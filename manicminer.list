 241+ 7E94              ; DrawItemGraphic
 242+ 7E94              ;
 243+ 7E94              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 244+ 7E94              ; utilizzando una bitmap di 8 byte e un attributo colore.
 245+ 7E94              ;
 246+ 7E94              ; Input:
 247+ 7E94              ;   B = Riga attributi (0..23)
 248+ 7E94              ;   C = Colonna attributi (0..31)
 249+ 7E94              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 250+ 7E94              ;   E = Attributo colore

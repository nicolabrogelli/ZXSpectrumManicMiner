 648+ 8015 21 D2 D8         ld   hl, Willy
 649+ 8018 19               add  hl, de
 650+ 8019 22 36 E5         ld   (willy_body_ptr), hl      ; Corpo destro
 651+ 801C
 652+ 801C              .willy_ptrs_ready:
 653+ 801C DD 21 5D 7C      ld   ix, ActiveEnemies
 654+ 8020 06 08            ld   b, 8                      ; 8 slot
 655+ 8022
 656+ 8022              .enemy_loop:
 657+ 8022 DD 7E 00         ld   a, (ix+0)
 658+ 8025 E6 80            and  $80                       ; Active?
 659+ 8027 CA 27 81         jp   z, .next_enemy
 660+ 802A
 661+ 802A                  ; ---------------------------------------------------------------
 662+ 802A                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 663+ 802A                  ; ---------------------------------------------------------------
 664+ 802A                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 665+ 802A 3A 12 DF         ld   a, (PlayerPos)            ; WillyX
 666+ 802D DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 667+ 8030 FE 10            cp   16
 668+ 8032 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 669+ 8034 FE F9            cp   249                       ; 249..255 = -7..-1
 670+ 8036 DA 27 81         jp   c, .next_enemy            ; 16..248 -> fuori range
 671+ 8039              .x_in_range:
 672+ 8039 32 3A E5         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 673+ 803C
 674+ 803C                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 675+ 803C 3A 13 DF         ld   a, (PlayerPos+1)          ; WillyY
 676+ 803F DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 677+ 8042 FE 10            cp   16
 678+ 8044 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 679+ 8046 FE F1            cp   241                       ; 241..255 = -15..-1
 680+ 8048 DA 27 81         jp   c, .next_enemy            ; 16..240 -> fuori range
 681+ 804B              .y_in_range:
 682+ 804B 32 3B E5         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 683+ 804E
 684+ 804E                  ; ---------------------------------------------------------------
 685+ 804E                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 686+ 804E                  ; ---------------------------------------------------------------
 687+ 804E C5               push bc                        ; Salva contatore nemici (B)
 688+ 804F
 689+ 804F                  ; Controlla se è guardiano verticale
 690+ 804F DD 7E 00         ld   a, (ix+0)
 691+ 8052 E6 40            and  $40                       ; Vertical?
 692+ 8054 20 1B            jr   nz, .col_guard_vert
 693+ 8056
 694+ 8056 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 695+ 8059 E6 03            and  3
 696+ 805B 4F               ld   c, a
 697+ 805C
 698+ 805C 3A 1D E3         ld   a, (room_has_v_guardians)
 699+ 805F B7               or   a
 700+ 8060 20 0A            jr   nz, .col_h_second_half    ; Se ci sono guardiani verticali, orizzontali usano la seconda metà (frame 4..7)
 701+ 8062
 702+ 8062 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 703+ 8065 FE 01            cp   1
 704+ 8067 28 03            jr   z, .guard_left_frame
 705+ 8069                  ; Frame Destra: Frame = Subframe (0..3, prima metà)
 706+ 8069 79               ld   a, c
 707+ 806A 18 0A            jr   .calc_guard_ptr
 708+ 806C              .col_h_second_half:
 709+ 806C              .guard_left_frame:
 710+ 806C                  ; Frame Sinistra (o stanza con guardiani verticali): Frame = 4 + Subframe (4..7, seconda metà)
 711+ 806C 3E 04            ld   a, 4
 712+ 806E 81               add  a, c
 713+ 806F 18 05            jr   .calc_guard_ptr
 714+ 8071
 715+ 8071              .col_guard_vert:
 716+ 8071                  ; Guardiano verticale: usa il frame salvato in (ix+1) (0..3, prima metà)
 717+ 8071 DD 7E 01         ld   a, (ix+1)
 718+ 8074 E6 03            and  3
 719+ 8076
 720+ 8076              .calc_guard_ptr:
 721+ 8076                  ; Offset = Frame * 32
 722+ 8076 6F               ld   l, a
 723+ 8077 26 00            ld   h, 0
 724+ 8079 29               add  hl, hl                    ; *2
 725+ 807A 29               add  hl, hl                    ; *4
 726+ 807B 29               add  hl, hl                    ; *8
 727+ 807C 29               add  hl, hl                    ; *16
 728+ 807D 29               add  hl, hl                    ; *32
 729+ 807E 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 730+ 8081 19               add  hl, de
 731+ 8082 ED 5B 93 E2      ld   de, (room_ptr)
 732+ 8086 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 733+ 8087 22 38 E5         ld   (guard_sprite_ptr), hl
 734+ 808A
 735+ 808A                  ; ---------------------------------------------------------------
 736+ 808A                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 737+ 808A                  ; ---------------------------------------------------------------
 738+ 808A 3A 3B E5         ld   a, (collision_delta_y)
 739+ 808D CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 740+ 808F 20 12            jr   nz, .willy_higher
 741+ 8091
 742+ 8091                  ; Willy lower or equal (DeltaY >= 0):
 743+ 8091                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 744+ 8091 32 3C E5         ld   (row_enemy_cur), a
 745+ 8094 AF               xor  a
 746+ 8095 32 3D E5         ld   (row_willy_cur), a
 747+ 8098 3E 10            ld   a, 16
 748+ 809A 21 3B E5         ld   hl, collision_delta_y
 749+ 809D 96               sub  (hl)
 750+ 809E 32 3E E5         ld   (overlap_num_lines), a
 751+ 80A1 18 12            jr   .check_lines_loop
 752+ 80A3
 753+ 80A3              .willy_higher:
 754+ 80A3                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 755+ 80A3 ED 44            neg                            ; A = -DeltaY (1..15)
 756+ 80A5 32 3D E5         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 757+ 80A8 AF               xor  a
 758+ 80A9 32 3C E5         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 759+ 80AC 3E 10            ld   a, 16
 760+ 80AE 21 3D E5         ld   hl, row_willy_cur
 761+ 80B1 96               sub  (hl)
 762+ 80B2 32 3E E5         ld   (overlap_num_lines), a
 763+ 80B5
 764+ 80B5              .check_lines_loop:
 765+ 80B5                  ; ---------------------------------------------------------------
 766+ 80B5                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 767+ 80B5                  ; ---------------------------------------------------------------
 768+ 80B5 3A 3E E5         ld   a, (overlap_num_lines)
 769+ 80B8 47               ld   b, a                      ; B = numero di scanlines da controllare
 770+ 80B9
 771+ 80B9              .scanline_loop:
 772+ 80B9 C5               push bc                        ; Salva contatore scanlines
 773+ 80BA
 774+ 80BA                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 775+ 80BA 3A 3C E5         ld   a, (row_enemy_cur)
 776+ 80BD 87               add  a, a                      ; row * 2
 777+ 80BE 5F               ld   e, a
 778+ 80BF 16 00            ld   d, 0
 779+ 80C1 2A 38 E5         ld   hl, (guard_sprite_ptr)
 780+ 80C4 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 781+ 80C5 56               ld   d, (hl)                   ; D = Enemy Byte 0
 782+ 80C6 23               inc  hl
 783+ 80C7 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 784+ 80C8
 785+ 80C8                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 786+ 80C8 3A 3A E5         ld   a, (collision_delta_x)
 787+ 80CB CB 7F            bit  7, a
 788+ 80CD 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 789+ 80CF
 790+ 80CF                  ; DeltaX >= 0:
 791+ 80CF FE 09            cp   9
 792+ 80D1 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 793+ 80D3
 794+ 80D3                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 795+ 80D3 B7               or   a
 796+ 80D4 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 797+ 80D6 4F               ld   c, a                      ; C = DeltaX (1..8)
 798+ 80D7              .shift_left_16bit:
 799+ 80D7 CB 23            sla  e
 800+ 80D9 CB 12            rl   d
 801+ 80DB 0D               dec  c
 802+ 80DC 20 F9            jr   nz, .shift_left_16bit
 803+ 80DE              .slice_ready_in_d:
 804+ 80DE 7A               ld   a, d                      ; A = fetta guardiano allineata
 805+ 80DF 18 14            jr   .test_willy_line
 806+ 80E1
 807+ 80E1              .shift_dx_gt_8:
 808+ 80E1                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 809+ 80E1 D6 08            sub  8
 810+ 80E3 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 811+ 80E4              .shift_left_e_only:
 812+ 80E4 CB 23            sla  e
 813+ 80E6 0D               dec  c
 814+ 80E7 20 FB            jr   nz, .shift_left_e_only
 815+ 80E9 7B               ld   a, e                      ; A = fetta guardiano allineata
 816+ 80EA 18 09            jr   .test_willy_line
 817+ 80EC
 818+ 80EC              .shift_neg_dx:
 819+ 80EC                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 820+ 80EC ED 44            neg
 821+ 80EE 4F               ld   c, a                      ; C = -DeltaX (1..7)
 822+ 80EF              .shift_right_d_only:
 823+ 80EF CB 3A            srl  d
 824+ 80F1 0D               dec  c
 825+ 80F2 20 FB            jr   nz, .shift_right_d_only
 826+ 80F4 7A               ld   a, d                      ; A = fetta guardiano allineata
 827+ 80F5
 828+ 80F5              .test_willy_line:
 829+ 80F5                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 830+ 80F5 B7               or   a
 831+ 80F6 28 21            jr   z, .next_scanline
 832+ 80F8
 833+ 80F8                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 834+ 80F8 4F               ld   c, a                      ; C = fetta guardiano

  40+ 7962                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7962 21 05 79         ld   hl, ActiveEnemies
  42+ 7965 11 06 79         ld   de, ActiveEnemies + 1
  43+ 7968 36 00            ld   (hl), 0

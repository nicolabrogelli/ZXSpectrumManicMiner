  71+ 8207 ~            ; -------------------------------------------------------------------
  72+ 8207 ~            ; Audio_UpdateMusic
  73+ 8207 ~            ;
  74+ 8207 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8207 ~            ; Viene chiamata a ogni frame.
  76+ 8207 ~            ; -------------------------------------------------------------------
  77+ 8207 ~            Audio_UpdateMusic:
  78+ 8207 ~                push af
  79+ 8207 ~                push bc
  80+ 8207 ~                push de
  81+ 8207 ~                push hl
  82+ 8207 ~
  83+ 8207 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8207 ~                ld   a, (Audio_jump_sound_note)
  85+ 8207 ~                cp   18
  86+ 8207 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8207 ~
  88+ 8207 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8207 ~                ld   a, (Audio_music_frame_counter)
  90+ 8207 ~                dec  a
  91+ 8207 ~                ld   (Audio_music_frame_counter), a
  92+ 8207 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8207 ~
  94+ 8207 ~                ; Altrimenti carica la nota successiva
  95+ 8207 ~                ld   a, (Audio_music_note_idx)
  96+ 8207 ~                inc  a
  97+ 8207 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8207 ~                jr   c, .no_wrap
  99+ 8207 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8207 ~            .no_wrap:
 101+ 8207 ~                ld   (Audio_music_note_idx), a
 102+ 8207 ~
 103+ 8207 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8207 ~                ld   e, a
 105+ 8207 ~                ld   d, 0
 106+ 8207 ~                ld   hl, Audio_MusicSheet
 107+ 8207 ~                add  hl, de
 108+ 8207 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8207 ~
 110+ 8207 ~                ; Leggi durata (secondo byte)
 111+ 8207 ~                inc  hl
 112+ 8207 ~                ld   a, (hl)
 113+ 8207 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8207 ~                jr   nz, .dur_ok
 115+ 8207 ~                ld   a, 1
 116+ 8207 ~            .dur_ok:
 117+ 8207 ~                ld   (Audio_music_frame_counter), a
 118+ 8207 ~
 119+ 8207 ~            .play_current_note:
 120+ 8207 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8207 ~                ld   a, (Audio_music_note_idx)
 122+ 8207 ~                ld   e, a
 123+ 8207 ~                ld   d, 0
 124+ 8207 ~                ld   hl, Audio_MusicSheet
 125+ 8207 ~                add  hl, de
 126+ 8207 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8207 ~                ld   a, (hl)                  ; A = delay
 128+ 8207 ~                or   a
 129+ 8207 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8207 ~
 131+ 8207 ~                ; Suona la nota: 2 cicli
 132+ 8207 ~                ld   d, a                     ; D = delay
 133+ 8207 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8207 ~            .note_loop:
 135+ 8207 ~                ; Speaker ON
 136+ 8207 ~                ld   a, (room_border_color)
 137+ 8207 ~                or   $10
 138+ 8207 ~                out  ($fe), a
 139+ 8207 ~                ld   c, d
 140+ 8207 ~            .d1:
 141+ 8207 ~                push af
 142+ 8207 ~                pop  af
 143+ 8207 ~                dec  c
 144+ 8207 ~                jr   nz, .d1
 145+ 8207 ~
 146+ 8207 ~                ; Speaker OFF
 147+ 8207 ~                ld   a, (room_border_color)
 148+ 8207 ~                and  $ef
 149+ 8207 ~                out  ($fe), a
 150+ 8207 ~                ld   c, d
 151+ 8207 ~            .d2:
 152+ 8207 ~                push af
 153+ 8207 ~                pop  af
 154+ 8207 ~                dec  c
 155+ 8207 ~                jr   nz, .d2
 156+ 8207 ~
 157+ 8207 ~                djnz .note_loop
 158+ 8207 ~
 159+ 8207 ~            .done:
 160+ 8207 ~                pop  hl
 161+ 8207 ~                pop  de
 162+ 8207 ~                pop  bc
 163+ 8207 ~                pop  af
 164+ 8207 ~                ret
 165+ 8207 ~
 166+ 8207 ~            Audio_MusicSheet:
 167+ 8207 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8207 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8207 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8207 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8207 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8207 ~                db 90, 10, 107, 20, 68, 65
 173+ 8207                  ELSE
 174+ 8207              Audio_UpdateMusic:
 175+ 8207 C9               ret
 176+ 8208                  ENDIF

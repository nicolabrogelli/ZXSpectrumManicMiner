  11+ 7C4B              ; Struttura dati per i nemici attivi della stanza corrente (RAM)
  12+ 7C4B              ; 8 slot, 11 byte ciascuno:
  13+ 7C4B              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7C4B              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C4B              ; Offset 2: Current X
  16+ 7C4B              ; Offset 3: Current Y
  17+ 7C4B              ; Offset 4: Min Limit
  18+ 7C4B              ; Offset 5: Max Limit
  19+ 7C4B              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7C4B              ; Offset 7: Anim State (0..3)
  21+ 7C4B              ; Offset 8: Old X
  22+ 7C4B              ; Offset 9: Old Y
  23+ 7C4B              ; Offset 10: Color (Attributo Spectrum)
  24+ 7C4B              ; -------------------------------------------------------------------
  25+ 7C4B              ActiveEnemies:
  26+ 7C4B 00          > db 0
  26+ 7C4C 00          > db 0

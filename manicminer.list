 204+ 80C5 69               ld   l, c
 205+ 80C6 01 00 A4         ld   bc, -23552
 206+ 80C9 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80CA
 208+ 80CA                  ; Col = Offset & 31
 209+ 80CA 7D               ld   a, l
 210+ 80CB E6 1F            and  31
 211+ 80CD 4F               ld   c, a                      ; C = Col (0..31)
 212+ 80CE
 213+ 80CE                  ; Row = Offset / 32
 214+ 80CE CB 3C            srl  h
 214+ 80D0 CB 1D          rr l
 215+ 80D2 CB 3C            srl  h
 215+ 80D4 CB 1D          rr l
 216+ 80D6 CB 3C            srl  h
 216+ 80D8 CB 1D          rr l
 217+ 80DA CB 3C            srl  h
 217+ 80DC CB 1D          rr l
 218+ 80DE CB 3C            srl  h
 218+ 80E0 CB 1D          rr l
 219+ 80E2 7D               ld   a, l
 220+ 80E3 47               ld   b, a                      ; B = Row (0..15)
 221+ 80E4
 222+ 80E4                  ; Disegna l'item sullo schermo
 223+ 80E4 DD E5            push ix
 224+ 80E6 E1               pop  hl                        ; HL = puntatore bitmap
 225+ 80E7 CD 39 81         call DrawItemGraphic
 226+ 80EA
 227+ 80EA                  ; Aggiorna items_grid: offset = Row * 32 + Col
 228+ 80EA D5               push de
 229+ 80EB 26 00            ld   h, 0
 230+ 80ED 68               ld   l, b                      ; HL = Row
 231+ 80EE 29               add  hl, hl
 232+ 80EF 29               add  hl, hl
 233+ 80F0 29               add  hl, hl
 234+ 80F1 29               add  hl, hl
 235+ 80F2 29               add  hl, hl                    ; Row * 32
 236+ 80F3 59               ld   e, c
 237+ 80F4 16 00            ld   d, 0
 238+ 80F6 19               add  hl, de                    ; Row * 32 + Col
 239+ 80F7 11 00 94         ld   de, items_grid
 240+ 80FA 19               add  hl, de

1187+ 787F              ; -------------------------------------------------------------------
1188+ 787F              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1189+ 787F              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1190+ 787F              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1191+ 787F              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1192+ 787F              ; -------------------------------------------------------------------
1193+ 787F              UnpackRoomLayout:
1194+ 787F E5               push hl
1195+ 7880 D5               push de
1196+ 7881 C5               push bc
1197+ 7882 DD E5            push ix
1198+ 7884
1199+ 7884 DD 2A 80 99      ld   ix, (room_ptr)
1200+ 7888 11 20 02         ld   de, OFFSET_TILES
1201+ 788B DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1202+ 788D
1203+ 788D 2A 80 99         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 7890 11 26 97         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 7893 01 00 02         ld   bc, 512               ; 512 celle
1206+ 7896
1207+ 7896              .byte_loop:
1208+ 7896 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1209+ 7897 23               inc  hl
1210+ 7898
1211+ 7898                  ; Confronta con le 8 definizioni di tile:
1212+ 7898 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 789B 28 23            jr   z, .is_bg
1214+ 789D DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 78A0 28 29            jr   z, .is_wall
1216+ 78A2 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 78A5 28 1C            jr   z, .is_floor
1218+ 78A7 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 78AA 28 1B            jr   z, .is_crumbling
1220+ 78AC DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 78AF 28 1E            jr   z, .is_conveyor
1222+ 78B1 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 78B4 28 1D            jr   z, .is_nasty1
1224+ 78B6 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 78B9 28 1C            jr   z, .is_nasty2
1226+ 78BB DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 78BE 28 1B            jr   z, .is_extra
1228+ 78C0
1229+ 78C0              .is_bg:
1230+ 78C0                  ; Default: Tile 0 (Background)
1231+ 78C0 AF               xor  a
1232+ 78C1 18 1A            jr   .store_cell
1233+ 78C3
1234+ 78C3              .is_floor:
1235+ 78C3 3E 01            ld   a, 1
1236+ 78C5 18 16            jr   .store_cell
1237+ 78C7              .is_crumbling:
1238+ 78C7 3E 02            ld   a, 2
1239+ 78C9 18 12            jr   .store_cell
1240+ 78CB              .is_wall:
1241+ 78CB 3E 03            ld   a, 3
1242+ 78CD 18 0E            jr   .store_cell
1243+ 78CF              .is_conveyor:
1244+ 78CF 3E 04            ld   a, 4
1245+ 78D1 18 0A            jr   .store_cell
1246+ 78D3              .is_nasty1:
1247+ 78D3 3E 05            ld   a, 5
1248+ 78D5 18 06            jr   .store_cell
1249+ 78D7              .is_nasty2:
1250+ 78D7 3E 06            ld   a, 6
1251+ 78D9 18 02            jr   .store_cell
1252+ 78DB              .is_extra:
1253+ 78DB 3E 07            ld   a, 7
1254+ 78DD
1255+ 78DD              .store_cell:
1256+ 78DD 12               ld   (de), a
1257+ 78DE 13               inc  de
1258+ 78DF 0B               dec  bc
1259+ 78E0 78               ld   a, b
1260+ 78E1 B1               or   c
1261+ 78E2 20 B2            jr   nz, .byte_loop
1262+ 78E4
1263+ 78E4 DD E1            pop  ix
1264+ 78E6 C1               pop  bc
1265+ 78E7 D1               pop  de
1266+ 78E8 E1               pop  hl
1267+ 78E9 C9               ret

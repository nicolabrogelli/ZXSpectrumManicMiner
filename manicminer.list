 722  8980              ; -------------------------------------------------------------------
 723  8980              ; TriggerPortalTransition
 724  8980              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  8980              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  8980              ; - Avanza all'indice della stanza successiva.
 727  8980              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  8980              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  8980              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  8980              ; -------------------------------------------------------------------
 731  8980              TriggerPortalTransition:
 732  8980                  ; 1. Determina l'ID della stanza corrente
 733  8980 CD E9 82         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  8983
 735  8983                  ; 2. Calcola l'indice della stanza successiva
 736  8983 3A E1 E3         ld   a, (current_room)
 737  8986 3C               inc  a
 738  8987 FE 14            cp   NUM_ROOMS
 739  8989 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  898B
 741  898B                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  898B 21 0C 73         ld   hl, RoomsListTable
 743  898E 5F               ld   e, a
 744  898F 16 00            ld   d, 0
 745  8991 19               add  hl, de
 746  8992 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  8993 5E               ld   e, (hl)
 748  8994 23               inc  hl
 749  8995 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  8996 ED 53 3C E4      ld   (room_ptr), de
 751  899A
 752  899A                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  899A AF               xor  a
 754  899B 32 42 E4         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  899E 32 C9 E0         ld   (velocity_y), a
 756  89A1 32 D2 E6         ld   (game_objective_completed), a
 757  89A4 3E 01            ld   a, 1
 758  89A6 32 CA E0         ld   (on_ground), a
 759  89A9
 760  89A9                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  89A9 3E 07            ld   a, $07
 762  89AB CD 99 62         call Gfx_ClearScreenDirect
 763  89AE
 764  89AE C3 43 86         jp   LoadRoomAndRestart
 765  89B1
 766  89B1              .all_rooms_completed:
 767  89B1                  ; Tutte le stanze sono state completate con successo!
 768  89B1                  IF ENABLE_VICTORY_SCREEN != 0
 769  89B1 C3 A8 88         jp   TriggerVictory
 770  89B4                  ELSE
 771  89B4 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  89B4 ~                ld   de, (RoomsListTable)
 773  89B4 ~                ld   (room_ptr), de
 774  89B4 ~                xor  a
 775  89B4 ~                ld   (transition_active), a
 776  89B4 ~                ld   (velocity_y), a
 777  89B4 ~                ld   (game_objective_completed), a
 778  89B4 ~                ld   a, 1
 779  89B4 ~                ld   (on_ground), a
 780  89B4 ~                ld   a, $07
 781  89B4 ~                call Gfx_ClearScreenDirect
 782  89B4 ~                jp   LoadRoomAndRestart
 783  89B4                  ENDIF

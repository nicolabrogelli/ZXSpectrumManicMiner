  16+ 7CE8              ; Offset 3: Current Y
  17+ 7CE8              ; Offset 4: Min Limit
  18+ 7CE8              ; Offset 5: Max Limit
  19+ 7CE8              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7CE8              ; Offset 7: Anim State (0..3)
  21+ 7CE8              ; Offset 8: Old X
  22+ 7CE8              ; Offset 9: Old Y
  23+ 7CE8              ; Offset 10: Color (Attributo Spectrum)
  24+ 7CE8              ; -------------------------------------------------------------------

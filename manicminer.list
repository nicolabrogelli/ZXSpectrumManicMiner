 202+ 8585
 203+ 8585 7E               ld   a, (hl)                   ; A = Collected flag
 204+ 8586 FE FF            cp   $FF
 205+ 8588 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto

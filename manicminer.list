 901  8489 32 85 8F         ld   (jump_dir), a
 902  848C 32 F7 92         ld   (transition_active), a
 903  848F 32 7B 93         ld   (willy_safety_timer), a
 904  8492 3E FF            ld   a, $ff
 905  8494 32 8F 8F         ld   (digit_key_prev), a
 906  8497 3E 01            ld   a, 1
 907  8499 32 88 8F         ld   (q_prev), a
 908  849C 32 89 8F         ld   (a_prev), a

1775+ 7B5F 79               ld   a, c
1776+ 7B60 C6 07            add  a, 7
1777+ 7B62 4F               ld   c, a
1778+ 7B63 CD 0D 7B         call CheckNastyCell
1779+ 7B66 38 19            jr   c, .collision
1780+ 7B68

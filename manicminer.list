 447  874A                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 448  874A C3 9B 86         jp   ShowTitleScreen
 449  874D
 450  874D              .continue_chosen:
 451  874D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 452  874D              .wait_continue_release:
 453  874D 76               halt
 454  874E 01 FE DF         ld   bc, $dffe
 455  8751 ED 78            in   a, (c)
 456  8753 CB 67            bit  4, a
 457  8755 28 F6            jr   z, .wait_continue_release
 458  8757
 459  8757                  ; 5b. Ripristina lo stato per continuare la partita:
 460  8757                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 461  8757 CD 5A 82         call Items_ResetCurrentRoomItems
 462  875A
 463  875A                  ; - Ripristina le vite di Willy al valore iniziale
 464  875A 3E 07            ld   a, INITIAL_LIVES
 465  875C 32 E7 DF         ld   (willy_lives), a
 466  875F
 467  875F                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 468  875F 2A FB DF         ld   hl, (counter)
 469  8762 22 FE DF         ld   (last_frame_counter), hl
 470  8765
 471  8765                  ; - Reimposta la fisica e le variabili di stato di Willy
 472  8765 AF               xor  a
 473  8766 32 E8 DF         ld   (velocity_y), a
 474  8769 32 EA DF         ld   (jump_pressed), a
 475  876C 32 EC DF         ld   (coyote_timer), a
 476  876F 32 EF DF         ld   (jump_frame), a
 477  8772 32 EE DF         ld   (jump_dir), a
 478  8775 32 E0 DF         ld   (body_state), a
 479  8778 32 F3 DF         ld   (w_warp_state), a
 480  877B 32 F6 DF         ld   (w_key_prev), a
 481  877E 32 F7 DF         ld   (enter_key_prev), a
 482  8781 32 E3 DF         ld   (collision_active), a
 483  8784 32 E2 DF         ld   (flags), a
 484  8787 32 DC E3         ld   (ramp_entry_guard), a
 485  878A 32 E8 E3         ld   (willy_on_ramp), a
 486  878D 32 E7 E3         ld   (willy_needs_redraw), a
 487  8790 3E FF            ld   a, $ff
 488  8792 32 F8 DF         ld   (digit_key_prev), a
 489  8795 32 E1 E3         ld   (player_drawn_pos+1), a
 490  8798 32 E2 E3         ld   (player_old_dir), a
 491  879B 32 E3 E3         ld   (player_old_body), a
 492  879E 3E 01            ld   a, 1
 493  87A0 32 F1 DF         ld   (q_prev), a
 494  87A3 32 F2 DF         ld   (a_prev), a
 495  87A6 32 E9 DF         ld   (on_ground), a
 496  87A9 32 E4 E3         ld   (enemy_was_updated), a
 497  87AC
 498  87AC                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 499  87AC 3E 00            ld   a, RESPAWN_SAFETY_TIME
 500  87AE 32 E6 E3         ld   (willy_safety_timer), a
 501  87B1
 502  87B1                  ; - Ripristina lo stato audio
 503  87B1 3E 12            ld   a, 18
 504  87B3 32 F7 E5         ld   (Audio_jump_sound_note), a
 505  87B6 AF               xor  a
 506  87B7 32 F8 E5         ld   (Audio_jump_sound_timer), a
 507  87BA                  IF ENABLE_MUSIC != 0
 508  87BA ~                ld   (Audio_music_note_idx), a
 509  87BA ~                ld   a, 1
 510  87BA ~                ld   (Audio_music_frame_counter), a
 511  87BA                  ENDIF
 512  87BA
 513  87BA                  ; - Riposiziona Willy nel punto di default definito nella stanza
 514  87BA AF               xor  a
 515  87BB 32 61 E3         ld   (transition_active), a
 516  87BE
 517  87BE                  ; - Cancella lo schermo a nero prima del caricamento
 518  87BE AF               xor  a
 519  87BF D3 FE            out  ($fe), a
 520  87C1 CD 99 62         call Gfx_ClearScreenDirect
 521  87C4
 522  87C4                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 523  87C4 C3 62 85         jp   LoadRoomAndRestart
 524  87C7
 525  87C7              ; -------------------------------------------------------------------
 526  87C7              ; TriggerVictory
 527  87C7              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  87C7              ; - Pulisce gli elementi di gioco della stanza.
 529  87C7              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  87C7              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  87C7              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  87C7              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  87C7              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  87C7              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  87C7              ; -------------------------------------------------------------------
 536  87C7              TriggerVictory:
 537  87C7                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  87C7 CD F3 66         call Gfx_DrawVictoryScreen
 539  87CA
 540  87CA                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  87CA              .wait_keys_release:
 542  87CA 76               halt
 543  87CB                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  87CB 01 FE DF         ld   bc, $dffe
 545  87CE ED 78            in   a, (c)
 546  87D0 CB 67            bit  4, a
 547  87D2 28 F6            jr   z, .wait_keys_release
 548  87D4
 549  87D4                  ; Controlla tasto N (Porta $7F, bit 3)
 550  87D4 01 FE 7F         ld   bc, $7ffe
 551  87D7 ED 78            in   a, (c)
 552  87D9 CB 5F            bit  3, a
 553  87DB 28 ED            jr   z, .wait_keys_release
 554  87DD
 555  87DD                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  87DD 01 FE BF         ld   bc, $bffe
 557  87E0 ED 78            in   a, (c)
 558  87E2 CB 47            bit  0, a
 559  87E4 28 E4            jr   z, .wait_keys_release
 560  87E6
 561  87E6                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  87E6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  87E8              .wait_choice_loop:
 564  87E8 76               halt
 565  87E9
 566  87E9                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  87E9 0C               inc  c
 568  87EA 79               ld   a, c
 569  87EB CB 3F            srl  a
 570  87ED CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  87EF E6 07            and  7
 572  87F1 5F               ld   e, a
 573  87F2 16 00            ld   d, 0
 574  87F4 21 0D 66         ld   hl, victory_color_table
 575  87F7 19               add  hl, de
 576  87F8 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  87F9 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  87FC 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  87FE              .color_cycle_loop:
 580  87FE 77               ld   (hl), a
 581  87FF 23               inc  hl
 582  8800 10 FC            djnz .color_cycle_loop
 583  8802
 584  8802                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  8802 01 FE DF         ld   bc, $dffe
 586  8805 ED 78            in   a, (c)
 587  8807 CB 67            bit  4, a
 588  8809 28 2A            jr   z, .play_again_chosen
 589  880B
 590  880B                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  880B 01 FE 7F         ld   bc, $7ffe
 592  880E ED 78            in   a, (c)
 593  8810 CB 5F            bit  3, a
 594  8812 28 0B            jr   z, .quit_chosen
 595  8814
 596  8814                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  8814 01 FE BF         ld   bc, $bffe
 598  8817 ED 78            in   a, (c)
 599  8819 CB 47            bit  0, a
 600  881B 28 02            jr   z, .quit_chosen
 601  881D
 602  881D 18 C9            jr   .wait_choice_loop
 603  881F
 604  881F              .quit_chosen:
 605  881F                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  881F              .wait_quit_release:
 607  881F 76               halt
 608  8820 01 FE 7F         ld   bc, $7ffe
 609  8823 ED 78            in   a, (c)
 610  8825 CB 5F            bit  3, a
 611  8827 28 F6            jr   z, .wait_quit_release
 612  8829 01 FE BF         ld   bc, $bffe
 613  882C ED 78            in   a, (c)
 614  882E CB 47            bit  0, a
 615  8830 28 ED            jr   z, .wait_quit_release
 616  8832
 617  8832                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  8832 C3 9B 86         jp   ShowTitleScreen
 619  8835
 620  8835              .play_again_chosen:
 621  8835                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  8835              .wait_play_again_release:
 623  8835 76               halt
 624  8836 01 FE DF         ld   bc, $dffe
 625  8839 ED 78            in   a, (c)
 626  883B CB 67            bit  4, a
 627  883D 28 F6            jr   z, .wait_play_again_release
 628  883F
 629  883F                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  883F CD 40 89         call ResetFullGameState
 631  8842 C3 62 85         jp   LoadRoomAndRestart
 632  8845
 633  8845              ; -------------------------------------------------------------------
 634  8845              ; CheckPortalTransition
 635  8845              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8845              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8845              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8845              ;
 639  8845              ; Output:
 640  8845              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8845              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8845              ; -------------------------------------------------------------------
 643  8845              CheckPortalTransition:
 644  8845 C5               push bc
 645  8846 D5               push de
 646  8847 E5               push hl
 647  8848
 648  8848                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  8848 CD D3 88         call CheckAllItemsCollected
 650  884B 30 4D            jr   nc, .no_transition
 651  884D
 652  884D                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  884D                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  884D                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  884D 2A 5B E3         ld   hl, (room_ptr)
 656  8850 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8853 19               add  hl, de
 658  8854 4E               ld   c, (hl)
 659  8855 23               inc  hl
 660  8856 46               ld   b, (hl)                   ; BC = AttrAddr
 661  8857
 662  8857                  ; Offset = BC - 23552
 663  8857 60               ld   h, b
 664  8858 69               ld   l, c
 665  8859 01 00 A4         ld   bc, -23552
 666  885C 09               add  hl, bc
 667  885D
 668  885D                  ; PortalX = (Offset & 31) * 8
 669  885D 7D               ld   a, l
 670  885E E6 1F            and  31
 671  8860 87               add  a, a
 671  8861 87             add a, a
 671  8862 87             add a, a
 672  8863 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8864
 674  8864                  ; PortalY = (Offset / 32) * 8
 675  8864 CB 3C            srl  h
 675  8866 CB 1D          rr l
 676  8868 CB 3C            srl  h
 676  886A CB 1D          rr l
 677  886C CB 3C            srl  h
 677  886E CB 1D          rr l
 678  8870 CB 3C            srl  h
 678  8872 CB 1D          rr l
 679  8874 CB 3C            srl  h
 679  8876 CB 1D          rr l
 680  8878 7D               ld   a, l
 681  8879 87               add  a, a
 681  887A 87             add a, a
 681  887B 87             add a, a
 682  887C 57               ld   d, a                      ; D = PortalY (0..120)
 683  887D
 684  887D                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  887D ED 4B DA DF      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  8881
 687  8881                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  8881 7B               ld   a, e
 689  8882 91               sub  c
 690  8883 30 02            jr   nc, .x_diff_pos
 691  8885 ED 44            neg
 692  8887              .x_diff_pos:
 693  8887 FE 0C            cp   12
 694  8889 30 0F            jr   nc, .no_transition
 695  888B
 696  888B                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  888B 7A               ld   a, d
 698  888C 90               sub  b
 699  888D 30 02            jr   nc, .y_diff_pos
 700  888F ED 44            neg
 701  8891              .y_diff_pos:
 702  8891 FE 0E            cp   14
 703  8893 30 05            jr   nc, .no_transition
 704  8895
 705  8895                  ; Transizione al portale attiva!
 706  8895 E1               pop  hl
 707  8896 D1               pop  de
 708  8897 C1               pop  bc
 709  8898 37               scf
 710  8899 C9               ret
 711  889A
 712  889A              .no_transition:
 713  889A E1               pop  hl
 714  889B D1               pop  de
 715  889C C1               pop  bc
 716  889D B7               or   a
 717  889E C9               ret
 718  889F
 719  889F              ; Alias per retrocompatibilità
 720  889F              CheckVictoryCondition: EQU CheckPortalTransition
 721  889F
 722  889F              ; -------------------------------------------------------------------
 723  889F              ; TriggerPortalTransition
 724  889F              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  889F              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  889F              ; - Avanza all'indice della stanza successiva.
 727  889F              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  889F              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  889F              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  889F              ; -------------------------------------------------------------------
 731  889F              TriggerPortalTransition:
 732  889F                  ; 1. Determina l'ID della stanza corrente
 733  889F CD 08 82         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  88A2
 735  88A2                  ; 2. Calcola l'indice della stanza successiva
 736  88A2 3A 00 E3         ld   a, (current_room)
 737  88A5 3C               inc  a
 738  88A6 FE 14            cp   NUM_ROOMS
 739  88A8 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  88AA
 741  88AA                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  88AA 21 0A 73         ld   hl, RoomsListTable
 743  88AD 5F               ld   e, a
 744  88AE 16 00            ld   d, 0
 745  88B0 19               add  hl, de
 746  88B1 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  88B2 5E               ld   e, (hl)
 748  88B3 23               inc  hl
 749  88B4 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  88B5 ED 53 5B E3      ld   (room_ptr), de
 751  88B9
 752  88B9                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  88B9 AF               xor  a
 754  88BA 32 61 E3         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  88BD 32 E8 DF         ld   (velocity_y), a
 756  88C0 32 F1 E5         ld   (game_objective_completed), a
 757  88C3 3E 01            ld   a, 1
 758  88C5 32 E9 DF         ld   (on_ground), a
 759  88C8
 760  88C8                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  88C8 3E 07            ld   a, $07
 762  88CA CD 99 62         call Gfx_ClearScreenDirect
 763  88CD
 764  88CD C3 62 85         jp   LoadRoomAndRestart
 765  88D0
 766  88D0              .all_rooms_completed:
 767  88D0                  ; Tutte le stanze sono state completate con successo!
 768  88D0                  IF ENABLE_VICTORY_SCREEN != 0
 769  88D0 C3 C7 87         jp   TriggerVictory
 770  88D3                  ELSE
 771  88D3 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  88D3 ~                ld   de, (RoomsListTable)
 773  88D3 ~                ld   (room_ptr), de
 774  88D3 ~                xor  a
 775  88D3 ~                ld   (transition_active), a
 776  88D3 ~                ld   (velocity_y), a
 777  88D3 ~                ld   (game_objective_completed), a
 778  88D3 ~                ld   a, 1
 779  88D3 ~                ld   (on_ground), a
 780  88D3 ~                ld   a, $07
 781  88D3 ~                call Gfx_ClearScreenDirect
 782  88D3 ~                jp   LoadRoomAndRestart
 783  88D3                  ENDIF
 784  88D3
 785  88D3              ; -------------------------------------------------------------------
 786  88D3              ; CheckAllItemsCollected
 787  88D3              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  88D3              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  88D3              ; -------------------------------------------------------------------
 790  88D3              CheckAllItemsCollected:
 791  88D3 3A F1 E5         ld   a, (game_objective_completed)
 792  88D6 B7               or   a
 793  88D7 20 08            jr   nz, .all_collected
 794  88D9 3A 5A E3         ld   a, (num_room_items)
 795  88DC B7               or   a
 796  88DD 28 02            jr   z, .all_collected
 797  88DF B7               or   a
 798  88E0 C9               ret
 799  88E1              .all_collected:
 800  88E1 37               scf
 801  88E2 C9               ret
 802  88E3
 803  88E3              ; -------------------------------------------------------------------
 804  88E3              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  88E3              ; -------------------------------------------------------------------
 806  88E3              CheckInMasterBedroom:
 807  88E3 37               scf
 808  88E4 C9               ret
 809  88E5
 810  88E5              ; -------------------------------------------------------------------
 811  88E5              ; CheckWillyConveyorCollision
 812  88E5              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  88E5              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  88E5              ; -------------------------------------------------------------------
 815  88E5              CheckWillyConveyorCollision:
 816  88E5 C5               push bc

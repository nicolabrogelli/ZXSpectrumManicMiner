 414+ 866A              ; CheckWillyItemCollision
 415+ 866A              ;
 416+ 866A              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 866A              ; Input:
 418+ 866A              ;   A = Item Col (0..31)
 419+ 866A              ;   H = Item Row (0..15)
 420+ 866A              ; Output:
 421+ 866A              ;   Carry Set = Collisione
 422+ 866A              ;   Carry Clear = Nessuna collisione
 423+ 866A              ; -------------------------------------------------------------------
 424+ 866A              CheckWillyItemCollision:
 425+ 866A C5               push bc
 426+ 866B D5               push de
 427+ 866C E5               push hl
 428+ 866D
 429+ 866D                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

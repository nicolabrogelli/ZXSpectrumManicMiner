  72+ 819B ~            ; Audio_UpdateMusic
  73+ 819B ~            ;
  74+ 819B ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 819B ~            ; Viene chiamata a ogni frame.
  76+ 819B ~            ; -------------------------------------------------------------------
  77+ 819B ~            Audio_UpdateMusic:
  78+ 819B ~                push af
  79+ 819B ~                push bc
  80+ 819B ~                push de
  81+ 819B ~                push hl
  82+ 819B ~
  83+ 819B ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 819B ~                ld   a, (Audio_jump_sound_note)
  85+ 819B ~                cp   18
  86+ 819B ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 819B ~
  88+ 819B ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 819B ~                ld   a, (Audio_music_frame_counter)
  90+ 819B ~                dec  a
  91+ 819B ~                ld   (Audio_music_frame_counter), a
  92+ 819B ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 819B ~
  94+ 819B ~                ; Altrimenti carica la nota successiva
  95+ 819B ~                ld   a, (Audio_music_note_idx)
  96+ 819B ~                inc  a
  97+ 819B ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 819B ~                jr   c, .no_wrap
  99+ 819B ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 819B ~            .no_wrap:
 101+ 819B ~                ld   (Audio_music_note_idx), a
 102+ 819B ~
 103+ 819B ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 819B ~                ld   e, a
 105+ 819B ~                ld   d, 0
 106+ 819B ~                ld   hl, Audio_MusicSheet
 107+ 819B ~                add  hl, de
 108+ 819B ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 819B ~
 110+ 819B ~                ; Leggi durata (secondo byte)
 111+ 819B ~                inc  hl
 112+ 819B ~                ld   a, (hl)
 113+ 819B ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 819B ~                jr   nz, .dur_ok
 115+ 819B ~                ld   a, 1
 116+ 819B ~            .dur_ok:
 117+ 819B ~                ld   (Audio_music_frame_counter), a
 118+ 819B ~
 119+ 819B ~            .play_current_note:
 120+ 819B ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 819B ~                ld   a, (Audio_music_note_idx)
 122+ 819B ~                ld   e, a
 123+ 819B ~                ld   d, 0
 124+ 819B ~                ld   hl, Audio_MusicSheet
 125+ 819B ~                add  hl, de
 126+ 819B ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 819B ~                ld   a, (hl)                  ; A = delay
 128+ 819B ~                or   a
 129+ 819B ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 819B ~
 131+ 819B ~                ; Suona la nota: 2 cicli
 132+ 819B ~                ld   d, a                     ; D = delay
 133+ 819B ~                ld   b, 2                     ; 2 cicli per frame
 134+ 819B ~            .note_loop:
 135+ 819B ~                ; Speaker ON
 136+ 819B ~                ld   a, (room_border_color)
 137+ 819B ~                or   $10
 138+ 819B ~                out  ($fe), a
 139+ 819B ~                ld   c, d
 140+ 819B ~            .d1:
 141+ 819B ~                push af
 142+ 819B ~                pop  af
 143+ 819B ~                dec  c
 144+ 819B ~                jr   nz, .d1
 145+ 819B ~
 146+ 819B ~                ; Speaker OFF
 147+ 819B ~                ld   a, (room_border_color)
 148+ 819B ~                and  $ef
 149+ 819B ~                out  ($fe), a
 150+ 819B ~                ld   c, d
 151+ 819B ~            .d2:
 152+ 819B ~                push af
 153+ 819B ~                pop  af
 154+ 819B ~                dec  c
 155+ 819B ~                jr   nz, .d2
 156+ 819B ~
 157+ 819B ~                djnz .note_loop
 158+ 819B ~
 159+ 819B ~            .done:
 160+ 819B ~                pop  hl
 161+ 819B ~                pop  de
 162+ 819B ~                pop  bc
 163+ 819B ~                pop  af
 164+ 819B ~                ret
 165+ 819B ~
 166+ 819B ~            Audio_MusicSheet:
 167+ 819B ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 819B ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 819B ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 819B ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 819B ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 819B ~                db 90, 10, 107, 20, 68, 65
 173+ 819B                  ELSE
 174+ 819B              Audio_UpdateMusic:
 175+ 819B C9               ret
 176+ 819C                  ENDIF

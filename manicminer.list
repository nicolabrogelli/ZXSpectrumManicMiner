 546+ 8250 19               add  hl, de
 547+ 8251 36 00            ld   (hl), 0
 548+ 8253 C1               pop  bc
 549+ 8254
 550+ 8254                  ; 3. Disattiva lo slot nella cache
 551+ 8254 FD 36 02 00      ld   (iy+2), 0

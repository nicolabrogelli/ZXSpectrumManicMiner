1095+ 783E              .is_bg:
1096+ 783E                  ; Default: Tile 0 (Background)
1097+ 783E AF               xor  a
1098+ 783F 18 1A            jr   .store_cell
1099+ 7841
1100+ 7841              .is_floor:
1101+ 7841 3E 01            ld   a, 1
1102+ 7843 18 16            jr   .store_cell
1103+ 7845              .is_crumbling:
1104+ 7845 3E 02            ld   a, 2
1105+ 7847 18 12            jr   .store_cell
1106+ 7849              .is_wall:
1107+ 7849 3E 03            ld   a, 3
1108+ 784B 18 0E            jr   .store_cell
1109+ 784D              .is_conveyor:
1110+ 784D 3E 04            ld   a, 4
1111+ 784F 18 0A            jr   .store_cell
1112+ 7851              .is_nasty1:
1113+ 7851 3E 05            ld   a, 5
1114+ 7853 18 06            jr   .store_cell
1115+ 7855              .is_nasty2:
1116+ 7855 3E 06            ld   a, 6
1117+ 7857 18 02            jr   .store_cell
1118+ 7859              .is_extra:
1119+ 7859 3E 07            ld   a, 7

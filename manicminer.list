 746+ 8825              ; -------------------------------------------------------------------
 747+ 8825              ; Items_Animate
 748+ 8825              ;
 749+ 8825              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 8825              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 8825              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 8825              ; originale $8F63.
 753+ 8825              ; -------------------------------------------------------------------
 754+ 8825              Items_Animate:
 755+ 8825 E5               push hl
 756+ 8826 D5               push de
 757+ 8827 C5               push bc
 758+ 8828 FD E5            push iy
 759+ 882A
 760+ 882A 3A 5E EE         ld   a, (num_room_items)
 761+ 882D B7               or   a
 762+ 882E 28 40            jr   z, .anim_done
 763+ 8830
 764+ 8830 FD 21 0E EE      ld   iy, current_room_items
 765+ 8834
 766+ 8834              .anim_loop:
 767+ 8834 FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 8837 FE FF            cp   $FF
 769+ 8839 28 35            jr   z, .anim_done
 770+ 883B B7               or   a
 771+ 883C 28 2B            jr   z, .next_anim_item
 772+ 883E
 773+ 883E                  ; Routine originale $8F63 di Manic Miner:
 774+ 883E                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 883E E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 8840 F6 03            or   $03                       ; Base Ink = 3
 777+ 8842 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 8843 FD 7E 02         ld   a, (iy+2)
 779+ 8846 E6 03            and  $03                       ; Isola offset rotazione
 780+ 8848 80               add  a, b                      ; A = Nuovo attributo
 781+ 8849 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 884C 47               ld   b, a                      ; B = Nuovo attributo
 783+ 884D
 784+ 884D                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 884D FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 8850 16 00            ld   d, 0
 787+ 8852 26 00            ld   h, 0
 788+ 8854 FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 8857 29               add  hl, hl
 790+ 8858 29               add  hl, hl
 791+ 8859 29               add  hl, hl
 792+ 885A 29               add  hl, hl
 793+ 885B 29               add  hl, hl                    ; Row * 32
 794+ 885C 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 885D
 796+ 885D                  ; Aggiorna items_grid
 797+ 885D E5               push hl
 798+ 885E 11 DE E8         ld   de, items_grid
 799+ 8861 19               add  hl, de
 800+ 8862 70               ld   (hl), b
 801+ 8863 E1               pop  hl
 802+ 8864
 803+ 8864                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 8864 11 00 58         ld   de, COLOR_DATA
 805+ 8867 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 8868 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 8869
 808+ 8869              .next_anim_item:
 809+ 8869 01 05 00         ld   bc, 5
 810+ 886C FD 09            add  iy, bc
 811+ 886E 18 C4            jr   .anim_loop
 812+ 8870
 813+ 8870              .anim_done:
 814+ 8870 FD E1            pop  iy
 815+ 8872 C1               pop  bc
 816+ 8873 D1               pop  de
 817+ 8874 E1               pop  hl
 818+ 8875 C9               ret

 736+ 87EA 3A C9 F0         ld   a, (player_score + 0)
 737+ 87ED 32 CC F0         ld   (high_score + 0), a
 738+ 87F0 3A CA F0         ld   a, (player_score + 1)
 739+ 87F3 32 CD F0         ld   (high_score + 1), a
 740+ 87F6 3A CB F0         ld   a, (player_score + 2)
 741+ 87F9 32 CE F0         ld   (high_score + 2), a

  86+ E5EB              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  87+ E5EB 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  88+ E5EE 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  89+ E5F1 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  90+ E5F2 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  91+ E5F3 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  92+ E5F4 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  93+ E5F5 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  94+ E5F6 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  95+ E5F7
  96+ E5F7 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)

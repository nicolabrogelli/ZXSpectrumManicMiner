 779+ 8941 E6 03            and  $03                       ; Isola offset rotazione
 780+ 8943 80               add  a, b                      ; A = Nuovo attributo
 781+ 8944 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 8947 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8948
 784+ 8948                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8948 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 894B 16 00            ld   d, 0
 787+ 894D 26 00            ld   h, 0

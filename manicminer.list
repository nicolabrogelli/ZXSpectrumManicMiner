 251  897E 32 D0 ED         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 252  8981 3E 01            ld   a, 1
 253  8983 32 58 EA         ld   (on_ground), a
 254  8986
 255  8986 3E 00            ld   a, RESPAWN_SAFETY_TIME
 256  8988 32 55 EE         ld   (willy_safety_timer), a
 257  898B
 258  898B                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 259  898B C3 71 88         jp   LoadRoomAndRestart
 260  898E
 261  898E              .draw_raster_bars:
 262  898E                  ; Collisione attiva: disegna le raster bar nel bordo
 263  898E 3A 6A EA         ld   a, (counter)
 264  8991 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 265  8993 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  8995              .raster_loop:
 267  8995 D3 FE            out  ($fe), a
 268  8997 3C               inc  a
 269  8998 E6 07            and  7
 270  899A 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  899C              .delay:
 272  899C 0D               dec  c
 273  899D 20 FD            jr   nz, .delay
 274  899F 10 F4            djnz .raster_loop
 275  89A1
 276  89A1                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  89A1 3A 55 EA         ld   a, (room_border_color)
 278  89A4 D3 FE            out  ($fe), a
 279  89A6 18 05            jr   .no_collision_change
 280  89A8
 281  89A8              .no_collision:
 282  89A8                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 283  89A8 3A 55 EA         ld   a, (room_border_color)
 284  89AB D3 FE            out  ($fe), a
 285  89AD
 286  89AD              .no_collision_change:
 287  89AD C3 D4 88         jp   Main_loop
 288  89B0
 289  89B0              ; -------------------------------------------------------------------
 290  89B0              ; ShowTitleScreen
 291  89B0              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  89B0              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  89B0              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  89B0              ; -------------------------------------------------------------------
 295  89B0              ShowTitleScreen:
 296  89B0                  ; 1. Disegna la schermata iniziale
 297  89B0 CD 7A 64         call Gfx_DrawTitleScreen
 298  89B3
 299  89B3                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  89B3              .wait_title_enter_release:
 301  89B3 76               halt
 302  89B4 3E BF            ld   a, $bf
 303  89B6 DB FE            in   a, ($fe)
 304  89B8 1F               rra
 305  89B9 30 F8            jr   nc, .wait_title_enter_release
 306  89BB
 307  89BB                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  89BB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  89BD              .title_loop:
 310  89BD 76               halt
 311  89BE
 312  89BE                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  89BE 0C               inc  c
 314  89BF 79               ld   a, c
 315  89C0 CB 3F            srl  a
 316  89C2 CB 3F            srl  a
 317  89C4 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  89C6 E6 07            and  7
 319  89C8 5F               ld   e, a
 320  89C9 16 00            ld   d, 0
 321  89CB 21 72 64         ld   hl, title_color_table
 322  89CE 19               add  hl, de
 323  89CF 7E               ld   a, (hl)               ; A = nuovo colore
 324  89D0 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  89D3 06 20            ld   b, 32
 326  89D5              .color_title_loop:
 327  89D5 77               ld   (hl), a
 328  89D6 23               inc  hl
 329  89D7 10 FC            djnz .color_title_loop
 330  89D9
 331  89D9                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  89D9 3E BF            ld   a, $bf
 333  89DB DB FE            in   a, ($fe)
 334  89DD 1F               rra
 335  89DE 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  89E0
 337  89E0                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  89E0              .wait_title_enter_release_after:
 339  89E0 76               halt
 340  89E1 3E BF            ld   a, $bf
 341  89E3 DB FE            in   a, ($fe)
 342  89E5 1F               rra
 343  89E6 30 F8            jr   nc, .wait_title_enter_release_after
 344  89E8
 345  89E8                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  89E8 AF               xor  a
 347  89E9 D3 FE            out  ($fe), a              ; Bordo a nero
 348  89EB CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  89EE
 350  89EE                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  89EE CD AF 8B         call ResetFullGameState
 352  89F1
 353  89F1                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  89F1 C3 71 88         jp   LoadRoomAndRestart
 355  89F4
 356  89F4              ; -------------------------------------------------------------------
 357  89F4              ; TriggerGameOver
 358  89F4              ; Scatena la sequenza originale di Game Over:
 359  89F4              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  89F4              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  89F4              ;   con suono beeper originale e lampeggio dello schermo.
 362  89F4              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  89F4              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  89F4              ; -------------------------------------------------------------------
 365  89F4              TriggerGameOver:
 366  89F4                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  89F4 CD 5B 87         call Score_CheckAndUpdateHighScore
 368  89F7
 369  89F7                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  89F7 CD 12 66         call Gfx_DrawGameOverScreen
 371  89FA
 372  89FA                  ; 3. Ritorna al Title Screen originale
 373  89FA C3 B0 89         jp   ShowTitleScreen
 374  89FD
 375  89FD              ; -------------------------------------------------------------------
 376  89FD              ; TriggerVictory
 377  89FD              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  89FD              ; - Pulisce gli elementi di gioco della stanza.
 379  89FD              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  89FD              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  89FD              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  89FD              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  89FD              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  89FD              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  89FD              ; -------------------------------------------------------------------
 386  89FD              TriggerVictory:
 387  89FD                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  89FD CD FD 66         call Gfx_DrawVictoryScreen
 389  8A00
 390  8A00                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8A00              .wait_keys_release:
 392  8A00 76               halt
 393  8A01                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8A01 01 FE DF         ld   bc, $dffe
 395  8A04 ED 78            in   a, (c)
 396  8A06 CB 67            bit  4, a
 397  8A08 28 F6            jr   z, .wait_keys_release
 398  8A0A
 399  8A0A                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8A0A 01 FE 7F         ld   bc, $7ffe
 401  8A0D ED 78            in   a, (c)
 402  8A0F CB 5F            bit  3, a
 403  8A11 28 ED            jr   z, .wait_keys_release
 404  8A13
 405  8A13                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8A13 01 FE BF         ld   bc, $bffe
 407  8A16 ED 78            in   a, (c)
 408  8A18 CB 47            bit  0, a
 409  8A1A 28 E4            jr   z, .wait_keys_release
 410  8A1C
 411  8A1C                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8A1C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8A1E              .wait_choice_loop:
 414  8A1E 76               halt
 415  8A1F
 416  8A1F                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8A1F 0C               inc  c
 418  8A20 79               ld   a, c
 419  8A21 CB 3F            srl  a
 420  8A23 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8A25 E6 07            and  7
 422  8A27 5F               ld   e, a
 423  8A28 16 00            ld   d, 0
 424  8A2A 21 F4 65         ld   hl, victory_color_table
 425  8A2D 19               add  hl, de
 426  8A2E 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8A2F 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8A32 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8A34              .color_cycle_loop:
 430  8A34 77               ld   (hl), a
 431  8A35 23               inc  hl
 432  8A36 10 FC            djnz .color_cycle_loop
 433  8A38
 434  8A38                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8A38 01 FE DF         ld   bc, $dffe
 436  8A3B ED 78            in   a, (c)
 437  8A3D CB 67            bit  4, a
 438  8A3F 28 2A            jr   z, .play_again_chosen
 439  8A41
 440  8A41                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8A41 01 FE 7F         ld   bc, $7ffe
 442  8A44 ED 78            in   a, (c)
 443  8A46 CB 5F            bit  3, a
 444  8A48 28 0B            jr   z, .quit_chosen
 445  8A4A
 446  8A4A                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8A4A 01 FE BF         ld   bc, $bffe
 448  8A4D ED 78            in   a, (c)
 449  8A4F CB 47            bit  0, a
 450  8A51 28 02            jr   z, .quit_chosen
 451  8A53
 452  8A53 18 C9            jr   .wait_choice_loop
 453  8A55
 454  8A55              .quit_chosen:
 455  8A55                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8A55              .wait_quit_release:
 457  8A55 76               halt
 458  8A56 01 FE 7F         ld   bc, $7ffe
 459  8A59 ED 78            in   a, (c)
 460  8A5B CB 5F            bit  3, a
 461  8A5D 28 F6            jr   z, .wait_quit_release
 462  8A5F 01 FE BF         ld   bc, $bffe
 463  8A62 ED 78            in   a, (c)
 464  8A64 CB 47            bit  0, a
 465  8A66 28 ED            jr   z, .wait_quit_release
 466  8A68
 467  8A68                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8A68 C3 B0 89         jp   ShowTitleScreen
 469  8A6B
 470  8A6B              .play_again_chosen:
 471  8A6B                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8A6B              .wait_play_again_release:
 473  8A6B 76               halt
 474  8A6C 01 FE DF         ld   bc, $dffe
 475  8A6F ED 78            in   a, (c)
 476  8A71 CB 67            bit  4, a
 477  8A73 28 F6            jr   z, .wait_play_again_release
 478  8A75
 479  8A75                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8A75 CD AF 8B         call ResetFullGameState
 481  8A78 C3 71 88         jp   LoadRoomAndRestart
 482  8A7B
 483  8A7B              ; -------------------------------------------------------------------
 484  8A7B              ; CheckPortalTransition
 485  8A7B              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8A7B              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8A7B              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8A7B              ;
 489  8A7B              ; Output:
 490  8A7B              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8A7B              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8A7B              ; -------------------------------------------------------------------
 493  8A7B              CheckPortalTransition:
 494  8A7B C5               push bc
 495  8A7C D5               push de
 496  8A7D E5               push hl
 497  8A7E
 498  8A7E                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8A7E CD 42 8B         call CheckAllItemsCollected
 500  8A81 30 4D            jr   nc, .no_transition
 501  8A83
 502  8A83                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8A83                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8A83                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8A83 2A CA ED         ld   hl, (room_ptr)
 506  8A86 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8A89 19               add  hl, de
 508  8A8A 4E               ld   c, (hl)
 509  8A8B 23               inc  hl
 510  8A8C 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8A8D
 512  8A8D                  ; Offset = BC - 23552
 513  8A8D 60               ld   h, b
 514  8A8E 69               ld   l, c
 515  8A8F 01 00 A4         ld   bc, -23552
 516  8A92 09               add  hl, bc
 517  8A93
 518  8A93                  ; PortalX = (Offset & 31) * 8
 519  8A93 7D               ld   a, l
 520  8A94 E6 1F            and  31
 521  8A96 87               add  a, a
 521  8A97 87             add a, a
 521  8A98 87             add a, a
 522  8A99 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8A9A
 524  8A9A                  ; PortalY = (Offset / 32) * 8
 525  8A9A CB 3C            srl  h
 525  8A9C CB 1D          rr l
 526  8A9E CB 3C            srl  h
 526  8AA0 CB 1D          rr l
 527  8AA2 CB 3C            srl  h
 527  8AA4 CB 1D          rr l
 528  8AA6 CB 3C            srl  h
 528  8AA8 CB 1D          rr l
 529  8AAA CB 3C            srl  h
 529  8AAC CB 1D          rr l
 530  8AAE 7D               ld   a, l
 531  8AAF 87               add  a, a
 531  8AB0 87             add a, a
 531  8AB1 87             add a, a
 532  8AB2 57               ld   d, a                      ; D = PortalY (0..120)
 533  8AB3
 534  8AB3                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8AB3 ED 4B 49 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8AB7
 537  8AB7                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8AB7 7B               ld   a, e
 539  8AB8 91               sub  c
 540  8AB9 30 02            jr   nc, .x_diff_pos
 541  8ABB ED 44            neg
 542  8ABD              .x_diff_pos:
 543  8ABD FE 0C            cp   12
 544  8ABF 30 0F            jr   nc, .no_transition
 545  8AC1
 546  8AC1                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8AC1 7A               ld   a, d
 548  8AC2 90               sub  b
 549  8AC3 30 02            jr   nc, .y_diff_pos
 550  8AC5 ED 44            neg
 551  8AC7              .y_diff_pos:
 552  8AC7 FE 0E            cp   14
 553  8AC9 30 05            jr   nc, .no_transition
 554  8ACB
 555  8ACB                  ; Transizione al portale attiva!
 556  8ACB E1               pop  hl
 557  8ACC D1               pop  de
 558  8ACD C1               pop  bc
 559  8ACE 37               scf
 560  8ACF C9               ret
 561  8AD0
 562  8AD0              .no_transition:
 563  8AD0 E1               pop  hl
 564  8AD1 D1               pop  de
 565  8AD2 C1               pop  bc
 566  8AD3 B7               or   a
 567  8AD4 C9               ret
 568  8AD5
 569  8AD5              ; Alias per retrocompatibilità
 570  8AD5              CheckVictoryCondition: EQU CheckPortalTransition
 571  8AD5
 572  8AD5              ; -------------------------------------------------------------------
 573  8AD5              ; TriggerPortalTransition
 574  8AD5              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8AD5              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8AD5              ; - Avanza all'indice della stanza successiva.
 577  8AD5              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8AD5              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8AD5              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8AD5              ; -------------------------------------------------------------------
 581  8AD5              TriggerPortalTransition:
 582  8AD5                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8AD5 CD 0C 8B         call Air_DepleteCountdown
 584  8AD8
 585  8AD8                  ; 1. Determina l'ID della stanza corrente
 586  8AD8 CD 9C 84         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8ADB
 588  8ADB                  ; 2. Calcola l'indice della stanza successiva
 589  8ADB 3A 6F ED         ld   a, (current_room)
 590  8ADE 3C               inc  a
 591  8ADF FE 14            cp   NUM_ROOMS
 592  8AE1 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8AE3
 594  8AE3                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8AE3 21 8E 73         ld   hl, RoomsListTable
 596  8AE6 5F               ld   e, a
 597  8AE7 16 00            ld   d, 0
 598  8AE9 19               add  hl, de
 599  8AEA 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8AEB 5E               ld   e, (hl)
 601  8AEC 23               inc  hl
 602  8AED 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8AEE ED 53 CA ED      ld   (room_ptr), de
 604  8AF2
 605  8AF2                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8AF2 AF               xor  a
 607  8AF3 32 D0 ED         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8AF6 32 57 EA         ld   (velocity_y), a
 609  8AF9 32 62 F0         ld   (game_objective_completed), a
 610  8AFC 3E 01            ld   a, 1
 611  8AFE 32 58 EA         ld   (on_ground), a
 612  8B01
 613  8B01                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8B01 3E 07            ld   a, $07
 615  8B03 CD 9D 62         call Gfx_ClearScreenDirect
 616  8B06
 617  8B06 C3 71 88         jp   LoadRoomAndRestart
 618  8B09
 619  8B09              .all_rooms_completed:
 620  8B09                  ; Tutte le stanze sono state completate con successo!
 621  8B09                  IF ENABLE_VICTORY_SCREEN != 0
 622  8B09 C3 FD 89         jp   TriggerVictory
 623  8B0C                  ELSE
 624  8B0C ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8B0C ~                ld   de, (RoomsListTable)
 626  8B0C ~                ld   (room_ptr), de
 627  8B0C ~                xor  a
 628  8B0C ~                ld   (transition_active), a
 629  8B0C ~                ld   (velocity_y), a
 630  8B0C ~                ld   (game_objective_completed), a
 631  8B0C ~                ld   a, 1
 632  8B0C ~                ld   (on_ground), a
 633  8B0C ~                ld   a, $07
 634  8B0C ~                call Gfx_ClearScreenDirect
 635  8B0C ~                jp   LoadRoomAndRestart
 636  8B0C                  ENDIF
 637  8B0C
 638  8B0C              ; -------------------------------------------------------------------
 639  8B0C              ; Air_DepleteCountdown
 640  8B0C              ; Animazione originale di completamento livello (Manic Miner):
 641  8B0C              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8B0C              ; - Ad ogni pixel decrementato:
 643  8B0C              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8B0C              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8B0C              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8B0C              ; -------------------------------------------------------------------
 647  8B0C              Air_DepleteCountdown:
 648  8B0C F5               push af
 649  8B0D C5               push bc
 650  8B0E D5               push de
 651  8B0F E5               push hl
 652  8B10
 653  8B10              .countdown_loop:
 654  8B10 3A 6B F0         ld   a, (air_pixels)
 655  8B13 B7               or   a
 656  8B14 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8B16
 658  8B16 3D               dec  a
 659  8B17 32 6B F0         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8B1A
 661  8B1A                  ; Aggiorna la barra grafica dell'aria
 662  8B1A CD 2D 6A         call Gfx_UpdateAirBar
 663  8B1D
 664  8B1D                  ; Aggiungi 1 punto allo score
 665  8B1D CD 10 87         call Score_Add1Point
 666  8B20
 667  8B20                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8B20                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8B20 3A 6B F0         ld   a, (air_pixels)
 670  8B23 2F               cpl
 671  8B24 E6 3F            and  63
 672  8B26 07               rlca
 673  8B27 3C               inc  a
 674  8B28 57               ld   d, a                      ; D = ritardo semionda audio
 675  8B29
 676  8B29 0E 03            ld   c, 3                      ; Durata impulso
 677  8B2B              .audio_loop:
 678  8B2B AF               xor  a
 679  8B2C D3 FE            out  ($fe), a
 680  8B2E 42               ld   b, d
 681  8B2F 10 FE        .w1: djnz .w1
 682  8B31

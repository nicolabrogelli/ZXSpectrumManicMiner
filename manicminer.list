 979+ 77E3                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77E3 5F               ld   e, a              ; E = r (Row)
 981+ 77E4 79               ld   a, c
 982+ 77E5 CB 3F            srl  a
 983+ 77E7 CB 3F            srl  a

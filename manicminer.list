1668+ 7ABF              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1669+ 7ABF              ; Input: C = X, B = Y
1670+ 7ABF              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1671+ 7ABF              ; -------------------------------------------------------------------
1672+ 7ABF              CheckNastyCell:
1673+ 7ABF E5               push hl
1674+ 7AC0 D5               push de
1675+ 7AC1 C5               push bc
1676+ 7AC2
1677+ 7AC2                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1678+ 7AC2 78               ld   a, b
1679+ 7AC3 FE 80            cp   128
1680+ 7AC5 30 1B            jr   nc, .not_nasty
1681+ 7AC7
1682+ 7AC7                  ; 2. Calcola riga di layout: r = Y / 8
1683+ 7AC7 CB 3F            srl  a
1684+ 7AC9 CB 3F            srl  a
1685+ 7ACB CB 3F            srl  a                 ; A = r (0..15)
1686+ 7ACD
1687+ 7ACD                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1688+ 7ACD 5F               ld   e, a              ; E = r
1689+ 7ACE 79               ld   a, c
1690+ 7ACF CB 3F            srl  a
1691+ 7AD1 CB 3F            srl  a
1692+ 7AD3 CB 3F            srl  a                 ; A = c (0..31)
1693+ 7AD5 4F               ld   c, a              ; C = c
1694+ 7AD6 7B               ld   a, e              ; A = r
1695+ 7AD7
1696+ 7AD7 CD 68 78         call GetCellFromUnpacked ; A = cell type

 959+ 77D5              ; -------------------------------------------------------------------
 960+ 77D5              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 961+ 77D5              ; Input: C = X, B = Y
 962+ 77D5              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 963+ 77D5              ; -------------------------------------------------------------------
 964+ 77D5              CheckWallCell:
 965+ 77D5 E5               push hl
 966+ 77D6 D5               push de
 967+ 77D7 C5               push bc
 968+ 77D8
 969+ 77D8                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77D8 78               ld   a, b
 971+ 77D9 FE 80            cp   128
 972+ 77DB 30 1F            jr   nc, .not_wall
 973+ 77DD
 974+ 77DD                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77DD CB 3F            srl  a
 976+ 77DF CB 3F            srl  a
 977+ 77E1 CB 3F            srl  a                 ; A = r (0..15)
 978+ 77E3
 979+ 77E3                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77E3 5F               ld   e, a              ; E = r (Row)
 981+ 77E4 79               ld   a, c
 982+ 77E5 CB 3F            srl  a
 983+ 77E7 CB 3F            srl  a
 984+ 77E9 CB 3F            srl  a                 ; A = c (0..31)
 985+ 77EB 4F               ld   c, a              ; C = c (Col)
 986+ 77EC
 987+ 77EC                  ; Se la cella è sulla rampa, non considerarla un muro!
 988+ 77EC 53               ld   d, e              ; D = Row
 989+ 77ED 59               ld   e, c              ; E = Col
 990+ 77EE CD 5A 77         call IsCellOnRamp
 991+ 77F1 38 09            jr   c, .not_wall
 992+ 77F3
 993+ 77F3 7A               ld   a, d              ; A = Row
 994+ 77F4 4B               ld   c, e              ; C = Col
 995+ 77F5 CD 91 78         call GetCellFromUnpacked ; A = cell type
 996+ 77F8
 997+ 77F8                  ; Controlla se è Wall (3)
 998+ 77F8 FE 03            cp   3

 199+ 8463 3A 4C AB         ld   a, (room_border_color)
 200+ 8466 E6 EF            and  $ef              ; speaker OFF
 201+ 8468 D3 FE            out  ($fe), a
 202+ 846A
 203+ 846A 0E 3C            ld   c, 60
 204+ 846C              .d2:
 205+ 846C 0D               dec  c
 206+ 846D 20 FD            jr   nz, .d2
 207+ 846F
 208+ 846F 10 E6            djnz .sound_loop

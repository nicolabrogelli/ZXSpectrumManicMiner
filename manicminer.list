 636  830A
 637  830A              ; -------------------------------------------------------------------
 638  830A              ; CheckPortalTransition
 639  830A              ; Verifica le condizioni per accedere alla stanza successiva:
 640  830A              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 641  830A              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 642  830A              ;
 643  830A              ; Output:
 644  830A              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 645  830A              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 646  830A              ; -------------------------------------------------------------------
 647  830A              CheckPortalTransition:
 648  830A C5               push bc
 649  830B D5               push de
 650  830C E5               push hl
 651  830D
 652  830D                  ; 1. Tutti gli item della stanza sono stati raccolti?
 653  830D CD 9B 83         call CheckAllItemsCollected
 654  8310 30 4D            jr   nc, .no_transition
 655  8312
 656  8312                  ; 2. Willy collide con il portale (16x16 pixel)?
 657  8312                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 658  8312                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 659  8312 2A 2D 96         ld   hl, (room_ptr)
 660  8315 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 661  8318 19               add  hl, de
 662  8319 4E               ld   c, (hl)
 663  831A 23               inc  hl
 664  831B 46               ld   b, (hl)                   ; BC = AttrAddr
 665  831C
 666  831C                  ; Offset = BC - 23552
 667  831C 60               ld   h, b
 668  831D 69               ld   l, c
 669  831E 01 00 A4         ld   bc, -23552
 670  8321 09               add  hl, bc
 671  8322
 672  8322                  ; PortalX = (Offset & 31) * 8
 673  8322 7D               ld   a, l
 674  8323 E6 1F            and  31
 675  8325 87               add  a, a
 675  8326 87             add a, a
 675  8327 87             add a, a
 676  8328 5F               ld   e, a                      ; E = PortalX (0..248)
 677  8329
 678  8329                  ; PortalY = (Offset / 32) * 8
 679  8329 CB 3C            srl  h
 679  832B CB 1D          rr l
 680  832D CB 3C            srl  h
 680  832F CB 1D          rr l
 681  8331 CB 3C            srl  h
 681  8333 CB 1D          rr l
 682  8335 CB 3C            srl  h
 682  8337 CB 1D          rr l
 683  8339 CB 3C            srl  h
 683  833B CB 1D          rr l
 684  833D 7D               ld   a, l
 685  833E 87               add  a, a
 685  833F 87             add a, a
 685  8340 87             add a, a
 686  8341 57               ld   d, a                      ; D = PortalY (0..120)
 687  8342
 688  8342                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 689  8342 ED 4B AD 92      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 690  8346
 691  8346                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 692  8346 7B               ld   a, e
 693  8347 91               sub  c
 694  8348 30 02            jr   nc, .x_diff_pos
 695  834A ED 44            neg

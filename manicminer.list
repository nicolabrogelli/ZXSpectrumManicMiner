 181+ 871E              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 871E              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 871E              ; -------------------------------------------------------------------
 184+ 871E              Audio_PlayCollectSound:
 185+ 871E C5               push bc
 186+ 871F D5               push de
 187+ 8720
 188+ 8720 06 78            ld   b, 120
 189+ 8722              .sound_loop:
 190+ 8722 3A 1E E2         ld   a, (room_border_color)
 191+ 8725 F6 10            or   $10               ; speaker ON
 192+ 8727 D3 FE            out  ($fe), a
 193+ 8729
 194+ 8729 0E 3C            ld   c, 60
 195+ 872B              .d1:
 196+ 872B 0D               dec  c
 197+ 872C 20 FD            jr   nz, .d1
 198+ 872E
 199+ 872E 3A 1E E2         ld   a, (room_border_color)
 200+ 8731 E6 EF            and  $ef              ; speaker OFF
 201+ 8733 D3 FE            out  ($fe), a
 202+ 8735
 203+ 8735 0E 3C            ld   c, 60
 204+ 8737              .d2:
 205+ 8737 0D               dec  c
 206+ 8738 20 FD            jr   nz, .d2
 207+ 873A
 208+ 873A 10 E6            djnz .sound_loop
 209+ 873C
 210+ 873C D1               pop  de
 211+ 873D C1               pop  bc
 212+ 873E C9               ret
 213+ 873F

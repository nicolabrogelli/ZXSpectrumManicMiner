   7+ 8361              ; -------------------------------------------------------------------
   8+ 8361              ; Audio_UpdateJumpSound
   9+ 8361              ;
  10+ 8361              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8361              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8361              ; -------------------------------------------------------------------
  13+ 8361              Audio_UpdateJumpSound:
  14+ 8361 F5               push af
  15+ 8362 C5               push bc
  16+ 8363 D5               push de
  17+ 8364 E5               push hl
  18+ 8365
  19+ 8365                  ; Controlla se il suono è attivo (note < 18)
  20+ 8365 3A 85 B0         ld   a, (Audio_jump_sound_note)
  21+ 8368 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 836A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 836C
  24+ 836C                  ; Carica la nota corrente da suonare
  25+ 836C 5F               ld   e, a
  26+ 836D 16 00            ld   d, 0
  27+ 836F 21 9B 83         ld   hl, Audio_JumpSoundDelays
  28+ 8372 19               add  hl, de
  29+ 8373 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8374 57               ld   d, a                      ; D = delay della nota
  31+ 8375
  32+ 8375                  ; Suona la nota: 15 cicli
  33+ 8375 06 0F            ld   b, 15
  34+ 8377              .note_loop:
  35+ 8377                  ; Speaker ON
  36+ 8377 3A 75 AA         ld   a, (room_border_color)
  37+ 837A F6 10            or   $10
  38+ 837C D3 FE            out  ($fe), a
  39+ 837E 4A               ld   c, d
  40+ 837F              .d1:
  41+ 837F 0D               dec  c
  42+ 8380 20 FD            jr   nz, .d1
  43+ 8382
  44+ 8382                  ; Speaker OFF
  45+ 8382 3A 75 AA         ld   a, (room_border_color)
  46+ 8385 E6 EF            and  $ef
  47+ 8387 D3 FE            out  ($fe), a
  48+ 8389 4A               ld   c, d
  49+ 838A              .d2:
  50+ 838A 0D               dec  c
  51+ 838B 20 FD            jr   nz, .d2
  52+ 838D
  53+ 838D 10 E8            djnz .note_loop
  54+ 838F
  55+ 838F                  ; Passa alla nota successiva
  56+ 838F 3A 85 B0         ld   a, (Audio_jump_sound_note)
  57+ 8392 3C               inc  a
  58+ 8393 32 85 B0         ld   (Audio_jump_sound_note), a
  59+ 8396
  60+ 8396              .done:
  61+ 8396 E1               pop  hl
  62+ 8397 D1               pop  de
  63+ 8398 C1               pop  bc
  64+ 8399 F1               pop  af
  65+ 839A C9               ret
  66+ 839B
  67+ 839B              Audio_JumpSoundDelays:
  68+ 839B 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 839F 19 13 0C 06
  68+ 83A3 0C 13 19 20
  68+ 83A7 26 2D 33 3A
  68+ 83AB 40 47

 357+ 7E75              ; Enemy_DrawSingleSlot
 358+ 7E75              ;
 359+ 7E75              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 360+ 7E75              ; La grafica (8 frame da 32 byte) è letta direttamente da
 361+ 7E75              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 362+ 7E75              ; -------------------------------------------------------------------
 363+ 7E75              Enemy_DrawSingleSlot:
 364+ 7E75 C5               push bc
 365+ 7E76 D5               push de
 366+ 7E77 E5               push hl
 367+ 7E78 DD E5            push ix
 368+ 7E7A
 369+ 7E7A                  ; 1. Salva subito le coordinate X e Y dal record IX
 370+ 7E7A DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 371+ 7E7D DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 372+ 7E80
 373+ 7E80                  ; Controlla se è guardiano verticale

 287  869B              ; -------------------------------------------------------------------
 288  869B              ; ShowTitleScreen
 289  869B              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  869B              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  869B              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  869B              ; -------------------------------------------------------------------
 293  869B              ShowTitleScreen:
 294  869B                  ; 1. Disegna la schermata iniziale
 295  869B CD 76 64         call Gfx_DrawTitleScreen
 296  869E
 297  869E                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  869E              .wait_title_enter_release:
 299  869E 76               halt
 300  869F 3E BF            ld   a, $bf
 301  86A1 DB FE            in   a, ($fe)
 302  86A3 1F               rra
 303  86A4 30 F8            jr   nc, .wait_title_enter_release
 304  86A6
 305  86A6                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  86A6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  86A8              .title_loop:
 308  86A8 76               halt
 309  86A9
 310  86A9                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  86A9 0C               inc  c
 312  86AA 79               ld   a, c
 313  86AB CB 3F            srl  a
 314  86AD CB 3F            srl  a
 315  86AF CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  86B1 E6 07            and  7
 317  86B3 5F               ld   e, a
 318  86B4 16 00            ld   d, 0
 319  86B6 21 6E 64         ld   hl, title_color_table
 320  86B9 19               add  hl, de
 321  86BA 7E               ld   a, (hl)               ; A = nuovo colore
 322  86BB 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  86BE 06 20            ld   b, 32
 324  86C0              .color_title_loop:
 325  86C0 77               ld   (hl), a
 326  86C1 23               inc  hl
 327  86C2 10 FC            djnz .color_title_loop
 328  86C4
 329  86C4                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  86C4 3E BF            ld   a, $bf
 331  86C6 DB FE            in   a, ($fe)
 332  86C8 1F               rra
 333  86C9 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  86CB
 335  86CB                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  86CB              .wait_title_enter_release_after:
 337  86CB 76               halt
 338  86CC 3E BF            ld   a, $bf
 339  86CE DB FE            in   a, ($fe)
 340  86D0 1F               rra
 341  86D1 30 F8            jr   nc, .wait_title_enter_release_after
 342  86D3
 343  86D3                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  86D3 AF               xor  a
 345  86D4 D3 FE            out  ($fe), a              ; Bordo a nero
 346  86D6 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  86D9
 348  86D9                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 349  86D9 CD 40 89         call ResetFullGameState

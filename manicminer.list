1217+ 64B8 11 40 5A         ld   de, $5a40             ; Indirizzo attributi riga 18
1218+ 64BB 01 20 00         ld   bc, 32
1219+ 64BE ED B0            ldir
1220+ 64C0
1221+ 64C0                  ; 7. Animazione: Discesa fluida di PiedeSprite dall'alto (Y=0) fino a Y=96 (alla parte alta della Botte)
1222+ 64C0 06 00            ld   b, 0                  ; B = Y iniziale (0)
1223+ 64C2              .foot_descent_loop:
1224+ 64C2 C5               push bc                    ; Salva B = Y corrente
1225+ 64C3
1226+ 64C3                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1227+ 64C3 78               ld   a, b
1228+ 64C4 B7               or   a
1229+ 64C5 28 1F            jr   z, .skip_clear_prev
1230+ 64C7 D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1231+ 64C9 47               ld   b, a
1232+ 64CA 0E 78            ld   c, 120                ; X = 120
1233+ 64CC CD 0A 61         call Gfx_Clear16x16_Black
1234+ 64CF
1235+ 64CF                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1236+ 64CF 78               ld   a, b
1237+ 64D0 CB 3F            srl  a
1238+ 64D2 CB 3F            srl  a
1239+ 64D4 CB 3F            srl  a                     ; A = Row da azzerare
1240+ 64D6 6F               ld   l, a
1241+ 64D7 26 00            ld   h, 0
1242+ 64D9 29               add  hl, hl                ; * 2
1243+ 64DA 29               add  hl, hl                ; * 4
1244+ 64DB 29               add  hl, hl                ; * 8
1245+ 64DC 29               add  hl, hl                ; * 16
1246+ 64DD 29               add  hl, hl                ; * 32
1247+ 64DE 11 0F 58         ld   de, $580f             ; $5800 + 15
1248+ 64E1 19               add  hl, de
1249+ 64E2 AF               xor  a
1250+ 64E3 77               ld   (hl), a               ; Col 15 = 0
1251+ 64E4 23               inc  hl
1252+ 64E5 77               ld   (hl), a               ; Col 16 = 0
1253+ 64E6
1254+ 64E6              .skip_clear_prev:
1255+ 64E6 C1               pop  bc                    ; Ripristina B = Y corrente
1256+ 64E7 C5               push bc
1257+ 64E8
1258+ 64E8                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1259+ 64E8 78               ld   a, b
1260+ 64E9 FE 60            cp   96
1261+ 64EB 20 09            jr   nz, .draw_foot
1262+ 64ED C5               push bc
1263+ 64EE 0E 78            ld   c, 120
1264+ 64F0 06 60            ld   b, 96
1265+ 64F2 CD 0A 61         call Gfx_Clear16x16_Black
1266+ 64F5 C1               pop  bc
1267+ 64F6
1268+ 64F6              .draw_foot:

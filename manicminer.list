 374+ 6CD6 67               ld   h, a
 375+ 6CD7 69               ld   l, c
 376+ 6CD8 01 00 A4         ld   bc, -23552
 377+ 6CDB 09               add  hl, bc
 378+ 6CDC 7D               ld   a, l
 379+ 6CDD E6 1F            and  31
 380+ 6CDF 87               add  a, a
 381+ 6CE0 87               add  a, a
 382+ 6CE1 87               add  a, a                      ; Col * 8 = Pixel X
 383+ 6CE2 4F               ld   c, a                      ; C = PlayerX
 384+ 6CE3 F1               pop  af                        ; A = PlayerY
 385+ 6CE4 47               ld   b, a                      ; B = PlayerY

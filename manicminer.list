 161+ 7C53              ; -------------------------------------------------------------------
 162+ 7C53              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7C53              ; -------------------------------------------------------------------
 164+ 7C53              CheckEnemyWillyOverlap:
 165+ 7C53 3A 71 98         ld   a, (player_drawn_pos+1)
 166+ 7C56 FE FF            cp   $FF
 167+ 7C58 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7C59
 169+ 7C59                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7C59 3A 70 98         ld   a, (player_drawn_pos)
 171+ 7C5C E6 F8            and  $F8
 172+ 7C5E 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7C5F 79               ld   a, c
 174+ 7C60 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7C62 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7C63 C6 10            add  a, 16
 177+ 7C65 FE 19            cp   25
 178+ 7C67 D0               ret  nc                 ; Fuori portata X
 179+ 7C68
 180+ 7C68                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7C68 3A 71 98         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7C6B 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7C6C C6 0F            add  a, 15
 184+ 7C6E FE 1F            cp   31
 185+ 7C70 D0               ret  nc                 ; Fuori portata Y
 186+ 7C71
 187+ 7C71                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7C71 3E 01            ld   a, 1
 189+ 7C73 32 76 98         ld   (willy_needs_redraw), a
 190+ 7C76 C9               ret

 726  858E              ; -------------------------------------------------------------------
 727  858E              ; TriggerPortalTransition
 728  858E              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 729  858E              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 730  858E              ; - Avanza all'indice della stanza successiva.
 731  858E              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 732  858E              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 733  858E              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 734  858E              ; -------------------------------------------------------------------
 735  858E              TriggerPortalTransition:
 736  858E                  ; 1. Determina l'ID della stanza corrente
 737  858E CD FA 7E         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 738  8591
 739  8591                  ; 2. Calcola l'indice della stanza successiva
 740  8591 3A FD 97         ld   a, (current_room)
 741  8594 3C               inc  a
 742  8595 FE 02            cp   NUM_ROOMS
 743  8597 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 744  8599
 745  8599                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 746  8599 21 09 72         ld   hl, RoomsListTable
 747  859C 5F               ld   e, a
 748  859D 16 00            ld   d, 0
 749  859F 19               add  hl, de
 750  85A0 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 751  85A1 5E               ld   e, (hl)
 752  85A2 23               inc  hl
 753  85A3 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 754  85A4 ED 53 57 98      ld   (room_ptr), de
 755  85A8
 756  85A8                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 757  85A8 AF               xor  a
 758  85A9 32 5D 98         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 759  85AC 32 E5 94         ld   (velocity_y), a
 760  85AF 32 EC 9A         ld   (game_objective_completed), a
 761  85B2 3E 01            ld   a, 1
 762  85B4 32 E6 94         ld   (on_ground), a
 763  85B7
 764  85B7                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 765  85B7 21 8D 5C         ld   hl, ATTR_P
 766  85BA 36 07            ld   (hl), $07
 767  85BC CD AF 0D         call CLS
 768  85BF
 769  85BF C3 4E 82         jp   LoadRoomAndRestart
 770  85C2
 771  85C2              .all_rooms_completed:
 772  85C2                  ; Tutte le stanze sono state completate con successo!
 773  85C2                  IF ENABLE_VICTORY_SCREEN != 0
 774  85C2 C3 B6 84         jp   TriggerVictory
 775  85C5                  ELSE
 776  85C5 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 777  85C5 ~                ld   de, (RoomsListTable)
 778  85C5 ~                ld   (room_ptr), de
 779  85C5 ~                xor  a
 780  85C5 ~                ld   (transition_active), a
 781  85C5 ~                ld   (velocity_y), a
 782  85C5 ~                ld   (game_objective_completed), a
 783  85C5 ~                ld   a, 1
 784  85C5 ~                ld   (on_ground), a
 785  85C5 ~                ld   hl, ATTR_P
 786  85C5 ~                ld   (hl), $07
 787  85C5 ~                call CLS
 788  85C5 ~                jp   LoadRoomAndRestart
 789  85C5                  ENDIF

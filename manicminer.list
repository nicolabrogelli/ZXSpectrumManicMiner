 101  84FC              Main_loop:
 102  84FC              .sync_loop:
 103  84FC 76               halt
 104  84FD 2A 61 AB         ld   hl, (counter)
 105  8500 ED 5B 64 AB      ld   de, (last_frame_counter)
 106  8504 B7               or   a
 107  8505 ED 52            sbc  hl, de
 108  8507 7D               ld   a, l
 109  8508 FE 02            cp   GAME_SPEED_DELAY
 110  850A 38 F0            jr   c, .sync_loop
 111  850C
 112  850C 2A 61 AB         ld   hl, (counter)
 113  850F 22 64 AB         ld   (last_frame_counter), hl
 114  8512
 115  8512                  ; Aggiorna il timer di sicurezza (invulnerabilità post-morte)
 116  8512 3A 4B AF         ld   a, (willy_safety_timer)
 117  8515 B7               or   a
 118  8516 28 04            jr   z, .no_safety_dec
 119  8518 3D               dec  a
 120  8519 32 4B AF         ld   (willy_safety_timer), a
 121  851C              .no_safety_dec:
 122  851C
 123  851C                  ; 1. Rendering atomico nemici ed estrazione sovrapposizioni
 124  851C CD 26 7E         call Enemy_RenderRoom
 125  851F
 126  851F                  ; 2. Rendering del giocatore (ridisegna Willy in primo piano se mosso o se coperto da un guardiano)
 127  851F CD 92 61         call Gfx_UpdatePlayer
 128  8522
 129  8522                  ; 3. Aggiorna animazione e rimozione dei pavimenti sgretolabili (Crumbling Floor)
 130  8522 CD 4B 7C         call Phys_UpdateCrumblingFloors
 131  8525
 132  8525                  ; 4. Aggiorna animazione lampeggio del portale (se attivo)
 133  8525 CD 08 6C         call Gfx_AnimatePortal
 134  8528
 135  8528                  ; 5b. Aggiorna consumo aria (morte se esaurita)
 136  8528 CD C3 7C         call Phys_UpdateAir
 137  852B DA 5B 85         jp   c, .willy_dies
 138  852E
 139  852E                  ; 6. Aggiornamento audio
 140  852E                  IF ENABLE_EFFECTS != 0
 141  852E ~                call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 142  852E                  ENDIF
 143  852E
 144  852E                  IF ENABLE_MUSIC != 0
 145  852E ~                call Audio_UpdateMusic        ; Aggiorna la musica
 146  852E                  ENDIF
 147  852E
 148  852E                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 149  852E                  IF ENABLE_ANIMATE_LIVES != 0
 150  852E ~                call Gfx_PrintWillyLives
 151  852E                  ENDIF
 152  852E
 153  852E
 154  852E                  ; 7. Salva le posizioni correnti del player per il prossimo frame
 155  852E ED 4B 40 AB      ld   bc, (PlayerPos)
 156  8532 ED 43 42 AB      ld   (PlayerPosOld), bc
 157  8536
 158  8536                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 159  8536 CD A7 70         call Input_CheckCtrl
 160  8539 CD BE 6E         call MovePlayer
 161  853C CD CB 73         call Phys_ApplyGravity
 162  853F CD 18 7F         call Enemy_Update
 163  8542 CD 1B 83         call Items_CheckCollision
 164  8545
 165  8545                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 166  8545 CD 9D 87         call CheckPortalTransition
 167  8548 DA F7 87         jp   c, TriggerPortalTransition
 168  854B
 169  854B                  ; Controlla collisione con Nasties (morte di Willy)
 170  854B                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 171  854B CD 91 7B         call Phys_CheckNastyCollision
 172  854E 38 0B            jr   c, .willy_dies
 173  8550                  ENDIF
 174  8550
 175  8550                  ; Controlla collisione con guardiani
 176  8550 CD F0 7F         call CheckCollision
 177  8553 38 03            jr   c, .guardian_collision_found
 178  8555
 179  8555                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 180  8555                  IF ENABLE_RAMP_DEBUG_BARS != 0
 181  8555 ~                ld   a, (willy_on_ramp)
 182  8555 ~                or   a
 183  8555 ~                jp   nz, .draw_raster_bars
 184  8555                  ENDIF
 185  8555
 186  8555 C3 D5 85         jp   .no_collision
 187  8558
 188  8558              .guardian_collision_found:
 189  8558                  ; C'è collisione con un guardiano!
 190  8558                  ; Controlla se la morte per collisione con i guardiani è abilitata
 191  8558                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 192  8558 C3 5B 85         jp   .willy_dies
 193  855B                  ELSE
 194  855B ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 195  855B ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 196  855B ~                    ELSE
 197  855B ~                    jp   .no_collision
 198  855B ~                    ENDIF
 199  855B                  ENDIF

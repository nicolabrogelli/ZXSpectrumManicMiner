 400  85F6 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 401  85F8 E6 07            and  7
 402  85FA 5F               ld   e, a
 403  85FB 16 00            ld   d, 0
 404  85FD 21 D1 65         ld   hl, game_over_color_table
 405  8600 19               add  hl, de
 406  8601 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  8602 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  8605 06 09            ld   b, 9

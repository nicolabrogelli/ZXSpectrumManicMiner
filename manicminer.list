   8+ 8311              ; Audio_UpdateJumpSound
   9+ 8311              ;
  10+ 8311              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8311              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8311              ; -------------------------------------------------------------------
  13+ 8311              Audio_UpdateJumpSound:
  14+ 8311 F5               push af
  15+ 8312 C5               push bc
  16+ 8313 D5               push de
  17+ 8314 E5               push hl
  18+ 8315
  19+ 8315                  ; Controlla se il suono è attivo (note < 18)
  20+ 8315 3A 6A A4         ld   a, (Audio_jump_sound_note)
  21+ 8318 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 831A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 831C
  24+ 831C                  ; Carica la nota corrente da suonare
  25+ 831C 5F               ld   e, a
  26+ 831D 16 00            ld   d, 0
  27+ 831F 21 4B 83         ld   hl, Audio_JumpSoundDelays
  28+ 8322 19               add  hl, de
  29+ 8323 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8324 57               ld   d, a                      ; D = delay della nota
  31+ 8325
  32+ 8325                  ; Suona la nota: 15 cicli
  33+ 8325 06 0F            ld   b, 15
  34+ 8327              .note_loop:
  35+ 8327                  ; Speaker ON
  36+ 8327 3A 5A 9E         ld   a, (room_border_color)
  37+ 832A F6 10            or   $10
  38+ 832C D3 FE            out  ($fe), a
  39+ 832E 4A               ld   c, d
  40+ 832F              .d1:
  41+ 832F 0D               dec  c
  42+ 8330 20 FD            jr   nz, .d1
  43+ 8332
  44+ 8332                  ; Speaker OFF
  45+ 8332 3A 5A 9E         ld   a, (room_border_color)
  46+ 8335 E6 EF            and  $ef
  47+ 8337 D3 FE            out  ($fe), a
  48+ 8339 4A               ld   c, d
  49+ 833A              .d2:
  50+ 833A 0D               dec  c
  51+ 833B 20 FD            jr   nz, .d2
  52+ 833D
  53+ 833D 10 E8            djnz .note_loop
  54+ 833F
  55+ 833F                  ; Passa alla nota successiva
  56+ 833F 3A 6A A4         ld   a, (Audio_jump_sound_note)
  57+ 8342 3C               inc  a
  58+ 8343 32 6A A4         ld   (Audio_jump_sound_note), a
  59+ 8346
  60+ 8346              .done:
  61+ 8346 E1               pop  hl
  62+ 8347 D1               pop  de
  63+ 8348 C1               pop  bc
  64+ 8349 F1               pop  af
  65+ 834A C9               ret

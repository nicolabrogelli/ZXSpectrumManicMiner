  72+ 89BD ~            ; Audio_UpdateMusic
  73+ 89BD ~            ;
  74+ 89BD ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 89BD ~            ; Viene chiamata a ogni frame.
  76+ 89BD ~            ; -------------------------------------------------------------------
  77+ 89BD ~            Audio_UpdateMusic:
  78+ 89BD ~                push af
  79+ 89BD ~                push bc
  80+ 89BD ~                push de
  81+ 89BD ~                push hl
  82+ 89BD ~
  83+ 89BD ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 89BD ~                ld   a, (Audio_jump_sound_note)

 512+ 7F8C
 513+ 7F8C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7F8F FE 01            cp   1                         ; Sinistra?
 515+ 7F91 28 03            jr   z, .left_frames
 516+ 7F93
 517+ 7F93                  ; Movimento a Destra: Frame 0..3 (prima metà)
 518+ 7F93 7B               ld   a, e

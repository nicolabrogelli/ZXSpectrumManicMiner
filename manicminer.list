1187+ 647B 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1188+ 647D CD BB 6A         call Gfx_SetEnemyColorAttributes
1189+ 6480
1190+ 6480                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1191+ 6480 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1192+ 6483 DD 21 D3 6B      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1193+ 6487 CD 38 5F         call Gfx_DrawPixelSprite16x16
1194+ 648A
1195+ 648A                  ; 3b. Imposta attributi colore per BotteSprite (Rosso Brillante) a X=120, Y=112
1196+ 648A 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1197+ 648D 3E 42            ld   a, RED | $40          ; Rosso Brillante
1198+ 648F CD BB 6A         call Gfx_SetEnemyColorAttributes

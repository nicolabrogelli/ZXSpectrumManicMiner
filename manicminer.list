 534  8646              ; -------------------------------------------------------------------
 535  8646              ; TriggerVictory
 536  8646              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 537  8646              ; - Pulisce gli elementi di gioco della stanza.
 538  8646              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 539  8646              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 540  8646              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 541  8646              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 542  8646              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 543  8646              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 544  8646              ; -------------------------------------------------------------------
 545  8646              TriggerVictory:
 546  8646                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 547  8646 CD 43 67         call Gfx_DrawVictoryScreen
 548  8649
 549  8649                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 550  8649              .wait_keys_release:
 551  8649 76               halt
 552  864A                  ; Controlla tasto Y (Porta $DF, bit 4)
 553  864A 01 FE DF         ld   bc, $dffe
 554  864D ED 78            in   a, (c)
 555  864F CB 67            bit  4, a
 556  8651 28 F6            jr   z, .wait_keys_release
 557  8653
 558  8653                  ; Controlla tasto N (Porta $7F, bit 3)
 559  8653 01 FE 7F         ld   bc, $7ffe
 560  8656 ED 78            in   a, (c)
 561  8658 CB 5F            bit  3, a
 562  865A 28 ED            jr   z, .wait_keys_release
 563  865C
 564  865C                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 565  865C 01 FE BF         ld   bc, $bffe
 566  865F ED 78            in   a, (c)
 567  8661 CB 47            bit  0, a
 568  8663 28 E4            jr   z, .wait_keys_release
 569  8665
 570  8665                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 571  8665 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 572  8667              .wait_choice_loop:
 573  8667 76               halt
 574  8668
 575  8668                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 576  8668 0C               inc  c
 577  8669 79               ld   a, c
 578  866A CB 3F            srl  a
 579  866C CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 580  866E E6 07            and  7
 581  8670 5F               ld   e, a
 582  8671 16 00            ld   d, 0
 583  8673 21 22 66         ld   hl, victory_color_table
 584  8676 19               add  hl, de
 585  8677 7E               ld   a, (hl)               ; A = nuovo colore attributo
 586  8678 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 587  867B 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 588  867D              .color_cycle_loop:
 589  867D 77               ld   (hl), a
 590  867E 23               inc  hl
 591  867F 10 FC            djnz .color_cycle_loop
 592  8681
 593  8681                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 594  8681 01 FE DF         ld   bc, $dffe
 595  8684 ED 78            in   a, (c)
 596  8686 CB 67            bit  4, a
 597  8688 28 2A            jr   z, .play_again_chosen
 598  868A
 599  868A                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)

 142+ 833C              ; Items_DrawRoom
 143+ 833C              ;
 144+ 833C              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 833C              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 833C              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 833C              ;
 148+ 833C              ; Record item nella stanza (5 byte):
 149+ 833C              ;   +0 Color / Attributo
 150+ 833C              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 833C              ;   +2 Attr Address High
 152+ 833C              ;   +3 Anim Mask (96)
 153+ 833C              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 833C              ; Fine lista: $FF
 155+ 833C              ; -------------------------------------------------------------------
 156+ 833C              Items_DrawRoom:

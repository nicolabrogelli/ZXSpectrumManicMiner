 430+ 8214 57               ld   d, a                      ; D = ItemRight
 431+ 8215
 432+ 8215 ED 4B 67 96      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 8219
 434+ 8219                  ; WillyLeft <= ItemRight
 435+ 8219 79               ld   a, c                      ; A = WillyX
 436+ 821A BA               cp   d                         ; D = ItemRight
 437+ 821B 28 04            jr   z, .x_ok
 438+ 821D 38 02            jr   c, .x_ok
 439+ 821F 18 31            jr   .no_collision
 440+ 8221
 441+ 8221              .x_ok:
 442+ 8221                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 8221 BB               cp   e                         ; E = ItemLeft
 444+ 8222 28 0B            jr   z, .y_check
 445+ 8224 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 8226
 447+ 8226                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 8226 C6 0F            add  a, 15
 449+ 8228 BB               cp   e
 450+ 8229 28 04            jr   z, .y_check
 451+ 822B 30 02            jr   nc, .y_check
 452+ 822D 18 23            jr   .no_collision
 453+ 822F
 454+ 822F              .y_check:
 455+ 822F                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 822F 7C               ld   a, h                      ; H = Item Row
 457+ 8230 87               add  a, a                      ; *2
 458+ 8231 87               add  a, a                      ; *4
 459+ 8232 87               add  a, a                      ; *8
 460+ 8233 5F               ld   e, a                      ; E = ItemTop
 461+ 8234 C6 07            add  a, 7
 462+ 8236 57               ld   d, a                      ; D = ItemBottom
 463+ 8237
 464+ 8237                  ; WillyTop <= ItemBottom
 465+ 8237 78               ld   a, b                      ; A = WillyY
 466+ 8238 BA               cp   d                         ; D = ItemBottom
 467+ 8239 28 04            jr   z, .y_ok
 468+ 823B 38 02            jr   c, .y_ok
 469+ 823D 18 13            jr   .no_collision
 470+ 823F
 471+ 823F              .y_ok:
 472+ 823F                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 823F BB               cp   e                         ; E = ItemTop
 474+ 8240 28 0B            jr   z, .collision
 475+ 8242 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 8244
 477+ 8244                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 8244 C6 0F            add  a, 15
 479+ 8246 BB               cp   e
 480+ 8247 28 04            jr   z, .collision
 481+ 8249 30 02            jr   nc, .collision
 482+ 824B 18 05            jr   .no_collision

1187+ 74EE              ; -------------------------------------------------------------------
1188+ 74EE              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1189+ 74EE              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1190+ 74EE              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1191+ 74EE              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1192+ 74EE              ; -------------------------------------------------------------------
1193+ 74EE              UnpackRoomLayout:
1194+ 74EE E5               push hl
1195+ 74EF D5               push de
1196+ 74F0 C5               push bc
1197+ 74F1 DD E5            push ix
1198+ 74F3
1199+ 74F3 DD 2A 27 91      ld   ix, (room_ptr)
1200+ 74F7 11 20 02         ld   de, OFFSET_TILES
1201+ 74FA DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1202+ 74FC
1203+ 74FC 2A 27 91         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 74FF 11 CD 8E         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 7502 01 00 02         ld   bc, 512               ; 512 celle
1206+ 7505
1207+ 7505              .byte_loop:
1208+ 7505 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1209+ 7506 23               inc  hl
1210+ 7507
1211+ 7507                  ; Confronta con le 8 definizioni di tile:
1212+ 7507 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 750A 28 23            jr   z, .is_bg
1214+ 750C DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 750F 28 29            jr   z, .is_wall
1216+ 7511 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 7514 28 1C            jr   z, .is_floor
1218+ 7516 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 7519 28 1B            jr   z, .is_crumbling
1220+ 751B DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 751E 28 1E            jr   z, .is_conveyor
1222+ 7520 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 7523 28 1D            jr   z, .is_nasty1
1224+ 7525 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 7528 28 1C            jr   z, .is_nasty2
1226+ 752A DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 752D 28 1B            jr   z, .is_extra
1228+ 752F
1229+ 752F              .is_bg:
1230+ 752F                  ; Default: Tile 0 (Background)
1231+ 752F AF               xor  a
1232+ 7530 18 1A            jr   .store_cell
1233+ 7532
1234+ 7532              .is_floor:
1235+ 7532 3E 01            ld   a, 1
1236+ 7534 18 16            jr   .store_cell
1237+ 7536              .is_crumbling:
1238+ 7536 3E 02            ld   a, 2
1239+ 7538 18 12            jr   .store_cell
1240+ 753A              .is_wall:
1241+ 753A 3E 03            ld   a, 3
1242+ 753C 18 0E            jr   .store_cell
1243+ 753E              .is_conveyor:
1244+ 753E 3E 04            ld   a, 4
1245+ 7540 18 0A            jr   .store_cell
1246+ 7542              .is_nasty1:
1247+ 7542 3E 05            ld   a, 5
1248+ 7544 18 06            jr   .store_cell
1249+ 7546              .is_nasty2:
1250+ 7546 3E 06            ld   a, 6
1251+ 7548 18 02            jr   .store_cell
1252+ 754A              .is_extra:
1253+ 754A 3E 07            ld   a, 7
1254+ 754C
1255+ 754C              .store_cell:
1256+ 754C 12               ld   (de), a
1257+ 754D 13               inc  de
1258+ 754E 0B               dec  bc
1259+ 754F 78               ld   a, b
1260+ 7550 B1               or   c
1261+ 7551 20 B2            jr   nz, .byte_loop
1262+ 7553
1263+ 7553 DD E1            pop  ix
1264+ 7555 C1               pop  bc
1265+ 7556 D1               pop  de
1266+ 7557 E1               pop  hl
1267+ 7558 C9               ret

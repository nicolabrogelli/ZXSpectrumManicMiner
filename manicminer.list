 161+ 7D70
 162+ 7D70 23               inc  hl
 163+ 7D71 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 164+ 7D72 DD 77 03         ld   (ix+3), a                 ; Current Y
 165+ 7D75
 166+ 7D75 23               inc  hl
 167+ 7D76 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 168+ 7D77 E6 1F            and  31
 169+ 7D79 87               add  a, a
 169+ 7D7A 87             add a, a
 169+ 7D7B 87             add a, a ; * 8 -> X pixel
 170+ 7D7C DD 77 02         ld   (ix+2), a                 ; Current X
 171+ 7D7F
 172+ 7D7F 23               inc  hl
 173+ 7D80 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 174+ 7D81 E6 03            and  3
 175+ 7D83 20 02            jr   nz, .v_step_ok
 176+ 7D85 3E 01            ld   a, 1
 177+ 7D87              .v_step_ok:
 178+ 7D87 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 179+ 7D8A 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 180+ 7D8C DD 77 06         ld   (ix+6), a
 181+ 7D8F
 182+ 7D8F 23               inc  hl
 183+ 7D90 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 184+ 7D91 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 185+ 7D94
 186+ 7D94 23               inc  hl
 187+ 7D95 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 188+ 7D96 DD 77 05         ld   (ix+5), a                 ; Max Limit Y

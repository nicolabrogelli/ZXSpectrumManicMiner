 747+ 87FD              ; Items_Animate
 748+ 87FD              ;
 749+ 87FD              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 87FD              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 87FD              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 87FD              ; originale $8F63.
 753+ 87FD              ; -------------------------------------------------------------------
 754+ 87FD              Items_Animate:
 755+ 87FD E5               push hl
 756+ 87FE D5               push de
 757+ 87FF C5               push bc
 758+ 8800 FD E5            push iy
 759+ 8802
 760+ 8802 3A 36 EE         ld   a, (num_room_items)
 761+ 8805 B7               or   a
 762+ 8806 28 40            jr   z, .anim_done
 763+ 8808
 764+ 8808 FD 21 E6 ED      ld   iy, current_room_items
 765+ 880C
 766+ 880C              .anim_loop:
 767+ 880C FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 880F FE FF            cp   $FF
 769+ 8811 28 35            jr   z, .anim_done
 770+ 8813 B7               or   a
 771+ 8814 28 2B            jr   z, .next_anim_item
 772+ 8816
 773+ 8816                  ; Routine originale $8F63 di Manic Miner:
 774+ 8816                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 8816 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 8818 F6 03            or   $03                       ; Base Ink = 3
 777+ 881A 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 881B FD 7E 02         ld   a, (iy+2)
 779+ 881E E6 03            and  $03                       ; Isola offset rotazione
 780+ 8820 80               add  a, b                      ; A = Nuovo attributo
 781+ 8821 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 8824 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8825
 784+ 8825                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8825 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 8828 16 00            ld   d, 0
 787+ 882A 26 00            ld   h, 0
 788+ 882C FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 882F 29               add  hl, hl
 790+ 8830 29               add  hl, hl
 791+ 8831 29               add  hl, hl
 792+ 8832 29               add  hl, hl
 793+ 8833 29               add  hl, hl                    ; Row * 32
 794+ 8834 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 8835
 796+ 8835                  ; Aggiorna items_grid
 797+ 8835 E5               push hl
 798+ 8836 11 B6 E8         ld   de, items_grid
 799+ 8839 19               add  hl, de
 800+ 883A 70               ld   (hl), b
 801+ 883B E1               pop  hl
 802+ 883C
 803+ 883C                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 883C 11 00 58         ld   de, COLOR_DATA
 805+ 883F 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 8840 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 8841
 808+ 8841              .next_anim_item:
 809+ 8841 01 05 00         ld   bc, 5
 810+ 8844 FD 09            add  iy, bc
 811+ 8846 18 C4            jr   .anim_loop
 812+ 8848
 813+ 8848              .anim_done:
 814+ 8848 FD E1            pop  iy
 815+ 884A C1               pop  bc
 816+ 884B D1               pop  de
 817+ 884C E1               pop  hl
 818+ 884D C9               ret

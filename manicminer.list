  61+ 89A6 E1               pop  hl
  62+ 89A7 D1               pop  de
  63+ 89A8 C1               pop  bc
  64+ 89A9 F1               pop  af
  65+ 89AA C9               ret
  66+ 89AB
  67+ 89AB              Audio_JumpSoundDelays:
  68+ 89AB 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 89AF 19 13 0C 06
  68+ 89B3 0C 13 19 20
  68+ 89B7 26 2D 33 3A
  68+ 89BB 40 47
  69+ 89BD
  70+ 89BD                  IF ENABLE_MUSIC != 0
  71+ 89BD              ; -------------------------------------------------------------------
  72+ 89BD              ; Audio_UpdateMusic
  73+ 89BD              ;
  74+ 89BD              ; Gestisce la riproduzione della musica di sottofondo frame-by-frame
  75+ 89BD              ; fedele al motore audio originale di Matthew Smith (Manic Miner 1983).
  76+ 89BD              ; Brano: "In the Hall of the Mountain King" (Edvard Grieg).
  77+ 89BD              ;
  78+ 89BD              ; Nel gioco originale (routine a $883A / 34874):
  79+ 89BD              ; - Un loop di sintesi a 1-bit su porta $FE (768 passaggi, ~8.8 ms) viene
  80+ 89BD              ;   eseguito a intervalli regolari.
  81+ 89BD              ; - Ciascuna delle 64 note della melodia viene suonata per 2 burst consecutivi
  82+ 89BD              ;   (producendo il caratteristico ritmo staccato "ta-ta").
  83+ 89BD              ; - Con MUSIC_FRAME_DIVIDER = 2 a 25 FPS, un burst viene emesso ogni 80 ms,
  84+ 89BD              ;   riproducendo il tema completo di 64 note in 10.24 secondi, perfettamente
  85+ 89BD              ;   allineato ai ~11.5 secondi del gioco originale.
  86+ 89BD              ; -------------------------------------------------------------------
  87+ 89BD              Audio_UpdateMusic:
  88+ 89BD F5               push af
  89+ 89BE C5               push bc
  90+ 89BF D5               push de
  91+ 89C0 E5               push hl
  92+ 89C1
  93+ 89C1                  IF MUTE_MUSIC_ON_JUMP != 0
  94+ 89C1 ~                ; Se abilitato, il salto silenzia temporaneamente la musica
  95+ 89C1 ~                ld   a, (Audio_jump_sound_note)
  96+ 89C1 ~                cp   18
  97+ 89C1 ~                jr   c, .done
  98+ 89C1                  ENDIF
  99+ 89C1
 100+ 89C1                  IF MUSIC_FRAME_DIVIDER > 1
 101+ 89C1                  ; Divisore di frame per sincronizzare il tempo al frame rate di gioco
 102+ 89C1 3A 97 F2         ld   a, (Audio_music_frame_counter)
 103+ 89C4 3D               dec  a
 104+ 89C5 32 97 F2         ld   (Audio_music_frame_counter), a
 105+ 89C8 20 33            jr   nz, .done
 106+ 89CA 3E 02            ld   a, MUSIC_FRAME_DIVIDER
 107+ 89CC 32 97 F2         ld   (Audio_music_frame_counter), a
 108+ 89CF                  ENDIF
 109+ 89CF
 110+ 89CF                  ; Avanza l'indice del burst e calcola la nota corrente (0..63)
 111+ 89CF                  ; INC A; AND 126; RRCA; mantiene ciascuna nota attiva per 2 burst
 112+ 89CF 3A 96 F2         ld   a, (Audio_music_note_idx)
 113+ 89D2 3C               inc  a
 114+ 89D3 32 96 F2         ld   (Audio_music_note_idx), a
 115+ 89D6 E6 7E            and  126                      ; Maschera bit 7 e bit 0 (valori 0, 2, ..., 126)
 116+ 89D8 0F               rrca                          ; Dividi per 2 -> indice nota 0..63
 117+ 89D9 5F               ld   e, a
 118+ 89DA 16 00            ld   d, 0
 119+ 89DC 21 02 8A         ld   hl, Audio_GameTune
 120+ 89DF 19               add  hl, de                   ; HL = puntatore al delay del semionda della nota
 121+ 89E0
 122+ 89E0                  ; Configura il colore del bordo corrente e lo stato iniziale dello speaker
 123+ 89E0 3A 7E EC         ld   a, (room_border_color)
 124+ 89E3 E6 07            and  $07                      ; Mantiene solo i 3 bit del colore bordo (speaker OFF)
 125+ 89E5 5E               ld   e, (hl)                  ; E = delay iniziale per il pitch counter
 126+ 89E6 01 03 00         ld   bc, 3                    ; B = 0 (256 cicli), C = 3 -> 768 iterazioni totali (~8.8 ms)
 127+ 89E9
 128+ 89E9                  ; Loop originale di generazione tono a 1 bit (routine 34898 / TM51)
 129+ 89E9              .sound_loop:
 130+ 89E9 D3 FE            out  ($fe), a                 ; Emette lo stato corrente su porta $FE
 131+ 89EB 1D               dec  e
 132+ 89EC 20 03            jr   nz, .no_flip
 133+ 89EE 5E               ld   e, (hl)                  ; Ricarica il valore del semionda
 134+ 89EF EE 18            xor  $18                      ; Inverte bit 3 (MIC) e bit 4 (EAR/BEEPER)
 135+ 89F1              .no_flip:
 136+ 89F1 10 F6            djnz .sound_loop
 137+ 89F3 0D               dec  c
 138+ 89F4 20 F3            jr   nz, .sound_loop
 139+ 89F6
 140+ 89F6                  ; Spegni lo speaker assicurando che i bit 3 e 4 tornino a 0
 141+ 89F6 3A 7E EC         ld   a, (room_border_color)
 142+ 89F9 E6 07            and  $07
 143+ 89FB D3 FE            out  ($fe), a
 144+ 89FD
 145+ 89FD              .done:
 146+ 89FD E1               pop  hl
 147+ 89FE D1               pop  de
 148+ 89FF C1               pop  bc
 149+ 8A00 F1               pop  af
 150+ 8A01 C9               ret
 151+ 8A02
 152+ 8A02              ; -------------------------------------------------------------------
 153+ 8A02              ; Tabella delle note dell'in-game tune: "In the Hall of the Mountain King"
 154+ 8A02              ; Dati originali Manic Miner (Bug-Byte Ltd, 1983 - memoria $858C / 34188).
 155+ 8A02              ; 64 note (1 byte per nota che rappresenta il delay del semionda).
 156+ 8A02              ; -------------------------------------------------------------------
 157+ 8A02              Audio_GameTune:
 158+ 8A02 80 72 66 60      db 128, 114, 102,  96,  86, 102,  86,  86,  81,  96,  81,  81,  86, 102,  86,  86
 158+ 8A06 56 66 56 56
 158+ 8A0A 51 60 51 51
 158+ 8A0E 56 66 56 56
 159+ 8A12 80 72 66 60      db 128, 114, 102,  96,  86, 102,  86,  86,  81,  96,  81,  81,  86,  86,  86,  86
 159+ 8A16 56 66 56 56
 159+ 8A1A 51 60 51 51
 159+ 8A1E 56 56 56 56
 160+ 8A22 80 72 66 60      db 128, 114, 102,  96,  86, 102,  86,  86,  81,  96,  81,  81,  86, 102,  86,  86
 160+ 8A26 56 66 56 56
 160+ 8A2A 51 60 51 51
 160+ 8A2E 56 66 56 56
 161+ 8A32 80 72 66 60      db 128, 114, 102,  96,  86, 102,  86,  64,  86, 102, 128, 102,  86,  86,  86,  86
 161+ 8A36 56 66 56 40
 161+ 8A3A 56 66 80 66
 161+ 8A3E 56 56 56 56
 162+ 8A42                  ELSE
 163+ 8A42 ~            Audio_UpdateMusic:
 164+ 8A42 ~                ret
 165+ 8A42                  ENDIF
 166+ 8A42
 167+ 8A42              ; -------------------------------------------------------------------
 168+ 8A42              ; Audio_PlayCollectSound
 169+ 8A42              ;
 170+ 8A42              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 171+ 8A42              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 172+ 8A42              ; -------------------------------------------------------------------
 173+ 8A42              Audio_PlayCollectSound:
 174+ 8A42 C5               push bc
 175+ 8A43 D5               push de
 176+ 8A44
 177+ 8A44 06 78            ld   b, 120
 178+ 8A46              .sound_loop:
 179+ 8A46 3A 7E EC         ld   a, (room_border_color)
 180+ 8A49 F6 18            or   $18               ; speaker ON (EAR + MIC)
 181+ 8A4B D3 FE            out  ($fe), a
 182+ 8A4D
 183+ 8A4D 0E 3C            ld   c, 60
 184+ 8A4F              .d1:
 185+ 8A4F 0D               dec  c
 186+ 8A50 20 FD            jr   nz, .d1
 187+ 8A52
 188+ 8A52 3A 7E EC         ld   a, (room_border_color)
 189+ 8A55 E6 E7            and  $e7              ; speaker OFF
 190+ 8A57 D3 FE            out  ($fe), a
 191+ 8A59
 192+ 8A59 0E 3C            ld   c, 60
 193+ 8A5B              .d2:
 194+ 8A5B 0D               dec  c
 195+ 8A5C 20 FD            jr   nz, .d2
 196+ 8A5E
 197+ 8A5E 10 E6            djnz .sound_loop
 198+ 8A60
 199+ 8A60 D1               pop  de
 200+ 8A61 C1               pop  bc
 201+ 8A62 C9               ret

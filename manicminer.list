 527+ 5FDB              ; Disegna il player (testa e corpo se Willy, oppure MaialeSprite se in TheNightmareRoom)
 528+ 5FDB              ; -------------------------------------------------------------------
 529+ 5FDB              Gfx_PrintPlayer:
 530+ 5FDB DD E5            push ix
 531+ 5FDD D5               push de
 532+ 5FDE E5               push hl
 533+ 5FDF C5               push bc
 534+ 5FE0
 535+ 5FE0                  ; --- RENDERING STANDARD WILLY ---
 536+ 5FE0                  ; 1. Determina sprite per la testa (sinistra o destra)
 537+ 5FE0 3A 78 8F         ld   a, (direction)
 538+ 5FE3 FE 01            cp   1                 ; Sinistra?
 539+ 5FE5 20 06            jr   nz, .right_head
 540+ 5FE7
 541+ 5FE7 DD 21 51 89      ld   ix, Willy + (4 * 8) ; 5° tile (HEAD_GRAPH_LEFT)
 542+ 5FEB 18 04            jr   .draw_head
 543+ 5FED
 544+ 5FED              .right_head:
 545+ 5FED DD 21 31 89      ld   ix, Willy + (0 * 8) ; 1° tile (HEAD_GRAPH_RIGHT)
 546+ 5FF1
 547+ 5FF1              .draw_head:
 548+ 5FF1 ED 4B 71 8F      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 549+ 5FF5 CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna testa
 550+ 5FF8
 551+ 5FF8                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
 552+ 5FF8 3A 78 8F         ld   a, (direction)
 553+ 5FFB FE 01            cp   1                 ; Sinistra?
 554+ 5FFD 20 13            jr   nz, .right_body
 555+ 5FFF
 556+ 5FFF                  ; Corpo a sinistra
 557+ 5FFF 3A 77 8F         ld   a, (body_state)   ; 0, 1, 2
 558+ 6002 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
 559+ 6004 87               add  a, a              ; *2
 560+ 6005 87               add  a, a              ; *4
 561+ 6006 87               add  a, a              ; *8
 562+ 6007 5F               ld   e, a
 563+ 6008 16 00            ld   d, 0
 564+ 600A DD 21 31 89      ld   ix, Willy
 565+ 600E DD 19            add  ix, de
 566+ 6010 18 11            jr   .draw_body
 567+ 6012
 568+ 6012              .right_body:
 569+ 6012                  ; Corpo a destra
 570+ 6012 3A 77 8F         ld   a, (body_state)   ; 0, 1, 2
 571+ 6015 C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 572+ 6017 87               add  a, a              ; *2
 573+ 6018 87               add  a, a              ; *4
 574+ 6019 87               add  a, a              ; *8
 575+ 601A 5F               ld   e, a
 576+ 601B 16 00            ld   d, 0
 577+ 601D DD 21 31 89      ld   ix, Willy
 578+ 6021 DD 19            add  ix, de
 579+ 6023
 580+ 6023              .draw_body:
 581+ 6023 ED 4B 71 8F      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 582+ 6027 78               ld   a, b
 583+ 6028 C6 08            add  a, 8
 584+ 602A 47               ld   b, a              ; B = PlayerY + 8
 585+ 602B CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna corpo
 586+ 602E
 587+ 602E                  ; 3. Imposta gli attributi colore di Willy (Bianco Brillante)
 588+ 602E ED 4B 71 8F      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 589+ 6032 3E 47            ld   a, WHITE | $40    ; Bianco Brillante

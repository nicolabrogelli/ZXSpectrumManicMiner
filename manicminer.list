 817  8C44              ; ResetFullGameState
 818  8C44              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 819  8C44              ; per l'avvio di una nuova partita dopo il Game Over.
 820  8C44              ; -------------------------------------------------------------------
 821  8C44              ResetFullGameState:
 822  8C44                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 823  8C44 AF               xor  a
 824  8C45 D3 FE            out  ($fe), a              ; Bordo a nero
 825  8C47 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 826  8C4A
 827  8C4A                  ; Ripristina il numero di vite iniziali
 828  8C4A 3E 07            ld   a, INITIAL_LIVES
 829  8C4C 32 EB EA         ld   (willy_lives), a
 830  8C4F
 831  8C4F                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 832  8C4F AF               xor  a
 833  8C50 32 E8 EA         ld   (items_collected), a
 834  8C53 32 E4 EA         ld   (body_state), a
 835  8C56 32 F7 EA         ld   (w_warp_state), a
 836  8C59 32 FA EA         ld   (w_key_prev), a
 837  8C5C 32 FB EA         ld   (enter_key_prev), a
 838  8C5F 32 EC EA         ld   (velocity_y), a
 839  8C62 32 EE EA         ld   (jump_pressed), a
 840  8C65 32 F0 EA         ld   (coyote_timer), a
 841  8C68 32 F3 EA         ld   (jump_frame), a
 842  8C6B 32 F2 EA         ld   (jump_dir), a
 843  8C6E 32 65 EE         ld   (transition_active), a
 844  8C71 32 EA EE         ld   (willy_safety_timer), a
 845  8C74 3E FF            ld   a, $ff
 846  8C76 32 FC EA         ld   (digit_key_prev), a
 847  8C79 3E 01            ld   a, 1
 848  8C7B 32 F5 EA         ld   (q_prev), a
 849  8C7E 32 F6 EA         ld   (a_prev), a
 850  8C81 32 ED EA         ld   (on_ground), a
 851  8C84
 852  8C84                  ; Azzeramento punteggio partita corrente (Score = 000000)
 853  8C84                  ; Nota: High score viene mantenuto intatto tra le partite
 854  8C84 AF               xor  a
 855  8C85 32 F1 F0         ld   (player_score + 0), a
 856  8C88 32 F2 F0         ld   (player_score + 1), a
 857  8C8B 32 F3 F0         ld   (player_score + 2), a
 858  8C8E
 859  8C8E                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 860  8C8E CD 58 85         call ResetItemsTable
 861  8C91

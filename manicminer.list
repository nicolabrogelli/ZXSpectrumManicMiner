1102+ 626F DD 7E 02         ld   a, (ix+2)
1102+ 6272 77             ld (hl), a
1102+ 6273 24             inc h
1103+ 6274 DD 7E 03         ld   a, (ix+3)
1103+ 6277 77             ld (hl), a
1103+ 6278 24             inc h
1104+ 6279 DD 7E 04         ld   a, (ix+4)
1104+ 627C 77             ld (hl), a
1104+ 627D 24             inc h
1105+ 627E DD 7E 05         ld   a, (ix+5)
1105+ 6281 77             ld (hl), a
1105+ 6282 24             inc h
1106+ 6283 DD 7E 06         ld   a, (ix+6)
1106+ 6286 77             ld (hl), a
1106+ 6287 24             inc h
1107+ 6288 DD 7E 07         ld   a, (ix+7)
1107+ 628B 77             ld (hl), a
1108+ 628C
1109+ 628C D1               pop  de
1110+ 628D C1               pop  bc
1111+ 628E E1               pop  hl
1112+ 628F
1113+ 628F 1C               inc  e                     ; Prossima colonna

 684+ 867D 38 0C            jr   c, .new_high_score
 685+ 867F 20 1C            jr   nz, .done_check
 686+ 8681
 687+ 8681                  ; Byte 0:
 688+ 8681 3A BC E7         ld   a, (player_score + 0)
 689+ 8684 47               ld   b, a
 690+ 8685 3A BF E7         ld   a, (high_score + 0)
 691+ 8688 B8               cp   b
 692+ 8689 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

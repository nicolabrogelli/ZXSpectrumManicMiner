 518+ 7FD6              ; CheckCollision
 519+ 7FD6              ;
 520+ 7FD6              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FD6              ; Output:
 522+ 7FD6              ;   Carry Set = Collisione con guardiano
 523+ 7FD6              ;   Carry Clear = Nessuna collisione
 524+ 7FD6              ; -------------------------------------------------------------------
 525+ 7FD6              CheckCollision:
 526+ 7FD6 DD E5            push ix
 527+ 7FD8 C5               push bc
 528+ 7FD9 D5               push de
 529+ 7FDA E5               push hl
 530+ 7FDB
 531+ 7FDB                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FDB 3A 13 9A         ld   a, (willy_safety_timer)
 533+ 7FDE B7               or   a
 534+ 7FDF 20 3B            jr   nz, .no_collision_found
 535+ 7FE1
 536+ 7FE1 DD 21 CE 7C      ld   ix, ActiveEnemies
 537+ 7FE5 06 08            ld   b, 8                      ; 8 slot
 538+ 7FE7
 539+ 7FE7              .collision_loop:
 540+ 7FE7 DD 7E 00         ld   a, (ix+0)
 541+ 7FEA E6 80            and  $80                       ; Active?
 542+ 7FEC 28 26            jr   z, .next_enemy
 543+ 7FEE
 544+ 7FEE C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7FEF
 546+ 7FEF                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7FEF ED 4B 09 96      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7FF3 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7FF6
 550+ 7FF6                  ; Calcola differenza X
 551+ 7FF6 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7FF7 30 02            jr   nc, .x_diff_pos
 553+ 7FF9 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7FFB              .x_diff_pos:
 555+ 7FFB FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7FFD 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7FFF
 558+ 7FFF                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7FFF DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 8002 90               sub  b                         ; A = EnemyY - WillyY
 561+ 8003 30 02            jr   nc, .y_diff_pos
 562+ 8005 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 8007              .y_diff_pos:
 564+ 8007 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8009 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 800B
 567+ 800B                  ; Collisione trovata!
 568+ 800B C1               pop  bc                        ; Ripristina stack
 569+ 800C E1               pop  hl
 570+ 800D D1               pop  de
 571+ 800E C1               pop  bc
 572+ 800F DD E1            pop  ix
 573+ 8011 37               scf
 574+ 8012 C9               ret
 575+ 8013
 576+ 8013              .no_x_hit:
 577+ 8013 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 8014
 579+ 8014              .next_enemy:
 580+ 8014 11 0B 00         ld   de, 11
 581+ 8017 DD 19            add  ix, de
 582+ 8019 05               dec  b
 583+ 801A 20 CB            jr   nz, .collision_loop
 584+ 801C
 585+ 801C              .no_collision_found:
 586+ 801C E1               pop  hl
 587+ 801D D1               pop  de
 588+ 801E C1               pop  bc
 589+ 801F DD E1            pop  ix
 590+ 8021 B7               or   a
 591+ 8022 C9               ret

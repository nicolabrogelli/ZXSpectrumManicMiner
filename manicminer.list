   2+ 7C4A              ; enemy.asm
   3+ 7C4A              ;
   4+ 7C4A              ; Gestione dei Guardiani (Nemici) per Manic Miner.
   5+ 7C4A              ; I dati e le sprite dei guardiani (8 frame da 16x16 pixel) sono definiti
   6+ 7C4A              ; direttamente all'interno della stanza (OFFSET_H_GUARDIANS, OFFSET_V_GUARDIANS,
   7+ 7C4A              ; OFFSET_GUARDIAN_GRAPHICS).
   8+ 7C4A              ;===========================================================================
   9+ 7C4A
  10+ 7C4A              ; -------------------------------------------------------------------
  11+ 7C4A              ; Struttura dati per i nemici attivi della stanza corrente (RAM)
  12+ 7C4A              ; 8 slot, 11 byte ciascuno:
  13+ 7C4A              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7C4A              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C4A              ; Offset 2: Current X
  16+ 7C4A              ; Offset 3: Current Y
  17+ 7C4A              ; Offset 4: Min Limit
  18+ 7C4A              ; Offset 5: Max Limit
  19+ 7C4A              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7C4A              ; Offset 7: Anim State (0..3)
  21+ 7C4A              ; Offset 8: Old X
  22+ 7C4A              ; Offset 9: Old Y
  23+ 7C4A              ; Offset 10: Color (Attributo Spectrum)
  24+ 7C4A              ; -------------------------------------------------------------------
  25+ 7C4A              ActiveEnemies:
  26+ 7C4A 00          > db 0
  26+ 7C4B 00          > db 0
  26+ 7C4C 00          > db 0
  26+ 7C4D 00          > db 0
  26+ 7C4E 00          > db 0
  26+ 7C4F 00          > db 0
  26+ 7C50 00          > db 0
  26+ 7C51 00          > db 0
  26+ 7C52 00          > db 0
  26+ 7C53 00          > db 0
  26+ 7C54 00          > db 0
  26+ 7C55 00          > db 0
  26+ 7C56 00          > db 0
  26+ 7C57 00          > db 0
  26+ 7C58 00          > db 0

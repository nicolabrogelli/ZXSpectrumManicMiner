1209+ 7572 23               inc  hl
1210+ 7573
1211+ 7573                  ; Confronta con le 8 definizioni di tile:
1212+ 7573 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 7576 28 23            jr   z, .is_bg
1214+ 7578 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 757B 28 29            jr   z, .is_wall
1216+ 757D DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 7580 28 1C            jr   z, .is_floor
1218+ 7582 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 7585 28 1B            jr   z, .is_crumbling
1220+ 7587 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 758A 28 1E            jr   z, .is_conveyor
1222+ 758C DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 758F 28 1D            jr   z, .is_nasty1
1224+ 7591 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 7594 28 1C            jr   z, .is_nasty2
1226+ 7596 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 7599 28 1B            jr   z, .is_extra

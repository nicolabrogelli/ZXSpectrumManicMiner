2031+ 7D3F              .advance_crumble_cell:
2032+ 7D3F                  ; Input: B = Row, C = Col
2033+ 7D3F C5               push bc
2034+ 7D40 D5               push de
2035+ 7D41 E5               push hl
2036+ 7D42
2037+ 7D42                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2038+ 7D42 68               ld   l, b
2039+ 7D43 26 00            ld   h, 0
2040+ 7D45 29               add  hl, hl
2040+ 7D46 29             add hl, hl
2040+ 7D47 29             add hl, hl
2040+ 7D48 29             add hl, hl
2040+ 7D49 29             add hl, hl
2041+ 7D4A 59               ld   e, c
2042+ 7D4B 16 00            ld   d, 0
2043+ 7D4D 19               add  hl, de
2044+ 7D4E 11 FB EE         ld   de, crumbling_grid
2045+ 7D51 19               add  hl, de
2046+ 7D52
2047+ 7D52                  ; 2. Avanza di 1 stadio
2048+ 7D52 7E               ld   a, (hl)               ; A = Stage (0..8)
2049+ 7D53 FE 08            cp   8
2050+ 7D55 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
2051+ 7D57
2052+ 7D57 3C               inc  a                     ; Avanza di 1 scanline (1..8)
2053+ 7D58 77               ld   (hl), a
2054+ 7D59 5F               ld   e, a                  ; E = nuovo Stage (1..8)
2055+ 7D5A
2056+ 7D5A                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
2057+ 7D5A E5               push hl
2058+ 7D5B CD 2A 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2059+ 7D5E E1               pop  hl
2060+ 7D5F
2061+ 7D5F                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2062+ 7D5F 7E               ld   a, (hl)
2063+ 7D60 FE 08            cp   8
2064+ 7D62 38 12            jr   c, .done_advance
2065+ 7D64
2066+ 7D64                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2067+ 7D64 68               ld   l, b                  ; L = Row
2068+ 7D65 26 00            ld   h, 0
2069+ 7D67 29               add  hl, hl
2069+ 7D68 29             add hl, hl
2069+ 7D69 29             add hl, hl
2069+ 7D6A 29             add hl, hl
2069+ 7D6B 29             add hl, hl
2070+ 7D6C 59               ld   e, c
2071+ 7D6D 16 00            ld   d, 0
2072+ 7D6F 19               add  hl, de
2073+ 7D70 11 10 EC         ld   de, unpacked_layout
2074+ 7D73 19               add  hl, de
2075+ 7D74 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2076+ 7D76
2077+ 7D76              .done_advance:
2078+ 7D76 E1               pop  hl
2079+ 7D77 D1               pop  de
2080+ 7D78 C1               pop  bc
2081+ 7D79 C9               ret

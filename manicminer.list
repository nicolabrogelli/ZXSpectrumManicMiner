 285  889A              ; -------------------------------------------------------------------
 286  889A              ; ShowTitleScreen
 287  889A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 288  889A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 289  889A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 290  889A              ; -------------------------------------------------------------------
 291  889A              ShowTitleScreen:
 292  889A                  ; 1. Disegna la schermata iniziale
 293  889A CD 7A 64         call Gfx_DrawTitleScreen
 294  889D
 295  889D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 296  889D              .wait_title_enter_release:
 297  889D 76               halt
 298  889E 3E BF            ld   a, $bf
 299  88A0 DB FE            in   a, ($fe)
 300  88A2 1F               rra
 301  88A3 30 F8            jr   nc, .wait_title_enter_release
 302  88A5
 303  88A5                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 304  88A5 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 305  88A7              .title_loop:
 306  88A7 76               halt
 307  88A8
 308  88A8                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 309  88A8 0C               inc  c
 310  88A9 79               ld   a, c
 311  88AA CB 3F            srl  a
 312  88AC CB 3F            srl  a
 313  88AE CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 314  88B0 E6 07            and  7
 315  88B2 5F               ld   e, a
 316  88B3 16 00            ld   d, 0
 317  88B5 21 72 64         ld   hl, title_color_table
 318  88B8 19               add  hl, de
 319  88B9 7E               ld   a, (hl)               ; A = nuovo colore
 320  88BA 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  88BD 06 20            ld   b, 32
 322  88BF              .color_title_loop:
 323  88BF 77               ld   (hl), a
 324  88C0 23               inc  hl
 325  88C1 10 FC            djnz .color_title_loop
 326  88C3
 327  88C3                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 328  88C3 3E BF            ld   a, $bf
 329  88C5 DB FE            in   a, ($fe)
 330  88C7 1F               rra
 331  88C8 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 332  88CA
 333  88CA                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 334  88CA              .wait_title_enter_release_after:
 335  88CA 76               halt
 336  88CB 3E BF            ld   a, $bf
 337  88CD DB FE            in   a, ($fe)
 338  88CF 1F               rra
 339  88D0 30 F8            jr   nc, .wait_title_enter_release_after

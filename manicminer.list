1756+ 7B15 CD BF 7A         call CheckNastyCell
1757+ 7B18 38 19            jr   c, .collision
1758+ 7B1A
1759+ 7B1A                  ; Punto 5: Bottom-Left (X, Y + 15)
1760+ 7B1A ED 4B 69 AA      ld   bc, (PlayerPos)
1761+ 7B1E 78               ld   a, b
1762+ 7B1F C6 0F            add  a, 15
1763+ 7B21 47               ld   b, a
1764+ 7B22 CD BF 7A         call CheckNastyCell
1765+ 7B25 38 0C            jr   c, .collision
1766+ 7B27
1767+ 7B27                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1768+ 7B27 79               ld   a, c
1769+ 7B28 C6 07            add  a, 7
1770+ 7B2A 4F               ld   c, a
1771+ 7B2B CD BF 7A         call CheckNastyCell
1772+ 7B2E 38 03            jr   c, .collision
1773+ 7B30
1774+ 7B30 C1               pop  bc
1775+ 7B31 B7               or   a                 ; Clear carry
1776+ 7B32 C9               ret

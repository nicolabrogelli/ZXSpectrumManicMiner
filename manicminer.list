 651+ 87B8 32 F2 F0         ld   (player_score + 1), a
 652+ 87BB
 653+ 87BB                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 87BB 3A F3 F0         ld   a, (player_score + 2)
 655+ 87BE CE 00            adc  a, 0
 656+ 87C0 27               daa
 657+ 87C1 32 F3 F0         ld   (player_score + 2), a
 658+ 87C4

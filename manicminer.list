 482+ 7F5C
 483+ 7F5C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 484+ 7F5F FE 01            cp   1                         ; Sinistra?
 485+ 7F61 28 03            jr   z, .left_frames
 486+ 7F63
 487+ 7F63                  ; Movimento a Destra: Frame 0..3 (prima metà)
 488+ 7F63 7B               ld   a, e
 489+ 7F64 18 23            jr   .got_frame_idx

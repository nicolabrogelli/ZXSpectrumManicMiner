  93+ E838 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ E839 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ E83A 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)

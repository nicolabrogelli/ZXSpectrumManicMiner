 542  862D              ; -------------------------------------------------------------------
 543  862D              ; TriggerVictory
 544  862D              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 545  862D              ; - Pulisce gli elementi di gioco della stanza.
 546  862D              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 547  862D              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 548  862D              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 549  862D              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 550  862D              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 551  862D              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 552  862D              ; -------------------------------------------------------------------
 553  862D              TriggerVictory:
 554  862D                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 555  862D CD F7 66         call Gfx_DrawVictoryScreen
 556  8630
 557  8630                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 558  8630              .wait_keys_release:
 559  8630 76               halt
 560  8631                  ; Controlla tasto Y (Porta $DF, bit 4)
 561  8631 01 FE DF         ld   bc, $dffe
 562  8634 ED 78            in   a, (c)
 563  8636 CB 67            bit  4, a
 564  8638 28 F6            jr   z, .wait_keys_release
 565  863A
 566  863A                  ; Controlla tasto N (Porta $7F, bit 3)
 567  863A 01 FE 7F         ld   bc, $7ffe
 568  863D ED 78            in   a, (c)
 569  863F CB 5F            bit  3, a
 570  8641 28 ED            jr   z, .wait_keys_release
 571  8643
 572  8643                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 573  8643 01 FE BF         ld   bc, $bffe
 574  8646 ED 78            in   a, (c)
 575  8648 CB 47            bit  0, a
 576  864A 28 E4            jr   z, .wait_keys_release
 577  864C
 578  864C                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 579  864C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 580  864E              .wait_choice_loop:
 581  864E 76               halt
 582  864F
 583  864F                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 584  864F 0C               inc  c
 585  8650 79               ld   a, c
 586  8651 CB 3F            srl  a
 587  8653 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 588  8655 E6 07            and  7
 589  8657 5F               ld   e, a
 590  8658 16 00            ld   d, 0
 591  865A 21 D6 65         ld   hl, victory_color_table
 592  865D 19               add  hl, de
 593  865E 7E               ld   a, (hl)               ; A = nuovo colore attributo
 594  865F 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 595  8662 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 596  8664              .color_cycle_loop:
 597  8664 77               ld   (hl), a
 598  8665 23               inc  hl

1053+ 7805              ; -------------------------------------------------------------------
1054+ 7805              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 7805              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 7805              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 7805              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 7805              ; -------------------------------------------------------------------
1059+ 7805              UnpackRoomLayout:
1060+ 7805 E5               push hl
1061+ 7806 D5               push de
1062+ 7807 C5               push bc
1063+ 7808 DD E5            push ix
1064+ 780A
1065+ 780A DD 2A 50 BE      ld   ix, (room_ptr)
1066+ 780E 11 20 02         ld   de, OFFSET_TILES
1067+ 7811 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 7813
1069+ 7813 2A 50 BE         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 7816 11 F5 BB         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 7819 01 00 02         ld   bc, 512               ; 512 celle
1072+ 781C
1073+ 781C              .byte_loop:
1074+ 781C 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 781D 23               inc  hl
1076+ 781E
1077+ 781E                  ; Confronta con le 8 definizioni di tile:
1078+ 781E DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7821 28 23            jr   z, .is_bg
1080+ 7823 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 7826 28 29            jr   z, .is_wall
1082+ 7828 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 782B 28 1C            jr   z, .is_floor
1084+ 782D DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7830 28 1B            jr   z, .is_crumbling
1086+ 7832 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 7835 28 1E            jr   z, .is_conveyor
1088+ 7837 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 783A 28 1D            jr   z, .is_nasty1
1090+ 783C DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 783F 28 1C            jr   z, .is_nasty2
1092+ 7841 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 7844 28 1B            jr   z, .is_extra
1094+ 7846
1095+ 7846              .is_bg:
1096+ 7846                  ; Default: Tile 0 (Background)
1097+ 7846 AF               xor  a
1098+ 7847 18 1A            jr   .store_cell
1099+ 7849
1100+ 7849              .is_floor:
1101+ 7849 3E 01            ld   a, 1
1102+ 784B 18 16            jr   .store_cell
1103+ 784D              .is_crumbling:
1104+ 784D 3E 02            ld   a, 2
1105+ 784F 18 12            jr   .store_cell
1106+ 7851              .is_wall:
1107+ 7851 3E 03            ld   a, 3
1108+ 7853 18 0E            jr   .store_cell
1109+ 7855              .is_conveyor:
1110+ 7855 3E 04            ld   a, 4
1111+ 7857 18 0A            jr   .store_cell
1112+ 7859              .is_nasty1:
1113+ 7859 3E 05            ld   a, 5
1114+ 785B 18 06            jr   .store_cell
1115+ 785D              .is_nasty2:
1116+ 785D 3E 06            ld   a, 6
1117+ 785F 18 02            jr   .store_cell
1118+ 7861              .is_extra:
1119+ 7861 3E 07            ld   a, 7
1120+ 7863
1121+ 7863              .store_cell:
1122+ 7863 12               ld   (de), a
1123+ 7864 13               inc  de
1124+ 7865 0B               dec  bc
1125+ 7866 78               ld   a, b
1126+ 7867 B1               or   c
1127+ 7868 20 B2            jr   nz, .byte_loop
1128+ 786A
1129+ 786A DD E1            pop  ix
1130+ 786C C1               pop  bc
1131+ 786D D1               pop  de
1132+ 786E E1               pop  hl
1133+ 786F C9               ret

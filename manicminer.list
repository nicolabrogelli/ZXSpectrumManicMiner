  29+ 7D1F              ; Enemy_LoadRoom
  30+ 7D1F              ;
  31+ 7D1F              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7D1F              ; Chiamato quando si entra in una stanza.
  33+ 7D1F              ; -------------------------------------------------------------------
  34+ 7D1F              Enemy_LoadRoom:
  35+ 7D1F E5               push hl
  36+ 7D20 D5               push de
  37+ 7D21 C5               push bc
  38+ 7D22 DD E5            push ix
  39+ 7D24
  40+ 7D24                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D24 21 C7 7C         ld   hl, ActiveEnemies
  42+ 7D27 11 C8 7C         ld   de, ActiveEnemies + 1
  43+ 7D2A 36 00            ld   (hl), 0
  44+ 7D2C 01 57 00         ld   bc, 87
  45+ 7D2F ED B0            ldir
  46+ 7D31
  47+ 7D31                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D31 DD 21 C7 7C      ld   ix, ActiveEnemies
  49+ 7D35 06 08            ld   b, 8
  50+ 7D37 11 0B 00         ld   de, 11
  51+ 7D3A              .init_old_pos:
  52+ 7D3A DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D3E DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D42 DD 19            add  ix, de
  55+ 7D44 10 F4            djnz .init_old_pos
  56+ 7D46
  57+ 7D46                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D46 DD 21 C7 7C      ld   ix, ActiveEnemies
  59+ 7D4A 2A 82 9D         ld   hl, (room_ptr)
  60+ 7D4D 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D50 19               add  hl, de
  62+ 7D51
  63+ 7D51 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D53              .load_h_loop:
  65+ 7D53 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D54 FE FF            cp   $FF
  67+ 7D56 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D58 B7               or   a
  69+ 7D59 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D5B
  71+ 7D5B                  ; Slot attivo
  72+ 7D5B DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D5F DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D62
  75+ 7D62 23               inc  hl
  76+ 7D63 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D64 23               inc  hl
  78+ 7D65 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D66
  80+ 7D66                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D66 E5               push hl
  82+ 7D67 C5               push bc
  83+ 7D68 67               ld   h, a
  84+ 7D69 69               ld   l, c
  85+ 7D6A 01 00 A4         ld   bc, -23552
  86+ 7D6D 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D6E
  88+ 7D6E                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D6E 7D               ld   a, l
  90+ 7D6F E6 1F            and  31
  91+ 7D71 87               add  a, a
  91+ 7D72 87             add a, a
  91+ 7D73 87             add a, a
  92+ 7D74 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D77
  94+ 7D77                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D77 CB 3C            srl  h
  95+ 7D79 CB 1D          rr l
  96+ 7D7B CB 3C            srl  h
  96+ 7D7D CB 1D          rr l
  97+ 7D7F CB 3C            srl  h
  97+ 7D81 CB 1D          rr l
  98+ 7D83 CB 3C            srl  h
  98+ 7D85 CB 1D          rr l
  99+ 7D87 CB 3C            srl  h
  99+ 7D89 CB 1D          rr l
 100+ 7D8B 7D               ld   a, l
 101+ 7D8C 87               add  a, a
 101+ 7D8D 87             add a, a
 101+ 7D8E 87             add a, a
 102+ 7D8F DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D92 C1               pop  bc
 104+ 7D93 E1               pop  hl
 105+ 7D94
 106+ 7D94 23               inc  hl
 107+ 7D95 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D96 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D9A
 110+ 7D9A 23               inc  hl
 111+ 7D9B 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D9C E6 01            and  1
 113+ 7D9E 28 04            jr   z, .h_dir_right
 114+ 7DA0 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DA2 18 02            jr   .set_h_dir
 116+ 7DA4              .h_dir_right:
 117+ 7DA4 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DA6              .set_h_dir:
 119+ 7DA6 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7DA9
 121+ 7DA9 23               inc  hl
 122+ 7DAA 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DAB E6 1F            and  31
 124+ 7DAD 87               add  a, a
 124+ 7DAE 87             add a, a
 124+ 7DAF 87             add a, a
 125+ 7DB0 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DB3
 127+ 7DB3 23               inc  hl
 128+ 7DB4 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DB5 E6 1F            and  31
 130+ 7DB7 87               add  a, a
 130+ 7DB8 87             add a, a
 130+ 7DB9 87             add a, a
 131+ 7DBA DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DBD
 133+ 7DBD 23               inc  hl                        ; Prossimo guardiano
 134+ 7DBE 11 0B 00         ld   de, 11
 135+ 7DC1 DD 19            add  ix, de
 136+ 7DC3 10 8E            djnz .load_h_loop

1053+ 7801              ; -------------------------------------------------------------------
1054+ 7801              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 7801              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 7801              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 7801              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 7801              ; -------------------------------------------------------------------
1059+ 7801              UnpackRoomLayout:
1060+ 7801 E5               push hl
1061+ 7802 D5               push de
1062+ 7803 C5               push bc
1063+ 7804 DD E5            push ix
1064+ 7806
1065+ 7806 DD 2A 4C B6      ld   ix, (room_ptr)
1066+ 780A 11 20 02         ld   de, OFFSET_TILES
1067+ 780D DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 780F
1069+ 780F 2A 4C B6         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 7812 11 F1 B3         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 7815 01 00 02         ld   bc, 512               ; 512 celle
1072+ 7818
1073+ 7818              .byte_loop:
1074+ 7818 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 7819 23               inc  hl
1076+ 781A
1077+ 781A                  ; Confronta con le 8 definizioni di tile:
1078+ 781A DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 781D 28 23            jr   z, .is_bg
1080+ 781F DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 7822 28 29            jr   z, .is_wall
1082+ 7824 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 7827 28 1C            jr   z, .is_floor
1084+ 7829 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 782C 28 1B            jr   z, .is_crumbling
1086+ 782E DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 7831 28 1E            jr   z, .is_conveyor
1088+ 7833 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 7836 28 1D            jr   z, .is_nasty1
1090+ 7838 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 783B 28 1C            jr   z, .is_nasty2
1092+ 783D DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 7840 28 1B            jr   z, .is_extra
1094+ 7842
1095+ 7842              .is_bg:
1096+ 7842                  ; Default: Tile 0 (Background)
1097+ 7842 AF               xor  a
1098+ 7843 18 1A            jr   .store_cell
1099+ 7845
1100+ 7845              .is_floor:
1101+ 7845 3E 01            ld   a, 1
1102+ 7847 18 16            jr   .store_cell
1103+ 7849              .is_crumbling:
1104+ 7849 3E 02            ld   a, 2
1105+ 784B 18 12            jr   .store_cell
1106+ 784D              .is_wall:
1107+ 784D 3E 03            ld   a, 3
1108+ 784F 18 0E            jr   .store_cell
1109+ 7851              .is_conveyor:
1110+ 7851 3E 04            ld   a, 4
1111+ 7853 18 0A            jr   .store_cell
1112+ 7855              .is_nasty1:
1113+ 7855 3E 05            ld   a, 5
1114+ 7857 18 06            jr   .store_cell
1115+ 7859              .is_nasty2:
1116+ 7859 3E 06            ld   a, 6
1117+ 785B 18 02            jr   .store_cell
1118+ 785D              .is_extra:
1119+ 785D 3E 07            ld   a, 7
1120+ 785F
1121+ 785F              .store_cell:
1122+ 785F 12               ld   (de), a
1123+ 7860 13               inc  de
1124+ 7861 0B               dec  bc
1125+ 7862 78               ld   a, b
1126+ 7863 B1               or   c
1127+ 7864 20 B2            jr   nz, .byte_loop
1128+ 7866
1129+ 7866 DD E1            pop  ix
1130+ 7868 C1               pop  bc
1131+ 7869 D1               pop  de
1132+ 786A E1               pop  hl
1133+ 786B C9               ret
1134+ 786C
1135+ 786C              ; -------------------------------------------------------------------
1136+ 786C              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 786C              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 786C              ; Output: A = tipo di cella (0..3)
1139+ 786C              ; Preserva tutti gli altri registri.
1140+ 786C              ; -------------------------------------------------------------------
1141+ 786C              GetCellFromUnpacked:
1142+ 786C E5               push hl
1143+ 786D D5               push de
1144+ 786E
1145+ 786E 6F               ld   l, a
1146+ 786F 26 00            ld   h, 0
1147+ 7871 29               add  hl, hl
1148+ 7872 29               add  hl, hl
1149+ 7873 29               add  hl, hl
1150+ 7874 29               add  hl, hl
1151+ 7875 29               add  hl, hl            ; HL = Row * 32
1152+ 7876 59               ld   e, c
1153+ 7877 16 00            ld   d, 0
1154+ 7879 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 787A 11 F1 B3         ld   de, unpacked_layout
1156+ 787D 19               add  hl, de
1157+ 787E 7E               ld   a, (hl)           ; A = cell type
1158+ 787F
1159+ 787F D1               pop  de
1160+ 7880 E1               pop  hl
1161+ 7881 C9               ret

 478+ 7F22              ; Enemy_DrawSingleSlot
 479+ 7F22              ;
 480+ 7F22              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7F22              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7F22              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F22              ; -------------------------------------------------------------------
 484+ 7F22              Enemy_DrawSingleSlot:
 485+ 7F22 C5               push bc
 486+ 7F23 D5               push de
 487+ 7F24 E5               push hl
 488+ 7F25 DD E5            push ix
 489+ 7F27
 490+ 7F27                  ; 1. Salva subito le coordinate X e Y dal record IX
 491+ 7F27 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 492+ 7F2A DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 493+ 7F2D
 494+ 7F2D                  ; Controlla se è Kong Beast ($A0)
 495+ 7F2D DD 7E 00         ld   a, (ix+0)
 496+ 7F30 FE A0            cp   $A0
 497+ 7F32 28 22            jr   z, .kong_frame
 498+ 7F34
 499+ 7F34                  ; Controlla se è guardiano verticale
 500+ 7F34 DD 7E 00         ld   a, (ix+0)
 501+ 7F37 E6 40            and  $40                       ; Vertical?
 502+ 7F39 20 22            jr   nz, .v_frame
 503+ 7F3B
 504+ 7F3B                  ; Guardiano Orizzontale:
 505+ 7F3B DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 506+ 7F3E E6 03            and  3
 507+ 7F40 5F               ld   e, a                      ; E = Anim subframe
 508+ 7F41
 509+ 7F41 3A 95 E5         ld   a, (room_has_v_guardians)
 510+ 7F44 B7               or   a
 511+ 7F45 20 0A            jr   nz, .h_use_second_half    ; Se ci sono guardiani verticali, i guardiani orizzontali usano la SECONDA METÀ (frame 4..7)!
 512+ 7F47
 513+ 7F47 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7F4A FE 01            cp   1                         ; Sinistra?
 515+ 7F4C 28 03            jr   z, .left_frames
 516+ 7F4E
 517+ 7F4E                  ; Movimento a Destra: Frame 0..3 (prima metà)
 518+ 7F4E 7B               ld   a, e
 519+ 7F4F 18 23            jr   .got_frame_idx
 520+ 7F51
 521+ 7F51              .h_use_second_half:
 522+ 7F51              .left_frames:
 523+ 7F51                  ; Movimento a Sinistra (o orizzontale in stanze con guardiani verticali): Frame 4..7 (seconda metà)
 524+ 7F51 3E 04            ld   a, 4

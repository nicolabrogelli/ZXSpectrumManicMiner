1916+ 7C86 78               ld   a, b
1917+ 7C87 C6 10            add  a, 16
1918+ 7C89 FE 80            cp   128
1919+ 7C8B 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1920+ 7C8D
1921+ 7C8D CB 3F            srl  a
1921+ 7C8F CB 3F          srl  a

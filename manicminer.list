 317+ 7E7D              ; -------------------------------------------------------------------
 318+ 7E7D              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 319+ 7E7D              ; -------------------------------------------------------------------
 320+ 7E7D              Enemy_EraseRoom:
 321+ 7E7D              Enemy_DrawRoom:
 322+ 7E7D              Enemy_RenderRoom:
 323+ 7E7D E5               push hl
 324+ 7E7E D5               push de
 325+ 7E7F C5               push bc
 326+ 7E80 DD E5            push ix
 327+ 7E82
 328+ 7E82                  ; ---------------------------------------------------------------
 329+ 7E82                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 330+ 7E82                  ; ---------------------------------------------------------------
 331+ 7E82 DD 21 5D 7C      ld   ix, ActiveEnemies
 332+ 7E86 06 08            ld   b, 8              ; 8 slot
 333+ 7E88              .erase_loop:
 334+ 7E88 DD 7E 00         ld   a, (ix+0)         ; Flags
 335+ 7E8B E6 80            and  $80               ; Active?
 336+ 7E8D 28 3A            jr   z, .next_erase
 337+ 7E8F
 338+ 7E8F                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 339+ 7E8F DD 7E 08         ld   a, (ix+8)         ; Old X
 340+ 7E92 FE FF            cp   $FF
 341+ 7E94 28 33            jr   z, .next_erase
 342+ 7E96
 343+ 7E96                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 344+ 7E96 DD 7E 08         ld   a, (ix+8)         ; Old X
 345+ 7E99 DD BE 02         cp   (ix+2)            ; Current X
 346+ 7E9C 20 0E            jr   nz, .do_erase_slot
 347+ 7E9E DD 7E 09         ld   a, (ix+9)         ; Old Y
 348+ 7EA1 DD BE 03         cp   (ix+3)            ; Current Y
 349+ 7EA4 20 06            jr   nz, .do_erase_slot
 350+ 7EA6
 351+ 7EA6 3A A7 E4         ld   a, (enemy_was_updated)
 352+ 7EA9 B7               or   a
 353+ 7EAA 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 354+ 7EAC
 355+ 7EAC              .do_erase_slot:
 356+ 7EAC C5               push bc                ; Salva contatore ciclo
 357+ 7EAD
 358+ 7EAD                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 359+ 7EAD DD 4E 08         ld   c, (ix+8)         ; C = Old X
 360+ 7EB0 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 361+ 7EB3 CD 59 7E         call CheckEnemyWillyOverlap
 362+ 7EB6
 363+ 7EB6                  ; Cancella il nemico nella VECCHIA posizione
 364+ 7EB6 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 365+ 7EB9 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 366+ 7EBC CD BD 5F         call Gfx_ErasePixelSprite16x16

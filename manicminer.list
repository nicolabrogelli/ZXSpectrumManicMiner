 289+ 7E8A DD 46 03         ld   b, (ix+3)         ; B = Current Y
 290+ 7E8D CD E1 7D         call CheckEnemyWillyOverlap
 291+ 7E90
 292+ 7E90                  ; Salva le coordinate effettivamente disegnate
 293+ 7E90 DD 7E 02         ld   a, (ix+2)
 294+ 7E93 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7E96 DD 7E 03         ld   a, (ix+3)
 296+ 7E99 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7E9C
 298+ 7E9C C1               pop  bc
 299+ 7E9D
 300+ 7E9D              .next_draw:
 301+ 7E9D 11 0B 00         ld   de, 11
 302+ 7EA0 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7EA2 05               dec  b
 304+ 7EA3 20 BA            jr   nz, .draw_loop
 305+ 7EA5
 306+ 7EA5 AF               xor  a
 307+ 7EA6 32 0B 9E         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 308+ 7EA9
 309+ 7EA9 DD E1            pop  ix
 310+ 7EAB C1               pop  bc
 311+ 7EAC D1               pop  de
 312+ 7EAD E1               pop  hl
 313+ 7EAE C9               ret

 518+ 7FD1              ; CheckCollision
 519+ 7FD1              ;
 520+ 7FD1              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FD1              ; Output:
 522+ 7FD1              ;   Carry Set = Collisione con guardiano
 523+ 7FD1              ;   Carry Clear = Nessuna collisione
 524+ 7FD1              ; -------------------------------------------------------------------
 525+ 7FD1              CheckCollision:
 526+ 7FD1 DD E5            push ix
 527+ 7FD3 C5               push bc
 528+ 7FD4 D5               push de
 529+ 7FD5 E5               push hl
 530+ 7FD6
 531+ 7FD6                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FD6 3A 0A A2         ld   a, (willy_safety_timer)
 533+ 7FD9 B7               or   a
 534+ 7FDA 20 3B            jr   nz, .no_collision_found
 535+ 7FDC
 536+ 7FDC DD 21 C9 7C      ld   ix, ActiveEnemies
 537+ 7FE0 06 08            ld   b, 8                      ; 8 slot
 538+ 7FE2
 539+ 7FE2              .collision_loop:
 540+ 7FE2 DD 7E 00         ld   a, (ix+0)
 541+ 7FE5 E6 80            and  $80                       ; Active?
 542+ 7FE7 28 26            jr   z, .next_enemy
 543+ 7FE9
 544+ 7FE9 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7FEA
 546+ 7FEA                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7FEA ED 4B 00 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7FEE DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7FF1
 550+ 7FF1                  ; Calcola differenza X
 551+ 7FF1 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7FF2 30 02            jr   nc, .x_diff_pos
 553+ 7FF4 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7FF6              .x_diff_pos:
 555+ 7FF6 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7FF8 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7FFA
 558+ 7FFA                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7FFA DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7FFD 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7FFE 30 02            jr   nc, .y_diff_pos
 562+ 8000 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 8002              .y_diff_pos:
 564+ 8002 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8004 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 8006
 567+ 8006                  ; Collisione trovata!
 568+ 8006 C1               pop  bc                        ; Ripristina stack
 569+ 8007 E1               pop  hl
 570+ 8008 D1               pop  de
 571+ 8009 C1               pop  bc
 572+ 800A DD E1            pop  ix
 573+ 800C 37               scf
 574+ 800D C9               ret
 575+ 800E
 576+ 800E              .no_x_hit:
 577+ 800E C1               pop  bc                        ; Ripristina B (contatore ciclo)

 357+ 6FEC
 358+ 6FEC                  ; Calcola indirizzo di OFFSET_POS_WILLY
 359+ 6FEC 21 68 02         ld   hl, OFFSET_POS_WILLY
 360+ 6FEF 19               add  hl, de                    ; HL = layout + OFFSET_POS_WILLY
 361+ 6FF0
 362+ 6FF0 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 363+ 6FF1 CB 3F            srl  a
 364+ 6FF3 F5               push af                        ; Salva PlayerY sullo stack
 365+ 6FF4
 366+ 6FF4 23               inc  hl                        ; Byte 1
 367+ 6FF5 23               inc  hl                        ; Byte 2
 368+ 6FF6 23               inc  hl                        ; Byte 3

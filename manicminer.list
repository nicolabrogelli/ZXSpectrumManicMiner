1784+ 7B5F              ; Phys_CheckCrumblingTrigger
1785+ 7B5F              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1786+ 7B5F              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1787+ 7B5F              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1788+ 7B5F              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1789+ 7B5F              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1790+ 7B5F              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1791+ 7B5F              ; -------------------------------------------------------------------
1792+ 7B5F              Phys_CheckCrumblingTrigger:
1793+ 7B5F C5               push bc
1794+ 7B60 D5               push de
1795+ 7B61 E5               push hl
1796+ 7B62
1797+ 7B62 ED 4B ED E1      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1798+ 7B66
1799+ 7B66                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1800+ 7B66 78               ld   a, b
1801+ 7B67 C6 10            add  a, 16
1802+ 7B69 FE 80            cp   128
1803+ 7B6B 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1804+ 7B6D
1805+ 7B6D CB 3F            srl  a
1805+ 7B6F CB 3F          srl  a
1805+ 7B71 CB 3F          srl  a   ; A = Row (0..15)
1806+ 7B73 47               ld   b, a                  ; B = Row
1807+ 7B74
1808+ 7B74                  ; Piede sinistro: Col1 = PlayerX / 8
1809+ 7B74 79               ld   a, c
1810+ 7B75 CB 3F            srl  a
1810+ 7B77 CB 3F          srl  a
1810+ 7B79 CB 3F          srl  a   ; A = Col1 (0..31)
1811+ 7B7B 4F               ld   c, a                  ; C = Col1
1812+ 7B7C
1813+ 7B7C                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1814+ 7B7C 78               ld   a, b
1815+ 7B7D CD 91 78         call GetCellFromUnpacked
1816+ 7B80 FE 02            cp   2
1817+ 7B82 20 03            jr   nz, .check_col2
1818+ 7B84
1819+ 7B84                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1820+ 7B84 CD BA 7B         call .advance_crumble_cell
1821+ 7B87
1822+ 7B87              .check_col2:
1823+ 7B87                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1824+ 7B87 ED 4B ED E1      ld   bc, (PlayerPos)
1825+ 7B8B 78               ld   a, b
1826+ 7B8C C6 10            add  a, 16
1827+ 7B8E CB 3F            srl  a
1827+ 7B90 CB 3F          srl  a
1827+ 7B92 CB 3F          srl  a
1828+ 7B94 47               ld   b, a                  ; B = Row
1829+ 7B95
1830+ 7B95 79               ld   a, c
1831+ 7B96 C6 07            add  a, 7
1832+ 7B98 CB 3F            srl  a
1832+ 7B9A CB 3F          srl  a
1832+ 7B9C CB 3F          srl  a   ; A = Col2 (0..31)
1833+ 7B9E 4F               ld   c, a                  ; C = Col2
1834+ 7B9F
1835+ 7B9F                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1836+ 7B9F 3A ED E1         ld   a, (PlayerPos)        ; A = PlayerX
1837+ 7BA2 CB 3F            srl  a
1837+ 7BA4 CB 3F          srl  a
1837+ 7BA6 CB 3F          srl  a   ; A = Col1
1838+ 7BA8 B9               cp   c
1839+ 7BA9 28 0B            jr   z, .done_trigger
1840+ 7BAB
1841+ 7BAB 78               ld   a, b
1842+ 7BAC CD 91 78         call GetCellFromUnpacked
1843+ 7BAF FE 02            cp   2
1844+ 7BB1 20 03            jr   nz, .done_trigger
1845+ 7BB3
1846+ 7BB3                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1847+ 7BB3 CD BA 7B         call .advance_crumble_cell
1848+ 7BB6
1849+ 7BB6              .done_trigger:
1850+ 7BB6 E1               pop  hl
1851+ 7BB7 D1               pop  de
1852+ 7BB8 C1               pop  bc
1853+ 7BB9 C9               ret
1854+ 7BBA
1855+ 7BBA              .advance_crumble_cell:
1856+ 7BBA                  ; Input: B = Row, C = Col
1857+ 7BBA C5               push bc
1858+ 7BBB D5               push de
1859+ 7BBC E5               push hl
1860+ 7BBD
1861+ 7BBD                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1862+ 7BBD 68               ld   l, b
1863+ 7BBE 26 00            ld   h, 0
1864+ 7BC0 29               add  hl, hl
1864+ 7BC1 29             add hl, hl
1864+ 7BC2 29             add hl, hl
1864+ 7BC3 29             add hl, hl
1864+ 7BC4 29             add hl, hl
1865+ 7BC5 59               ld   e, c
1866+ 7BC6 16 00            ld   d, 0
1867+ 7BC8 19               add  hl, de
1868+ 7BC9 11 FE E5         ld   de, crumbling_grid
1869+ 7BCC 19               add  hl, de
1870+ 7BCD
1871+ 7BCD                  ; 2. Avanza di 1 stadio
1872+ 7BCD 7E               ld   a, (hl)               ; A = Stage (0..8)
1873+ 7BCE FE 08            cp   8
1874+ 7BD0 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
1875+ 7BD2
1876+ 7BD2 3C               inc  a                     ; Avanza di 1 scanline (1..8)
1877+ 7BD3 77               ld   (hl), a
1878+ 7BD4 5F               ld   e, a                  ; E = nuovo Stage (1..8)
1879+ 7BD5
1880+ 7BD5                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
1881+ 7BD5 E5               push hl
1882+ 7BD6 CD 24 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
1883+ 7BD9 E1               pop  hl
1884+ 7BDA
1885+ 7BDA                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
1886+ 7BDA 7E               ld   a, (hl)
1887+ 7BDB FE 08            cp   8
1888+ 7BDD 38 12            jr   c, .done_advance
1889+ 7BDF
1890+ 7BDF                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
1891+ 7BDF 68               ld   l, b                  ; L = Row
1892+ 7BE0 26 00            ld   h, 0
1893+ 7BE2 29               add  hl, hl
1893+ 7BE3 29             add hl, hl
1893+ 7BE4 29             add hl, hl
1893+ 7BE5 29             add hl, hl
1893+ 7BE6 29             add hl, hl
1894+ 7BE7 59               ld   e, c
1895+ 7BE8 16 00            ld   d, 0
1896+ 7BEA 19               add  hl, de
1897+ 7BEB 11 13 E3         ld   de, unpacked_layout
1898+ 7BEE 19               add  hl, de
1899+ 7BEF 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
1900+ 7BF1
1901+ 7BF1              .done_advance:
1902+ 7BF1 E1               pop  hl
1903+ 7BF2 D1               pop  de
1904+ 7BF3 C1               pop  bc
1905+ 7BF4 C9               ret

1144+ 644A              ; -------------------------------------------------------------------
1145+ 644A              ; Gfx_DrawGameOverScreen
1146+ 644A              ; Esegue la sequenza animata di Game Over:
1147+ 644A              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1148+ 644A              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1149+ 644A              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1150+ 644A              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1151+ 644A              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1152+ 644A              ; -------------------------------------------------------------------
1153+ 644A              Gfx_DrawGameOverScreen:
1154+ 644A F5               push af
1155+ 644B C5               push bc
1156+ 644C D5               push de
1157+ 644D E5               push hl
1158+ 644E DD E5            push ix
1159+ 6450
1160+ 6450                  ; 1. Bordo hardware e schermo a nero
1161+ 6450 AF               xor  a
1162+ 6451 D3 FE            out  ($fe), a              ; Bordo a nero
1163+ 6453 21 8D 5C         ld   hl, ATTR_P
1164+ 6456 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1165+ 6457 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1166+ 645A 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1167+ 645C 3E 07            ld   a, $07
1168+ 645E 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1169+ 6461
1170+ 6461                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1171+ 6461                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1172+ 6461 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1173+ 6464 DD 21 25 88      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1174+ 6468 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1175+ 646B
1176+ 646B                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1177+ 646B 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1178+ 646E DD 21 2D 88      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1179+ 6472 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1180+ 6475
1181+ 6475                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96

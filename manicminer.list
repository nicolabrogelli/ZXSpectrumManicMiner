1660+ 7ABB 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1661+ 7ABD 32 EE BA         ld   (room_jump_strength), a
1662+ 7AC0 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1663+ 7AC2 32 EF BA         ld   (room_gravity_preset), a
1664+ 7AC5 F1               pop  af
1665+ 7AC6 C9               ret

  71+ 7FDD ~            ; -------------------------------------------------------------------
  72+ 7FDD ~            ; Audio_UpdateMusic
  73+ 7FDD ~            ;
  74+ 7FDD ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7FDD ~            ; Viene chiamata a ogni frame.
  76+ 7FDD ~            ; -------------------------------------------------------------------
  77+ 7FDD ~            Audio_UpdateMusic:
  78+ 7FDD ~                push af
  79+ 7FDD ~                push bc
  80+ 7FDD ~                push de
  81+ 7FDD ~                push hl
  82+ 7FDD ~
  83+ 7FDD ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7FDD ~                ld   a, (Audio_jump_sound_note)
  85+ 7FDD ~                cp   18
  86+ 7FDD ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7FDD ~
  88+ 7FDD ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7FDD ~                ld   a, (Audio_music_frame_counter)
  90+ 7FDD ~                dec  a
  91+ 7FDD ~                ld   (Audio_music_frame_counter), a
  92+ 7FDD ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7FDD ~
  94+ 7FDD ~                ; Altrimenti carica la nota successiva
  95+ 7FDD ~                ld   a, (Audio_music_note_idx)
  96+ 7FDD ~                inc  a
  97+ 7FDD ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7FDD ~                jr   c, .no_wrap
  99+ 7FDD ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7FDD ~            .no_wrap:
 101+ 7FDD ~                ld   (Audio_music_note_idx), a
 102+ 7FDD ~
 103+ 7FDD ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7FDD ~                ld   e, a
 105+ 7FDD ~                ld   d, 0
 106+ 7FDD ~                ld   hl, Audio_MusicSheet
 107+ 7FDD ~                add  hl, de
 108+ 7FDD ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7FDD ~
 110+ 7FDD ~                ; Leggi durata (secondo byte)
 111+ 7FDD ~                inc  hl
 112+ 7FDD ~                ld   a, (hl)
 113+ 7FDD ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7FDD ~                jr   nz, .dur_ok
 115+ 7FDD ~                ld   a, 1
 116+ 7FDD ~            .dur_ok:
 117+ 7FDD ~                ld   (Audio_music_frame_counter), a
 118+ 7FDD ~
 119+ 7FDD ~            .play_current_note:
 120+ 7FDD ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7FDD ~                ld   a, (Audio_music_note_idx)
 122+ 7FDD ~                ld   e, a
 123+ 7FDD ~                ld   d, 0
 124+ 7FDD ~                ld   hl, Audio_MusicSheet
 125+ 7FDD ~                add  hl, de
 126+ 7FDD ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7FDD ~                ld   a, (hl)                  ; A = delay
 128+ 7FDD ~                or   a
 129+ 7FDD ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7FDD ~
 131+ 7FDD ~                ; Suona la nota: 2 cicli
 132+ 7FDD ~                ld   d, a                     ; D = delay
 133+ 7FDD ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7FDD ~            .note_loop:
 135+ 7FDD ~                ; Speaker ON
 136+ 7FDD ~                ld   a, (room_border_color)
 137+ 7FDD ~                or   $10
 138+ 7FDD ~                out  ($fe), a
 139+ 7FDD ~                ld   c, d
 140+ 7FDD ~            .d1:
 141+ 7FDD ~                push af
 142+ 7FDD ~                pop  af
 143+ 7FDD ~                dec  c
 144+ 7FDD ~                jr   nz, .d1
 145+ 7FDD ~
 146+ 7FDD ~                ; Speaker OFF
 147+ 7FDD ~                ld   a, (room_border_color)
 148+ 7FDD ~                and  $ef
 149+ 7FDD ~                out  ($fe), a
 150+ 7FDD ~                ld   c, d
 151+ 7FDD ~            .d2:
 152+ 7FDD ~                push af
 153+ 7FDD ~                pop  af
 154+ 7FDD ~                dec  c
 155+ 7FDD ~                jr   nz, .d2
 156+ 7FDD ~
 157+ 7FDD ~                djnz .note_loop
 158+ 7FDD ~
 159+ 7FDD ~            .done:
 160+ 7FDD ~                pop  hl
 161+ 7FDD ~                pop  de
 162+ 7FDD ~                pop  bc
 163+ 7FDD ~                pop  af
 164+ 7FDD ~                ret
 165+ 7FDD ~
 166+ 7FDD ~            Audio_MusicSheet:
 167+ 7FDD ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7FDD ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7FDD ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7FDD ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7FDD ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7FDD ~                db 90, 10, 107, 20, 68, 65
 173+ 7FDD                  ELSE
 174+ 7FDD              Audio_UpdateMusic:
 175+ 7FDD C9               ret
 176+ 7FDE                  ENDIF

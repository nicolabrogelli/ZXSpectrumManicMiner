 392  890A 76               halt
 393  890B
 394  890B                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 395  890B 0C               inc  c
 396  890C 79               ld   a, c
 397  890D CB 3F            srl  a
 398  890F CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 399  8911 E6 07            and  7
 400  8913 5F               ld   e, a
 401  8914 16 00            ld   d, 0
 402  8916 21 D5 65         ld   hl, game_over_color_table
 403  8919 19               add  hl, de
 404  891A 7E               ld   a, (hl)               ; A = nuovo colore attributo
 405  891B 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 406  891E 06 09            ld   b, 9

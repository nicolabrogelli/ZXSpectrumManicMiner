 457+ 7F98 28 08            jr   z, .h_rev_left
 458+ 7F9A 30 06            jr   nc, .h_rev_left
 459+ 7F9C DD 77 02         ld   (ix+2), a
 460+ 7F9F C3 F4 7F         jp   .next

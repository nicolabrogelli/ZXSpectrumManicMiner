 381  85E0 ED 78            in   a, (c)
 382  85E2 CB 5F            bit  3, a
 383  85E4 28 ED            jr   z, .wait_keys_release
 384  85E6
 385  85E6                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  85E6 01 FE BF         ld   bc, $bffe
 387  85E9 ED 78            in   a, (c)
 388  85EB CB 47            bit  0, a
 389  85ED 28 E4            jr   z, .wait_keys_release
 390  85EF

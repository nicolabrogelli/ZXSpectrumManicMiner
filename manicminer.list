  12+ 801E              ; DetermineCurrentRoomID
  13+ 801E              ;
  14+ 801E              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 801E              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 801E              ;
  17+ 801E              ; Output:
  18+ 801E              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 801E              ;   (current_room) = A
  20+ 801E              ; -------------------------------------------------------------------
  21+ 801E              DetermineCurrentRoomID:
  22+ 801E E5               push hl
  23+ 801F D5               push de
  24+ 8020 C5               push bc
  25+ 8021
  26+ 8021 21 04 73         ld   hl, RoomsListTable
  27+ 8024 ED 5B 80 A1      ld   de, (room_ptr)
  28+ 8028 06 04            ld   b, NUM_ROOMS
  29+ 802A 0E 00            ld   c, 0
  30+ 802C
  31+ 802C              .loop:
  32+ 802C 7E               ld   a, (hl)
  33+ 802D BB               cp   e
  34+ 802E 20 06            jr   nz, .no_match
  35+ 8030 23               inc  hl
  36+ 8031 7E               ld   a, (hl)
  37+ 8032 BA               cp   d
  38+ 8033 28 08            jr   z, .found
  39+ 8035 2B               dec  hl
  40+ 8036
  41+ 8036              .no_match:
  42+ 8036 23               inc  hl
  43+ 8037 23               inc  hl
  44+ 8038 0C               inc  c
  45+ 8039 10 F1            djnz .loop
  46+ 803B
  47+ 803B 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 803D
  49+ 803D              .found:
  50+ 803D 79               ld   a, c
  51+ 803E 32 26 A1         ld   (current_room), a
  52+ 8041
  53+ 8041 C1               pop  bc
  54+ 8042 D1               pop  de
  55+ 8043 E1               pop  hl
  56+ 8044 C9               ret

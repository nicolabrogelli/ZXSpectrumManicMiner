 265  8213 20 FD            jr   nz, .delay
 266  8215 10 F4            djnz .raster_loop
 267  8217
 268  8217                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 269  8217 3A 95 93         ld   a, (room_border_color)
 270  821A D3 FE            out  ($fe), a
 271  821C 18 05            jr   .no_collision_change
 272  821E

 727  8C0E              ; CheckWillyConveyorCollision
 728  8C0E              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 729  8C0E              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 730  8C0E              ; -------------------------------------------------------------------
 731  8C0E              CheckWillyConveyorCollision:
 732  8C0E C5               push bc
 733  8C0F D5               push de
 734  8C10 E5               push hl
 735  8C11
 736  8C11                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 737  8C11 CD 74 78         call CheckWillyOnConveyor
 738  8C14 38 49            jr   c, .collision_detected
 739  8C16
 740  8C16                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 741  8C16 3A 2C EE         ld   a, (conveyor_len)
 742  8C19 B7               or   a
 743  8C1A 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 744  8C1C
 745  8C1C                  ; B = WillyY, C = WillyX
 746  8C1C ED 4B 03 EB      ld   bc, (PlayerPos)
 747  8C20
 748  8C20                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 749  8C20 3A 2D EE         ld   a, (conveyor_row)
 750  8C23 87               add  a, a                  ; *2
 751  8C24 87               add  a, a                  ; *4
 752  8C25 87               add  a, a                  ; *8
 753  8C26 5F               ld   e, a                  ; E = ConveyorTop
 754  8C27 C6 07            add  a, 7
 755  8C29 57               ld   d, a                  ; D = ConveyorBottom
 756  8C2A
 757  8C2A                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 758  8C2A 78               ld   a, b                  ; WillyTop
 759  8C2B BA               cp   d
 760  8C2C 28 04            jr   z, .y_overlap
 761  8C2E 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 762  8C30 18 32            jr   .no_conv_collision
 763  8C32
 764  8C32              .y_overlap:
 765  8C32 C6 0F            add  a, 15                 ; WillyBottom
 766  8C34 BB               cp   e
 767  8C35 28 04            jr   z, .x_check
 768  8C37 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 769  8C39 18 29            jr   .no_conv_collision
 770  8C3B
 771  8C3B              .x_check:
 772  8C3B                  ; ConveyorLeft = conveyor_col * 8
 773  8C3B 3A 2E EE         ld   a, (conveyor_col)
 774  8C3E 87               add  a, a                  ; *2
 775  8C3F 87               add  a, a                  ; *4
 776  8C40 87               add  a, a                  ; *8
 777  8C41 5F               ld   e, a                  ; E = ConveyorLeft
 778  8C42
 779  8C42                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 780  8C42 21 2C EE         ld   hl, conveyor_len
 781  8C45 3A 2E EE         ld   a, (conveyor_col)
 782  8C48 86               add  a, (hl)
 783  8C49 87               add  a, a                  ; *2
 784  8C4A 87               add  a, a                  ; *4
 785  8C4B 87               add  a, a                  ; *8
 786  8C4C 3D               dec  a                     ; ConveyorRight
 787  8C4D 57               ld   d, a                  ; D = ConveyorRight
 788  8C4E
 789  8C4E                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 790  8C4E 79               ld   a, c                  ; WillyLeft
 791  8C4F BA               cp   d
 792  8C50 28 04            jr   z, .x_overlap
 793  8C52 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 794  8C54 18 0E            jr   .no_conv_collision
 795  8C56
 796  8C56              .x_overlap:
 797  8C56 C6 0F            add  a, 15                 ; WillyRight
 798  8C58 BB               cp   e
 799  8C59 28 04            jr   z, .collision_detected
 800  8C5B 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 801  8C5D 18 05            jr   .no_conv_collision
 802  8C5F

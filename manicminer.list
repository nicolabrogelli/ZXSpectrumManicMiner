 316+ 7C3F              ; Enemy_DrawSingleSlot
 317+ 7C3F              ;
 318+ 7C3F              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7C3F              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7C3F              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7C3F              ; -------------------------------------------------------------------
 322+ 7C3F              Enemy_DrawSingleSlot:
 323+ 7C3F C5               push bc
 324+ 7C40 D5               push de
 325+ 7C41 E5               push hl
 326+ 7C42 DD E5            push ix
 327+ 7C44
 328+ 7C44                  ; 1. Determina il frame di animazione (0..7)
 329+ 7C44                  ; Nei dati di Manic Miner:
 330+ 7C44                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7C44                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7C44 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7C47 E6 03            and  3
 334+ 7C49 47               ld   b, a                      ; B = Anim subframe
 335+ 7C4A
 336+ 7C4A DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7C4D FE 01            cp   1                         ; Sinistra?
 338+ 7C4F 28 03            jr   z, .left_frames
 339+ 7C51
 340+ 7C51                  ; Movimento a Destra: Frame 0..3
 341+ 7C51 78               ld   a, b
 342+ 7C52 18 03            jr   .got_frame_idx
 343+ 7C54
 344+ 7C54              .left_frames:
 345+ 7C54                  ; Movimento a Sinistra: Frame 4..7
 346+ 7C54 3E 04            ld   a, 4
 347+ 7C56 80               add  a, b
 348+ 7C57
 349+ 7C57              .got_frame_idx:
 350+ 7C57                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7C57 6F               ld   l, a
 352+ 7C58 26 00            ld   h, 0
 353+ 7C5A 29               add  hl, hl                    ; *2
 354+ 7C5B 29               add  hl, hl                    ; *4
 355+ 7C5C 29               add  hl, hl                    ; *8
 356+ 7C5D 29               add  hl, hl                    ; *16
 357+ 7C5E 29               add  hl, hl                    ; *32
 358+ 7C5F
 359+ 7C5F 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7C62 19               add  hl, de
 361+ 7C63 ED 5B 09 97      ld   de, (room_ptr)
 362+ 7C67 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7C68 E5               push hl
 364+ 7C69 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7C6B
 366+ 7C6B                  ; 2. Coordinate e colore
 367+ 7C6B FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7C6D FD E5            push iy
 369+ 7C6F
 370+ 7C6F FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7C72 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7C75 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7C78

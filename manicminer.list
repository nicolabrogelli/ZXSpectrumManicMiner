 339+ 7E76 29               add  hl, hl                    ; *2
 340+ 7E77 29               add  hl, hl                    ; *4
 341+ 7E78 29               add  hl, hl                    ; *8
 342+ 7E79 19               add  hl, de                    ; *9
 343+ 7E7A 11 20 02         ld   de, OFFSET_TILES
 344+ 7E7D 19               add  hl, de

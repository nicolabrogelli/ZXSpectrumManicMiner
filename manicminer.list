 316+ 7AE3              ; Enemy_DrawSingleSlot
 317+ 7AE3              ;
 318+ 7AE3              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7AE3              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7AE3              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7AE3              ; -------------------------------------------------------------------
 322+ 7AE3              Enemy_DrawSingleSlot:
 323+ 7AE3 C5               push bc

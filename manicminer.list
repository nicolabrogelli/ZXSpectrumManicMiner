 875  87B5 BA               cp   d
 876  87B6 28 04            jr   z, .x_overlap
 877  87B8 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  87BA 18 0E            jr   .no_conv_collision
 879  87BC

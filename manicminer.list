1211+ 7571                  ; Confronta con le 8 definizioni di tile:
1212+ 7571 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 7574 28 23            jr   z, .is_bg
1214+ 7576 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 7579 28 29            jr   z, .is_wall
1216+ 757B DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 757E 28 1C            jr   z, .is_floor
1218+ 7580 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 7583 28 1B            jr   z, .is_crumbling
1220+ 7585 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 7588 28 1E            jr   z, .is_conveyor
1222+ 758A DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 758D 28 1D            jr   z, .is_nasty1
1224+ 758F DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 7592 28 1C            jr   z, .is_nasty2
1226+ 7594 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 7597 28 1B            jr   z, .is_extra

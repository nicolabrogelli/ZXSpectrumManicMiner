  32+ 8485 7E               ld   a, (hl)
  33+ 8486 BB               cp   e
  34+ 8487 20 06            jr   nz, .no_match
  35+ 8489 23               inc  hl
  36+ 848A 7E               ld   a, (hl)
  37+ 848B BA               cp   d
  38+ 848C 28 08            jr   z, .found
  39+ 848E 2B               dec  hl

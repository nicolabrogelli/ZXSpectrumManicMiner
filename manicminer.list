 569  8625 28 ED            jr   z, .wait_keys_release
 570  8627
 571  8627                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 572  8627 01 FE BF         ld   bc, $bffe
 573  862A ED 78            in   a, (c)
 574  862C CB 47            bit  0, a
 575  862E 28 E4            jr   z, .wait_keys_release
 576  8630
 577  8630                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 578  8630 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 579  8632              .wait_choice_loop:

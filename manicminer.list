  77+ 7DC9 23               inc  hl
  78+ 7DCA 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7DCB
  80+ 7DCB                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7DCB E5               push hl
  82+ 7DCC C5               push bc

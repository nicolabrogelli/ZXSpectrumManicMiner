 202+ 7DB6 E6 03            and  3
 203+ 7DB8 20 02            jr   nz, .v_step_ok
 204+ 7DBA 3E 01            ld   a, 1
 205+ 7DBC              .v_step_ok:
 206+ 7DBC DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 207+ 7DBF 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 208+ 7DC1 DD 77 06         ld   (ix+6), a
 209+ 7DC4
 210+ 7DC4 23               inc  hl
 211+ 7DC5 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 212+ 7DC6 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 213+ 7DC9
 214+ 7DC9 23               inc  hl
 215+ 7DCA 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 216+ 7DCB DD 77 05         ld   (ix+5), a                 ; Max Limit Y

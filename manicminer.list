  72+ 83AD ~            ; Audio_UpdateMusic
  73+ 83AD ~            ;
  74+ 83AD ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 83AD ~            ; Viene chiamata a ogni frame.
  76+ 83AD ~            ; -------------------------------------------------------------------
  77+ 83AD ~            Audio_UpdateMusic:
  78+ 83AD ~                push af
  79+ 83AD ~                push bc
  80+ 83AD ~                push de
  81+ 83AD ~                push hl
  82+ 83AD ~
  83+ 83AD ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 83AD ~                ld   a, (Audio_jump_sound_note)
  85+ 83AD ~                cp   18
  86+ 83AD ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 83AD ~
  88+ 83AD ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 83AD ~                ld   a, (Audio_music_frame_counter)
  90+ 83AD ~                dec  a
  91+ 83AD ~                ld   (Audio_music_frame_counter), a
  92+ 83AD ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 83AD ~
  94+ 83AD ~                ; Altrimenti carica la nota successiva
  95+ 83AD ~                ld   a, (Audio_music_note_idx)
  96+ 83AD ~                inc  a
  97+ 83AD ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 83AD ~                jr   c, .no_wrap
  99+ 83AD ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 83AD ~            .no_wrap:
 101+ 83AD ~                ld   (Audio_music_note_idx), a
 102+ 83AD ~
 103+ 83AD ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 83AD ~                ld   e, a
 105+ 83AD ~                ld   d, 0
 106+ 83AD ~                ld   hl, Audio_MusicSheet
 107+ 83AD ~                add  hl, de
 108+ 83AD ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 83AD ~
 110+ 83AD ~                ; Leggi durata (secondo byte)
 111+ 83AD ~                inc  hl
 112+ 83AD ~                ld   a, (hl)
 113+ 83AD ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 83AD ~                jr   nz, .dur_ok
 115+ 83AD ~                ld   a, 1
 116+ 83AD ~            .dur_ok:
 117+ 83AD ~                ld   (Audio_music_frame_counter), a
 118+ 83AD ~
 119+ 83AD ~            .play_current_note:
 120+ 83AD ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 83AD ~                ld   a, (Audio_music_note_idx)
 122+ 83AD ~                ld   e, a
 123+ 83AD ~                ld   d, 0
 124+ 83AD ~                ld   hl, Audio_MusicSheet
 125+ 83AD ~                add  hl, de
 126+ 83AD ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 83AD ~                ld   a, (hl)                  ; A = delay
 128+ 83AD ~                or   a
 129+ 83AD ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 83AD ~
 131+ 83AD ~                ; Suona la nota: 2 cicli
 132+ 83AD ~                ld   d, a                     ; D = delay
 133+ 83AD ~                ld   b, 2                     ; 2 cicli per frame
 134+ 83AD ~            .note_loop:
 135+ 83AD ~                ; Speaker ON
 136+ 83AD ~                ld   a, (room_border_color)
 137+ 83AD ~                or   $10
 138+ 83AD ~                out  ($fe), a
 139+ 83AD ~                ld   c, d
 140+ 83AD ~            .d1:
 141+ 83AD ~                push af
 142+ 83AD ~                pop  af
 143+ 83AD ~                dec  c
 144+ 83AD ~                jr   nz, .d1
 145+ 83AD ~
 146+ 83AD ~                ; Speaker OFF
 147+ 83AD ~                ld   a, (room_border_color)
 148+ 83AD ~                and  $ef
 149+ 83AD ~                out  ($fe), a
 150+ 83AD ~                ld   c, d
 151+ 83AD ~            .d2:
 152+ 83AD ~                push af
 153+ 83AD ~                pop  af
 154+ 83AD ~                dec  c
 155+ 83AD ~                jr   nz, .d2
 156+ 83AD ~
 157+ 83AD ~                djnz .note_loop
 158+ 83AD ~
 159+ 83AD ~            .done:
 160+ 83AD ~                pop  hl
 161+ 83AD ~                pop  de
 162+ 83AD ~                pop  bc
 163+ 83AD ~                pop  af
 164+ 83AD ~                ret
 165+ 83AD ~
 166+ 83AD ~            Audio_MusicSheet:
 167+ 83AD ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 83AD ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 83AD ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 83AD ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 83AD ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 83AD ~                db 90, 10, 107, 20, 68, 65
 173+ 83AD                  ELSE
 174+ 83AD              Audio_UpdateMusic:
 175+ 83AD C9               ret
 176+ 83AE                  ENDIF

  87+ 7DD3
  88+ 7DD3                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7DD3 7D               ld   a, l
  90+ 7DD4 E6 1F            and  31
  91+ 7DD6 87               add  a, a
  91+ 7DD7 87             add a, a
  91+ 7DD8 87             add a, a
  92+ 7DD9 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7DDC
  94+ 7DDC                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7DDC CB 3C            srl  h
  95+ 7DDE CB 1D          rr l
  96+ 7DE0 CB 3C            srl  h
  96+ 7DE2 CB 1D          rr l
  97+ 7DE4 CB 3C            srl  h
  97+ 7DE6 CB 1D          rr l
  98+ 7DE8 CB 3C            srl  h
  98+ 7DEA CB 1D          rr l
  99+ 7DEC CB 3C            srl  h
  99+ 7DEE CB 1D          rr l
 100+ 7DF0 7D               ld   a, l
 101+ 7DF1 87               add  a, a
 101+ 7DF2 87             add a, a
 101+ 7DF3 87             add a, a
 102+ 7DF4 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7DF7 C1               pop  bc
 104+ 7DF8 E1               pop  hl
 105+ 7DF9
 106+ 7DF9 23               inc  hl
 107+ 7DFA 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7DFB DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7DFF

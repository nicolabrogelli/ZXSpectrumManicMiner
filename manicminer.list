 208+ 7E2B              .erase_loop:
 209+ 7E2B DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E2E E6 80            and  $80               ; Active?
 211+ 7E30 28 3A            jr   z, .next_erase
 212+ 7E32
 213+ 7E32                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E32 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E35 FE FF            cp   $FF
 216+ 7E37 28 33            jr   z, .next_erase
 217+ 7E39
 218+ 7E39                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E39 DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E3C DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E3F 20 0E            jr   nz, .do_erase_slot
 222+ 7E41 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E44 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E47 20 06            jr   nz, .do_erase_slot
 225+ 7E49
 226+ 7E49 3A 3C A2         ld   a, (enemy_was_updated)
 227+ 7E4C B7               or   a
 228+ 7E4D 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E4F
 230+ 7E4F              .do_erase_slot:
 231+ 7E4F C5               push bc                ; Salva contatore ciclo
 232+ 7E50
 233+ 7E50                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E50 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E53 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E56 CD FC 7D         call CheckEnemyWillyOverlap
 237+ 7E59
 238+ 7E59                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E59 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E5C DD 46 09         ld   b, (ix+9)         ; B = Old Y

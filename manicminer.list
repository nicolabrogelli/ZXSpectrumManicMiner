 438+ 85FA ED 4B B3 E9      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 85FE
 440+ 85FE                  ; WillyLeft <= ItemRight
 441+ 85FE 79               ld   a, c                      ; A = WillyX
 442+ 85FF BA               cp   d                         ; D = ItemRight
 443+ 8600 28 04            jr   z, .x_ok
 444+ 8602 38 02            jr   c, .x_ok
 445+ 8604 18 31            jr   .no_collision
 446+ 8606
 447+ 8606              .x_ok:
 448+ 8606                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8606 BB               cp   e                         ; E = ItemLeft
 450+ 8607 28 0B            jr   z, .y_check
 451+ 8609 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 860B
 453+ 860B                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 860B C6 0F            add  a, 15
 455+ 860D BB               cp   e
 456+ 860E 28 04            jr   z, .y_check
 457+ 8610 30 02            jr   nc, .y_check
 458+ 8612 18 23            jr   .no_collision
 459+ 8614
 460+ 8614              .y_check:
 461+ 8614                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 8614 7C               ld   a, h                      ; H = Item Row
 463+ 8615 87               add  a, a                      ; *2
 464+ 8616 87               add  a, a                      ; *4
 465+ 8617 87               add  a, a                      ; *8
 466+ 8618 5F               ld   e, a                      ; E = ItemTop
 467+ 8619 C6 07            add  a, 7
 468+ 861B 57               ld   d, a                      ; D = ItemBottom
 469+ 861C
 470+ 861C                  ; WillyTop <= ItemBottom
 471+ 861C 78               ld   a, b                      ; A = WillyY
 472+ 861D BA               cp   d                         ; D = ItemBottom
 473+ 861E 28 04            jr   z, .y_ok
 474+ 8620 38 02            jr   c, .y_ok
 475+ 8622 18 13            jr   .no_collision
 476+ 8624
 477+ 8624              .y_ok:
 478+ 8624                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8624 BB               cp   e                         ; E = ItemTop
 480+ 8625 28 0B            jr   z, .collision
 481+ 8627 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8629
 483+ 8629                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8629 C6 0F            add  a, 15
 485+ 862B BB               cp   e
 486+ 862C 28 04            jr   z, .collision
 487+ 862E 30 02            jr   nc, .collision
 488+ 8630 18 05            jr   .no_collision

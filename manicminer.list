 365  862C              ; -------------------------------------------------------------------
 366  862C              ; TriggerGameOver
 367  862C              ; Scatena la schermata di Game Over per la stanza corrente.
 368  862C              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 369  862C              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 370  862C              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 371  862C              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 372  862C              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 373  862C              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 374  862C              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 375  862C              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 376  862C              ; -------------------------------------------------------------------
 377  862C              TriggerGameOver:
 378  862C                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 379  862C CD DE 65         call Gfx_DrawGameOverScreen
 380  862F
 381  862F                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 382  862F              .wait_keys_release:
 383  862F 76               halt
 384  8630                  ; Controlla tasto Y (Porta $DF, bit 4)
 385  8630 01 FE DF         ld   bc, $dffe
 386  8633 ED 78            in   a, (c)
 387  8635 CB 67            bit  4, a
 388  8637 28 F6            jr   z, .wait_keys_release
 389  8639
 390  8639                  ; Controlla tasto N (Porta $7F, bit 3)
 391  8639 01 FE 7F         ld   bc, $7ffe
 392  863C ED 78            in   a, (c)
 393  863E CB 5F            bit  3, a
 394  8640 28 ED            jr   z, .wait_keys_release
 395  8642
 396  8642                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 397  8642 01 FE BF         ld   bc, $bffe
 398  8645 ED 78            in   a, (c)
 399  8647 CB 47            bit  0, a
 400  8649 28 E4            jr   z, .wait_keys_release
 401  864B
 402  864B                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 403  864B 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 404  864D              .wait_choice_loop:
 405  864D 76               halt
 406  864E
 407  864E                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 408  864E 0C               inc  c
 409  864F 79               ld   a, c
 410  8650 CB 3F            srl  a
 411  8652 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 412  8654 E6 07            and  7
 413  8656 5F               ld   e, a
 414  8657 16 00            ld   d, 0
 415  8659 21 9A 65         ld   hl, game_over_color_table
 416  865C 19               add  hl, de
 417  865D 7E               ld   a, (hl)               ; A = nuovo colore attributo
 418  865E 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 419  8661 06 09            ld   b, 9
 420  8663              .color_cycle_loop:
 421  8663 77               ld   (hl), a
 422  8664 23               inc  hl
 423  8665 10 FC            djnz .color_cycle_loop
 424  8667
 425  8667                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 426  8667 01 FE DF         ld   bc, $dffe
 427  866A ED 78            in   a, (c)
 428  866C CB 67            bit  4, a
 429  866E 28 2A            jr   z, .continue_chosen
 430  8670
 431  8670                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 432  8670 01 FE 7F         ld   bc, $7ffe
 433  8673 ED 78            in   a, (c)
 434  8675 CB 5F            bit  3, a
 435  8677 28 0B            jr   z, .quit_chosen
 436  8679
 437  8679                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 438  8679 01 FE BF         ld   bc, $bffe
 439  867C ED 78            in   a, (c)
 440  867E CB 47            bit  0, a
 441  8680 28 02            jr   z, .quit_chosen
 442  8682
 443  8682 18 C9            jr   .wait_choice_loop
 444  8684
 445  8684              .quit_chosen:
 446  8684                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 447  8684              .wait_quit_release:
 448  8684 76               halt
 449  8685 01 FE 7F         ld   bc, $7ffe
 450  8688 ED 78            in   a, (c)
 451  868A CB 5F            bit  3, a
 452  868C 28 F6            jr   z, .wait_quit_release
 453  868E 01 FE BF         ld   bc, $bffe
 454  8691 ED 78            in   a, (c)
 455  8693 CB 47            bit  0, a
 456  8695 28 ED            jr   z, .wait_quit_release
 457  8697
 458  8697                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 459  8697 C3 DD 85         jp   ShowTitleScreen
 460  869A
 461  869A              .continue_chosen:

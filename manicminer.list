  72+ 851E ~            ; Audio_UpdateMusic
  73+ 851E ~            ;
  74+ 851E ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 851E ~            ; Viene chiamata a ogni frame.
  76+ 851E ~            ; -------------------------------------------------------------------
  77+ 851E ~            Audio_UpdateMusic:
  78+ 851E ~                push af
  79+ 851E ~                push bc
  80+ 851E ~                push de
  81+ 851E ~                push hl
  82+ 851E ~
  83+ 851E ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 851E ~                ld   a, (Audio_jump_sound_note)
  85+ 851E ~                cp   18
  86+ 851E ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 851E ~
  88+ 851E ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 851E ~                ld   a, (Audio_music_frame_counter)
  90+ 851E ~                dec  a
  91+ 851E ~                ld   (Audio_music_frame_counter), a
  92+ 851E ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 851E ~
  94+ 851E ~                ; Altrimenti carica la nota successiva
  95+ 851E ~                ld   a, (Audio_music_note_idx)
  96+ 851E ~                inc  a
  97+ 851E ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 851E ~                jr   c, .no_wrap
  99+ 851E ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 851E ~            .no_wrap:
 101+ 851E ~                ld   (Audio_music_note_idx), a
 102+ 851E ~
 103+ 851E ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 851E ~                ld   e, a
 105+ 851E ~                ld   d, 0
 106+ 851E ~                ld   hl, Audio_MusicSheet
 107+ 851E ~                add  hl, de
 108+ 851E ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 851E ~
 110+ 851E ~                ; Leggi durata (secondo byte)
 111+ 851E ~                inc  hl
 112+ 851E ~                ld   a, (hl)
 113+ 851E ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 851E ~                jr   nz, .dur_ok
 115+ 851E ~                ld   a, 1
 116+ 851E ~            .dur_ok:
 117+ 851E ~                ld   (Audio_music_frame_counter), a
 118+ 851E ~
 119+ 851E ~            .play_current_note:
 120+ 851E ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 851E ~                ld   a, (Audio_music_note_idx)
 122+ 851E ~                ld   e, a
 123+ 851E ~                ld   d, 0
 124+ 851E ~                ld   hl, Audio_MusicSheet
 125+ 851E ~                add  hl, de
 126+ 851E ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 851E ~                ld   a, (hl)                  ; A = delay
 128+ 851E ~                or   a
 129+ 851E ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 851E ~
 131+ 851E ~                ; Suona la nota: 2 cicli
 132+ 851E ~                ld   d, a                     ; D = delay
 133+ 851E ~                ld   b, 2                     ; 2 cicli per frame
 134+ 851E ~            .note_loop:
 135+ 851E ~                ; Speaker ON
 136+ 851E ~                ld   a, (room_border_color)
 137+ 851E ~                or   $10
 138+ 851E ~                out  ($fe), a
 139+ 851E ~                ld   c, d
 140+ 851E ~            .d1:
 141+ 851E ~                push af
 142+ 851E ~                pop  af
 143+ 851E ~                dec  c
 144+ 851E ~                jr   nz, .d1
 145+ 851E ~
 146+ 851E ~                ; Speaker OFF
 147+ 851E ~                ld   a, (room_border_color)
 148+ 851E ~                and  $ef
 149+ 851E ~                out  ($fe), a
 150+ 851E ~                ld   c, d
 151+ 851E ~            .d2:
 152+ 851E ~                push af
 153+ 851E ~                pop  af
 154+ 851E ~                dec  c
 155+ 851E ~                jr   nz, .d2
 156+ 851E ~
 157+ 851E ~                djnz .note_loop
 158+ 851E ~
 159+ 851E ~            .done:
 160+ 851E ~                pop  hl
 161+ 851E ~                pop  de
 162+ 851E ~                pop  bc
 163+ 851E ~                pop  af
 164+ 851E ~                ret
 165+ 851E ~
 166+ 851E ~            Audio_MusicSheet:
 167+ 851E ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 851E ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 851E ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 851E ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 851E ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 851E ~                db 90, 10, 107, 20, 68, 65
 173+ 851E                  ELSE
 174+ 851E              Audio_UpdateMusic:
 175+ 851E C9               ret
 176+ 851F                  ENDIF

1965+ 7D1B              ; Phys_CheckCrumblingTrigger
1966+ 7D1B              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1967+ 7D1B              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1968+ 7D1B              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1969+ 7D1B              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1970+ 7D1B              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1971+ 7D1B              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1972+ 7D1B              ; -------------------------------------------------------------------
1973+ 7D1B              Phys_CheckCrumblingTrigger:
1974+ 7D1B C5               push bc
1975+ 7D1C D5               push de
1976+ 7D1D E5               push hl
1977+ 7D1E
1978+ 7D1E ED 4B 2B EB      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1979+ 7D22
1980+ 7D22                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1981+ 7D22 78               ld   a, b
1982+ 7D23 C6 10            add  a, 16
1983+ 7D25 FE 80            cp   128
1984+ 7D27 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1985+ 7D29
1986+ 7D29 CB 3F            srl  a
1986+ 7D2B CB 3F          srl  a
1986+ 7D2D CB 3F          srl  a   ; A = Row (0..15)
1987+ 7D2F 47               ld   b, a                  ; B = Row
1988+ 7D30
1989+ 7D30                  ; Piede sinistro: Col1 = PlayerX / 8
1990+ 7D30 79               ld   a, c
1991+ 7D31 CB 3F            srl  a
1991+ 7D33 CB 3F          srl  a
1991+ 7D35 CB 3F          srl  a   ; A = Col1 (0..31)
1992+ 7D37 4F               ld   c, a                  ; C = Col1
1993+ 7D38
1994+ 7D38                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1995+ 7D38 78               ld   a, b
1996+ 7D39 CD 48 7A         call GetCellFromUnpacked
1997+ 7D3C FE 02            cp   2
1998+ 7D3E 20 03            jr   nz, .check_col2
1999+ 7D40
2000+ 7D40                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
2001+ 7D40 CD 76 7D         call .advance_crumble_cell
2002+ 7D43
2003+ 7D43              .check_col2:
2004+ 7D43                  ; Piede destro: Col2 = (PlayerX + 7) / 8
2005+ 7D43 ED 4B 2B EB      ld   bc, (PlayerPos)
2006+ 7D47 78               ld   a, b
2007+ 7D48 C6 10            add  a, 16
2008+ 7D4A CB 3F            srl  a
2008+ 7D4C CB 3F          srl  a
2008+ 7D4E CB 3F          srl  a
2009+ 7D50 47               ld   b, a                  ; B = Row
2010+ 7D51
2011+ 7D51 79               ld   a, c
2012+ 7D52 C6 07            add  a, 7
2013+ 7D54 CB 3F            srl  a
2013+ 7D56 CB 3F          srl  a
2013+ 7D58 CB 3F          srl  a   ; A = Col2 (0..31)
2014+ 7D5A 4F               ld   c, a                  ; C = Col2
2015+ 7D5B
2016+ 7D5B                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2017+ 7D5B 3A 2B EB         ld   a, (PlayerPos)        ; A = PlayerX
2018+ 7D5E CB 3F            srl  a
2018+ 7D60 CB 3F          srl  a
2018+ 7D62 CB 3F          srl  a   ; A = Col1
2019+ 7D64 B9               cp   c
2020+ 7D65 28 0B            jr   z, .done_trigger
2021+ 7D67
2022+ 7D67 78               ld   a, b
2023+ 7D68 CD 48 7A         call GetCellFromUnpacked
2024+ 7D6B FE 02            cp   2
2025+ 7D6D 20 03            jr   nz, .done_trigger
2026+ 7D6F
2027+ 7D6F                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
2028+ 7D6F CD 76 7D         call .advance_crumble_cell

2114+ 7E4B              ; Phys_UpdateAir
2115+ 7E4B              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2116+ 7E4B              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2117+ 7E4B              ; Output:
2118+ 7E4B              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2119+ 7E4B              ;   Carry Clear = Aria ancora disponibile
2120+ 7E4B              ; -------------------------------------------------------------------
2121+ 7E4B              Phys_UpdateAir:
2122+ 7E4B                  ; Incrementa il timer dei frame
2123+ 7E4B 3A ED F1         ld   a, (air_timer)
2124+ 7E4E 3C               inc  a
2125+ 7E4F 32 ED F1         ld   (air_timer), a
2126+ 7E52 21 EE F1         ld   hl, air_deplete_rate
2127+ 7E55 BE               cp   (hl)
2128+ 7E56 38 14            jr   c, .no_deplete
2129+ 7E58
2130+ 7E58                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2131+ 7E58 AF               xor  a
2132+ 7E59 32 ED F1         ld   (air_timer), a
2133+ 7E5C
2134+ 7E5C 3A EC F1         ld   a, (air_pixels)
2135+ 7E5F B7               or   a
2136+ 7E60 28 0C            jr   z, .air_finished
2137+ 7E62
2138+ 7E62 3D               dec  a
2139+ 7E63 32 EC F1         ld   (air_pixels), a
2140+ 7E66 CD 42 6A         call Gfx_UpdateAirBar
2141+ 7E69
2142+ 7E69 B7               or   a
2143+ 7E6A 28 02            jr   z, .air_finished
2144+ 7E6C
2145+ 7E6C              .no_deplete:
2146+ 7E6C B7               or   a                     ; Carry Clear = Ok
2147+ 7E6D C9               ret
2148+ 7E6E
2149+ 7E6E              .air_finished:
2150+ 7E6E 37               scf                        ; Carry Set = Morte per esaurimento aria
2151+ 7E6F C9               ret

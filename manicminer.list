   5+ 6EF9              ; -------------------------------------------------------------------
   6+ 6EF9              ; MovePlayer
   7+ 6EF9              ;
   8+ 6EF9              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6EF9              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6EF9              ; con i muri.
  11+ 6EF9              ;
  12+ 6EF9              ; Input:
  13+ 6EF9              ;   D = stato dei controlli (bitfield)
  14+ 6EF9              ;
  15+ 6EF9              ; Strutture utilizzate:
  16+ 6EF9              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6EF9              ;   player_speed    -> velocità orizzontale
  18+ 6EF9              ;   flags           -> flag di stato input
  19+ 6EF9              ;
  20+ 6EF9              ; Bit controlli:
  21+ 6EF9              ;   bit 0 = sinistra
  22+ 6EF9              ;   bit 1 = destra
  23+ 6EF9              ;
  24+ 6EF9              ; Nota:
  25+ 6EF9              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6EF9              ;   ignorato per tutta la durata del salto.
  27+ 6EF9              ;
  28+ 6EF9              ; Output:
  29+ 6EF9              ;   aggiorna PlayerPos e body_state
  30+ 6EF9              ; -------------------------------------------------------------------
  31+ 6EF9              MovePlayer:
  32+ 6EF9
  33+ 6EF9                  ; ---------------------------------------------------------------
  34+ 6EF9                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6EF9                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6EF9                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6EF9                  ; ---------------------------------------------------------------
  38+ 6EF9 3A 3A EB         ld   a, (on_ground)
  39+ 6EFC B7               or   a
  40+ 6EFD 20 20            jr   nz, .on_ground_check
  41+ 6EFF
  42+ 6EFF                  ; In aria: resetta lo stato di cattura del nastro
  43+ 6EFF AF               xor  a
  44+ 6F00 32 57 EE         ld   (conveyor_caught), a
  45+ 6F03
  46+ 6F03 3A 3F EB         ld   a, (jump_dir)
  47+ 6F06 B7               or   a
  48+ 6F07 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  49+ 6F08
  50+ 6F08                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  51+ 6F08 DD 21 33 EB      ld   ix, flags
  52+ 6F0C DD CB 00 86      res  $00, (ix)
  53+ 6F10
  54+ 6F10 ED 4B 2B EB      ld   bc, (PlayerPos)
  55+ 6F14 FE 01            cp   1
  56+ 6F16 CA E9 6F         jp   z, movePlayer_left
  57+ 6F19 FE 02            cp   2
  58+ 6F1B CA 18 70         jp   z, movePlayer_right
  59+ 6F1E C9               ret
  60+ 6F1F
  61+ 6F1F              .on_ground_check:
  62+ 6F1F                  ; ---------------------------------------------------------------
  63+ 6F1F                  ; Controlla se Willy è sopra un nastro trasportatore (Conveyor)
  64+ 6F1F                  ; ---------------------------------------------------------------
  65+ 6F1F CD 97 78         call CheckWillyOnConveyor
  66+ 6F22 38 20            jr   c, .on_conveyor_ground
  67+ 6F24
  68+ 6F24                  ; ---------------------------------------------------------------
  69+ 6F24                  ; Terreno normale (non su conveyor):
  70+ 6F24                  ; Resetta lo stato di cattura del conveyor
  71+ 6F24                  ; ---------------------------------------------------------------
  72+ 6F24 AF               xor  a
  73+ 6F25 32 57 EE         ld   (conveyor_caught), a
  74+ 6F28
  75+ 6F28 DD 21 33 EB      ld   ix, flags
  76+ 6F2C DD CB 00 46      bit  $00, (ix)
  77+ 6F30 C8               ret  z
  78+ 6F31
  79+ 6F31 DD CB 00 86      res  $00, (ix)
  80+ 6F35
  81+ 6F35 ED 4B 2B EB      ld   bc, (PlayerPos)
  82+ 6F39
  83+ 6F39              .ground_input:
  84+ 6F39                  ; ---------------------------------------------------------------
  85+ 6F39                  ; Input: destra?
  86+ 6F39                  ; ---------------------------------------------------------------
  87+ 6F39 CB 4A            bit  $01, d
  88+ 6F3B C2 18 70         jp   nz, movePlayer_right
  89+ 6F3E
  90+ 6F3E                  ; ---------------------------------------------------------------
  91+ 6F3E                  ; Input: sinistra?
  92+ 6F3E                  ; ---------------------------------------------------------------
  93+ 6F3E CB 42            bit  $00, d
  94+ 6F40 C8               ret  z
  95+ 6F41 C3 E9 6F         jp   movePlayer_left
  96+ 6F44
  97+ 6F44              .on_conveyor_ground:
  98+ 6F44                  ; ---------------------------------------------------------------
  99+ 6F44                  ; Willy si trova sul nastro trasportatore:
 100+ 6F44                  ; - Se Willy monta sul nastro muovendosi nella direzione opposta
 101+ 6F44                  ;   allo scorrimento, finché tiene premuto il tasto direzionale
 102+ 6F44                  ;   continua il movimento nella direzione scelta.
 103+ 6F44                  ; - Non appena il tasto direzionale opposto viene rilasciato,
 104+ 6F44                  ;   Willy viene catturato dal nastro (conveyor_caught = 1) e trascinato
 105+ 6F44                  ;   nella direzione del nastro.
 106+ 6F44                  ; - Se il tasto opposto viene ripremuto mentre Willy è già catturato
 107+ 6F44                  ;   sul nastro, non ha alcun effetto e Willy continua a essere trascinato.
 108+ 6F44                  ; ---------------------------------------------------------------
 109+ 6F44 DD 21 33 EB      ld   ix, flags
 110+ 6F48 DD CB 00 86      res  $00, (ix)
 111+ 6F4C ED 4B 2B EB      ld   bc, (PlayerPos)
 112+ 6F50
 113+ 6F50 3A 53 EE         ld   a, (conveyor_dir)
 114+ 6F53 B7               or   a
 115+ 6F54 20 31            jr   nz, .conv_is_right
 116+ 6F56
 117+ 6F56                  ; ── CONVEYOR VA A SINISTRA (conveyor_dir == 0) ──
 118+ 6F56                  ; Tasto opposto = DESTRA (bit 1 di D)
 119+ 6F56 CB 4A            bit  $01, d                 ; Premuto DESTRA (opposto)?
 120+ 6F58 20 0D            jr   nz, .check_oppose_right
 121+ 6F5A
 122+ 6F5A                  ; Non sta premendo Destra: Willy viene catturato dal nastro a Sinistra
 123+ 6F5A 3E 01            ld   a, 1
 124+ 6F5C 32 57 EE         ld   (conveyor_caught), a
 125+ 6F5F
 126+ 6F5F                  ; Muovi a Sinistra (trascinamento del nastro)
 127+ 6F5F 3E 01            ld   a, 1
 128+ 6F61 32 32 EB         ld   (direction), a
 129+ 6F64 C3 E9 6F         jp   movePlayer_left
 130+ 6F67
 131+ 6F67              .check_oppose_right:
 132+ 6F67                  ; Sta premendo Destra contro il nastro a Sinistra.
 133+ 6F67                  ; Se sta saltando (bit 2 di D o jump_pressed), permetti sempre il salto a Destra
 134+ 6F67 CB 52            bit  2, d
 135+ 6F69 20 0C            jr   nz, .do_move_right
 136+ 6F6B 3A 3B EB         ld   a, (jump_pressed)
 137+ 6F6E B7               or   a
 138+ 6F6F 20 06            jr   nz, .do_move_right
 139+ 6F71
 140+ 6F71                  ; Se era già stato catturato (tasto rilasciato prima sul nastro), ignora l'input!
 141+ 6F71 3A 57 EE         ld   a, (conveyor_caught)
 142+ 6F74 B7               or   a
 143+ 6F75 20 08            jr   nz, .right_ignored_drag_left
 144+ 6F77
 145+ 6F77              .do_move_right:
 146+ 6F77                  ; Non era ancora catturato o sta saltando: continua a muoversi a Destra!
 147+ 6F77 3E 02            ld   a, 2
 148+ 6F79 32 32 EB         ld   (direction), a
 149+ 6F7C C3 18 70         jp   movePlayer_right
 150+ 6F7F
 151+ 6F7F              .right_ignored_drag_left:
 152+ 6F7F                  ; Tasto opposto ignorato: continua il trascinamento a Sinistra
 153+ 6F7F 3E 01            ld   a, 1
 154+ 6F81 32 32 EB         ld   (direction), a
 155+ 6F84 C3 E9 6F         jp   movePlayer_left
 156+ 6F87
 157+ 6F87              .conv_is_right:
 158+ 6F87                  ; ── CONVEYOR VA A DESTRA (conveyor_dir == 1) ──
 159+ 6F87                  ; Tasto opposto = SINISTRA (bit 0 di D)
 160+ 6F87 CB 42            bit  $00, d                 ; Premuto SINISTRA (opposto)?
 161+ 6F89 20 0D            jr   nz, .check_oppose_left
 162+ 6F8B
 163+ 6F8B                  ; Non sta premendo Sinistra: Willy viene catturato dal nastro a Destra
 164+ 6F8B 3E 01            ld   a, 1
 165+ 6F8D 32 57 EE         ld   (conveyor_caught), a
 166+ 6F90
 167+ 6F90                  ; Muovi a Destra (trascinamento del nastro)
 168+ 6F90 3E 02            ld   a, 2
 169+ 6F92 32 32 EB         ld   (direction), a
 170+ 6F95 C3 18 70         jp   movePlayer_right
 171+ 6F98
 172+ 6F98              .check_oppose_left:
 173+ 6F98                  ; Sta premendo Sinistra contro il nastro a Destra.
 174+ 6F98                  ; Se sta saltando (bit 2 di D o jump_pressed), permetti sempre il salto a Sinistra
 175+ 6F98 CB 52            bit  2, d
 176+ 6F9A 20 0C            jr   nz, .do_move_left
 177+ 6F9C 3A 3B EB         ld   a, (jump_pressed)
 178+ 6F9F B7               or   a
 179+ 6FA0 20 06            jr   nz, .do_move_left
 180+ 6FA2
 181+ 6FA2                  ; Se era già stato catturato (tasto rilasciato prima sul nastro), ignora l'input!
 182+ 6FA2 3A 57 EE         ld   a, (conveyor_caught)
 183+ 6FA5 B7               or   a
 184+ 6FA6 20 08            jr   nz, .left_ignored_drag_right
 185+ 6FA8
 186+ 6FA8              .do_move_left:
 187+ 6FA8                  ; Non era ancora catturato o sta saltando: continua a muoversi a Sinistra!
 188+ 6FA8 3E 01            ld   a, 1
 189+ 6FAA 32 32 EB         ld   (direction), a
 190+ 6FAD C3 E9 6F         jp   movePlayer_left
 191+ 6FB0
 192+ 6FB0              .left_ignored_drag_right:
 193+ 6FB0                  ; Tasto opposto ignorato: continua il trascinamento a Destra
 194+ 6FB0 3E 02            ld   a, 2

 190  8516                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 191  8516 C3 19 85         jp   .willy_dies
 192  8519                  ELSE
 193  8519 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 194  8519 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 195  8519 ~                    ELSE
 196  8519 ~                    jp   .no_collision
 197  8519 ~                    ENDIF
 198  8519                  ENDIF

 414+ 7F31 DD 21 E2 7C      ld   ix, ActiveEnemies
 415+ 7F35 06 08            ld   b, 8                      ; 8 slot
 416+ 7F37              .loop:
 417+ 7F37 DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7F3A E6 80            and  $80                       ; Active?
 419+ 7F3C CA DB 7F         jp   z, .next
 420+ 7F3F
 421+ 7F3F                  ; 1. Aggiorna Anim State (0..3)
 422+ 7F3F DD 7E 07         ld   a, (ix+7)
 423+ 7F42 3C               inc  a
 424+ 7F43 E6 03            and  3
 425+ 7F45 DD 77 07         ld   (ix+7), a
 426+ 7F48
 427+ 7F48                  ; 2. Determina se orizzontale o verticale
 428+ 7F48 DD 7E 00         ld   a, (ix+0)
 429+ 7F4B E6 40            and  $40                       ; Vertical?
 430+ 7F4D C2 97 7F         jp   nz, .vertical
 431+ 7F50
 432+ 7F50              .horizontal:
 433+ 7F50 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7F53 FE 01            cp   1
 435+ 7F55 20 20            jr   nz, .horiz_right
 436+ 7F57
 437+ 7F57              .horiz_left:
 438+ 7F57 DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7F5A D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7F5C DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7F5F 28 08            jr   z, .h_rev_right
 442+ 7F61 38 06            jr   c, .h_rev_right
 443+ 7F63 DD 77 02         ld   (ix+2), a
 444+ 7F66 C3 DB 7F         jp   .next
 445+ 7F69
 446+ 7F69              .h_rev_right:
 447+ 7F69 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7F6C DD 77 02         ld   (ix+2), a
 449+ 7F6F 3E 02            ld   a, 2
 450+ 7F71 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7F74 C3 DB 7F         jp   .next
 452+ 7F77
 453+ 7F77              .horiz_right:
 454+ 7F77 DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7F7A C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7F7C DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7F7F 28 08            jr   z, .h_rev_left
 458+ 7F81 30 06            jr   nc, .h_rev_left
 459+ 7F83 DD 77 02         ld   (ix+2), a
 460+ 7F86 C3 DB 7F         jp   .next
 461+ 7F89
 462+ 7F89              .h_rev_left:
 463+ 7F89 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7F8C DD 77 02         ld   (ix+2), a
 465+ 7F8F 3E 01            ld   a, 1
 466+ 7F91 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7F94 C3 DB 7F         jp   .next
 468+ 7F97
 469+ 7F97              .vertical:
 470+ 7F97 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7F9A FE 01            cp   1
 472+ 7F9C 20 20            jr   nz, .vert_down
 473+ 7F9E
 474+ 7F9E              .vert_up:
 475+ 7F9E DD 7E 03         ld   a, (ix+3)                 ; Current Y
 476+ 7FA1 D6 02            sub  2
 477+ 7FA3 DD BE 04         cp   (ix+4)
 478+ 7FA6 28 08            jr   z, .v_rev_down
 479+ 7FA8 38 06            jr   c, .v_rev_down
 480+ 7FAA DD 77 03         ld   (ix+3), a
 481+ 7FAD C3 DB 7F         jp   .next
 482+ 7FB0
 483+ 7FB0              .v_rev_down:
 484+ 7FB0 DD 7E 04         ld   a, (ix+4)
 485+ 7FB3 DD 77 03         ld   (ix+3), a
 486+ 7FB6 3E 02            ld   a, 2
 487+ 7FB8 DD 77 06         ld   (ix+6), a
 488+ 7FBB C3 DB 7F         jp   .next
 489+ 7FBE
 490+ 7FBE              .vert_down:
 491+ 7FBE DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7FC1 C6 02            add  a, 2
 493+ 7FC3 DD BE 05         cp   (ix+5)
 494+ 7FC6 28 08            jr   z, .v_rev_up
 495+ 7FC8 30 06            jr   nc, .v_rev_up
 496+ 7FCA DD 77 03         ld   (ix+3), a
 497+ 7FCD C3 DB 7F         jp   .next
 498+ 7FD0
 499+ 7FD0              .v_rev_up:
 500+ 7FD0 DD 7E 05         ld   a, (ix+5)
 501+ 7FD3 DD 77 03         ld   (ix+3), a
 502+ 7FD6 3E 01            ld   a, 1
 503+ 7FD8 DD 77 06         ld   (ix+6), a

 163+ 7D80 32 DD E5         ld   (room_has_v_guardians), a
 164+ 7D83 18 06            jr   .has_v_guardians
 165+ 7D85
 166+ 7D85              .no_v_guardians:
 167+ 7D85 AF               xor  a

 152+ 6F08 CB 42            bit  $00, d                 ; Premuto SINISTRA (opposto)?
 153+ 6F0A 20 0D            jr   nz, .check_oppose_left
 154+ 6F0C
 155+ 6F0C                  ; Non sta premendo Sinistra: Willy viene catturato dal nastro a Destra
 156+ 6F0C 3E 01            ld   a, 1
 157+ 6F0E 32 18 E5         ld   (conveyor_caught), a

1239+ 75A4 18 12            jr   .store_cell
1240+ 75A6              .is_wall:
1241+ 75A6 3E 03            ld   a, 3
1242+ 75A8 18 0E            jr   .store_cell
1243+ 75AA              .is_conveyor:
1244+ 75AA 3E 04            ld   a, 4
1245+ 75AC 18 0A            jr   .store_cell
1246+ 75AE              .is_nasty1:
1247+ 75AE 3E 05            ld   a, 5
1248+ 75B0 18 06            jr   .store_cell
1249+ 75B2              .is_nasty2:

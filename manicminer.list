 414+ 862C              ; CheckWillyItemCollision
 415+ 862C              ;
 416+ 862C              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 862C              ; Input:
 418+ 862C              ;   A = Item Col (0..31)
 419+ 862C              ;   H = Item Row (0..15)
 420+ 862C              ; Output:
 421+ 862C              ;   Carry Set = Collisione
 422+ 862C              ;   Carry Clear = Nessuna collisione
 423+ 862C              ; -------------------------------------------------------------------
 424+ 862C              CheckWillyItemCollision:
 425+ 862C C5               push bc
 426+ 862D D5               push de
 427+ 862E E5               push hl
 428+ 862F
 429+ 862F                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 862F 6F               ld   l, a
 431+ 8630 87               add  a, a                      ; *2
 432+ 8631 87               add  a, a                      ; *4
 433+ 8632 87               add  a, a                      ; *8
 434+ 8633 5F               ld   e, a                      ; E = ItemLeft
 435+ 8634 C6 07            add  a, 7
 436+ 8636 57               ld   d, a                      ; D = ItemRight
 437+ 8637
 438+ 8637 ED 4B 47 EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 863B
 440+ 863B                  ; WillyLeft <= ItemRight
 441+ 863B 79               ld   a, c                      ; A = WillyX
 442+ 863C BA               cp   d                         ; D = ItemRight
 443+ 863D 28 04            jr   z, .x_ok
 444+ 863F 38 02            jr   c, .x_ok
 445+ 8641 18 31            jr   .no_collision
 446+ 8643
 447+ 8643              .x_ok:
 448+ 8643                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8643 BB               cp   e                         ; E = ItemLeft
 450+ 8644 28 0B            jr   z, .y_check
 451+ 8646 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8648
 453+ 8648                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 8648 C6 0F            add  a, 15
 455+ 864A BB               cp   e
 456+ 864B 28 04            jr   z, .y_check
 457+ 864D 30 02            jr   nc, .y_check
 458+ 864F 18 23            jr   .no_collision
 459+ 8651
 460+ 8651              .y_check:
 461+ 8651                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 8651 7C               ld   a, h                      ; H = Item Row
 463+ 8652 87               add  a, a                      ; *2
 464+ 8653 87               add  a, a                      ; *4
 465+ 8654 87               add  a, a                      ; *8
 466+ 8655 5F               ld   e, a                      ; E = ItemTop
 467+ 8656 C6 07            add  a, 7
 468+ 8658 57               ld   d, a                      ; D = ItemBottom
 469+ 8659
 470+ 8659                  ; WillyTop <= ItemBottom
 471+ 8659 78               ld   a, b                      ; A = WillyY
 472+ 865A BA               cp   d                         ; D = ItemBottom
 473+ 865B 28 04            jr   z, .y_ok
 474+ 865D 38 02            jr   c, .y_ok
 475+ 865F 18 13            jr   .no_collision
 476+ 8661
 477+ 8661              .y_ok:
 478+ 8661                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8661 BB               cp   e                         ; E = ItemTop
 480+ 8662 28 0B            jr   z, .collision
 481+ 8664 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8666
 483+ 8666                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8666 C6 0F            add  a, 15
 485+ 8668 BB               cp   e
 486+ 8669 28 04            jr   z, .collision
 487+ 866B 30 02            jr   nc, .collision
 488+ 866D 18 05            jr   .no_collision
 489+ 866F

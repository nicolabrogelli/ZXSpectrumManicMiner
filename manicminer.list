1163+ 7921                  ; Confronta con le 8 definizioni di tile:
1164+ 7921 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1165+ 7924 28 23            jr   z, .is_bg
1166+ 7926 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1167+ 7929 28 29            jr   z, .is_wall
1168+ 792B DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1169+ 792E 28 1C            jr   z, .is_floor
1170+ 7930 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1171+ 7933 28 1B            jr   z, .is_crumbling
1172+ 7935 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1173+ 7938 28 1E            jr   z, .is_conveyor
1174+ 793A DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1175+ 793D 28 1D            jr   z, .is_nasty1
1176+ 793F DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1177+ 7942 28 1C            jr   z, .is_nasty2
1178+ 7944 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1179+ 7947 28 1B            jr   z, .is_extra

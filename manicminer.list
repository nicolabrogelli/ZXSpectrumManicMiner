 413+ 870D              ; -------------------------------------------------------------------
 414+ 870D              ; CheckWillyItemCollision
 415+ 870D              ;
 416+ 870D              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 870D              ; Input:
 418+ 870D              ;   A = Item Col (0..31)
 419+ 870D              ;   H = Item Row (0..15)
 420+ 870D              ; Output:
 421+ 870D              ;   Carry Set = Collisione
 422+ 870D              ;   Carry Clear = Nessuna collisione
 423+ 870D              ; -------------------------------------------------------------------
 424+ 870D              CheckWillyItemCollision:
 425+ 870D C5               push bc
 426+ 870E D5               push de
 427+ 870F E5               push hl
 428+ 8710
 429+ 8710                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8710 6F               ld   l, a
 431+ 8711 87               add  a, a                      ; *2
 432+ 8712 87               add  a, a                      ; *4
 433+ 8713 87               add  a, a                      ; *8
 434+ 8714 5F               ld   e, a                      ; E = ItemLeft
 435+ 8715 C6 07            add  a, 7
 436+ 8717 57               ld   d, a                      ; D = ItemRight
 437+ 8718
 438+ 8718 ED 4B 2B EB      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 871C
 440+ 871C                  ; WillyLeft <= ItemRight
 441+ 871C 79               ld   a, c                      ; A = WillyX
 442+ 871D BA               cp   d                         ; D = ItemRight
 443+ 871E 28 04            jr   z, .x_ok
 444+ 8720 38 02            jr   c, .x_ok
 445+ 8722 18 31            jr   .no_collision
 446+ 8724
 447+ 8724              .x_ok:
 448+ 8724                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8724 BB               cp   e                         ; E = ItemLeft
 450+ 8725 28 0B            jr   z, .y_check
 451+ 8727 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8729
 453+ 8729                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 8729 C6 07            add  a, 7
 455+ 872B BB               cp   e
 456+ 872C 28 04            jr   z, .y_check
 457+ 872E 30 02            jr   nc, .y_check
 458+ 8730 18 23            jr   .no_collision
 459+ 8732
 460+ 8732              .y_check:
 461+ 8732                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 8732 7C               ld   a, h                      ; H = Item Row
 463+ 8733 87               add  a, a                      ; *2
 464+ 8734 87               add  a, a                      ; *4
 465+ 8735 87               add  a, a                      ; *8
 466+ 8736 5F               ld   e, a                      ; E = ItemTop
 467+ 8737 C6 07            add  a, 7
 468+ 8739 57               ld   d, a                      ; D = ItemBottom
 469+ 873A
 470+ 873A                  ; WillyTop <= ItemBottom
 471+ 873A 78               ld   a, b                      ; A = WillyY
 472+ 873B BA               cp   d                         ; D = ItemBottom
 473+ 873C 28 04            jr   z, .y_ok
 474+ 873E 38 02            jr   c, .y_ok
 475+ 8740 18 13            jr   .no_collision
 476+ 8742
 477+ 8742              .y_ok:
 478+ 8742                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8742 BB               cp   e                         ; E = ItemTop
 480+ 8743 28 0B            jr   z, .collision
 481+ 8745 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8747
 483+ 8747                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8747 C6 0F            add  a, 15
 485+ 8749 BB               cp   e
 486+ 874A 28 04            jr   z, .collision
 487+ 874C 30 02            jr   nc, .collision
 488+ 874E 18 05            jr   .no_collision
 489+ 8750
 490+ 8750              .collision:
 491+ 8750 E1               pop  hl
 492+ 8751 D1               pop  de
 493+ 8752 C1               pop  bc
 494+ 8753 37               scf
 495+ 8754 C9               ret
 496+ 8755
 497+ 8755              .no_collision:
 498+ 8755 E1               pop  hl
 499+ 8756 D1               pop  de
 500+ 8757 C1               pop  bc
 501+ 8758 B7               or   a
 502+ 8759 C9               ret
 503+ 875A
 504+ 875A              ; -------------------------------------------------------------------
 505+ 875A              ; Items_CheckCollision
 506+ 875A              ;
 507+ 875A              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 508+ 875A              ; -------------------------------------------------------------------
 509+ 875A              Items_CheckCollision:
 510+ 875A E5               push hl
 511+ 875B D5               push de
 512+ 875C C5               push bc
 513+ 875D FD E5            push iy
 514+ 875F
 515+ 875F 3A AC EE         ld   a, (num_room_items)
 516+ 8762 B7               or   a
 517+ 8763 28 66            jr   z, .done
 518+ 8765
 519+ 8765 FD 21 5C EE      ld   iy, current_room_items
 520+ 8769
 521+ 8769              .loop:
 522+ 8769 FD 7E 02         ld   a, (iy+2)                 ; Color / Active / Terminator ($FF)
 523+ 876C FE FF            cp   $FF
 524+ 876E 28 5B            jr   z, .done                  ; Fine lista item della stanza
 525+ 8770 B7               or   a
 526+ 8771 28 51            jr   z, .next_item             ; Item già raccolto -> controlla il successivo
 527+ 8773
 528+ 8773 FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 529+ 8776 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 530+ 8779
 531+ 8779 79               ld   a, c
 532+ 877A CD 0D 87         call CheckWillyItemCollision
 533+ 877D 30 45            jr   nc, .next_item
 534+ 877F
 535+ 877F                  ; --- ITEM RACCOLTO ---
 536+ 877F                  ; 1. Imposta il flag collected nei dati stanza
 537+ 877F FD 6E 03         ld   l, (iy+3)
 538+ 8782 FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 539+ 8785 36 00            ld   (hl), 0                   ; 0 = raccolto

  68+ 79A0 B7               or   a
  69+ 79A1 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 79A3
  71+ 79A3                  ; Slot attivo
  72+ 79A3 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 79A7 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 79AA
  75+ 79AA 23               inc  hl
  76+ 79AB 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 79AC 23               inc  hl
  78+ 79AD 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 79AE
  80+ 79AE                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 79AE E5               push hl
  82+ 79AF C5               push bc

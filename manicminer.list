 678+ 8659
 679+ 8659                  ; Byte 1:
 680+ 8659 3A 9E E7         ld   a, (player_score + 1)
 681+ 865C 47               ld   b, a
 682+ 865D 3A A1 E7         ld   a, (high_score + 1)
 683+ 8660 B8               cp   b
 684+ 8661 38 0C            jr   c, .new_high_score
 685+ 8663 20 1C            jr   nz, .done_check
 686+ 8665
 687+ 8665                  ; Byte 0:
 688+ 8665 3A 9D E7         ld   a, (player_score + 0)
 689+ 8668 47               ld   b, a
 690+ 8669 3A A0 E7         ld   a, (high_score + 0)
 691+ 866C B8               cp   b
 692+ 866D 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 693+ 866F
 694+ 866F              .new_high_score:
 695+ 866F 3A 9D E7         ld   a, (player_score + 0)
 696+ 8672 32 A0 E7         ld   (high_score + 0), a

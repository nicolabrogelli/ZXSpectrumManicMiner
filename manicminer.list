  68+ 7DBD B7               or   a
  69+ 7DBE 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7DC0
  71+ 7DC0                  ; Slot attivo
  72+ 7DC0 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7DC4 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7DC7
  75+ 7DC7 23               inc  hl

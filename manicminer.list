 443+ 5F90              ; -------------------------------------------------------------------
 444+ 5F90              ; Disegna uno sprite 16x16 a coordinate pixel (X, Y)
 445+ 5F90              ; Input: C = X, B = Y, IX = puntatore dati sprite (32 byte)
 446+ 5F90              ; -------------------------------------------------------------------
 447+ 5F90              Gfx_DrawPixelSprite16x16:
 448+ 5F90 C5               push bc
 449+ 5F91 D5               push de
 450+ 5F92 E5               push hl
 451+ 5F93 DD E5            push ix
 452+ 5F95
 453+ 5F95                  ; 1. Salva la coordinata X per calcolare lo shift
 454+ 5F95 79               ld   a, c
 455+ 5F96 E6 07            and  7
 456+ 5F98 32 94 93         ld   (sprite_shift), a
 457+ 5F9B
 458+ 5F9B                  ; 2. Calcola indirizzo schermo
 459+ 5F9B 60               ld   h, b

2089+ 7E26              ; Phys_UpdateAir
2090+ 7E26              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2091+ 7E26              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2092+ 7E26              ; Output:
2093+ 7E26              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2094+ 7E26              ;   Carry Clear = Aria ancora disponibile
2095+ 7E26              ; -------------------------------------------------------------------
2096+ 7E26              Phys_UpdateAir:
2097+ 7E26                  ; Incrementa il timer dei frame
2098+ 7E26 3A C7 F1         ld   a, (air_timer)
2099+ 7E29 3C               inc  a
2100+ 7E2A 32 C7 F1         ld   (air_timer), a
2101+ 7E2D 21 C8 F1         ld   hl, air_deplete_rate
2102+ 7E30 BE               cp   (hl)
2103+ 7E31 38 14            jr   c, .no_deplete
2104+ 7E33
2105+ 7E33                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2106+ 7E33 AF               xor  a
2107+ 7E34 32 C7 F1         ld   (air_timer), a
2108+ 7E37
2109+ 7E37 3A C6 F1         ld   a, (air_pixels)
2110+ 7E3A B7               or   a
2111+ 7E3B 28 0C            jr   z, .air_finished
2112+ 7E3D
2113+ 7E3D 3D               dec  a
2114+ 7E3E 32 C6 F1         ld   (air_pixels), a
2115+ 7E41 CD 42 6A         call Gfx_UpdateAirBar
2116+ 7E44
2117+ 7E44 B7               or   a
2118+ 7E45 28 02            jr   z, .air_finished
2119+ 7E47
2120+ 7E47              .no_deplete:
2121+ 7E47 B7               or   a                     ; Carry Clear = Ok
2122+ 7E48 C9               ret
2123+ 7E49
2124+ 7E49              .air_finished:
2125+ 7E49 37               scf                        ; Carry Set = Morte per esaurimento aria
2126+ 7E4A C9               ret

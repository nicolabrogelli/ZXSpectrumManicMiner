 482  85A4                  ; - Reimposta la fisica e le variabili di stato di Willy
 483  85A4 AF               xor  a
 484  85A5 32 40 9E         ld   (velocity_y), a
 485  85A8 32 42 9E         ld   (jump_pressed), a
 486  85AB 32 44 9E         ld   (coyote_timer), a
 487  85AE 32 47 9E         ld   (jump_frame), a
 488  85B1 32 46 9E         ld   (jump_dir), a
 489  85B4 32 38 9E         ld   (body_state), a
 490  85B7 32 4B 9E         ld   (w_warp_state), a
 491  85BA 32 4E 9E         ld   (w_key_prev), a
 492  85BD 32 4F 9E         ld   (enter_key_prev), a
 493  85C0 32 3B 9E         ld   (collision_active), a
 494  85C3 32 3A 9E         ld   (flags), a
 495  85C6 32 34 A2         ld   (ramp_entry_guard), a
 496  85C9 32 3F A2         ld   (willy_on_ramp), a
 497  85CC 32 3E A2         ld   (willy_needs_redraw), a
 498  85CF 3E FF            ld   a, $ff
 499  85D1 32 50 9E         ld   (digit_key_prev), a
 500  85D4 32 39 A2         ld   (player_drawn_pos+1), a
 501  85D7 32 3A A2         ld   (player_old_dir), a
 502  85DA 32 3B A2         ld   (player_old_body), a
 503  85DD 3E 01            ld   a, 1
 504  85DF 32 49 9E         ld   (q_prev), a
 505  85E2 32 4A 9E         ld   (a_prev), a
 506  85E5 32 41 9E         ld   (on_ground), a
 507  85E8 32 3C A2         ld   (enemy_was_updated), a
 508  85EB
 509  85EB                  ; - Timer di sicurezza post-respawn (invulnerabilità)

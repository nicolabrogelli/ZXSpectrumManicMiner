 522+ 7F44 E6 03            and  3
 523+ 7F46 20 02            jr   nz, .v_step_ok
 524+ 7F48 3E 01            ld   a, 1
 525+ 7F4A              .v_step_ok:
 526+ 7F4A 4F               ld   c, a                      ; C = Step
 527+ 7F4B
 528+ 7F4B DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 529+ 7F4E FE 01            cp   1
 530+ 7F50 20 1F            jr   nz, .vert_down
 531+ 7F52
 532+ 7F52              .vert_up:
 533+ 7F52 DD 7E 03         ld   a, (ix+3)                 ; Current Y

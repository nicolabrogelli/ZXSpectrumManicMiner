 213+ 8591
 214+ 8591                  ; Col = Offset & 31
 215+ 8591 7D               ld   a, l
 216+ 8592 E6 1F            and  31
 217+ 8594 4F               ld   c, a                      ; C = Col (0..31)
 218+ 8595
 219+ 8595                  ; Row = Offset / 32

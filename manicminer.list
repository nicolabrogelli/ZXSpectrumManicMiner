1965+ 7D90              ; Phys_CheckCrumblingTrigger
1966+ 7D90              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1967+ 7D90              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1968+ 7D90              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1969+ 7D90              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1970+ 7D90              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1971+ 7D90              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1972+ 7D90              ; -------------------------------------------------------------------
1973+ 7D90              Phys_CheckCrumblingTrigger:
1974+ 7D90 C5               push bc
1975+ 7D91 D5               push de
1976+ 7D92 E5               push hl
1977+ 7D93
1978+ 7D93 ED 4B A3 EB      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1979+ 7D97
1980+ 7D97                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1981+ 7D97 78               ld   a, b
1982+ 7D98 C6 10            add  a, 16
1983+ 7D9A FE 80            cp   128
1984+ 7D9C 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1985+ 7D9E
1986+ 7D9E CB 3F            srl  a
1986+ 7DA0 CB 3F          srl  a
1986+ 7DA2 CB 3F          srl  a   ; A = Row (0..15)
1987+ 7DA4 47               ld   b, a                  ; B = Row
1988+ 7DA5
1989+ 7DA5                  ; Piede sinistro: Col1 = PlayerX / 8
1990+ 7DA5 79               ld   a, c
1991+ 7DA6 CB 3F            srl  a
1991+ 7DA8 CB 3F          srl  a
1991+ 7DAA CB 3F          srl  a   ; A = Col1 (0..31)
1992+ 7DAC 4F               ld   c, a                  ; C = Col1
1993+ 7DAD
1994+ 7DAD                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1995+ 7DAD 78               ld   a, b
1996+ 7DAE CD BD 7A         call GetCellFromUnpacked
1997+ 7DB1 FE 02            cp   2
1998+ 7DB3 20 03            jr   nz, .check_col2
1999+ 7DB5
2000+ 7DB5                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
2001+ 7DB5 CD EB 7D         call .advance_crumble_cell
2002+ 7DB8
2003+ 7DB8              .check_col2:
2004+ 7DB8                  ; Piede destro: Col2 = (PlayerX + 7) / 8
2005+ 7DB8 ED 4B A3 EB      ld   bc, (PlayerPos)
2006+ 7DBC 78               ld   a, b
2007+ 7DBD C6 10            add  a, 16
2008+ 7DBF CB 3F            srl  a
2008+ 7DC1 CB 3F          srl  a
2008+ 7DC3 CB 3F          srl  a
2009+ 7DC5 47               ld   b, a                  ; B = Row
2010+ 7DC6
2011+ 7DC6 79               ld   a, c
2012+ 7DC7 C6 07            add  a, 7
2013+ 7DC9 CB 3F            srl  a
2013+ 7DCB CB 3F          srl  a
2013+ 7DCD CB 3F          srl  a   ; A = Col2 (0..31)
2014+ 7DCF 4F               ld   c, a                  ; C = Col2
2015+ 7DD0
2016+ 7DD0                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2017+ 7DD0 3A A3 EB         ld   a, (PlayerPos)        ; A = PlayerX
2018+ 7DD3 CB 3F            srl  a
2018+ 7DD5 CB 3F          srl  a
2018+ 7DD7 CB 3F          srl  a   ; A = Col1
2019+ 7DD9 B9               cp   c
2020+ 7DDA 28 0B            jr   z, .done_trigger
2021+ 7DDC
2022+ 7DDC 78               ld   a, b
2023+ 7DDD CD BD 7A         call GetCellFromUnpacked
2024+ 7DE0 FE 02            cp   2
2025+ 7DE2 20 03            jr   nz, .done_trigger
2026+ 7DE4
2027+ 7DE4                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
2028+ 7DE4 CD EB 7D         call .advance_crumble_cell
2029+ 7DE7
2030+ 7DE7              .done_trigger:
2031+ 7DE7 E1               pop  hl
2032+ 7DE8 D1               pop  de
2033+ 7DE9 C1               pop  bc
2034+ 7DEA C9               ret
2035+ 7DEB
2036+ 7DEB              .advance_crumble_cell:
2037+ 7DEB                  ; Input: B = Row, C = Col
2038+ 7DEB C5               push bc
2039+ 7DEC D5               push de
2040+ 7DED E5               push hl
2041+ 7DEE
2042+ 7DEE                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2043+ 7DEE 68               ld   l, b
2044+ 7DEF 26 00            ld   h, 0
2045+ 7DF1 29               add  hl, hl
2045+ 7DF2 29             add hl, hl
2045+ 7DF3 29             add hl, hl
2045+ 7DF4 29             add hl, hl
2045+ 7DF5 29             add hl, hl
2046+ 7DF6 59               ld   e, c
2047+ 7DF7 16 00            ld   d, 0
2048+ 7DF9 19               add  hl, de
2049+ 7DFA 11 B5 EF         ld   de, crumbling_grid
2050+ 7DFD 19               add  hl, de
2051+ 7DFE
2052+ 7DFE                  ; 2. Avanza di 1 stadio
2053+ 7DFE 7E               ld   a, (hl)               ; A = Stage (0..8)
2054+ 7DFF FE 08            cp   8
2055+ 7E01 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
2056+ 7E03
2057+ 7E03 3C               inc  a                     ; Avanza di 1 scanline (1..8)
2058+ 7E04 77               ld   (hl), a
2059+ 7E05 5F               ld   e, a                  ; E = nuovo Stage (1..8)
2060+ 7E06
2061+ 7E06                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
2062+ 7E06 E5               push hl
2063+ 7E07 CD 3F 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2064+ 7E0A E1               pop  hl
2065+ 7E0B
2066+ 7E0B                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2067+ 7E0B 7E               ld   a, (hl)
2068+ 7E0C FE 08            cp   8
2069+ 7E0E 38 12            jr   c, .done_advance
2070+ 7E10
2071+ 7E10                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2072+ 7E10 68               ld   l, b                  ; L = Row
2073+ 7E11 26 00            ld   h, 0
2074+ 7E13 29               add  hl, hl
2074+ 7E14 29             add hl, hl
2074+ 7E15 29             add hl, hl
2074+ 7E16 29             add hl, hl
2074+ 7E17 29             add hl, hl
2075+ 7E18 59               ld   e, c
2076+ 7E19 16 00            ld   d, 0
2077+ 7E1B 19               add  hl, de
2078+ 7E1C 11 CA EC         ld   de, unpacked_layout
2079+ 7E1F 19               add  hl, de
2080+ 7E20 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2081+ 7E22
2082+ 7E22              .done_advance:
2083+ 7E22 E1               pop  hl
2084+ 7E23 D1               pop  de
2085+ 7E24 C1               pop  bc
2086+ 7E25 C9               ret

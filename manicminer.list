 145  89A4                  IF ENABLE_ANIMATE_LIVES != 0
 146  89A4 ~                call Gfx_PrintWillyLives
 147  89A4                  ENDIF
 148  89A4
 149  89A4
 150  89A4                  ; 7. Salva le posizioni correnti del player per il prossimo frame
 151  89A4 ED 4B EA EA      ld   bc, (PlayerPos)
 152  89A8 ED 43 EC EA      ld   (PlayerPosOld), bc
 153  89AC
 154  89AC                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 155  89AC CD D6 70         call Input_CheckCtrl
 156  89AF CD F9 6E         call MovePlayer
 157  89B2 CD 3B 74         call Phys_ApplyGravity
 158  89B5                  IF ENABLE_FALL_DEATH != 0
 159  89B5 DA DA 89         jp   c, .willy_dies
 160  89B8                  ENDIF
 161  89B8 CD 1E 81         call Enemy_Update
 162  89BB CD 1C 87         call Items_CheckCollision
 163  89BE CD 31 88         call Items_Animate
 164  89C1 CD 59 84         call Kong_CheckSwitches
 165  89C4
 166  89C4                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 167  89C4 CD 1C 8B         call CheckPortalTransition
 168  89C7 DA 76 8B         jp   c, TriggerPortalTransition
 169  89CA
 170  89CA                  ; Controlla collisione con Nasties (morte di Willy)
 171  89CA                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 172  89CA CD 9A 7C         call Phys_CheckNastyCollision
 173  89CD 38 0B            jr   c, .willy_dies
 174  89CF                  ENDIF
 175  89CF
 176  89CF                  ; Controlla collisione con guardiani
 177  89CF CD CD 82         call CheckCollision
 178  89D2 38 03            jr   c, .guardian_collision_found
 179  89D4
 180  89D4                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 181  89D4                  IF ENABLE_RAMP_DEBUG_BARS != 0
 182  89D4 ~                ld   a, (willy_on_ramp)
 183  89D4 ~                or   a
 184  89D4 ~                jp   nz, .draw_raster_bars
 185  89D4                  ENDIF
 186  89D4
 187  89D4 C3 49 8A         jp   .no_collision
 188  89D7
 189  89D7              .guardian_collision_found:
 190  89D7                  ; C'è collisione con un guardiano!
 191  89D7                  ; Controlla se la morte per collisione con i guardiani è abilitata
 192  89D7                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 193  89D7 C3 DA 89         jp   .willy_dies
 194  89DA                  ELSE
 195  89DA ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 196  89DA ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 197  89DA ~                    ELSE
 198  89DA ~                    jp   .no_collision
 199  89DA ~                    ENDIF
 200  89DA                  ENDIF
 201  89DA
 202  89DA              .willy_dies:
 203  89DA                  ; 1. Decrementa le vite
 204  89DA 21 F7 EA         ld   hl, willy_lives
 205  89DD 7E               ld   a, (hl)
 206  89DE B7               or   a
 207  89DF 28 05            jr   z, .check_game_over
 208  89E1 35               dec  (hl)
 209  89E2 28 02            jr   z, .check_game_over
 210  89E4 18 03            jr   .normal_respawn
 211  89E6
 212  89E6              .check_game_over:
 213  89E6                  IF ENABLE_GAME_OVER_RESTART != 0
 214  89E6 C3 95 8A         jp   TriggerGameOver
 215  89E9                  ELSE
 216  89E9 ~                ld   a, 1
 217  89E9 ~                ld   (willy_lives), a
 218  89E9 ~                jr   .normal_respawn
 219  89E9                  ENDIF
 220  89E9
 221  89E9              .normal_respawn:
 222  89E9                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 223  89E9 CD 8F 85         call Items_ResetCurrentRoomItems
 224  89EC
 225  89EC                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 226  89EC AF               xor  a
 227  89ED D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 228  89EF CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce il display RAM e imposta gli attributi a nero
 229  89F2
 230  89F2                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 231  89F2 06 19            ld   b, 25
 232  89F4              .death_pause:
 233  89F4 76               halt
 234  89F5 10 FD            djnz .death_pause
 235  89F7
 236  89F7                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 237  89F7 AF               xor  a
 238  89F8 32 F8 EA         ld   (velocity_y), a
 239  89FB 32 FA EA         ld   (jump_pressed), a
 240  89FE 32 FC EA         ld   (coyote_timer), a
 241  8A01 32 FF EA         ld   (jump_frame), a
 242  8A04 32 FE EA         ld   (jump_dir), a
 243  8A07 32 F0 EA         ld   (body_state), a
 244  8A0A 32 F3 EE         ld   (player_old_body), a
 245  8A0D 32 F2 EE         ld   (player_old_dir), a
 246  8A10 32 F5 EA         ld   (sprite_shift), a
 247  8A13 32 F3 EA         ld   (collision_active), a
 248  8A16 32 F7 EE         ld   (willy_needs_redraw), a
 249  8A19 32 00 EB         ld   (current_input_dir), a
 250  8A1C 32 15 EE         ld   (conveyor_caught), a
 251  8A1F 32 71 EE         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 252  8A22 3E 01            ld   a, 1
 253  8A24 32 F9 EA         ld   (on_ground), a
 254  8A27
 255  8A27 3E 00            ld   a, RESPAWN_SAFETY_TIME
 256  8A29 32 F6 EE         ld   (willy_safety_timer), a
 257  8A2C
 258  8A2C                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 259  8A2C C3 12 89         jp   LoadRoomAndRestart
 260  8A2F
 261  8A2F              .draw_raster_bars:
 262  8A2F                  ; Collisione attiva: disegna le raster bar nel bordo
 263  8A2F 3A 0B EB         ld   a, (counter)
 264  8A32 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 265  8A34 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  8A36              .raster_loop:
 267  8A36 D3 FE            out  ($fe), a
 268  8A38 3C               inc  a
 269  8A39 E6 07            and  7
 270  8A3B 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  8A3D              .delay:
 272  8A3D 0D               dec  c
 273  8A3E 20 FD            jr   nz, .delay
 274  8A40 10 F4            djnz .raster_loop
 275  8A42
 276  8A42                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  8A42 3A F6 EA         ld   a, (room_border_color)
 278  8A45 D3 FE            out  ($fe), a
 279  8A47 18 05            jr   .no_collision_change
 280  8A49
 281  8A49              .no_collision:
 282  8A49                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 283  8A49 3A F6 EA         ld   a, (room_border_color)
 284  8A4C D3 FE            out  ($fe), a
 285  8A4E
 286  8A4E              .no_collision_change:
 287  8A4E C3 75 89         jp   Main_loop
 288  8A51
 289  8A51              ; -------------------------------------------------------------------
 290  8A51              ; ShowTitleScreen
 291  8A51              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  8A51              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  8A51              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  8A51              ; -------------------------------------------------------------------
 295  8A51              ShowTitleScreen:
 296  8A51                  ; 1. Disegna la schermata iniziale
 297  8A51 CD 7A 64         call Gfx_DrawTitleScreen
 298  8A54
 299  8A54                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  8A54              .wait_title_enter_release:
 301  8A54 76               halt
 302  8A55 3E BF            ld   a, $bf
 303  8A57 DB FE            in   a, ($fe)
 304  8A59 1F               rra
 305  8A5A 30 F8            jr   nc, .wait_title_enter_release
 306  8A5C
 307  8A5C                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  8A5C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  8A5E              .title_loop:
 310  8A5E 76               halt
 311  8A5F
 312  8A5F                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  8A5F 0C               inc  c
 314  8A60 79               ld   a, c
 315  8A61 CB 3F            srl  a
 316  8A63 CB 3F            srl  a
 317  8A65 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  8A67 E6 07            and  7
 319  8A69 5F               ld   e, a
 320  8A6A 16 00            ld   d, 0
 321  8A6C 21 72 64         ld   hl, title_color_table
 322  8A6F 19               add  hl, de
 323  8A70 7E               ld   a, (hl)               ; A = nuovo colore
 324  8A71 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  8A74 06 20            ld   b, 32
 326  8A76              .color_title_loop:
 327  8A76 77               ld   (hl), a
 328  8A77 23               inc  hl
 329  8A78 10 FC            djnz .color_title_loop
 330  8A7A
 331  8A7A                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  8A7A 3E BF            ld   a, $bf
 333  8A7C DB FE            in   a, ($fe)
 334  8A7E 1F               rra
 335  8A7F 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  8A81
 337  8A81                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  8A81              .wait_title_enter_release_after:
 339  8A81 76               halt
 340  8A82 3E BF            ld   a, $bf
 341  8A84 DB FE            in   a, ($fe)
 342  8A86 1F               rra
 343  8A87 30 F8            jr   nc, .wait_title_enter_release_after
 344  8A89
 345  8A89                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  8A89 AF               xor  a
 347  8A8A D3 FE            out  ($fe), a              ; Bordo a nero
 348  8A8C CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  8A8F
 350  8A8F                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  8A8F CD 50 8C         call ResetFullGameState
 352  8A92
 353  8A92                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  8A92 C3 12 89         jp   LoadRoomAndRestart
 355  8A95
 356  8A95              ; -------------------------------------------------------------------
 357  8A95              ; TriggerGameOver
 358  8A95              ; Scatena la sequenza originale di Game Over:
 359  8A95              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  8A95              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  8A95              ;   con suono beeper originale e lampeggio dello schermo.
 362  8A95              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  8A95              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  8A95              ; -------------------------------------------------------------------
 365  8A95              TriggerGameOver:
 366  8A95                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  8A95 CD FC 87         call Score_CheckAndUpdateHighScore
 368  8A98
 369  8A98                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  8A98 CD 12 66         call Gfx_DrawGameOverScreen
 371  8A9B
 372  8A9B                  ; 3. Ritorna al Title Screen originale
 373  8A9B C3 51 8A         jp   ShowTitleScreen
 374  8A9E
 375  8A9E              ; -------------------------------------------------------------------
 376  8A9E              ; TriggerVictory
 377  8A9E              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  8A9E              ; - Pulisce gli elementi di gioco della stanza.
 379  8A9E              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  8A9E              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  8A9E              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  8A9E              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  8A9E              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  8A9E              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  8A9E              ; -------------------------------------------------------------------
 386  8A9E              TriggerVictory:
 387  8A9E                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  8A9E CD FD 66         call Gfx_DrawVictoryScreen
 389  8AA1
 390  8AA1                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8AA1              .wait_keys_release:
 392  8AA1 76               halt
 393  8AA2                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8AA2 01 FE DF         ld   bc, $dffe
 395  8AA5 ED 78            in   a, (c)
 396  8AA7 CB 67            bit  4, a
 397  8AA9 28 F6            jr   z, .wait_keys_release
 398  8AAB
 399  8AAB                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8AAB 01 FE 7F         ld   bc, $7ffe
 401  8AAE ED 78            in   a, (c)
 402  8AB0 CB 5F            bit  3, a
 403  8AB2 28 ED            jr   z, .wait_keys_release
 404  8AB4
 405  8AB4                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8AB4 01 FE BF         ld   bc, $bffe
 407  8AB7 ED 78            in   a, (c)
 408  8AB9 CB 47            bit  0, a
 409  8ABB 28 E4            jr   z, .wait_keys_release
 410  8ABD
 411  8ABD                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8ABD 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8ABF              .wait_choice_loop:
 414  8ABF 76               halt
 415  8AC0
 416  8AC0                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8AC0 0C               inc  c
 418  8AC1 79               ld   a, c
 419  8AC2 CB 3F            srl  a
 420  8AC4 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8AC6 E6 07            and  7
 422  8AC8 5F               ld   e, a
 423  8AC9 16 00            ld   d, 0
 424  8ACB 21 F4 65         ld   hl, victory_color_table
 425  8ACE 19               add  hl, de
 426  8ACF 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8AD0 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8AD3 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8AD5              .color_cycle_loop:
 430  8AD5 77               ld   (hl), a
 431  8AD6 23               inc  hl
 432  8AD7 10 FC            djnz .color_cycle_loop
 433  8AD9
 434  8AD9                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8AD9 01 FE DF         ld   bc, $dffe
 436  8ADC ED 78            in   a, (c)
 437  8ADE CB 67            bit  4, a
 438  8AE0 28 2A            jr   z, .play_again_chosen
 439  8AE2
 440  8AE2                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8AE2 01 FE 7F         ld   bc, $7ffe
 442  8AE5 ED 78            in   a, (c)
 443  8AE7 CB 5F            bit  3, a
 444  8AE9 28 0B            jr   z, .quit_chosen
 445  8AEB
 446  8AEB                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8AEB 01 FE BF         ld   bc, $bffe
 448  8AEE ED 78            in   a, (c)
 449  8AF0 CB 47            bit  0, a
 450  8AF2 28 02            jr   z, .quit_chosen
 451  8AF4
 452  8AF4 18 C9            jr   .wait_choice_loop
 453  8AF6
 454  8AF6              .quit_chosen:
 455  8AF6                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8AF6              .wait_quit_release:
 457  8AF6 76               halt
 458  8AF7 01 FE 7F         ld   bc, $7ffe
 459  8AFA ED 78            in   a, (c)
 460  8AFC CB 5F            bit  3, a
 461  8AFE 28 F6            jr   z, .wait_quit_release
 462  8B00 01 FE BF         ld   bc, $bffe
 463  8B03 ED 78            in   a, (c)
 464  8B05 CB 47            bit  0, a
 465  8B07 28 ED            jr   z, .wait_quit_release
 466  8B09
 467  8B09                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8B09 C3 51 8A         jp   ShowTitleScreen
 469  8B0C
 470  8B0C              .play_again_chosen:
 471  8B0C                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8B0C              .wait_play_again_release:
 473  8B0C 76               halt
 474  8B0D 01 FE DF         ld   bc, $dffe
 475  8B10 ED 78            in   a, (c)
 476  8B12 CB 67            bit  4, a
 477  8B14 28 F6            jr   z, .wait_play_again_release
 478  8B16
 479  8B16                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8B16 CD 50 8C         call ResetFullGameState
 481  8B19 C3 12 89         jp   LoadRoomAndRestart
 482  8B1C
 483  8B1C              ; -------------------------------------------------------------------
 484  8B1C              ; CheckPortalTransition
 485  8B1C              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8B1C              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8B1C              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8B1C              ;
 489  8B1C              ; Output:
 490  8B1C              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8B1C              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8B1C              ; -------------------------------------------------------------------
 493  8B1C              CheckPortalTransition:
 494  8B1C C5               push bc
 495  8B1D D5               push de
 496  8B1E E5               push hl
 497  8B1F
 498  8B1F                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8B1F CD E3 8B         call CheckAllItemsCollected
 500  8B22 30 4D            jr   nc, .no_transition
 501  8B24
 502  8B24                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8B24                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8B24                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8B24 2A 6B EE         ld   hl, (room_ptr)
 506  8B27 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8B2A 19               add  hl, de
 508  8B2B 4E               ld   c, (hl)
 509  8B2C 23               inc  hl
 510  8B2D 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8B2E
 512  8B2E                  ; Offset = BC - 23552
 513  8B2E 60               ld   h, b
 514  8B2F 69               ld   l, c
 515  8B30 01 00 A4         ld   bc, -23552
 516  8B33 09               add  hl, bc
 517  8B34
 518  8B34                  ; PortalX = (Offset & 31) * 8
 519  8B34 7D               ld   a, l
 520  8B35 E6 1F            and  31
 521  8B37 87               add  a, a
 521  8B38 87             add a, a
 521  8B39 87             add a, a
 522  8B3A 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8B3B
 524  8B3B                  ; PortalY = (Offset / 32) * 8
 525  8B3B CB 3C            srl  h
 525  8B3D CB 1D          rr l
 526  8B3F CB 3C            srl  h
 526  8B41 CB 1D          rr l
 527  8B43 CB 3C            srl  h
 527  8B45 CB 1D          rr l
 528  8B47 CB 3C            srl  h
 528  8B49 CB 1D          rr l
 529  8B4B CB 3C            srl  h
 529  8B4D CB 1D          rr l
 530  8B4F 7D               ld   a, l
 531  8B50 87               add  a, a
 531  8B51 87             add a, a
 531  8B52 87             add a, a
 532  8B53 57               ld   d, a                      ; D = PortalY (0..120)
 533  8B54
 534  8B54                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8B54 ED 4B EA EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8B58
 537  8B58                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8B58 7B               ld   a, e
 539  8B59 91               sub  c
 540  8B5A 30 02            jr   nc, .x_diff_pos
 541  8B5C ED 44            neg
 542  8B5E              .x_diff_pos:
 543  8B5E FE 0C            cp   12
 544  8B60 30 0F            jr   nc, .no_transition
 545  8B62
 546  8B62                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8B62 7A               ld   a, d
 548  8B63 90               sub  b
 549  8B64 30 02            jr   nc, .y_diff_pos
 550  8B66 ED 44            neg
 551  8B68              .y_diff_pos:
 552  8B68 FE 0E            cp   14
 553  8B6A 30 05            jr   nc, .no_transition
 554  8B6C
 555  8B6C                  ; Transizione al portale attiva!
 556  8B6C E1               pop  hl
 557  8B6D D1               pop  de
 558  8B6E C1               pop  bc
 559  8B6F 37               scf
 560  8B70 C9               ret
 561  8B71
 562  8B71              .no_transition:
 563  8B71 E1               pop  hl
 564  8B72 D1               pop  de
 565  8B73 C1               pop  bc
 566  8B74 B7               or   a
 567  8B75 C9               ret
 568  8B76
 569  8B76              ; Alias per retrocompatibilità
 570  8B76              CheckVictoryCondition: EQU CheckPortalTransition
 571  8B76
 572  8B76              ; -------------------------------------------------------------------
 573  8B76              ; TriggerPortalTransition
 574  8B76              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8B76              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8B76              ; - Avanza all'indice della stanza successiva.
 577  8B76              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8B76              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8B76              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8B76              ; -------------------------------------------------------------------
 581  8B76              TriggerPortalTransition:
 582  8B76                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8B76 CD AD 8B         call Air_DepleteCountdown
 584  8B79
 585  8B79                  ; 1. Determina l'ID della stanza corrente
 586  8B79 CD 3D 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8B7C
 588  8B7C                  ; 2. Calcola l'indice della stanza successiva
 589  8B7C 3A 10 EE         ld   a, (current_room)
 590  8B7F 3C               inc  a
 591  8B80 FE 14            cp   NUM_ROOMS
 592  8B82 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8B84
 594  8B84                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8B84 21 A2 73         ld   hl, RoomsListTable
 596  8B87 5F               ld   e, a
 597  8B88 16 00            ld   d, 0
 598  8B8A 19               add  hl, de
 599  8B8B 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8B8C 5E               ld   e, (hl)
 601  8B8D 23               inc  hl
 602  8B8E 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8B8F ED 53 6B EE      ld   (room_ptr), de
 604  8B93
 605  8B93                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8B93 AF               xor  a
 607  8B94 32 71 EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8B97 32 F8 EA         ld   (velocity_y), a
 609  8B9A 32 03 F1         ld   (game_objective_completed), a
 610  8B9D 3E 01            ld   a, 1
 611  8B9F 32 F9 EA         ld   (on_ground), a
 612  8BA2
 613  8BA2                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8BA2 3E 07            ld   a, $07
 615  8BA4 CD 9D 62         call Gfx_ClearScreenDirect
 616  8BA7
 617  8BA7 C3 12 89         jp   LoadRoomAndRestart
 618  8BAA
 619  8BAA              .all_rooms_completed:
 620  8BAA                  ; Tutte le stanze sono state completate con successo!
 621  8BAA                  IF ENABLE_VICTORY_SCREEN != 0
 622  8BAA C3 9E 8A         jp   TriggerVictory
 623  8BAD                  ELSE
 624  8BAD ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8BAD ~                ld   de, (RoomsListTable)
 626  8BAD ~                ld   (room_ptr), de
 627  8BAD ~                xor  a
 628  8BAD ~                ld   (transition_active), a
 629  8BAD ~                ld   (velocity_y), a
 630  8BAD ~                ld   (game_objective_completed), a
 631  8BAD ~                ld   a, 1
 632  8BAD ~                ld   (on_ground), a
 633  8BAD ~                ld   a, $07
 634  8BAD ~                call Gfx_ClearScreenDirect
 635  8BAD ~                jp   LoadRoomAndRestart
 636  8BAD                  ENDIF
 637  8BAD
 638  8BAD              ; -------------------------------------------------------------------
 639  8BAD              ; Air_DepleteCountdown
 640  8BAD              ; Animazione originale di completamento livello (Manic Miner):
 641  8BAD              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8BAD              ; - Ad ogni pixel decrementato:
 643  8BAD              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8BAD              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8BAD              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8BAD              ; -------------------------------------------------------------------
 647  8BAD              Air_DepleteCountdown:
 648  8BAD F5               push af
 649  8BAE C5               push bc
 650  8BAF D5               push de
 651  8BB0 E5               push hl
 652  8BB1
 653  8BB1              .countdown_loop:
 654  8BB1 3A 0C F1         ld   a, (air_pixels)
 655  8BB4 B7               or   a
 656  8BB5 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8BB7
 658  8BB7 3D               dec  a
 659  8BB8 32 0C F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8BBB
 661  8BBB                  ; Aggiorna la barra grafica dell'aria
 662  8BBB CD 2D 6A         call Gfx_UpdateAirBar
 663  8BBE
 664  8BBE                  ; Aggiungi 1 punto allo score
 665  8BBE CD B1 87         call Score_Add1Point
 666  8BC1
 667  8BC1                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8BC1                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8BC1 3A 0C F1         ld   a, (air_pixels)
 670  8BC4 2F               cpl
 671  8BC5 E6 3F            and  63
 672  8BC7 07               rlca
 673  8BC8 3C               inc  a
 674  8BC9 57               ld   d, a                      ; D = ritardo semionda audio
 675  8BCA
 676  8BCA 0E 03            ld   c, 3                      ; Durata impulso
 677  8BCC              .audio_loop:
 678  8BCC AF               xor  a
 679  8BCD D3 FE            out  ($fe), a
 680  8BCF 42               ld   b, d
 681  8BD0 10 FE        .w1: djnz .w1
 682  8BD2
 683  8BD2 3E 18            ld   a, $18
 684  8BD4 D3 FE            out  ($fe), a
 685  8BD6 42               ld   b, d
 686  8BD7 10 FE        .w2: djnz .w2
 687  8BD9
 688  8BD9 0D               dec  c
 689  8BDA 20 F0            jr   nz, .audio_loop
 690  8BDC
 691  8BDC 18 D3            jr   .countdown_loop
 692  8BDE
 693  8BDE              .done_countdown:
 694  8BDE E1               pop  hl
 695  8BDF D1               pop  de
 696  8BE0 C1               pop  bc
 697  8BE1 F1               pop  af
 698  8BE2 C9               ret
 699  8BE3
 700  8BE3              ; -------------------------------------------------------------------
 701  8BE3              ; CheckAllItemsCollected
 702  8BE3              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8BE3              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8BE3              ; -------------------------------------------------------------------
 705  8BE3              CheckAllItemsCollected:
 706  8BE3 3A 03 F1         ld   a, (game_objective_completed)
 707  8BE6 B7               or   a
 708  8BE7 20 08            jr   nz, .all_collected
 709  8BE9 3A 6A EE         ld   a, (num_room_items)
 710  8BEC B7               or   a
 711  8BED 28 02            jr   z, .all_collected
 712  8BEF B7               or   a
 713  8BF0 C9               ret
 714  8BF1              .all_collected:
 715  8BF1 37               scf
 716  8BF2 C9               ret
 717  8BF3
 718  8BF3              ; -------------------------------------------------------------------
 719  8BF3              ; CheckInMasterBedroom (alias per retrocompatibilità)
 720  8BF3              ; -------------------------------------------------------------------
 721  8BF3              CheckInMasterBedroom:
 722  8BF3 37               scf
 723  8BF4 C9               ret
 724  8BF5
 725  8BF5              ; -------------------------------------------------------------------
 726  8BF5              ; CheckWillyConveyorCollision
 727  8BF5              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8BF5              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8BF5              ; -------------------------------------------------------------------
 730  8BF5              CheckWillyConveyorCollision:
 731  8BF5 C5               push bc
 732  8BF6 D5               push de
 733  8BF7 E5               push hl
 734  8BF8
 735  8BF8                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8BF8 CD 5F 78         call CheckWillyOnConveyor
 737  8BFB 38 49            jr   c, .collision_detected
 738  8BFD
 739  8BFD                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8BFD 3A 12 EE         ld   a, (conveyor_len)
 741  8C00 B7               or   a
 742  8C01 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8C03
 744  8C03                  ; B = WillyY, C = WillyX
 745  8C03 ED 4B EA EA      ld   bc, (PlayerPos)
 746  8C07
 747  8C07                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8C07 3A 13 EE         ld   a, (conveyor_row)
 749  8C0A 87               add  a, a                  ; *2
 750  8C0B 87               add  a, a                  ; *4
 751  8C0C 87               add  a, a                  ; *8
 752  8C0D 5F               ld   e, a                  ; E = ConveyorTop
 753  8C0E C6 07            add  a, 7
 754  8C10 57               ld   d, a                  ; D = ConveyorBottom
 755  8C11
 756  8C11                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8C11 78               ld   a, b                  ; WillyTop
 758  8C12 BA               cp   d
 759  8C13 28 04            jr   z, .y_overlap
 760  8C15 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8C17 18 32            jr   .no_conv_collision
 762  8C19
 763  8C19              .y_overlap:
 764  8C19 C6 0F            add  a, 15                 ; WillyBottom
 765  8C1B BB               cp   e
 766  8C1C 28 04            jr   z, .x_check
 767  8C1E 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8C20 18 29            jr   .no_conv_collision
 769  8C22
 770  8C22              .x_check:
 771  8C22                  ; ConveyorLeft = conveyor_col * 8
 772  8C22 3A 14 EE         ld   a, (conveyor_col)
 773  8C25 87               add  a, a                  ; *2
 774  8C26 87               add  a, a                  ; *4
 775  8C27 87               add  a, a                  ; *8
 776  8C28 5F               ld   e, a                  ; E = ConveyorLeft
 777  8C29
 778  8C29                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 779  8C29 21 12 EE         ld   hl, conveyor_len
 780  8C2C 3A 14 EE         ld   a, (conveyor_col)
 781  8C2F 86               add  a, (hl)
 782  8C30 87               add  a, a                  ; *2
 783  8C31 87               add  a, a                  ; *4
 784  8C32 87               add  a, a                  ; *8
 785  8C33 3D               dec  a                     ; ConveyorRight
 786  8C34 57               ld   d, a                  ; D = ConveyorRight
 787  8C35
 788  8C35                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 789  8C35 79               ld   a, c                  ; WillyLeft
 790  8C36 BA               cp   d
 791  8C37 28 04            jr   z, .x_overlap
 792  8C39 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8C3B 18 0E            jr   .no_conv_collision
 794  8C3D
 795  8C3D              .x_overlap:
 796  8C3D C6 0F            add  a, 15                 ; WillyRight
 797  8C3F BB               cp   e
 798  8C40 28 04            jr   z, .collision_detected
 799  8C42 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 800  8C44 18 05            jr   .no_conv_collision
 801  8C46
 802  8C46              .collision_detected:
 803  8C46 E1               pop  hl
 804  8C47 D1               pop  de
 805  8C48 C1               pop  bc
 806  8C49 37               scf
 807  8C4A C9               ret
 808  8C4B

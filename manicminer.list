2486+ 6ABC                  ; Determina il frame del corpo per le icone delle vite
2487+ 6ABC                  IF ENABLE_ANIMATE_LIVES != 0
2488+ 6ABC ~                ; Calcola il frame animato dal contatore
2489+ 6ABC ~                ld   a, (counter)
2490+ 6ABC ~                rrca
2491+ 6ABC ~                rrca
2492+ 6ABC ~                rrca

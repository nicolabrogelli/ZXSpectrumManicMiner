 161+ 7CBF              ; -------------------------------------------------------------------
 162+ 7CBF              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7CBF              ; -------------------------------------------------------------------
 164+ 7CBF              CheckEnemyWillyOverlap:
 165+ 7CBF 3A DD 98         ld   a, (player_drawn_pos+1)
 166+ 7CC2 FE FF            cp   $FF
 167+ 7CC4 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7CC5
 169+ 7CC5                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7CC5 3A DC 98         ld   a, (player_drawn_pos)
 171+ 7CC8 E6 F8            and  $F8
 172+ 7CCA 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7CCB 79               ld   a, c
 174+ 7CCC E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7CCE 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7CCF C6 10            add  a, 16
 177+ 7CD1 FE 19            cp   25
 178+ 7CD3 D0               ret  nc                 ; Fuori portata X
 179+ 7CD4
 180+ 7CD4                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7CD4 3A DD 98         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7CD7 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7CD8 C6 0F            add  a, 15
 184+ 7CDA FE 1F            cp   31
 185+ 7CDC D0               ret  nc                 ; Fuori portata Y
 186+ 7CDD
 187+ 7CDD                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7CDD 3E 01            ld   a, 1
 189+ 7CDF 32 E2 98         ld   (willy_needs_redraw), a
 190+ 7CE2 C9               ret

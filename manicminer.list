   2+ 5DAD              ; settings.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Impostazioni e flag di configurazione a tempo di compilazione per .
   5+ 5DAD              ; Ogni flag può essere abilitato (1) o disabilitato (0).
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DENABLE_MUSIC=0 -DENABLE_ROOM_SKIP_KEYS=0).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Effetti di sottofondo ---
  11+ 5DAD              ; 1 = Effetti abilitati
  12+ 5DAD              ; 0 = Effetti disabilitati
  13+ 5DAD                  IFNDEF ENABLE_EFFECTS
  14+ 5DAD              ENABLE_EFFECTS EQU 1
  15+ 5DAD                  ENDIF
  16+ 5DAD
  17+ 5DAD              ; --- Musica di sottofondo ---
  18+ 5DAD              ; 1 = Musica abilitata
  19+ 5DAD              ; 0 = Musica disabilitata
  20+ 5DAD                  IFNDEF ENABLE_MUSIC
  21+ 5DAD              ENABLE_MUSIC EQU 1
  22+ 5DAD                  ENDIF
  23+ 5DAD
  24+ 5DAD              ; --- Divisore Frame per la Musica In-Game ---
  25+ 5DAD              ; Intervallo di frame per la riproduzione dei burst musicali (a 25 FPS):
  26+ 5DAD              ; 2 = Tempo fedele all'originale (~10.2s per 64 note, 1 burst ogni 80ms, 12.5 note/s)
  27+ 5DAD              ; 1 = Tempo rapido arcade (~5.1s per 64 note, 1 burst ogni frame a 40ms, 25 note/s)
  28+ 5DAD                  IFNDEF MUSIC_FRAME_DIVIDER
  29+ 5DAD              MUSIC_FRAME_DIVIDER EQU 2
  30+ 5DAD                  ENDIF
  31+ 5DAD
  32+ 5DAD              ; --- Muto musica durante il salto ---
  33+ 5DAD              ; 1 = Il salto silenzia la musica durante i 18 frame dell'animazione
  34+ 5DAD              ; 0 = La musica continua regolarmente anche durante il salto (comportamento originale Manic Miner)
  35+ 5DAD                  IFNDEF MUTE_MUSIC_ON_JUMP
  36+ 5DAD              MUTE_MUSIC_ON_JUMP EQU 0
  37+ 5DAD                  ENDIF
  38+ 5DAD
  39+ 5DAD              ; --- Morte per collisione con i guardiani (nemici) ---
  40+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite alla collisione con i guardiani
  41+ 5DAD              ; 0 = Disabilita la morte
  42+ 5DAD                  IFNDEF ENABLE_GUARDIAN_COLLISION_DEATH
  43+ 5DAD              ENABLE_GUARDIAN_COLLISION_DEATH EQU 1
  44+ 5DAD                  ENDIF
  45+ 5DAD
  46+ 5DAD              ; --- Bande colorate di debug per collisione con i guardiani ---
  47+ 5DAD              ; 1 = Abilita le bande colorate (raster bar) sul bordo alla collisione con i guardiani (quando la morte è disabilitata)
  48+ 5DAD              ; 0 = Disabilita le bande colorate di debug per i guardiani
  49+ 5DAD                  IFNDEF ENABLE_GUARDIAN_DEBUG_BARS
  50+ 5DAD              ENABLE_GUARDIAN_DEBUG_BARS EQU 1
  51+ 5DAD                  ENDIF
  52+ 5DAD
  53+ 5DAD              ; --- Morte per collisione con gli elementi Nasty (tiles pericolose) ---
  54+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite al tocco delle Nasty tiles
  55+ 5DAD              ; 0 = Disabilita il controllo di morte sulle Nasty tiles
  56+ 5DAD                  IFNDEF ENABLE_NASTY_COLLISION_DEATH
  57+ 5DAD              ENABLE_NASTY_COLLISION_DEATH EQU 1
  58+ 5DAD                  ENDIF
  59+ 5DAD
  60+ 5DAD              ; --- Morte per caduta dall'alto (Fall Death) ---
  61+ 5DAD              ; 1 = Abilita la morte quando Willy cade da una piattaforma o scende da un'altezza eccessiva (> 40 pixel / 5 blocchi)
  62+ 5DAD              ; 0 = Disabilita la morte per caduta
  63+ 5DAD                  IFNDEF ENABLE_FALL_DEATH
  64+ 5DAD              ENABLE_FALL_DEATH EQU 1
  65+ 5DAD                  ENDIF
  66+ 5DAD
  67+ 5DAD              ; --- Altezza massima di caduta sicura (in pixel) ---
  68+ 5DAD              ; Nel gioco originale, la caduta massima sicura è di 5 blocchi (40 pixel, pari a counter < 12)
  69+ 5DAD                  IFNDEF MAX_SAFE_FALL_HEIGHT
  70+ 5DAD              MAX_SAFE_FALL_HEIGHT EQU 40
  71+ 5DAD                  ENDIF
  72+ 5DAD
  73+ 5DAD              ; --- Animazione delle icone delle vite ---
  74+ 5DAD              ; 1 = Abilita l'animazione camminante per le icone delle vite in basso a schermo
  75+ 5DAD              ; 0 = Icone delle vite statiche
  76+ 5DAD                  IFNDEF ENABLE_ANIMATE_LIVES
  77+ 5DAD              ENABLE_ANIMATE_LIVES EQU 0
  78+ 5DAD                  ENDIF
  79+ 5DAD
  80+ 5DAD              ; --- Tasti di navigazione rapida tra le stanze (Q / A) ---
  81+ 5DAD              ; 1 = Abilita i tasti Q (stanza successiva) e A (stanza precedente) per scorrere tra le stanze
  82+ 5DAD              ; 0 = Disabilita i tasti Q e A
  83+ 5DAD                  IFNDEF ENABLE_ROOM_SKIP_KEYS
  84+ 5DAD              ENABLE_ROOM_SKIP_KEYS EQU 1
  85+ 5DAD                  ENDIF
  86+ 5DAD
  87+ 5DAD              ; --- Bande colorate di debug per Willy su rampa ---
  88+ 5DAD              ; 1 = Abilita le bande colorate (raster bar) sul bordo quando Willy si trova posizionato su una rampa
  89+ 5DAD              ; 0 = Disabilita le bande colorate di debug per le rampe
  90+ 5DAD                  IFNDEF ENABLE_RAMP_DEBUG_BARS
  91+ 5DAD              ENABLE_RAMP_DEBUG_BARS EQU 0
  92+ 5DAD                  ENDIF
  93+ 5DAD
  94+ 5DAD
  95+ 5DAD              ; --- Riavvio del gioco al Game Over quando Willy esaurisce tutte le vite ---
  96+ 5DAD              ; 1 = Abilita la schermata di Game Over e il riavvio completo dal primo livello quando le vite finiscono
  97+ 5DAD              ; 0 = Disabilita il riavvio (Willy respawna normalmente mantenendo 1 vita senza azzerare la partita)
  98+ 5DAD                  IFNDEF ENABLE_GAME_OVER_RESTART
  99+ 5DAD              ENABLE_GAME_OVER_RESTART EQU 1
 100+ 5DAD                  ENDIF

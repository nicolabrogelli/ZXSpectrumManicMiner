2256+ 69AD              ; Gfx_FormatBCD6
2257+ 69AD              ; Converte 3 byte BCD (puntati da IX) in 6 caratteri ASCII (scritti in HL).
2258+ 69AD              ; IX+2 = cifre alte (centinaia di migliaia, decine di migliaia)
2259+ 69AD              ; IX+1 = cifre medie (migliaia, centinaia)
2260+ 69AD              ; IX+0 = cifre basse (decine, unità)

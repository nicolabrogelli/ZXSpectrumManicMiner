  84+ A011              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  85+ A011 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  86+ A014 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  87+ A017 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  88+ A018 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  89+ A019 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  90+ A01A 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  91+ A01B
  92+ A01B 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)

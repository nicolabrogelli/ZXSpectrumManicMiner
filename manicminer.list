 631+ 855D              ; Score_AddItemPoints
 632+ 855D              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 633+ 855D              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 634+ 855D              ; -------------------------------------------------------------------
 635+ 855D              Score_AddItemPoints:
 636+ 855D F5               push af
 637+ 855E C5               push bc
 638+ 855F D5               push de
 639+ 8560 E5               push hl
 640+ 8561
 641+ 8561                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 642+ 8561 3A CD E6         ld   a, (player_score + 1)
 643+ 8564 C6 01            add  a, $01
 644+ 8566 27               daa
 645+ 8567 32 CD E6         ld   (player_score + 1), a
 646+ 856A
 647+ 856A                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 648+ 856A 3A CE E6         ld   a, (player_score + 2)
 649+ 856D CE 00            adc  a, 0
 650+ 856F 27               daa
 651+ 8570 32 CE E6         ld   (player_score + 2), a
 652+ 8573
 653+ 8573                  ; Controlla se player_score ha superato high_score
 654+ 8573 CD 7E 85         call Score_CheckAndUpdateHighScore
 655+ 8576
 656+ 8576                  ; Aggiorna visualizzazione a schermo
 657+ 8576 CD AE 68         call Gfx_UpdateScoreDisplay

 192+ 7E6A              ; -------------------------------------------------------------------
 193+ 7E6A              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7E6A              ; -------------------------------------------------------------------
 195+ 7E6A              Enemy_EraseRoom:
 196+ 7E6A              Enemy_DrawRoom:
 197+ 7E6A              Enemy_RenderRoom:
 198+ 7E6A E5               push hl
 199+ 7E6B D5               push de
 200+ 7E6C C5               push bc
 201+ 7E6D DD E5            push ix
 202+ 7E6F
 203+ 7E6F                  ; ---------------------------------------------------------------
 204+ 7E6F                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7E6F                  ; ---------------------------------------------------------------
 206+ 7E6F DD 21 2C 7D      ld   ix, ActiveEnemies
 207+ 7E73 06 08            ld   b, 8              ; 8 slot
 208+ 7E75              .erase_loop:
 209+ 7E75 DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E78 E6 80            and  $80               ; Active?
 211+ 7E7A 28 3A            jr   z, .next_erase
 212+ 7E7C
 213+ 7E7C                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E7C DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E7F FE FF            cp   $FF
 216+ 7E81 28 33            jr   z, .next_erase
 217+ 7E83
 218+ 7E83                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E83 DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E86 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E89 20 0E            jr   nz, .do_erase_slot
 222+ 7E8B DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E8E DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E91 20 06            jr   nz, .do_erase_slot
 225+ 7E93
 226+ 7E93 3A 70 9A         ld   a, (enemy_was_updated)
 227+ 7E96 B7               or   a
 228+ 7E97 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E99
 230+ 7E99              .do_erase_slot:
 231+ 7E99 C5               push bc                ; Salva contatore ciclo
 232+ 7E9A
 233+ 7E9A                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E9A DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E9D DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7EA0 CD 46 7E         call CheckEnemyWillyOverlap
 237+ 7EA3
 238+ 7EA3                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7EA3 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7EA6 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7EA9 CD E2 5F         call Gfx_ErasePixelSprite16x16
 242+ 7EAC DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7EAF DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7EB2 CD 25 6E         call Gfx_RestoreEnemyColorAttributes
 245+ 7EB5
 246+ 7EB5 C1               pop  bc
 247+ 7EB6
 248+ 7EB6              .next_erase:
 249+ 7EB6 11 0B 00         ld   de, 11
 250+ 7EB9 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7EBB 05               dec  b
 252+ 7EBC 20 B7            jr   nz, .erase_loop

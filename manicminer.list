 528+ 8015              .kong_frame:
 529+ 8015                  ; Kong Beast: usa Frame 0..3 (salvato in (ix+1)) da OFFSET_GUARDIAN_GRAPHICS
 530+ 8015 DD 7E 01         ld   a, (ix+1)
 531+ 8018 E6 03            and  3
 532+ 801A 18 17            jr   .got_frame_idx

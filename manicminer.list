 216+ 7DC6              ; -------------------------------------------------------------------
 217+ 7DC6              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 218+ 7DC6              ; -------------------------------------------------------------------
 219+ 7DC6              CheckEnemyWillyOverlap:
 220+ 7DC6 3A 10 E3         ld   a, (player_drawn_pos+1)
 221+ 7DC9 FE FF            cp   $FF
 222+ 7DCB C8               ret  z                  ; Se Willy non è disegnato, esci
 223+ 7DCC
 224+ 7DCC                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 225+ 7DCC 3A 0F E3         ld   a, (player_drawn_pos)
 226+ 7DCF E6 F8            and  $F8

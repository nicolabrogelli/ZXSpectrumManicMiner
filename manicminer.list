 199+ 8424 3A DB BA         ld   a, (room_border_color)
 200+ 8427 E6 EF            and  $ef              ; speaker OFF
 201+ 8429 D3 FE            out  ($fe), a
 202+ 842B
 203+ 842B 0E 3C            ld   c, 60

 270+ 6FF7              .speed_left_ok:
 271+ 6FF7 5F               ld   e, a
 272+ 6FF8
 273+ 6FF8 79               ld   a, c
 274+ 6FF9 93               sub  e
 275+ 6FFA
 276+ 6FFA                  ; Controllo limite sinistro schermo
 277+ 6FFA FE 05            cp   PLAYER_MIN_X
 278+ 6FFC 38 0D            jr   c, .clamp_left

  68+ 7CE2 B7               or   a
  69+ 7CE3 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7CE5
  71+ 7CE5                  ; Slot attivo
  72+ 7CE5 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CE9 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7CEC
  75+ 7CEC 23               inc  hl

 119+ 844D ~            .play_current_note:
 120+ 844D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 844D ~                ld   a, (Audio_music_note_idx)
 122+ 844D ~                ld   e, a
 123+ 844D ~                ld   d, 0
 124+ 844D ~                ld   hl, Audio_MusicSheet
 125+ 844D ~                add  hl, de
 126+ 844D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 844D ~                ld   a, (hl)                  ; A = delay
 128+ 844D ~                or   a
 129+ 844D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 844D ~
 131+ 844D ~                ; Suona la nota: 2 cicli
 132+ 844D ~                ld   d, a                     ; D = delay
 133+ 844D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 844D ~            .note_loop:
 135+ 844D ~                ; Speaker ON
 136+ 844D ~                ld   a, (room_border_color)
 137+ 844D ~                or   $10
 138+ 844D ~                out  ($fe), a
 139+ 844D ~                ld   c, d
 140+ 844D ~            .d1:
 141+ 844D ~                push af
 142+ 844D ~                pop  af
 143+ 844D ~                dec  c
 144+ 844D ~                jr   nz, .d1
 145+ 844D ~
 146+ 844D ~                ; Speaker OFF
 147+ 844D ~                ld   a, (room_border_color)
 148+ 844D ~                and  $ef
 149+ 844D ~                out  ($fe), a
 150+ 844D ~                ld   c, d
 151+ 844D ~            .d2:
 152+ 844D ~                push af
 153+ 844D ~                pop  af
 154+ 844D ~                dec  c
 155+ 844D ~                jr   nz, .d2
 156+ 844D ~
 157+ 844D ~                djnz .note_loop
 158+ 844D ~
 159+ 844D ~            .done:
 160+ 844D ~                pop  hl
 161+ 844D ~                pop  de
 162+ 844D ~                pop  bc
 163+ 844D ~                pop  af
 164+ 844D ~                ret
 165+ 844D ~
 166+ 844D ~            Audio_MusicSheet:
 167+ 844D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 844D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 844D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 844D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25

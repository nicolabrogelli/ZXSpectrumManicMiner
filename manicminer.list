1688+ 7AE9 5F               ld   e, a              ; E = r
1689+ 7AEA 79               ld   a, c
1690+ 7AEB CB 3F            srl  a
1691+ 7AED CB 3F            srl  a
1692+ 7AEF CB 3F            srl  a                 ; A = c (0..31)
1693+ 7AF1 4F               ld   c, a              ; C = c
1694+ 7AF2 7B               ld   a, e              ; A = r
1695+ 7AF3
1696+ 7AF3 CD 84 78         call GetCellFromUnpacked ; A = cell type

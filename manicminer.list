 963+ 7863 96               sub  (hl)              ; A = ramp_col - ramp_len
 964+ 7864              .compare_plat:
 965+ 7864 BB               cp   e                 ; Compare with Col
 966+ 7865 20 0B            jr   nz, .no
 967+ 7867
 968+ 7867 3A E1 EC         ld   a, (ramp_row)
 969+ 786A 21 E0 EC         ld   hl, ramp_len
 970+ 786D 96               sub  (hl)
 971+ 786E 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 972+ 786F BA               cp   d                 ; Compare with Row
 973+ 7870 28 04            jr   z, .yes
 974+ 7872
 975+ 7872              .no:
 976+ 7872 E1               pop  hl
 977+ 7873 C1               pop  bc
 978+ 7874 B7               or   a
 979+ 7875 C9               ret

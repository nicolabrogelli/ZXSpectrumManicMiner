 271+ 6CF8              ; LoadPositionPlayeinRoom
 272+ 6CF8              ;
 273+ 6CF8              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6CF8              ; in una nuova stanza.
 275+ 6CF8              ;
 276+ 6CF8              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6CF8              ; (layout/metadata) a partire da room_ptr.
 278+ 6CF8              ;
 279+ 6CF8              ; Output:
 280+ 6CF8              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6CF8              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6CF8              ;
 283+ 6CF8              ; Struttura dati stanza:
 284+ 6CF8              ;   OFFSET_POS_WILLY:
 285+ 6CF8              ;       +0 = X
 286+ 6CF8              ;       +1 = Y
 287+ 6CF8              ; -------------------------------------------------------------------
 288+ 6CF8              LoadPositionPlayeinRoom:
 289+ 6CF8                  ; ---------------------------------------------------------------
 290+ 6CF8                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6CF8                  ; ---------------------------------------------------------------
 292+ 6CF8 2A 6C 91         ld   hl, (room_ptr)
 293+ 6CFB 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6CFE 19               add  hl, de
 295+ 6CFF
 296+ 6CFF                  ; Byte 0: Y * 2
 297+ 6CFF 7E               ld   a, (hl)
 298+ 6D00 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6D02 57               ld   d, a                      ; D = PlayerY
 300+ 6D03
 301+ 6D03                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6D03 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6D04 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6D05 7E               ld   a, (hl)
 305+ 6D06 E6 01            and  1
 306+ 6D08 28 04            jr   z, .facing_right
 307+ 6D0A 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6D0C 18 02            jr   .set_dir
 309+ 6D0E              .facing_right:
 310+ 6D0E 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6D10              .set_dir:
 312+ 6D10 32 F3 8D         ld   (direction), a
 313+ 6D13
 314+ 6D13                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6D13 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6D14 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6D15 4E               ld   c, (hl)
 318+ 6D16 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6D17 7E               ld   a, (hl)
 320+ 6D18
 321+ 6D18                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6D18 67               ld   h, a
 323+ 6D19 69               ld   l, c
 324+ 6D1A 01 00 A4         ld   bc, -23552
 325+ 6D1D 09               add  hl, bc
 326+ 6D1E
 327+ 6D1E 7D               ld   a, l
 328+ 6D1F E6 1F            and  31
 329+ 6D21 87               add  a, a                      ; *2
 330+ 6D22 87               add  a, a                      ; *4
 331+ 6D23 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6D24 4F               ld   c, a                      ; C = PlayerX
 333+ 6D25 42               ld   b, d                      ; B = PlayerY
 334+ 6D26
 335+ 6D26                  ; Salva coordinate (C = X, B = Y)
 336+ 6D26 ED 43 EC 8D      ld   (PlayerPos), bc
 337+ 6D2A ED 43 EE 8D      ld   (PlayerPosOld), bc
 338+ 6D2E C9               ret

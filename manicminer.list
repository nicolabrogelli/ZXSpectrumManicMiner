1623+ 664B 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1624+ 664E 3E 42            ld   a, RED | $40          ; Rosso Brillante
1625+ 6650 CD 1F 6D         call Gfx_SetEnemyColorAttributes

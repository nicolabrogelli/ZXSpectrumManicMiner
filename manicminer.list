 290  8B07              ; -------------------------------------------------------------------
 291  8B07              ; ShowTitleScreen
 292  8B07              ; Visualizza la schermata iniziale del gioco (Title Screen).
 293  8B07              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 294  8B07              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 295  8B07              ; -------------------------------------------------------------------
 296  8B07              ShowTitleScreen:
 297  8B07                  ; 1. Disegna la schermata iniziale
 298  8B07 CD 91 64         call Gfx_DrawTitleScreen
 299  8B0A
 300  8B0A                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 301  8B0A              .wait_title_enter_release:
 302  8B0A 76               halt
 303  8B0B 3E BF            ld   a, $bf
 304  8B0D DB FE            in   a, ($fe)
 305  8B0F 1F               rra
 306  8B10 30 F8            jr   nc, .wait_title_enter_release
 307  8B12
 308  8B12                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 309  8B12 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 310  8B14              .title_loop:
 311  8B14 76               halt
 312  8B15
 313  8B15                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 314  8B15 0C               inc  c
 315  8B16 79               ld   a, c
 316  8B17 CB 3F            srl  a
 317  8B19 CB 3F            srl  a
 318  8B1B CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 319  8B1D E6 07            and  7
 320  8B1F 5F               ld   e, a
 321  8B20 16 00            ld   d, 0
 322  8B22 21 89 64         ld   hl, title_color_table
 323  8B25 19               add  hl, de
 324  8B26 7E               ld   a, (hl)               ; A = nuovo colore
 325  8B27 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 326  8B2A 06 20            ld   b, 32
 327  8B2C              .color_title_loop:
 328  8B2C 77               ld   (hl), a
 329  8B2D 23               inc  hl
 330  8B2E 10 FC            djnz .color_title_loop
 331  8B30
 332  8B30                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 333  8B30 3E BF            ld   a, $bf
 334  8B32 DB FE            in   a, ($fe)
 335  8B34 1F               rra
 336  8B35 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 337  8B37
 338  8B37                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 339  8B37              .wait_title_enter_release_after:
 340  8B37 76               halt
 341  8B38 3E BF            ld   a, $bf
 342  8B3A DB FE            in   a, ($fe)
 343  8B3C 1F               rra
 344  8B3D 30 F8            jr   nc, .wait_title_enter_release_after
 345  8B3F
 346  8B3F                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 347  8B3F AF               xor  a
 348  8B40 D3 FE            out  ($fe), a              ; Bordo a nero
 349  8B42 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 350  8B45

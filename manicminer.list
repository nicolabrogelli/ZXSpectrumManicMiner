  65+ 7CA6 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CA7 FE FF            cp   $FF
  67+ 7CA9 28 7F            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CAB B7               or   a
  69+ 7CAC 28 74            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7CAE
  71+ 7CAE                  ; Slot attivo
  72+ 7CAE DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CB2 CB 7F            bit  7, a
  74+ 7CB4 28 04            jr   z, .h_speed_normal
  75+ 7CB6 DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)

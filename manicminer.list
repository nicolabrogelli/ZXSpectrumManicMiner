 121+ 89A6 ~                ld   a, (Audio_music_note_idx)
 122+ 89A6 ~                ld   e, a
 123+ 89A6 ~                ld   d, 0
 124+ 89A6 ~                ld   hl, Audio_MusicSheet
 125+ 89A6 ~                add  hl, de
 126+ 89A6 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 89A6 ~                ld   a, (hl)                  ; A = delay
 128+ 89A6 ~                or   a
 129+ 89A6 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 89A6 ~
 131+ 89A6 ~                ; Suona la nota: 2 cicli
 132+ 89A6 ~                ld   d, a                     ; D = delay
 133+ 89A6 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 89A6 ~            .note_loop:
 135+ 89A6 ~                ; Speaker ON
 136+ 89A6 ~                ld   a, (room_border_color)
 137+ 89A6 ~                or   $10
 138+ 89A6 ~                out  ($fe), a

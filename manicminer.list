1259+ 79D1 28 1C            jr   z, .is_floor
1260+ 79D3 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1261+ 79D6 28 1B            jr   z, .is_crumbling
1262+ 79D8 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1263+ 79DB 28 1E            jr   z, .is_conveyor
1264+ 79DD DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1265+ 79E0 28 1D            jr   z, .is_nasty1
1266+ 79E2 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?

 144+ 89BD ~                jr   nz, .d1
 145+ 89BD ~
 146+ 89BD ~                ; Speaker OFF
 147+ 89BD ~                ld   a, (room_border_color)
 148+ 89BD ~                and  $ef
 149+ 89BD ~                out  ($fe), a
 150+ 89BD ~                ld   c, d
 151+ 89BD ~            .d2:
 152+ 89BD ~                push af
 153+ 89BD ~                pop  af
 154+ 89BD ~                dec  c
 155+ 89BD ~                jr   nz, .d2
 156+ 89BD ~
 157+ 89BD ~                djnz .note_loop
 158+ 89BD ~
 159+ 89BD ~            .done:
 160+ 89BD ~                pop  hl
 161+ 89BD ~                pop  de
 162+ 89BD ~                pop  bc
 163+ 89BD ~                pop  af
 164+ 89BD ~                ret
 165+ 89BD ~
 166+ 89BD ~            Audio_MusicSheet:
 167+ 89BD ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 89BD ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 89BD ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 89BD ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25

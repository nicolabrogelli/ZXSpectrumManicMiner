1044+ 78AB              ; -------------------------------------------------------------------
1045+ 78AB              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
1046+ 78AB              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
1047+ 78AB              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1048+ 78AB              ; -------------------------------------------------------------------
1049+ 78AB              CheckWillyWallCollision:
1050+ 78AB C5               push bc
1051+ 78AC
1052+ 78AC                  ; 1. Punto superiore: (X, Y)
1053+ 78AC CD 7A 78         call CheckWallCell
1054+ 78AF 38 17            jr   c, .collision
1055+ 78B1
1056+ 78B1                  ; 2. Punto medio: (X, Y + 7)
1057+ 78B1 78               ld   a, b
1058+ 78B2 C6 07            add  a, 7
1059+ 78B4 47               ld   b, a
1060+ 78B5 CD 7A 78         call CheckWallCell
1061+ 78B8 38 0E            jr   c, .collision
1062+ 78BA
1063+ 78BA                  ; 3. Punto inferiore: (X, Y + 15)
1064+ 78BA C1               pop  bc
1065+ 78BB C5               push bc
1066+ 78BC 78               ld   a, b
1067+ 78BD C6 0F            add  a, 15
1068+ 78BF 47               ld   b, a
1069+ 78C0 CD 7A 78         call CheckWallCell
1070+ 78C3 38 03            jr   c, .collision
1071+ 78C5
1072+ 78C5 C1               pop  bc
1073+ 78C6 B7               or   a                 ; Reset carry (nessuna collisione)
1074+ 78C7 C9               ret
1075+ 78C8
1076+ 78C8              .collision:
1077+ 78C8 C1               pop  bc
1078+ 78C9 37               scf                    ; Set carry (collisione avvenuta)
1079+ 78CA C9               ret
1080+ 78CB
1081+ 78CB              ; -------------------------------------------------------------------
1082+ 78CB              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1083+ 78CB              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1084+ 78CB              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1085+ 78CB              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1086+ 78CB              ; -------------------------------------------------------------------
1087+ 78CB              UnpackRoomLayout:
1088+ 78CB E5               push hl
1089+ 78CC D5               push de
1090+ 78CD C5               push bc
1091+ 78CE DD E5            push ix
1092+ 78D0
1093+ 78D0 DD 2A 34 ED      ld   ix, (room_ptr)
1094+ 78D4 11 20 02         ld   de, OFFSET_TILES
1095+ 78D7 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1096+ 78D9
1097+ 78D9 2A 34 ED         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1098+ 78DC 11 D9 EA         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1099+ 78DF 01 00 02         ld   bc, 512               ; 512 celle
1100+ 78E2
1101+ 78E2              .byte_loop:
1102+ 78E2 7E               ld   a, (hl)               ; Leggi byte attributo dal layout

  72+ 88D5 ~            ; Audio_UpdateMusic
  73+ 88D5 ~            ;
  74+ 88D5 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 88D5 ~            ; Viene chiamata a ogni frame.
  76+ 88D5 ~            ; -------------------------------------------------------------------
  77+ 88D5 ~            Audio_UpdateMusic:
  78+ 88D5 ~                push af
  79+ 88D5 ~                push bc
  80+ 88D5 ~                push de
  81+ 88D5 ~                push hl
  82+ 88D5 ~
  83+ 88D5 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 88D5 ~                ld   a, (Audio_jump_sound_note)
  85+ 88D5 ~                cp   18
  86+ 88D5 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 88D5 ~
  88+ 88D5 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 88D5 ~                ld   a, (Audio_music_frame_counter)
  90+ 88D5 ~                dec  a
  91+ 88D5 ~                ld   (Audio_music_frame_counter), a
  92+ 88D5 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 88D5 ~
  94+ 88D5 ~                ; Altrimenti carica la nota successiva
  95+ 88D5 ~                ld   a, (Audio_music_note_idx)
  96+ 88D5 ~                inc  a
  97+ 88D5 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 88D5 ~                jr   c, .no_wrap
  99+ 88D5 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 88D5 ~            .no_wrap:
 101+ 88D5 ~                ld   (Audio_music_note_idx), a
 102+ 88D5 ~
 103+ 88D5 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 88D5 ~                ld   e, a
 105+ 88D5 ~                ld   d, 0
 106+ 88D5 ~                ld   hl, Audio_MusicSheet
 107+ 88D5 ~                add  hl, de
 108+ 88D5 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 88D5 ~
 110+ 88D5 ~                ; Leggi durata (secondo byte)
 111+ 88D5 ~                inc  hl
 112+ 88D5 ~                ld   a, (hl)
 113+ 88D5 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 88D5 ~                jr   nz, .dur_ok
 115+ 88D5 ~                ld   a, 1
 116+ 88D5 ~            .dur_ok:
 117+ 88D5 ~                ld   (Audio_music_frame_counter), a
 118+ 88D5 ~
 119+ 88D5 ~            .play_current_note:
 120+ 88D5 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 88D5 ~                ld   a, (Audio_music_note_idx)
 122+ 88D5 ~                ld   e, a
 123+ 88D5 ~                ld   d, 0
 124+ 88D5 ~                ld   hl, Audio_MusicSheet
 125+ 88D5 ~                add  hl, de
 126+ 88D5 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 88D5 ~                ld   a, (hl)                  ; A = delay
 128+ 88D5 ~                or   a
 129+ 88D5 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 88D5 ~
 131+ 88D5 ~                ; Suona la nota: 2 cicli
 132+ 88D5 ~                ld   d, a                     ; D = delay
 133+ 88D5 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 88D5 ~            .note_loop:
 135+ 88D5 ~                ; Speaker ON
 136+ 88D5 ~                ld   a, (room_border_color)
 137+ 88D5 ~                or   $10
 138+ 88D5 ~                out  ($fe), a
 139+ 88D5 ~                ld   c, d
 140+ 88D5 ~            .d1:
 141+ 88D5 ~                push af
 142+ 88D5 ~                pop  af
 143+ 88D5 ~                dec  c
 144+ 88D5 ~                jr   nz, .d1
 145+ 88D5 ~
 146+ 88D5 ~                ; Speaker OFF
 147+ 88D5 ~                ld   a, (room_border_color)
 148+ 88D5 ~                and  $ef
 149+ 88D5 ~                out  ($fe), a
 150+ 88D5 ~                ld   c, d
 151+ 88D5 ~            .d2:
 152+ 88D5 ~                push af
 153+ 88D5 ~                pop  af
 154+ 88D5 ~                dec  c
 155+ 88D5 ~                jr   nz, .d2
 156+ 88D5 ~
 157+ 88D5 ~                djnz .note_loop
 158+ 88D5 ~
 159+ 88D5 ~            .done:
 160+ 88D5 ~                pop  hl
 161+ 88D5 ~                pop  de
 162+ 88D5 ~                pop  bc
 163+ 88D5 ~                pop  af
 164+ 88D5 ~                ret
 165+ 88D5 ~
 166+ 88D5 ~            Audio_MusicSheet:
 167+ 88D5 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 88D5 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 88D5 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 88D5 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 88D5 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 88D5 ~                db 90, 10, 107, 20, 68, 65
 173+ 88D5                  ELSE
 174+ 88D5              Audio_UpdateMusic:
 175+ 88D5 C9               ret
 176+ 88D6                  ENDIF

 502+ 7CEF              ; -------------------------------------------------------------------
 503+ 7CEF              ; CheckCollision
 504+ 7CEF              ;
 505+ 7CEF              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 506+ 7CEF              ; Output:
 507+ 7CEF              ;   Carry Set = Collisione con guardiano
 508+ 7CEF              ;   Carry Clear = Nessuna collisione
 509+ 7CEF              ; -------------------------------------------------------------------
 510+ 7CEF              CheckCollision:
 511+ 7CEF DD E5            push ix
 512+ 7CF1 C5               push bc
 513+ 7CF2 D5               push de
 514+ 7CF3 E5               push hl
 515+ 7CF4
 516+ 7CF4                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 517+ 7CF4 3A 9E 92         ld   a, (willy_safety_timer)
 518+ 7CF7 B7               or   a
 519+ 7CF8 20 3B            jr   nz, .no_collision_found
 520+ 7CFA
 521+ 7CFA DD 21 FC 79      ld   ix, ActiveEnemies
 522+ 7CFE 06 08            ld   b, 8                      ; 8 slot
 523+ 7D00
 524+ 7D00              .collision_loop:
 525+ 7D00 DD 7E 00         ld   a, (ix+0)
 526+ 7D03 E6 80            and  $80                       ; Active?
 527+ 7D05 28 26            jr   z, .next_enemy
 528+ 7D07
 529+ 7D07 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 530+ 7D08
 531+ 7D08                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 532+ 7D08 ED 4B 94 8E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 533+ 7D0C DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 534+ 7D0F
 535+ 7D0F                  ; Calcola differenza X
 536+ 7D0F 91               sub  c                         ; A = EnemyX - WillyX
 537+ 7D10 30 02            jr   nc, .x_diff_pos
 538+ 7D12 ED 44            neg                            ; A = |EnemyX - WillyX|
 539+ 7D14              .x_diff_pos:
 540+ 7D14 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 541+ 7D16 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 542+ 7D18
 543+ 7D18                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 544+ 7D18 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 545+ 7D1B 90               sub  b                         ; A = EnemyY - WillyY
 546+ 7D1C 30 02            jr   nc, .y_diff_pos
 547+ 7D1E ED 44            neg                            ; A = |EnemyY - WillyY|
 548+ 7D20              .y_diff_pos:
 549+ 7D20 FE 0E            cp   14                        ; Sovrapposizione verticale?
 550+ 7D22 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 551+ 7D24
 552+ 7D24                  ; Collisione trovata!
 553+ 7D24 C1               pop  bc                        ; Ripristina stack
 554+ 7D25 E1               pop  hl
 555+ 7D26 D1               pop  de
 556+ 7D27 C1               pop  bc
 557+ 7D28 DD E1            pop  ix
 558+ 7D2A 37               scf
 559+ 7D2B C9               ret
 560+ 7D2C
 561+ 7D2C              .no_x_hit:
 562+ 7D2C C1               pop  bc                        ; Ripristina B (contatore ciclo)
 563+ 7D2D
 564+ 7D2D              .next_enemy:
 565+ 7D2D 11 0B 00         ld   de, 11
 566+ 7D30 DD 19            add  ix, de
 567+ 7D32 05               dec  b
 568+ 7D33 20 CB            jr   nz, .collision_loop
 569+ 7D35
 570+ 7D35              .no_collision_found:
 571+ 7D35 E1               pop  hl
 572+ 7D36 D1               pop  de
 573+ 7D37 C1               pop  bc
 574+ 7D38 DD E1            pop  ix
 575+ 7D3A B7               or   a
 576+ 7D3B C9               ret

1202+ 7566
1203+ 7566 2A E5 91         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 7569 11 8B 8F         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 756C 01 00 02         ld   bc, 512               ; 512 celle

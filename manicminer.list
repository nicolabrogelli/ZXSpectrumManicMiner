  12+ 7C45              ; DetermineCurrentRoomID
  13+ 7C45              ;
  14+ 7C45              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7C45              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7C45              ;
  17+ 7C45              ; Output:
  18+ 7C45              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7C45              ;   (current_room) = A
  20+ 7C45              ; -------------------------------------------------------------------
  21+ 7C45              DetermineCurrentRoomID:
  22+ 7C45 E5               push hl
  23+ 7C46 D5               push de
  24+ 7C47 C5               push bc

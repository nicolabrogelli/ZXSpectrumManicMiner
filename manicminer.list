2103+ 7D96                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2104+ 7D96 AF               xor  a
2105+ 7D97 32 27 F1         ld   (air_timer), a
2106+ 7D9A
2107+ 7D9A 3A 26 F1         ld   a, (air_pixels)
2108+ 7D9D B7               or   a
2109+ 7D9E 28 0C            jr   z, .air_finished
2110+ 7DA0
2111+ 7DA0 3D               dec  a
2112+ 7DA1 32 26 F1         ld   (air_pixels), a
2113+ 7DA4 CD 2D 6A         call Gfx_UpdateAirBar
2114+ 7DA7
2115+ 7DA7 B7               or   a
2116+ 7DA8 28 02            jr   z, .air_finished
2117+ 7DAA
2118+ 7DAA              .no_deplete:
2119+ 7DAA B7               or   a                     ; Carry Clear = Ok
2120+ 7DAB C9               ret
2121+ 7DAC
2122+ 7DAC              .air_finished:
2123+ 7DAC 37               scf                        ; Carry Set = Morte per esaurimento aria
2124+ 7DAD C9               ret

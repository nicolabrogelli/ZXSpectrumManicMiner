 161+ 7DFC              ; -------------------------------------------------------------------
 162+ 7DFC              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DFC              ; -------------------------------------------------------------------
 164+ 7DFC              CheckEnemyWillyOverlap:
 165+ 7DFC 3A 39 A2         ld   a, (player_drawn_pos+1)
 166+ 7DFF FE FF            cp   $FF
 167+ 7E01 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7E02
 169+ 7E02                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7E02 3A 38 A2         ld   a, (player_drawn_pos)
 171+ 7E05 E6 F8            and  $F8
 172+ 7E07 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7E08 79               ld   a, c
 174+ 7E09 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7E0B 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7E0C C6 10            add  a, 16
 177+ 7E0E FE 19            cp   25
 178+ 7E10 D0               ret  nc                 ; Fuori portata X
 179+ 7E11
 180+ 7E11                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7E11 3A 39 A2         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7E14 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7E15 C6 0F            add  a, 15
 184+ 7E17 FE 1F            cp   31
 185+ 7E19 D0               ret  nc                 ; Fuori portata Y
 186+ 7E1A
 187+ 7E1A                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7E1A 3E 01            ld   a, 1
 189+ 7E1C 32 3E A2         ld   (willy_needs_redraw), a
 190+ 7E1F C9               ret

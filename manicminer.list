 242+ 7E62 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E65 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E68 CD BC 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E6B
 246+ 7E6B C1               pop  bc
 247+ 7E6C
 248+ 7E6C              .next_erase:
 249+ 7E6C 11 0B 00         ld   de, 11

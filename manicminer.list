 414+ 86CF              ; CheckWillyItemCollision
 415+ 86CF              ;
 416+ 86CF              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 86CF              ; Input:
 418+ 86CF              ;   A = Item Col (0..31)
 419+ 86CF              ;   H = Item Row (0..15)
 420+ 86CF              ; Output:
 421+ 86CF              ;   Carry Set = Collisione
 422+ 86CF              ;   Carry Clear = Nessuna collisione
 423+ 86CF              ; -------------------------------------------------------------------
 424+ 86CF              CheckWillyItemCollision:
 425+ 86CF C5               push bc
 426+ 86D0 D5               push de
 427+ 86D1 E5               push hl
 428+ 86D2
 429+ 86D2                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 86D2 6F               ld   l, a
 431+ 86D3 87               add  a, a                      ; *2
 432+ 86D4 87               add  a, a                      ; *4
 433+ 86D5 87               add  a, a                      ; *8
 434+ 86D6 5F               ld   e, a                      ; E = ItemLeft
 435+ 86D7 C6 07            add  a, 7
 436+ 86D9 57               ld   d, a                      ; D = ItemRight
 437+ 86DA
 438+ 86DA ED 4B EA EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 86DE
 440+ 86DE                  ; WillyLeft <= ItemRight
 441+ 86DE 79               ld   a, c                      ; A = WillyX
 442+ 86DF BA               cp   d                         ; D = ItemRight
 443+ 86E0 28 04            jr   z, .x_ok
 444+ 86E2 38 02            jr   c, .x_ok
 445+ 86E4 18 31            jr   .no_collision
 446+ 86E6
 447+ 86E6              .x_ok:
 448+ 86E6                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 86E6 BB               cp   e                         ; E = ItemLeft
 450+ 86E7 28 0B            jr   z, .y_check
 451+ 86E9 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 86EB
 453+ 86EB                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 86EB C6 07            add  a, 7
 455+ 86ED BB               cp   e
 456+ 86EE 28 04            jr   z, .y_check
 457+ 86F0 30 02            jr   nc, .y_check
 458+ 86F2 18 23            jr   .no_collision
 459+ 86F4
 460+ 86F4              .y_check:
 461+ 86F4                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 86F4 7C               ld   a, h                      ; H = Item Row
 463+ 86F5 87               add  a, a                      ; *2
 464+ 86F6 87               add  a, a                      ; *4
 465+ 86F7 87               add  a, a                      ; *8
 466+ 86F8 5F               ld   e, a                      ; E = ItemTop
 467+ 86F9 C6 07            add  a, 7
 468+ 86FB 57               ld   d, a                      ; D = ItemBottom
 469+ 86FC
 470+ 86FC                  ; WillyTop <= ItemBottom
 471+ 86FC 78               ld   a, b                      ; A = WillyY
 472+ 86FD BA               cp   d                         ; D = ItemBottom
 473+ 86FE 28 04            jr   z, .y_ok
 474+ 8700 38 02            jr   c, .y_ok
 475+ 8702 18 13            jr   .no_collision
 476+ 8704
 477+ 8704              .y_ok:
 478+ 8704                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8704 BB               cp   e                         ; E = ItemTop
 480+ 8705 28 0B            jr   z, .collision
 481+ 8707 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8709
 483+ 8709                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8709 C6 0F            add  a, 15
 485+ 870B BB               cp   e
 486+ 870C 28 04            jr   z, .collision
 487+ 870E 30 02            jr   nc, .collision
 488+ 8710 18 05            jr   .no_collision

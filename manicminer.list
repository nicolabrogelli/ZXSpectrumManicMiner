 478+ 7F67              ; Enemy_DrawSingleSlot
 479+ 7F67              ;
 480+ 7F67              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7F67              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7F67              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F67              ; -------------------------------------------------------------------
 484+ 7F67              Enemy_DrawSingleSlot:
 485+ 7F67 C5               push bc
 486+ 7F68 D5               push de
 487+ 7F69 E5               push hl
 488+ 7F6A DD E5            push ix
 489+ 7F6C
 490+ 7F6C                  ; 1. Salva subito le coordinate X e Y dal record IX
 491+ 7F6C DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 492+ 7F6F DD 46 03         ld   b, (ix+3)                 ; B = Current Y

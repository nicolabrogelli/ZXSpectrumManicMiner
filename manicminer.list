 536+ 8091 FD 4E 00         ld   c, (iy+0)
 537+ 8094 FD 46 01         ld   b, (iy+1)
 538+ 8097 C5               push bc
 539+ 8098 26 00            ld   h, 0
 540+ 809A 68               ld   l, b
 541+ 809B 29               add  hl, hl
 541+ 809C 29             add hl, hl
 541+ 809D 29             add hl, hl
 541+ 809E 29             add hl, hl
 541+ 809F 29             add hl, hl
 542+ 80A0 59               ld   e, c

  59+ 7EB5              ; ResetItemsTable
  60+ 7EB5              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7EB5              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7EB5              ; -------------------------------------------------------------------
  63+ 7EB5              ResetItemsTable:
  64+ 7EB5 E5               push hl
  65+ 7EB6 D5               push de
  66+ 7EB7 C5               push bc
  67+ 7EB8
  68+ 7EB8 21 9D 71         ld   hl, RoomsListTable
  69+ 7EBB 06 02            ld   b, NUM_ROOMS
  70+ 7EBD

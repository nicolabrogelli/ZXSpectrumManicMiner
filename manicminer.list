 390+ 7F2B              Enemy_Update:
 391+ 7F2B                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7F2B 3A D1 A1         ld   a, (enemy_update_rate)
 393+ 7F2E FE 01            cp   1
 394+ 7F30 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7F32
 396+ 7F32 21 D2 A1         ld   hl, enemy_update_timer
 397+ 7F35 34               inc  (hl)
 398+ 7F36 7E               ld   a, (hl)
 399+ 7F37 21 D1 A1         ld   hl, enemy_update_rate
 400+ 7F3A BE               cp   (hl)
 401+ 7F3B D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7F3C AF               xor  a
 403+ 7F3D 32 D2 A1         ld   (enemy_update_timer), a

 318+ 84ED 87               add  a, a                      ; *4
 319+ 84EE 87               add  a, a                      ; *8
 320+ 84EF 87               add  a, a                      ; *16
 321+ 84F0 87               add  a, a                      ; *32
 322+ 84F1 81               add  a, c                      ; + Col
 323+ 84F2 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 84F3
 325+ 84F3 C5               push bc
 326+ 84F4 06 08            ld   b, 8                      ; 8 scanline

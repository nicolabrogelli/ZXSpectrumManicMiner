 275  807D              ; -------------------------------------------------------------------
 276  807D              ; ShowTitleScreen
 277  807D              ; Visualizza la schermata iniziale del gioco (Title Screen).
 278  807D              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 279  807D              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 280  807D              ; -------------------------------------------------------------------
 281  807D              ShowTitleScreen:
 282  807D                  ; 1. Disegna la schermata iniziale
 283  807D CD 69 62         call Gfx_DrawTitleScreen
 284  8080
 285  8080                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 286  8080              .wait_title_enter_release:
 287  8080 76               halt
 288  8081 3E BF            ld   a, $bf
 289  8083 DB FE            in   a, ($fe)
 290  8085 1F               rra
 291  8086 30 F8            jr   nc, .wait_title_enter_release
 292  8088
 293  8088                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 294  8088 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 295  808A              .title_loop:
 296  808A 76               halt
 297  808B
 298  808B                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 299  808B 0C               inc  c
 300  808C 79               ld   a, c
 301  808D CB 3F            srl  a
 302  808F CB 3F            srl  a
 303  8091 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 304  8093 E6 07            and  7
 305  8095 5F               ld   e, a
 306  8096 16 00            ld   d, 0
 307  8098 21 61 62         ld   hl, title_color_table
 308  809B 19               add  hl, de
 309  809C 7E               ld   a, (hl)               ; A = nuovo colore
 310  809D 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 311  80A0 06 20            ld   b, 32
 312  80A2              .color_title_loop:
 313  80A2 77               ld   (hl), a
 314  80A3 23               inc  hl
 315  80A4 10 FC            djnz .color_title_loop
 316  80A6
 317  80A6                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 318  80A6 3E BF            ld   a, $bf
 319  80A8 DB FE            in   a, ($fe)
 320  80AA 1F               rra
 321  80AB 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 322  80AD
 323  80AD                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 324  80AD              .wait_title_enter_release_after:
 325  80AD 76               halt
 326  80AE 3E BF            ld   a, $bf
 327  80B0 DB FE            in   a, ($fe)
 328  80B2 1F               rra
 329  80B3 30 F8            jr   nc, .wait_title_enter_release_after

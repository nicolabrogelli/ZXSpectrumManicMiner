  12+ 8037              ; DetermineCurrentRoomID
  13+ 8037              ;
  14+ 8037              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 8037              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 8037              ;
  17+ 8037              ; Output:
  18+ 8037              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 8037              ;   (current_room) = A
  20+ 8037              ; -------------------------------------------------------------------
  21+ 8037              DetermineCurrentRoomID:
  22+ 8037 E5               push hl
  23+ 8038 D5               push de
  24+ 8039 C5               push bc
  25+ 803A
  26+ 803A 21 7C 73         ld   hl, RoomsListTable
  27+ 803D ED 5B B3 A1      ld   de, (room_ptr)
  28+ 8041 06 04            ld   b, NUM_ROOMS
  29+ 8043 0E 00            ld   c, 0
  30+ 8045
  31+ 8045              .loop:
  32+ 8045 7E               ld   a, (hl)
  33+ 8046 BB               cp   e
  34+ 8047 20 06            jr   nz, .no_match
  35+ 8049 23               inc  hl
  36+ 804A 7E               ld   a, (hl)
  37+ 804B BA               cp   d
  38+ 804C 28 08            jr   z, .found
  39+ 804E 2B               dec  hl
  40+ 804F
  41+ 804F              .no_match:
  42+ 804F 23               inc  hl
  43+ 8050 23               inc  hl
  44+ 8051 0C               inc  c
  45+ 8052 10 F1            djnz .loop
  46+ 8054
  47+ 8054 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 8056
  49+ 8056              .found:
  50+ 8056 79               ld   a, c
  51+ 8057 32 58 A1         ld   (current_room), a
  52+ 805A
  53+ 805A C1               pop  bc
  54+ 805B D1               pop  de
  55+ 805C E1               pop  hl
  56+ 805D C9               ret

   8+ 8342              ; Audio_UpdateJumpSound
   9+ 8342              ;
  10+ 8342              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8342              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8342              ; -------------------------------------------------------------------
  13+ 8342              Audio_UpdateJumpSound:
  14+ 8342 F5               push af
  15+ 8343 C5               push bc
  16+ 8344 D5               push de
  17+ 8345 E5               push hl
  18+ 8346
  19+ 8346                  ; Controlla se il suono è attivo (note < 18)
  20+ 8346 3A 80 9C         ld   a, (Audio_jump_sound_note)
  21+ 8349 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 834B 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 834D
  24+ 834D                  ; Carica la nota corrente da suonare
  25+ 834D 5F               ld   e, a
  26+ 834E 16 00            ld   d, 0
  27+ 8350 21 7C 83         ld   hl, Audio_JumpSoundDelays
  28+ 8353 19               add  hl, de
  29+ 8354 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8355 57               ld   d, a                      ; D = delay della nota
  31+ 8356
  32+ 8356                  ; Suona la nota: 15 cicli
  33+ 8356 06 0F            ld   b, 15
  34+ 8358              .note_loop:
  35+ 8358                  ; Speaker ON
  36+ 8358 3A 73 96         ld   a, (room_border_color)
  37+ 835B F6 10            or   $10
  38+ 835D D3 FE            out  ($fe), a
  39+ 835F 4A               ld   c, d
  40+ 8360              .d1:
  41+ 8360 0D               dec  c
  42+ 8361 20 FD            jr   nz, .d1
  43+ 8363
  44+ 8363                  ; Speaker OFF
  45+ 8363 3A 73 96         ld   a, (room_border_color)
  46+ 8366 E6 EF            and  $ef
  47+ 8368 D3 FE            out  ($fe), a
  48+ 836A 4A               ld   c, d
  49+ 836B              .d2:
  50+ 836B 0D               dec  c
  51+ 836C 20 FD            jr   nz, .d2
  52+ 836E
  53+ 836E 10 E8            djnz .note_loop
  54+ 8370
  55+ 8370                  ; Passa alla nota successiva
  56+ 8370 3A 80 9C         ld   a, (Audio_jump_sound_note)
  57+ 8373 3C               inc  a
  58+ 8374 32 80 9C         ld   (Audio_jump_sound_note), a
  59+ 8377
  60+ 8377              .done:
  61+ 8377 E1               pop  hl
  62+ 8378 D1               pop  de
  63+ 8379 C1               pop  bc
  64+ 837A F1               pop  af
  65+ 837B C9               ret

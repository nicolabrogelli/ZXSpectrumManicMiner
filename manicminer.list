 362+ 7B0B 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7B0C E5               push hl
 364+ 7B0D DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7B0F
 366+ 7B0F                  ; 2. Coordinate e colore
 367+ 7B0F FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7B11 FD E5            push iy
 369+ 7B13
 370+ 7B13 FD 4E 02         ld   c, (iy+2)                 ; C = Current X

 322+ 7E49              .do_draw_slot:
 323+ 7E49 C5               push bc                ; Salva contatore ciclo
 324+ 7E4A
 325+ 7E4A                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)

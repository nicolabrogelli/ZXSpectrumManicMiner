2024+ 7D15              ; Phys_UpdateAir
2025+ 7D15              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2026+ 7D15              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2027+ 7D15              ; Output:
2028+ 7D15              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2029+ 7D15              ;   Carry Clear = Aria ancora disponibile
2030+ 7D15              ; -------------------------------------------------------------------
2031+ 7D15              Phys_UpdateAir:
2032+ 7D15                  ; Incrementa il timer dei frame
2033+ 7D15 3A A8 F0         ld   a, (air_timer)
2034+ 7D18 3C               inc  a
2035+ 7D19 32 A8 F0         ld   (air_timer), a
2036+ 7D1C 21 A9 F0         ld   hl, air_deplete_rate
2037+ 7D1F BE               cp   (hl)
2038+ 7D20 38 14            jr   c, .no_deplete
2039+ 7D22
2040+ 7D22                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2041+ 7D22 AF               xor  a
2042+ 7D23 32 A8 F0         ld   (air_timer), a
2043+ 7D26
2044+ 7D26 3A A7 F0         ld   a, (air_pixels)
2045+ 7D29 B7               or   a
2046+ 7D2A 28 0C            jr   z, .air_finished
2047+ 7D2C
2048+ 7D2C 3D               dec  a
2049+ 7D2D 32 A7 F0         ld   (air_pixels), a
2050+ 7D30 CD 2D 6A         call Gfx_UpdateAirBar
2051+ 7D33
2052+ 7D33 B7               or   a
2053+ 7D34 28 02            jr   z, .air_finished
2054+ 7D36
2055+ 7D36              .no_deplete:
2056+ 7D36 B7               or   a                     ; Carry Clear = Ok
2057+ 7D37 C9               ret
2058+ 7D38
2059+ 7D38              .air_finished:
2060+ 7D38 37               scf                        ; Carry Set = Morte per esaurimento aria
2061+ 7D39 C9               ret

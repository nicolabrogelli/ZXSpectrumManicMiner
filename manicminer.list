 138+ 7D45              .done_h_guardians:
 139+ 7D45                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7D45 2A 4C B6         ld   hl, (room_ptr)
 141+ 7D48 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7D4B 19               add  hl, de
 143+ 7D4C
 144+ 7D4C 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 145+ 7D4E              .load_v_loop:
 146+ 7D4E 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 147+ 7D4F FE FF            cp   $FF
 148+ 7D51 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 149+ 7D53 B7               or   a
 150+ 7D54 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 151+ 7D56
 152+ 7D56                  ; Slot attivo per guardiano verticale
 153+ 7D56 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 154+ 7D5A DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 155+ 7D5D
 156+ 7D5D 23               inc  hl
 157+ 7D5E 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 158+ 7D5F E6 03            and  3
 159+ 7D61 C6 04            add  a, 4                      ; Frame 4..7 in OFFSET_GUARDIAN_GRAPHICS
 160+ 7D63 DD 77 01         ld   (ix+1), a                 ; Frame index (4..7)
 161+ 7D66
 162+ 7D66 23               inc  hl
 163+ 7D67 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 164+ 7D68 DD 77 03         ld   (ix+3), a                 ; Current Y
 165+ 7D6B
 166+ 7D6B 23               inc  hl
 167+ 7D6C 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 168+ 7D6D E6 1F            and  31
 169+ 7D6F 87               add  a, a
 169+ 7D70 87             add a, a
 169+ 7D71 87             add a, a ; * 8 -> X pixel
 170+ 7D72 DD 77 02         ld   (ix+2), a                 ; Current X
 171+ 7D75
 172+ 7D75 23               inc  hl
 173+ 7D76 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 174+ 7D77 E6 03            and  3
 175+ 7D79 20 02            jr   nz, .v_step_ok
 176+ 7D7B 3E 01            ld   a, 1
 177+ 7D7D              .v_step_ok:
 178+ 7D7D DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 179+ 7D80 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 180+ 7D82 DD 77 06         ld   (ix+6), a
 181+ 7D85
 182+ 7D85 23               inc  hl
 183+ 7D86 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 184+ 7D87 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 185+ 7D8A
 186+ 7D8A 23               inc  hl
 187+ 7D8B 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 188+ 7D8C DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 189+ 7D8F
 190+ 7D8F 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 191+ 7D90 11 0B 00         ld   de, 11
 192+ 7D93 DD 19            add  ix, de
 193+ 7D95 10 B7            djnz .load_v_loop
 194+ 7D97
 195+ 7D97              .done_v_guardians:
 196+ 7D97 DD E1            pop  ix
 197+ 7D99 C1               pop  bc
 198+ 7D9A D1               pop  de
 199+ 7D9B E1               pop  hl
 200+ 7D9C C9               ret

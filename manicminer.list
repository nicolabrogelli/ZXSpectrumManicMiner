 798+ 8959 11 72 EA         ld   de, items_grid
 799+ 895C 19               add  hl, de
 800+ 895D 70               ld   (hl), b
 801+ 895E E1               pop  hl
 802+ 895F
 803+ 895F                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 895F 11 00 58         ld   de, COLOR_DATA
 805+ 8962 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 8963 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo

 333+ 7AEB E6 03            and  3
 334+ 7AED 47               ld   b, a                      ; B = Anim subframe
 335+ 7AEE
 336+ 7AEE DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7AF1 FE 01            cp   1                         ; Sinistra?
 338+ 7AF3 28 03            jr   z, .left_frames
 339+ 7AF5
 340+ 7AF5                  ; Movimento a Destra: Frame 0..3
 341+ 7AF5 78               ld   a, b
 342+ 7AF6 18 03            jr   .got_frame_idx
 343+ 7AF8

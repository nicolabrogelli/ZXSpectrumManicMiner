 408+ 828B              ; CheckWillyItemCollision
 409+ 828B              ;
 410+ 828B              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 828B              ; Input:
 412+ 828B              ;   A = Item Col (0..31)
 413+ 828B              ;   H = Item Row (0..15)
 414+ 828B              ; Output:
 415+ 828B              ;   Carry Set = Collisione
 416+ 828B              ;   Carry Clear = Nessuna collisione
 417+ 828B              ; -------------------------------------------------------------------
 418+ 828B              CheckWillyItemCollision:
 419+ 828B C5               push bc
 420+ 828C D5               push de
 421+ 828D E5               push hl
 422+ 828E
 423+ 828E                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 828E 6F               ld   l, a
 425+ 828F 87               add  a, a                      ; *2
 426+ 8290 87               add  a, a                      ; *4
 427+ 8291 87               add  a, a                      ; *8
 428+ 8292 5F               ld   e, a                      ; E = ItemLeft
 429+ 8293 C6 07            add  a, 7
 430+ 8295 57               ld   d, a                      ; D = ItemRight
 431+ 8296
 432+ 8296 ED 4B CB B2      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 829A
 434+ 829A                  ; WillyLeft <= ItemRight
 435+ 829A 79               ld   a, c                      ; A = WillyX
 436+ 829B BA               cp   d                         ; D = ItemRight
 437+ 829C 28 04            jr   z, .x_ok
 438+ 829E 38 02            jr   c, .x_ok
 439+ 82A0 18 31            jr   .no_collision
 440+ 82A2
 441+ 82A2              .x_ok:
 442+ 82A2                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 82A2 BB               cp   e                         ; E = ItemLeft
 444+ 82A3 28 0B            jr   z, .y_check
 445+ 82A5 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 82A7
 447+ 82A7                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 82A7 C6 0F            add  a, 15
 449+ 82A9 BB               cp   e
 450+ 82AA 28 04            jr   z, .y_check
 451+ 82AC 30 02            jr   nc, .y_check
 452+ 82AE 18 23            jr   .no_collision
 453+ 82B0
 454+ 82B0              .y_check:
 455+ 82B0                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 82B0 7C               ld   a, h                      ; H = Item Row
 457+ 82B1 87               add  a, a                      ; *2
 458+ 82B2 87               add  a, a                      ; *4
 459+ 82B3 87               add  a, a                      ; *8

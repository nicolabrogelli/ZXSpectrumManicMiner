 960+ 77C6              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 961+ 77C6              ; Input: C = X, B = Y
 962+ 77C6              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 963+ 77C6              ; -------------------------------------------------------------------
 964+ 77C6              CheckWallCell:
 965+ 77C6 E5               push hl
 966+ 77C7 D5               push de
 967+ 77C8 C5               push bc
 968+ 77C9
 969+ 77C9                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77C9 78               ld   a, b
 971+ 77CA FE 80            cp   128
 972+ 77CC 30 1F            jr   nc, .not_wall
 973+ 77CE
 974+ 77CE                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77CE CB 3F            srl  a
 976+ 77D0 CB 3F            srl  a
 977+ 77D2 CB 3F            srl  a                 ; A = r (0..15)
 978+ 77D4
 979+ 77D4                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77D4 5F               ld   e, a              ; E = r (Row)
 981+ 77D5 79               ld   a, c

 460+ 86C0              .y_check:
 461+ 86C0                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 86C0 7C               ld   a, h                      ; H = Item Row
 463+ 86C1 87               add  a, a                      ; *2
 464+ 86C2 87               add  a, a                      ; *4

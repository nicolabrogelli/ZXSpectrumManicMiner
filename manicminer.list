 271+ 6C81              ; LoadPositionPlayeinRoom
 272+ 6C81              ;
 273+ 6C81              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6C81              ; in una nuova stanza.
 275+ 6C81              ;
 276+ 6C81              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6C81              ; (layout/metadata) a partire da room_ptr.
 278+ 6C81              ;
 279+ 6C81              ; Output:
 280+ 6C81              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6C81              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6C81              ;
 283+ 6C81              ; Struttura dati stanza:
 284+ 6C81              ;   OFFSET_POS_WILLY:
 285+ 6C81              ;       +0 = X
 286+ 6C81              ;       +1 = Y
 287+ 6C81              ; -------------------------------------------------------------------
 288+ 6C81              LoadPositionPlayeinRoom:
 289+ 6C81                  ; ---------------------------------------------------------------
 290+ 6C81                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6C81                  ; ---------------------------------------------------------------
 292+ 6C81 2A E5 91         ld   hl, (room_ptr)
 293+ 6C84 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6C87 19               add  hl, de
 295+ 6C88
 296+ 6C88                  ; Byte 0: Y * 2
 297+ 6C88 7E               ld   a, (hl)
 298+ 6C89 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6C8B 57               ld   d, a                      ; D = PlayerY
 300+ 6C8C
 301+ 6C8C                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6C8C 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6C8D 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6C8E 7E               ld   a, (hl)
 305+ 6C8F E6 01            and  1
 306+ 6C91 28 04            jr   z, .facing_right
 307+ 6C93 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6C95 18 02            jr   .set_dir
 309+ 6C97              .facing_right:
 310+ 6C97 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6C99              .set_dir:
 312+ 6C99 32 6C 8E         ld   (direction), a
 313+ 6C9C
 314+ 6C9C                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6C9C 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6C9D 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6C9E 4E               ld   c, (hl)
 318+ 6C9F 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6CA0 7E               ld   a, (hl)
 320+ 6CA1
 321+ 6CA1                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6CA1 67               ld   h, a
 323+ 6CA2 69               ld   l, c
 324+ 6CA3 01 00 A4         ld   bc, -23552
 325+ 6CA6 09               add  hl, bc
 326+ 6CA7
 327+ 6CA7 7D               ld   a, l
 328+ 6CA8 E6 1F            and  31
 329+ 6CAA 87               add  a, a                      ; *2
 330+ 6CAB 87               add  a, a                      ; *4
 331+ 6CAC 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6CAD 4F               ld   c, a                      ; C = PlayerX
 333+ 6CAE 42               ld   b, d                      ; B = PlayerY
 334+ 6CAF
 335+ 6CAF                  ; Salva coordinate (C = X, B = Y)
 336+ 6CAF ED 43 65 8E      ld   (PlayerPos), bc
 337+ 6CB3 ED 43 67 8E      ld   (PlayerPosOld), bc
 338+ 6CB7 C9               ret

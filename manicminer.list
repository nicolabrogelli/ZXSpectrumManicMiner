2114+ 7D07              ; Phys_UpdateAir
2115+ 7D07              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2116+ 7D07              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2117+ 7D07              ; Output:
2118+ 7D07              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2119+ 7D07              ;   Carry Clear = Aria ancora disponibile
2120+ 7D07              ; -------------------------------------------------------------------
2121+ 7D07              Phys_UpdateAir:
2122+ 7D07                  ; Incrementa il timer dei frame
2123+ 7D07 3A 83 9C         ld   a, (air_timer)
2124+ 7D0A 3C               inc  a
2125+ 7D0B 32 83 9C         ld   (air_timer), a
2126+ 7D0E 21 84 9C         ld   hl, air_deplete_rate
2127+ 7D11 BE               cp   (hl)
2128+ 7D12 38 14            jr   c, .no_deplete
2129+ 7D14
2130+ 7D14                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2131+ 7D14 AF               xor  a
2132+ 7D15 32 83 9C         ld   (air_timer), a
2133+ 7D18
2134+ 7D18 3A 82 9C         ld   a, (air_pixels)
2135+ 7D1B B7               or   a
2136+ 7D1C 28 0C            jr   z, .air_finished
2137+ 7D1E
2138+ 7D1E 3D               dec  a
2139+ 7D1F 32 82 9C         ld   (air_pixels), a
2140+ 7D22 CD B8 6A         call Gfx_UpdateAirBar
2141+ 7D25
2142+ 7D25 B7               or   a
2143+ 7D26 28 02            jr   z, .air_finished
2144+ 7D28
2145+ 7D28              .no_deplete:
2146+ 7D28 B7               or   a                     ; Carry Clear = Ok
2147+ 7D29 C9               ret
2148+ 7D2A
2149+ 7D2A              .air_finished:
2150+ 7D2A 37               scf                        ; Carry Set = Morte per esaurimento aria
2151+ 7D2B C9               ret

 471+ 86C8 78               ld   a, b                      ; A = WillyY
 472+ 86C9 BA               cp   d                         ; D = ItemBottom
 473+ 86CA 28 04            jr   z, .y_ok
 474+ 86CC 38 02            jr   c, .y_ok
 475+ 86CE 18 13            jr   .no_collision
 476+ 86D0
 477+ 86D0              .y_ok:
 478+ 86D0                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 86D0 BB               cp   e                         ; E = ItemTop
 480+ 86D1 28 0B            jr   z, .collision
 481+ 86D3 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 86D5
 483+ 86D5                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 86D5 C6 0F            add  a, 15
 485+ 86D7 BB               cp   e
 486+ 86D8 28 04            jr   z, .collision

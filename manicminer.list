 293+ 7E23                  ; Cancella il nemico nella VECCHIA posizione
 294+ 7E23 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 295+ 7E26 DD 46 09         ld   b, (ix+9)         ; B = Old Y

 445+ 7ED9              ; -------------------------------------------------------------------
 446+ 7ED9              ; Items_CheckCollision
 447+ 7ED9              ;
 448+ 7ED9              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 449+ 7ED9              ; -------------------------------------------------------------------
 450+ 7ED9              Items_CheckCollision:
 451+ 7ED9 E5               push hl
 452+ 7EDA D5               push de
 453+ 7EDB C5               push bc
 454+ 7EDC FD E5            push iy
 455+ 7EDE
 456+ 7EDE 3A 13 92         ld   a, (num_room_items)
 457+ 7EE1 B7               or   a
 458+ 7EE2 28 5F            jr   z, .done
 459+ 7EE4
 460+ 7EE4 47               ld   b, a                      ; B = numero item attivi
 461+ 7EE5 FD 21 C3 91      ld   iy, current_room_items
 462+ 7EE9
 463+ 7EE9              .loop:
 464+ 7EE9 FD 7E 02         ld   a, (iy+2)                 ; Color / Active
 465+ 7EEC B7               or   a
 466+ 7EED 28 4D            jr   z, .next_item
 467+ 7EEF
 468+ 7EEF FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 469+ 7EF2 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 470+ 7EF5
 471+ 7EF5 79               ld   a, c
 472+ 7EF6 CD 94 7E         call CheckWillyItemCollision
 473+ 7EF9 30 41            jr   nc, .next_item
 474+ 7EFB
 475+ 7EFB                  ; --- ITEM RACCOLTO ---
 476+ 7EFB                  ; 1. Imposta il flag collected nei dati stanza
 477+ 7EFB FD 6E 03         ld   l, (iy+3)
 478+ 7EFE FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 479+ 7F01 36 00            ld   (hl), 0                   ; 0 = raccolto
 480+ 7F03
 481+ 7F03                  ; 2. Rimuovi dalla griglia items_grid
 482+ 7F03 FD 4E 00         ld   c, (iy+0)
 483+ 7F06 FD 46 01         ld   b, (iy+1)
 484+ 7F09 C5               push bc
 485+ 7F0A 26 00            ld   h, 0
 486+ 7F0C 68               ld   l, b
 487+ 7F0D 29               add  hl, hl
 487+ 7F0E 29             add hl, hl
 487+ 7F0F 29             add hl, hl
 487+ 7F10 29             add hl, hl
 487+ 7F11 29             add hl, hl
 488+ 7F12 59               ld   e, c
 489+ 7F13 16 00            ld   d, 0
 490+ 7F15 19               add  hl, de
 491+ 7F16 11 94 8C         ld   de, items_grid
 492+ 7F19 19               add  hl, de
 493+ 7F1A 36 00            ld   (hl), 0
 494+ 7F1C C1               pop  bc
 495+ 7F1D
 496+ 7F1D                  ; 3. Disattiva lo slot nella cache
 497+ 7F1D FD 36 02 00      ld   (iy+2), 0
 498+ 7F21
 499+ 7F21                  ; 4. Incrementa il conteggio globale degli item raccolti
 500+ 7F21 3A 9E 8E         ld   a, (items_collected)
 501+ 7F24 3C               inc  a
 502+ 7F25 32 9E 8E         ld   (items_collected), a
 503+ 7F28
 504+ 7F28 FE 05            cp   TOTAL_ITEMS
 505+ 7F2A 38 07            jr   c, .objective_not_yet
 506+ 7F2C F5               push af
 507+ 7F2D 3E 01            ld   a, 1
 508+ 7F2F 32 A9 94         ld   (game_objective_completed), a
 509+ 7F32 F1               pop  af
 510+ 7F33              .objective_not_yet:
 511+ 7F33                  ; 5. Aggiungi 100 punti allo Score, aggiorna High Score e aggiorna la visualizzazione HUD
 512+ 7F33 CD 67 7F         call Score_AddItemPoints
 513+ 7F36
 514+ 7F36                  ; 6. Ripristina il tile di sfondo
 515+ 7F36 CD 62 7E         call RestoreBackgroundCell
 516+ 7F39
 517+ 7F39                  ; 7. Suono di raccolta
 518+ 7F39 CD 0A 80         call Audio_PlayCollectSound
 519+ 7F3C
 520+ 7F3C              .next_item:
 521+ 7F3C 11 05 00         ld   de, 5
 522+ 7F3F FD 19            add  iy, de
 523+ 7F41 10 A6            djnz .loop
 524+ 7F43
 525+ 7F43              .done:
 526+ 7F43 FD E1            pop  iy
 527+ 7F45 C1               pop  bc
 528+ 7F46 D1               pop  de
 529+ 7F47 E1               pop  hl
 530+ 7F48 C9               ret
 531+ 7F49
 532+ 7F49              ; -------------------------------------------------------------------
 533+ 7F49              ; CheckActiveItemAtCell
 534+ 7F49              ;
 535+ 7F49              ; Verifica rapida su griglia se c'è un item attivo alla cella (B=Col, C=Row)
 536+ 7F49              ; Output: Carry Set = Item presente, Carry Clear = Nessun item
 537+ 7F49              ; -------------------------------------------------------------------
 538+ 7F49              CheckActiveItemAtCell:
 539+ 7F49 D5               push de
 540+ 7F4A E5               push hl
 541+ 7F4B
 542+ 7F4B 26 00            ld   h, 0
 543+ 7F4D 69               ld   l, c                      ; HL = Row
 544+ 7F4E 29               add  hl, hl
 544+ 7F4F 29             add hl, hl
 544+ 7F50 29             add hl, hl
 544+ 7F51 29             add hl, hl
 544+ 7F52 29             add hl, hl
 545+ 7F53 58               ld   e, b
 546+ 7F54 16 00            ld   d, 0
 547+ 7F56 19               add  hl, de
 548+ 7F57 11 94 8C         ld   de, items_grid
 549+ 7F5A 19               add  hl, de
 550+ 7F5B 7E               ld   a, (hl)
 551+ 7F5C B7               or   a
 552+ 7F5D 28 04            jr   z, .not_active
 553+ 7F5F
 554+ 7F5F E1               pop  hl
 555+ 7F60 D1               pop  de
 556+ 7F61 37               scf
 557+ 7F62 C9               ret
 558+ 7F63
 559+ 7F63              .not_active:
 560+ 7F63 E1               pop  hl
 561+ 7F64 D1               pop  de
 562+ 7F65 B7               or   a
 563+ 7F66 C9               ret
 564+ 7F67
 565+ 7F67              ; -------------------------------------------------------------------
 566+ 7F67              ; Score_AddItemPoints
 567+ 7F67              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 568+ 7F67              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 569+ 7F67              ; -------------------------------------------------------------------
 570+ 7F67              Score_AddItemPoints:
 571+ 7F67 F5               push af
 572+ 7F68 C5               push bc
 573+ 7F69 D5               push de
 574+ 7F6A E5               push hl
 575+ 7F6B
 576+ 7F6B                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 577+ 7F6B 3A A4 94         ld   a, (player_score + 1)
 578+ 7F6E C6 01            add  a, $01
 579+ 7F70 27               daa
 580+ 7F71 32 A4 94         ld   (player_score + 1), a
 581+ 7F74
 582+ 7F74                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 583+ 7F74 3A A5 94         ld   a, (player_score + 2)
 584+ 7F77 CE 00            adc  a, 0
 585+ 7F79 27               daa
 586+ 7F7A 32 A5 94         ld   (player_score + 2), a
 587+ 7F7D
 588+ 7F7D                  ; Controlla se player_score ha superato high_score
 589+ 7F7D CD 88 7F         call Score_CheckAndUpdateHighScore
 590+ 7F80
 591+ 7F80                  ; Aggiorna visualizzazione a schermo
 592+ 7F80 CD 66 67         call Gfx_UpdateScoreDisplay
 593+ 7F83
 594+ 7F83 E1               pop  hl
 595+ 7F84 D1               pop  de
 596+ 7F85 C1               pop  bc
 597+ 7F86 F1               pop  af
 598+ 7F87 C9               ret
 599+ 7F88
 600+ 7F88              ; -------------------------------------------------------------------
 601+ 7F88              ; Score_CheckAndUpdateHighScore
 602+ 7F88              ; Se player_score > high_score, copia player_score in high_score.
 603+ 7F88              ; -------------------------------------------------------------------
 604+ 7F88              Score_CheckAndUpdateHighScore:
 605+ 7F88                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 606+ 7F88                  ; Byte 2:
 607+ 7F88 3A A5 94         ld   a, (player_score + 2)
 608+ 7F8B 47               ld   b, a
 609+ 7F8C 3A A8 94         ld   a, (high_score + 2)
 610+ 7F8F B8               cp   b
 611+ 7F90 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 612+ 7F92 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento

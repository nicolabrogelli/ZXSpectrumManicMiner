  29+ 7D40              ; Enemy_LoadRoom
  30+ 7D40              ;
  31+ 7D40              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7D40              ; Chiamato quando si entra in una stanza.
  33+ 7D40              ; -------------------------------------------------------------------
  34+ 7D40              Enemy_LoadRoom:
  35+ 7D40 E5               push hl
  36+ 7D41 D5               push de
  37+ 7D42 C5               push bc
  38+ 7D43 DD E5            push ix
  39+ 7D45
  40+ 7D45                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D45 21 E8 7C         ld   hl, ActiveEnemies
  42+ 7D48 11 E9 7C         ld   de, ActiveEnemies + 1
  43+ 7D4B 36 00            ld   (hl), 0
  44+ 7D4D 01 57 00         ld   bc, 87
  45+ 7D50 ED B0            ldir
  46+ 7D52
  47+ 7D52                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D52 DD 21 E8 7C      ld   ix, ActiveEnemies
  49+ 7D56 06 08            ld   b, 8
  50+ 7D58 11 0B 00         ld   de, 11
  51+ 7D5B              .init_old_pos:
  52+ 7D5B DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D5F DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D63 DD 19            add  ix, de
  55+ 7D65 10 F4            djnz .init_old_pos
  56+ 7D67
  57+ 7D67                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D67 DD 21 E8 7C      ld   ix, ActiveEnemies
  59+ 7D6B 2A C1 AE         ld   hl, (room_ptr)
  60+ 7D6E 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D71 19               add  hl, de
  62+ 7D72
  63+ 7D72 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D74              .load_h_loop:
  65+ 7D74 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D75 FE FF            cp   $FF
  67+ 7D77 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D79 B7               or   a
  69+ 7D7A 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D7C
  71+ 7D7C                  ; Slot attivo
  72+ 7D7C DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D80 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D83
  75+ 7D83 23               inc  hl
  76+ 7D84 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D85 23               inc  hl
  78+ 7D86 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D87
  80+ 7D87                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D87 E5               push hl
  82+ 7D88 C5               push bc
  83+ 7D89 67               ld   h, a
  84+ 7D8A 69               ld   l, c
  85+ 7D8B 01 00 A4         ld   bc, -23552
  86+ 7D8E 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D8F
  88+ 7D8F                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D8F 7D               ld   a, l
  90+ 7D90 E6 1F            and  31
  91+ 7D92 87               add  a, a
  91+ 7D93 87             add a, a
  91+ 7D94 87             add a, a
  92+ 7D95 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D98
  94+ 7D98                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D98 CB 3C            srl  h
  95+ 7D9A CB 1D          rr l
  96+ 7D9C CB 3C            srl  h
  96+ 7D9E CB 1D          rr l
  97+ 7DA0 CB 3C            srl  h
  97+ 7DA2 CB 1D          rr l
  98+ 7DA4 CB 3C            srl  h
  98+ 7DA6 CB 1D          rr l
  99+ 7DA8 CB 3C            srl  h
  99+ 7DAA CB 1D          rr l
 100+ 7DAC 7D               ld   a, l
 101+ 7DAD 87               add  a, a
 101+ 7DAE 87             add a, a
 101+ 7DAF 87             add a, a
 102+ 7DB0 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7DB3 C1               pop  bc
 104+ 7DB4 E1               pop  hl
 105+ 7DB5
 106+ 7DB5 23               inc  hl
 107+ 7DB6 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7DB7 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7DBB
 110+ 7DBB 23               inc  hl
 111+ 7DBC 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7DBD E6 01            and  1
 113+ 7DBF 28 04            jr   z, .h_dir_right
 114+ 7DC1 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DC3 18 02            jr   .set_h_dir
 116+ 7DC5              .h_dir_right:
 117+ 7DC5 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DC7              .set_h_dir:
 119+ 7DC7 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7DCA
 121+ 7DCA 23               inc  hl
 122+ 7DCB 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DCC E6 1F            and  31
 124+ 7DCE 87               add  a, a
 124+ 7DCF 87             add a, a
 124+ 7DD0 87             add a, a
 125+ 7DD1 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DD4
 127+ 7DD4 23               inc  hl
 128+ 7DD5 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DD6 E6 1F            and  31
 130+ 7DD8 87               add  a, a
 130+ 7DD9 87             add a, a
 130+ 7DDA 87             add a, a
 131+ 7DDB DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DDE
 133+ 7DDE 23               inc  hl                        ; Prossimo guardiano
 134+ 7DDF 11 0B 00         ld   de, 11
 135+ 7DE2 DD 19            add  ix, de
 136+ 7DE4 10 8E            djnz .load_h_loop

 192+ 7E26              ; -------------------------------------------------------------------
 193+ 7E26              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7E26              ; -------------------------------------------------------------------
 195+ 7E26              Enemy_EraseRoom:
 196+ 7E26              Enemy_DrawRoom:
 197+ 7E26              Enemy_RenderRoom:
 198+ 7E26 E5               push hl
 199+ 7E27 D5               push de
 200+ 7E28 C5               push bc
 201+ 7E29 DD E5            push ix
 202+ 7E2B
 203+ 7E2B                  ; ---------------------------------------------------------------
 204+ 7E2B                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7E2B                  ; ---------------------------------------------------------------
 206+ 7E2B DD 21 E8 7C      ld   ix, ActiveEnemies
 207+ 7E2F 06 08            ld   b, 8              ; 8 slot
 208+ 7E31              .erase_loop:
 209+ 7E31 DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E34 E6 80            and  $80               ; Active?
 211+ 7E36 28 3A            jr   z, .next_erase
 212+ 7E38
 213+ 7E38                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E38 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E3B FE FF            cp   $FF
 216+ 7E3D 28 33            jr   z, .next_erase
 217+ 7E3F
 218+ 7E3F                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E3F DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E42 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E45 20 0E            jr   nz, .do_erase_slot
 222+ 7E47 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E4A DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E4D 20 06            jr   nz, .do_erase_slot
 225+ 7E4F
 226+ 7E4F 3A 4A AF         ld   a, (enemy_was_updated)
 227+ 7E52 B7               or   a
 228+ 7E53 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E55
 230+ 7E55              .do_erase_slot:
 231+ 7E55 C5               push bc                ; Salva contatore ciclo
 232+ 7E56
 233+ 7E56                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E56 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E59 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E5C CD 02 7E         call CheckEnemyWillyOverlap
 237+ 7E5F
 238+ 7E5F                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E5F DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E62 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7E65 CD BD 5F         call Gfx_ErasePixelSprite16x16
 242+ 7E68 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E6B DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E6E CD BC 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E71
 246+ 7E71 C1               pop  bc
 247+ 7E72
 248+ 7E72              .next_erase:
 249+ 7E72 11 0B 00         ld   de, 11
 250+ 7E75 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7E77 05               dec  b
 252+ 7E78 20 B7            jr   nz, .erase_loop
 253+ 7E7A
 254+ 7E7A                  ; ---------------------------------------------------------------
 255+ 7E7A                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7E7A                  ; ---------------------------------------------------------------
 257+ 7E7A DD 21 E8 7C      ld   ix, ActiveEnemies
 258+ 7E7E 06 08            ld   b, 8              ; 8 slot
 259+ 7E80              .draw_loop:
 260+ 7E80 DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7E83 E6 80            and  $80               ; Active?
 262+ 7E85 28 37            jr   z, .next_draw
 263+ 7E87
 264+ 7E87                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E87 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E8A FE FF            cp   $FF
 267+ 7E8C 28 16            jr   z, .do_draw_slot
 268+ 7E8E
 269+ 7E8E                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E8E DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E91 DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E94 20 0E            jr   nz, .do_draw_slot
 273+ 7E96 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E99 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E9C 20 06            jr   nz, .do_draw_slot
 276+ 7E9E
 277+ 7E9E 3A 4A AF         ld   a, (enemy_was_updated)
 278+ 7EA1 B7               or   a
 279+ 7EA2 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7EA4
 281+ 7EA4              .do_draw_slot:
 282+ 7EA4 C5               push bc                ; Salva contatore ciclo
 283+ 7EA5
 284+ 7EA5                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7EA5 CD D0 7E         call Enemy_DrawSingleSlot
 286+ 7EA8
 287+ 7EA8                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 288+ 7EA8 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 289+ 7EAB DD 46 03         ld   b, (ix+3)         ; B = Current Y
 290+ 7EAE CD 02 7E         call CheckEnemyWillyOverlap
 291+ 7EB1
 292+ 7EB1                  ; Salva le coordinate effettivamente disegnate
 293+ 7EB1 DD 7E 02         ld   a, (ix+2)
 294+ 7EB4 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7EB7 DD 7E 03         ld   a, (ix+3)
 296+ 7EBA DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7EBD
 298+ 7EBD C1               pop  bc
 299+ 7EBE
 300+ 7EBE              .next_draw:
 301+ 7EBE 11 0B 00         ld   de, 11
 302+ 7EC1 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7EC3 05               dec  b
 304+ 7EC4 20 BA            jr   nz, .draw_loop
 305+ 7EC6
 306+ 7EC6 AF               xor  a
 307+ 7EC7 32 4A AF         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 308+ 7ECA
 309+ 7ECA DD E1            pop  ix
 310+ 7ECC C1               pop  bc
 311+ 7ECD D1               pop  de
 312+ 7ECE E1               pop  hl
 313+ 7ECF C9               ret

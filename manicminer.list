  36+ 7968 D5               push de
  37+ 7969 C5               push bc
  38+ 796A DD E5            push ix
  39+ 796C
  40+ 796C                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 796C 21 0F 79         ld   hl, ActiveEnemies
  42+ 796F 11 10 79         ld   de, ActiveEnemies + 1
  43+ 7972 36 00            ld   (hl), 0
  44+ 7974 01 57 00         ld   bc, 87
  45+ 7977 ED B0            ldir
  46+ 7979
  47+ 7979                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7979 DD 21 0F 79      ld   ix, ActiveEnemies
  49+ 797D 06 08            ld   b, 8
  50+ 797F 11 0B 00         ld   de, 11

 636+ 82BF 3A 5F A4         ld   a, (player_score + 1)
 637+ 82C2 C6 01            add  a, $01
 638+ 82C4 27               daa
 639+ 82C5 32 5F A4         ld   (player_score + 1), a
 640+ 82C8

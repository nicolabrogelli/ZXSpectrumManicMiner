 287  84A1              ; ShowTitleScreen
 288  84A1              ; Visualizza la schermata iniziale del gioco (Title Screen).
 289  84A1              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 290  84A1              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 291  84A1              ; -------------------------------------------------------------------
 292  84A1              ShowTitleScreen:
 293  84A1                  ; 1. Disegna la schermata iniziale
 294  84A1 CD E2 63         call Gfx_DrawTitleScreen
 295  84A4
 296  84A4                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 297  84A4              .wait_title_enter_release:
 298  84A4 76               halt
 299  84A5 3E BF            ld   a, $bf
 300  84A7 DB FE            in   a, ($fe)
 301  84A9 1F               rra
 302  84AA 30 F8            jr   nc, .wait_title_enter_release
 303  84AC
 304  84AC                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 305  84AC 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 306  84AE              .title_loop:
 307  84AE 76               halt
 308  84AF
 309  84AF                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 310  84AF 0C               inc  c
 311  84B0 79               ld   a, c
 312  84B1 CB 3F            srl  a
 313  84B3 CB 3F            srl  a
 314  84B5 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 315  84B7 E6 07            and  7
 316  84B9 5F               ld   e, a
 317  84BA 16 00            ld   d, 0
 318  84BC 21 DA 63         ld   hl, title_color_table
 319  84BF 19               add  hl, de
 320  84C0 7E               ld   a, (hl)               ; A = nuovo colore
 321  84C1 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 322  84C4 06 20            ld   b, 32
 323  84C6              .color_title_loop:
 324  84C6 77               ld   (hl), a
 325  84C7 23               inc  hl
 326  84C8 10 FC            djnz .color_title_loop
 327  84CA
 328  84CA                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 329  84CA 3E BF            ld   a, $bf
 330  84CC DB FE            in   a, ($fe)
 331  84CE 1F               rra
 332  84CF 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 333  84D1
 334  84D1                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 335  84D1              .wait_title_enter_release_after:
 336  84D1 76               halt
 337  84D2 3E BF            ld   a, $bf
 338  84D4 DB FE            in   a, ($fe)
 339  84D6 1F               rra
 340  84D7 30 F8            jr   nc, .wait_title_enter_release_after
 341  84D9
 342  84D9                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 343  84D9 AF               xor  a
 344  84DA D3 FE            out  ($fe), a              ; Bordo a nero
 345  84DC 21 8D 5C         ld   hl, ATTR_P
 346  84DF 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 347  84E0 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  84E3 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 349  84E5 3E 07            ld   a, $07
 350  84E7 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 351  84EA
 352  84EA                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 353  84EA CD 5F 87         call ResetFullGameState
 354  84ED
 355  84ED                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 356  84ED C3 72 83         jp   LoadRoomAndRestart
 357  84F0
 358  84F0              ; -------------------------------------------------------------------
 359  84F0              ; TriggerGameOver
 360  84F0              ; Scatena la schermata di Game Over per la stanza corrente.
 361  84F0              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 362  84F0              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 363  84F0              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 364  84F0              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 365  84F0              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 366  84F0              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 367  84F0              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 368  84F0              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 369  84F0              ; -------------------------------------------------------------------
 370  84F0              TriggerGameOver:
 371  84F0                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 372  84F0 CD C3 65         call Gfx_DrawGameOverScreen

 106+ 8072              ; Items_ResetCurrentRoomItems
 107+ 8072              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
 108+ 8072              ; per tutti gli item della stanza corrente puntata da (room_ptr).
 109+ 8072              ; -------------------------------------------------------------------
 110+ 8072              Items_ResetCurrentRoomItems:
 111+ 8072 E5               push hl
 112+ 8073 D5               push de
 113+ 8074 F5               push af
 114+ 8075
 115+ 8075 2A 89 99         ld   hl, (room_ptr)
 116+ 8078 11 75 02         ld   de, OFFSET_ITEMS
 117+ 807B 19               add  hl, de
 118+ 807C
 119+ 807C              .item_loop:

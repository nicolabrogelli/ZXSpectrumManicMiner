 470+ 7D22 DD 77 03         ld   (ix+3), a
 471+ 7D25 3E 02            ld   a, 2
 472+ 7D27 DD 77 06         ld   (ix+6), a
 473+ 7D2A C3 4A 7D         jp   .next
 474+ 7D2D
 475+ 7D2D              .vert_down:

 414+ 8566              ; CheckWillyItemCollision
 415+ 8566              ;
 416+ 8566              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 8566              ; Input:
 418+ 8566              ;   A = Item Col (0..31)
 419+ 8566              ;   H = Item Row (0..15)
 420+ 8566              ; Output:
 421+ 8566              ;   Carry Set = Collisione
 422+ 8566              ;   Carry Clear = Nessuna collisione
 423+ 8566              ; -------------------------------------------------------------------
 424+ 8566              CheckWillyItemCollision:
 425+ 8566 C5               push bc
 426+ 8567 D5               push de
 427+ 8568 E5               push hl
 428+ 8569
 429+ 8569                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8569 6F               ld   l, a
 431+ 856A 87               add  a, a                      ; *2
 432+ 856B 87               add  a, a                      ; *4
 433+ 856C 87               add  a, a                      ; *8
 434+ 856D 5F               ld   e, a                      ; E = ItemLeft
 435+ 856E C6 07            add  a, 7
 436+ 8570 57               ld   d, a                      ; D = ItemRight
 437+ 8571
 438+ 8571 ED 4B A9 E1      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 8575
 440+ 8575                  ; WillyLeft <= ItemRight
 441+ 8575 79               ld   a, c                      ; A = WillyX

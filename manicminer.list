2041+ 7DF5                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2042+ 7DF5 3A C8 EB         ld   a, (PlayerPos)        ; A = PlayerX
2043+ 7DF8 CB 3F            srl  a
2043+ 7DFA CB 3F          srl  a
2043+ 7DFC CB 3F          srl  a   ; A = Col1

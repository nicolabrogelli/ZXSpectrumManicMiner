  72+ 85E1 ~            ; Audio_UpdateMusic
  73+ 85E1 ~            ;
  74+ 85E1 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 85E1 ~            ; Viene chiamata a ogni frame.
  76+ 85E1 ~            ; -------------------------------------------------------------------
  77+ 85E1 ~            Audio_UpdateMusic:
  78+ 85E1 ~                push af
  79+ 85E1 ~                push bc
  80+ 85E1 ~                push de
  81+ 85E1 ~                push hl
  82+ 85E1 ~
  83+ 85E1 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 85E1 ~                ld   a, (Audio_jump_sound_note)
  85+ 85E1 ~                cp   18
  86+ 85E1 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 85E1 ~
  88+ 85E1 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 85E1 ~                ld   a, (Audio_music_frame_counter)
  90+ 85E1 ~                dec  a
  91+ 85E1 ~                ld   (Audio_music_frame_counter), a
  92+ 85E1 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 85E1 ~
  94+ 85E1 ~                ; Altrimenti carica la nota successiva
  95+ 85E1 ~                ld   a, (Audio_music_note_idx)
  96+ 85E1 ~                inc  a
  97+ 85E1 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 85E1 ~                jr   c, .no_wrap
  99+ 85E1 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 85E1 ~            .no_wrap:
 101+ 85E1 ~                ld   (Audio_music_note_idx), a
 102+ 85E1 ~
 103+ 85E1 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 85E1 ~                ld   e, a
 105+ 85E1 ~                ld   d, 0
 106+ 85E1 ~                ld   hl, Audio_MusicSheet
 107+ 85E1 ~                add  hl, de
 108+ 85E1 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 85E1 ~
 110+ 85E1 ~                ; Leggi durata (secondo byte)
 111+ 85E1 ~                inc  hl
 112+ 85E1 ~                ld   a, (hl)
 113+ 85E1 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 85E1 ~                jr   nz, .dur_ok
 115+ 85E1 ~                ld   a, 1
 116+ 85E1 ~            .dur_ok:
 117+ 85E1 ~                ld   (Audio_music_frame_counter), a
 118+ 85E1 ~
 119+ 85E1 ~            .play_current_note:
 120+ 85E1 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 85E1 ~                ld   a, (Audio_music_note_idx)
 122+ 85E1 ~                ld   e, a
 123+ 85E1 ~                ld   d, 0
 124+ 85E1 ~                ld   hl, Audio_MusicSheet
 125+ 85E1 ~                add  hl, de
 126+ 85E1 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 85E1 ~                ld   a, (hl)                  ; A = delay
 128+ 85E1 ~                or   a
 129+ 85E1 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 85E1 ~
 131+ 85E1 ~                ; Suona la nota: 2 cicli
 132+ 85E1 ~                ld   d, a                     ; D = delay
 133+ 85E1 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 85E1 ~            .note_loop:
 135+ 85E1 ~                ; Speaker ON
 136+ 85E1 ~                ld   a, (room_border_color)
 137+ 85E1 ~                or   $10
 138+ 85E1 ~                out  ($fe), a
 139+ 85E1 ~                ld   c, d
 140+ 85E1 ~            .d1:
 141+ 85E1 ~                push af
 142+ 85E1 ~                pop  af
 143+ 85E1 ~                dec  c
 144+ 85E1 ~                jr   nz, .d1
 145+ 85E1 ~
 146+ 85E1 ~                ; Speaker OFF
 147+ 85E1 ~                ld   a, (room_border_color)
 148+ 85E1 ~                and  $ef
 149+ 85E1 ~                out  ($fe), a
 150+ 85E1 ~                ld   c, d
 151+ 85E1 ~            .d2:
 152+ 85E1 ~                push af
 153+ 85E1 ~                pop  af
 154+ 85E1 ~                dec  c
 155+ 85E1 ~                jr   nz, .d2
 156+ 85E1 ~
 157+ 85E1 ~                djnz .note_loop
 158+ 85E1 ~
 159+ 85E1 ~            .done:
 160+ 85E1 ~                pop  hl
 161+ 85E1 ~                pop  de
 162+ 85E1 ~                pop  bc
 163+ 85E1 ~                pop  af
 164+ 85E1 ~                ret
 165+ 85E1 ~
 166+ 85E1 ~            Audio_MusicSheet:
 167+ 85E1 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 85E1 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 85E1 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 85E1 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 85E1 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 85E1 ~                db 90, 10, 107, 20, 68, 65

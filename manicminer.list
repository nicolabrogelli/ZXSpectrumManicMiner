  51+ 7C65 32 1F 91         ld   (current_room), a
  52+ 7C68
  53+ 7C68 C1               pop  bc
  54+ 7C69 D1               pop  de
  55+ 7C6A E1               pop  hl
  56+ 7C6B C9               ret

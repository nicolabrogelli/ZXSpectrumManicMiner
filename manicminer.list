  72+ 844D ~            ; Audio_UpdateMusic
  73+ 844D ~            ;
  74+ 844D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 844D ~            ; Viene chiamata a ogni frame.
  76+ 844D ~            ; -------------------------------------------------------------------
  77+ 844D ~            Audio_UpdateMusic:
  78+ 844D ~                push af
  79+ 844D ~                push bc
  80+ 844D ~                push de
  81+ 844D ~                push hl
  82+ 844D ~
  83+ 844D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 844D ~                ld   a, (Audio_jump_sound_note)
  85+ 844D ~                cp   18
  86+ 844D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 844D ~
  88+ 844D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 844D ~                ld   a, (Audio_music_frame_counter)
  90+ 844D ~                dec  a
  91+ 844D ~                ld   (Audio_music_frame_counter), a
  92+ 844D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 844D ~
  94+ 844D ~                ; Altrimenti carica la nota successiva
  95+ 844D ~                ld   a, (Audio_music_note_idx)
  96+ 844D ~                inc  a
  97+ 844D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 844D ~                jr   c, .no_wrap
  99+ 844D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 844D ~            .no_wrap:
 101+ 844D ~                ld   (Audio_music_note_idx), a
 102+ 844D ~
 103+ 844D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 844D ~                ld   e, a
 105+ 844D ~                ld   d, 0
 106+ 844D ~                ld   hl, Audio_MusicSheet
 107+ 844D ~                add  hl, de
 108+ 844D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 844D ~
 110+ 844D ~                ; Leggi durata (secondo byte)
 111+ 844D ~                inc  hl
 112+ 844D ~                ld   a, (hl)
 113+ 844D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 844D ~                jr   nz, .dur_ok
 115+ 844D ~                ld   a, 1
 116+ 844D ~            .dur_ok:
 117+ 844D ~                ld   (Audio_music_frame_counter), a

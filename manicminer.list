 242+ 5EB4                  ; 5b. Controlla se la cella (Row E, Col C) appartiene al Portale (16x16 pixel a OFFSET_PORTAL = 655)
 243+ 5EB4 3A E7 F1         ld   a, (portal_row)
 244+ 5EB7 67               ld   h, a                  ; H = PortalRow (0..15)

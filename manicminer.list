 665+ 857E              ; -------------------------------------------------------------------
 666+ 857E              ; Score_CheckAndUpdateHighScore
 667+ 857E              ; Se player_score > high_score, copia player_score in high_score.
 668+ 857E              ; -------------------------------------------------------------------
 669+ 857E              Score_CheckAndUpdateHighScore:
 670+ 857E                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 671+ 857E                  ; Byte 2:
 672+ 857E 3A CE E6         ld   a, (player_score + 2)
 673+ 8581 47               ld   b, a
 674+ 8582 3A D1 E6         ld   a, (high_score + 2)
 675+ 8585 B8               cp   b
 676+ 8586 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 677+ 8588 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 678+ 858A
 679+ 858A                  ; Byte 1:
 680+ 858A 3A CD E6         ld   a, (player_score + 1)
 681+ 858D 47               ld   b, a
 682+ 858E 3A D0 E6         ld   a, (high_score + 1)
 683+ 8591 B8               cp   b
 684+ 8592 38 0C            jr   c, .new_high_score
 685+ 8594 20 1C            jr   nz, .done_check
 686+ 8596
 687+ 8596                  ; Byte 0:
 688+ 8596 3A CC E6         ld   a, (player_score + 0)
 689+ 8599 47               ld   b, a
 690+ 859A 3A CF E6         ld   a, (high_score + 0)
 691+ 859D B8               cp   b
 692+ 859E 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 693+ 85A0
 694+ 85A0              .new_high_score:
 695+ 85A0 3A CC E6         ld   a, (player_score + 0)
 696+ 85A3 32 CF E6         ld   (high_score + 0), a
 697+ 85A6 3A CD E6         ld   a, (player_score + 1)
 698+ 85A9 32 D0 E6         ld   (high_score + 1), a
 699+ 85AC 3A CE E6         ld   a, (player_score + 2)
 700+ 85AF 32 D1 E6         ld   (high_score + 2), a
 701+ 85B2
 702+ 85B2              .done_check:
 703+ 85B2 C9               ret

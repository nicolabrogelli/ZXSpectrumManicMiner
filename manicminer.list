 642+ 6083 ED 43 F1 91      ld   (player_drawn_pos), bc
 643+ 6087 3A F3 8D         ld   a, (direction)
 644+ 608A 32 F3 91         ld   (player_old_dir), a
 645+ 608D 3A F2 8D         ld   a, (body_state)
 646+ 6090 32 F4 91         ld   (player_old_body), a

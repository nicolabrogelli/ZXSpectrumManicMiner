 867+ 616B 20 05            jr   nz, .not_empty        ; Se != 0, contiene un tile (Floor, Wall, Crumbling, Conveyor, Nasty...)
 868+ 616D
 869+ 616D                  ; La cella è completamente vuota!
 870+ 616D C1               pop  bc
 871+ 616E D1               pop  de
 872+ 616F E1               pop  hl

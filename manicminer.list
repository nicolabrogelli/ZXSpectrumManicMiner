 690+ 82D4 32 1B 9C         ld   (high_score + 0), a
 691+ 82D7 3A 19 9C         ld   a, (player_score + 1)
 692+ 82DA 32 1C 9C         ld   (high_score + 1), a
 693+ 82DD 3A 1A 9C         ld   a, (player_score + 2)
 694+ 82E0 32 1D 9C         ld   (high_score + 2), a
 695+ 82E3

2204+ 6937 C6 30            add  a, '0'
2205+ 6939 77               ld   (hl), a
2206+ 693A 23               inc  hl
2207+ 693B
2208+ 693B                  ; Cifra 3 (centinaia)
2209+ 693B DD 7E 01         ld   a, (ix+1)
2210+ 693E E6 0F            and  $0f
2211+ 6940 C6 30            add  a, '0'
2212+ 6942 77               ld   (hl), a
2213+ 6943 23               inc  hl
2214+ 6944
2215+ 6944                  ; Cifra 4 (decine)

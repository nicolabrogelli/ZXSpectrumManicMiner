1886+ 7BDA 7E               ld   a, (hl)
1887+ 7BDB FE 08            cp   8
1888+ 7BDD 38 12            jr   c, .done_advance
1889+ 7BDF
1890+ 7BDF                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
1891+ 7BDF 68               ld   l, b                  ; L = Row
1892+ 7BE0 26 00            ld   h, 0
1893+ 7BE2 29               add  hl, hl
1893+ 7BE3 29             add hl, hl
1893+ 7BE4 29             add hl, hl
1893+ 7BE5 29             add hl, hl
1893+ 7BE6 29             add hl, hl
1894+ 7BE7 59               ld   e, c
1895+ 7BE8 16 00            ld   d, 0
1896+ 7BEA 19               add  hl, de
1897+ 7BEB 11 B0 E2         ld   de, unpacked_layout
1898+ 7BEE 19               add  hl, de
1899+ 7BEF 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
1900+ 7BF1
1901+ 7BF1              .done_advance:
1902+ 7BF1 E1               pop  hl
1903+ 7BF2 D1               pop  de
1904+ 7BF3 C1               pop  bc
1905+ 7BF4 C9               ret

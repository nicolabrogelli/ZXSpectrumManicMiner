   8+ 7FD1              ; Audio_UpdateJumpSound
   9+ 7FD1              ;
  10+ 7FD1              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7FD1              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7FD1              ; -------------------------------------------------------------------
  13+ 7FD1              Audio_UpdateJumpSound:
  14+ 7FD1 F5               push af
  15+ 7FD2 C5               push bc
  16+ 7FD3 D5               push de
  17+ 7FD4 E5               push hl
  18+ 7FD5
  19+ 7FD5                  ; Controlla se il suono è attivo (note < 18)
  20+ 7FD5 3A 86 95         ld   a, (Audio_jump_sound_note)
  21+ 7FD8 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7FDA 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7FDC
  24+ 7FDC                  ; Carica la nota corrente da suonare
  25+ 7FDC 5F               ld   e, a
  26+ 7FDD 16 00            ld   d, 0
  27+ 7FDF 21 0B 80         ld   hl, Audio_JumpSoundDelays
  28+ 7FE2 19               add  hl, de
  29+ 7FE3 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7FE4 57               ld   d, a                      ; D = delay della nota
  31+ 7FE5
  32+ 7FE5                  ; Suona la nota: 15 cicli
  33+ 7FE5 06 0F            ld   b, 15
  34+ 7FE7              .note_loop:
  35+ 7FE7                  ; Speaker ON
  36+ 7FE7 3A 7D 8F         ld   a, (room_border_color)
  37+ 7FEA F6 10            or   $10
  38+ 7FEC D3 FE            out  ($fe), a
  39+ 7FEE 4A               ld   c, d
  40+ 7FEF              .d1:
  41+ 7FEF 0D               dec  c
  42+ 7FF0 20 FD            jr   nz, .d1
  43+ 7FF2
  44+ 7FF2                  ; Speaker OFF
  45+ 7FF2 3A 7D 8F         ld   a, (room_border_color)
  46+ 7FF5 E6 EF            and  $ef
  47+ 7FF7 D3 FE            out  ($fe), a
  48+ 7FF9 4A               ld   c, d
  49+ 7FFA              .d2:
  50+ 7FFA 0D               dec  c
  51+ 7FFB 20 FD            jr   nz, .d2
  52+ 7FFD
  53+ 7FFD 10 E8            djnz .note_loop
  54+ 7FFF
  55+ 7FFF                  ; Passa alla nota successiva
  56+ 7FFF 3A 86 95         ld   a, (Audio_jump_sound_note)
  57+ 8002 3C               inc  a
  58+ 8003 32 86 95         ld   (Audio_jump_sound_note), a
  59+ 8006
  60+ 8006              .done:
  61+ 8006 E1               pop  hl
  62+ 8007 D1               pop  de
  63+ 8008 C1               pop  bc
  64+ 8009 F1               pop  af
  65+ 800A C9               ret
  66+ 800B
  67+ 800B              Audio_JumpSoundDelays:
  68+ 800B 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 800F 19 13 0C 06
  68+ 8013 0C 13 19 20
  68+ 8017 26 2D 33 3A
  68+ 801B 40 47
  69+ 801D
  70+ 801D                  IF ENABLE_MUSIC != 0
  71+ 801D ~            ; -------------------------------------------------------------------
  72+ 801D ~            ; Audio_UpdateMusic
  73+ 801D ~            ;
  74+ 801D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 801D ~            ; Viene chiamata a ogni frame.
  76+ 801D ~            ; -------------------------------------------------------------------
  77+ 801D ~            Audio_UpdateMusic:
  78+ 801D ~                push af
  79+ 801D ~                push bc
  80+ 801D ~                push de
  81+ 801D ~                push hl
  82+ 801D ~
  83+ 801D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 801D ~                ld   a, (Audio_jump_sound_note)
  85+ 801D ~                cp   18
  86+ 801D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 801D ~
  88+ 801D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 801D ~                ld   a, (Audio_music_frame_counter)
  90+ 801D ~                dec  a
  91+ 801D ~                ld   (Audio_music_frame_counter), a
  92+ 801D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 801D ~
  94+ 801D ~                ; Altrimenti carica la nota successiva
  95+ 801D ~                ld   a, (Audio_music_note_idx)
  96+ 801D ~                inc  a
  97+ 801D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 801D ~                jr   c, .no_wrap
  99+ 801D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 801D ~            .no_wrap:
 101+ 801D ~                ld   (Audio_music_note_idx), a
 102+ 801D ~
 103+ 801D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 801D ~                ld   e, a
 105+ 801D ~                ld   d, 0
 106+ 801D ~                ld   hl, Audio_MusicSheet
 107+ 801D ~                add  hl, de
 108+ 801D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 801D ~
 110+ 801D ~                ; Leggi durata (secondo byte)
 111+ 801D ~                inc  hl
 112+ 801D ~                ld   a, (hl)
 113+ 801D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 801D ~                jr   nz, .dur_ok
 115+ 801D ~                ld   a, 1
 116+ 801D ~            .dur_ok:
 117+ 801D ~                ld   (Audio_music_frame_counter), a
 118+ 801D ~
 119+ 801D ~            .play_current_note:
 120+ 801D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 801D ~                ld   a, (Audio_music_note_idx)
 122+ 801D ~                ld   e, a
 123+ 801D ~                ld   d, 0
 124+ 801D ~                ld   hl, Audio_MusicSheet
 125+ 801D ~                add  hl, de
 126+ 801D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 801D ~                ld   a, (hl)                  ; A = delay
 128+ 801D ~                or   a
 129+ 801D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 801D ~
 131+ 801D ~                ; Suona la nota: 2 cicli
 132+ 801D ~                ld   d, a                     ; D = delay
 133+ 801D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 801D ~            .note_loop:
 135+ 801D ~                ; Speaker ON
 136+ 801D ~                ld   a, (room_border_color)
 137+ 801D ~                or   $10
 138+ 801D ~                out  ($fe), a
 139+ 801D ~                ld   c, d
 140+ 801D ~            .d1:
 141+ 801D ~                push af
 142+ 801D ~                pop  af
 143+ 801D ~                dec  c
 144+ 801D ~                jr   nz, .d1
 145+ 801D ~
 146+ 801D ~                ; Speaker OFF
 147+ 801D ~                ld   a, (room_border_color)
 148+ 801D ~                and  $ef
 149+ 801D ~                out  ($fe), a
 150+ 801D ~                ld   c, d
 151+ 801D ~            .d2:
 152+ 801D ~                push af
 153+ 801D ~                pop  af
 154+ 801D ~                dec  c
 155+ 801D ~                jr   nz, .d2
 156+ 801D ~
 157+ 801D ~                djnz .note_loop
 158+ 801D ~
 159+ 801D ~            .done:
 160+ 801D ~                pop  hl
 161+ 801D ~                pop  de
 162+ 801D ~                pop  bc
 163+ 801D ~                pop  af
 164+ 801D ~                ret
 165+ 801D ~
 166+ 801D ~            Audio_MusicSheet:
 167+ 801D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 801D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 801D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 801D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 801D ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 801D ~                db 90, 10, 107, 20, 68, 65
 173+ 801D                  ELSE
 174+ 801D              Audio_UpdateMusic:
 175+ 801D C9               ret
 176+ 801E                  ENDIF
 177+ 801E
 178+ 801E              ; -------------------------------------------------------------------
 179+ 801E              ; Audio_PlayCollectSound
 180+ 801E              ;
 181+ 801E              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 801E              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 801E              ; -------------------------------------------------------------------
 184+ 801E              Audio_PlayCollectSound:
 185+ 801E C5               push bc
 186+ 801F D5               push de
 187+ 8020
 188+ 8020 06 78            ld   b, 120
 189+ 8022              .sound_loop:
 190+ 8022 3A 7D 8F         ld   a, (room_border_color)
 191+ 8025 F6 10            or   $10               ; speaker ON
 192+ 8027 D3 FE            out  ($fe), a
 193+ 8029
 194+ 8029 0E 3C            ld   c, 60
 195+ 802B              .d1:
 196+ 802B 0D               dec  c
 197+ 802C 20 FD            jr   nz, .d1
 198+ 802E
 199+ 802E 3A 7D 8F         ld   a, (room_border_color)
 200+ 8031 E6 EF            and  $ef              ; speaker OFF
 201+ 8033 D3 FE            out  ($fe), a
 202+ 8035
 203+ 8035 0E 3C            ld   c, 60
 204+ 8037              .d2:
 205+ 8037 0D               dec  c
 206+ 8038 20 FD            jr   nz, .d2
 207+ 803A
 208+ 803A 10 E6            djnz .sound_loop
 209+ 803C
 210+ 803C D1               pop  de
 211+ 803D C1               pop  bc
 212+ 803E C9               ret
 213+ 803F

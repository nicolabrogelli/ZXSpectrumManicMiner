 448+ 7F37              ; Enemy_DrawSingleSlot
 449+ 7F37              ;
 450+ 7F37              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 451+ 7F37              ; La grafica (8 frame da 32 byte) è letta direttamente da
 452+ 7F37              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 453+ 7F37              ; -------------------------------------------------------------------
 454+ 7F37              Enemy_DrawSingleSlot:
 455+ 7F37 C5               push bc
 456+ 7F38 D5               push de
 457+ 7F39 E5               push hl
 458+ 7F3A DD E5            push ix
 459+ 7F3C
 460+ 7F3C                  ; 1. Salva subito le coordinate X e Y dal record IX

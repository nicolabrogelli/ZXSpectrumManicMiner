 581  82BE 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 582  82C1 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 583  82C3              .color_cycle_loop:

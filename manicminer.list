 664  820A              ; 2. Willy collide con il portale attivo.
 665  820A              ; -------------------------------------------------------------------
 666  820A              CheckVictoryCondition:
 667  820A C5               push bc
 668  820B D5               push de
 669  820C E5               push hl
 670  820D
 671  820D                  ; 1. Tutti gli item raccolti?

 481  895E 32 F5 E1         ld   (flags), a
 482  8961 32 EF E5         ld   (ramp_entry_guard), a
 483  8964 32 FB E5         ld   (willy_on_ramp), a
 484  8967 32 FA E5         ld   (willy_needs_redraw), a
 485  896A 3E FF            ld   a, $ff
 486  896C 32 0B E2         ld   (digit_key_prev), a
 487  896F 32 F4 E5         ld   (player_drawn_pos+1), a
 488  8972 32 F5 E5         ld   (player_old_dir), a
 489  8975 32 F6 E5         ld   (player_old_body), a
 490  8978 3E 01            ld   a, 1
 491  897A 32 04 E2         ld   (q_prev), a
 492  897D 32 05 E2         ld   (a_prev), a
 493  8980 32 FC E1         ld   (on_ground), a
 494  8983 32 F7 E5         ld   (enemy_was_updated), a
 495  8986
 496  8986                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 497  8986 3E 00            ld   a, RESPAWN_SAFETY_TIME
 498  8988 32 F9 E5         ld   (willy_safety_timer), a
 499  898B
 500  898B                  ; - Ripristina lo stato audio
 501  898B 3E 12            ld   a, 18
 502  898D 32 0C E8         ld   (Audio_jump_sound_note), a
 503  8990 AF               xor  a
 504  8991 32 0D E8         ld   (Audio_jump_sound_timer), a
 505  8994                  IF ENABLE_MUSIC != 0
 506  8994 ~                ld   (Audio_music_note_idx), a
 507  8994 ~                ld   a, 1
 508  8994 ~                ld   (Audio_music_frame_counter), a
 509  8994                  ENDIF
 510  8994
 511  8994                  ; - Riposiziona Willy nel punto di default definito nella stanza
 512  8994 AF               xor  a
 513  8995 32 74 E5         ld   (transition_active), a
 514  8998
 515  8998                  ; - Cancella lo schermo a nero prima del caricamento
 516  8998 AF               xor  a
 517  8999 D3 FE            out  ($fe), a
 518  899B CD 9D 62         call Gfx_ClearScreenDirect
 519  899E
 520  899E                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 521  899E C3 3C 87         jp   LoadRoomAndRestart
 522  89A1
 523  89A1              ; -------------------------------------------------------------------
 524  89A1              ; TriggerVictory
 525  89A1              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 526  89A1              ; - Pulisce gli elementi di gioco della stanza.
 527  89A1              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 528  89A1              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 529  89A1              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 530  89A1              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 531  89A1              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 532  89A1              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 533  89A1              ; -------------------------------------------------------------------
 534  89A1              TriggerVictory:
 535  89A1                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 536  89A1 CD F7 66         call Gfx_DrawVictoryScreen
 537  89A4
 538  89A4                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 539  89A4              .wait_keys_release:
 540  89A4 76               halt
 541  89A5                  ; Controlla tasto Y (Porta $DF, bit 4)
 542  89A5 01 FE DF         ld   bc, $dffe
 543  89A8 ED 78            in   a, (c)
 544  89AA CB 67            bit  4, a
 545  89AC 28 F6            jr   z, .wait_keys_release
 546  89AE
 547  89AE                  ; Controlla tasto N (Porta $7F, bit 3)
 548  89AE 01 FE 7F         ld   bc, $7ffe
 549  89B1 ED 78            in   a, (c)
 550  89B3 CB 5F            bit  3, a
 551  89B5 28 ED            jr   z, .wait_keys_release
 552  89B7
 553  89B7                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 554  89B7 01 FE BF         ld   bc, $bffe
 555  89BA ED 78            in   a, (c)
 556  89BC CB 47            bit  0, a
 557  89BE 28 E4            jr   z, .wait_keys_release
 558  89C0
 559  89C0                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 560  89C0 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 561  89C2              .wait_choice_loop:
 562  89C2 76               halt
 563  89C3
 564  89C3                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 565  89C3 0C               inc  c
 566  89C4 79               ld   a, c
 567  89C5 CB 3F            srl  a
 568  89C7 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 569  89C9 E6 07            and  7
 570  89CB 5F               ld   e, a
 571  89CC 16 00            ld   d, 0
 572  89CE 21 11 66         ld   hl, victory_color_table
 573  89D1 19               add  hl, de
 574  89D2 7E               ld   a, (hl)               ; A = nuovo colore attributo
 575  89D3 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 576  89D6 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 577  89D8              .color_cycle_loop:
 578  89D8 77               ld   (hl), a
 579  89D9 23               inc  hl
 580  89DA 10 FC            djnz .color_cycle_loop
 581  89DC
 582  89DC                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 583  89DC 01 FE DF         ld   bc, $dffe
 584  89DF ED 78            in   a, (c)
 585  89E1 CB 67            bit  4, a
 586  89E3 28 2A            jr   z, .play_again_chosen
 587  89E5
 588  89E5                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 589  89E5 01 FE 7F         ld   bc, $7ffe
 590  89E8 ED 78            in   a, (c)
 591  89EA CB 5F            bit  3, a
 592  89EC 28 0B            jr   z, .quit_chosen
 593  89EE
 594  89EE                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 595  89EE 01 FE BF         ld   bc, $bffe
 596  89F1 ED 78            in   a, (c)
 597  89F3 CB 47            bit  0, a
 598  89F5 28 02            jr   z, .quit_chosen
 599  89F7
 600  89F7 18 C9            jr   .wait_choice_loop
 601  89F9
 602  89F9              .quit_chosen:
 603  89F9                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 604  89F9              .wait_quit_release:
 605  89F9 76               halt
 606  89FA 01 FE 7F         ld   bc, $7ffe
 607  89FD ED 78            in   a, (c)
 608  89FF CB 5F            bit  3, a
 609  8A01 28 F6            jr   z, .wait_quit_release
 610  8A03 01 FE BF         ld   bc, $bffe
 611  8A06 ED 78            in   a, (c)
 612  8A08 CB 47            bit  0, a
 613  8A0A 28 ED            jr   z, .wait_quit_release
 614  8A0C
 615  8A0C                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 616  8A0C C3 75 88         jp   ShowTitleScreen
 617  8A0F
 618  8A0F              .play_again_chosen:
 619  8A0F                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 620  8A0F              .wait_play_again_release:
 621  8A0F 76               halt
 622  8A10 01 FE DF         ld   bc, $dffe
 623  8A13 ED 78            in   a, (c)
 624  8A15 CB 67            bit  4, a
 625  8A17 28 F6            jr   z, .wait_play_again_release
 626  8A19
 627  8A19                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 628  8A19 CD 53 8B         call ResetFullGameState
 629  8A1C C3 3C 87         jp   LoadRoomAndRestart
 630  8A1F
 631  8A1F              ; -------------------------------------------------------------------
 632  8A1F              ; CheckPortalTransition
 633  8A1F              ; Verifica le condizioni per accedere alla stanza successiva:
 634  8A1F              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 635  8A1F              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 636  8A1F              ;
 637  8A1F              ; Output:
 638  8A1F              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 639  8A1F              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 640  8A1F              ; -------------------------------------------------------------------
 641  8A1F              CheckPortalTransition:
 642  8A1F C5               push bc
 643  8A20 D5               push de
 644  8A21 E5               push hl
 645  8A22
 646  8A22                  ; 1. Tutti gli item della stanza sono stati raccolti?
 647  8A22 CD E6 8A         call CheckAllItemsCollected
 648  8A25 30 4D            jr   nc, .no_transition
 649  8A27
 650  8A27                  ; 2. Willy collide con il portale (16x16 pixel)?
 651  8A27                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 652  8A27                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 653  8A27 2A 6E E5         ld   hl, (room_ptr)
 654  8A2A 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 655  8A2D 19               add  hl, de
 656  8A2E 4E               ld   c, (hl)
 657  8A2F 23               inc  hl
 658  8A30 46               ld   b, (hl)                   ; BC = AttrAddr
 659  8A31
 660  8A31                  ; Offset = BC - 23552
 661  8A31 60               ld   h, b
 662  8A32 69               ld   l, c
 663  8A33 01 00 A4         ld   bc, -23552
 664  8A36 09               add  hl, bc
 665  8A37
 666  8A37                  ; PortalX = (Offset & 31) * 8
 667  8A37 7D               ld   a, l
 668  8A38 E6 1F            and  31
 669  8A3A 87               add  a, a
 669  8A3B 87             add a, a
 669  8A3C 87             add a, a
 670  8A3D 5F               ld   e, a                      ; E = PortalX (0..248)
 671  8A3E
 672  8A3E                  ; PortalY = (Offset / 32) * 8
 673  8A3E CB 3C            srl  h
 673  8A40 CB 1D          rr l
 674  8A42 CB 3C            srl  h
 674  8A44 CB 1D          rr l
 675  8A46 CB 3C            srl  h
 675  8A48 CB 1D          rr l
 676  8A4A CB 3C            srl  h
 676  8A4C CB 1D          rr l
 677  8A4E CB 3C            srl  h
 677  8A50 CB 1D          rr l
 678  8A52 7D               ld   a, l
 679  8A53 87               add  a, a
 679  8A54 87             add a, a
 679  8A55 87             add a, a
 680  8A56 57               ld   d, a                      ; D = PortalY (0..120)
 681  8A57
 682  8A57                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 683  8A57 ED 4B ED E1      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 684  8A5B
 685  8A5B                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 686  8A5B 7B               ld   a, e
 687  8A5C 91               sub  c
 688  8A5D 30 02            jr   nc, .x_diff_pos
 689  8A5F ED 44            neg
 690  8A61              .x_diff_pos:
 691  8A61 FE 0C            cp   12
 692  8A63 30 0F            jr   nc, .no_transition
 693  8A65
 694  8A65                  ; Controllo verticale: |WillyY - PortalY| < 14
 695  8A65 7A               ld   a, d
 696  8A66 90               sub  b
 697  8A67 30 02            jr   nc, .y_diff_pos
 698  8A69 ED 44            neg
 699  8A6B              .y_diff_pos:
 700  8A6B FE 0E            cp   14
 701  8A6D 30 05            jr   nc, .no_transition
 702  8A6F
 703  8A6F                  ; Transizione al portale attiva!
 704  8A6F E1               pop  hl
 705  8A70 D1               pop  de
 706  8A71 C1               pop  bc
 707  8A72 37               scf
 708  8A73 C9               ret
 709  8A74
 710  8A74              .no_transition:
 711  8A74 E1               pop  hl
 712  8A75 D1               pop  de
 713  8A76 C1               pop  bc
 714  8A77 B7               or   a
 715  8A78 C9               ret
 716  8A79
 717  8A79              ; Alias per retrocompatibilità
 718  8A79              CheckVictoryCondition: EQU CheckPortalTransition
 719  8A79
 720  8A79              ; -------------------------------------------------------------------
 721  8A79              ; TriggerPortalTransition
 722  8A79              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 723  8A79              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 724  8A79              ; - Avanza all'indice della stanza successiva.
 725  8A79              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 726  8A79              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 727  8A79              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 728  8A79              ; -------------------------------------------------------------------
 729  8A79              TriggerPortalTransition:
 730  8A79                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 731  8A79 CD B0 8A         call Air_DepleteCountdown
 732  8A7C
 733  8A7C                  ; 1. Determina l'ID della stanza corrente
 734  8A7C CD B8 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8A7F
 736  8A7F                  ; 2. Calcola l'indice della stanza successiva
 737  8A7F 3A 13 E5         ld   a, (current_room)
 738  8A82 3C               inc  a
 739  8A83 FE 14            cp   NUM_ROOMS
 740  8A85 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8A87
 742  8A87                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8A87 21 19 73         ld   hl, RoomsListTable
 744  8A8A 5F               ld   e, a
 745  8A8B 16 00            ld   d, 0
 746  8A8D 19               add  hl, de
 747  8A8E 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8A8F 5E               ld   e, (hl)
 749  8A90 23               inc  hl
 750  8A91 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8A92 ED 53 6E E5      ld   (room_ptr), de
 752  8A96
 753  8A96                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8A96 AF               xor  a
 755  8A97 32 74 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8A9A 32 FB E1         ld   (velocity_y), a
 757  8A9D 32 06 E8         ld   (game_objective_completed), a
 758  8AA0 3E 01            ld   a, 1
 759  8AA2 32 FC E1         ld   (on_ground), a
 760  8AA5
 761  8AA5                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8AA5 3E 07            ld   a, $07
 763  8AA7 CD 9D 62         call Gfx_ClearScreenDirect
 764  8AAA
 765  8AAA C3 3C 87         jp   LoadRoomAndRestart
 766  8AAD
 767  8AAD              .all_rooms_completed:
 768  8AAD                  ; Tutte le stanze sono state completate con successo!
 769  8AAD                  IF ENABLE_VICTORY_SCREEN != 0
 770  8AAD C3 A1 89         jp   TriggerVictory
 771  8AB0                  ELSE
 772  8AB0 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8AB0 ~                ld   de, (RoomsListTable)
 774  8AB0 ~                ld   (room_ptr), de
 775  8AB0 ~                xor  a
 776  8AB0 ~                ld   (transition_active), a
 777  8AB0 ~                ld   (velocity_y), a
 778  8AB0 ~                ld   (game_objective_completed), a
 779  8AB0 ~                ld   a, 1
 780  8AB0 ~                ld   (on_ground), a
 781  8AB0 ~                ld   a, $07
 782  8AB0 ~                call Gfx_ClearScreenDirect
 783  8AB0 ~                jp   LoadRoomAndRestart
 784  8AB0                  ENDIF
 785  8AB0
 786  8AB0              ; -------------------------------------------------------------------
 787  8AB0              ; Air_DepleteCountdown
 788  8AB0              ; Animazione originale di completamento livello (Manic Miner):
 789  8AB0              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 790  8AB0              ; - Ad ogni pixel decrementato:
 791  8AB0              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 792  8AB0              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 793  8AB0              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 794  8AB0              ; -------------------------------------------------------------------
 795  8AB0              Air_DepleteCountdown:
 796  8AB0 F5               push af
 797  8AB1 C5               push bc
 798  8AB2 D5               push de
 799  8AB3 E5               push hl
 800  8AB4
 801  8AB4              .countdown_loop:
 802  8AB4 3A 0E E8         ld   a, (air_pixels)
 803  8AB7 B7               or   a
 804  8AB8 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 805  8ABA
 806  8ABA 3D               dec  a
 807  8ABB 32 0E E8         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 808  8ABE
 809  8ABE                  ; Aggiorna la barra grafica dell'aria
 810  8ABE CD 27 6A         call Gfx_UpdateAirBar
 811  8AC1
 812  8AC1                  ; Aggiungi 1 punto allo score
 813  8AC1 CD 2C 86         call Score_Add1Point
 814  8AC4
 815  8AC4                  ; Genera l'effetto sonoro originale di Manic Miner:
 816  8AC4                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 817  8AC4 3A 0E E8         ld   a, (air_pixels)
 818  8AC7 2F               cpl
 819  8AC8 E6 3F            and  63
 820  8ACA 07               rlca
 821  8ACB 3C               inc  a
 822  8ACC 57               ld   d, a                      ; D = ritardo semionda audio
 823  8ACD
 824  8ACD 0E 03            ld   c, 3                      ; Durata impulso
 825  8ACF              .audio_loop:
 826  8ACF AF               xor  a
 827  8AD0 D3 FE            out  ($fe), a
 828  8AD2 42               ld   b, d
 829  8AD3 10 FE        .w1: djnz .w1
 830  8AD5
 831  8AD5 3E 18            ld   a, $18
 832  8AD7 D3 FE            out  ($fe), a
 833  8AD9 42               ld   b, d
 834  8ADA 10 FE        .w2: djnz .w2
 835  8ADC
 836  8ADC 0D               dec  c
 837  8ADD 20 F0            jr   nz, .audio_loop
 838  8ADF
 839  8ADF 18 D3            jr   .countdown_loop
 840  8AE1
 841  8AE1              .done_countdown:
 842  8AE1 E1               pop  hl
 843  8AE2 D1               pop  de
 844  8AE3 C1               pop  bc
 845  8AE4 F1               pop  af
 846  8AE5 C9               ret
 847  8AE6
 848  8AE6              ; -------------------------------------------------------------------
 849  8AE6              ; CheckAllItemsCollected
 850  8AE6              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 851  8AE6              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 852  8AE6              ; -------------------------------------------------------------------
 853  8AE6              CheckAllItemsCollected:
 854  8AE6 3A 06 E8         ld   a, (game_objective_completed)
 855  8AE9 B7               or   a
 856  8AEA 20 08            jr   nz, .all_collected
 857  8AEC 3A 6D E5         ld   a, (num_room_items)
 858  8AEF B7               or   a
 859  8AF0 28 02            jr   z, .all_collected
 860  8AF2 B7               or   a
 861  8AF3 C9               ret
 862  8AF4              .all_collected:
 863  8AF4 37               scf
 864  8AF5 C9               ret
 865  8AF6
 866  8AF6              ; -------------------------------------------------------------------
 867  8AF6              ; CheckInMasterBedroom (alias per retrocompatibilità)
 868  8AF6              ; -------------------------------------------------------------------
 869  8AF6              CheckInMasterBedroom:
 870  8AF6 37               scf
 871  8AF7 C9               ret
 872  8AF8
 873  8AF8              ; -------------------------------------------------------------------
 874  8AF8              ; CheckWillyConveyorCollision
 875  8AF8              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 876  8AF8              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 877  8AF8              ; -------------------------------------------------------------------
 878  8AF8              CheckWillyConveyorCollision:
 879  8AF8 C5               push bc
 880  8AF9 D5               push de
 881  8AFA E5               push hl
 882  8AFB
 883  8AFB                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 884  8AFB CD DA 76         call CheckWillyOnConveyor
 885  8AFE 38 49            jr   c, .collision_detected
 886  8B00
 887  8B00                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 888  8B00 3A 15 E5         ld   a, (conveyor_len)
 889  8B03 B7               or   a
 890  8B04 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 891  8B06
 892  8B06                  ; B = WillyY, C = WillyX
 893  8B06 ED 4B ED E1      ld   bc, (PlayerPos)
 894  8B0A
 895  8B0A                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 896  8B0A 3A 16 E5         ld   a, (conveyor_row)
 897  8B0D 87               add  a, a                  ; *2
 898  8B0E 87               add  a, a                  ; *4
 899  8B0F 87               add  a, a                  ; *8
 900  8B10 5F               ld   e, a                  ; E = ConveyorTop
 901  8B11 C6 07            add  a, 7
 902  8B13 57               ld   d, a                  ; D = ConveyorBottom
 903  8B14
 904  8B14                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 905  8B14 78               ld   a, b                  ; WillyTop
 906  8B15 BA               cp   d
 907  8B16 28 04            jr   z, .y_overlap
 908  8B18 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 909  8B1A 18 32            jr   .no_conv_collision
 910  8B1C
 911  8B1C              .y_overlap:
 912  8B1C C6 0F            add  a, 15                 ; WillyBottom
 913  8B1E BB               cp   e

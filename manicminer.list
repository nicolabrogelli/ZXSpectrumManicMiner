   2+ 7C47              ; enemy.asm
   3+ 7C47              ;
   4+ 7C47              ; Gestione dei Guardiani (Nemici) per Manic Miner.
   5+ 7C47              ; I dati e le sprite dei guardiani (8 frame da 16x16 pixel) sono definiti
   6+ 7C47              ; direttamente all'interno della stanza (OFFSET_H_GUARDIANS, OFFSET_V_GUARDIANS,
   7+ 7C47              ; OFFSET_GUARDIAN_GRAPHICS).
   8+ 7C47              ;===========================================================================
   9+ 7C47
  10+ 7C47              ; -------------------------------------------------------------------
  11+ 7C47              ; Struttura dati per i nemici attivi della stanza corrente (RAM)
  12+ 7C47              ; 8 slot, 11 byte ciascuno:
  13+ 7C47              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7C47              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C47              ; Offset 2: Current X
  16+ 7C47              ; Offset 3: Current Y
  17+ 7C47              ; Offset 4: Min Limit
  18+ 7C47              ; Offset 5: Max Limit
  19+ 7C47              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7C47              ; Offset 7: Anim State (0..3)
  21+ 7C47              ; Offset 8: Old X
  22+ 7C47              ; Offset 9: Old Y
  23+ 7C47              ; Offset 10: Color (Attributo Spectrum)
  24+ 7C47              ; -------------------------------------------------------------------
  25+ 7C47              ActiveEnemies:
  26+ 7C47 00          > db 0
  26+ 7C48 00          > db 0
  26+ 7C49 00          > db 0
  26+ 7C4A 00          > db 0
  26+ 7C4B 00          > db 0
  26+ 7C4C 00          > db 0
  26+ 7C4D 00          > db 0
  26+ 7C4E 00          > db 0

 573  8B8F              ; -------------------------------------------------------------------
 574  8B8F              ; TriggerPortalTransition
 575  8B8F              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 576  8B8F              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 577  8B8F              ; - Avanza all'indice della stanza successiva.
 578  8B8F              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 579  8B8F              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 580  8B8F              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 581  8B8F              ; -------------------------------------------------------------------
 582  8B8F              TriggerPortalTransition:
 583  8B8F                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 584  8B8F CD C6 8B         call Air_DepleteCountdown
 585  8B92
 586  8B92                  ; 1. Determina l'ID della stanza corrente
 587  8B92 CD 53 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 588  8B95
 589  8B95                  ; 2. Calcola l'indice della stanza successiva
 590  8B95 3A 2A EE         ld   a, (current_room)
 591  8B98 3C               inc  a
 592  8B99 FE 14            cp   NUM_ROOMS
 593  8B9B 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 594  8B9D
 595  8B9D                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 596  8B9D 21 A5 73         ld   hl, RoomsListTable
 597  8BA0 5F               ld   e, a
 598  8BA1 16 00            ld   d, 0
 599  8BA3 19               add  hl, de
 600  8BA4 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 601  8BA5 5E               ld   e, (hl)
 602  8BA6 23               inc  hl
 603  8BA7 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 604  8BA8 ED 53 85 EE      ld   (room_ptr), de
 605  8BAC
 606  8BAC                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 607  8BAC AF               xor  a
 608  8BAD 32 8B EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 609  8BB0 32 11 EB         ld   (velocity_y), a
 610  8BB3 32 1D F1         ld   (game_objective_completed), a
 611  8BB6 3E 01            ld   a, 1
 612  8BB8 32 12 EB         ld   (on_ground), a
 613  8BBB
 614  8BBB                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 615  8BBB 3E 07            ld   a, $07
 616  8BBD CD 9D 62         call Gfx_ClearScreenDirect
 617  8BC0
 618  8BC0 C3 28 89         jp   LoadRoomAndRestart
 619  8BC3
 620  8BC3              .all_rooms_completed:
 621  8BC3                  ; Tutte le stanze sono state completate con successo!
 622  8BC3                  IF ENABLE_VICTORY_SCREEN != 0
 623  8BC3 C3 B7 8A         jp   TriggerVictory
 624  8BC6                  ELSE
 625  8BC6 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 626  8BC6 ~                ld   de, (RoomsListTable)
 627  8BC6 ~                ld   (room_ptr), de
 628  8BC6 ~                xor  a
 629  8BC6 ~                ld   (transition_active), a
 630  8BC6 ~                ld   (velocity_y), a
 631  8BC6 ~                ld   (game_objective_completed), a
 632  8BC6 ~                ld   a, 1
 633  8BC6 ~                ld   (on_ground), a
 634  8BC6 ~                ld   a, $07
 635  8BC6 ~                call Gfx_ClearScreenDirect
 636  8BC6 ~                jp   LoadRoomAndRestart
 637  8BC6                  ENDIF

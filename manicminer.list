 652+ 8726
 653+ 8726                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 8726 3A 5E F0         ld   a, (player_score + 2)
 655+ 8729 CE 00            adc  a, 0
 656+ 872B 27               daa
 657+ 872C 32 5E F0         ld   (player_score + 2), a

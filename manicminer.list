1107+ 834B 4F               ld   c, a                      ; C = fetta guardiano
1108+ 834C 3A 52 F0         ld   a, (row_willy_cur)
1109+ 834F FE 08            cp   8
1110+ 8351 38 0D            jr   c, .read_willy_head

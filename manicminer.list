 356  8A89              ; -------------------------------------------------------------------
 357  8A89              ; TriggerGameOver
 358  8A89              ; Scatena la sequenza originale di Game Over:
 359  8A89              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  8A89              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  8A89              ;   con suono beeper originale e lampeggio dello schermo.
 362  8A89              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  8A89              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  8A89              ; -------------------------------------------------------------------
 365  8A89              TriggerGameOver:
 366  8A89                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  8A89 CD F0 87         call Score_CheckAndUpdateHighScore
 368  8A8C
 369  8A8C                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  8A8C CD 12 66         call Gfx_DrawGameOverScreen
 371  8A8F
 372  8A8F                  ; 3. Ritorna al Title Screen originale
 373  8A8F C3 45 8A         jp   ShowTitleScreen
 374  8A92
 375  8A92              ; -------------------------------------------------------------------
 376  8A92              ; TriggerVictory
 377  8A92              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  8A92              ; - Pulisce gli elementi di gioco della stanza.
 379  8A92              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  8A92              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  8A92              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  8A92              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  8A92              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  8A92              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  8A92              ; -------------------------------------------------------------------
 386  8A92              TriggerVictory:
 387  8A92                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  8A92 CD FD 66         call Gfx_DrawVictoryScreen
 389  8A95
 390  8A95                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8A95              .wait_keys_release:
 392  8A95 76               halt
 393  8A96                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8A96 01 FE DF         ld   bc, $dffe
 395  8A99 ED 78            in   a, (c)
 396  8A9B CB 67            bit  4, a
 397  8A9D 28 F6            jr   z, .wait_keys_release
 398  8A9F
 399  8A9F                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8A9F 01 FE 7F         ld   bc, $7ffe
 401  8AA2 ED 78            in   a, (c)
 402  8AA4 CB 5F            bit  3, a
 403  8AA6 28 ED            jr   z, .wait_keys_release
 404  8AA8
 405  8AA8                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8AA8 01 FE BF         ld   bc, $bffe
 407  8AAB ED 78            in   a, (c)
 408  8AAD CB 47            bit  0, a
 409  8AAF 28 E4            jr   z, .wait_keys_release
 410  8AB1
 411  8AB1                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8AB1 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8AB3              .wait_choice_loop:
 414  8AB3 76               halt
 415  8AB4
 416  8AB4                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8AB4 0C               inc  c
 418  8AB5 79               ld   a, c
 419  8AB6 CB 3F            srl  a
 420  8AB8 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8ABA E6 07            and  7
 422  8ABC 5F               ld   e, a
 423  8ABD 16 00            ld   d, 0
 424  8ABF 21 F4 65         ld   hl, victory_color_table
 425  8AC2 19               add  hl, de
 426  8AC3 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8AC4 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8AC7 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8AC9              .color_cycle_loop:
 430  8AC9 77               ld   (hl), a
 431  8ACA 23               inc  hl
 432  8ACB 10 FC            djnz .color_cycle_loop
 433  8ACD
 434  8ACD                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8ACD 01 FE DF         ld   bc, $dffe
 436  8AD0 ED 78            in   a, (c)
 437  8AD2 CB 67            bit  4, a
 438  8AD4 28 2A            jr   z, .play_again_chosen
 439  8AD6
 440  8AD6                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8AD6 01 FE 7F         ld   bc, $7ffe
 442  8AD9 ED 78            in   a, (c)
 443  8ADB CB 5F            bit  3, a
 444  8ADD 28 0B            jr   z, .quit_chosen
 445  8ADF
 446  8ADF                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8ADF 01 FE BF         ld   bc, $bffe
 448  8AE2 ED 78            in   a, (c)
 449  8AE4 CB 47            bit  0, a
 450  8AE6 28 02            jr   z, .quit_chosen
 451  8AE8
 452  8AE8 18 C9            jr   .wait_choice_loop
 453  8AEA
 454  8AEA              .quit_chosen:
 455  8AEA                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8AEA              .wait_quit_release:
 457  8AEA 76               halt
 458  8AEB 01 FE 7F         ld   bc, $7ffe
 459  8AEE ED 78            in   a, (c)
 460  8AF0 CB 5F            bit  3, a
 461  8AF2 28 F6            jr   z, .wait_quit_release
 462  8AF4 01 FE BF         ld   bc, $bffe
 463  8AF7 ED 78            in   a, (c)
 464  8AF9 CB 47            bit  0, a
 465  8AFB 28 ED            jr   z, .wait_quit_release
 466  8AFD
 467  8AFD                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8AFD C3 45 8A         jp   ShowTitleScreen
 469  8B00
 470  8B00              .play_again_chosen:
 471  8B00                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8B00              .wait_play_again_release:
 473  8B00 76               halt
 474  8B01 01 FE DF         ld   bc, $dffe
 475  8B04 ED 78            in   a, (c)
 476  8B06 CB 67            bit  4, a
 477  8B08 28 F6            jr   z, .wait_play_again_release
 478  8B0A
 479  8B0A                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8B0A CD 44 8C         call ResetFullGameState
 481  8B0D C3 06 89         jp   LoadRoomAndRestart
 482  8B10
 483  8B10              ; -------------------------------------------------------------------
 484  8B10              ; CheckPortalTransition
 485  8B10              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8B10              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8B10              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8B10              ;
 489  8B10              ; Output:
 490  8B10              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8B10              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8B10              ; -------------------------------------------------------------------
 493  8B10              CheckPortalTransition:
 494  8B10 C5               push bc
 495  8B11 D5               push de
 496  8B12 E5               push hl
 497  8B13
 498  8B13                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8B13 CD D7 8B         call CheckAllItemsCollected
 500  8B16 30 4D            jr   nc, .no_transition
 501  8B18
 502  8B18                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8B18                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8B18                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8B18 2A 5F EE         ld   hl, (room_ptr)
 506  8B1B 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8B1E 19               add  hl, de
 508  8B1F 4E               ld   c, (hl)
 509  8B20 23               inc  hl
 510  8B21 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8B22
 512  8B22                  ; Offset = BC - 23552
 513  8B22 60               ld   h, b
 514  8B23 69               ld   l, c
 515  8B24 01 00 A4         ld   bc, -23552
 516  8B27 09               add  hl, bc
 517  8B28
 518  8B28                  ; PortalX = (Offset & 31) * 8
 519  8B28 7D               ld   a, l
 520  8B29 E6 1F            and  31
 521  8B2B 87               add  a, a
 521  8B2C 87             add a, a
 521  8B2D 87             add a, a
 522  8B2E 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8B2F
 524  8B2F                  ; PortalY = (Offset / 32) * 8
 525  8B2F CB 3C            srl  h
 525  8B31 CB 1D          rr l
 526  8B33 CB 3C            srl  h
 526  8B35 CB 1D          rr l
 527  8B37 CB 3C            srl  h
 527  8B39 CB 1D          rr l
 528  8B3B CB 3C            srl  h
 528  8B3D CB 1D          rr l
 529  8B3F CB 3C            srl  h
 529  8B41 CB 1D          rr l
 530  8B43 7D               ld   a, l
 531  8B44 87               add  a, a
 531  8B45 87             add a, a
 531  8B46 87             add a, a
 532  8B47 57               ld   d, a                      ; D = PortalY (0..120)
 533  8B48
 534  8B48                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8B48 ED 4B DE EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8B4C
 537  8B4C                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8B4C 7B               ld   a, e
 539  8B4D 91               sub  c
 540  8B4E 30 02            jr   nc, .x_diff_pos
 541  8B50 ED 44            neg
 542  8B52              .x_diff_pos:
 543  8B52 FE 0C            cp   12
 544  8B54 30 0F            jr   nc, .no_transition
 545  8B56
 546  8B56                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8B56 7A               ld   a, d
 548  8B57 90               sub  b
 549  8B58 30 02            jr   nc, .y_diff_pos
 550  8B5A ED 44            neg
 551  8B5C              .y_diff_pos:
 552  8B5C FE 0E            cp   14
 553  8B5E 30 05            jr   nc, .no_transition
 554  8B60
 555  8B60                  ; Transizione al portale attiva!
 556  8B60 E1               pop  hl
 557  8B61 D1               pop  de
 558  8B62 C1               pop  bc
 559  8B63 37               scf
 560  8B64 C9               ret
 561  8B65
 562  8B65              .no_transition:
 563  8B65 E1               pop  hl
 564  8B66 D1               pop  de
 565  8B67 C1               pop  bc
 566  8B68 B7               or   a
 567  8B69 C9               ret
 568  8B6A
 569  8B6A              ; Alias per retrocompatibilità
 570  8B6A              CheckVictoryCondition: EQU CheckPortalTransition
 571  8B6A
 572  8B6A              ; -------------------------------------------------------------------
 573  8B6A              ; TriggerPortalTransition
 574  8B6A              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8B6A              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8B6A              ; - Avanza all'indice della stanza successiva.
 577  8B6A              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8B6A              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8B6A              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8B6A              ; -------------------------------------------------------------------
 581  8B6A              TriggerPortalTransition:
 582  8B6A                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8B6A CD A1 8B         call Air_DepleteCountdown
 584  8B6D
 585  8B6D                  ; 1. Determina l'ID della stanza corrente
 586  8B6D CD 31 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8B70
 588  8B70                  ; 2. Calcola l'indice della stanza successiva
 589  8B70 3A 04 EE         ld   a, (current_room)
 590  8B73 3C               inc  a
 591  8B74 FE 14            cp   NUM_ROOMS
 592  8B76 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8B78
 594  8B78                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8B78 21 A2 73         ld   hl, RoomsListTable
 596  8B7B 5F               ld   e, a
 597  8B7C 16 00            ld   d, 0
 598  8B7E 19               add  hl, de
 599  8B7F 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8B80 5E               ld   e, (hl)
 601  8B81 23               inc  hl
 602  8B82 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8B83 ED 53 5F EE      ld   (room_ptr), de
 604  8B87
 605  8B87                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8B87 AF               xor  a
 607  8B88 32 65 EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8B8B 32 EC EA         ld   (velocity_y), a
 609  8B8E 32 F7 F0         ld   (game_objective_completed), a
 610  8B91 3E 01            ld   a, 1
 611  8B93 32 ED EA         ld   (on_ground), a
 612  8B96
 613  8B96                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8B96 3E 07            ld   a, $07
 615  8B98 CD 9D 62         call Gfx_ClearScreenDirect
 616  8B9B
 617  8B9B C3 06 89         jp   LoadRoomAndRestart
 618  8B9E
 619  8B9E              .all_rooms_completed:
 620  8B9E                  ; Tutte le stanze sono state completate con successo!
 621  8B9E                  IF ENABLE_VICTORY_SCREEN != 0
 622  8B9E C3 92 8A         jp   TriggerVictory
 623  8BA1                  ELSE
 624  8BA1 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8BA1 ~                ld   de, (RoomsListTable)
 626  8BA1 ~                ld   (room_ptr), de
 627  8BA1 ~                xor  a
 628  8BA1 ~                ld   (transition_active), a
 629  8BA1 ~                ld   (velocity_y), a
 630  8BA1 ~                ld   (game_objective_completed), a
 631  8BA1 ~                ld   a, 1
 632  8BA1 ~                ld   (on_ground), a
 633  8BA1 ~                ld   a, $07
 634  8BA1 ~                call Gfx_ClearScreenDirect
 635  8BA1 ~                jp   LoadRoomAndRestart
 636  8BA1                  ENDIF
 637  8BA1
 638  8BA1              ; -------------------------------------------------------------------
 639  8BA1              ; Air_DepleteCountdown
 640  8BA1              ; Animazione originale di completamento livello (Manic Miner):
 641  8BA1              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8BA1              ; - Ad ogni pixel decrementato:
 643  8BA1              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8BA1              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8BA1              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8BA1              ; -------------------------------------------------------------------
 647  8BA1              Air_DepleteCountdown:
 648  8BA1 F5               push af
 649  8BA2 C5               push bc
 650  8BA3 D5               push de
 651  8BA4 E5               push hl
 652  8BA5
 653  8BA5              .countdown_loop:
 654  8BA5 3A 00 F1         ld   a, (air_pixels)
 655  8BA8 B7               or   a
 656  8BA9 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8BAB
 658  8BAB 3D               dec  a
 659  8BAC 32 00 F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8BAF
 661  8BAF                  ; Aggiorna la barra grafica dell'aria
 662  8BAF CD 2D 6A         call Gfx_UpdateAirBar
 663  8BB2
 664  8BB2                  ; Aggiungi 1 punto allo score
 665  8BB2 CD A5 87         call Score_Add1Point
 666  8BB5
 667  8BB5                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8BB5                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8BB5 3A 00 F1         ld   a, (air_pixels)
 670  8BB8 2F               cpl
 671  8BB9 E6 3F            and  63
 672  8BBB 07               rlca
 673  8BBC 3C               inc  a
 674  8BBD 57               ld   d, a                      ; D = ritardo semionda audio
 675  8BBE
 676  8BBE 0E 03            ld   c, 3                      ; Durata impulso
 677  8BC0              .audio_loop:
 678  8BC0 AF               xor  a
 679  8BC1 D3 FE            out  ($fe), a
 680  8BC3 42               ld   b, d
 681  8BC4 10 FE        .w1: djnz .w1
 682  8BC6
 683  8BC6 3E 18            ld   a, $18
 684  8BC8 D3 FE            out  ($fe), a
 685  8BCA 42               ld   b, d
 686  8BCB 10 FE        .w2: djnz .w2
 687  8BCD
 688  8BCD 0D               dec  c
 689  8BCE 20 F0            jr   nz, .audio_loop
 690  8BD0
 691  8BD0 18 D3            jr   .countdown_loop
 692  8BD2
 693  8BD2              .done_countdown:
 694  8BD2 E1               pop  hl
 695  8BD3 D1               pop  de
 696  8BD4 C1               pop  bc
 697  8BD5 F1               pop  af
 698  8BD6 C9               ret
 699  8BD7
 700  8BD7              ; -------------------------------------------------------------------
 701  8BD7              ; CheckAllItemsCollected
 702  8BD7              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8BD7              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8BD7              ; -------------------------------------------------------------------
 705  8BD7              CheckAllItemsCollected:
 706  8BD7 3A F7 F0         ld   a, (game_objective_completed)
 707  8BDA B7               or   a
 708  8BDB 20 08            jr   nz, .all_collected
 709  8BDD 3A 5E EE         ld   a, (num_room_items)
 710  8BE0 B7               or   a
 711  8BE1 28 02            jr   z, .all_collected
 712  8BE3 B7               or   a
 713  8BE4 C9               ret
 714  8BE5              .all_collected:
 715  8BE5 37               scf
 716  8BE6 C9               ret
 717  8BE7
 718  8BE7              ; -------------------------------------------------------------------
 719  8BE7              ; CheckInMasterBedroom (alias per retrocompatibilità)
 720  8BE7              ; -------------------------------------------------------------------
 721  8BE7              CheckInMasterBedroom:
 722  8BE7 37               scf
 723  8BE8 C9               ret
 724  8BE9
 725  8BE9              ; -------------------------------------------------------------------
 726  8BE9              ; CheckWillyConveyorCollision
 727  8BE9              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8BE9              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8BE9              ; -------------------------------------------------------------------
 730  8BE9              CheckWillyConveyorCollision:
 731  8BE9 C5               push bc
 732  8BEA D5               push de
 733  8BEB E5               push hl
 734  8BEC
 735  8BEC                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8BEC CD 52 78         call CheckWillyOnConveyor
 737  8BEF 38 49            jr   c, .collision_detected
 738  8BF1
 739  8BF1                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8BF1 3A 06 EE         ld   a, (conveyor_len)
 741  8BF4 B7               or   a
 742  8BF5 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8BF7
 744  8BF7                  ; B = WillyY, C = WillyX
 745  8BF7 ED 4B DE EA      ld   bc, (PlayerPos)
 746  8BFB
 747  8BFB                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8BFB 3A 07 EE         ld   a, (conveyor_row)
 749  8BFE 87               add  a, a                  ; *2
 750  8BFF 87               add  a, a                  ; *4
 751  8C00 87               add  a, a                  ; *8
 752  8C01 5F               ld   e, a                  ; E = ConveyorTop
 753  8C02 C6 07            add  a, 7
 754  8C04 57               ld   d, a                  ; D = ConveyorBottom
 755  8C05
 756  8C05                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8C05 78               ld   a, b                  ; WillyTop
 758  8C06 BA               cp   d
 759  8C07 28 04            jr   z, .y_overlap
 760  8C09 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8C0B 18 32            jr   .no_conv_collision
 762  8C0D
 763  8C0D              .y_overlap:
 764  8C0D C6 0F            add  a, 15                 ; WillyBottom
 765  8C0F BB               cp   e
 766  8C10 28 04            jr   z, .x_check
 767  8C12 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8C14 18 29            jr   .no_conv_collision
 769  8C16
 770  8C16              .x_check:
 771  8C16                  ; ConveyorLeft = conveyor_col * 8
 772  8C16 3A 08 EE         ld   a, (conveyor_col)
 773  8C19 87               add  a, a                  ; *2
 774  8C1A 87               add  a, a                  ; *4
 775  8C1B 87               add  a, a                  ; *8
 776  8C1C 5F               ld   e, a                  ; E = ConveyorLeft
 777  8C1D
 778  8C1D                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 779  8C1D 21 06 EE         ld   hl, conveyor_len
 780  8C20 3A 08 EE         ld   a, (conveyor_col)
 781  8C23 86               add  a, (hl)
 782  8C24 87               add  a, a                  ; *2
 783  8C25 87               add  a, a                  ; *4
 784  8C26 87               add  a, a                  ; *8
 785  8C27 3D               dec  a                     ; ConveyorRight
 786  8C28 57               ld   d, a                  ; D = ConveyorRight
 787  8C29
 788  8C29                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 789  8C29 79               ld   a, c                  ; WillyLeft
 790  8C2A BA               cp   d
 791  8C2B 28 04            jr   z, .x_overlap
 792  8C2D 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8C2F 18 0E            jr   .no_conv_collision
 794  8C31
 795  8C31              .x_overlap:
 796  8C31 C6 0F            add  a, 15                 ; WillyRight
 797  8C33 BB               cp   e
 798  8C34 28 04            jr   z, .collision_detected
 799  8C36 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 800  8C38 18 05            jr   .no_conv_collision
 801  8C3A
 802  8C3A              .collision_detected:
 803  8C3A E1               pop  hl
 804  8C3B D1               pop  de
 805  8C3C C1               pop  bc
 806  8C3D 37               scf
 807  8C3E C9               ret
 808  8C3F
 809  8C3F              .no_conv_collision:
 810  8C3F E1               pop  hl
 811  8C40 D1               pop  de
 812  8C41 C1               pop  bc
 813  8C42 B7               or   a
 814  8C43 C9               ret

 906+ 779B 47               ld   b, a              ; B = offset
 907+ 779C
 908+ 779C                  ; SlopeRow = ramp_row - B
 909+ 779C 3A B8 E4         ld   a, (ramp_row)
 910+ 779F 90               sub  b
 911+ 77A0 47               ld   b, a              ; B = SlopeRow

1053+ 780B              ; -------------------------------------------------------------------
1054+ 780B              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 780B              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 780B              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 780B              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 780B              ; -------------------------------------------------------------------
1059+ 780B              UnpackRoomLayout:
1060+ 780B E5               push hl
1061+ 780C D5               push de
1062+ 780D C5               push bc
1063+ 780E DD E5            push ix
1064+ 7810
1065+ 7810 DD 2A 5F CA      ld   ix, (room_ptr)
1066+ 7814 11 20 02         ld   de, OFFSET_TILES
1067+ 7817 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 7819
1069+ 7819 2A 5F CA         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 781C 11 04 C8         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 781F 01 00 02         ld   bc, 512               ; 512 celle
1072+ 7822
1073+ 7822              .byte_loop:
1074+ 7822 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 7823 23               inc  hl
1076+ 7824
1077+ 7824                  ; Confronta con le 8 definizioni di tile:
1078+ 7824 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7827 28 23            jr   z, .is_bg
1080+ 7829 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 782C 28 29            jr   z, .is_wall
1082+ 782E DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 7831 28 1C            jr   z, .is_floor
1084+ 7833 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7836 28 1B            jr   z, .is_crumbling
1086+ 7838 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 783B 28 1E            jr   z, .is_conveyor
1088+ 783D DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 7840 28 1D            jr   z, .is_nasty1
1090+ 7842 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 7845 28 1C            jr   z, .is_nasty2
1092+ 7847 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 784A 28 1B            jr   z, .is_extra
1094+ 784C
1095+ 784C              .is_bg:
1096+ 784C                  ; Default: Tile 0 (Background)
1097+ 784C AF               xor  a
1098+ 784D 18 1A            jr   .store_cell
1099+ 784F
1100+ 784F              .is_floor:
1101+ 784F 3E 01            ld   a, 1
1102+ 7851 18 16            jr   .store_cell
1103+ 7853              .is_crumbling:
1104+ 7853 3E 02            ld   a, 2
1105+ 7855 18 12            jr   .store_cell
1106+ 7857              .is_wall:
1107+ 7857 3E 03            ld   a, 3
1108+ 7859 18 0E            jr   .store_cell
1109+ 785B              .is_conveyor:
1110+ 785B 3E 04            ld   a, 4
1111+ 785D 18 0A            jr   .store_cell
1112+ 785F              .is_nasty1:
1113+ 785F 3E 05            ld   a, 5
1114+ 7861 18 06            jr   .store_cell
1115+ 7863              .is_nasty2:
1116+ 7863 3E 06            ld   a, 6
1117+ 7865 18 02            jr   .store_cell
1118+ 7867              .is_extra:
1119+ 7867 3E 07            ld   a, 7
1120+ 7869
1121+ 7869              .store_cell:
1122+ 7869 12               ld   (de), a
1123+ 786A 13               inc  de
1124+ 786B 0B               dec  bc
1125+ 786C 78               ld   a, b
1126+ 786D B1               or   c
1127+ 786E 20 B2            jr   nz, .byte_loop
1128+ 7870
1129+ 7870 DD E1            pop  ix
1130+ 7872 C1               pop  bc
1131+ 7873 D1               pop  de
1132+ 7874 E1               pop  hl
1133+ 7875 C9               ret
1134+ 7876
1135+ 7876              ; -------------------------------------------------------------------
1136+ 7876              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7876              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7876              ; Output: A = tipo di cella (0..3)
1139+ 7876              ; Preserva tutti gli altri registri.
1140+ 7876              ; -------------------------------------------------------------------
1141+ 7876              GetCellFromUnpacked:
1142+ 7876 E5               push hl
1143+ 7877 D5               push de
1144+ 7878
1145+ 7878 6F               ld   l, a
1146+ 7879 26 00            ld   h, 0
1147+ 787B 29               add  hl, hl
1148+ 787C 29               add  hl, hl
1149+ 787D 29               add  hl, hl
1150+ 787E 29               add  hl, hl
1151+ 787F 29               add  hl, hl            ; HL = Row * 32
1152+ 7880 59               ld   e, c
1153+ 7881 16 00            ld   d, 0
1154+ 7883 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 7884 11 04 C8         ld   de, unpacked_layout
1156+ 7887 19               add  hl, de
1157+ 7888 7E               ld   a, (hl)           ; A = cell type
1158+ 7889
1159+ 7889 D1               pop  de
1160+ 788A E1               pop  hl
1161+ 788B C9               ret

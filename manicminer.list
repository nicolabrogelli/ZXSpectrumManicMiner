 518+ 7FBC              ; CheckCollision
 519+ 7FBC              ;
 520+ 7FBC              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FBC              ; Output:
 522+ 7FBC              ;   Carry Set = Collisione con guardiano
 523+ 7FBC              ;   Carry Clear = Nessuna collisione
 524+ 7FBC              ; -------------------------------------------------------------------
 525+ 7FBC              CheckCollision:
 526+ 7FBC DD E5            push ix
 527+ 7FBE C5               push bc
 528+ 7FBF D5               push de
 529+ 7FC0 E5               push hl
 530+ 7FC1
 531+ 7FC1                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FC1 3A 0F A2         ld   a, (willy_safety_timer)
 533+ 7FC4 B7               or   a
 534+ 7FC5 20 3B            jr   nz, .no_collision_found
 535+ 7FC7
 536+ 7FC7 DD 21 B4 7C      ld   ix, ActiveEnemies
 537+ 7FCB 06 08            ld   b, 8                      ; 8 slot
 538+ 7FCD
 539+ 7FCD              .collision_loop:
 540+ 7FCD DD 7E 00         ld   a, (ix+0)
 541+ 7FD0 E6 80            and  $80                       ; Active?
 542+ 7FD2 28 26            jr   z, .next_enemy
 543+ 7FD4
 544+ 7FD4 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7FD5
 546+ 7FD5                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7FD5 ED 4B 04 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7FD9 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7FDC
 550+ 7FDC                  ; Calcola differenza X
 551+ 7FDC 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7FDD 30 02            jr   nc, .x_diff_pos
 553+ 7FDF ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7FE1              .x_diff_pos:
 555+ 7FE1 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7FE3 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7FE5
 558+ 7FE5                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7FE5 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7FE8 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7FE9 30 02            jr   nc, .y_diff_pos
 562+ 7FEB ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7FED              .y_diff_pos:
 564+ 7FED FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7FEF 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7FF1
 567+ 7FF1                  ; Collisione trovata!
 568+ 7FF1 C1               pop  bc                        ; Ripristina stack
 569+ 7FF2 E1               pop  hl
 570+ 7FF3 D1               pop  de
 571+ 7FF4 C1               pop  bc
 572+ 7FF5 DD E1            pop  ix
 573+ 7FF7 37               scf
 574+ 7FF8 C9               ret
 575+ 7FF9
 576+ 7FF9              .no_x_hit:
 577+ 7FF9 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 7FFA
 579+ 7FFA              .next_enemy:
 580+ 7FFA 11 0B 00         ld   de, 11
 581+ 7FFD DD 19            add  ix, de
 582+ 7FFF 05               dec  b
 583+ 8000 20 CB            jr   nz, .collision_loop

  84+ A414
  85+ A414              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ A414 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ A417 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ A41A 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ A41B 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ A41C 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ A41D 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ A41E 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ A41F 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ A420
  95+ A420 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ A421 00           Audio_jump_sound_timer:   db 0

 625+ 836D              ; Score_AddItemPoints
 626+ 836D              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 836D              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 836D              ; -------------------------------------------------------------------
 629+ 836D              Score_AddItemPoints:
 630+ 836D F5               push af
 631+ 836E C5               push bc
 632+ 836F D5               push de
 633+ 8370 E5               push hl
 634+ 8371
 635+ 8371                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8371 3A DC B8         ld   a, (player_score + 1)
 637+ 8374 C6 01            add  a, $01
 638+ 8376 27               daa
 639+ 8377 32 DC B8         ld   (player_score + 1), a
 640+ 837A
 641+ 837A                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 837A 3A DD B8         ld   a, (player_score + 2)
 643+ 837D CE 00            adc  a, 0
 644+ 837F 27               daa
 645+ 8380 32 DD B8         ld   (player_score + 2), a

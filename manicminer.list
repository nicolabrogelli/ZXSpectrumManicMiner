  72+ 8413 ~            ; Audio_UpdateMusic
  73+ 8413 ~            ;
  74+ 8413 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8413 ~            ; Viene chiamata a ogni frame.
  76+ 8413 ~            ; -------------------------------------------------------------------
  77+ 8413 ~            Audio_UpdateMusic:
  78+ 8413 ~                push af
  79+ 8413 ~                push bc
  80+ 8413 ~                push de
  81+ 8413 ~                push hl
  82+ 8413 ~
  83+ 8413 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8413 ~                ld   a, (Audio_jump_sound_note)
  85+ 8413 ~                cp   18
  86+ 8413 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8413 ~
  88+ 8413 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8413 ~                ld   a, (Audio_music_frame_counter)
  90+ 8413 ~                dec  a
  91+ 8413 ~                ld   (Audio_music_frame_counter), a
  92+ 8413 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8413 ~
  94+ 8413 ~                ; Altrimenti carica la nota successiva
  95+ 8413 ~                ld   a, (Audio_music_note_idx)
  96+ 8413 ~                inc  a
  97+ 8413 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8413 ~                jr   c, .no_wrap
  99+ 8413 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8413 ~            .no_wrap:
 101+ 8413 ~                ld   (Audio_music_note_idx), a
 102+ 8413 ~
 103+ 8413 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8413 ~                ld   e, a
 105+ 8413 ~                ld   d, 0
 106+ 8413 ~                ld   hl, Audio_MusicSheet
 107+ 8413 ~                add  hl, de
 108+ 8413 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8413 ~
 110+ 8413 ~                ; Leggi durata (secondo byte)
 111+ 8413 ~                inc  hl
 112+ 8413 ~                ld   a, (hl)
 113+ 8413 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8413 ~                jr   nz, .dur_ok
 115+ 8413 ~                ld   a, 1
 116+ 8413 ~            .dur_ok:
 117+ 8413 ~                ld   (Audio_music_frame_counter), a
 118+ 8413 ~
 119+ 8413 ~            .play_current_note:
 120+ 8413 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8413 ~                ld   a, (Audio_music_note_idx)
 122+ 8413 ~                ld   e, a
 123+ 8413 ~                ld   d, 0
 124+ 8413 ~                ld   hl, Audio_MusicSheet
 125+ 8413 ~                add  hl, de
 126+ 8413 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8413 ~                ld   a, (hl)                  ; A = delay
 128+ 8413 ~                or   a
 129+ 8413 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8413 ~
 131+ 8413 ~                ; Suona la nota: 2 cicli
 132+ 8413 ~                ld   d, a                     ; D = delay
 133+ 8413 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8413 ~            .note_loop:
 135+ 8413 ~                ; Speaker ON
 136+ 8413 ~                ld   a, (room_border_color)
 137+ 8413 ~                or   $10
 138+ 8413 ~                out  ($fe), a
 139+ 8413 ~                ld   c, d
 140+ 8413 ~            .d1:
 141+ 8413 ~                push af
 142+ 8413 ~                pop  af
 143+ 8413 ~                dec  c
 144+ 8413 ~                jr   nz, .d1
 145+ 8413 ~
 146+ 8413 ~                ; Speaker OFF
 147+ 8413 ~                ld   a, (room_border_color)
 148+ 8413 ~                and  $ef
 149+ 8413 ~                out  ($fe), a
 150+ 8413 ~                ld   c, d
 151+ 8413 ~            .d2:
 152+ 8413 ~                push af
 153+ 8413 ~                pop  af
 154+ 8413 ~                dec  c
 155+ 8413 ~                jr   nz, .d2
 156+ 8413 ~
 157+ 8413 ~                djnz .note_loop
 158+ 8413 ~
 159+ 8413 ~            .done:
 160+ 8413 ~                pop  hl
 161+ 8413 ~                pop  de
 162+ 8413 ~                pop  bc
 163+ 8413 ~                pop  af
 164+ 8413 ~                ret
 165+ 8413 ~
 166+ 8413 ~            Audio_MusicSheet:
 167+ 8413 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8413 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8413 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8413 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8413 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8413 ~                db 90, 10, 107, 20, 68, 65

  85+ B079              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ B079 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ B07C 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ B07F 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ B080 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ B081 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ B082 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ B083 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ B084 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ B085
  95+ B085 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)

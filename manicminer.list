2066+ 7D67              ; -------------------------------------------------------------------
2067+ 7D67              ; Phys_UpdateAir
2068+ 7D67              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2069+ 7D67              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2070+ 7D67              ; Output:
2071+ 7D67              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2072+ 7D67              ;   Carry Clear = Aria ancora disponibile
2073+ 7D67              ; -------------------------------------------------------------------
2074+ 7D67              Phys_UpdateAir:
2075+ 7D67                  ; Incrementa il timer dei frame
2076+ 7D67 3A 01 F1         ld   a, (air_timer)
2077+ 7D6A 3C               inc  a
2078+ 7D6B 32 01 F1         ld   (air_timer), a
2079+ 7D6E 21 02 F1         ld   hl, air_deplete_rate
2080+ 7D71 BE               cp   (hl)
2081+ 7D72 38 14            jr   c, .no_deplete
2082+ 7D74
2083+ 7D74                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2084+ 7D74 AF               xor  a
2085+ 7D75 32 01 F1         ld   (air_timer), a
2086+ 7D78
2087+ 7D78 3A 00 F1         ld   a, (air_pixels)
2088+ 7D7B B7               or   a
2089+ 7D7C 28 0C            jr   z, .air_finished
2090+ 7D7E
2091+ 7D7E 3D               dec  a
2092+ 7D7F 32 00 F1         ld   (air_pixels), a
2093+ 7D82 CD 2D 6A         call Gfx_UpdateAirBar
2094+ 7D85
2095+ 7D85 B7               or   a
2096+ 7D86 28 02            jr   z, .air_finished
2097+ 7D88
2098+ 7D88              .no_deplete:
2099+ 7D88 B7               or   a                     ; Carry Clear = Ok
2100+ 7D89 C9               ret
2101+ 7D8A
2102+ 7D8A              .air_finished:
2103+ 7D8A 37               scf                        ; Carry Set = Morte per esaurimento aria
2104+ 7D8B C9               ret

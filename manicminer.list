  88+ E800              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ E800 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ E803 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ E806 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ E807 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ E808 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ E809 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ E80A 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ E80B 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

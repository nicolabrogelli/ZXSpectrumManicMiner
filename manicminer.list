 922+ 82CD 3A 86 EA         ld   a, (PlayerPos+1)          ; WillyY
 923+ 82D0 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 924+ 82D3 FE 10            cp   16
 925+ 82D5 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 926+ 82D7 FE F1            cp   241                       ; 241..255 = -15..-1
 927+ 82D9 DA DB 83         jp   c, .next_enemy            ; 16..240 -> fuori range
 928+ 82DC              .y_in_range:

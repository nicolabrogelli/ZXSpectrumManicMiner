 138+ 80EC              ; Items_DrawRoom
 139+ 80EC              ;
 140+ 80EC              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 80EC              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 80EC              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 80EC              ;
 144+ 80EC              ; Record item nella stanza (5 byte):
 145+ 80EC              ;   +0 Color / Attributo
 146+ 80EC              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 80EC              ;   +2 Attr Address High
 148+ 80EC              ;   +3 Anim Mask (96)
 149+ 80EC              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 80EC              ; Fine lista: $FF
 151+ 80EC              ; -------------------------------------------------------------------
 152+ 80EC              Items_DrawRoom:
 153+ 80EC E5               push hl
 154+ 80ED D5               push de

 253  8204              .draw_raster_bars:
 254  8204                  ; Collisione attiva: disegna le raster bar nel bordo
 255  8204 3A AA 93         ld   a, (counter)
 256  8207 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 257  8209 06 1E            ld   b, 30             ; Numero di righe della barra raster
 258  820B              .raster_loop:
 259  820B D3 FE            out  ($fe), a
 260  820D 3C               inc  a
 261  820E E6 07            and  7
 262  8210 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 263  8212              .delay:

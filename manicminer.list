 747+ 8847              ; Items_Animate
 748+ 8847              ;
 749+ 8847              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 8847              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 8847              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 8847              ; originale $8F63.
 753+ 8847              ; -------------------------------------------------------------------
 754+ 8847              Items_Animate:
 755+ 8847 E5               push hl
 756+ 8848 D5               push de
 757+ 8849 C5               push bc
 758+ 884A FD E5            push iy
 759+ 884C
 760+ 884C 3A 84 EE         ld   a, (num_room_items)
 761+ 884F B7               or   a
 762+ 8850 28 40            jr   z, .anim_done
 763+ 8852
 764+ 8852 FD 21 34 EE      ld   iy, current_room_items
 765+ 8856
 766+ 8856              .anim_loop:
 767+ 8856 FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 8859 FE FF            cp   $FF
 769+ 885B 28 35            jr   z, .anim_done
 770+ 885D B7               or   a
 771+ 885E 28 2B            jr   z, .next_anim_item
 772+ 8860
 773+ 8860                  ; Routine originale $8F63 di Manic Miner:
 774+ 8860                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 8860 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 8862 F6 03            or   $03                       ; Base Ink = 3
 777+ 8864 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 8865 FD 7E 02         ld   a, (iy+2)
 779+ 8868 E6 03            and  $03                       ; Isola offset rotazione
 780+ 886A 80               add  a, b                      ; A = Nuovo attributo
 781+ 886B FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 886E 47               ld   b, a                      ; B = Nuovo attributo
 783+ 886F
 784+ 886F                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 886F FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 8872 16 00            ld   d, 0
 787+ 8874 26 00            ld   h, 0
 788+ 8876 FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 8879 29               add  hl, hl
 790+ 887A 29               add  hl, hl
 791+ 887B 29               add  hl, hl
 792+ 887C 29               add  hl, hl
 793+ 887D 29               add  hl, hl                    ; Row * 32
 794+ 887E 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 887F
 796+ 887F                  ; Aggiorna items_grid
 797+ 887F E5               push hl
 798+ 8880 11 03 E9         ld   de, items_grid
 799+ 8883 19               add  hl, de
 800+ 8884 70               ld   (hl), b
 801+ 8885 E1               pop  hl
 802+ 8886
 803+ 8886                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 8886 11 00 58         ld   de, COLOR_DATA
 805+ 8889 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 888A 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 888B
 808+ 888B              .next_anim_item:
 809+ 888B 01 05 00         ld   bc, 5
 810+ 888E FD 09            add  iy, bc
 811+ 8890 18 C4            jr   .anim_loop
 812+ 8892
 813+ 8892              .anim_done:
 814+ 8892 FD E1            pop  iy
 815+ 8894 C1               pop  bc
 816+ 8895 D1               pop  de
 817+ 8896 E1               pop  hl
 818+ 8897 C9               ret

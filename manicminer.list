 192+ 834E D3 FE            out  ($fe), a
 193+ 8350
 194+ 8350 0E 3C            ld   c, 60
 195+ 8352              .d1:
 196+ 8352 0D               dec  c
 197+ 8353 20 FD            jr   nz, .d1
 198+ 8355
 199+ 8355 3A 3E 9E         ld   a, (room_border_color)
 200+ 8358 E6 EF            and  $ef              ; speaker OFF
 201+ 835A D3 FE            out  ($fe), a
 202+ 835C
 203+ 835C 0E 3C            ld   c, 60
 204+ 835E              .d2:
 205+ 835E 0D               dec  c
 206+ 835F 20 FD            jr   nz, .d2
 207+ 8361
 208+ 8361 10 E6            djnz .sound_loop
 209+ 8363
 210+ 8363 D1               pop  de
 211+ 8364 C1               pop  bc
 212+ 8365 C9               ret

  87+ F1DB 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  88+ F1DC 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  89+ F1DD
  90+ F1DD              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  91+ F1DD 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  92+ F1E0 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  93+ F1E3 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  94+ F1E4 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  95+ F1E5 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  96+ F1E6 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  97+ F1E7 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  98+ F1E8 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  99+ F1E9 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
 100+ F1EA
 101+ F1EA 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 102+ F1EB 00           Audio_jump_sound_timer:   db 0
 103+ F1EC                  IF ENABLE_MUSIC != 0
 104+ F1EC ~            Audio_music_note_idx:      db 0
 105+ F1EC ~            Audio_music_frame_counter: db 1
 106+ F1EC                  ENDIF
 107+ F1EC
 108+ F1EC              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 109+ F1EC E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 110+ F1ED 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 111+ F1EE 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 112+ F1EF
 113+ F1EF              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 114+ F1EF 00 00        willy_head_ptr:         dw 0
 115+ F1F1 00 00        willy_body_ptr:         dw 0
 116+ F1F3 00 00        guard_sprite_ptr:       dw 0
 117+ F1F5 00           collision_delta_x:      db 0
 118+ F1F6 00           collision_delta_y:      db 0
 119+ F1F7 00           row_enemy_cur:          db 0
 120+ F1F8 00           row_willy_cur:          db 0
 121+ F1F9 00           overlap_num_lines:      db 0
 122+ F1FA

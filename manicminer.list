 168+ 5E70 DD E1            pop  ix
 169+ 5E72 E1               pop  hl
 170+ 5E73 D1               pop  de
 171+ 5E74 C1               pop  bc
 172+ 5E75 C9               ret
 173+ 5E76
 174+ 5E76              ; -------------------------------------------------------------------
 175+ 5E76              ; Ripristina un byte dello sfondo statico.
 176+ 5E76              ; Input: A = X del byte schermo in pixel (0, 8, 16...), D = Y pixel
 177+ 5E76              ; Output: A = byte di sfondo
 178+ 5E76              ; -------------------------------------------------------------------
 179+ 5E76              Gfx_GetBackgroundByte:
 180+ 5E76 E5               push hl
 181+ 5E77 D5               push de
 182+ 5E78 C5               push bc
 183+ 5E79
 184+ 5E79 4F               ld   c, a                  ; C = X pixel (0, 8, 16...)
 185+ 5E7A
 186+ 5E7A                  ; 1. Controlla se Y (in D) è fuori dalla griglia di layout (Y >= 128)
 187+ 5E7A 7A               ld   a, d
 188+ 5E7B FE 80            cp   128
 189+ 5E7D D2 2B 5F         jp   nc, .blank
 190+ 5E80
 191+ 5E80                  ; 2. Calcola Col = X / 8
 192+ 5E80 79               ld   a, c
 193+ 5E81 CB 3F            srl  a
 194+ 5E83 CB 3F            srl  a
 195+ 5E85 CB 3F            srl  a
 196+ 5E87 4F               ld   c, a                  ; C = Col (0..31)
 197+ 5E88
 198+ 5E88                  ; 3. Calcola Row = Y / 8
 199+ 5E88 7A               ld   a, d
 200+ 5E89 CB 3F            srl  a
 201+ 5E8B CB 3F            srl  a
 202+ 5E8D CB 3F            srl  a
 203+ 5E8F 5F               ld   e, a                  ; E = Row (0..15)
 204+ 5E90
 205+ 5E90                  ; 4. Calcola Scanline offset = (Y & 7) + 1 (byte 0 nel tile da 9 byte è l'attributo)
 206+ 5E90 7A               ld   a, d
 207+ 5E91 E6 07            and  7
 208+ 5E93 3C               inc  a
 209+ 5E94 47               ld   b, a                  ; B = Scanline offset (1..8)
 210+ 5E95
 211+ 5E95                  ; 5. Controlla se c'è un Item Attivo in questa cella (Row E, Col C)
 212+ 5E95 D5               push de
 213+ 5E96 C5               push bc
 214+ 5E97 41               ld   b, c                  ; B = Col
 215+ 5E98 4B               ld   c, e                  ; C = Row
 216+ 5E99 CD 82 88         call CheckActiveItemAtCell
 217+ 5E9C 30 14            jr   nc, .no_item
 218+ 5E9E
 219+ 5E9E                  ; --- ITEM ATTIVO PRESENTE ---
 220+ 5E9E C1               pop  bc                    ; B = Scanline offset (1..8), C = Col

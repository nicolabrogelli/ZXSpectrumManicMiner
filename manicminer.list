  86+ E4FA 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ E4FD 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ E500 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ E501 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ E502 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ E503 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ E504 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ E505 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ E506
  95+ E506 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ E507 00           Audio_jump_sound_timer:   db 0
  97+ E508                  IF ENABLE_MUSIC != 0
  98+ E508 ~            Audio_music_note_idx:      db 0
  99+ E508 ~            Audio_music_frame_counter: db 1
 100+ E508                  ENDIF
 101+ E508
 102+ E508              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 103+ E508 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 104+ E509 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 105+ E50A 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 106+ E50B
 107+ E50B              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 108+ E50B 00 00        willy_head_ptr:         dw 0
 109+ E50D 00 00        willy_body_ptr:         dw 0
 110+ E50F 00 00        guard_sprite_ptr:       dw 0
 111+ E511 00           collision_delta_x:      db 0
 112+ E512 00           collision_delta_y:      db 0
 113+ E513 00           row_enemy_cur:          db 0
 114+ E514 00           row_willy_cur:          db 0
 115+ E515 00           overlap_num_lines:      db 0
 116+ E516
# file closed: datavariable.asm
 963  E516
 964  E516                  SAVESNA "manicminer.sna", start ; sna48-ok

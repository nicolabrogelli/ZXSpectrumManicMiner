 494  896F 32 C0 E1         ld   (q_prev), a
 495  8972 32 C1 E1         ld   (a_prev), a
 496  8975 32 B8 E1         ld   (on_ground), a
 497  8978 32 B3 E5         ld   (enemy_was_updated), a
 498  897B
 499  897B                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 500  897B 3E 00            ld   a, RESPAWN_SAFETY_TIME
 501  897D 32 B5 E5         ld   (willy_safety_timer), a
 502  8980
 503  8980                  ; - Ripristina lo stato audio
 504  8980 3E 12            ld   a, 18
 505  8982 32 C8 E7         ld   (Audio_jump_sound_note), a
 506  8985 AF               xor  a
 507  8986 32 C9 E7         ld   (Audio_jump_sound_timer), a
 508  8989                  IF ENABLE_MUSIC != 0
 509  8989 ~                ld   (Audio_music_note_idx), a
 510  8989 ~                ld   a, 1
 511  8989 ~                ld   (Audio_music_frame_counter), a
 512  8989                  ENDIF
 513  8989
 514  8989                  ; - Riposiziona Willy nel punto di default definito nella stanza
 515  8989 AF               xor  a
 516  898A 32 30 E5         ld   (transition_active), a
 517  898D
 518  898D                  ; - Cancella lo schermo a nero prima del caricamento
 519  898D AF               xor  a
 520  898E D3 FE            out  ($fe), a
 521  8990 CD 99 62         call Gfx_ClearScreenDirect
 522  8993
 523  8993                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 524  8993 C3 2E 87         jp   LoadRoomAndRestart
 525  8996
 526  8996              ; -------------------------------------------------------------------
 527  8996              ; TriggerVictory
 528  8996              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 529  8996              ; - Pulisce gli elementi di gioco della stanza.
 530  8996              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 531  8996              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 532  8996              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 533  8996              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 534  8996              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 535  8996              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 536  8996              ; -------------------------------------------------------------------
 537  8996              TriggerVictory:
 538  8996                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 539  8996 CD F3 66         call Gfx_DrawVictoryScreen
 540  8999
 541  8999                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 542  8999              .wait_keys_release:
 543  8999 76               halt
 544  899A                  ; Controlla tasto Y (Porta $DF, bit 4)
 545  899A 01 FE DF         ld   bc, $dffe
 546  899D ED 78            in   a, (c)
 547  899F CB 67            bit  4, a
 548  89A1 28 F6            jr   z, .wait_keys_release
 549  89A3
 550  89A3                  ; Controlla tasto N (Porta $7F, bit 3)
 551  89A3 01 FE 7F         ld   bc, $7ffe
 552  89A6 ED 78            in   a, (c)
 553  89A8 CB 5F            bit  3, a
 554  89AA 28 ED            jr   z, .wait_keys_release
 555  89AC
 556  89AC                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 557  89AC 01 FE BF         ld   bc, $bffe
 558  89AF ED 78            in   a, (c)
 559  89B1 CB 47            bit  0, a
 560  89B3 28 E4            jr   z, .wait_keys_release
 561  89B5
 562  89B5                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 563  89B5 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 564  89B7              .wait_choice_loop:
 565  89B7 76               halt
 566  89B8
 567  89B8                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 568  89B8 0C               inc  c
 569  89B9 79               ld   a, c
 570  89BA CB 3F            srl  a
 571  89BC CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 572  89BE E6 07            and  7
 573  89C0 5F               ld   e, a
 574  89C1 16 00            ld   d, 0
 575  89C3 21 0D 66         ld   hl, victory_color_table
 576  89C6 19               add  hl, de
 577  89C7 7E               ld   a, (hl)               ; A = nuovo colore attributo
 578  89C8 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 579  89CB 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 580  89CD              .color_cycle_loop:
 581  89CD 77               ld   (hl), a
 582  89CE 23               inc  hl
 583  89CF 10 FC            djnz .color_cycle_loop
 584  89D1
 585  89D1                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 586  89D1 01 FE DF         ld   bc, $dffe
 587  89D4 ED 78            in   a, (c)
 588  89D6 CB 67            bit  4, a
 589  89D8 28 2A            jr   z, .play_again_chosen
 590  89DA
 591  89DA                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 592  89DA 01 FE 7F         ld   bc, $7ffe
 593  89DD ED 78            in   a, (c)
 594  89DF CB 5F            bit  3, a
 595  89E1 28 0B            jr   z, .quit_chosen
 596  89E3
 597  89E3                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 598  89E3 01 FE BF         ld   bc, $bffe
 599  89E6 ED 78            in   a, (c)
 600  89E8 CB 47            bit  0, a
 601  89EA 28 02            jr   z, .quit_chosen
 602  89EC
 603  89EC 18 C9            jr   .wait_choice_loop
 604  89EE
 605  89EE              .quit_chosen:
 606  89EE                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 607  89EE              .wait_quit_release:
 608  89EE 76               halt
 609  89EF 01 FE 7F         ld   bc, $7ffe
 610  89F2 ED 78            in   a, (c)
 611  89F4 CB 5F            bit  3, a
 612  89F6 28 F6            jr   z, .wait_quit_release
 613  89F8 01 FE BF         ld   bc, $bffe
 614  89FB ED 78            in   a, (c)
 615  89FD CB 47            bit  0, a
 616  89FF 28 ED            jr   z, .wait_quit_release
 617  8A01
 618  8A01                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 619  8A01 C3 6A 88         jp   ShowTitleScreen
 620  8A04
 621  8A04              .play_again_chosen:
 622  8A04                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 623  8A04              .wait_play_again_release:
 624  8A04 76               halt
 625  8A05 01 FE DF         ld   bc, $dffe
 626  8A08 ED 78            in   a, (c)
 627  8A0A CB 67            bit  4, a
 628  8A0C 28 F6            jr   z, .wait_play_again_release
 629  8A0E
 630  8A0E                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 631  8A0E CD 0F 8B         call ResetFullGameState
 632  8A11 C3 2E 87         jp   LoadRoomAndRestart
 633  8A14
 634  8A14              ; -------------------------------------------------------------------
 635  8A14              ; CheckPortalTransition
 636  8A14              ; Verifica le condizioni per accedere alla stanza successiva:
 637  8A14              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 638  8A14              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 639  8A14              ;
 640  8A14              ; Output:
 641  8A14              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 642  8A14              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 643  8A14              ; -------------------------------------------------------------------
 644  8A14              CheckPortalTransition:
 645  8A14 C5               push bc
 646  8A15 D5               push de
 647  8A16 E5               push hl
 648  8A17
 649  8A17                  ; 1. Tutti gli item della stanza sono stati raccolti?
 650  8A17 CD A2 8A         call CheckAllItemsCollected
 651  8A1A 30 4D            jr   nc, .no_transition
 652  8A1C
 653  8A1C                  ; 2. Willy collide con il portale (16x16 pixel)?
 654  8A1C                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 655  8A1C                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 656  8A1C 2A 2A E5         ld   hl, (room_ptr)
 657  8A1F 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 658  8A22 19               add  hl, de
 659  8A23 4E               ld   c, (hl)
 660  8A24 23               inc  hl
 661  8A25 46               ld   b, (hl)                   ; BC = AttrAddr
 662  8A26
 663  8A26                  ; Offset = BC - 23552
 664  8A26 60               ld   h, b
 665  8A27 69               ld   l, c
 666  8A28 01 00 A4         ld   bc, -23552
 667  8A2B 09               add  hl, bc
 668  8A2C
 669  8A2C                  ; PortalX = (Offset & 31) * 8
 670  8A2C 7D               ld   a, l
 671  8A2D E6 1F            and  31
 672  8A2F 87               add  a, a
 672  8A30 87             add a, a
 672  8A31 87             add a, a
 673  8A32 5F               ld   e, a                      ; E = PortalX (0..248)
 674  8A33
 675  8A33                  ; PortalY = (Offset / 32) * 8
 676  8A33 CB 3C            srl  h
 676  8A35 CB 1D          rr l
 677  8A37 CB 3C            srl  h
 677  8A39 CB 1D          rr l
 678  8A3B CB 3C            srl  h
 678  8A3D CB 1D          rr l
 679  8A3F CB 3C            srl  h
 679  8A41 CB 1D          rr l
 680  8A43 CB 3C            srl  h
 680  8A45 CB 1D          rr l
 681  8A47 7D               ld   a, l
 682  8A48 87               add  a, a
 682  8A49 87             add a, a
 682  8A4A 87             add a, a
 683  8A4B 57               ld   d, a                      ; D = PortalY (0..120)
 684  8A4C
 685  8A4C                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 686  8A4C ED 4B A9 E1      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 687  8A50
 688  8A50                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 689  8A50 7B               ld   a, e
 690  8A51 91               sub  c
 691  8A52 30 02            jr   nc, .x_diff_pos
 692  8A54 ED 44            neg
 693  8A56              .x_diff_pos:
 694  8A56 FE 0C            cp   12
 695  8A58 30 0F            jr   nc, .no_transition
 696  8A5A
 697  8A5A                  ; Controllo verticale: |WillyY - PortalY| < 14
 698  8A5A 7A               ld   a, d
 699  8A5B 90               sub  b
 700  8A5C 30 02            jr   nc, .y_diff_pos
 701  8A5E ED 44            neg
 702  8A60              .y_diff_pos:
 703  8A60 FE 0E            cp   14
 704  8A62 30 05            jr   nc, .no_transition
 705  8A64
 706  8A64                  ; Transizione al portale attiva!
 707  8A64 E1               pop  hl
 708  8A65 D1               pop  de
 709  8A66 C1               pop  bc
 710  8A67 37               scf
 711  8A68 C9               ret
 712  8A69
 713  8A69              .no_transition:
 714  8A69 E1               pop  hl
 715  8A6A D1               pop  de
 716  8A6B C1               pop  bc
 717  8A6C B7               or   a
 718  8A6D C9               ret
 719  8A6E
 720  8A6E              ; Alias per retrocompatibilità
 721  8A6E              CheckVictoryCondition: EQU CheckPortalTransition
 722  8A6E
 723  8A6E              ; -------------------------------------------------------------------
 724  8A6E              ; TriggerPortalTransition
 725  8A6E              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 726  8A6E              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 727  8A6E              ; - Avanza all'indice della stanza successiva.
 728  8A6E              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 729  8A6E              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 730  8A6E              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 731  8A6E              ; -------------------------------------------------------------------
 732  8A6E              TriggerPortalTransition:
 733  8A6E                  ; 1. Determina l'ID della stanza corrente
 734  8A6E CD D4 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8A71
 736  8A71                  ; 2. Calcola l'indice della stanza successiva
 737  8A71 3A CF E4         ld   a, (current_room)
 738  8A74 3C               inc  a
 739  8A75 FE 14            cp   NUM_ROOMS
 740  8A77 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8A79
 742  8A79                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8A79 21 0C 73         ld   hl, RoomsListTable
 744  8A7C 5F               ld   e, a
 745  8A7D 16 00            ld   d, 0
 746  8A7F 19               add  hl, de
 747  8A80 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8A81 5E               ld   e, (hl)
 749  8A82 23               inc  hl
 750  8A83 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8A84 ED 53 2A E5      ld   (room_ptr), de
 752  8A88
 753  8A88                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8A88 AF               xor  a
 755  8A89 32 30 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8A8C 32 B7 E1         ld   (velocity_y), a
 757  8A8F 32 C2 E7         ld   (game_objective_completed), a
 758  8A92 3E 01            ld   a, 1
 759  8A94 32 B8 E1         ld   (on_ground), a
 760  8A97
 761  8A97                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8A97 3E 07            ld   a, $07
 763  8A99 CD 99 62         call Gfx_ClearScreenDirect
 764  8A9C
 765  8A9C C3 2E 87         jp   LoadRoomAndRestart
 766  8A9F
 767  8A9F              .all_rooms_completed:
 768  8A9F                  ; Tutte le stanze sono state completate con successo!
 769  8A9F                  IF ENABLE_VICTORY_SCREEN != 0
 770  8A9F C3 96 89         jp   TriggerVictory
 771  8AA2                  ELSE
 772  8AA2 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8AA2 ~                ld   de, (RoomsListTable)
 774  8AA2 ~                ld   (room_ptr), de
 775  8AA2 ~                xor  a
 776  8AA2 ~                ld   (transition_active), a
 777  8AA2 ~                ld   (velocity_y), a
 778  8AA2 ~                ld   (game_objective_completed), a
 779  8AA2 ~                ld   a, 1
 780  8AA2 ~                ld   (on_ground), a
 781  8AA2 ~                ld   a, $07
 782  8AA2 ~                call Gfx_ClearScreenDirect
 783  8AA2 ~                jp   LoadRoomAndRestart
 784  8AA2                  ENDIF
 785  8AA2
 786  8AA2              ; -------------------------------------------------------------------
 787  8AA2              ; CheckAllItemsCollected
 788  8AA2              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 789  8AA2              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 790  8AA2              ; -------------------------------------------------------------------
 791  8AA2              CheckAllItemsCollected:
 792  8AA2 3A C2 E7         ld   a, (game_objective_completed)
 793  8AA5 B7               or   a
 794  8AA6 20 08            jr   nz, .all_collected
 795  8AA8 3A 29 E5         ld   a, (num_room_items)
 796  8AAB B7               or   a
 797  8AAC 28 02            jr   z, .all_collected
 798  8AAE B7               or   a
 799  8AAF C9               ret
 800  8AB0              .all_collected:
 801  8AB0 37               scf
 802  8AB1 C9               ret
 803  8AB2
 804  8AB2              ; -------------------------------------------------------------------
 805  8AB2              ; CheckInMasterBedroom (alias per retrocompatibilità)
 806  8AB2              ; -------------------------------------------------------------------
 807  8AB2              CheckInMasterBedroom:
 808  8AB2 37               scf
 809  8AB3 C9               ret
 810  8AB4
 811  8AB4              ; -------------------------------------------------------------------
 812  8AB4              ; CheckWillyConveyorCollision
 813  8AB4              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 814  8AB4              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 815  8AB4              ; -------------------------------------------------------------------
 816  8AB4              CheckWillyConveyorCollision:
 817  8AB4 C5               push bc
 818  8AB5 D5               push de
 819  8AB6 E5               push hl
 820  8AB7
 821  8AB7                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 822  8AB7 CD CD 76         call CheckWillyOnConveyor
 823  8ABA 38 49            jr   c, .collision_detected
 824  8ABC
 825  8ABC                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 826  8ABC 3A D1 E4         ld   a, (conveyor_len)
 827  8ABF B7               or   a
 828  8AC0 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 829  8AC2
 830  8AC2                  ; B = WillyY, C = WillyX
 831  8AC2 ED 4B A9 E1      ld   bc, (PlayerPos)
 832  8AC6
 833  8AC6                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 834  8AC6 3A D2 E4         ld   a, (conveyor_row)
 835  8AC9 87               add  a, a                  ; *2
 836  8ACA 87               add  a, a                  ; *4
 837  8ACB 87               add  a, a                  ; *8
 838  8ACC 5F               ld   e, a                  ; E = ConveyorTop
 839  8ACD C6 07            add  a, 7
 840  8ACF 57               ld   d, a                  ; D = ConveyorBottom
 841  8AD0
 842  8AD0                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 843  8AD0 78               ld   a, b                  ; WillyTop
 844  8AD1 BA               cp   d
 845  8AD2 28 04            jr   z, .y_overlap
 846  8AD4 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 847  8AD6 18 32            jr   .no_conv_collision
 848  8AD8
 849  8AD8              .y_overlap:
 850  8AD8 C6 0F            add  a, 15                 ; WillyBottom
 851  8ADA BB               cp   e
 852  8ADB 28 04            jr   z, .x_check
 853  8ADD 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 854  8ADF 18 29            jr   .no_conv_collision
 855  8AE1
 856  8AE1              .x_check:
 857  8AE1                  ; ConveyorLeft = conveyor_col * 8
 858  8AE1 3A D3 E4         ld   a, (conveyor_col)
 859  8AE4 87               add  a, a                  ; *2
 860  8AE5 87               add  a, a                  ; *4
 861  8AE6 87               add  a, a                  ; *8
 862  8AE7 5F               ld   e, a                  ; E = ConveyorLeft
 863  8AE8
 864  8AE8                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 865  8AE8 21 D1 E4         ld   hl, conveyor_len
 866  8AEB 3A D3 E4         ld   a, (conveyor_col)
 867  8AEE 86               add  a, (hl)
 868  8AEF 87               add  a, a                  ; *2
 869  8AF0 87               add  a, a                  ; *4
 870  8AF1 87               add  a, a                  ; *8
 871  8AF2 3D               dec  a                     ; ConveyorRight
 872  8AF3 57               ld   d, a                  ; D = ConveyorRight
 873  8AF4
 874  8AF4                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 875  8AF4 79               ld   a, c                  ; WillyLeft
 876  8AF5 BA               cp   d
 877  8AF6 28 04            jr   z, .x_overlap
 878  8AF8 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 879  8AFA 18 0E            jr   .no_conv_collision
 880  8AFC
 881  8AFC              .x_overlap:
 882  8AFC C6 0F            add  a, 15                 ; WillyRight
 883  8AFE BB               cp   e
 884  8AFF 28 04            jr   z, .collision_detected
 885  8B01 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 886  8B03 18 05            jr   .no_conv_collision
 887  8B05
 888  8B05              .collision_detected:
 889  8B05 E1               pop  hl
 890  8B06 D1               pop  de
 891  8B07 C1               pop  bc
 892  8B08 37               scf
 893  8B09 C9               ret
 894  8B0A
 895  8B0A              .no_conv_collision:
 896  8B0A E1               pop  hl
 897  8B0B D1               pop  de
 898  8B0C C1               pop  bc
 899  8B0D B7               or   a
 900  8B0E C9               ret
 901  8B0F
 902  8B0F              ; -------------------------------------------------------------------
 903  8B0F              ; ResetFullGameState
 904  8B0F              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 905  8B0F              ; per l'avvio di una nuova partita dopo il Game Over.
 906  8B0F              ; -------------------------------------------------------------------
 907  8B0F              ResetFullGameState:
 908  8B0F                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 909  8B0F AF               xor  a
 910  8B10 D3 FE            out  ($fe), a              ; Bordo a nero
 911  8B12 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 912  8B15
 913  8B15                  ; Ripristina il numero di vite iniziali
 914  8B15 3E 07            ld   a, INITIAL_LIVES
 915  8B17 32 B6 E1         ld   (willy_lives), a
 916  8B1A
 917  8B1A                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 918  8B1A AF               xor  a
 919  8B1B 32 B3 E1         ld   (items_collected), a
 920  8B1E 32 AF E1         ld   (body_state), a
 921  8B21 32 C2 E1         ld   (w_warp_state), a
 922  8B24 32 C5 E1         ld   (w_key_prev), a
 923  8B27 32 C6 E1         ld   (enter_key_prev), a

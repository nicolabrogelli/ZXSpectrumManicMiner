 454+ 82B4              .y_check:
 455+ 82B4                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 82B4 7C               ld   a, h                      ; H = Item Row
 457+ 82B5 87               add  a, a                      ; *2
 458+ 82B6 87               add  a, a                      ; *4
 459+ 82B7 87               add  a, a                      ; *8

 478+ 7FE1              ; Enemy_DrawSingleSlot
 479+ 7FE1              ;
 480+ 7FE1              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7FE1              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7FE1              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7FE1              ; -------------------------------------------------------------------
 484+ 7FE1              Enemy_DrawSingleSlot:
 485+ 7FE1 C5               push bc
 486+ 7FE2 D5               push de
 487+ 7FE3 E5               push hl
 488+ 7FE4 DD E5            push ix
 489+ 7FE6
 490+ 7FE6                  ; 1. Salva subito le coordinate X e Y dal record IX

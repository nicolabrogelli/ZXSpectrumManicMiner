 417  8623 CB 67            bit  4, a
 418  8625 28 2A            jr   z, .continue_chosen
 419  8627
 420  8627                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  8627 01 FE 7F         ld   bc, $7ffe
 422  862A ED 78            in   a, (c)
 423  862C CB 5F            bit  3, a
 424  862E 28 0B            jr   z, .quit_chosen
 425  8630
 426  8630                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  8630 01 FE BF         ld   bc, $bffe
 428  8633 ED 78            in   a, (c)
 429  8635 CB 47            bit  0, a
 430  8637 28 02            jr   z, .quit_chosen
 431  8639
 432  8639 18 C9            jr   .wait_choice_loop

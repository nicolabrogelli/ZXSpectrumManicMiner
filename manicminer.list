1784+ 7B6A 79               ld   a, c
1785+ 7B6B C6 07            add  a, 7
1786+ 7B6D 4F               ld   c, a
1787+ 7B6E CD 02 7B         call CheckNastyCell
1788+ 7B71 38 03            jr   c, .collision

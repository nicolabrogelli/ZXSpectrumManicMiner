 475+ 7F4C
 476+ 7F4C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 477+ 7F4F FE 01            cp   1                         ; Sinistra?
 478+ 7F51 28 03            jr   z, .left_frames

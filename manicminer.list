 478+ 7F47              ; Enemy_DrawSingleSlot
 479+ 7F47              ;
 480+ 7F47              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7F47              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7F47              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F47              ; -------------------------------------------------------------------
 484+ 7F47              Enemy_DrawSingleSlot:
 485+ 7F47 C5               push bc
 486+ 7F48 D5               push de
 487+ 7F49 E5               push hl
 488+ 7F4A DD E5            push ix
 489+ 7F4C
 490+ 7F4C                  ; 1. Salva subito le coordinate X e Y dal record IX
 491+ 7F4C DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 492+ 7F4F DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 493+ 7F52
 494+ 7F52                  ; Controlla se è Kong Beast ($A0)
 495+ 7F52 DD 7E 00         ld   a, (ix+0)
 496+ 7F55 FE A0            cp   $A0
 497+ 7F57 28 22            jr   z, .kong_frame

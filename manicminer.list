 414+ 856F              ; CheckWillyItemCollision
 415+ 856F              ;
 416+ 856F              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 856F              ; Input:
 418+ 856F              ;   A = Item Col (0..31)
 419+ 856F              ;   H = Item Row (0..15)
 420+ 856F              ; Output:
 421+ 856F              ;   Carry Set = Collisione
 422+ 856F              ;   Carry Clear = Nessuna collisione
 423+ 856F              ; -------------------------------------------------------------------
 424+ 856F              CheckWillyItemCollision:
 425+ 856F C5               push bc
 426+ 8570 D5               push de
 427+ 8571 E5               push hl

 179+ 88CF              ; Audio_PlayCollectSound
 180+ 88CF              ;
 181+ 88CF              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 88CF              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 88CF              ; -------------------------------------------------------------------
 184+ 88CF              Audio_PlayCollectSound:
 185+ 88CF C5               push bc
 186+ 88D0 D5               push de
 187+ 88D1
 188+ 88D1 06 78            ld   b, 120
 189+ 88D3              .sound_loop:
 190+ 88D3 3A F6 EA         ld   a, (room_border_color)
 191+ 88D6 F6 10            or   $10               ; speaker ON
 192+ 88D8 D3 FE            out  ($fe), a
 193+ 88DA
 194+ 88DA 0E 3C            ld   c, 60
 195+ 88DC              .d1:
 196+ 88DC 0D               dec  c
 197+ 88DD 20 FD            jr   nz, .d1
 198+ 88DF
 199+ 88DF 3A F6 EA         ld   a, (room_border_color)
 200+ 88E2 E6 EF            and  $ef              ; speaker OFF
 201+ 88E4 D3 FE            out  ($fe), a
 202+ 88E6
 203+ 88E6 0E 3C            ld   c, 60
 204+ 88E8              .d2:
 205+ 88E8 0D               dec  c
 206+ 88E9 20 FD            jr   nz, .d2
 207+ 88EB
 208+ 88EB 10 E6            djnz .sound_loop
 209+ 88ED
 210+ 88ED D1               pop  de
 211+ 88EE C1               pop  bc
 212+ 88EF C9               ret

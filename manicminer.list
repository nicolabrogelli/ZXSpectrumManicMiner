 388+ 7C96              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7C96              ; -------------------------------------------------------------------
 390+ 7C96              Enemy_Update:
 391+ 7C96 E5               push hl
 392+ 7C97 D5               push de
 393+ 7C98 C5               push bc
 394+ 7C99 DD E5            push ix
 395+ 7C9B
 396+ 7C9B 3E 01            ld   a, 1
 397+ 7C9D 32 7A 93         ld   (enemy_was_updated), a

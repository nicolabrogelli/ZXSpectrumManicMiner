 355+ 7051 23               inc  hl
 356+ 7052 E5               push hl                        ; Salva posizione corrente in RoomsListTable
 357+ 7053
 358+ 7053                  ; Calcola indirizzo di OFFSET_POS_WILLY
 359+ 7053 21 68 02         ld   hl, OFFSET_POS_WILLY
 360+ 7056 19               add  hl, de                    ; HL = layout + OFFSET_POS_WILLY
 361+ 7057
 362+ 7057 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 363+ 7058 CB 3F            srl  a
 364+ 705A F5               push af                        ; Salva PlayerY sullo stack
 365+ 705B
 366+ 705B 23               inc  hl                        ; Byte 1
 367+ 705C 23               inc  hl                        ; Byte 2
 368+ 705D 23               inc  hl                        ; Byte 3
 369+ 705E 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 370+ 705F 4E               ld   c, (hl)
 371+ 7060 23               inc  hl                        ; Byte 5 (AttrAddr High)
 372+ 7061 7E               ld   a, (hl)
 373+ 7062
 374+ 7062 67               ld   h, a

 446+ 86B2
 447+ 86B2              .x_ok:
 448+ 86B2                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 86B2 BB               cp   e                         ; E = ItemLeft
 450+ 86B3 28 0B            jr   z, .y_check
 451+ 86B5 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 86B7
 453+ 86B7                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 86B7 C6 07            add  a, 7
 455+ 86B9 BB               cp   e
 456+ 86BA 28 04            jr   z, .y_check
 457+ 86BC 30 02            jr   nc, .y_check
 458+ 86BE 18 23            jr   .no_collision

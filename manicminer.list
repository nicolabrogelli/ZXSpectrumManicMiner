 172+ 7CD4 69               ld   l, c
 173+ 7CD5 01 00 A4         ld   bc, -23552
 174+ 7CD8 09               add  hl, bc                    ; HL = AttrOffset
 175+ 7CD9
 176+ 7CD9                  ; Col = Offset & 31
 177+ 7CD9 7D               ld   a, l
 178+ 7CDA E6 1F            and  31
 179+ 7CDC 4F               ld   c, a                      ; C = Col (0..31)
 180+ 7CDD
 181+ 7CDD                  ; Row = Offset / 32
 182+ 7CDD CB 3C            srl  h
 182+ 7CDF CB 1D          rr l
 183+ 7CE1 CB 3C            srl  h
 183+ 7CE3 CB 1D          rr l
 184+ 7CE5 CB 3C            srl  h
 184+ 7CE7 CB 1D          rr l
 185+ 7CE9 CB 3C            srl  h
 185+ 7CEB CB 1D          rr l
 186+ 7CED CB 3C            srl  h
 186+ 7CEF CB 1D          rr l
 187+ 7CF1 7D               ld   a, l
 188+ 7CF2 47               ld   b, a                      ; B = Row (0..15)
 189+ 7CF3
 190+ 7CF3                  ; Disegna l'item sullo schermo
 191+ 7CF3 DD E5            push ix
 192+ 7CF5 E1               pop  hl                        ; HL = puntatore bitmap
 193+ 7CF6 CD 33 7D         call DrawItemGraphic

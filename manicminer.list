 287  85D3              ; -------------------------------------------------------------------
 288  85D3              ; ShowTitleScreen
 289  85D3              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  85D3              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  85D3              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  85D3              ; -------------------------------------------------------------------
 293  85D3              ShowTitleScreen:
 294  85D3                  ; 1. Disegna la schermata iniziale
 295  85D3 CD 76 64         call Gfx_DrawTitleScreen
 296  85D6
 297  85D6                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  85D6              .wait_title_enter_release:
 299  85D6 76               halt
 300  85D7 3E BF            ld   a, $bf
 301  85D9 DB FE            in   a, ($fe)
 302  85DB 1F               rra
 303  85DC 30 F8            jr   nc, .wait_title_enter_release
 304  85DE
 305  85DE                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  85DE 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  85E0              .title_loop:
 308  85E0 76               halt
 309  85E1
 310  85E1                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  85E1 0C               inc  c
 312  85E2 79               ld   a, c
 313  85E3 CB 3F            srl  a
 314  85E5 CB 3F            srl  a
 315  85E7 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85E9 E6 07            and  7
 317  85EB 5F               ld   e, a
 318  85EC 16 00            ld   d, 0
 319  85EE 21 6E 64         ld   hl, title_color_table
 320  85F1 19               add  hl, de
 321  85F2 7E               ld   a, (hl)               ; A = nuovo colore
 322  85F3 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85F6 06 20            ld   b, 32
 324  85F8              .color_title_loop:
 325  85F8 77               ld   (hl), a
 326  85F9 23               inc  hl
 327  85FA 10 FC            djnz .color_title_loop
 328  85FC
 329  85FC                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85FC 3E BF            ld   a, $bf
 331  85FE DB FE            in   a, ($fe)
 332  8600 1F               rra
 333  8601 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  8603
 335  8603                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  8603              .wait_title_enter_release_after:
 337  8603 76               halt
 338  8604 3E BF            ld   a, $bf
 339  8606 DB FE            in   a, ($fe)
 340  8608 1F               rra
 341  8609 30 F8            jr   nc, .wait_title_enter_release_after

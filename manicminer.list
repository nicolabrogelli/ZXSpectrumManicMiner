 436+ 7021 23               inc  hl
 437+ 7022 E5               push hl                        ; Salva posizione corrente in RoomsListTable
 438+ 7023
 439+ 7023                  ; Calcola indirizzo di OFFSET_POS_WILLY
 440+ 7023 21 68 02         ld   hl, OFFSET_POS_WILLY

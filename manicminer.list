 287+ 7D54 29               add  hl, hl
 288+ 7D55 29               add  hl, hl
 289+ 7D56 29               add  hl, hl
 290+ 7D57 29               add  hl, hl
 291+ 7D58 29               add  hl, hl                    ; Row * 32
 292+ 7D59 79               ld   a, c

2110+ 7E4A 38 12            jr   c, .done_advance
2111+ 7E4C
2112+ 7E4C                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2113+ 7E4C 68               ld   l, b                  ; L = Row
2114+ 7E4D 26 00            ld   h, 0
2115+ 7E4F 29               add  hl, hl
2115+ 7E50 29             add hl, hl
2115+ 7E51 29             add hl, hl
2115+ 7E52 29             add hl, hl
2115+ 7E53 29             add hl, hl
2116+ 7E54 59               ld   e, c
2117+ 7E55 16 00            ld   d, 0
2118+ 7E57 19               add  hl, de
2119+ 7E58 11 07 ED         ld   de, unpacked_layout
2120+ 7E5B 19               add  hl, de
2121+ 7E5C 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2122+ 7E5E
2123+ 7E5E              .done_advance:
2124+ 7E5E E1               pop  hl
2125+ 7E5F D1               pop  de
2126+ 7E60 C1               pop  bc
2127+ 7E61 C9               ret

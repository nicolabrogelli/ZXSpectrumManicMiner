 476+ 7FEB D6 02            sub  2
 477+ 7FED DD BE 04         cp   (ix+4)
 478+ 7FF0 28 08            jr   z, .v_rev_down
 479+ 7FF2 38 06            jr   c, .v_rev_down
 480+ 7FF4 DD 77 03         ld   (ix+3), a
 481+ 7FF7 C3 25 80         jp   .next
 482+ 7FFA

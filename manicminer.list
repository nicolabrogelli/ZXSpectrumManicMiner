  85+ 93B6 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  86+ 93B9 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  87+ 93BC 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato, 0 = Non completato
  88+ 93BD
  89+ 93BD 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  90+ 93BE 00           Audio_jump_sound_timer:   db 0
  91+ 93BF                  IF ENABLE_MUSIC != 0
  92+ 93BF ~            Audio_music_note_idx:      db 0
  93+ 93BF ~            Audio_music_frame_counter: db 1
  94+ 93BF                  ENDIF
  95+ 93BF
# file closed: data/datavariable.asm
 891  93BF
 892  93BF                  SAVESNA "manicminer.sna", start ; sna48-ok
 893  93BF

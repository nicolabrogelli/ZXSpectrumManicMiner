1278+ 7A96
1279+ 7A96              .is_floor:
1280+ 7A96 3E 01            ld   a, 1
1281+ 7A98 18 16            jr   .store_cell
1282+ 7A9A              .is_crumbling:
1283+ 7A9A 3E 02            ld   a, 2
1284+ 7A9C 18 12            jr   .store_cell
1285+ 7A9E              .is_wall:
1286+ 7A9E 3E 03            ld   a, 3
1287+ 7AA0 18 0E            jr   .store_cell
1288+ 7AA2              .is_conveyor:
1289+ 7AA2 3E 04            ld   a, 4
1290+ 7AA4 18 0A            jr   .store_cell
1291+ 7AA6              .is_nasty1:
1292+ 7AA6 3E 05            ld   a, 5
1293+ 7AA8 18 06            jr   .store_cell
1294+ 7AAA              .is_nasty2:
1295+ 7AAA 3E 06            ld   a, 6
1296+ 7AAC 18 02            jr   .store_cell
1297+ 7AAE              .is_extra:
1298+ 7AAE 3E 07            ld   a, 7

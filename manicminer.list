 881+ 822B 21 E4 DB         ld   hl, Willy
 882+ 822E 19               add  hl, de
 883+ 822F 22 4B F0         ld   (willy_body_ptr), hl      ; Corpo sinistro
 884+ 8232 18 18            jr   .willy_ptrs_ready
 885+ 8234
 886+ 8234              .willy_right:
 887+ 8234                  ; Willy a Destra:
 888+ 8234 21 E4 DB         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 889+ 8237 22 49 F0         ld   (willy_head_ptr), hl
 890+ 823A 3A 2A EA         ld   a, (body_state)           ; 0, 1, 2
 891+ 823D C6 01            add  a, 1                      ; tile 1, 2, 3
 892+ 823F 87               add  a, a

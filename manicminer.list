1199+ 649E 19               add  hl, de
1200+ 649F 06 20            ld   b, 32
1201+ 64A1 CD C7 60         call Gfx_PrintString
1202+ 64A4
1203+ 64A4                  ; 5. Stampa la riga di stato a riga 18
1204+ 64A4 3E 16            ld   a, 22                 ; Codice di controllo AT (22)
1205+ 64A6 D7               rst  $10
1206+ 64A7 3E 12            ld   a, 18                 ; Riga 18
1207+ 64A9 D7               rst  $10

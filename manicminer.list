   8+ 83D6              ; Audio_UpdateJumpSound
   9+ 83D6              ;
  10+ 83D6              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 83D6              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 83D6              ; -------------------------------------------------------------------
  13+ 83D6              Audio_UpdateJumpSound:
  14+ 83D6 F5               push af
  15+ 83D7 C5               push bc
  16+ 83D8 D5               push de
  17+ 83D9 E5               push hl
  18+ 83DA
  19+ 83DA                  ; Controlla se il suono è attivo (note < 18)
  20+ 83DA 3A FA CC         ld   a, (Audio_jump_sound_note)
  21+ 83DD FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 83DF 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 83E1
  24+ 83E1                  ; Carica la nota corrente da suonare
  25+ 83E1 5F               ld   e, a
  26+ 83E2 16 00            ld   d, 0
  27+ 83E4 21 10 84         ld   hl, Audio_JumpSoundDelays
  28+ 83E7 19               add  hl, de
  29+ 83E8 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 83E9 57               ld   d, a                      ; D = delay della nota
  31+ 83EA
  32+ 83EA                  ; Suona la nota: 15 cicli
  33+ 83EA 06 0F            ld   b, 15
  34+ 83EC              .note_loop:
  35+ 83EC                  ; Speaker ON
  36+ 83EC 3A EA C6         ld   a, (room_border_color)
  37+ 83EF F6 10            or   $10
  38+ 83F1 D3 FE            out  ($fe), a
  39+ 83F3 4A               ld   c, d
  40+ 83F4              .d1:
  41+ 83F4 0D               dec  c
  42+ 83F5 20 FD            jr   nz, .d1
  43+ 83F7
  44+ 83F7                  ; Speaker OFF
  45+ 83F7 3A EA C6         ld   a, (room_border_color)
  46+ 83FA E6 EF            and  $ef
  47+ 83FC D3 FE            out  ($fe), a
  48+ 83FE 4A               ld   c, d
  49+ 83FF              .d2:
  50+ 83FF 0D               dec  c
  51+ 8400 20 FD            jr   nz, .d2
  52+ 8402
  53+ 8402 10 E8            djnz .note_loop
  54+ 8404
  55+ 8404                  ; Passa alla nota successiva
  56+ 8404 3A FA CC         ld   a, (Audio_jump_sound_note)
  57+ 8407 3C               inc  a
  58+ 8408 32 FA CC         ld   (Audio_jump_sound_note), a

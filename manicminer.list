 862+ 6285              ; Gfx_DrawTitleScreen
 863+ 6285              ; Disegna la schermata iniziale (Title Screen):
 864+ 6285              ; - Bordo nero e pulizia schermo.
 865+ 6285              ; - Titolo "JET SET WILLY" e sottotitolo.
 866+ 6285              ; - Separatori grafici.
 867+ 6285              ; - Sprite decorativi (Willy a sinistra, Maria a destra).
 868+ 6285              ; - Obiettivo di gioco.
 869+ 6285              ; - Messaggio "PRESS ENTER TO START".
 870+ 6285              ; - Riepilogo controlli (O, P, Z, ENTER).
 871+ 6285              ; - Copyright.
 872+ 6285              ; (Tutte le righe sono comprese tra 0 e 20 per evitare errori "Out of screen" della ROM)
 873+ 6285              ; -------------------------------------------------------------------
 874+ 6285              Gfx_DrawTitleScreen:
 875+ 6285 F5               push af
 876+ 6286 C5               push bc
 877+ 6287 D5               push de
 878+ 6288 E5               push hl
 879+ 6289 DD E5            push ix
 880+ 628B
 881+ 628B                  ; 1. Bordo hardware e schermo a nero
 882+ 628B AF               xor  a
 883+ 628C D3 FE            out  ($fe), a              ; Bordo a nero
 884+ 628E 21 8D 5C         ld   hl, ATTR_P
 885+ 6291 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 886+ 6292 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 887+ 6295 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 888+ 6297 3E 07            ld   a, $07
 889+ 6299 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 890+ 629C
 891+ 629C                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
 892+ 629C 3E 16            ld   a, 22
 893+ 629E D7               rst  $10
 894+ 629F 3E 01            ld   a, 1
 895+ 62A1 D7               rst  $10
 896+ 62A2 3E 00            ld   a, 0
 897+ 62A4 D7               rst  $10
 898+ 62A5 21 5D 61         ld   hl, title_banner_1
 899+ 62A8 06 20            ld   b, 32
 900+ 62AA CD E8 60         call Gfx_PrintString
 901+ 62AD
 902+ 62AD                  ; Imposta attributi riga 1 a Giallo Brillante ($5820)
 903+ 62AD 21 20 58         ld   hl, $5820
 904+ 62B0 06 20            ld   b, 32
 905+ 62B2 3E 46            ld   a, YELLOW | $40
 906+ 62B4              .attr_r1:
 907+ 62B4 77               ld   (hl), a
 908+ 62B5 23               inc  hl
 909+ 62B6 10 FC            djnz .attr_r1
 910+ 62B8

 659+ 8392              ; -------------------------------------------------------------------
 660+ 8392              ; Score_CheckAndUpdateHighScore
 661+ 8392              ; Se player_score > high_score, copia player_score in high_score.
 662+ 8392              ; -------------------------------------------------------------------
 663+ 8392              Score_CheckAndUpdateHighScore:
 664+ 8392                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 8392                  ; Byte 2:
 666+ 8392 3A E1 C0         ld   a, (player_score + 2)
 667+ 8395 47               ld   b, a
 668+ 8396 3A E4 C0         ld   a, (high_score + 2)
 669+ 8399 B8               cp   b
 670+ 839A 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 839C 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 839E
 673+ 839E                  ; Byte 1:
 674+ 839E 3A E0 C0         ld   a, (player_score + 1)
 675+ 83A1 47               ld   b, a
 676+ 83A2 3A E3 C0         ld   a, (high_score + 1)
 677+ 83A5 B8               cp   b
 678+ 83A6 38 0C            jr   c, .new_high_score
 679+ 83A8 20 1C            jr   nz, .done_check
 680+ 83AA
 681+ 83AA                  ; Byte 0:
 682+ 83AA 3A DF C0         ld   a, (player_score + 0)
 683+ 83AD 47               ld   b, a
 684+ 83AE 3A E2 C0         ld   a, (high_score + 0)
 685+ 83B1 B8               cp   b
 686+ 83B2 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 83B4
 688+ 83B4              .new_high_score:
 689+ 83B4 3A DF C0         ld   a, (player_score + 0)
 690+ 83B7 32 E2 C0         ld   (high_score + 0), a
 691+ 83BA 3A E0 C0         ld   a, (player_score + 1)
 692+ 83BD 32 E3 C0         ld   (high_score + 1), a
 693+ 83C0 3A E1 C0         ld   a, (player_score + 2)
 694+ 83C3 32 E4 C0         ld   (high_score + 2), a
 695+ 83C6
 696+ 83C6              .done_check:
 697+ 83C6 C9               ret

 142+ 857A              ; Items_DrawRoom
 143+ 857A              ;
 144+ 857A              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 857A              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 857A              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 857A              ;
 148+ 857A              ; Record item nella stanza (5 byte):
 149+ 857A              ;   +0 Color / Attributo
 150+ 857A              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 857A              ;   +2 Attr Address High
 152+ 857A              ;   +3 Anim Mask (96)
 153+ 857A              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 857A              ; Fine lista: $FF
 155+ 857A              ; -------------------------------------------------------------------
 156+ 857A              Items_DrawRoom:
 157+ 857A E5               push hl
 158+ 857B D5               push de

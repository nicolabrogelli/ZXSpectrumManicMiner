 291  8B2C              ; ShowTitleScreen
 292  8B2C              ; Visualizza la schermata iniziale del gioco (Title Screen).
 293  8B2C              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 294  8B2C              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 295  8B2C              ; -------------------------------------------------------------------
 296  8B2C              ShowTitleScreen:
 297  8B2C                  ; 1. Disegna la schermata iniziale
 298  8B2C CD 91 64         call Gfx_DrawTitleScreen
 299  8B2F
 300  8B2F                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 301  8B2F              .wait_title_enter_release:
 302  8B2F 76               halt
 303  8B30 3E BF            ld   a, $bf
 304  8B32 DB FE            in   a, ($fe)
 305  8B34 1F               rra
 306  8B35 30 F8            jr   nc, .wait_title_enter_release
 307  8B37
 308  8B37                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 309  8B37 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 310  8B39              .title_loop:
 311  8B39 76               halt
 312  8B3A
 313  8B3A                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 314  8B3A 0C               inc  c
 315  8B3B 79               ld   a, c
 316  8B3C CB 3F            srl  a
 317  8B3E CB 3F            srl  a
 318  8B40 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 319  8B42 E6 07            and  7
 320  8B44 5F               ld   e, a
 321  8B45 16 00            ld   d, 0
 322  8B47 21 89 64         ld   hl, title_color_table
 323  8B4A 19               add  hl, de
 324  8B4B 7E               ld   a, (hl)               ; A = nuovo colore
 325  8B4C 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 326  8B4F 06 20            ld   b, 32
 327  8B51              .color_title_loop:
 328  8B51 77               ld   (hl), a
 329  8B52 23               inc  hl
 330  8B53 10 FC            djnz .color_title_loop
 331  8B55
 332  8B55                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 333  8B55 3E BF            ld   a, $bf
 334  8B57 DB FE            in   a, ($fe)
 335  8B59 1F               rra
 336  8B5A 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 337  8B5C
 338  8B5C                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 339  8B5C              .wait_title_enter_release_after:
 340  8B5C 76               halt
 341  8B5D 3E BF            ld   a, $bf

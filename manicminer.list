  93+ E7C4 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ E7C5 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ E7C6 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ E7C7 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

2077+ 7E27              .advance_crumble_cell:
2078+ 7E27                  ; Input: B = Row, C = Col
2079+ 7E27 C5               push bc
2080+ 7E28 D5               push de
2081+ 7E29 E5               push hl
2082+ 7E2A
2083+ 7E2A                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2084+ 7E2A 68               ld   l, b
2085+ 7E2B 26 00            ld   h, 0
2086+ 7E2D 29               add  hl, hl
2086+ 7E2E 29             add hl, hl
2086+ 7E2F 29             add hl, hl
2086+ 7E30 29             add hl, hl
2086+ 7E31 29             add hl, hl
2087+ 7E32 59               ld   e, c
2088+ 7E33 16 00            ld   d, 0
2089+ 7E35 19               add  hl, de
2090+ 7E36 11 85 F0         ld   de, crumbling_grid
2091+ 7E39 19               add  hl, de
2092+ 7E3A
2093+ 7E3A                  ; 2. Avanza di 1 stadio
2094+ 7E3A 7E               ld   a, (hl)               ; A = Stage (0..8)
2095+ 7E3B FE 08            cp   8

 706+ 8759              ; -------------------------------------------------------------------
 707+ 8759              ; Score_CheckAndUpdateHighScore
 708+ 8759              ; Se player_score > high_score, copia player_score in high_score.
 709+ 8759              ; -------------------------------------------------------------------
 710+ 8759              Score_CheckAndUpdateHighScore:
 711+ 8759                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 8759                  ; Byte 2:
 713+ 8759 3A 5C F0         ld   a, (player_score + 2)
 714+ 875C 47               ld   b, a
 715+ 875D 3A 5F F0         ld   a, (high_score + 2)
 716+ 8760 B8               cp   b
 717+ 8761 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 8763 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 8765
 720+ 8765                  ; Byte 1:
 721+ 8765 3A 5B F0         ld   a, (player_score + 1)
 722+ 8768 47               ld   b, a
 723+ 8769 3A 5E F0         ld   a, (high_score + 1)
 724+ 876C B8               cp   b
 725+ 876D 38 0C            jr   c, .new_high_score
 726+ 876F 20 1C            jr   nz, .done_check
 727+ 8771
 728+ 8771                  ; Byte 0:
 729+ 8771 3A 5A F0         ld   a, (player_score + 0)
 730+ 8774 47               ld   b, a
 731+ 8775 3A 5D F0         ld   a, (high_score + 0)
 732+ 8778 B8               cp   b
 733+ 8779 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 877B
 735+ 877B              .new_high_score:
 736+ 877B 3A 5A F0         ld   a, (player_score + 0)
 737+ 877E 32 5D F0         ld   (high_score + 0), a
 738+ 8781 3A 5B F0         ld   a, (player_score + 1)
 739+ 8784 32 5E F0         ld   (high_score + 1), a
 740+ 8787 3A 5C F0         ld   a, (player_score + 2)
 741+ 878A 32 5F F0         ld   (high_score + 2), a
 742+ 878D
 743+ 878D              .done_check:
 744+ 878D C9               ret

 305  8882              .title_loop:
 306  8882 76               halt
 307  8883
 308  8883                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 309  8883 0C               inc  c
 310  8884 79               ld   a, c
 311  8885 CB 3F            srl  a
 312  8887 CB 3F            srl  a
 313  8889 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)

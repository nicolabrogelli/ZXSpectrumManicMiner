2145+ 7CC5              .no_deplete:
2146+ 7CC5 B7               or   a                     ; Carry Clear = Ok
2147+ 7CC6 C9               ret
2148+ 7CC7
2149+ 7CC7              .air_finished:
2150+ 7CC7 37               scf                        ; Carry Set = Morte per esaurimento aria
2151+ 7CC8 C9               ret

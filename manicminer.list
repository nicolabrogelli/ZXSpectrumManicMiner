 173+ 7D87
 174+ 7D87                  ; Slot attivo per guardiano verticale
 175+ 7D87 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 176+ 7D8B DD 77 0A         ld   (ix+10), a                ; Color / Attributo

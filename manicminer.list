  68+ 7DF6 B7               or   a
  69+ 7DF7 28 75            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7DF9
  71+ 7DF9                  ; Slot attivo
  72+ 7DF9 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)

 253+ 7E07 2A 9E E5         ld   hl, (room_ptr)
 254+ 7E0A 11 DD B7         ld   de, ReturnoftheAlienKongBeastLayout
 255+ 7E0D B7               or   a
 256+ 7E0E ED 52            sbc  hl, de
 257+ 7E10 20 43            jr   nz, .not_kong
 258+ 7E12
 259+ 7E12              .is_kong_room2:
 260+ 7E12 3E 46            ld   a, 70                     ; Kong colore in Return of the Alien Kong: Bright 1, Paper 0, Ink 6 (Giallo) -> 70
 261+ 7E14 18 02            jr   .init_kong_slot
 262+ 7E16
 263+ 7E16              .is_kong_room1:
 264+ 7E16 3E 44            ld   a, 68                     ; Kong colore in Miner Willy meets the Kong Beast: Bright 1, Paper 0, Ink 4 (Verde) -> 68
 265+ 7E18
 266+ 7E18              .init_kong_slot:
 267+ 7E18 F5               push af
 268+ 7E19 3E 01            ld   a, 1
 269+ 7E1B 32 28 E6         ld   (room_has_v_guardians), a ; Segnala che i nemici orizzontali usano la seconda metà (frame 4..7)
 270+ 7E1E
 271+ 7E1E                  ; Inizializza Kong Beast nello Slot 3 (offset 33) di ActiveEnemies
 272+ 7E1E DD 21 6B 7C      ld   ix, ActiveEnemies + 33
 273+ 7E22 DD 36 00 A0      ld   (ix+0), $A0               ; Active = 1, Kong = 1 (Bit 7 + Bit 5)
 274+ 7E26 DD 36 01 00      ld   (ix+1), 0                 ; Frame iniziale = 0
 275+ 7E2A DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 276+ 7E2E DD 36 03 00      ld   (ix+3), 0                 ; Y = 0 (Ledge in alto)
 277+ 7E32 DD 36 04 00      ld   (ix+4), 0                 ; Min Y = 0
 278+ 7E36 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88
 279+ 7E3A DD 36 06 00      ld   (ix+6), 0                 ; Kong status = 0 (on ledge)
 280+ 7E3E DD 36 07 00      ld   (ix+7), 0
 281+ 7E42 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
 282+ 7E46 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
 283+ 7E4A F1               pop  af
 284+ 7E4B DD 77 0A         ld   (ix+10), a                ; Colore Kong
 285+ 7E4E
 286+ 7E4E                  ; Resetta lo stato degli interruttori di Kong
 287+ 7E4E AF               xor  a
 288+ 7E4F 32 2C E6         ld   (kong_switch_left), a
 289+ 7E52 32 2D E6         ld   (kong_switch_right), a
 290+ 7E55
 291+ 7E55              .not_kong:
 292+ 7E55 DD E1            pop  ix
 293+ 7E57 C1               pop  bc
 294+ 7E58 D1               pop  de
 295+ 7E59 E1               pop  hl
 296+ 7E5A C9               ret
 297+ 7E5B
 298+ 7E5B              ; -------------------------------------------------------------------
 299+ 7E5B              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 300+ 7E5B              ; -------------------------------------------------------------------
 301+ 7E5B              CheckEnemyWillyOverlap:
 302+ 7E5B 3A 24 E6         ld   a, (player_drawn_pos+1)
 303+ 7E5E FE FF            cp   $FF
 304+ 7E60 C8               ret  z                  ; Se Willy non è disegnato, esci
 305+ 7E61
 306+ 7E61                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 307+ 7E61 3A 23 E6         ld   a, (player_drawn_pos)
 308+ 7E64 E6 F8            and  $F8
 309+ 7E66 5F               ld   e, a               ; E = WillyX & $F8
 310+ 7E67 79               ld   a, c
 311+ 7E68 E6 F8            and  $F8                ; A = EnemyX & $F8
 312+ 7E6A 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 313+ 7E6B C6 10            add  a, 16
 314+ 7E6D FE 19            cp   25
 315+ 7E6F D0               ret  nc                 ; Fuori portata X
 316+ 7E70
 317+ 7E70                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 318+ 7E70 3A 24 E6         ld   a, (player_drawn_pos+1) ; A = WillyY
 319+ 7E73 90               sub  b                  ; A = WillyY - EnemyY
 320+ 7E74 C6 0F            add  a, 15
 321+ 7E76 FE 1F            cp   31
 322+ 7E78 D0               ret  nc                 ; Fuori portata Y
 323+ 7E79
 324+ 7E79                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 325+ 7E79 3E 01            ld   a, 1
 326+ 7E7B 32 2A E6         ld   (willy_needs_redraw), a
 327+ 7E7E C9               ret
 328+ 7E7F
 329+ 7E7F              ; -------------------------------------------------------------------
 330+ 7E7F              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 331+ 7E7F              ; -------------------------------------------------------------------
 332+ 7E7F              Enemy_EraseRoom:
 333+ 7E7F              Enemy_DrawRoom:
 334+ 7E7F              Enemy_RenderRoom:
 335+ 7E7F E5               push hl
 336+ 7E80 D5               push de
 337+ 7E81 C5               push bc
 338+ 7E82 DD E5            push ix
 339+ 7E84
 340+ 7E84                  ; ---------------------------------------------------------------
 341+ 7E84                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 342+ 7E84                  ; ---------------------------------------------------------------
 343+ 7E84 DD 21 4A 7C      ld   ix, ActiveEnemies
 344+ 7E88 06 08            ld   b, 8              ; 8 slot
 345+ 7E8A              .erase_loop:
 346+ 7E8A                  ; Se Old X == $FF (non ancora disegnato o già cancellato), non c'è nulla da cancellare
 347+ 7E8A DD 7E 08         ld   a, (ix+8)         ; Old X
 348+ 7E8D FE FF            cp   $FF
 349+ 7E8F 28 63            jr   z, .next_erase
 350+ 7E91
 351+ 7E91                  ; Controlla se lo slot è diventato inattivo (es. Kong caduto e morto)
 352+ 7E91 DD 7E 00         ld   a, (ix+0)         ; Flags
 353+ 7E94 E6 80            and  $80               ; Active?
 354+ 7E96 28 35            jr   z, .do_erase_inactive_slot
 355+ 7E98
 356+ 7E98                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 357+ 7E98 DD 7E 08         ld   a, (ix+8)         ; Old X
 358+ 7E9B DD BE 02         cp   (ix+2)            ; Current X
 359+ 7E9E 20 0E            jr   nz, .do_erase_slot
 360+ 7EA0 DD 7E 09         ld   a, (ix+9)         ; Old Y
 361+ 7EA3 DD BE 03         cp   (ix+3)            ; Current Y
 362+ 7EA6 20 06            jr   nz, .do_erase_slot
 363+ 7EA8
 364+ 7EA8 3A 27 E6         ld   a, (enemy_was_updated)
 365+ 7EAB B7               or   a
 366+ 7EAC 28 46            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 367+ 7EAE
 368+ 7EAE              .do_erase_slot:
 369+ 7EAE C5               push bc                ; Salva contatore ciclo
 370+ 7EAF
 371+ 7EAF                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 372+ 7EAF DD 4E 08         ld   c, (ix+8)         ; C = Old X
 373+ 7EB2 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 374+ 7EB5 CD 5B 7E         call CheckEnemyWillyOverlap
 375+ 7EB8
 376+ 7EB8                  ; Cancella il nemico nella VECCHIA posizione
 377+ 7EB8 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 378+ 7EBB DD 46 09         ld   b, (ix+9)         ; B = Old Y
 379+ 7EBE CD C1 5F         call Gfx_ErasePixelSprite16x16
 380+ 7EC1 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 381+ 7EC4 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 382+ 7EC7 CD 82 6D         call Gfx_RestoreEnemyColorAttributes
 383+ 7ECA
 384+ 7ECA C1               pop  bc
 385+ 7ECB 18 27            jr   .next_erase

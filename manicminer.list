2496+ 6ABC ~                ld   a, 1              ; map 3 to 1 -> cycle is 0, 1, 2, 1
2497+ 6ABC ~            .not_3:
2498+ 6ABC ~                inc  a
2499+ 6ABC ~                jr   .calc_ix
2500+ 6ABC                  ELSE
2501+ 6ABC 3E 01            ld   a, 1              ; frame statico 1
2502+ 6ABE                  ENDIF

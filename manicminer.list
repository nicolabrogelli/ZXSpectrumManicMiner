 786  8996              ; CheckAllItemsCollected
 787  8996              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  8996              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  8996              ; -------------------------------------------------------------------
 790  8996              CheckAllItemsCollected:
 791  8996 3A B4 E6         ld   a, (game_objective_completed)
 792  8999 B7               or   a
 793  899A 20 08            jr   nz, .all_collected
 794  899C 3A 1D E4         ld   a, (num_room_items)
 795  899F B7               or   a
 796  89A0 28 02            jr   z, .all_collected
 797  89A2 B7               or   a
 798  89A3 C9               ret

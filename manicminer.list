 231  84CD 76               halt
 232  84CE 10 FD            djnz .death_pause
 233  84D0
 234  84D0                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 235  84D0 AF               xor  a
 236  84D1 32 77 AA         ld   (velocity_y), a
 237  84D4 32 79 AA         ld   (jump_pressed), a
 238  84D7 32 7B AA         ld   (coyote_timer), a
 239  84DA 32 7E AA         ld   (jump_frame), a
 240  84DD 32 7D AA         ld   (jump_dir), a
 241  84E0 32 6F AA         ld   (body_state), a
 242  84E3 32 72 AE         ld   (player_old_body), a
 243  84E6 32 71 AE         ld   (player_old_dir), a
 244  84E9 32 74 AA         ld   (sprite_shift), a
 245  84EC 32 72 AA         ld   (collision_active), a
 246  84EF 32 75 AE         ld   (willy_needs_redraw), a
 247  84F2 32 7F AA         ld   (current_input_dir), a
 248  84F5 32 94 AD         ld   (conveyor_caught), a
 249  84F8 32 F0 AD         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 250  84FB 3E 01            ld   a, 1
 251  84FD 32 78 AA         ld   (on_ground), a
 252  8500
 253  8500 3E 00            ld   a, RESPAWN_SAFETY_TIME
 254  8502 32 74 AE         ld   (willy_safety_timer), a

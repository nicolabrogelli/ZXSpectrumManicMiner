1908+ 7BF5              ; Phys_UpdateAir
1909+ 7BF5              ; Aggiorna il consumo di aria durante ogni frame di gioco.
1910+ 7BF5              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
1911+ 7BF5              ; Output:
1912+ 7BF5              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
1913+ 7BF5              ;   Carry Clear = Aria ancora disponibile
1914+ 7BF5              ; -------------------------------------------------------------------
1915+ 7BF5              Phys_UpdateAir:
1916+ 7BF5                  ; Incrementa il timer dei frame
1917+ 7BF5 3A AC E7         ld   a, (air_timer)
1918+ 7BF8 3C               inc  a
1919+ 7BF9 32 AC E7         ld   (air_timer), a
1920+ 7BFC 21 AD E7         ld   hl, air_deplete_rate
1921+ 7BFF BE               cp   (hl)
1922+ 7C00 38 14            jr   c, .no_deplete
1923+ 7C02
1924+ 7C02                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
1925+ 7C02 AF               xor  a
1926+ 7C03 32 AC E7         ld   (air_timer), a
1927+ 7C06
1928+ 7C06 3A AB E7         ld   a, (air_pixels)
1929+ 7C09 B7               or   a
1930+ 7C0A 28 0C            jr   z, .air_finished
1931+ 7C0C
1932+ 7C0C 3D               dec  a
1933+ 7C0D 32 AB E7         ld   (air_pixels), a
1934+ 7C10 CD 27 6A         call Gfx_UpdateAirBar
1935+ 7C13
1936+ 7C13 B7               or   a
1937+ 7C14 28 02            jr   z, .air_finished
1938+ 7C16
1939+ 7C16              .no_deplete:
1940+ 7C16 B7               or   a                     ; Carry Clear = Ok
1941+ 7C17 C9               ret
1942+ 7C18
1943+ 7C18              .air_finished:
1944+ 7C18 37               scf                        ; Carry Set = Morte per esaurimento aria
1945+ 7C19 C9               ret

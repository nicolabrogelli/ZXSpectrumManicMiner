 312  8BDB
 313  8BDB                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 314  8BDB 0C               inc  c
 315  8BDC 79               ld   a, c
 316  8BDD CB 3F            srl  a
 317  8BDF CB 3F            srl  a
 318  8BE1 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 319  8BE3 E6 07            and  7
 320  8BE5 5F               ld   e, a
 321  8BE6 16 00            ld   d, 0
 322  8BE8 21 89 64         ld   hl, title_color_table
 323  8BEB 19               add  hl, de
 324  8BEC 7E               ld   a, (hl)               ; A = nuovo colore
 325  8BED 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 326  8BF0 06 20            ld   b, 32
 327  8BF2              .color_title_loop:
 328  8BF2 77               ld   (hl), a
 329  8BF3 23               inc  hl
 330  8BF4 10 FC            djnz .color_title_loop
 331  8BF6
 332  8BF6                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 333  8BF6 3E BF            ld   a, $bf
 334  8BF8 DB FE            in   a, ($fe)
 335  8BFA 1F               rra
 336  8BFB 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 337  8BFD
 338  8BFD                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 339  8BFD              .wait_title_enter_release_after:
 340  8BFD 76               halt
 341  8BFE 3E BF            ld   a, $bf
 342  8C00 DB FE            in   a, ($fe)
 343  8C02 1F               rra
 344  8C03 30 F8            jr   nc, .wait_title_enter_release_after
 345  8C05
 346  8C05                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 347  8C05 AF               xor  a
 348  8C06 D3 FE            out  ($fe), a              ; Bordo a nero
 349  8C08 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 350  8C0B
 351  8C0B                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 352  8C0B CD CF 8D         call ResetFullGameState
 353  8C0E
 354  8C0E                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 355  8C0E C3 85 8A         jp   LoadRoomAndRestart
 356  8C11
 357  8C11              ; -------------------------------------------------------------------
 358  8C11              ; TriggerGameOver
 359  8C11              ; Scatena la sequenza originale di Game Over:
 360  8C11              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 361  8C11              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 362  8C11              ;   con suono beeper originale e lampeggio dello schermo.
 363  8C11              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 364  8C11              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 365  8C11              ; -------------------------------------------------------------------
 366  8C11              TriggerGameOver:
 367  8C11                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 368  8C11 CD EB 88         call Score_CheckAndUpdateHighScore
 369  8C14
 370  8C14                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 371  8C14 CD 29 66         call Gfx_DrawGameOverScreen
 372  8C17
 373  8C17                  ; 3. Ritorna al Title Screen originale
 374  8C17 C3 CD 8B         jp   ShowTitleScreen
 375  8C1A
 376  8C1A              ; -------------------------------------------------------------------
 377  8C1A              ; TriggerVictory
 378  8C1A              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 379  8C1A              ; - Pulisce gli elementi di gioco della stanza.
 380  8C1A              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 381  8C1A              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 382  8C1A              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 383  8C1A              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 384  8C1A              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 385  8C1A              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 386  8C1A              ; -------------------------------------------------------------------
 387  8C1A              TriggerVictory:
 388  8C1A                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 389  8C1A CD EB 88         call Score_CheckAndUpdateHighScore
 390  8C1D
 391  8C1D                  ; 2. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 392  8C1D CD 14 67         call Gfx_DrawVictoryScreen
 393  8C20
 394  8C20                  ; 3. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 395  8C20              .wait_keys_release:
 396  8C20 76               halt
 397  8C21                  ; Controlla tasto Y (Porta $DF, bit 4)
 398  8C21 01 FE DF         ld   bc, $dffe
 399  8C24 ED 78            in   a, (c)
 400  8C26 CB 67            bit  4, a
 401  8C28 28 F6            jr   z, .wait_keys_release
 402  8C2A
 403  8C2A                  ; Controlla tasto N (Porta $7F, bit 3)
 404  8C2A 01 FE 7F         ld   bc, $7ffe
 405  8C2D ED 78            in   a, (c)
 406  8C2F CB 5F            bit  3, a
 407  8C31 28 ED            jr   z, .wait_keys_release
 408  8C33
 409  8C33                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 410  8C33 01 FE BF         ld   bc, $bffe
 411  8C36 ED 78            in   a, (c)
 412  8C38 CB 47            bit  0, a
 413  8C3A 28 E4            jr   z, .wait_keys_release
 414  8C3C
 415  8C3C                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 416  8C3C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 417  8C3E              .wait_choice_loop:
 418  8C3E 76               halt
 419  8C3F
 420  8C3F                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 421  8C3F 0C               inc  c
 422  8C40 79               ld   a, c
 423  8C41 CB 3F            srl  a
 424  8C43 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 425  8C45 E6 07            and  7
 426  8C47 5F               ld   e, a
 427  8C48 16 00            ld   d, 0
 428  8C4A 21 0B 66         ld   hl, victory_color_table
 429  8C4D 19               add  hl, de
 430  8C4E 7E               ld   a, (hl)               ; A = nuovo colore attributo
 431  8C4F 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 432  8C52 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 433  8C54              .color_cycle_loop:
 434  8C54 77               ld   (hl), a
 435  8C55 23               inc  hl
 436  8C56 10 FC            djnz .color_cycle_loop
 437  8C58
 438  8C58                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 439  8C58 01 FE DF         ld   bc, $dffe
 440  8C5B ED 78            in   a, (c)
 441  8C5D CB 67            bit  4, a
 442  8C5F 28 2A            jr   z, .play_again_chosen
 443  8C61
 444  8C61                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 445  8C61 01 FE 7F         ld   bc, $7ffe
 446  8C64 ED 78            in   a, (c)
 447  8C66 CB 5F            bit  3, a
 448  8C68 28 0B            jr   z, .quit_chosen
 449  8C6A
 450  8C6A                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 451  8C6A 01 FE BF         ld   bc, $bffe
 452  8C6D ED 78            in   a, (c)
 453  8C6F CB 47            bit  0, a
 454  8C71 28 02            jr   z, .quit_chosen
 455  8C73
 456  8C73 18 C9            jr   .wait_choice_loop
 457  8C75
 458  8C75              .quit_chosen:
 459  8C75                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 460  8C75              .wait_quit_release:
 461  8C75 76               halt
 462  8C76 01 FE 7F         ld   bc, $7ffe
 463  8C79 ED 78            in   a, (c)
 464  8C7B CB 5F            bit  3, a
 465  8C7D 28 F6            jr   z, .wait_quit_release
 466  8C7F 01 FE BF         ld   bc, $bffe
 467  8C82 ED 78            in   a, (c)
 468  8C84 CB 47            bit  0, a
 469  8C86 28 ED            jr   z, .wait_quit_release
 470  8C88
 471  8C88                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 472  8C88 C3 CD 8B         jp   ShowTitleScreen
 473  8C8B
 474  8C8B              .play_again_chosen:
 475  8C8B                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 476  8C8B              .wait_play_again_release:
 477  8C8B 76               halt
 478  8C8C 01 FE DF         ld   bc, $dffe
 479  8C8F ED 78            in   a, (c)
 480  8C91 CB 67            bit  4, a
 481  8C93 28 F6            jr   z, .wait_play_again_release
 482  8C95
 483  8C95                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 484  8C95 CD CF 8D         call ResetFullGameState
 485  8C98 C3 85 8A         jp   LoadRoomAndRestart
 486  8C9B
 487  8C9B              ; -------------------------------------------------------------------
 488  8C9B              ; CheckPortalTransition
 489  8C9B              ; Verifica le condizioni per accedere alla stanza successiva:
 490  8C9B              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 491  8C9B              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 492  8C9B              ;
 493  8C9B              ; Output:
 494  8C9B              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 495  8C9B              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 496  8C9B              ; -------------------------------------------------------------------
 497  8C9B              CheckPortalTransition:
 498  8C9B C5               push bc
 499  8C9C D5               push de
 500  8C9D E5               push hl
 501  8C9E
 502  8C9E                  ; 1. Tutti gli item della stanza sono stati raccolti?
 503  8C9E CD 62 8D         call CheckAllItemsCollected
 504  8CA1 30 4D            jr   nc, .no_transition
 505  8CA3
 506  8CA3                  ; 2. Willy collide con il portale (16x16 pixel)?
 507  8CA3                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 508  8CA3                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 509  8CA3 2A F5 EF         ld   hl, (room_ptr)
 510  8CA6 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 511  8CA9 19               add  hl, de
 512  8CAA 4E               ld   c, (hl)
 513  8CAB 23               inc  hl
 514  8CAC 46               ld   b, (hl)                   ; BC = AttrAddr
 515  8CAD
 516  8CAD                  ; Offset = BC - 23552
 517  8CAD 60               ld   h, b
 518  8CAE 69               ld   l, c
 519  8CAF 01 00 A4         ld   bc, -23552
 520  8CB2 09               add  hl, bc
 521  8CB3
 522  8CB3                  ; PortalX = (Offset & 31) * 8
 523  8CB3 7D               ld   a, l
 524  8CB4 E6 1F            and  31
 525  8CB6 87               add  a, a
 525  8CB7 87             add a, a
 525  8CB8 87             add a, a
 526  8CB9 5F               ld   e, a                      ; E = PortalX (0..248)
 527  8CBA
 528  8CBA                  ; PortalY = (Offset / 32) * 8
 529  8CBA CB 3C            srl  h
 529  8CBC CB 1D          rr l
 530  8CBE CB 3C            srl  h
 530  8CC0 CB 1D          rr l
 531  8CC2 CB 3C            srl  h
 531  8CC4 CB 1D          rr l
 532  8CC6 CB 3C            srl  h
 532  8CC8 CB 1D          rr l
 533  8CCA CB 3C            srl  h
 533  8CCC CB 1D          rr l
 534  8CCE 7D               ld   a, l
 535  8CCF 87               add  a, a
 535  8CD0 87             add a, a
 535  8CD1 87             add a, a
 536  8CD2 57               ld   d, a                      ; D = PortalY (0..120)
 537  8CD3
 538  8CD3                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 539  8CD3 ED 4B 72 EC      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 540  8CD7
 541  8CD7                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 542  8CD7 7B               ld   a, e
 543  8CD8 91               sub  c
 544  8CD9 30 02            jr   nc, .x_diff_pos
 545  8CDB ED 44            neg
 546  8CDD              .x_diff_pos:
 547  8CDD FE 0C            cp   12
 548  8CDF 30 0F            jr   nc, .no_transition
 549  8CE1
 550  8CE1                  ; Controllo verticale: |WillyY - PortalY| < 14
 551  8CE1 7A               ld   a, d
 552  8CE2 90               sub  b
 553  8CE3 30 02            jr   nc, .y_diff_pos
 554  8CE5 ED 44            neg
 555  8CE7              .y_diff_pos:
 556  8CE7 FE 0E            cp   14
 557  8CE9 30 05            jr   nc, .no_transition
 558  8CEB
 559  8CEB                  ; Transizione al portale attiva!
 560  8CEB E1               pop  hl
 561  8CEC D1               pop  de
 562  8CED C1               pop  bc
 563  8CEE 37               scf
 564  8CEF C9               ret
 565  8CF0
 566  8CF0              .no_transition:
 567  8CF0 E1               pop  hl
 568  8CF1 D1               pop  de
 569  8CF2 C1               pop  bc
 570  8CF3 B7               or   a
 571  8CF4 C9               ret
 572  8CF5
 573  8CF5              ; Alias per retrocompatibilità
 574  8CF5              CheckVictoryCondition: EQU CheckPortalTransition
 575  8CF5
 576  8CF5              ; -------------------------------------------------------------------
 577  8CF5              ; TriggerPortalTransition
 578  8CF5              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 579  8CF5              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 580  8CF5              ; - Avanza all'indice della stanza successiva.
 581  8CF5              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 582  8CF5              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 583  8CF5              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 584  8CF5              ; -------------------------------------------------------------------
 585  8CF5              TriggerPortalTransition:
 586  8CF5                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 587  8CF5 CD 2C 8D         call Air_DepleteCountdown
 588  8CF8
 589  8CF8                  ; 1. Determina l'ID della stanza corrente
 590  8CF8 CD 2C 86         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 591  8CFB
 592  8CFB                  ; 2. Calcola l'indice della stanza successiva
 593  8CFB 3A 9A EF         ld   a, (current_room)
 594  8CFE 3C               inc  a
 595  8CFF FE 14            cp   NUM_ROOMS
 596  8D01 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 597  8D03
 598  8D03                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 599  8D03 21 3D 74         ld   hl, RoomsListTable
 600  8D06 5F               ld   e, a
 601  8D07 16 00            ld   d, 0
 602  8D09 19               add  hl, de
 603  8D0A 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 604  8D0B 5E               ld   e, (hl)
 605  8D0C 23               inc  hl
 606  8D0D 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 607  8D0E ED 53 F5 EF      ld   (room_ptr), de
 608  8D12
 609  8D12                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 610  8D12 AF               xor  a
 611  8D13 32 FB EF         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 612  8D16 32 80 EC         ld   (velocity_y), a
 613  8D19 32 8D F2         ld   (game_objective_completed), a
 614  8D1C 3E 01            ld   a, 1
 615  8D1E 32 81 EC         ld   (on_ground), a
 616  8D21
 617  8D21                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 618  8D21 3E 07            ld   a, $07
 619  8D23 CD 9D 62         call Gfx_ClearScreenDirect
 620  8D26
 621  8D26 C3 85 8A         jp   LoadRoomAndRestart
 622  8D29
 623  8D29              .all_rooms_completed:
 624  8D29                  ; Tutte le stanze sono state completate con successo!
 625  8D29                  IF ENABLE_VICTORY_SCREEN != 0
 626  8D29 C3 1A 8C         jp   TriggerVictory
 627  8D2C                  ELSE
 628  8D2C ~                ; Ricomincia dalla prima stanza (Stanza 00)
 629  8D2C ~                ld   de, (RoomsListTable)
 630  8D2C ~                ld   (room_ptr), de
 631  8D2C ~                xor  a
 632  8D2C ~                ld   (transition_active), a
 633  8D2C ~                ld   (velocity_y), a
 634  8D2C ~                ld   (game_objective_completed), a
 635  8D2C ~                ld   a, 1
 636  8D2C ~                ld   (on_ground), a
 637  8D2C ~                ld   a, $07
 638  8D2C ~                call Gfx_ClearScreenDirect
 639  8D2C ~                jp   LoadRoomAndRestart
 640  8D2C                  ENDIF
 641  8D2C
 642  8D2C              ; -------------------------------------------------------------------
 643  8D2C              ; Air_DepleteCountdown
 644  8D2C              ; Animazione originale di completamento livello (Manic Miner):
 645  8D2C              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 646  8D2C              ; - Ad ogni pixel decrementato:
 647  8D2C              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 648  8D2C              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 649  8D2C              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 650  8D2C              ; -------------------------------------------------------------------
 651  8D2C              Air_DepleteCountdown:
 652  8D2C F5               push af
 653  8D2D C5               push bc
 654  8D2E D5               push de
 655  8D2F E5               push hl
 656  8D30
 657  8D30              .countdown_loop:
 658  8D30 3A 98 F2         ld   a, (air_pixels)
 659  8D33 B7               or   a
 660  8D34 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 661  8D36
 662  8D36 3D               dec  a
 663  8D37 32 98 F2         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 664  8D3A
 665  8D3A                  ; Aggiorna la barra grafica dell'aria
 666  8D3A CD 42 6A         call Gfx_UpdateAirBar
 667  8D3D
 668  8D3D                  ; Aggiungi 1 punto allo score
 669  8D3D CD A0 88         call Score_Add1Point
 670  8D40
 671  8D40                  ; Genera l'effetto sonoro originale di Manic Miner:
 672  8D40                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 673  8D40 3A 98 F2         ld   a, (air_pixels)
 674  8D43 2F               cpl
 675  8D44 E6 3F            and  63
 676  8D46 07               rlca
 677  8D47 3C               inc  a
 678  8D48 57               ld   d, a                      ; D = ritardo semionda audio
 679  8D49
 680  8D49 0E 03            ld   c, 3                      ; Durata impulso
 681  8D4B              .audio_loop:
 682  8D4B AF               xor  a
 683  8D4C D3 FE            out  ($fe), a
 684  8D4E 42               ld   b, d
 685  8D4F 10 FE        .w1: djnz .w1
 686  8D51
 687  8D51 3E 18            ld   a, $18
 688  8D53 D3 FE            out  ($fe), a
 689  8D55 42               ld   b, d
 690  8D56 10 FE        .w2: djnz .w2
 691  8D58
 692  8D58 0D               dec  c
 693  8D59 20 F0            jr   nz, .audio_loop
 694  8D5B
 695  8D5B 18 D3            jr   .countdown_loop
 696  8D5D
 697  8D5D              .done_countdown:
 698  8D5D E1               pop  hl
 699  8D5E D1               pop  de
 700  8D5F C1               pop  bc
 701  8D60 F1               pop  af
 702  8D61 C9               ret
 703  8D62
 704  8D62              ; -------------------------------------------------------------------
 705  8D62              ; CheckAllItemsCollected
 706  8D62              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 707  8D62              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8D62              ; -------------------------------------------------------------------
 709  8D62              CheckAllItemsCollected:
 710  8D62 3A 8D F2         ld   a, (game_objective_completed)
 711  8D65 B7               or   a
 712  8D66 20 08            jr   nz, .all_collected
 713  8D68 3A F4 EF         ld   a, (num_room_items)
 714  8D6B B7               or   a
 715  8D6C 28 02            jr   z, .all_collected
 716  8D6E B7               or   a
 717  8D6F C9               ret
 718  8D70              .all_collected:
 719  8D70 37               scf
 720  8D71 C9               ret
 721  8D72
 722  8D72              ; -------------------------------------------------------------------
 723  8D72              ; CheckInMasterBedroom (alias per retrocompatibilità)
 724  8D72              ; -------------------------------------------------------------------
 725  8D72              CheckInMasterBedroom:
 726  8D72 37               scf
 727  8D73 C9               ret
 728  8D74
 729  8D74              ; -------------------------------------------------------------------
 730  8D74              ; CheckWillyConveyorCollision
 731  8D74              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 732  8D74              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 733  8D74              ; -------------------------------------------------------------------
 734  8D74              CheckWillyConveyorCollision:
 735  8D74 C5               push bc
 736  8D75 D5               push de
 737  8D76 E5               push hl
 738  8D77
 739  8D77                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 740  8D77 CD 1D 79         call CheckWillyOnConveyor
 741  8D7A 38 49            jr   c, .collision_detected
 742  8D7C
 743  8D7C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 744  8D7C 3A 9C EF         ld   a, (conveyor_len)
 745  8D7F B7               or   a
 746  8D80 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente

 581  8633
 582  8633                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 583  8633 0C               inc  c
 584  8634 79               ld   a, c
 585  8635 CB 3F            srl  a
 586  8637 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 587  8639 E6 07            and  7
 588  863B 5F               ld   e, a
 589  863C 16 00            ld   d, 0
 590  863E 21 D6 65         ld   hl, victory_color_table
 591  8641 19               add  hl, de

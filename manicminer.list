 648+ 8017 06 08            ld   b, 8                      ; 8 slot
 649+ 8019
 650+ 8019              .enemy_loop:
 651+ 8019 DD 7E 00         ld   a, (ix+0)
 652+ 801C E6 80            and  $80                       ; Active?
 653+ 801E CA 1E 81         jp   z, .next_enemy
 654+ 8021
 655+ 8021                  ; ---------------------------------------------------------------
 656+ 8021                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 657+ 8021                  ; ---------------------------------------------------------------
 658+ 8021                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 659+ 8021 3A 09 DF         ld   a, (PlayerPos)            ; WillyX
 660+ 8024 DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 661+ 8027 FE 10            cp   16
 662+ 8029 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 663+ 802B FE F9            cp   249                       ; 249..255 = -7..-1
 664+ 802D DA 1E 81         jp   c, .next_enemy            ; 16..248 -> fuori range
 665+ 8030              .x_in_range:
 666+ 8030 32 31 E5         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 667+ 8033
 668+ 8033                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 669+ 8033 3A 0A DF         ld   a, (PlayerPos+1)          ; WillyY
 670+ 8036 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 671+ 8039 FE 10            cp   16
 672+ 803B 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 673+ 803D FE F1            cp   241                       ; 241..255 = -15..-1
 674+ 803F DA 1E 81         jp   c, .next_enemy            ; 16..240 -> fuori range
 675+ 8042              .y_in_range:
 676+ 8042 32 32 E5         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)

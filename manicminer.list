 181+ 8729              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8729              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8729              ; -------------------------------------------------------------------
 184+ 8729              Audio_PlayCollectSound:
 185+ 8729 C5               push bc
 186+ 872A D5               push de
 187+ 872B
 188+ 872B 06 78            ld   b, 120
 189+ 872D              .sound_loop:
 190+ 872D 3A 29 E2         ld   a, (room_border_color)
 191+ 8730 F6 10            or   $10               ; speaker ON
 192+ 8732 D3 FE            out  ($fe), a
 193+ 8734
 194+ 8734 0E 3C            ld   c, 60
 195+ 8736              .d1:
 196+ 8736 0D               dec  c
 197+ 8737 20 FD            jr   nz, .d1
 198+ 8739
 199+ 8739 3A 29 E2         ld   a, (room_border_color)
 200+ 873C E6 EF            and  $ef              ; speaker OFF
 201+ 873E D3 FE            out  ($fe), a
 202+ 8740
 203+ 8740 0E 3C            ld   c, 60
 204+ 8742              .d2:
 205+ 8742 0D               dec  c
 206+ 8743 20 FD            jr   nz, .d2
 207+ 8745
 208+ 8745 10 E6            djnz .sound_loop
 209+ 8747
 210+ 8747 D1               pop  de
 211+ 8748 C1               pop  bc
 212+ 8749 C9               ret
 213+ 874A

 331  80B5                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 332  80B5 AF               xor  a
 333  80B6 D3 FE            out  ($fe), a              ; Bordo a nero
 334  80B8 21 8D 5C         ld   hl, ATTR_P
 335  80BB 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 336  80BC CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 337  80BF 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 338  80C1 3E 07            ld   a, $07
 339  80C3 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07

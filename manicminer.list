1819+ 67AA 0F               rrca
1820+ 67AB 0F               rrca
1821+ 67AC 0F               rrca
1822+ 67AD E6 0F            and  $0f
1823+ 67AF C6 30            add  a, '0'
1824+ 67B1 77               ld   (hl), a
1825+ 67B2 23               inc  hl
1826+ 67B3
1827+ 67B3                  ; Cifra 1 (decine di migliaia)
1828+ 67B3 DD 7E 02         ld   a, (ix+2)
1829+ 67B6 E6 0F            and  $0f
1830+ 67B8 C6 30            add  a, '0'
1831+ 67BA 77               ld   (hl), a
1832+ 67BB 23               inc  hl
1833+ 67BC
1834+ 67BC                  ; Cifra 2 (migliaia)
1835+ 67BC DD 7E 01         ld   a, (ix+1)
1836+ 67BF 0F               rrca
1837+ 67C0 0F               rrca
1838+ 67C1 0F               rrca
1839+ 67C2 0F               rrca
1840+ 67C3 E6 0F            and  $0f
1841+ 67C5 C6 30            add  a, '0'
1842+ 67C7 77               ld   (hl), a
1843+ 67C8 23               inc  hl
1844+ 67C9
1845+ 67C9                  ; Cifra 3 (centinaia)
1846+ 67C9 DD 7E 01         ld   a, (ix+1)
1847+ 67CC E6 0F            and  $0f
1848+ 67CE C6 30            add  a, '0'
1849+ 67D0 77               ld   (hl), a
1850+ 67D1 23               inc  hl
1851+ 67D2
1852+ 67D2                  ; Cifra 4 (decine)
1853+ 67D2 DD 7E 00         ld   a, (ix+0)
1854+ 67D5 0F               rrca
1855+ 67D6 0F               rrca
1856+ 67D7 0F               rrca
1857+ 67D8 0F               rrca
1858+ 67D9 E6 0F            and  $0f
1859+ 67DB C6 30            add  a, '0'
1860+ 67DD 77               ld   (hl), a
1861+ 67DE 23               inc  hl
1862+ 67DF
1863+ 67DF                  ; Cifra 5 (unità)
1864+ 67DF DD 7E 00         ld   a, (ix+0)
1865+ 67E2 E6 0F            and  $0f
1866+ 67E4 C6 30            add  a, '0'
1867+ 67E6 77               ld   (hl), a
1868+ 67E7 23               inc  hl
1869+ 67E8 C9               ret

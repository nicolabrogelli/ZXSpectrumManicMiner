  59+ 804A              ; ResetItemsTable
  60+ 804A              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 804A              ; per tutte le stanze registrate in RoomsListTable.
  62+ 804A              ; -------------------------------------------------------------------
  63+ 804A              ResetItemsTable:
  64+ 804A E5               push hl
  65+ 804B D5               push de
  66+ 804C C5               push bc
  67+ 804D
  68+ 804D 21 0D 73         ld   hl, RoomsListTable
  69+ 8050 06 02            ld   b, NUM_ROOMS
  70+ 8052
  71+ 8052              .room_loop:
  72+ 8052 C5               push bc
  73+ 8053 5E               ld   e, (hl)
  74+ 8054 23               inc  hl
  75+ 8055 56               ld   d, (hl)
  76+ 8056 23               inc  hl
  77+ 8057 E5               push hl
  78+ 8058
  79+ 8058                  ; DE = room_ptr
  80+ 8058 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 805B 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 805C
  83+ 805C              .item_loop:

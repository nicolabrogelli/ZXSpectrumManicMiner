 472  895D                  ; - Reimposta la fisica e le variabili di stato di Willy
 473  895D AF               xor  a
 474  895E 32 E0 E1         ld   (velocity_y), a
 475  8961 32 E2 E1         ld   (jump_pressed), a
 476  8964 32 E4 E1         ld   (coyote_timer), a
 477  8967 32 E7 E1         ld   (jump_frame), a
 478  896A 32 E6 E1         ld   (jump_dir), a
 479  896D 32 D8 E1         ld   (body_state), a
 480  8970 32 EB E1         ld   (w_warp_state), a
 481  8973 32 EE E1         ld   (w_key_prev), a
 482  8976 32 EF E1         ld   (enter_key_prev), a
 483  8979 32 DB E1         ld   (collision_active), a
 484  897C 32 DA E1         ld   (flags), a
 485  897F 32 D4 E5         ld   (ramp_entry_guard), a
 486  8982 32 E0 E5         ld   (willy_on_ramp), a
 487  8985 32 DF E5         ld   (willy_needs_redraw), a
 488  8988 3E FF            ld   a, $ff
 489  898A 32 F0 E1         ld   (digit_key_prev), a
 490  898D 32 D9 E5         ld   (player_drawn_pos+1), a
 491  8990 32 DA E5         ld   (player_old_dir), a
 492  8993 32 DB E5         ld   (player_old_body), a
 493  8996 3E 01            ld   a, 1
 494  8998 32 E9 E1         ld   (q_prev), a
 495  899B 32 EA E1         ld   (a_prev), a
 496  899E 32 E1 E1         ld   (on_ground), a
 497  89A1 32 DC E5         ld   (enemy_was_updated), a
 498  89A4
 499  89A4                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 500  89A4 3E 00            ld   a, RESPAWN_SAFETY_TIME
 501  89A6 32 DE E5         ld   (willy_safety_timer), a
 502  89A9
 503  89A9                  ; - Ripristina lo stato audio
 504  89A9 3E 12            ld   a, 18
 505  89AB 32 F1 E7         ld   (Audio_jump_sound_note), a
 506  89AE AF               xor  a
 507  89AF 32 F2 E7         ld   (Audio_jump_sound_timer), a
 508  89B2                  IF ENABLE_MUSIC != 0
 509  89B2 ~                ld   (Audio_music_note_idx), a
 510  89B2 ~                ld   a, 1
 511  89B2 ~                ld   (Audio_music_frame_counter), a
 512  89B2                  ENDIF
 513  89B2
 514  89B2                  ; - Riposiziona Willy nel punto di default definito nella stanza
 515  89B2 AF               xor  a
 516  89B3 32 59 E5         ld   (transition_active), a
 517  89B6
 518  89B6                  ; - Cancella lo schermo a nero prima del caricamento
 519  89B6 AF               xor  a
 520  89B7 D3 FE            out  ($fe), a
 521  89B9 CD 99 62         call Gfx_ClearScreenDirect
 522  89BC
 523  89BC                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 524  89BC C3 57 87         jp   LoadRoomAndRestart
 525  89BF
 526  89BF              ; -------------------------------------------------------------------
 527  89BF              ; TriggerVictory
 528  89BF              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 529  89BF              ; - Pulisce gli elementi di gioco della stanza.
 530  89BF              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 531  89BF              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 532  89BF              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 533  89BF              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 534  89BF              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 535  89BF              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 536  89BF              ; -------------------------------------------------------------------
 537  89BF              TriggerVictory:
 538  89BF                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 539  89BF CD F3 66         call Gfx_DrawVictoryScreen
 540  89C2
 541  89C2                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 542  89C2              .wait_keys_release:
 543  89C2 76               halt
 544  89C3                  ; Controlla tasto Y (Porta $DF, bit 4)
 545  89C3 01 FE DF         ld   bc, $dffe
 546  89C6 ED 78            in   a, (c)
 547  89C8 CB 67            bit  4, a
 548  89CA 28 F6            jr   z, .wait_keys_release
 549  89CC
 550  89CC                  ; Controlla tasto N (Porta $7F, bit 3)
 551  89CC 01 FE 7F         ld   bc, $7ffe
 552  89CF ED 78            in   a, (c)
 553  89D1 CB 5F            bit  3, a
 554  89D3 28 ED            jr   z, .wait_keys_release
 555  89D5
 556  89D5                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 557  89D5 01 FE BF         ld   bc, $bffe
 558  89D8 ED 78            in   a, (c)
 559  89DA CB 47            bit  0, a
 560  89DC 28 E4            jr   z, .wait_keys_release
 561  89DE
 562  89DE                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 563  89DE 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 564  89E0              .wait_choice_loop:
 565  89E0 76               halt
 566  89E1
 567  89E1                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 568  89E1 0C               inc  c
 569  89E2 79               ld   a, c
 570  89E3 CB 3F            srl  a
 571  89E5 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 572  89E7 E6 07            and  7
 573  89E9 5F               ld   e, a
 574  89EA 16 00            ld   d, 0
 575  89EC 21 0D 66         ld   hl, victory_color_table
 576  89EF 19               add  hl, de
 577  89F0 7E               ld   a, (hl)               ; A = nuovo colore attributo
 578  89F1 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 579  89F4 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 580  89F6              .color_cycle_loop:
 581  89F6 77               ld   (hl), a
 582  89F7 23               inc  hl
 583  89F8 10 FC            djnz .color_cycle_loop
 584  89FA
 585  89FA                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 586  89FA 01 FE DF         ld   bc, $dffe
 587  89FD ED 78            in   a, (c)
 588  89FF CB 67            bit  4, a
 589  8A01 28 2A            jr   z, .play_again_chosen
 590  8A03
 591  8A03                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 592  8A03 01 FE 7F         ld   bc, $7ffe
 593  8A06 ED 78            in   a, (c)
 594  8A08 CB 5F            bit  3, a
 595  8A0A 28 0B            jr   z, .quit_chosen
 596  8A0C
 597  8A0C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 598  8A0C 01 FE BF         ld   bc, $bffe
 599  8A0F ED 78            in   a, (c)
 600  8A11 CB 47            bit  0, a
 601  8A13 28 02            jr   z, .quit_chosen
 602  8A15
 603  8A15 18 C9            jr   .wait_choice_loop
 604  8A17
 605  8A17              .quit_chosen:
 606  8A17                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 607  8A17              .wait_quit_release:
 608  8A17 76               halt
 609  8A18 01 FE 7F         ld   bc, $7ffe
 610  8A1B ED 78            in   a, (c)
 611  8A1D CB 5F            bit  3, a
 612  8A1F 28 F6            jr   z, .wait_quit_release
 613  8A21 01 FE BF         ld   bc, $bffe
 614  8A24 ED 78            in   a, (c)
 615  8A26 CB 47            bit  0, a
 616  8A28 28 ED            jr   z, .wait_quit_release
 617  8A2A
 618  8A2A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 619  8A2A C3 93 88         jp   ShowTitleScreen
 620  8A2D
 621  8A2D              .play_again_chosen:
 622  8A2D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 623  8A2D              .wait_play_again_release:
 624  8A2D 76               halt
 625  8A2E 01 FE DF         ld   bc, $dffe
 626  8A31 ED 78            in   a, (c)
 627  8A33 CB 67            bit  4, a
 628  8A35 28 F6            jr   z, .wait_play_again_release
 629  8A37
 630  8A37                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 631  8A37 CD 38 8B         call ResetFullGameState
 632  8A3A C3 57 87         jp   LoadRoomAndRestart
 633  8A3D
 634  8A3D              ; -------------------------------------------------------------------
 635  8A3D              ; CheckPortalTransition
 636  8A3D              ; Verifica le condizioni per accedere alla stanza successiva:
 637  8A3D              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 638  8A3D              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 639  8A3D              ;
 640  8A3D              ; Output:
 641  8A3D              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 642  8A3D              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 643  8A3D              ; -------------------------------------------------------------------
 644  8A3D              CheckPortalTransition:
 645  8A3D C5               push bc
 646  8A3E D5               push de
 647  8A3F E5               push hl
 648  8A40
 649  8A40                  ; 1. Tutti gli item della stanza sono stati raccolti?
 650  8A40 CD CB 8A         call CheckAllItemsCollected
 651  8A43 30 4D            jr   nc, .no_transition
 652  8A45
 653  8A45                  ; 2. Willy collide con il portale (16x16 pixel)?
 654  8A45                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 655  8A45                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 656  8A45 2A 53 E5         ld   hl, (room_ptr)
 657  8A48 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 658  8A4B 19               add  hl, de
 659  8A4C 4E               ld   c, (hl)
 660  8A4D 23               inc  hl
 661  8A4E 46               ld   b, (hl)                   ; BC = AttrAddr
 662  8A4F
 663  8A4F                  ; Offset = BC - 23552
 664  8A4F 60               ld   h, b
 665  8A50 69               ld   l, c
 666  8A51 01 00 A4         ld   bc, -23552
 667  8A54 09               add  hl, bc
 668  8A55
 669  8A55                  ; PortalX = (Offset & 31) * 8
 670  8A55 7D               ld   a, l
 671  8A56 E6 1F            and  31
 672  8A58 87               add  a, a
 672  8A59 87             add a, a
 672  8A5A 87             add a, a
 673  8A5B 5F               ld   e, a                      ; E = PortalX (0..248)
 674  8A5C
 675  8A5C                  ; PortalY = (Offset / 32) * 8
 676  8A5C CB 3C            srl  h
 676  8A5E CB 1D          rr l
 677  8A60 CB 3C            srl  h
 677  8A62 CB 1D          rr l
 678  8A64 CB 3C            srl  h
 678  8A66 CB 1D          rr l
 679  8A68 CB 3C            srl  h
 679  8A6A CB 1D          rr l
 680  8A6C CB 3C            srl  h
 680  8A6E CB 1D          rr l
 681  8A70 7D               ld   a, l
 682  8A71 87               add  a, a
 682  8A72 87             add a, a
 682  8A73 87             add a, a
 683  8A74 57               ld   d, a                      ; D = PortalY (0..120)
 684  8A75
 685  8A75                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 686  8A75 ED 4B D2 E1      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 687  8A79
 688  8A79                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 689  8A79 7B               ld   a, e
 690  8A7A 91               sub  c
 691  8A7B 30 02            jr   nc, .x_diff_pos
 692  8A7D ED 44            neg
 693  8A7F              .x_diff_pos:
 694  8A7F FE 0C            cp   12
 695  8A81 30 0F            jr   nc, .no_transition
 696  8A83
 697  8A83                  ; Controllo verticale: |WillyY - PortalY| < 14
 698  8A83 7A               ld   a, d
 699  8A84 90               sub  b
 700  8A85 30 02            jr   nc, .y_diff_pos
 701  8A87 ED 44            neg
 702  8A89              .y_diff_pos:
 703  8A89 FE 0E            cp   14
 704  8A8B 30 05            jr   nc, .no_transition
 705  8A8D
 706  8A8D                  ; Transizione al portale attiva!
 707  8A8D E1               pop  hl
 708  8A8E D1               pop  de
 709  8A8F C1               pop  bc
 710  8A90 37               scf
 711  8A91 C9               ret
 712  8A92
 713  8A92              .no_transition:
 714  8A92 E1               pop  hl
 715  8A93 D1               pop  de
 716  8A94 C1               pop  bc
 717  8A95 B7               or   a
 718  8A96 C9               ret
 719  8A97
 720  8A97              ; Alias per retrocompatibilità
 721  8A97              CheckVictoryCondition: EQU CheckPortalTransition
 722  8A97
 723  8A97              ; -------------------------------------------------------------------
 724  8A97              ; TriggerPortalTransition
 725  8A97              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 726  8A97              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 727  8A97              ; - Avanza all'indice della stanza successiva.
 728  8A97              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 729  8A97              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 730  8A97              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 731  8A97              ; -------------------------------------------------------------------
 732  8A97              TriggerPortalTransition:
 733  8A97                  ; 1. Determina l'ID della stanza corrente
 734  8A97 CD FD 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8A9A
 736  8A9A                  ; 2. Calcola l'indice della stanza successiva
 737  8A9A 3A F8 E4         ld   a, (current_room)
 738  8A9D 3C               inc  a
 739  8A9E FE 14            cp   NUM_ROOMS
 740  8AA0 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8AA2
 742  8AA2                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8AA2 21 0C 73         ld   hl, RoomsListTable
 744  8AA5 5F               ld   e, a
 745  8AA6 16 00            ld   d, 0
 746  8AA8 19               add  hl, de
 747  8AA9 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8AAA 5E               ld   e, (hl)
 749  8AAB 23               inc  hl
 750  8AAC 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8AAD ED 53 53 E5      ld   (room_ptr), de
 752  8AB1
 753  8AB1                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8AB1 AF               xor  a
 755  8AB2 32 59 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8AB5 32 E0 E1         ld   (velocity_y), a
 757  8AB8 32 EB E7         ld   (game_objective_completed), a
 758  8ABB 3E 01            ld   a, 1
 759  8ABD 32 E1 E1         ld   (on_ground), a
 760  8AC0
 761  8AC0                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8AC0 3E 07            ld   a, $07
 763  8AC2 CD 99 62         call Gfx_ClearScreenDirect
 764  8AC5
 765  8AC5 C3 57 87         jp   LoadRoomAndRestart
 766  8AC8
 767  8AC8              .all_rooms_completed:
 768  8AC8                  ; Tutte le stanze sono state completate con successo!
 769  8AC8                  IF ENABLE_VICTORY_SCREEN != 0
 770  8AC8 C3 BF 89         jp   TriggerVictory
 771  8ACB                  ELSE
 772  8ACB ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8ACB ~                ld   de, (RoomsListTable)
 774  8ACB ~                ld   (room_ptr), de
 775  8ACB ~                xor  a
 776  8ACB ~                ld   (transition_active), a
 777  8ACB ~                ld   (velocity_y), a
 778  8ACB ~                ld   (game_objective_completed), a
 779  8ACB ~                ld   a, 1
 780  8ACB ~                ld   (on_ground), a
 781  8ACB ~                ld   a, $07
 782  8ACB ~                call Gfx_ClearScreenDirect
 783  8ACB ~                jp   LoadRoomAndRestart
 784  8ACB                  ENDIF
 785  8ACB
 786  8ACB              ; -------------------------------------------------------------------
 787  8ACB              ; CheckAllItemsCollected
 788  8ACB              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 789  8ACB              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 790  8ACB              ; -------------------------------------------------------------------
 791  8ACB              CheckAllItemsCollected:
 792  8ACB 3A EB E7         ld   a, (game_objective_completed)
 793  8ACE B7               or   a
 794  8ACF 20 08            jr   nz, .all_collected
 795  8AD1 3A 52 E5         ld   a, (num_room_items)
 796  8AD4 B7               or   a
 797  8AD5 28 02            jr   z, .all_collected
 798  8AD7 B7               or   a
 799  8AD8 C9               ret
 800  8AD9              .all_collected:
 801  8AD9 37               scf
 802  8ADA C9               ret
 803  8ADB
 804  8ADB              ; -------------------------------------------------------------------
 805  8ADB              ; CheckInMasterBedroom (alias per retrocompatibilità)
 806  8ADB              ; -------------------------------------------------------------------
 807  8ADB              CheckInMasterBedroom:
 808  8ADB 37               scf
 809  8ADC C9               ret
 810  8ADD
 811  8ADD              ; -------------------------------------------------------------------
 812  8ADD              ; CheckWillyConveyorCollision
 813  8ADD              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 814  8ADD              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 815  8ADD              ; -------------------------------------------------------------------
 816  8ADD              CheckWillyConveyorCollision:
 817  8ADD C5               push bc
 818  8ADE D5               push de
 819  8ADF E5               push hl
 820  8AE0
 821  8AE0                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 822  8AE0 CD CD 76         call CheckWillyOnConveyor
 823  8AE3 38 49            jr   c, .collision_detected
 824  8AE5
 825  8AE5                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 826  8AE5 3A FA E4         ld   a, (conveyor_len)
 827  8AE8 B7               or   a
 828  8AE9 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 829  8AEB
 830  8AEB                  ; B = WillyY, C = WillyX
 831  8AEB ED 4B D2 E1      ld   bc, (PlayerPos)
 832  8AEF
 833  8AEF                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 834  8AEF 3A FB E4         ld   a, (conveyor_row)
 835  8AF2 87               add  a, a                  ; *2
 836  8AF3 87               add  a, a                  ; *4
 837  8AF4 87               add  a, a                  ; *8
 838  8AF5 5F               ld   e, a                  ; E = ConveyorTop
 839  8AF6 C6 07            add  a, 7
 840  8AF8 57               ld   d, a                  ; D = ConveyorBottom
 841  8AF9
 842  8AF9                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 843  8AF9 78               ld   a, b                  ; WillyTop
 844  8AFA BA               cp   d
 845  8AFB 28 04            jr   z, .y_overlap
 846  8AFD 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 847  8AFF 18 32            jr   .no_conv_collision
 848  8B01
 849  8B01              .y_overlap:
 850  8B01 C6 0F            add  a, 15                 ; WillyBottom
 851  8B03 BB               cp   e
 852  8B04 28 04            jr   z, .x_check
 853  8B06 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 854  8B08 18 29            jr   .no_conv_collision
 855  8B0A
 856  8B0A              .x_check:
 857  8B0A                  ; ConveyorLeft = conveyor_col * 8
 858  8B0A 3A FC E4         ld   a, (conveyor_col)
 859  8B0D 87               add  a, a                  ; *2
 860  8B0E 87               add  a, a                  ; *4
 861  8B0F 87               add  a, a                  ; *8
 862  8B10 5F               ld   e, a                  ; E = ConveyorLeft
 863  8B11
 864  8B11                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 865  8B11 21 FA E4         ld   hl, conveyor_len
 866  8B14 3A FC E4         ld   a, (conveyor_col)
 867  8B17 86               add  a, (hl)
 868  8B18 87               add  a, a                  ; *2
 869  8B19 87               add  a, a                  ; *4
 870  8B1A 87               add  a, a                  ; *8
 871  8B1B 3D               dec  a                     ; ConveyorRight
 872  8B1C 57               ld   d, a                  ; D = ConveyorRight
 873  8B1D
 874  8B1D                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 875  8B1D 79               ld   a, c                  ; WillyLeft
 876  8B1E BA               cp   d
 877  8B1F 28 04            jr   z, .x_overlap
 878  8B21 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 879  8B23 18 0E            jr   .no_conv_collision
 880  8B25
 881  8B25              .x_overlap:
 882  8B25 C6 0F            add  a, 15                 ; WillyRight
 883  8B27 BB               cp   e
 884  8B28 28 04            jr   z, .collision_detected
 885  8B2A 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 886  8B2C 18 05            jr   .no_conv_collision
 887  8B2E
 888  8B2E              .collision_detected:
 889  8B2E E1               pop  hl
 890  8B2F D1               pop  de
 891  8B30 C1               pop  bc
 892  8B31 37               scf
 893  8B32 C9               ret
 894  8B33
 895  8B33              .no_conv_collision:
 896  8B33 E1               pop  hl
 897  8B34 D1               pop  de
 898  8B35 C1               pop  bc
 899  8B36 B7               or   a
 900  8B37 C9               ret
 901  8B38

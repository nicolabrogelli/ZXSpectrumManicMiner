 316+ 7EE3              ; Enemy_DrawSingleSlot
 317+ 7EE3              ;
 318+ 7EE3              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7EE3              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7EE3              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7EE3              ; -------------------------------------------------------------------
 322+ 7EE3              Enemy_DrawSingleSlot:
 323+ 7EE3 C5               push bc
 324+ 7EE4 D5               push de
 325+ 7EE5 E5               push hl
 326+ 7EE6 DD E5            push ix
 327+ 7EE8
 328+ 7EE8                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EE8                  ; Nei dati di Manic Miner:
 330+ 7EE8                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EE8                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EE8 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EEB E6 03            and  3
 334+ 7EED 47               ld   b, a                      ; B = Anim subframe
 335+ 7EEE
 336+ 7EEE DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EF1 FE 01            cp   1                         ; Sinistra?
 338+ 7EF3 28 03            jr   z, .left_frames
 339+ 7EF5
 340+ 7EF5                  ; Movimento a Destra: Frame 0..3
 341+ 7EF5 78               ld   a, b
 342+ 7EF6 18 03            jr   .got_frame_idx
 343+ 7EF8
 344+ 7EF8              .left_frames:
 345+ 7EF8                  ; Movimento a Sinistra: Frame 4..7
 346+ 7EF8 3E 04            ld   a, 4
 347+ 7EFA 80               add  a, b
 348+ 7EFB
 349+ 7EFB              .got_frame_idx:
 350+ 7EFB                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7EFB 6F               ld   l, a
 352+ 7EFC 26 00            ld   h, 0
 353+ 7EFE 29               add  hl, hl                    ; *2
 354+ 7EFF 29               add  hl, hl                    ; *4
 355+ 7F00 29               add  hl, hl                    ; *8
 356+ 7F01 29               add  hl, hl                    ; *16
 357+ 7F02 29               add  hl, hl                    ; *32
 358+ 7F03
 359+ 7F03 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7F06 19               add  hl, de
 361+ 7F07 ED 5B CF A1      ld   de, (room_ptr)
 362+ 7F0B 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7F0C E5               push hl
 364+ 7F0D DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7F0F
 366+ 7F0F                  ; 2. Coordinate e colore
 367+ 7F0F FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7F11 FD E5            push iy
 369+ 7F13
 370+ 7F13 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7F16 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7F19 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7F1C
 374+ 7F1C                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7F1C CD 6B 5F         call Gfx_DrawPixelSprite16x16
 376+ 7F1F FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7F22 CD 5B 6D         call Gfx_SetEnemyColorAttributes
 378+ 7F25
 379+ 7F25 DD E1            pop  ix
 380+ 7F27 E1               pop  hl
 381+ 7F28 D1               pop  de
 382+ 7F29 C1               pop  bc
 383+ 7F2A C9               ret

  89+ 7CC6 69               ld   l, c
  90+ 7CC7 01 00 A4         ld   bc, -23552
  91+ 7CCA 09               add  hl, bc                    ; HL = AttrOffset
  92+ 7CCB
  93+ 7CCB                  ; Col = Offset & 31 -> StartX = Col * 8
  94+ 7CCB 7D               ld   a, l
  95+ 7CCC E6 1F            and  31
  96+ 7CCE 87               add  a, a
  96+ 7CCF 87             add a, a
  96+ 7CD0 87             add a, a
  97+ 7CD1 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7CD4
  99+ 7CD4                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7CD4 CB 3C            srl  h
 100+ 7CD6 CB 1D          rr l
 101+ 7CD8 CB 3C            srl  h
 101+ 7CDA CB 1D          rr l
 102+ 7CDC CB 3C            srl  h
 102+ 7CDE CB 1D          rr l
 103+ 7CE0 CB 3C            srl  h
 103+ 7CE2 CB 1D          rr l
 104+ 7CE4 CB 3C            srl  h

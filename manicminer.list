  93  84EE 07               rlca                   ; Sposta nei bit 3-5
  94  84EF F6 07            or   $07               ; Ink bianco nei bit 0-2
  95  84F1 32 48 5C         ld   (BORDCR), a
  96  84F4
  97  84F4 3E FF            ld   a, $ff
  98  84F6 32 47 AF         ld   (player_drawn_pos+1), a
  99  84F9 CD 0E 60         call Gfx_PrintPlayer

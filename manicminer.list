 169+ 7A9B                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7A9B 3A B2 96         ld   a, (player_drawn_pos)
 171+ 7A9E E6 F8            and  $F8

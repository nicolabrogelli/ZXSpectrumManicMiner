   8+ 8406              ; Audio_UpdateJumpSound
   9+ 8406              ;
  10+ 8406              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8406              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8406              ; -------------------------------------------------------------------
  13+ 8406              Audio_UpdateJumpSound:
  14+ 8406 F5               push af
  15+ 8407 C5               push bc
  16+ 8408 D5               push de
  17+ 8409 E5               push hl
  18+ 840A
  19+ 840A                  ; Controlla se il suono è attivo (note < 18)
  20+ 840A 3A 5C B1         ld   a, (Audio_jump_sound_note)
  21+ 840D FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 840F 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8411
  24+ 8411                  ; Carica la nota corrente da suonare
  25+ 8411 5F               ld   e, a
  26+ 8412 16 00            ld   d, 0
  27+ 8414 21 40 84         ld   hl, Audio_JumpSoundDelays
  28+ 8417 19               add  hl, de
  29+ 8418 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8419 57               ld   d, a                      ; D = delay della nota
  31+ 841A
  32+ 841A                  ; Suona la nota: 15 cicli
  33+ 841A 06 0F            ld   b, 15
  34+ 841C              .note_loop:
  35+ 841C                  ; Speaker ON
  36+ 841C 3A 4C AB         ld   a, (room_border_color)
  37+ 841F F6 10            or   $10
  38+ 8421 D3 FE            out  ($fe), a
  39+ 8423 4A               ld   c, d
  40+ 8424              .d1:
  41+ 8424 0D               dec  c
  42+ 8425 20 FD            jr   nz, .d1
  43+ 8427
  44+ 8427                  ; Speaker OFF
  45+ 8427 3A 4C AB         ld   a, (room_border_color)
  46+ 842A E6 EF            and  $ef
  47+ 842C D3 FE            out  ($fe), a
  48+ 842E 4A               ld   c, d
  49+ 842F              .d2:
  50+ 842F 0D               dec  c
  51+ 8430 20 FD            jr   nz, .d2
  52+ 8432
  53+ 8432 10 E8            djnz .note_loop
  54+ 8434
  55+ 8434                  ; Passa alla nota successiva
  56+ 8434 3A 5C B1         ld   a, (Audio_jump_sound_note)
  57+ 8437 3C               inc  a
  58+ 8438 32 5C B1         ld   (Audio_jump_sound_note), a

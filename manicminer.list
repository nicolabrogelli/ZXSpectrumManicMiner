  29+ 7D0C              ; Enemy_LoadRoom
  30+ 7D0C              ;
  31+ 7D0C              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7D0C              ; Chiamato quando si entra in una stanza.
  33+ 7D0C              ; -------------------------------------------------------------------
  34+ 7D0C              Enemy_LoadRoom:
  35+ 7D0C E5               push hl
  36+ 7D0D D5               push de
  37+ 7D0E C5               push bc
  38+ 7D0F DD E5            push ix
  39+ 7D11
  40+ 7D11                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D11 21 B4 7C         ld   hl, ActiveEnemies
  42+ 7D14 11 B5 7C         ld   de, ActiveEnemies + 1
  43+ 7D17 36 00            ld   (hl), 0
  44+ 7D19 01 57 00         ld   bc, 87
  45+ 7D1C ED B0            ldir
  46+ 7D1E
  47+ 7D1E                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D1E DD 21 B4 7C      ld   ix, ActiveEnemies
  49+ 7D22 06 08            ld   b, 8
  50+ 7D24 11 0B 00         ld   de, 11

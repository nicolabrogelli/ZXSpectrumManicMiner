  72+ 840F ~            ; Audio_UpdateMusic
  73+ 840F ~            ;
  74+ 840F ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 840F ~            ; Viene chiamata a ogni frame.
  76+ 840F ~            ; -------------------------------------------------------------------
  77+ 840F ~            Audio_UpdateMusic:
  78+ 840F ~                push af
  79+ 840F ~                push bc
  80+ 840F ~                push de
  81+ 840F ~                push hl
  82+ 840F ~
  83+ 840F ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 840F ~                ld   a, (Audio_jump_sound_note)
  85+ 840F ~                cp   18
  86+ 840F ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 840F ~
  88+ 840F ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 840F ~                ld   a, (Audio_music_frame_counter)
  90+ 840F ~                dec  a
  91+ 840F ~                ld   (Audio_music_frame_counter), a
  92+ 840F ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 840F ~
  94+ 840F ~                ; Altrimenti carica la nota successiva
  95+ 840F ~                ld   a, (Audio_music_note_idx)
  96+ 840F ~                inc  a
  97+ 840F ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 840F ~                jr   c, .no_wrap
  99+ 840F ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 840F ~            .no_wrap:
 101+ 840F ~                ld   (Audio_music_note_idx), a
 102+ 840F ~
 103+ 840F ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 840F ~                ld   e, a
 105+ 840F ~                ld   d, 0
 106+ 840F ~                ld   hl, Audio_MusicSheet
 107+ 840F ~                add  hl, de
 108+ 840F ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 840F ~
 110+ 840F ~                ; Leggi durata (secondo byte)
 111+ 840F ~                inc  hl
 112+ 840F ~                ld   a, (hl)
 113+ 840F ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 840F ~                jr   nz, .dur_ok
 115+ 840F ~                ld   a, 1
 116+ 840F ~            .dur_ok:
 117+ 840F ~                ld   (Audio_music_frame_counter), a
 118+ 840F ~
 119+ 840F ~            .play_current_note:
 120+ 840F ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 840F ~                ld   a, (Audio_music_note_idx)
 122+ 840F ~                ld   e, a
 123+ 840F ~                ld   d, 0
 124+ 840F ~                ld   hl, Audio_MusicSheet
 125+ 840F ~                add  hl, de
 126+ 840F ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 840F ~                ld   a, (hl)                  ; A = delay
 128+ 840F ~                or   a
 129+ 840F ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 840F ~
 131+ 840F ~                ; Suona la nota: 2 cicli
 132+ 840F ~                ld   d, a                     ; D = delay
 133+ 840F ~                ld   b, 2                     ; 2 cicli per frame
 134+ 840F ~            .note_loop:
 135+ 840F ~                ; Speaker ON
 136+ 840F ~                ld   a, (room_border_color)
 137+ 840F ~                or   $10
 138+ 840F ~                out  ($fe), a
 139+ 840F ~                ld   c, d
 140+ 840F ~            .d1:
 141+ 840F ~                push af
 142+ 840F ~                pop  af
 143+ 840F ~                dec  c
 144+ 840F ~                jr   nz, .d1
 145+ 840F ~
 146+ 840F ~                ; Speaker OFF
 147+ 840F ~                ld   a, (room_border_color)
 148+ 840F ~                and  $ef
 149+ 840F ~                out  ($fe), a
 150+ 840F ~                ld   c, d
 151+ 840F ~            .d2:
 152+ 840F ~                push af
 153+ 840F ~                pop  af
 154+ 840F ~                dec  c
 155+ 840F ~                jr   nz, .d2
 156+ 840F ~
 157+ 840F ~                djnz .note_loop
 158+ 840F ~
 159+ 840F ~            .done:
 160+ 840F ~                pop  hl
 161+ 840F ~                pop  de
 162+ 840F ~                pop  bc
 163+ 840F ~                pop  af
 164+ 840F ~                ret
 165+ 840F ~
 166+ 840F ~            Audio_MusicSheet:
 167+ 840F ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 840F ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 840F ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 840F ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 840F ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 840F ~                db 90, 10, 107, 20, 68, 65
 173+ 840F                  ELSE
 174+ 840F              Audio_UpdateMusic:
 175+ 840F C9               ret

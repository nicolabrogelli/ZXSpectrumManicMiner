 287  875E              ; -------------------------------------------------------------------
 288  875E              ; ShowTitleScreen
 289  875E              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  875E              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  875E              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  875E              ; -------------------------------------------------------------------
 293  875E              ShowTitleScreen:
 294  875E                  ; 1. Disegna la schermata iniziale
 295  875E CD 76 64         call Gfx_DrawTitleScreen
 296  8761
 297  8761                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  8761              .wait_title_enter_release:
 299  8761 76               halt
 300  8762 3E BF            ld   a, $bf
 301  8764 DB FE            in   a, ($fe)
 302  8766 1F               rra
 303  8767 30 F8            jr   nc, .wait_title_enter_release
 304  8769
 305  8769                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  8769 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  876B              .title_loop:
 308  876B 76               halt
 309  876C
 310  876C                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  876C 0C               inc  c
 312  876D 79               ld   a, c
 313  876E CB 3F            srl  a
 314  8770 CB 3F            srl  a
 315  8772 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  8774 E6 07            and  7
 317  8776 5F               ld   e, a
 318  8777 16 00            ld   d, 0
 319  8779 21 6E 64         ld   hl, title_color_table
 320  877C 19               add  hl, de
 321  877D 7E               ld   a, (hl)               ; A = nuovo colore
 322  877E 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  8781 06 20            ld   b, 32
 324  8783              .color_title_loop:
 325  8783 77               ld   (hl), a
 326  8784 23               inc  hl
 327  8785 10 FC            djnz .color_title_loop
 328  8787
 329  8787                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  8787 3E BF            ld   a, $bf
 331  8789 DB FE            in   a, ($fe)
 332  878B 1F               rra
 333  878C 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  878E

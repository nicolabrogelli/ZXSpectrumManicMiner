 432+ 7CD8 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 433+ 7CDB DD 77 02         ld   (ix+2), a
 434+ 7CDE 3E 02            ld   a, 2
 435+ 7CE0 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 436+ 7CE3 C3 4A 7D         jp   .next
 437+ 7CE6
 438+ 7CE6              .horiz_right:
 439+ 7CE6 DD 7E 02         ld   a, (ix+2)                 ; Current X
 440+ 7CE9 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 441+ 7CEB DD BE 05         cp   (ix+5)                    ; Max Limit
 442+ 7CEE 28 08            jr   z, .h_rev_left
 443+ 7CF0 30 06            jr   nc, .h_rev_left
 444+ 7CF2 DD 77 02         ld   (ix+2), a
 445+ 7CF5 C3 4A 7D         jp   .next

 676+ 8568 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 677+ 856A 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 678+ 856C
 679+ 856C                  ; Byte 1:
 680+ 856C 3A AF E6         ld   a, (player_score + 1)
 681+ 856F 47               ld   b, a
 682+ 8570 3A B2 E6         ld   a, (high_score + 1)
 683+ 8573 B8               cp   b
 684+ 8574 38 0C            jr   c, .new_high_score
 685+ 8576 20 1C            jr   nz, .done_check
 686+ 8578
 687+ 8578                  ; Byte 0:
 688+ 8578 3A AE E6         ld   a, (player_score + 0)
 689+ 857B 47               ld   b, a
 690+ 857C 3A B1 E6         ld   a, (high_score + 0)
 691+ 857F B8               cp   b
 692+ 8580 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

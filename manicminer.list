   6+ 6EAF              ; -------------------------------------------------------------------
   7+ 6EAF              ; Input_CheckCtrl
   8+ 6EAF              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6EAF              ;
  10+ 6EAF              ; Output:
  11+ 6EAF              ;   D = bitmask tasti attivi:
  12+ 6EAF              ;       bit 0 → sinistra (O)
  13+ 6EAF              ;       bit 1 → destra   (P)
  14+ 6EAF              ;       bit 2 → salto    (Z)
  15+ 6EAF              ;
  16+ 6EAF              ; Effetti collaterali in RAM:
  17+ 6EAF              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6EAF              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6EAF              ;   (jump_prev)     → debounce tasto salto
  20+ 6EAF              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6EAF              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 6EAF              ; -------------------------------------------------------------------
  23+ 6EAF
  24+ 6EAF              Input_CheckCtrl:
  25+ 6EAF AF               xor  a
  26+ 6EB0 32 81 94         ld   (current_input_dir), a
  27+ 6EB3
  28+ 6EB3                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 6EB3                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 6EB3                  ;
  31+ 6EB3                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 6EB3                  ; Se bit 0 = 0, Q è premuto.
  33+ 6EB3
  34+ 6EB3 01 FE FB         ld   bc, $fbfe
  35+ 6EB6 ED 78            in   a, (c)
  36+ 6EB8 CB 47            bit  0, a
  37+ 6EBA 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6EBC
  39+ 6EBC                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6EBC                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6EBC 3A 82 94         ld   a, (q_prev)
  42+ 6EBF B7               or   a
  43+ 6EC0 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 6EC2
  45+ 6EC2                  ; ── Primo frame di pressione di Q ──

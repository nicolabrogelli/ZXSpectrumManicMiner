 198+ 6FB8              ; -------------------------------------------------------------------
 199+ 6FB8              ; GetPlayerAirSpeed
 200+ 6FB8              ;
 201+ 6FB8              ; Calcola la velocità orizzontale in volo (pixel per frame) in base al
 202+ 6FB8              ; preset configurato in player_air_speed (DEFAULT_AIR_SPEED_PRESET).
 203+ 6FB8              ;
 204+ 6FB8              ; Presets:
 205+ 6FB8              ;   0 = 1.0 px/frame costante  (parabola stretta)
 206+ 6FB8              ;   1 = 1.5 px/frame alternato (parabola corta: alterna 1 e 2 px)
 207+ 6FB8              ;   2 = 2.0 px/frame costante  (parabola media)
 208+ 6FB8              ;   3 = 2.5 px/frame alternato (parabola standard MM: alterna 2 e 3 px)
 209+ 6FB8              ;   4 = 3.0 px/frame costante  (parabola estesa)
 210+ 6FB8              ;
 211+ 6FB8              ; Output:
 212+ 6FB8              ;   A = pixel di spostamento orizzontale per il frame corrente
 213+ 6FB8              ; -------------------------------------------------------------------
 214+ 6FB8              GetPlayerAirSpeed:
 215+ 6FB8 3A B2 EE         ld   a, (player_air_speed)
 216+ 6FBB B7               or   a
 217+ 6FBC 28 0E            jr   z, .speed_1_0
 218+ 6FBE 3D               dec  a
 219+ 6FBF 28 0E            jr   z, .speed_1_5
 220+ 6FC1 3D               dec  a
 221+ 6FC2 28 15            jr   z, .speed_2_0
 222+ 6FC4 3D               dec  a
 223+ 6FC5 28 15            jr   z, .speed_2_5
 224+ 6FC7 3D               dec  a
 225+ 6FC8 28 1C            jr   z, .speed_3_0
 226+ 6FCA
 227+ 6FCA                  ; Default: se valore diverso, usa 2.0 px/frame
 228+ 6FCA 18 0D            jr   .speed_2_0
 229+ 6FCC
 230+ 6FCC              .speed_1_0:
 231+ 6FCC 3E 01            ld   a, 1
 232+ 6FCE C9               ret
 233+ 6FCF
 234+ 6FCF              .speed_1_5:
 235+ 6FCF 3E 01            ld   a, 1
 236+ 6FD1 21 40 EB         ld   hl, jump_frame
 237+ 6FD4 CB 46            bit  0, (hl)
 238+ 6FD6 C8               ret  z
 239+ 6FD7 3C               inc  a                      ; Alterna 1 e 2 px
 240+ 6FD8 C9               ret
 241+ 6FD9
 242+ 6FD9              .speed_2_0:
 243+ 6FD9 3E 02            ld   a, 2
 244+ 6FDB C9               ret
 245+ 6FDC
 246+ 6FDC              .speed_2_5:
 247+ 6FDC 3E 02            ld   a, 2
 248+ 6FDE 21 40 EB         ld   hl, jump_frame
 249+ 6FE1 CB 46            bit  0, (hl)
 250+ 6FE3 C8               ret  z
 251+ 6FE4 3C               inc  a                      ; Alterna 2 e 3 px (standard MM)
 252+ 6FE5 C9               ret
 253+ 6FE6
 254+ 6FE6              .speed_3_0:
 255+ 6FE6 3E 03            ld   a, 3
 256+ 6FE8 C9               ret
 257+ 6FE9

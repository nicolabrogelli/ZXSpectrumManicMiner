 718+ 87A1 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 87A3
 720+ 87A3                  ; Byte 1:
 721+ 87A3 3A 99 F0         ld   a, (player_score + 1)
 722+ 87A6 47               ld   b, a
 723+ 87A7 3A 9C F0         ld   a, (high_score + 1)
 724+ 87AA B8               cp   b

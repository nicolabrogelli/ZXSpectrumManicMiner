   6+ 703E              ; -------------------------------------------------------------------
   7+ 703E              ; Input_CheckCtrl
   8+ 703E              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 703E              ;
  10+ 703E              ; Output:
  11+ 703E              ;   D = bitmask tasti attivi:
  12+ 703E              ;       bit 0 → sinistra (O)
  13+ 703E              ;       bit 1 → destra   (P)
  14+ 703E              ;       bit 2 → salto    (Z)
  15+ 703E              ;
  16+ 703E              ; Effetti collaterali in RAM:
  17+ 703E              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 703E              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 703E              ;   (jump_prev)     → debounce tasto salto
  20+ 703E              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 703E              ;   (flags)         → bit 0 impostato se movimento rilevato

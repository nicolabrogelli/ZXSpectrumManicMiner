 518+ 7C83              ; CheckCollision
 519+ 7C83              ;
 520+ 7C83              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7C83              ; Output:
 522+ 7C83              ;   Carry Set = Collisione con guardiano
 523+ 7C83              ;   Carry Clear = Nessuna collisione
 524+ 7C83              ; -------------------------------------------------------------------
 525+ 7C83              CheckCollision:
 526+ 7C83 DD E5            push ix
 527+ 7C85 C5               push bc
 528+ 7C86 D5               push de
 529+ 7C87 E5               push hl
 530+ 7C88
 531+ 7C88                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7C88 3A B7 96         ld   a, (willy_safety_timer)
 533+ 7C8B B7               or   a
 534+ 7C8C 20 3B            jr   nz, .no_collision_found
 535+ 7C8E
 536+ 7C8E DD 21 7B 79      ld   ix, ActiveEnemies
 537+ 7C92 06 08            ld   b, 8                      ; 8 slot
 538+ 7C94
 539+ 7C94              .collision_loop:
 540+ 7C94 DD 7E 00         ld   a, (ix+0)
 541+ 7C97 E6 80            and  $80                       ; Active?
 542+ 7C99 28 26            jr   z, .next_enemy
 543+ 7C9B
 544+ 7C9B C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7C9C
 546+ 7C9C                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7C9C ED 4B AD 92      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7CA0 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7CA3
 550+ 7CA3                  ; Calcola differenza X
 551+ 7CA3 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7CA4 30 02            jr   nc, .x_diff_pos
 553+ 7CA6 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7CA8              .x_diff_pos:
 555+ 7CA8 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7CAA 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7CAC
 558+ 7CAC                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7CAC DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7CAF 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7CB0 30 02            jr   nc, .y_diff_pos
 562+ 7CB2 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7CB4              .y_diff_pos:
 564+ 7CB4 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7CB6 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7CB8
 567+ 7CB8                  ; Collisione trovata!
 568+ 7CB8 C1               pop  bc                        ; Ripristina stack
 569+ 7CB9 E1               pop  hl
 570+ 7CBA D1               pop  de
 571+ 7CBB C1               pop  bc
 572+ 7CBC DD E1            pop  ix
 573+ 7CBE 37               scf
 574+ 7CBF C9               ret
 575+ 7CC0
 576+ 7CC0              .no_x_hit:
 577+ 7CC0 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 7CC1
 579+ 7CC1              .next_enemy:
 580+ 7CC1 11 0B 00         ld   de, 11
 581+ 7CC4 DD 19            add  ix, de
 582+ 7CC6 05               dec  b
 583+ 7CC7 20 CB            jr   nz, .collision_loop
 584+ 7CC9
 585+ 7CC9              .no_collision_found:
 586+ 7CC9 E1               pop  hl
 587+ 7CCA D1               pop  de
 588+ 7CCB C1               pop  bc
 589+ 7CCC DD E1            pop  ix
 590+ 7CCE B7               or   a
 591+ 7CCF C9               ret

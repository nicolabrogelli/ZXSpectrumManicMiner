 438+ 8468 ED 4B 9D E0      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 846C
 440+ 846C                  ; WillyLeft <= ItemRight
 441+ 846C 79               ld   a, c                      ; A = WillyX
 442+ 846D BA               cp   d                         ; D = ItemRight
 443+ 846E 28 04            jr   z, .x_ok
 444+ 8470 38 02            jr   c, .x_ok
 445+ 8472 18 31            jr   .no_collision
 446+ 8474
 447+ 8474              .x_ok:
 448+ 8474                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8474 BB               cp   e                         ; E = ItemLeft
 450+ 8475 28 0B            jr   z, .y_check
 451+ 8477 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8479
 453+ 8479                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 8479 C6 0F            add  a, 15
 455+ 847B BB               cp   e
 456+ 847C 28 04            jr   z, .y_check
 457+ 847E 30 02            jr   nc, .y_check
 458+ 8480 18 23            jr   .no_collision
 459+ 8482
 460+ 8482              .y_check:
 461+ 8482                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 8482 7C               ld   a, h                      ; H = Item Row
 463+ 8483 87               add  a, a                      ; *2
 464+ 8484 87               add  a, a                      ; *4
 465+ 8485 87               add  a, a                      ; *8
 466+ 8486 5F               ld   e, a                      ; E = ItemTop
 467+ 8487 C6 07            add  a, 7
 468+ 8489 57               ld   d, a                      ; D = ItemBottom
 469+ 848A
 470+ 848A                  ; WillyTop <= ItemBottom
 471+ 848A 78               ld   a, b                      ; A = WillyY
 472+ 848B BA               cp   d                         ; D = ItemBottom
 473+ 848C 28 04            jr   z, .y_ok
 474+ 848E 38 02            jr   c, .y_ok
 475+ 8490 18 13            jr   .no_collision
 476+ 8492
 477+ 8492              .y_ok:
 478+ 8492                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8492 BB               cp   e                         ; E = ItemTop
 480+ 8493 28 0B            jr   z, .collision
 481+ 8495 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8497
 483+ 8497                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8497 C6 0F            add  a, 15
 485+ 8499 BB               cp   e
 486+ 849A 28 04            jr   z, .collision
 487+ 849C 30 02            jr   nc, .collision
 488+ 849E 18 05            jr   .no_collision

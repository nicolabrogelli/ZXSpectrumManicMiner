 356+ 7E6B              ; -------------------------------------------------------------------
 357+ 7E6B              ; Enemy_DrawSingleSlot
 358+ 7E6B              ;
 359+ 7E6B              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 360+ 7E6B              ; La grafica (8 frame da 32 byte) è letta direttamente da
 361+ 7E6B              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 362+ 7E6B              ; -------------------------------------------------------------------
 363+ 7E6B              Enemy_DrawSingleSlot:
 364+ 7E6B C5               push bc
 365+ 7E6C D5               push de
 366+ 7E6D E5               push hl
 367+ 7E6E DD E5            push ix
 368+ 7E70
 369+ 7E70                  ; 1. Salva subito le coordinate X e Y dal record IX
 370+ 7E70 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 371+ 7E73 DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 372+ 7E76
 373+ 7E76                  ; Controlla se è guardiano verticale
 374+ 7E76 DD 7E 00         ld   a, (ix+0)
 375+ 7E79 E6 40            and  $40                       ; Vertical?
 376+ 7E7B 20 15            jr   nz, .v_frame
 377+ 7E7D
 378+ 7E7D                  ; Guardiano Orizzontale:
 379+ 7E7D DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 380+ 7E80 E6 03            and  3
 381+ 7E82 5F               ld   e, a                      ; E = Anim subframe
 382+ 7E83
 383+ 7E83 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 384+ 7E86 FE 01            cp   1                         ; Sinistra?
 385+ 7E88 28 03            jr   z, .left_frames
 386+ 7E8A
 387+ 7E8A                  ; Movimento a Destra: Frame 0..3
 388+ 7E8A 7B               ld   a, e
 389+ 7E8B 18 0A            jr   .got_frame_idx
 390+ 7E8D
 391+ 7E8D              .left_frames:
 392+ 7E8D                  ; Movimento a Sinistra: Frame 4..7
 393+ 7E8D 3E 04            ld   a, 4
 394+ 7E8F 83               add  a, e
 395+ 7E90 18 05            jr   .got_frame_idx
 396+ 7E92
 397+ 7E92              .v_frame:
 398+ 7E92                  ; Guardiano Verticale: usa il frame salvato in (ix+1) (4..7)
 399+ 7E92 DD 7E 01         ld   a, (ix+1)
 400+ 7E95 E6 07            and  7

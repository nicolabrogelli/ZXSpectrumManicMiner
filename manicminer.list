 695+ 83C3 3A EE CC         ld   a, (player_score + 0)
 696+ 83C6 32 F1 CC         ld   (high_score + 0), a
 697+ 83C9 3A EF CC         ld   a, (player_score + 1)
 698+ 83CC 32 F2 CC         ld   (high_score + 1), a
 699+ 83CF 3A F0 CC         ld   a, (player_score + 2)

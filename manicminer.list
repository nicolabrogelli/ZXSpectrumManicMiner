 408+ 7EA6 29               add  hl, hl                    ; *8
 409+ 7EA7 29               add  hl, hl                    ; *16
 410+ 7EA8 29               add  hl, hl                    ; *32
 411+ 7EA9
 412+ 7EA9 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 413+ 7EAC 19               add  hl, de
 414+ 7EAD ED 5B 5F CA      ld   de, (room_ptr)
 415+ 7EB1 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 416+ 7EB2
 417+ 7EB2 DD 7E 0A         ld   a, (ix+10)                ; A = Color Attributo
 418+ 7EB5 F5               push af                        ; Salva colore nello stack
 419+ 7EB6
 420+ 7EB6 E5               push hl
 421+ 7EB7 DD E1            pop  ix                        ; IX = frame bitmap pointer
 422+ 7EB9
 423+ 7EB9                  ; 2. Disegna sprite 16x16 alle coordinate (C=X, B=Y)
 424+ 7EB9 CD 6B 5F         call Gfx_DrawPixelSprite16x16
 425+ 7EBC
 426+ 7EBC                  ; 3. Imposta gli attributi colore alle coordinate (C=X, B=Y)
 427+ 7EBC F1               pop  af                        ; A = Color Attributo
 428+ 7EBD CD 12 6D         call Gfx_SetEnemyColorAttributes
 429+ 7EC0
 430+ 7EC0 DD E1            pop  ix
 431+ 7EC2 E1               pop  hl
 432+ 7EC3 D1               pop  de
 433+ 7EC4 C1               pop  bc
 434+ 7EC5 C9               ret
 435+ 7EC6
 436+ 7EC6              ; -------------------------------------------------------------------
 437+ 7EC6              ; Enemy_Update
 438+ 7EC6              ;
 439+ 7EC6              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 440+ 7EC6              ; -------------------------------------------------------------------
 441+ 7EC6              Enemy_Update:
 442+ 7EC6                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 443+ 7EC6 3A 61 CA         ld   a, (enemy_update_rate)
 444+ 7EC9 FE 01            cp   1
 445+ 7ECB 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 446+ 7ECD
 447+ 7ECD 21 62 CA         ld   hl, enemy_update_timer
 448+ 7ED0 34               inc  (hl)
 449+ 7ED1 7E               ld   a, (hl)
 450+ 7ED2 21 61 CA         ld   hl, enemy_update_rate
 451+ 7ED5 BE               cp   (hl)
 452+ 7ED6 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 453+ 7ED7 AF               xor  a
 454+ 7ED8 32 62 CA         ld   (enemy_update_timer), a
 455+ 7EDB
 456+ 7EDB              .do_update:
 457+ 7EDB E5               push hl
 458+ 7EDC D5               push de
 459+ 7EDD C5               push bc
 460+ 7EDE DD E5            push ix
 461+ 7EE0
 462+ 7EE0 3E 01            ld   a, 1
 463+ 7EE2 32 E8 CA         ld   (enemy_was_updated), a
 464+ 7EE5
 465+ 7EE5 DD 21 51 7C      ld   ix, ActiveEnemies
 466+ 7EE9 06 08            ld   b, 8                      ; 8 slot
 467+ 7EEB              .loop:
 468+ 7EEB DD 7E 00         ld   a, (ix+0)                 ; Flags
 469+ 7EEE E6 80            and  $80                       ; Active?
 470+ 7EF0 CA 9A 7F         jp   z, .next
 471+ 7EF3
 472+ 7EF3                  ; 1. Determina se orizzontale o verticale
 473+ 7EF3 DD 7E 00         ld   a, (ix+0)
 474+ 7EF6 E6 40            and  $40                       ; Vertical?
 475+ 7EF8 C2 4B 7F         jp   nz, .vertical
 476+ 7EFB
 477+ 7EFB                  ; Aggiorna Anim State per guardiano orizzontale (0..3)
 478+ 7EFB DD 7E 07         ld   a, (ix+7)
 479+ 7EFE 3C               inc  a
 480+ 7EFF E6 03            and  3
 481+ 7F01 DD 77 07         ld   (ix+7), a
 482+ 7F04
 483+ 7F04              .horizontal:
 484+ 7F04 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 485+ 7F07 FE 01            cp   1
 486+ 7F09 20 20            jr   nz, .horiz_right
 487+ 7F0B
 488+ 7F0B              .horiz_left:
 489+ 7F0B DD 7E 02         ld   a, (ix+2)                 ; Current X
 490+ 7F0E D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 491+ 7F10 DD BE 04         cp   (ix+4)                    ; Min Limit
 492+ 7F13 28 08            jr   z, .h_rev_right
 493+ 7F15 38 06            jr   c, .h_rev_right
 494+ 7F17 DD 77 02         ld   (ix+2), a
 495+ 7F1A C3 9A 7F         jp   .next
 496+ 7F1D
 497+ 7F1D              .h_rev_right:
 498+ 7F1D DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 499+ 7F20 DD 77 02         ld   (ix+2), a
 500+ 7F23 3E 02            ld   a, 2
 501+ 7F25 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 502+ 7F28 C3 9A 7F         jp   .next
 503+ 7F2B
 504+ 7F2B              .horiz_right:
 505+ 7F2B DD 7E 02         ld   a, (ix+2)                 ; Current X
 506+ 7F2E C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 507+ 7F30 DD BE 05         cp   (ix+5)                    ; Max Limit
 508+ 7F33 28 08            jr   z, .h_rev_left
 509+ 7F35 30 06            jr   nc, .h_rev_left
 510+ 7F37 DD 77 02         ld   (ix+2), a
 511+ 7F3A C3 9A 7F         jp   .next
 512+ 7F3D
 513+ 7F3D              .h_rev_left:
 514+ 7F3D DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 515+ 7F40 DD 77 02         ld   (ix+2), a
 516+ 7F43 3E 01            ld   a, 1
 517+ 7F45 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 518+ 7F48 C3 9A 7F         jp   .next
 519+ 7F4B
 520+ 7F4B              .vertical:
 521+ 7F4B DD 7E 07         ld   a, (ix+7)                 ; Step in pixel (1 o 2)
 522+ 7F4E E6 03            and  3
 523+ 7F50 20 02            jr   nz, .v_step_ok
 524+ 7F52 3E 01            ld   a, 1
 525+ 7F54              .v_step_ok:
 526+ 7F54 4F               ld   c, a                      ; C = Step
 527+ 7F55
 528+ 7F55 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 529+ 7F58 FE 01            cp   1
 530+ 7F5A 20 1F            jr   nz, .vert_down
 531+ 7F5C
 532+ 7F5C              .vert_up:
 533+ 7F5C DD 7E 03         ld   a, (ix+3)                 ; Current Y
 534+ 7F5F 91               sub  c                         ; Muovi verso l'alto
 535+ 7F60 DD BE 04         cp   (ix+4)                    ; Min Limit Y
 536+ 7F63 28 08            jr   z, .v_rev_down
 537+ 7F65 38 06            jr   c, .v_rev_down
 538+ 7F67 DD 77 03         ld   (ix+3), a
 539+ 7F6A C3 9A 7F         jp   .next
 540+ 7F6D
 541+ 7F6D              .v_rev_down:
 542+ 7F6D DD 7E 04         ld   a, (ix+4)                 ; Min Limit Y
 543+ 7F70 DD 77 03         ld   (ix+3), a
 544+ 7F73 3E 02            ld   a, 2                      ; Cambia direzione a Down
 545+ 7F75 DD 77 06         ld   (ix+6), a
 546+ 7F78 C3 9A 7F         jp   .next
 547+ 7F7B
 548+ 7F7B              .vert_down:
 549+ 7F7B DD 7E 03         ld   a, (ix+3)                 ; Current Y
 550+ 7F7E 81               add  a, c                      ; Muovi verso il basso
 551+ 7F7F DD BE 05         cp   (ix+5)                    ; Max Limit Y
 552+ 7F82 28 08            jr   z, .v_rev_up
 553+ 7F84 30 06            jr   nc, .v_rev_up
 554+ 7F86 DD 77 03         ld   (ix+3), a
 555+ 7F89 C3 9A 7F         jp   .next
 556+ 7F8C
 557+ 7F8C              .v_rev_up:
 558+ 7F8C DD 7E 05         ld   a, (ix+5)                 ; Max Limit Y
 559+ 7F8F DD 77 03         ld   (ix+3), a
 560+ 7F92 3E 01            ld   a, 1                      ; Cambia direzione a Up
 561+ 7F94 DD 77 06         ld   (ix+6), a
 562+ 7F97 C3 9A 7F         jp   .next
 563+ 7F9A
 564+ 7F9A              .next:
 565+ 7F9A 11 0B 00         ld   de, 11
 566+ 7F9D DD 19            add  ix, de
 567+ 7F9F 05               dec  b
 568+ 7FA0 C2 EB 7E         jp   nz, .loop
 569+ 7FA3
 570+ 7FA3 DD E1            pop  ix
 571+ 7FA5 C1               pop  bc
 572+ 7FA6 D1               pop  de
 573+ 7FA7 E1               pop  hl
 574+ 7FA8 C9               ret
 575+ 7FA9
 576+ 7FA9              ; -------------------------------------------------------------------
 577+ 7FA9              ; CheckCollision
 578+ 7FA9              ;
 579+ 7FA9              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 580+ 7FA9              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 581+ 7FA9              ; Output:
 582+ 7FA9              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 583+ 7FA9              ;   Carry Clear = Nessuna collisione
 584+ 7FA9              ; -------------------------------------------------------------------
 585+ 7FA9              CheckCollision:
 586+ 7FA9 DD E5            push ix
 587+ 7FAB C5               push bc
 588+ 7FAC D5               push de
 589+ 7FAD E5               push hl
 590+ 7FAE
 591+ 7FAE                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 592+ 7FAE 3A E9 CA         ld   a, (willy_safety_timer)
 593+ 7FB1 B7               or   a
 594+ 7FB2 C2 FC 80         jp   nz, .no_collision_found
 595+ 7FB5
 596+ 7FB5                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 597+ 7FB5 3A E5 C6         ld   a, (direction)
 598+ 7FB8 FE 01            cp   1                         ; Sinistra?
 599+ 7FBA 20 1A            jr   nz, .willy_right
 600+ 7FBC
 601+ 7FBC                  ; Willy a Sinistra:
 602+ 7FBC 21 BE C0         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 603+ 7FBF 22 FF CC         ld   (willy_head_ptr), hl
 604+ 7FC2 3A E4 C6         ld   a, (body_state)           ; 0, 1, 2
 605+ 7FC5 C6 05            add  a, 5                      ; tile 5, 6, 7
 606+ 7FC7 87               add  a, a
 606+ 7FC8 87             add a, a
 606+ 7FC9 87             add a, a ; * 8
 607+ 7FCA 5F               ld   e, a
 608+ 7FCB 16 00            ld   d, 0
 609+ 7FCD 21 9E C0         ld   hl, Willy
 610+ 7FD0 19               add  hl, de
 611+ 7FD1 22 01 CD         ld   (willy_body_ptr), hl      ; Corpo sinistro
 612+ 7FD4 18 18            jr   .willy_ptrs_ready
 613+ 7FD6
 614+ 7FD6              .willy_right:
 615+ 7FD6                  ; Willy a Destra:
 616+ 7FD6 21 9E C0         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 617+ 7FD9 22 FF CC         ld   (willy_head_ptr), hl
 618+ 7FDC 3A E4 C6         ld   a, (body_state)           ; 0, 1, 2
 619+ 7FDF C6 01            add  a, 1                      ; tile 1, 2, 3
 620+ 7FE1 87               add  a, a
 620+ 7FE2 87             add a, a
 620+ 7FE3 87             add a, a ; * 8
 621+ 7FE4 5F               ld   e, a
 622+ 7FE5 16 00            ld   d, 0
 623+ 7FE7 21 9E C0         ld   hl, Willy
 624+ 7FEA 19               add  hl, de
 625+ 7FEB 22 01 CD         ld   (willy_body_ptr), hl      ; Corpo destro
 626+ 7FEE
 627+ 7FEE              .willy_ptrs_ready:
 628+ 7FEE DD 21 51 7C      ld   ix, ActiveEnemies
 629+ 7FF2 06 08            ld   b, 8                      ; 8 slot
 630+ 7FF4
 631+ 7FF4              .enemy_loop:
 632+ 7FF4 DD 7E 00         ld   a, (ix+0)
 633+ 7FF7 E6 80            and  $80                       ; Active?
 634+ 7FF9 CA F3 80         jp   z, .next_enemy
 635+ 7FFC
 636+ 7FFC                  ; ---------------------------------------------------------------
 637+ 7FFC                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 638+ 7FFC                  ; ---------------------------------------------------------------
 639+ 7FFC                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 640+ 7FFC 3A DE C6         ld   a, (PlayerPos)            ; WillyX
 641+ 7FFF DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 642+ 8002 FE 10            cp   16
 643+ 8004 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 644+ 8006 FE F9            cp   249                       ; 249..255 = -7..-1
 645+ 8008 DA F3 80         jp   c, .next_enemy            ; 16..248 -> fuori range
 646+ 800B              .x_in_range:
 647+ 800B 32 05 CD         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 648+ 800E
 649+ 800E                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 650+ 800E 3A DF C6         ld   a, (PlayerPos+1)          ; WillyY
 651+ 8011 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 652+ 8014 FE 10            cp   16
 653+ 8016 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 654+ 8018 FE F1            cp   241                       ; 241..255 = -15..-1
 655+ 801A DA F3 80         jp   c, .next_enemy            ; 16..240 -> fuori range
 656+ 801D              .y_in_range:
 657+ 801D 32 06 CD         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 658+ 8020
 659+ 8020                  ; ---------------------------------------------------------------
 660+ 8020                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 661+ 8020                  ; ---------------------------------------------------------------
 662+ 8020 C5               push bc                        ; Salva contatore nemici (B)
 663+ 8021
 664+ 8021                  ; Controlla se è guardiano verticale
 665+ 8021 DD 7E 00         ld   a, (ix+0)
 666+ 8024 E6 40            and  $40                       ; Vertical?
 667+ 8026 20 15            jr   nz, .col_guard_vert
 668+ 8028
 669+ 8028 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 670+ 802B E6 03            and  3
 671+ 802D 4F               ld   c, a
 672+ 802E
 673+ 802E DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 674+ 8031 FE 01            cp   1
 675+ 8033 28 03            jr   z, .guard_left_frame
 676+ 8035                  ; Frame Destra: Frame = Subframe (0..3)
 677+ 8035 79               ld   a, c
 678+ 8036 18 0A            jr   .calc_guard_ptr
 679+ 8038              .guard_left_frame:
 680+ 8038                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 681+ 8038 3E 04            ld   a, 4
 682+ 803A 81               add  a, c
 683+ 803B 18 05            jr   .calc_guard_ptr
 684+ 803D
 685+ 803D              .col_guard_vert:
 686+ 803D                  ; Guardiano verticale: usa il frame salvato in (ix+1) (4..7)
 687+ 803D DD 7E 01         ld   a, (ix+1)
 688+ 8040 E6 07            and  7
 689+ 8042
 690+ 8042              .calc_guard_ptr:
 691+ 8042                  ; Offset = Frame * 32
 692+ 8042 6F               ld   l, a
 693+ 8043 26 00            ld   h, 0
 694+ 8045 29               add  hl, hl                    ; *2
 695+ 8046 29               add  hl, hl                    ; *4
 696+ 8047 29               add  hl, hl                    ; *8
 697+ 8048 29               add  hl, hl                    ; *16
 698+ 8049 29               add  hl, hl                    ; *32
 699+ 804A 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 700+ 804D 19               add  hl, de
 701+ 804E ED 5B 5F CA      ld   de, (room_ptr)
 702+ 8052 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 703+ 8053 22 03 CD         ld   (guard_sprite_ptr), hl
 704+ 8056
 705+ 8056                  ; ---------------------------------------------------------------
 706+ 8056                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 707+ 8056                  ; ---------------------------------------------------------------
 708+ 8056 3A 06 CD         ld   a, (collision_delta_y)
 709+ 8059 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 710+ 805B 20 12            jr   nz, .willy_higher
 711+ 805D
 712+ 805D                  ; Willy lower or equal (DeltaY >= 0):
 713+ 805D                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 714+ 805D 32 07 CD         ld   (row_enemy_cur), a
 715+ 8060 AF               xor  a
 716+ 8061 32 08 CD         ld   (row_willy_cur), a
 717+ 8064 3E 10            ld   a, 16
 718+ 8066 21 06 CD         ld   hl, collision_delta_y
 719+ 8069 96               sub  (hl)
 720+ 806A 32 09 CD         ld   (overlap_num_lines), a
 721+ 806D 18 12            jr   .check_lines_loop
 722+ 806F
 723+ 806F              .willy_higher:
 724+ 806F                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 725+ 806F ED 44            neg                            ; A = -DeltaY (1..15)
 726+ 8071 32 08 CD         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 727+ 8074 AF               xor  a
 728+ 8075 32 07 CD         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 729+ 8078 3E 10            ld   a, 16
 730+ 807A 21 08 CD         ld   hl, row_willy_cur
 731+ 807D 96               sub  (hl)
 732+ 807E 32 09 CD         ld   (overlap_num_lines), a
 733+ 8081
 734+ 8081              .check_lines_loop:
 735+ 8081                  ; ---------------------------------------------------------------
 736+ 8081                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 737+ 8081                  ; ---------------------------------------------------------------
 738+ 8081 3A 09 CD         ld   a, (overlap_num_lines)
 739+ 8084 47               ld   b, a                      ; B = numero di scanlines da controllare
 740+ 8085
 741+ 8085              .scanline_loop:
 742+ 8085 C5               push bc                        ; Salva contatore scanlines
 743+ 8086
 744+ 8086                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 745+ 8086 3A 07 CD         ld   a, (row_enemy_cur)
 746+ 8089 87               add  a, a                      ; row * 2
 747+ 808A 5F               ld   e, a
 748+ 808B 16 00            ld   d, 0
 749+ 808D 2A 03 CD         ld   hl, (guard_sprite_ptr)
 750+ 8090 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 751+ 8091 56               ld   d, (hl)                   ; D = Enemy Byte 0
 752+ 8092 23               inc  hl
 753+ 8093 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 754+ 8094
 755+ 8094                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 756+ 8094 3A 05 CD         ld   a, (collision_delta_x)
 757+ 8097 CB 7F            bit  7, a
 758+ 8099 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 759+ 809B
 760+ 809B                  ; DeltaX >= 0:
 761+ 809B FE 09            cp   9
 762+ 809D 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 763+ 809F
 764+ 809F                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 765+ 809F B7               or   a
 766+ 80A0 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 767+ 80A2 4F               ld   c, a                      ; C = DeltaX (1..8)
 768+ 80A3              .shift_left_16bit:
 769+ 80A3 CB 23            sla  e
 770+ 80A5 CB 12            rl   d
 771+ 80A7 0D               dec  c
 772+ 80A8 20 F9            jr   nz, .shift_left_16bit
 773+ 80AA              .slice_ready_in_d:
 774+ 80AA 7A               ld   a, d                      ; A = fetta guardiano allineata
 775+ 80AB 18 14            jr   .test_willy_line
 776+ 80AD
 777+ 80AD              .shift_dx_gt_8:
 778+ 80AD                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 779+ 80AD D6 08            sub  8
 780+ 80AF 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 781+ 80B0              .shift_left_e_only:
 782+ 80B0 CB 23            sla  e
 783+ 80B2 0D               dec  c
 784+ 80B3 20 FB            jr   nz, .shift_left_e_only
 785+ 80B5 7B               ld   a, e                      ; A = fetta guardiano allineata
 786+ 80B6 18 09            jr   .test_willy_line
 787+ 80B8
 788+ 80B8              .shift_neg_dx:
 789+ 80B8                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 790+ 80B8 ED 44            neg
 791+ 80BA 4F               ld   c, a                      ; C = -DeltaX (1..7)
 792+ 80BB              .shift_right_d_only:
 793+ 80BB CB 3A            srl  d
 794+ 80BD 0D               dec  c
 795+ 80BE 20 FB            jr   nz, .shift_right_d_only
 796+ 80C0 7A               ld   a, d                      ; A = fetta guardiano allineata
 797+ 80C1
 798+ 80C1              .test_willy_line:
 799+ 80C1                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 800+ 80C1 B7               or   a
 801+ 80C2 28 21            jr   z, .next_scanline
 802+ 80C4
 803+ 80C4                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 804+ 80C4 4F               ld   c, a                      ; C = fetta guardiano
 805+ 80C5 3A 08 CD         ld   a, (row_willy_cur)
 806+ 80C8 FE 08            cp   8
 807+ 80CA 38 0D            jr   c, .read_willy_head
 808+ 80CC
 809+ 80CC                  ; Riga corpo (8..15)
 810+ 80CC D6 08            sub  8
 811+ 80CE 6F               ld   l, a
 812+ 80CF 26 00            ld   h, 0
 813+ 80D1 ED 5B 01 CD      ld   de, (willy_body_ptr)
 814+ 80D5 19               add  hl, de
 815+ 80D6 7E               ld   a, (hl)                   ; A = byte corpo Willy
 816+ 80D7 18 09            jr   .do_pixel_and
 817+ 80D9
 818+ 80D9              .read_willy_head:
 819+ 80D9                  ; Riga testa (0..7)
 820+ 80D9 6F               ld   l, a
 821+ 80DA 26 00            ld   h, 0
 822+ 80DC ED 5B FF CC      ld   de, (willy_head_ptr)
 823+ 80E0 19               add  hl, de
 824+ 80E1 7E               ld   a, (hl)                   ; A = byte testa Willy
 825+ 80E2
 826+ 80E2              .do_pixel_and:
 827+ 80E2                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 828+ 80E2 A1               and  c
 829+ 80E3 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 830+ 80E5
 831+ 80E5              .next_scanline:
 832+ 80E5                  ; Avanza alla prossima riga
 833+ 80E5 21 07 CD         ld   hl, row_enemy_cur
 834+ 80E8 34               inc  (hl)
 835+ 80E9 21 08 CD         ld   hl, row_willy_cur
 836+ 80EC 34               inc  (hl)
 837+ 80ED
 838+ 80ED C1               pop  bc                        ; Ripristina B (contatore scanlines)
 839+ 80EE 05               dec  b
 840+ 80EF C2 85 80         jp   nz, .scanline_loop
 841+ 80F2
 842+ 80F2                  ; Nessun pixel sovrapposto per questo guardiano
 843+ 80F2 C1               pop  bc                        ; Ripristina B (contatore nemici)
 844+ 80F3
 845+ 80F3              .next_enemy:
 846+ 80F3 11 0B 00         ld   de, 11
 847+ 80F6 DD 19            add  ix, de

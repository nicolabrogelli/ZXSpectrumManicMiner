  72+ 882B ~            ; Audio_UpdateMusic
  73+ 882B ~            ;
  74+ 882B ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 882B ~            ; Viene chiamata a ogni frame.
  76+ 882B ~            ; -------------------------------------------------------------------
  77+ 882B ~            Audio_UpdateMusic:
  78+ 882B ~                push af
  79+ 882B ~                push bc
  80+ 882B ~                push de
  81+ 882B ~                push hl
  82+ 882B ~
  83+ 882B ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 882B ~                ld   a, (Audio_jump_sound_note)
  85+ 882B ~                cp   18
  86+ 882B ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 882B ~
  88+ 882B ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 882B ~                ld   a, (Audio_music_frame_counter)
  90+ 882B ~                dec  a
  91+ 882B ~                ld   (Audio_music_frame_counter), a
  92+ 882B ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 882B ~
  94+ 882B ~                ; Altrimenti carica la nota successiva
  95+ 882B ~                ld   a, (Audio_music_note_idx)
  96+ 882B ~                inc  a
  97+ 882B ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 882B ~                jr   c, .no_wrap
  99+ 882B ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 882B ~            .no_wrap:
 101+ 882B ~                ld   (Audio_music_note_idx), a
 102+ 882B ~
 103+ 882B ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 882B ~                ld   e, a
 105+ 882B ~                ld   d, 0
 106+ 882B ~                ld   hl, Audio_MusicSheet
 107+ 882B ~                add  hl, de
 108+ 882B ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 882B ~
 110+ 882B ~                ; Leggi durata (secondo byte)
 111+ 882B ~                inc  hl
 112+ 882B ~                ld   a, (hl)
 113+ 882B ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 882B ~                jr   nz, .dur_ok
 115+ 882B ~                ld   a, 1
 116+ 882B ~            .dur_ok:
 117+ 882B ~                ld   (Audio_music_frame_counter), a
 118+ 882B ~
 119+ 882B ~            .play_current_note:
 120+ 882B ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 882B ~                ld   a, (Audio_music_note_idx)
 122+ 882B ~                ld   e, a
 123+ 882B ~                ld   d, 0
 124+ 882B ~                ld   hl, Audio_MusicSheet
 125+ 882B ~                add  hl, de
 126+ 882B ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 882B ~                ld   a, (hl)                  ; A = delay
 128+ 882B ~                or   a
 129+ 882B ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 882B ~
 131+ 882B ~                ; Suona la nota: 2 cicli
 132+ 882B ~                ld   d, a                     ; D = delay
 133+ 882B ~                ld   b, 2                     ; 2 cicli per frame
 134+ 882B ~            .note_loop:
 135+ 882B ~                ; Speaker ON
 136+ 882B ~                ld   a, (room_border_color)
 137+ 882B ~                or   $10
 138+ 882B ~                out  ($fe), a
 139+ 882B ~                ld   c, d
 140+ 882B ~            .d1:
 141+ 882B ~                push af
 142+ 882B ~                pop  af
 143+ 882B ~                dec  c
 144+ 882B ~                jr   nz, .d1
 145+ 882B ~
 146+ 882B ~                ; Speaker OFF
 147+ 882B ~                ld   a, (room_border_color)
 148+ 882B ~                and  $ef
 149+ 882B ~                out  ($fe), a
 150+ 882B ~                ld   c, d
 151+ 882B ~            .d2:
 152+ 882B ~                push af
 153+ 882B ~                pop  af
 154+ 882B ~                dec  c
 155+ 882B ~                jr   nz, .d2
 156+ 882B ~
 157+ 882B ~                djnz .note_loop
 158+ 882B ~
 159+ 882B ~            .done:
 160+ 882B ~                pop  hl
 161+ 882B ~                pop  de
 162+ 882B ~                pop  bc
 163+ 882B ~                pop  af
 164+ 882B ~                ret
 165+ 882B ~
 166+ 882B ~            Audio_MusicSheet:
 167+ 882B ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 882B ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 882B ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 882B ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 882B ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 882B ~                db 90, 10, 107, 20, 68, 65

 293+ 85C4              ; DrawItemGraphic
 294+ 85C4              ;
 295+ 85C4              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 85C4              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 85C4              ;
 298+ 85C4              ; Input:
 299+ 85C4              ;   B = Riga attributi (0..23)
 300+ 85C4              ;   C = Colonna attributi (0..31)
 301+ 85C4              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)

 419+ 7F86 CA 25 80         jp   z, .next
 420+ 7F89
 421+ 7F89                  ; 1. Aggiorna Anim State (0..3)
 422+ 7F89 DD 7E 07         ld   a, (ix+7)
 423+ 7F8C 3C               inc  a
 424+ 7F8D E6 03            and  3
 425+ 7F8F DD 77 07         ld   (ix+7), a
 426+ 7F92
 427+ 7F92                  ; 2. Determina se orizzontale o verticale
 428+ 7F92 DD 7E 00         ld   a, (ix+0)
 429+ 7F95 E6 40            and  $40                       ; Vertical?
 430+ 7F97 C2 E1 7F         jp   nz, .vertical
 431+ 7F9A
 432+ 7F9A              .horizontal:
 433+ 7F9A DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7F9D FE 01            cp   1
 435+ 7F9F 20 20            jr   nz, .horiz_right
 436+ 7FA1
 437+ 7FA1              .horiz_left:
 438+ 7FA1 DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7FA4 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7FA6 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7FA9 28 08            jr   z, .h_rev_right
 442+ 7FAB 38 06            jr   c, .h_rev_right
 443+ 7FAD DD 77 02         ld   (ix+2), a
 444+ 7FB0 C3 25 80         jp   .next
 445+ 7FB3
 446+ 7FB3              .h_rev_right:
 447+ 7FB3 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7FB6 DD 77 02         ld   (ix+2), a
 449+ 7FB9 3E 02            ld   a, 2
 450+ 7FBB DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7FBE C3 25 80         jp   .next
 452+ 7FC1
 453+ 7FC1              .horiz_right:
 454+ 7FC1 DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7FC4 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7FC6 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7FC9 28 08            jr   z, .h_rev_left
 458+ 7FCB 30 06            jr   nc, .h_rev_left
 459+ 7FCD DD 77 02         ld   (ix+2), a
 460+ 7FD0 C3 25 80         jp   .next
 461+ 7FD3
 462+ 7FD3              .h_rev_left:
 463+ 7FD3 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7FD6 DD 77 02         ld   (ix+2), a
 465+ 7FD9 3E 01            ld   a, 1

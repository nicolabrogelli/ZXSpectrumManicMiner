 316+ 7ECA              ; Enemy_DrawSingleSlot
 317+ 7ECA              ;
 318+ 7ECA              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7ECA              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7ECA              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7ECA              ; -------------------------------------------------------------------
 322+ 7ECA              Enemy_DrawSingleSlot:
 323+ 7ECA C5               push bc
 324+ 7ECB D5               push de
 325+ 7ECC E5               push hl
 326+ 7ECD DD E5            push ix
 327+ 7ECF
 328+ 7ECF                  ; 1. Determina il frame di animazione (0..7)
 329+ 7ECF                  ; Nei dati di Manic Miner:
 330+ 7ECF                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7ECF                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7ECF DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7ED2 E6 03            and  3
 334+ 7ED4 47               ld   b, a                      ; B = Anim subframe
 335+ 7ED5
 336+ 7ED5 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7ED8 FE 01            cp   1                         ; Sinistra?
 338+ 7EDA 28 03            jr   z, .left_frames
 339+ 7EDC
 340+ 7EDC                  ; Movimento a Destra: Frame 0..3
 341+ 7EDC 78               ld   a, b
 342+ 7EDD 18 03            jr   .got_frame_idx
 343+ 7EDF
 344+ 7EDF              .left_frames:
 345+ 7EDF                  ; Movimento a Sinistra: Frame 4..7
 346+ 7EDF 3E 04            ld   a, 4
 347+ 7EE1 80               add  a, b
 348+ 7EE2
 349+ 7EE2              .got_frame_idx:
 350+ 7EE2                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7EE2 6F               ld   l, a
 352+ 7EE3 26 00            ld   h, 0
 353+ 7EE5 29               add  hl, hl                    ; *2
 354+ 7EE6 29               add  hl, hl                    ; *4
 355+ 7EE7 29               add  hl, hl                    ; *8
 356+ 7EE8 29               add  hl, hl                    ; *16
 357+ 7EE9 29               add  hl, hl                    ; *32
 358+ 7EEA
 359+ 7EEA 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7EED 19               add  hl, de
 361+ 7EEE ED 5B B3 A1      ld   de, (room_ptr)
 362+ 7EF2 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7EF3 E5               push hl
 364+ 7EF4 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7EF6
 366+ 7EF6                  ; 2. Coordinate e colore
 367+ 7EF6 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7EF8 FD E5            push iy
 369+ 7EFA
 370+ 7EFA FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7EFD FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7F00 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7F03
 374+ 7F03                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7F03 CD 6B 5F         call Gfx_DrawPixelSprite16x16
 376+ 7F06 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7F09 CD 5B 6D         call Gfx_SetEnemyColorAttributes
 378+ 7F0C
 379+ 7F0C DD E1            pop  ix
 380+ 7F0E E1               pop  hl
 381+ 7F0F D1               pop  de
 382+ 7F10 C1               pop  bc
 383+ 7F11 C9               ret

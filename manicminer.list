1623+ 664B 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1624+ 664E 3E 42            ld   a, RED | $40          ; Rosso Brillante
1625+ 6650 CD 1F 6D         call Gfx_SetEnemyColorAttributes
1626+ 6653
1627+ 6653                  ; 4. Stampa il Nome della Stanza a riga 16
1628+ 6653 CD C0 62         call Gfx_PrintRoomName
1629+ 6656
1630+ 6656                  ; 5. Stampa la riga di stato a riga 18
1631+ 6656 21 5F 69         ld   hl, status_line       ; HL = indirizzo stringa di stato
1632+ 6659 06 20            ld   b, 32                 ; B = 32 caratteri
1633+ 665B 16 12            ld   d, 18
1634+ 665D 1E 00            ld   e, 0
1635+ 665F CD 41 62         call Gfx_PrintDirectText

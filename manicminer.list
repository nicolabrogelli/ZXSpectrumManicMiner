   8+ 88C0              ; Audio_UpdateJumpSound
   9+ 88C0              ;
  10+ 88C0              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 88C0              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 88C0              ; -------------------------------------------------------------------
  13+ 88C0              Audio_UpdateJumpSound:
  14+ 88C0 F5               push af
  15+ 88C1 C5               push bc
  16+ 88C2 D5               push de
  17+ 88C3 E5               push hl
  18+ 88C4
  19+ 88C4                  ; Controlla se il suono è attivo (note < 18)
  20+ 88C4 3A 4C F1         ld   a, (Audio_jump_sound_note)
  21+ 88C7 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 88C9 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 88CB
  24+ 88CB                  ; Carica la nota corrente da suonare
  25+ 88CB 5F               ld   e, a
  26+ 88CC 16 00            ld   d, 0
  27+ 88CE 21 FA 88         ld   hl, Audio_JumpSoundDelays
  28+ 88D1 19               add  hl, de
  29+ 88D2 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 88D3 57               ld   d, a                      ; D = delay della nota
  31+ 88D4
  32+ 88D4                  ; Suona la nota: 15 cicli
  33+ 88D4 06 0F            ld   b, 15
  34+ 88D6              .note_loop:
  35+ 88D6                  ; Speaker ON
  36+ 88D6 3A 37 EB         ld   a, (room_border_color)
  37+ 88D9 F6 10            or   $10
  38+ 88DB D3 FE            out  ($fe), a
  39+ 88DD 4A               ld   c, d
  40+ 88DE              .d1:
  41+ 88DE 0D               dec  c
  42+ 88DF 20 FD            jr   nz, .d1
  43+ 88E1
  44+ 88E1                  ; Speaker OFF
  45+ 88E1 3A 37 EB         ld   a, (room_border_color)
  46+ 88E4 E6 EF            and  $ef
  47+ 88E6 D3 FE            out  ($fe), a
  48+ 88E8 4A               ld   c, d
  49+ 88E9              .d2:
  50+ 88E9 0D               dec  c
  51+ 88EA 20 FD            jr   nz, .d2
  52+ 88EC
  53+ 88EC 10 E8            djnz .note_loop
  54+ 88EE
  55+ 88EE                  ; Passa alla nota successiva
  56+ 88EE 3A 4C F1         ld   a, (Audio_jump_sound_note)
  57+ 88F1 3C               inc  a
  58+ 88F2 32 4C F1         ld   (Audio_jump_sound_note), a
  59+ 88F5
  60+ 88F5              .done:
  61+ 88F5 E1               pop  hl
  62+ 88F6 D1               pop  de
  63+ 88F7 C1               pop  bc
  64+ 88F8 F1               pop  af
  65+ 88F9 C9               ret

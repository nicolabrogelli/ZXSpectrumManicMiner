1660+ 7AB3 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1661+ 7AB5 32 88 AA         ld   (room_jump_strength), a
1662+ 7AB8 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1663+ 7ABA 32 89 AA         ld   (room_gravity_preset), a
1664+ 7ABD F1               pop  af
1665+ 7ABE C9               ret

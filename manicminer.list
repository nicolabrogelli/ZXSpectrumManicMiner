 330+ 6FA7              ; LoadPositionPlayeinRoom
 331+ 6FA7              ;
 332+ 6FA7              ; Inizializza la posizione del player (Willy) quando entra
 333+ 6FA7              ; in una nuova stanza.
 334+ 6FA7              ;
 335+ 6FA7              ; La posizione viene letta direttamente dai dati della stanza
 336+ 6FA7              ; (layout/metadata) a partire da room_ptr.
 337+ 6FA7              ;
 338+ 6FA7              ; Output:
 339+ 6FA7              ;   PlayerPos     = posizione iniziale (Y, X)
 340+ 6FA7              ;   PlayerPosOld  = copia della posizione iniziale
 341+ 6FA7              ;
 342+ 6FA7              ; Struttura dati stanza:
 343+ 6FA7              ;   OFFSET_POS_WILLY:
 344+ 6FA7              ;       +0 = X
 345+ 6FA7              ;       +1 = Y
 346+ 6FA7              ; -------------------------------------------------------------------
 347+ 6FA7              LoadPositionPlayeinRoom:
 348+ 6FA7                  ; ---------------------------------------------------------------
 349+ 6FA7                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 350+ 6FA7                  ; ---------------------------------------------------------------
 351+ 6FA7 2A 3C E4         ld   hl, (room_ptr)
 352+ 6FAA 11 68 02         ld   de, OFFSET_POS_WILLY
 353+ 6FAD 19               add  hl, de
 354+ 6FAE
 355+ 6FAE                  ; Byte 0: Y * 2
 356+ 6FAE 7E               ld   a, (hl)
 357+ 6FAF CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 358+ 6FB1 57               ld   d, a                      ; D = PlayerY
 359+ 6FB2
 360+ 6FB2                  ; Byte 1: Anim frame
 361+ 6FB2 23               inc  hl
 362+ 6FB3 7E               ld   a, (hl)
 363+ 6FB4 E6 03            and  3                         ; Garanzia valore valido (0..3)
 364+ 6FB6 FE 03            cp   3
 365+ 6FB8 38 01            jr   c, .valid_anim
 366+ 6FBA AF               xor  a
 367+ 6FBB              .valid_anim:
 368+ 6FBB 32 C1 E0         ld   (body_state), a
 369+ 6FBE 32 C4 E4         ld   (player_old_body), a
 370+ 6FC1
 371+ 6FC1                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 372+ 6FC1 23               inc  hl                        ; Byte 2 (Direction)
 373+ 6FC2 7E               ld   a, (hl)
 374+ 6FC3 E6 01            and  1
 375+ 6FC5 28 04            jr   z, .facing_right
 376+ 6FC7 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 377+ 6FC9 18 02            jr   .set_dir

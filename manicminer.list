 271+ 7E3B DD 36 05 58      ld   (ix+5), 88                ; Max Y = 88
 272+ 7E3F DD 36 06 00      ld   (ix+6), 0                 ; Kong status = 0 (on ledge)
 273+ 7E43 DD 36 07 00      ld   (ix+7), 0
 274+ 7E47 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
 275+ 7E4B DD 36 09 FF      ld   (ix+9), $FF               ; Old Y

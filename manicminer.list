 850  879A BB               cp   e
 851  879B 28 04            jr   z, .x_check
 852  879D 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  879F 18 29            jr   .no_conv_collision
 854  87A1

  12+ 82F8              ; -------------------------------------------------------------------
  13+ 82F8              Audio_UpdateJumpSound:
  14+ 82F8 F5               push af
  15+ 82F9 C5               push bc
  16+ 82FA D5               push de
  17+ 82FB E5               push hl
  18+ 82FC
  19+ 82FC                  ; Controlla se il suono è attivo (note < 18)
  20+ 82FC 3A 4E A4         ld   a, (Audio_jump_sound_note)
  21+ 82FF FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8301 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8303
  24+ 8303                  ; Carica la nota corrente da suonare
  25+ 8303 5F               ld   e, a
  26+ 8304 16 00            ld   d, 0
  27+ 8306 21 32 83         ld   hl, Audio_JumpSoundDelays
  28+ 8309 19               add  hl, de
  29+ 830A 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 830B 57               ld   d, a                      ; D = delay della nota
  31+ 830C
  32+ 830C                  ; Suona la nota: 15 cicli
  33+ 830C 06 0F            ld   b, 15
  34+ 830E              .note_loop:
  35+ 830E                  ; Speaker ON
  36+ 830E 3A 3E 9E         ld   a, (room_border_color)
  37+ 8311 F6 10            or   $10
  38+ 8313 D3 FE            out  ($fe), a
  39+ 8315 4A               ld   c, d
  40+ 8316              .d1:
  41+ 8316 0D               dec  c
  42+ 8317 20 FD            jr   nz, .d1
  43+ 8319
  44+ 8319                  ; Speaker OFF

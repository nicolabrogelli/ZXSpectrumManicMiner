 202+ 7DA7              ; -------------------------------------------------------------------
 203+ 7DA7              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 204+ 7DA7              ; -------------------------------------------------------------------
 205+ 7DA7              CheckEnemyWillyOverlap:
 206+ 7DA7 3A E5 CA         ld   a, (player_drawn_pos+1)
 207+ 7DAA FE FF            cp   $FF
 208+ 7DAC C8               ret  z                  ; Se Willy non è disegnato, esci
 209+ 7DAD
 210+ 7DAD                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 211+ 7DAD 3A E4 CA         ld   a, (player_drawn_pos)
 212+ 7DB0 E6 F8            and  $F8
 213+ 7DB2 5F               ld   e, a               ; E = WillyX & $F8
 214+ 7DB3 79               ld   a, c
 215+ 7DB4 E6 F8            and  $F8                ; A = EnemyX & $F8
 216+ 7DB6 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 217+ 7DB7 C6 10            add  a, 16
 218+ 7DB9 FE 19            cp   25
 219+ 7DBB D0               ret  nc                 ; Fuori portata X
 220+ 7DBC
 221+ 7DBC                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 222+ 7DBC 3A E5 CA         ld   a, (player_drawn_pos+1) ; A = WillyY
 223+ 7DBF 90               sub  b                  ; A = WillyY - EnemyY
 224+ 7DC0 C6 0F            add  a, 15
 225+ 7DC2 FE 1F            cp   31
 226+ 7DC4 D0               ret  nc                 ; Fuori portata Y
 227+ 7DC5
 228+ 7DC5                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 229+ 7DC5 3E 01            ld   a, 1
 230+ 7DC7 32 EA CA         ld   (willy_needs_redraw), a
 231+ 7DCA C9               ret

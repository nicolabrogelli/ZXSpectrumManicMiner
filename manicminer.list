 848+ 775A              ; -------------------------------------------------------------------
 849+ 775A              IsCellOnRamp:
 850+ 775A C5               push bc
 851+ 775B E5               push hl
 852+ 775C
 853+ 775C 3A B7 E4         ld   a, (ramp_len)
 854+ 775F B7               or   a
 855+ 7760 28 6B            jr   z, .no
 856+ 7762
 857+ 7762                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 858+ 7762 3A B6 E4         ld   a, (ramp_dir)
 859+ 7765 B7               or   a
 860+ 7766 28 1A            jr   z, .range_left
 861+ 7768              .range_right:
 862+ 7768 3A B9 E4         ld   a, (ramp_col)
 863+ 776B 47               ld   b, a              ; B = ramp_col
 864+ 776C 3A B7 E4         ld   a, (ramp_len)
 865+ 776F 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7770 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7771
 868+ 7771 7B               ld   a, e              ; A = Col
 869+ 7772 B8               cp   b
 870+ 7773 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7775 B9               cp   c
 872+ 7776 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 7778
 874+ 7778                  ; Calcola B = Col - ramp_col
 875+ 7778 7B               ld   a, e
 876+ 7779 90               sub  b
 877+ 777A 47               ld   b, a              ; B = offset (0..ramp_len-1)
 878+ 777B
 879+ 777B                  ; SlopeRow = ramp_row - B
 880+ 777B 3A B8 E4         ld   a, (ramp_row)
 881+ 777E 90               sub  b
 882+ 777F 47               ld   b, a              ; B = SlopeRow

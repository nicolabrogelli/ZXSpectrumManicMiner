 223  831F 21 8D 5C         ld   hl, ATTR_P
 224  8322 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 225  8323 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 226  8326 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 227  8328 3E 07            ld   a, $07

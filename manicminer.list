 102+ 5DAD              ; --- Velocità dell'orologio di gioco (Test rapido) ---
 103+ 5DAD              ; 1 = Modalità Test rapido (1 secondo reale = 1 minuto di gioco, 50 tick IM2 a 50Hz)
 104+ 5DAD              ; 0 = Modalità Normale (40 secondi reali = 1 minuto di gioco, 2000 tick IM2 a 50Hz)
 105+ 5DAD                  IFNDEF ENABLE_FAST_CLOCK_TEST
 106+ 5DAD              ENABLE_FAST_CLOCK_TEST EQU 0
 107+ 5DAD                  ENDIF
 108+ 5DAD
 109+ 5DAD                  IF ENABLE_FAST_CLOCK_TEST != 0
 110+ 5DAD ~            CLOCK_TICKS_PER_MINUTE EQU 50    ; Test rapido: 1 secondo reale = 1 minuto di gioco
 111+ 5DAD                  ELSE
 112+ 5DAD              CLOCK_TICKS_PER_MINUTE EQU 2000  ; Normale: 40 secondi reali = 1 minuto di gioco
 113+ 5DAD                  ENDIF

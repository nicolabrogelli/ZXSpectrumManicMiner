 358+ 6CC7                  ; Calcola indirizzo di OFFSET_POS_WILLY
 359+ 6CC7 21 68 02         ld   hl, OFFSET_POS_WILLY
 360+ 6CCA 19               add  hl, de                    ; HL = layout + OFFSET_POS_WILLY
 361+ 6CCB
 362+ 6CCB 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 363+ 6CCC CB 3F            srl  a
 364+ 6CCE F5               push af                        ; Salva PlayerY sullo stack
 365+ 6CCF
 366+ 6CCF 23               inc  hl                        ; Byte 1
 367+ 6CD0 23               inc  hl                        ; Byte 2
 368+ 6CD1 23               inc  hl                        ; Byte 3

  33+ 7DBB BB               cp   e
  34+ 7DBC 20 06            jr   nz, .no_match
  35+ 7DBE 23               inc  hl
  36+ 7DBF 7E               ld   a, (hl)
  37+ 7DC0 BA               cp   d
  38+ 7DC1 28 08            jr   z, .found
  39+ 7DC3 2B               dec  hl
  40+ 7DC4

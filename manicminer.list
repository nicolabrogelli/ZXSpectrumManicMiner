  72+ 85FF ~            ; Audio_UpdateMusic
  73+ 85FF ~            ;
  74+ 85FF ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 85FF ~            ; Viene chiamata a ogni frame.
  76+ 85FF ~            ; -------------------------------------------------------------------
  77+ 85FF ~            Audio_UpdateMusic:
  78+ 85FF ~                push af
  79+ 85FF ~                push bc
  80+ 85FF ~                push de
  81+ 85FF ~                push hl
  82+ 85FF ~
  83+ 85FF ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 85FF ~                ld   a, (Audio_jump_sound_note)
  85+ 85FF ~                cp   18
  86+ 85FF ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 85FF ~
  88+ 85FF ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 85FF ~                ld   a, (Audio_music_frame_counter)
  90+ 85FF ~                dec  a
  91+ 85FF ~                ld   (Audio_music_frame_counter), a
  92+ 85FF ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 85FF ~
  94+ 85FF ~                ; Altrimenti carica la nota successiva
  95+ 85FF ~                ld   a, (Audio_music_note_idx)
  96+ 85FF ~                inc  a
  97+ 85FF ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 85FF ~                jr   c, .no_wrap
  99+ 85FF ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 85FF ~            .no_wrap:
 101+ 85FF ~                ld   (Audio_music_note_idx), a
 102+ 85FF ~
 103+ 85FF ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 85FF ~                ld   e, a
 105+ 85FF ~                ld   d, 0
 106+ 85FF ~                ld   hl, Audio_MusicSheet
 107+ 85FF ~                add  hl, de
 108+ 85FF ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 85FF ~
 110+ 85FF ~                ; Leggi durata (secondo byte)
 111+ 85FF ~                inc  hl
 112+ 85FF ~                ld   a, (hl)
 113+ 85FF ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 85FF ~                jr   nz, .dur_ok
 115+ 85FF ~                ld   a, 1
 116+ 85FF ~            .dur_ok:
 117+ 85FF ~                ld   (Audio_music_frame_counter), a
 118+ 85FF ~
 119+ 85FF ~            .play_current_note:
 120+ 85FF ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 85FF ~                ld   a, (Audio_music_note_idx)
 122+ 85FF ~                ld   e, a
 123+ 85FF ~                ld   d, 0
 124+ 85FF ~                ld   hl, Audio_MusicSheet
 125+ 85FF ~                add  hl, de
 126+ 85FF ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 85FF ~                ld   a, (hl)                  ; A = delay
 128+ 85FF ~                or   a
 129+ 85FF ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 85FF ~
 131+ 85FF ~                ; Suona la nota: 2 cicli
 132+ 85FF ~                ld   d, a                     ; D = delay
 133+ 85FF ~                ld   b, 2                     ; 2 cicli per frame
 134+ 85FF ~            .note_loop:
 135+ 85FF ~                ; Speaker ON
 136+ 85FF ~                ld   a, (room_border_color)
 137+ 85FF ~                or   $10
 138+ 85FF ~                out  ($fe), a
 139+ 85FF ~                ld   c, d
 140+ 85FF ~            .d1:
 141+ 85FF ~                push af
 142+ 85FF ~                pop  af
 143+ 85FF ~                dec  c
 144+ 85FF ~                jr   nz, .d1
 145+ 85FF ~
 146+ 85FF ~                ; Speaker OFF
 147+ 85FF ~                ld   a, (room_border_color)
 148+ 85FF ~                and  $ef
 149+ 85FF ~                out  ($fe), a
 150+ 85FF ~                ld   c, d
 151+ 85FF ~            .d2:
 152+ 85FF ~                push af
 153+ 85FF ~                pop  af
 154+ 85FF ~                dec  c
 155+ 85FF ~                jr   nz, .d2
 156+ 85FF ~
 157+ 85FF ~                djnz .note_loop
 158+ 85FF ~
 159+ 85FF ~            .done:
 160+ 85FF ~                pop  hl
 161+ 85FF ~                pop  de
 162+ 85FF ~                pop  bc
 163+ 85FF ~                pop  af
 164+ 85FF ~                ret
 165+ 85FF ~
 166+ 85FF ~            Audio_MusicSheet:
 167+ 85FF ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 85FF ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 85FF ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 85FF ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 85FF ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 85FF ~                db 90, 10, 107, 20, 68, 65
 173+ 85FF                  ELSE
 174+ 85FF              Audio_UpdateMusic:
 175+ 85FF C9               ret

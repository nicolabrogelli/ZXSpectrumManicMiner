 393+ 7ECF              ; Enemy_DrawSingleSlot
 394+ 7ECF              ;
 395+ 7ECF              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 396+ 7ECF              ; La grafica (8 frame da 32 byte) è letta direttamente da

  29+ 7C9F              ; Enemy_LoadRoom
  30+ 7C9F              ;
  31+ 7C9F              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7C9F              ; Chiamato quando si entra in una stanza.
  33+ 7C9F              ; -------------------------------------------------------------------
  34+ 7C9F              Enemy_LoadRoom:
  35+ 7C9F E5               push hl
  36+ 7CA0 D5               push de
  37+ 7CA1 C5               push bc
  38+ 7CA2 DD E5            push ix
  39+ 7CA4
  40+ 7CA4                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CA4 21 47 7C         ld   hl, ActiveEnemies
  42+ 7CA7 11 48 7C         ld   de, ActiveEnemies + 1
  43+ 7CAA 36 00            ld   (hl), 0
  44+ 7CAC 01 57 00         ld   bc, 87
  45+ 7CAF ED B0            ldir
  46+ 7CB1
  47+ 7CB1                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CB1 DD 21 47 7C      ld   ix, ActiveEnemies
  49+ 7CB5 06 08            ld   b, 8
  50+ 7CB7 11 0B 00         ld   de, 11
  51+ 7CBA              .init_old_pos:
  52+ 7CBA DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7CBE DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CC2 DD 19            add  ix, de
  55+ 7CC4 10 F4            djnz .init_old_pos
  56+ 7CC6
  57+ 7CC6                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CC6 DD 21 47 7C      ld   ix, ActiveEnemies
  59+ 7CCA 2A 4C B6         ld   hl, (room_ptr)
  60+ 7CCD 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7CD0 19               add  hl, de
  62+ 7CD1
  63+ 7CD1 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CD3              .load_h_loop:
  65+ 7CD3 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CD4 FE FF            cp   $FF
  67+ 7CD6 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CD8 B7               or   a
  69+ 7CD9 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7CDB
  71+ 7CDB                  ; Slot attivo
  72+ 7CDB DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CDF DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7CE2
  75+ 7CE2 23               inc  hl
  76+ 7CE3 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7CE4 23               inc  hl
  78+ 7CE5 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7CE6
  80+ 7CE6                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7CE6 E5               push hl
  82+ 7CE7 C5               push bc
  83+ 7CE8 67               ld   h, a
  84+ 7CE9 69               ld   l, c
  85+ 7CEA 01 00 A4         ld   bc, -23552
  86+ 7CED 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7CEE
  88+ 7CEE                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7CEE 7D               ld   a, l
  90+ 7CEF E6 1F            and  31
  91+ 7CF1 87               add  a, a
  91+ 7CF2 87             add a, a
  91+ 7CF3 87             add a, a
  92+ 7CF4 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7CF7
  94+ 7CF7                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7CF7 CB 3C            srl  h
  95+ 7CF9 CB 1D          rr l
  96+ 7CFB CB 3C            srl  h
  96+ 7CFD CB 1D          rr l
  97+ 7CFF CB 3C            srl  h
  97+ 7D01 CB 1D          rr l
  98+ 7D03 CB 3C            srl  h
  98+ 7D05 CB 1D          rr l
  99+ 7D07 CB 3C            srl  h
  99+ 7D09 CB 1D          rr l
 100+ 7D0B 7D               ld   a, l
 101+ 7D0C 87               add  a, a
 101+ 7D0D 87             add a, a
 101+ 7D0E 87             add a, a
 102+ 7D0F DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D12 C1               pop  bc
 104+ 7D13 E1               pop  hl
 105+ 7D14
 106+ 7D14 23               inc  hl
 107+ 7D15 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D16 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D1A
 110+ 7D1A 23               inc  hl
 111+ 7D1B 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D1C E6 01            and  1
 113+ 7D1E 28 04            jr   z, .h_dir_right
 114+ 7D20 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7D22 18 02            jr   .set_h_dir

 222+ 5EA0
 223+ 5EA0 78               ld   a, b                  ; A = 1..8
 224+ 5EA1 3D               dec  a                     ; A = 0..7 (scanline per item da 8 byte)
 225+ 5EA2 5F               ld   e, a
 226+ 5EA3 16 00            ld   d, 0
 227+ 5EA5 2A F5 EF         ld   hl, (room_ptr)
 228+ 5EA8 01 B4 02         ld   bc, OFFSET_ITEM_GRAPHIC
 229+ 5EAB 09               add  hl, bc
 230+ 5EAC 19               add  hl, de                ; HL = indirizzo scanline item
 231+ 5EAD 7E               ld   a, (hl)               ; A = byte bitmap item
 232+ 5EAE
 233+ 5EAE C1               pop  bc
 234+ 5EAF D1               pop  de
 235+ 5EB0 E1               pop  hl
 236+ 5EB1 C9               ret
 237+ 5EB2
 238+ 5EB2              .no_item:
 239+ 5EB2 C1               pop  bc                    ; B = Scanline offset (1..8), C = Col
 240+ 5EB3 D1               pop  de                    ; D = Y, E = Row
 241+ 5EB4
 242+ 5EB4                  ; 5b. Controlla se la cella (Row E, Col C) appartiene al Portale (16x16 pixel a OFFSET_PORTAL = 655)
 243+ 5EB4 3A 91 F2         ld   a, (portal_row)
 244+ 5EB7 67               ld   h, a                  ; H = PortalRow (0..15)
 245+ 5EB8 7B               ld   a, e                  ; A = Row (0..15)
 246+ 5EB9 94               sub  h                     ; A = Row - PortalRow
 247+ 5EBA FE 02            cp   2
 248+ 5EBC 30 28            jr   nc, .not_portal_bg
 249+ 5EBE
 250+ 5EBE 67               ld   h, a                  ; H = DeltaRow (0..1)
 251+ 5EBF
 252+ 5EBF                  ; Confronta Col (in C) con PortalCol: DeltaCol = C - PortalCol
 253+ 5EBF 3A 92 F2         ld   a, (portal_col)
 254+ 5EC2 6F               ld   l, a                  ; L = PortalCol (0..31)
 255+ 5EC3 79               ld   a, c
 256+ 5EC4 95               sub  l
 257+ 5EC5 FE 02            cp   2
 258+ 5EC7 30 1D            jr   nc, .not_portal_bg
 259+ 5EC9
 260+ 5EC9                  ; A = DeltaCol (0..1)
 261+ 5EC9 6F               ld   l, a                  ; L = DeltaCol (0..1)
 262+ 5ECA
 263+ 5ECA                  ; --- LA CELLA APPARTIENE AL PORTALE! ---
 264+ 5ECA                  ; Calcola offset nella bitmap del portale (32 byte):
 265+ 5ECA                  ; ScanlineIndex = (DeltaRow * 8) + (ScanlineOffset - 1)
 266+ 5ECA                  ; BitmapOffset = (DeltaRow * 16) + (Scanline * 2) + DeltaCol
 267+ 5ECA 78               ld   a, b                  ; A = Scanline offset (1..8)
 268+ 5ECB 3D               dec  a                     ; A = Scanline (0..7)
 269+ 5ECC 87               add  a, a                  ; *2
 270+ 5ECD 85               add  a, l                  ; + DeltaCol
 271+ 5ECE 5F               ld   e, a
 272+ 5ECF 7C               ld   a, h                  ; A = DeltaRow (0..1)
 273+ 5ED0 B7               or   a
 274+ 5ED1 28 04            jr   z, .portal_top_row
 275+ 5ED3 7B               ld   a, e
 276+ 5ED4 C6 10            add  a, 16                 ; +16 per la riga inferiore del portale
 277+ 5ED6 5F               ld   e, a
 278+ 5ED7              .portal_top_row:
 279+ 5ED7 16 00            ld   d, 0
 280+ 5ED9 2A F5 EF         ld   hl, (room_ptr)
 281+ 5EDC 01 90 02         ld   bc, OFFSET_PORTAL + 1 ; Inizio bitmap 32 byte del portale
 282+ 5EDF 09               add  hl, bc
 283+ 5EE0 19               add  hl, de
 284+ 5EE1 7E               ld   a, (hl)               ; A = byte bitmap del portale
 285+ 5EE2
 286+ 5EE2 C1               pop  bc
 287+ 5EE3 D1               pop  de
 288+ 5EE4 E1               pop  hl
 289+ 5EE5 C9               ret
 290+ 5EE6
 291+ 5EE6              .not_portal_bg:
 292+ 5EE6                  ; 6. Ottieni il tipo di cella da unpacked_layout
 293+ 5EE6 7B               ld   a, e                  ; A = Row (0..15)
 294+ 5EE7                  ; C = Col (0..31)
 295+ 5EE7 CD CE 7A         call GetCellFromUnpacked   ; A = tile index (0..7)
 296+ 5EEA
 297+ 5EEA                  ; Controlla se è un Crumbling Floor (Tile 2)
 298+ 5EEA FE 02            cp   2
 299+ 5EEC 20 21            jr   nz, .not_crumbling_bg
 300+ 5EEE
 301+ 5EEE                  ; Calcola offset in crumbling_grid: Row * 32 + Col
 302+ 5EEE E5               push hl
 303+ 5EEF D5               push de
 304+ 5EF0 6B               ld   l, e
 305+ 5EF1 26 00            ld   h, 0
 306+ 5EF3 29               add  hl, hl
 306+ 5EF4 29             add hl, hl
 306+ 5EF5 29             add hl, hl
 306+ 5EF6 29             add hl, hl
 306+ 5EF7 29             add hl, hl
 307+ 5EF8 59               ld   e, c
 308+ 5EF9 16 00            ld   d, 0
 309+ 5EFB 19               add  hl, de
 310+ 5EFC 11 85 F0         ld   de, crumbling_grid
 311+ 5EFF 19               add  hl, de
 312+ 5F00 7E               ld   a, (hl)               ; A = crumbling stage (0..8)
 313+ 5F01 D1               pop  de
 314+ 5F02 E1               pop  hl
 315+ 5F03
 316+ 5F03                  ; Se stage > 0 e ScanlineOffset <= stage, la scanline è già sgretolata!
 317+ 5F03 B7               or   a
 318+ 5F04 28 07            jr   z, .crumble_intact
 319+ 5F06 B8               cp   b
 320+ 5F07 30 22            jr   nc, .blank            ; Se stage >= scanline_offset (1..8), linea cancellata!
 321+ 5F09
 322+ 5F09                  ; La linea richiesta corrisponde alla linea originale traslata (ScanlineOffset - stage)
 323+ 5F09 90               sub  b                     ; A = stage - B
 324+ 5F0A ED 44            neg                        ; A = B - stage
 325+ 5F0C 47               ld   b, a                  ; B = offset scanline originale nel tile (1..8)
 326+ 5F0D
 327+ 5F0D              .crumble_intact:
 328+ 5F0D 3E 02            ld   a, 2                  ; Tile 2
 329+ 5F0F
 330+ 5F0F              .not_crumbling_bg:
 331+ 5F0F                  ; 7. Calcola puntatore alla scanline del tile:
 332+ 5F0F                  ; HL = (room_ptr + OFFSET_TILES) + (A * 9) + ScanlineOffset (in B)
 333+ 5F0F 6F               ld   l, a
 334+ 5F10 26 00            ld   h, 0
 335+ 5F12 5F               ld   e, a
 336+ 5F13 16 00            ld   d, 0

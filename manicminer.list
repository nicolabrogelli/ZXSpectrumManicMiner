 979+ 77D4                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77D4 5F               ld   e, a              ; E = r (Row)
 981+ 77D5 79               ld   a, c
 982+ 77D6 CB 3F            srl  a
 983+ 77D8 CB 3F            srl  a
 984+ 77DA CB 3F            srl  a                 ; A = c (0..31)

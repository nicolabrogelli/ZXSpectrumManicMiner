 726  8BC1              ; CheckWillyConveyorCollision
 727  8BC1              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8BC1              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8BC1              ; -------------------------------------------------------------------
 730  8BC1              CheckWillyConveyorCollision:
 731  8BC1 C5               push bc
 732  8BC2 D5               push de
 733  8BC3 E5               push hl
 734  8BC4
 735  8BC4                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8BC4 CD 2A 78         call CheckWillyOnConveyor
 737  8BC7 38 49            jr   c, .collision_detected
 738  8BC9
 739  8BC9                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8BC9 3A DE ED         ld   a, (conveyor_len)
 741  8BCC B7               or   a
 742  8BCD 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8BCF
 744  8BCF                  ; B = WillyY, C = WillyX
 745  8BCF ED 4B B6 EA      ld   bc, (PlayerPos)
 746  8BD3
 747  8BD3                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8BD3 3A DF ED         ld   a, (conveyor_row)
 749  8BD6 87               add  a, a                  ; *2
 750  8BD7 87               add  a, a                  ; *4
 751  8BD8 87               add  a, a                  ; *8
 752  8BD9 5F               ld   e, a                  ; E = ConveyorTop
 753  8BDA C6 07            add  a, 7
 754  8BDC 57               ld   d, a                  ; D = ConveyorBottom
 755  8BDD
 756  8BDD                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8BDD 78               ld   a, b                  ; WillyTop
 758  8BDE BA               cp   d
 759  8BDF 28 04            jr   z, .y_overlap
 760  8BE1 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8BE3 18 32            jr   .no_conv_collision
 762  8BE5
 763  8BE5              .y_overlap:
 764  8BE5 C6 0F            add  a, 15                 ; WillyBottom
 765  8BE7 BB               cp   e
 766  8BE8 28 04            jr   z, .x_check
 767  8BEA 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8BEC 18 29            jr   .no_conv_collision
 769  8BEE
 770  8BEE              .x_check:
 771  8BEE                  ; ConveyorLeft = conveyor_col * 8
 772  8BEE 3A E0 ED         ld   a, (conveyor_col)
 773  8BF1 87               add  a, a                  ; *2
 774  8BF2 87               add  a, a                  ; *4
 775  8BF3 87               add  a, a                  ; *8
 776  8BF4 5F               ld   e, a                  ; E = ConveyorLeft
 777  8BF5
 778  8BF5                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 779  8BF5 21 DE ED         ld   hl, conveyor_len
 780  8BF8 3A E0 ED         ld   a, (conveyor_col)
 781  8BFB 86               add  a, (hl)
 782  8BFC 87               add  a, a                  ; *2
 783  8BFD 87               add  a, a                  ; *4
 784  8BFE 87               add  a, a                  ; *8
 785  8BFF 3D               dec  a                     ; ConveyorRight
 786  8C00 57               ld   d, a                  ; D = ConveyorRight
 787  8C01
 788  8C01                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 789  8C01 79               ld   a, c                  ; WillyLeft
 790  8C02 BA               cp   d
 791  8C03 28 04            jr   z, .x_overlap
 792  8C05 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8C07 18 0E            jr   .no_conv_collision
 794  8C09
 795  8C09              .x_overlap:
 796  8C09 C6 0F            add  a, 15                 ; WillyRight
 797  8C0B BB               cp   e
 798  8C0C 28 04            jr   z, .collision_detected
 799  8C0E 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 800  8C10 18 05            jr   .no_conv_collision
 801  8C12
 802  8C12              .collision_detected:

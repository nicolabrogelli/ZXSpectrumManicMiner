 315  899B CB 3F            srl  a
 316  899D CB 3F            srl  a
 317  899F CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  89A1 E6 07            and  7
 319  89A3 5F               ld   e, a
 320  89A4 16 00            ld   d, 0
 321  89A6 21 72 64         ld   hl, title_color_table
 322  89A9 19               add  hl, de
 323  89AA 7E               ld   a, (hl)               ; A = nuovo colore
 324  89AB 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  89AE 06 20            ld   b, 32
 326  89B0              .color_title_loop:
 327  89B0 77               ld   (hl), a
 328  89B1 23               inc  hl
 329  89B2 10 FC            djnz .color_title_loop
 330  89B4
 331  89B4                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  89B4 3E BF            ld   a, $bf
 333  89B6 DB FE            in   a, ($fe)
 334  89B8 1F               rra
 335  89B9 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  89BB
 337  89BB                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  89BB              .wait_title_enter_release_after:
 339  89BB 76               halt
 340  89BC 3E BF            ld   a, $bf
 341  89BE DB FE            in   a, ($fe)
 342  89C0 1F               rra
 343  89C1 30 F8            jr   nc, .wait_title_enter_release_after
 344  89C3
 345  89C3                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  89C3 AF               xor  a
 347  89C4 D3 FE            out  ($fe), a              ; Bordo a nero
 348  89C6 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  89C9
 350  89C9                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  89C9 CD 8A 8B         call ResetFullGameState
 352  89CC
 353  89CC                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  89CC C3 4C 88         jp   LoadRoomAndRestart
 355  89CF
 356  89CF              ; -------------------------------------------------------------------
 357  89CF              ; TriggerGameOver
 358  89CF              ; Scatena la sequenza originale di Game Over:
 359  89CF              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  89CF              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  89CF              ;   con suono beeper originale e lampeggio dello schermo.
 362  89CF              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  89CF              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  89CF              ; -------------------------------------------------------------------
 365  89CF              TriggerGameOver:
 366  89CF                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  89CF CD 36 87         call Score_CheckAndUpdateHighScore
 368  89D2
 369  89D2                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  89D2 CD 12 66         call Gfx_DrawGameOverScreen
 371  89D5
 372  89D5                  ; 3. Ritorna al Title Screen originale
 373  89D5 C3 8B 89         jp   ShowTitleScreen
 374  89D8
 375  89D8              ; -------------------------------------------------------------------
 376  89D8              ; TriggerVictory
 377  89D8              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  89D8              ; - Pulisce gli elementi di gioco della stanza.
 379  89D8              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  89D8              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  89D8              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  89D8              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  89D8              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  89D8              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  89D8              ; -------------------------------------------------------------------
 386  89D8              TriggerVictory:
 387  89D8                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  89D8 CD FD 66         call Gfx_DrawVictoryScreen
 389  89DB
 390  89DB                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  89DB              .wait_keys_release:
 392  89DB 76               halt
 393  89DC                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  89DC 01 FE DF         ld   bc, $dffe
 395  89DF ED 78            in   a, (c)
 396  89E1 CB 67            bit  4, a
 397  89E3 28 F6            jr   z, .wait_keys_release
 398  89E5
 399  89E5                  ; Controlla tasto N (Porta $7F, bit 3)
 400  89E5 01 FE 7F         ld   bc, $7ffe
 401  89E8 ED 78            in   a, (c)
 402  89EA CB 5F            bit  3, a
 403  89EC 28 ED            jr   z, .wait_keys_release
 404  89EE
 405  89EE                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  89EE 01 FE BF         ld   bc, $bffe
 407  89F1 ED 78            in   a, (c)
 408  89F3 CB 47            bit  0, a
 409  89F5 28 E4            jr   z, .wait_keys_release
 410  89F7
 411  89F7                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  89F7 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  89F9              .wait_choice_loop:
 414  89F9 76               halt
 415  89FA
 416  89FA                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  89FA 0C               inc  c
 418  89FB 79               ld   a, c
 419  89FC CB 3F            srl  a
 420  89FE CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8A00 E6 07            and  7
 422  8A02 5F               ld   e, a
 423  8A03 16 00            ld   d, 0
 424  8A05 21 F4 65         ld   hl, victory_color_table
 425  8A08 19               add  hl, de
 426  8A09 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8A0A 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8A0D 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8A0F              .color_cycle_loop:
 430  8A0F 77               ld   (hl), a
 431  8A10 23               inc  hl
 432  8A11 10 FC            djnz .color_cycle_loop
 433  8A13
 434  8A13                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8A13 01 FE DF         ld   bc, $dffe
 436  8A16 ED 78            in   a, (c)
 437  8A18 CB 67            bit  4, a
 438  8A1A 28 2A            jr   z, .play_again_chosen
 439  8A1C
 440  8A1C                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8A1C 01 FE 7F         ld   bc, $7ffe
 442  8A1F ED 78            in   a, (c)
 443  8A21 CB 5F            bit  3, a
 444  8A23 28 0B            jr   z, .quit_chosen
 445  8A25
 446  8A25                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8A25 01 FE BF         ld   bc, $bffe
 448  8A28 ED 78            in   a, (c)
 449  8A2A CB 47            bit  0, a
 450  8A2C 28 02            jr   z, .quit_chosen
 451  8A2E
 452  8A2E 18 C9            jr   .wait_choice_loop
 453  8A30
 454  8A30              .quit_chosen:
 455  8A30                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8A30              .wait_quit_release:
 457  8A30 76               halt
 458  8A31 01 FE 7F         ld   bc, $7ffe
 459  8A34 ED 78            in   a, (c)
 460  8A36 CB 5F            bit  3, a
 461  8A38 28 F6            jr   z, .wait_quit_release
 462  8A3A 01 FE BF         ld   bc, $bffe
 463  8A3D ED 78            in   a, (c)
 464  8A3F CB 47            bit  0, a
 465  8A41 28 ED            jr   z, .wait_quit_release
 466  8A43
 467  8A43                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8A43 C3 8B 89         jp   ShowTitleScreen
 469  8A46
 470  8A46              .play_again_chosen:
 471  8A46                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8A46              .wait_play_again_release:
 473  8A46 76               halt
 474  8A47 01 FE DF         ld   bc, $dffe
 475  8A4A ED 78            in   a, (c)
 476  8A4C CB 67            bit  4, a
 477  8A4E 28 F6            jr   z, .wait_play_again_release
 478  8A50
 479  8A50                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8A50 CD 8A 8B         call ResetFullGameState
 481  8A53 C3 4C 88         jp   LoadRoomAndRestart
 482  8A56
 483  8A56              ; -------------------------------------------------------------------
 484  8A56              ; CheckPortalTransition
 485  8A56              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8A56              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8A56              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8A56              ;
 489  8A56              ; Output:
 490  8A56              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8A56              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8A56              ; -------------------------------------------------------------------
 493  8A56              CheckPortalTransition:
 494  8A56 C5               push bc
 495  8A57 D5               push de
 496  8A58 E5               push hl
 497  8A59
 498  8A59                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8A59 CD 1D 8B         call CheckAllItemsCollected
 500  8A5C 30 4D            jr   nc, .no_transition
 501  8A5E
 502  8A5E                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8A5E                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8A5E                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8A5E 2A A5 ED         ld   hl, (room_ptr)
 506  8A61 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8A64 19               add  hl, de
 508  8A65 4E               ld   c, (hl)
 509  8A66 23               inc  hl
 510  8A67 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8A68
 512  8A68                  ; Offset = BC - 23552
 513  8A68 60               ld   h, b
 514  8A69 69               ld   l, c
 515  8A6A 01 00 A4         ld   bc, -23552
 516  8A6D 09               add  hl, bc
 517  8A6E
 518  8A6E                  ; PortalX = (Offset & 31) * 8
 519  8A6E 7D               ld   a, l
 520  8A6F E6 1F            and  31
 521  8A71 87               add  a, a
 521  8A72 87             add a, a
 521  8A73 87             add a, a
 522  8A74 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8A75
 524  8A75                  ; PortalY = (Offset / 32) * 8
 525  8A75 CB 3C            srl  h
 525  8A77 CB 1D          rr l
 526  8A79 CB 3C            srl  h
 526  8A7B CB 1D          rr l
 527  8A7D CB 3C            srl  h
 527  8A7F CB 1D          rr l
 528  8A81 CB 3C            srl  h
 528  8A83 CB 1D          rr l
 529  8A85 CB 3C            srl  h
 529  8A87 CB 1D          rr l
 530  8A89 7D               ld   a, l
 531  8A8A 87               add  a, a
 531  8A8B 87             add a, a
 531  8A8C 87             add a, a
 532  8A8D 57               ld   d, a                      ; D = PortalY (0..120)
 533  8A8E
 534  8A8E                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8A8E ED 4B 24 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8A92
 537  8A92                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8A92 7B               ld   a, e
 539  8A93 91               sub  c
 540  8A94 30 02            jr   nc, .x_diff_pos
 541  8A96 ED 44            neg
 542  8A98              .x_diff_pos:
 543  8A98 FE 0C            cp   12
 544  8A9A 30 0F            jr   nc, .no_transition
 545  8A9C
 546  8A9C                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8A9C 7A               ld   a, d
 548  8A9D 90               sub  b
 549  8A9E 30 02            jr   nc, .y_diff_pos
 550  8AA0 ED 44            neg
 551  8AA2              .y_diff_pos:
 552  8AA2 FE 0E            cp   14
 553  8AA4 30 05            jr   nc, .no_transition
 554  8AA6
 555  8AA6                  ; Transizione al portale attiva!
 556  8AA6 E1               pop  hl
 557  8AA7 D1               pop  de
 558  8AA8 C1               pop  bc
 559  8AA9 37               scf
 560  8AAA C9               ret
 561  8AAB
 562  8AAB              .no_transition:
 563  8AAB E1               pop  hl
 564  8AAC D1               pop  de
 565  8AAD C1               pop  bc
 566  8AAE B7               or   a
 567  8AAF C9               ret
 568  8AB0
 569  8AB0              ; Alias per retrocompatibilità
 570  8AB0              CheckVictoryCondition: EQU CheckPortalTransition
 571  8AB0
 572  8AB0              ; -------------------------------------------------------------------
 573  8AB0              ; TriggerPortalTransition
 574  8AB0              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8AB0              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8AB0              ; - Avanza all'indice della stanza successiva.
 577  8AB0              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8AB0              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8AB0              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8AB0              ; -------------------------------------------------------------------
 581  8AB0              TriggerPortalTransition:
 582  8AB0                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8AB0 CD E7 8A         call Air_DepleteCountdown
 584  8AB3
 585  8AB3                  ; 1. Determina l'ID della stanza corrente
 586  8AB3 CD 77 84         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8AB6
 588  8AB6                  ; 2. Calcola l'indice della stanza successiva
 589  8AB6 3A 4A ED         ld   a, (current_room)
 590  8AB9 3C               inc  a
 591  8ABA FE 14            cp   NUM_ROOMS
 592  8ABC 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8ABE
 594  8ABE                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8ABE 21 8E 73         ld   hl, RoomsListTable
 596  8AC1 5F               ld   e, a
 597  8AC2 16 00            ld   d, 0
 598  8AC4 19               add  hl, de
 599  8AC5 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8AC6 5E               ld   e, (hl)
 601  8AC7 23               inc  hl
 602  8AC8 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8AC9 ED 53 A5 ED      ld   (room_ptr), de
 604  8ACD
 605  8ACD                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8ACD AF               xor  a
 607  8ACE 32 AB ED         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8AD1 32 32 EA         ld   (velocity_y), a
 609  8AD4 32 3D F0         ld   (game_objective_completed), a
 610  8AD7 3E 01            ld   a, 1
 611  8AD9 32 33 EA         ld   (on_ground), a
 612  8ADC
 613  8ADC                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8ADC 3E 07            ld   a, $07
 615  8ADE CD 9D 62         call Gfx_ClearScreenDirect
 616  8AE1
 617  8AE1 C3 4C 88         jp   LoadRoomAndRestart
 618  8AE4
 619  8AE4              .all_rooms_completed:
 620  8AE4                  ; Tutte le stanze sono state completate con successo!
 621  8AE4                  IF ENABLE_VICTORY_SCREEN != 0
 622  8AE4 C3 D8 89         jp   TriggerVictory
 623  8AE7                  ELSE
 624  8AE7 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8AE7 ~                ld   de, (RoomsListTable)
 626  8AE7 ~                ld   (room_ptr), de
 627  8AE7 ~                xor  a
 628  8AE7 ~                ld   (transition_active), a
 629  8AE7 ~                ld   (velocity_y), a
 630  8AE7 ~                ld   (game_objective_completed), a
 631  8AE7 ~                ld   a, 1
 632  8AE7 ~                ld   (on_ground), a
 633  8AE7 ~                ld   a, $07
 634  8AE7 ~                call Gfx_ClearScreenDirect
 635  8AE7 ~                jp   LoadRoomAndRestart
 636  8AE7                  ENDIF
 637  8AE7
 638  8AE7              ; -------------------------------------------------------------------
 639  8AE7              ; Air_DepleteCountdown
 640  8AE7              ; Animazione originale di completamento livello (Manic Miner):
 641  8AE7              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8AE7              ; - Ad ogni pixel decrementato:
 643  8AE7              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8AE7              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8AE7              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8AE7              ; -------------------------------------------------------------------
 647  8AE7              Air_DepleteCountdown:
 648  8AE7 F5               push af
 649  8AE8 C5               push bc
 650  8AE9 D5               push de
 651  8AEA E5               push hl
 652  8AEB
 653  8AEB              .countdown_loop:
 654  8AEB 3A 46 F0         ld   a, (air_pixels)
 655  8AEE B7               or   a
 656  8AEF 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8AF1
 658  8AF1 3D               dec  a
 659  8AF2 32 46 F0         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8AF5
 661  8AF5                  ; Aggiorna la barra grafica dell'aria
 662  8AF5 CD 2D 6A         call Gfx_UpdateAirBar
 663  8AF8
 664  8AF8                  ; Aggiungi 1 punto allo score
 665  8AF8 CD EB 86         call Score_Add1Point
 666  8AFB
 667  8AFB                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8AFB                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8AFB 3A 46 F0         ld   a, (air_pixels)
 670  8AFE 2F               cpl
 671  8AFF E6 3F            and  63
 672  8B01 07               rlca
 673  8B02 3C               inc  a
 674  8B03 57               ld   d, a                      ; D = ritardo semionda audio
 675  8B04
 676  8B04 0E 03            ld   c, 3                      ; Durata impulso
 677  8B06              .audio_loop:
 678  8B06 AF               xor  a
 679  8B07 D3 FE            out  ($fe), a
 680  8B09 42               ld   b, d
 681  8B0A 10 FE        .w1: djnz .w1
 682  8B0C
 683  8B0C 3E 18            ld   a, $18
 684  8B0E D3 FE            out  ($fe), a
 685  8B10 42               ld   b, d
 686  8B11 10 FE        .w2: djnz .w2
 687  8B13
 688  8B13 0D               dec  c
 689  8B14 20 F0            jr   nz, .audio_loop
 690  8B16
 691  8B16 18 D3            jr   .countdown_loop
 692  8B18
 693  8B18              .done_countdown:
 694  8B18 E1               pop  hl
 695  8B19 D1               pop  de
 696  8B1A C1               pop  bc
 697  8B1B F1               pop  af
 698  8B1C C9               ret
 699  8B1D
 700  8B1D              ; -------------------------------------------------------------------
 701  8B1D              ; CheckAllItemsCollected
 702  8B1D              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8B1D              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8B1D              ; -------------------------------------------------------------------
 705  8B1D              CheckAllItemsCollected:
 706  8B1D 3A 3D F0         ld   a, (game_objective_completed)
 707  8B20 B7               or   a
 708  8B21 20 08            jr   nz, .all_collected
 709  8B23 3A A4 ED         ld   a, (num_room_items)
 710  8B26 B7               or   a
 711  8B27 28 02            jr   z, .all_collected
 712  8B29 B7               or   a
 713  8B2A C9               ret
 714  8B2B              .all_collected:
 715  8B2B 37               scf
 716  8B2C C9               ret
 717  8B2D
 718  8B2D              ; -------------------------------------------------------------------
 719  8B2D              ; CheckInMasterBedroom (alias per retrocompatibilità)
 720  8B2D              ; -------------------------------------------------------------------
 721  8B2D              CheckInMasterBedroom:
 722  8B2D 37               scf
 723  8B2E C9               ret
 724  8B2F
 725  8B2F              ; -------------------------------------------------------------------
 726  8B2F              ; CheckWillyConveyorCollision
 727  8B2F              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8B2F              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8B2F              ; -------------------------------------------------------------------
 730  8B2F              CheckWillyConveyorCollision:
 731  8B2F C5               push bc
 732  8B30 D5               push de
 733  8B31 E5               push hl
 734  8B32
 735  8B32                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8B32 CD 99 77         call CheckWillyOnConveyor
 737  8B35 38 49            jr   c, .collision_detected
 738  8B37
 739  8B37                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8B37 3A 4C ED         ld   a, (conveyor_len)
 741  8B3A B7               or   a
 742  8B3B 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8B3D
 744  8B3D                  ; B = WillyY, C = WillyX
 745  8B3D ED 4B 24 EA      ld   bc, (PlayerPos)
 746  8B41
 747  8B41                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8B41 3A 4D ED         ld   a, (conveyor_row)
 749  8B44 87               add  a, a                  ; *2
 750  8B45 87               add  a, a                  ; *4
 751  8B46 87               add  a, a                  ; *8
 752  8B47 5F               ld   e, a                  ; E = ConveyorTop
 753  8B48 C6 07            add  a, 7

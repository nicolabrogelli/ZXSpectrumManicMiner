 698+ 60A7 CB 3F            srl  a
 698+ 60A9 CB 3F          srl a
 698+ 60AB CB 3F          srl a
 699+ 60AD 4F               ld   c, a                  ; C = ColEnd (0..31)
 700+ 60AE
 701+ 60AE                  ; Calcola RowStart (H) e RowEnd (L)
 702+ 60AE 78               ld   a, b
 703+ 60AF CB 3F            srl  a
 703+ 60B1 CB 3F          srl a
 703+ 60B3 CB 3F          srl a
 704+ 60B5 67               ld   h, a                  ; H = RowStart (0..15)
 705+ 60B6
 706+ 60B6 78               ld   a, b
 707+ 60B7 C6 0F            add  a, 15
 708+ 60B9 CB 3F            srl  a
 708+ 60BB CB 3F          srl a
 708+ 60BD CB 3F          srl a
 709+ 60BF 6F               ld   l, a                  ; L = RowEnd (0..15)
 710+ 60C0
 711+ 60C0              .row_loop:

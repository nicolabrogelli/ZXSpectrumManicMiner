   2+ 7D3C              ; items.asm
   3+ 7D3C              ;
   4+ 7D3C              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 7D3C              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 7D3C              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 7D3C              ;===========================================================================
   8+ 7D3C
   9+ 7D3C              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 7D3C
  11+ 7D3C              ; -------------------------------------------------------------------
  12+ 7D3C              ; DetermineCurrentRoomID
  13+ 7D3C              ;
  14+ 7D3C              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7D3C              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7D3C              ;
  17+ 7D3C              ; Output:
  18+ 7D3C              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7D3C              ;   (current_room) = A
  20+ 7D3C              ; -------------------------------------------------------------------
  21+ 7D3C              DetermineCurrentRoomID:
  22+ 7D3C E5               push hl
  23+ 7D3D D5               push de
  24+ 7D3E C5               push bc
  25+ 7D3F
  26+ 7D3F 21 62 70         ld   hl, RoomsListTable
  27+ 7D42 ED 5B 14 92      ld   de, (room_ptr)
  28+ 7D46 06 01            ld   b, NUM_ROOMS
  29+ 7D48 0E 00            ld   c, 0
  30+ 7D4A
  31+ 7D4A              .loop:
  32+ 7D4A 7E               ld   a, (hl)
  33+ 7D4B BB               cp   e
  34+ 7D4C 20 06            jr   nz, .no_match
  35+ 7D4E 23               inc  hl
  36+ 7D4F 7E               ld   a, (hl)
  37+ 7D50 BA               cp   d
  38+ 7D51 28 08            jr   z, .found
  39+ 7D53 2B               dec  hl
  40+ 7D54
  41+ 7D54              .no_match:
  42+ 7D54 23               inc  hl
  43+ 7D55 23               inc  hl
  44+ 7D56 0C               inc  c
  45+ 7D57 10 F1            djnz .loop
  46+ 7D59
  47+ 7D59 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7D5B
  49+ 7D5B              .found:
  50+ 7D5B 79               ld   a, c
  51+ 7D5C 32 BA 91         ld   (current_room), a
  52+ 7D5F
  53+ 7D5F C1               pop  bc
  54+ 7D60 D1               pop  de
  55+ 7D61 E1               pop  hl
  56+ 7D62 C9               ret
  57+ 7D63
  58+ 7D63              ; -------------------------------------------------------------------
  59+ 7D63              ; ResetItemsTable
  60+ 7D63              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7D63              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7D63              ; -------------------------------------------------------------------
  63+ 7D63              ResetItemsTable:
  64+ 7D63 E5               push hl
  65+ 7D64 D5               push de
  66+ 7D65 C5               push bc
  67+ 7D66
  68+ 7D66 21 62 70         ld   hl, RoomsListTable
  69+ 7D69 06 01            ld   b, NUM_ROOMS
  70+ 7D6B
  71+ 7D6B              .room_loop:
  72+ 7D6B C5               push bc
  73+ 7D6C 5E               ld   e, (hl)
  74+ 7D6D 23               inc  hl
  75+ 7D6E 56               ld   d, (hl)
  76+ 7D6F 23               inc  hl
  77+ 7D70 E5               push hl
  78+ 7D71
  79+ 7D71                  ; DE = room_ptr
  80+ 7D71 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7D74 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7D75
  83+ 7D75              .item_loop:
  84+ 7D75 7E               ld   a, (hl)
  85+ 7D76 FE FF            cp   $FF
  86+ 7D78 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 7D7A 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 7D7B 23               inc  hl                        ; +2 (Attr Address High)
  89+ 7D7C 23               inc  hl                        ; +3 (Anim mask)
  90+ 7D7D 23               inc  hl                        ; +4 (Collected flag)
  91+ 7D7E 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 7D80 23               inc  hl                        ; Avanza al prossimo item
  93+ 7D81 18 F2            jr   .item_loop
  94+ 7D83
  95+ 7D83              .next_room:
  96+ 7D83 E1               pop  hl
  97+ 7D84 C1               pop  bc
  98+ 7D85 10 E4            djnz .room_loop
  99+ 7D87
 100+ 7D87 C1               pop  bc
 101+ 7D88 D1               pop  de
 102+ 7D89 E1               pop  hl
 103+ 7D8A C9               ret

 801+ 8922 E1               pop  hl
 802+ 8923
 803+ 8923                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 8923 11 00 58         ld   de, COLOR_DATA
 805+ 8926 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 8927 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo

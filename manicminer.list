 339+ 7D89 29               add  hl, hl                    ; *2
 340+ 7D8A 29               add  hl, hl                    ; *4
 341+ 7D8B 29               add  hl, hl                    ; *8
 342+ 7D8C 19               add  hl, de                    ; *9
 343+ 7D8D 11 20 02         ld   de, OFFSET_TILES
 344+ 7D90 19               add  hl, de

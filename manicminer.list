 917  8340 22 FC 91         ld   (time_last_counter), hl
 918  8343 CD B4 67         call Gfx_UpdateTimeDisplay
 919  8346
 920  8346                  ; Ripristina la stanza iniziale (Central Cavern)
 921  8346 21 AC 83         ld   hl, CentralCavernLayout

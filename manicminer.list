  71+ 7CFD              .room_loop:
  72+ 7CFD C5               push bc
  73+ 7CFE 5E               ld   e, (hl)
  74+ 7CFF 23               inc  hl
  75+ 7D00 56               ld   d, (hl)
  76+ 7D01 23               inc  hl
  77+ 7D02 E5               push hl
  78+ 7D03
  79+ 7D03                  ; DE = room_ptr
  80+ 7D03 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7D06 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7D07

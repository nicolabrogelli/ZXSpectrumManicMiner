 399  8512
 400  8512                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 401  8512 0C               inc  c
 402  8513 79               ld   a, c
 403  8514 CB 3F            srl  a
 404  8516 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 405  8518 E6 07            and  7
 406  851A 5F               ld   e, a
 407  851B 16 00            ld   d, 0
 408  851D 21 7F 65         ld   hl, game_over_color_table
 409  8520 19               add  hl, de
 410  8521 7E               ld   a, (hl)               ; A = nuovo colore attributo
 411  8522 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 412  8525 06 09            ld   b, 9

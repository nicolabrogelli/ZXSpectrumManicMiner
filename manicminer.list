1242+ 79BE 28 1C            jr   z, .is_floor
1243+ 79C0 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1244+ 79C3 28 1B            jr   z, .is_crumbling
1245+ 79C5 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1246+ 79C8 28 1E            jr   z, .is_conveyor
1247+ 79CA DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1248+ 79CD 28 1D            jr   z, .is_nasty1

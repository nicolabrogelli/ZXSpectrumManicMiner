 634  864E C3 A1 84         jp   ShowTitleScreen
 635  8651
 636  8651              .play_again_chosen:
 637  8651                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 638  8651              .wait_play_again_release:
 639  8651 76               halt
 640  8652 01 FE DF         ld   bc, $dffe
 641  8655 ED 78            in   a, (c)
 642  8657 CB 67            bit  4, a
 643  8659 28 F6            jr   z, .wait_play_again_release

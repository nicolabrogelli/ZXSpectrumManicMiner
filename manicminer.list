# file opened: macro.asm
   1+ 5DAD              ; Macro per inserire un oggetto calcolando l'ID della stanza a tempo di compilazione dall'offset in RoomsListTable
   2+ 5DAD                  MACRO ITEM room_sublabel, x, y, color, state
   3+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2, x, y, color, state
   4+ 5DAD                  ENDM
   5+ 5DAD
   6+ 5DAD
   7+ 5DAD                  MACRO ROOM room_sublabel
   8+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2
   9+ 5DAD                  ENDM
# file closed: macro.asm
  15  5DAD                  include "interrupts.asm"
# file opened: interrupts.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; interrupts.asm
   3+ 5DAD              ;===========================================================================
   4+ 5DAD
   5+ 5DAD              ; -------------------------------------------------------------------
   6+ 5DAD              ; Setup interrupt IM2
   7+ 5DAD              ; -------------------------------------------------------------------
   8+ 5DAD              SetupIM2:
   9+ 5DAD F3               di
  10+ 5DAE 11 00 FE         ld de,IM2_TABLE
  11+ 5DB1 21 FD FD         ld hl,IM2_VECTOR
  12+ 5DB4 7A               ld a,d
  13+ 5DB5 ED 47            ld i,a
  14+ 5DB7 7D               ld a,l
  15+ 5DB8              .fill_loop:
  16+ 5DB8 12               ld (de),a
  17+ 5DB9 1C               inc e
  18+ 5DBA C2 B8 5D         jp nz,.fill_loop
  19+ 5DBD 14               inc d
  20+ 5DBE 12               ld (de),a
  21+ 5DBF 36 C3            ld (hl),$C3
  22+ 5DC1 2C               inc l
  23+ 5DC2 36 CB            ld (hl),low im2_handler
  24+ 5DC4 2C               inc l
  25+ 5DC5 36 5D            ld (hl),high im2_handler
  26+ 5DC7 ED 5E            im 2
  27+ 5DC9 FB               ei
  28+ 5DCA C9               ret
  29+ 5DCB
  30+ 5DCB              ; -------------------------------------------------------------------
  31+ 5DCB              ; Handler interrupt IM2
  32+ 5DCB              ; -------------------------------------------------------------------
  33+ 5DCB              im2_handler:
  34+ 5DCB F5               push af
  35+ 5DCC E5               push hl
  36+ 5DCD
  37+ 5DCD                  ; Reset interrupt ULA
  38+ 5DCD DB FE            in a, (0xFE)
  39+ 5DCF
  40+ 5DCF                  ; Incrementa il contatore (usato per animazioni/raster bars)
  41+ 5DCF 2A 0D 8E         ld hl, (counter)
  42+ 5DD2 23               inc hl
  43+ 5DD3 22 0D 8E         ld (counter), hl
  44+ 5DD6
  45+ 5DD6                  ; Ripristina registri
  46+ 5DD6 E1               pop hl
  47+ 5DD7 F1               pop af
  48+ 5DD8 FB               ei
  49+ 5DD9 ED 4D            reti
# file closed: interrupts.asm

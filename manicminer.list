2089+ 7DB1              ; Phys_UpdateAir
2090+ 7DB1              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2091+ 7DB1              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2092+ 7DB1              ; Output:
2093+ 7DB1              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2094+ 7DB1              ;   Carry Clear = Aria ancora disponibile
2095+ 7DB1              ; -------------------------------------------------------------------
2096+ 7DB1              Phys_UpdateAir:
2097+ 7DB1                  ; Incrementa il timer dei frame
2098+ 7DB1 3A 4F F1         ld   a, (air_timer)
2099+ 7DB4 3C               inc  a
2100+ 7DB5 32 4F F1         ld   (air_timer), a
2101+ 7DB8 21 50 F1         ld   hl, air_deplete_rate
2102+ 7DBB BE               cp   (hl)
2103+ 7DBC 38 14            jr   c, .no_deplete
2104+ 7DBE
2105+ 7DBE                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2106+ 7DBE AF               xor  a
2107+ 7DBF 32 4F F1         ld   (air_timer), a
2108+ 7DC2
2109+ 7DC2 3A 4E F1         ld   a, (air_pixels)
2110+ 7DC5 B7               or   a
2111+ 7DC6 28 0C            jr   z, .air_finished
2112+ 7DC8
2113+ 7DC8 3D               dec  a
2114+ 7DC9 32 4E F1         ld   (air_pixels), a
2115+ 7DCC CD 2D 6A         call Gfx_UpdateAirBar
2116+ 7DCF
2117+ 7DCF B7               or   a
2118+ 7DD0 28 02            jr   z, .air_finished
2119+ 7DD2
2120+ 7DD2              .no_deplete:
2121+ 7DD2 B7               or   a                     ; Carry Clear = Ok
2122+ 7DD3 C9               ret
2123+ 7DD4
2124+ 7DD4              .air_finished:
2125+ 7DD4 37               scf                        ; Carry Set = Morte per esaurimento aria
2126+ 7DD5 C9               ret

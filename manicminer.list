 684+ 83C1 38 0C            jr   c, .new_high_score
 685+ 83C3 20 1C            jr   nz, .done_check
 686+ 83C5
 687+ 83C5                  ; Byte 0:
 688+ 83C5 3A FA E4         ld   a, (player_score + 0)
 689+ 83C8 47               ld   b, a
 690+ 83C9 3A FD E4         ld   a, (high_score + 0)
 691+ 83CC B8               cp   b
 692+ 83CD 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

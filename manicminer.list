 906+ 77B9
 907+ 77B9 7B               ld   a, e              ; A = Col
 908+ 77BA B8               cp   b
 909+ 77BB 38 34            jr   c, .check_platform_case ; Col < ramp_col
 910+ 77BD B9               cp   c
 911+ 77BE 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 912+ 77C0
 913+ 77C0                  ; Calcola B = Col - ramp_col
 914+ 77C0 7B               ld   a, e
 915+ 77C1 90               sub  b
 916+ 77C2 47               ld   b, a              ; B = offset (0..ramp_len-1)
 917+ 77C3

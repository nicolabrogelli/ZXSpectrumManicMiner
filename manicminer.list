  86+ F1B5 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  87+ F1B6 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  88+ F1B7
  89+ F1B7              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  90+ F1B7 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  91+ F1BA 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  92+ F1BD 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  93+ F1BE 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  94+ F1BF 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  95+ F1C0 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  96+ F1C1 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  97+ F1C2 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  98+ F1C3 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  99+ F1C4
 100+ F1C4 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 101+ F1C5 00           Audio_jump_sound_timer:   db 0
 102+ F1C6                  IF ENABLE_MUSIC != 0
 103+ F1C6 ~            Audio_music_note_idx:      db 0
 104+ F1C6 ~            Audio_music_frame_counter: db 1
 105+ F1C6                  ENDIF
 106+ F1C6
 107+ F1C6              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 108+ F1C6 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 109+ F1C7 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 110+ F1C8 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 111+ F1C9
 112+ F1C9              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 113+ F1C9 00 00        willy_head_ptr:         dw 0
 114+ F1CB 00 00        willy_body_ptr:         dw 0
 115+ F1CD 00 00        guard_sprite_ptr:       dw 0
 116+ F1CF 00           collision_delta_x:      db 0
 117+ F1D0 00           collision_delta_y:      db 0
 118+ F1D1 00           row_enemy_cur:          db 0
 119+ F1D2 00           row_willy_cur:          db 0
 120+ F1D3 00           overlap_num_lines:      db 0
 121+ F1D4
 122+ F1D4              ; Interrupt
 123+ F1D4              IM2_TABLE   = $FE00
 124+ F1D4              IM2_VECTOR  = $FDFD
 125+ F1D4              SCREEN_LINE = $4860
 126+ F1D4              SCREEN_MEMORY = $4000
 127+ F1D4              COLOR_DATA = $5800
 128+ F1D4              STACK_POINTER = $fdf0

 342  88D2 AF               xor  a
 343  88D3 D3 FE            out  ($fe), a              ; Bordo a nero
 344  88D5 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 345  88D8

 192+ 8320 D3 FE            out  ($fe), a
 193+ 8322
 194+ 8322 0E 3C            ld   c, 60
 195+ 8324              .d1:
 196+ 8324 0D               dec  c
 197+ 8325 20 FD            jr   nz, .d1
 198+ 8327
 199+ 8327 3A 10 9E         ld   a, (room_border_color)
 200+ 832A E6 EF            and  $ef              ; speaker OFF
 201+ 832C D3 FE            out  ($fe), a
 202+ 832E
 203+ 832E 0E 3C            ld   c, 60
 204+ 8330              .d2:
 205+ 8330 0D               dec  c
 206+ 8331 20 FD            jr   nz, .d2
 207+ 8333
 208+ 8333 10 E6            djnz .sound_loop
 209+ 8335
 210+ 8335 D1               pop  de
 211+ 8336 C1               pop  bc
 212+ 8337 C9               ret

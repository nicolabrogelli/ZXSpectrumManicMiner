 905  8B38              ; per l'avvio di una nuova partita dopo il Game Over.
 906  8B38              ; -------------------------------------------------------------------
 907  8B38              ResetFullGameState:
 908  8B38                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 909  8B38 AF               xor  a
 910  8B39 D3 FE            out  ($fe), a              ; Bordo a nero
 911  8B3B CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 912  8B3E
 913  8B3E                  ; Ripristina il numero di vite iniziali

 414+ 829E              ; CheckWillyItemCollision
 415+ 829E              ;
 416+ 829E              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 829E              ; Input:
 418+ 829E              ;   A = Item Col (0..31)
 419+ 829E              ;   H = Item Row (0..15)
 420+ 829E              ; Output:
 421+ 829E              ;   Carry Set = Collisione
 422+ 829E              ;   Carry Clear = Nessuna collisione
 423+ 829E              ; -------------------------------------------------------------------
 424+ 829E              CheckWillyItemCollision:
 425+ 829E C5               push bc
 426+ 829F D5               push de
 427+ 82A0 E5               push hl
 428+ 82A1
 429+ 82A1                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

  72+ 7FCC ~            ; Audio_UpdateMusic
  73+ 7FCC ~            ;
  74+ 7FCC ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7FCC ~            ; Viene chiamata a ogni frame.
  76+ 7FCC ~            ; -------------------------------------------------------------------
  77+ 7FCC ~            Audio_UpdateMusic:
  78+ 7FCC ~                push af
  79+ 7FCC ~                push bc
  80+ 7FCC ~                push de
  81+ 7FCC ~                push hl
  82+ 7FCC ~
  83+ 7FCC ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7FCC ~                ld   a, (Audio_jump_sound_note)
  85+ 7FCC ~                cp   18
  86+ 7FCC ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7FCC ~
  88+ 7FCC ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7FCC ~                ld   a, (Audio_music_frame_counter)
  90+ 7FCC ~                dec  a
  91+ 7FCC ~                ld   (Audio_music_frame_counter), a
  92+ 7FCC ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7FCC ~
  94+ 7FCC ~                ; Altrimenti carica la nota successiva
  95+ 7FCC ~                ld   a, (Audio_music_note_idx)
  96+ 7FCC ~                inc  a
  97+ 7FCC ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7FCC ~                jr   c, .no_wrap
  99+ 7FCC ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7FCC ~            .no_wrap:
 101+ 7FCC ~                ld   (Audio_music_note_idx), a
 102+ 7FCC ~
 103+ 7FCC ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7FCC ~                ld   e, a
 105+ 7FCC ~                ld   d, 0
 106+ 7FCC ~                ld   hl, Audio_MusicSheet
 107+ 7FCC ~                add  hl, de
 108+ 7FCC ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7FCC ~
 110+ 7FCC ~                ; Leggi durata (secondo byte)
 111+ 7FCC ~                inc  hl
 112+ 7FCC ~                ld   a, (hl)
 113+ 7FCC ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7FCC ~                jr   nz, .dur_ok
 115+ 7FCC ~                ld   a, 1
 116+ 7FCC ~            .dur_ok:
 117+ 7FCC ~                ld   (Audio_music_frame_counter), a
 118+ 7FCC ~
 119+ 7FCC ~            .play_current_note:
 120+ 7FCC ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7FCC ~                ld   a, (Audio_music_note_idx)
 122+ 7FCC ~                ld   e, a
 123+ 7FCC ~                ld   d, 0
 124+ 7FCC ~                ld   hl, Audio_MusicSheet
 125+ 7FCC ~                add  hl, de
 126+ 7FCC ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7FCC ~                ld   a, (hl)                  ; A = delay
 128+ 7FCC ~                or   a
 129+ 7FCC ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7FCC ~
 131+ 7FCC ~                ; Suona la nota: 2 cicli
 132+ 7FCC ~                ld   d, a                     ; D = delay
 133+ 7FCC ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7FCC ~            .note_loop:
 135+ 7FCC ~                ; Speaker ON
 136+ 7FCC ~                ld   a, (room_border_color)
 137+ 7FCC ~                or   $10
 138+ 7FCC ~                out  ($fe), a
 139+ 7FCC ~                ld   c, d
 140+ 7FCC ~            .d1:
 141+ 7FCC ~                push af
 142+ 7FCC ~                pop  af
 143+ 7FCC ~                dec  c
 144+ 7FCC ~                jr   nz, .d1
 145+ 7FCC ~
 146+ 7FCC ~                ; Speaker OFF
 147+ 7FCC ~                ld   a, (room_border_color)
 148+ 7FCC ~                and  $ef
 149+ 7FCC ~                out  ($fe), a
 150+ 7FCC ~                ld   c, d
 151+ 7FCC ~            .d2:
 152+ 7FCC ~                push af
 153+ 7FCC ~                pop  af
 154+ 7FCC ~                dec  c
 155+ 7FCC ~                jr   nz, .d2
 156+ 7FCC ~
 157+ 7FCC ~                djnz .note_loop
 158+ 7FCC ~
 159+ 7FCC ~            .done:
 160+ 7FCC ~                pop  hl
 161+ 7FCC ~                pop  de
 162+ 7FCC ~                pop  bc
 163+ 7FCC ~                pop  af
 164+ 7FCC ~                ret
 165+ 7FCC ~
 166+ 7FCC ~            Audio_MusicSheet:
 167+ 7FCC ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7FCC ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7FCC ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7FCC ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7FCC ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7FCC ~                db 90, 10, 107, 20, 68, 65
 173+ 7FCC                  ELSE
 174+ 7FCC              Audio_UpdateMusic:
 175+ 7FCC C9               ret
 176+ 7FCD                  ENDIF

 362+ 7D90              ; CheckWillyItemCollision
 363+ 7D90              ;
 364+ 7D90              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 365+ 7D90              ; Input:
 366+ 7D90              ;   A = Item Col (0..31)
 367+ 7D90              ;   H = Item Row (0..15)
 368+ 7D90              ; Output:
 369+ 7D90              ;   Carry Set = Collisione
 370+ 7D90              ;   Carry Clear = Nessuna collisione
 371+ 7D90              ; -------------------------------------------------------------------
 372+ 7D90              CheckWillyItemCollision:
 373+ 7D90 C5               push bc
 374+ 7D91 D5               push de
 375+ 7D92 E5               push hl
 376+ 7D93
 377+ 7D93                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

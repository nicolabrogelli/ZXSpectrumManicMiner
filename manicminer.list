 315+ 7EAD              ; -------------------------------------------------------------------
 316+ 7EAD              ; Enemy_DrawSingleSlot
 317+ 7EAD              ;
 318+ 7EAD              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7EAD              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7EAD              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7EAD              ; -------------------------------------------------------------------
 322+ 7EAD              Enemy_DrawSingleSlot:
 323+ 7EAD C5               push bc
 324+ 7EAE D5               push de
 325+ 7EAF E5               push hl
 326+ 7EB0 DD E5            push ix
 327+ 7EB2
 328+ 7EB2                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EB2                  ; Nei dati di Manic Miner:
 330+ 7EB2                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EB2                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EB2 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EB5 E6 03            and  3
 334+ 7EB7 47               ld   b, a                      ; B = Anim subframe
 335+ 7EB8
 336+ 7EB8 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EBB FE 01            cp   1                         ; Sinistra?
 338+ 7EBD 28 03            jr   z, .left_frames
 339+ 7EBF
 340+ 7EBF                  ; Movimento a Destra: Frame 0..3
 341+ 7EBF 78               ld   a, b
 342+ 7EC0 18 03            jr   .got_frame_idx
 343+ 7EC2
 344+ 7EC2              .left_frames:
 345+ 7EC2                  ; Movimento a Sinistra: Frame 4..7
 346+ 7EC2 3E 04            ld   a, 4
 347+ 7EC4 80               add  a, b
 348+ 7EC5
 349+ 7EC5              .got_frame_idx:
 350+ 7EC5                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7EC5 6F               ld   l, a
 352+ 7EC6 26 00            ld   h, 0
 353+ 7EC8 29               add  hl, hl                    ; *2
 354+ 7EC9 29               add  hl, hl                    ; *4
 355+ 7ECA 29               add  hl, hl                    ; *8
 356+ 7ECB 29               add  hl, hl                    ; *16
 357+ 7ECC 29               add  hl, hl                    ; *32
 358+ 7ECD
 359+ 7ECD 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7ED0 19               add  hl, de
 361+ 7ED1 ED 5B 80 99      ld   de, (room_ptr)
 362+ 7ED5 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7ED6 E5               push hl
 364+ 7ED7 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7ED9
 366+ 7ED9                  ; 2. Coordinate e colore
 367+ 7ED9 FD E1            pop  iy                        ; IY = ActiveEnemies slot

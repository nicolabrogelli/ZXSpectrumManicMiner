 138+ 8087              ; Items_DrawRoom
 139+ 8087              ;
 140+ 8087              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 8087              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 8087              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 8087              ;
 144+ 8087              ; Record item nella stanza (5 byte):
 145+ 8087              ;   +0 Color / Attributo
 146+ 8087              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 8087              ;   +2 Attr Address High
 148+ 8087              ;   +3 Anim Mask (96)
 149+ 8087              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 8087              ; Fine lista: $FF
 151+ 8087              ; -------------------------------------------------------------------
 152+ 8087              Items_DrawRoom:
 153+ 8087 E5               push hl
 154+ 8088 D5               push de
 155+ 8089 C5               push bc
 156+ 808A DD E5            push ix
 157+ 808C FD E5            push iy
 158+ 808E
 159+ 808E                  ; 1. Azzera items_grid (512 byte)
 160+ 808E 21 02 98         ld   hl, items_grid
 161+ 8091 11 03 98         ld   de, items_grid + 1
 162+ 8094 36 00            ld   (hl), 0
 163+ 8096 01 FF 01         ld   bc, 511
 164+ 8099 ED B0            ldir
 165+ 809B
 166+ 809B                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 809B AF               xor  a
 168+ 809C 32 81 9D         ld   (num_room_items), a
 169+ 809F
 170+ 809F FD 21 31 9D      ld   iy, current_room_items
 171+ 80A3
 172+ 80A3                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80A3 2A 82 9D         ld   hl, (room_ptr)
 174+ 80A6 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80A9 19               add  hl, de
 176+ 80AA E5               push hl
 177+ 80AB DD E1            pop  ix                        ; IX = bitmap item
 178+ 80AD
 179+ 80AD                  ; 4. HL = Inizio lista item nella stanza
 180+ 80AD 2A 82 9D         ld   hl, (room_ptr)
 181+ 80B0 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80B3 19               add  hl, de
 183+ 80B4
 184+ 80B4              .loop:
 185+ 80B4 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80B5 FE FF            cp   $FF
 187+ 80B7 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80B9
 189+ 80B9 5F               ld   e, a                      ; E = Color
 190+ 80BA 23               inc  hl
 191+ 80BB 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80BC 23               inc  hl
 193+ 80BD 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80BE 23               inc  hl                        ; Salta Anim Byte
 195+ 80BF 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80C0
 197+ 80C0 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80C1 FE FF            cp   $FF
 199+ 80C3 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 80C5
 201+ 80C5                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 80C5 E5               push hl
 203+ 80C6 60               ld   h, b
 204+ 80C7 69               ld   l, c
 205+ 80C8 01 00 A4         ld   bc, -23552
 206+ 80CB 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80CC
 208+ 80CC                  ; Col = Offset & 31
 209+ 80CC 7D               ld   a, l
 210+ 80CD E6 1F            and  31
 211+ 80CF 4F               ld   c, a                      ; C = Col (0..31)
 212+ 80D0
 213+ 80D0                  ; Row = Offset / 32
 214+ 80D0 CB 3C            srl  h
 214+ 80D2 CB 1D          rr l
 215+ 80D4 CB 3C            srl  h
 215+ 80D6 CB 1D          rr l
 216+ 80D8 CB 3C            srl  h
 216+ 80DA CB 1D          rr l
 217+ 80DC CB 3C            srl  h
 217+ 80DE CB 1D          rr l
 218+ 80E0 CB 3C            srl  h
 218+ 80E2 CB 1D          rr l
 219+ 80E4 7D               ld   a, l
 220+ 80E5 47               ld   b, a                      ; B = Row (0..15)
 221+ 80E6
 222+ 80E6                  ; Disegna l'item sullo schermo
 223+ 80E6 DD E5            push ix
 224+ 80E8 E1               pop  hl                        ; HL = puntatore bitmap
 225+ 80E9 CD 3B 81         call DrawItemGraphic
 226+ 80EC
 227+ 80EC                  ; Aggiorna items_grid: offset = Row * 32 + Col
 228+ 80EC D5               push de
 229+ 80ED 26 00            ld   h, 0
 230+ 80EF 68               ld   l, b                      ; HL = Row
 231+ 80F0 29               add  hl, hl
 232+ 80F1 29               add  hl, hl
 233+ 80F2 29               add  hl, hl
 234+ 80F3 29               add  hl, hl
 235+ 80F4 29               add  hl, hl                    ; Row * 32
 236+ 80F5 59               ld   e, c
 237+ 80F6 16 00            ld   d, 0
 238+ 80F8 19               add  hl, de                    ; Row * 32 + Col

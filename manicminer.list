 204+ 7E57 69               ld   l, c
 205+ 7E58 01 00 A4         ld   bc, -23552
 206+ 7E5B 09               add  hl, bc                    ; HL = AttrOffset
 207+ 7E5C
 208+ 7E5C                  ; Col = Offset & 31
 209+ 7E5C 7D               ld   a, l
 210+ 7E5D E6 1F            and  31
 211+ 7E5F 4F               ld   c, a                      ; C = Col (0..31)
 212+ 7E60
 213+ 7E60                  ; Row = Offset / 32
 214+ 7E60 CB 3C            srl  h
 214+ 7E62 CB 1D          rr l
 215+ 7E64 CB 3C            srl  h
 215+ 7E66 CB 1D          rr l
 216+ 7E68 CB 3C            srl  h
 216+ 7E6A CB 1D          rr l
 217+ 7E6C CB 3C            srl  h
 217+ 7E6E CB 1D          rr l
 218+ 7E70 CB 3C            srl  h

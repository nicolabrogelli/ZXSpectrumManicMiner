1699+ 66B0 CD 1F 6D         call Gfx_SetEnemyColorAttributes
1700+ 66B3
1701+ 66B3                  ; 7d. Pausa per movimento fluido a 50Hz
1702+ 66B3 76               halt
1703+ 66B4
1704+ 66B4 C1               pop  bc                    ; B = Y corrente
1705+ 66B5 78               ld   a, b
1706+ 66B6 C6 02            add  a, 2                  ; Avanza di 2 pixel
1707+ 66B8 47               ld   b, a
1708+ 66B9 FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1709+ 66BB 38 B2            jr   c, .foot_descent_loop
1710+ 66BD
1711+ 66BD                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1712+ 66BD 06 23            ld   b, 35

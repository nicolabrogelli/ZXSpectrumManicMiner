 465+ 7EF1 DD 21 5D 7C      ld   ix, ActiveEnemies
 466+ 7EF5 06 08            ld   b, 8                      ; 8 slot
 467+ 7EF7              .loop:
 468+ 7EF7 DD 7E 00         ld   a, (ix+0)                 ; Flags
 469+ 7EFA E6 80            and  $80                       ; Active?
 470+ 7EFC CA A6 7F         jp   z, .next
 471+ 7EFF
 472+ 7EFF                  ; 1. Determina se orizzontale o verticale
 473+ 7EFF DD 7E 00         ld   a, (ix+0)
 474+ 7F02 E6 40            and  $40                       ; Vertical?
 475+ 7F04 C2 57 7F         jp   nz, .vertical
 476+ 7F07
 477+ 7F07                  ; Aggiorna Anim State per guardiano orizzontale (0..3)
 478+ 7F07 DD 7E 07         ld   a, (ix+7)
 479+ 7F0A 3C               inc  a
 480+ 7F0B E6 03            and  3
 481+ 7F0D DD 77 07         ld   (ix+7), a
 482+ 7F10
 483+ 7F10              .horizontal:
 484+ 7F10 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 485+ 7F13 FE 01            cp   1
 486+ 7F15 20 20            jr   nz, .horiz_right
 487+ 7F17
 488+ 7F17              .horiz_left:
 489+ 7F17 DD 7E 02         ld   a, (ix+2)                 ; Current X
 490+ 7F1A D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 491+ 7F1C DD BE 04         cp   (ix+4)                    ; Min Limit
 492+ 7F1F 28 08            jr   z, .h_rev_right
 493+ 7F21 38 06            jr   c, .h_rev_right
 494+ 7F23 DD 77 02         ld   (ix+2), a
 495+ 7F26 C3 A6 7F         jp   .next
 496+ 7F29
 497+ 7F29              .h_rev_right:
 498+ 7F29 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 499+ 7F2C DD 77 02         ld   (ix+2), a
 500+ 7F2F 3E 02            ld   a, 2
 501+ 7F31 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 502+ 7F34 C3 A6 7F         jp   .next
 503+ 7F37
 504+ 7F37              .horiz_right:
 505+ 7F37 DD 7E 02         ld   a, (ix+2)                 ; Current X
 506+ 7F3A C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 507+ 7F3C DD BE 05         cp   (ix+5)                    ; Max Limit
 508+ 7F3F 28 08            jr   z, .h_rev_left
 509+ 7F41 30 06            jr   nc, .h_rev_left
 510+ 7F43 DD 77 02         ld   (ix+2), a
 511+ 7F46 C3 A6 7F         jp   .next
 512+ 7F49
 513+ 7F49              .h_rev_left:
 514+ 7F49 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 515+ 7F4C DD 77 02         ld   (ix+2), a
 516+ 7F4F 3E 01            ld   a, 1
 517+ 7F51 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 518+ 7F54 C3 A6 7F         jp   .next
 519+ 7F57
 520+ 7F57              .vertical:
 521+ 7F57 DD 7E 07         ld   a, (ix+7)                 ; Step in pixel (1 o 2)
 522+ 7F5A E6 03            and  3
 523+ 7F5C 20 02            jr   nz, .v_step_ok
 524+ 7F5E 3E 01            ld   a, 1
 525+ 7F60              .v_step_ok:
 526+ 7F60 4F               ld   c, a                      ; C = Step
 527+ 7F61
 528+ 7F61 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 529+ 7F64 FE 01            cp   1
 530+ 7F66 20 1F            jr   nz, .vert_down
 531+ 7F68
 532+ 7F68              .vert_up:
 533+ 7F68 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 534+ 7F6B 91               sub  c                         ; Muovi verso l'alto
 535+ 7F6C DD BE 04         cp   (ix+4)                    ; Min Limit Y
 536+ 7F6F 28 08            jr   z, .v_rev_down
 537+ 7F71 38 06            jr   c, .v_rev_down
 538+ 7F73 DD 77 03         ld   (ix+3), a
 539+ 7F76 C3 A6 7F         jp   .next
 540+ 7F79
 541+ 7F79              .v_rev_down:
 542+ 7F79 DD 7E 04         ld   a, (ix+4)                 ; Min Limit Y
 543+ 7F7C DD 77 03         ld   (ix+3), a
 544+ 7F7F 3E 02            ld   a, 2                      ; Cambia direzione a Down
 545+ 7F81 DD 77 06         ld   (ix+6), a
 546+ 7F84 C3 A6 7F         jp   .next
 547+ 7F87
 548+ 7F87              .vert_down:
 549+ 7F87 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 550+ 7F8A 81               add  a, c                      ; Muovi verso il basso
 551+ 7F8B DD BE 05         cp   (ix+5)                    ; Max Limit Y
 552+ 7F8E 28 08            jr   z, .v_rev_up
 553+ 7F90 30 06            jr   nc, .v_rev_up
 554+ 7F92 DD 77 03         ld   (ix+3), a
 555+ 7F95 C3 A6 7F         jp   .next
 556+ 7F98
 557+ 7F98              .v_rev_up:
 558+ 7F98 DD 7E 05         ld   a, (ix+5)                 ; Max Limit Y

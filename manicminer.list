 632  8908
 633  8908              ; -------------------------------------------------------------------
 634  8908              ; CheckPortalTransition
 635  8908              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8908              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8908              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8908              ;
 639  8908              ; Output:
 640  8908              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8908              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8908              ; -------------------------------------------------------------------
 643  8908              CheckPortalTransition:
 644  8908 C5               push bc
 645  8909 D5               push de
 646  890A E5               push hl
 647  890B
 648  890B                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  890B CD 96 89         call CheckAllItemsCollected
 650  890E 30 4D            jr   nc, .no_transition
 651  8910
 652  8910                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  8910                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  8910                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  8910 2A 1E E4         ld   hl, (room_ptr)
 656  8913 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8916 19               add  hl, de
 658  8917 4E               ld   c, (hl)
 659  8918 23               inc  hl
 660  8919 46               ld   b, (hl)                   ; BC = AttrAddr
 661  891A
 662  891A                  ; Offset = BC - 23552
 663  891A 60               ld   h, b
 664  891B 69               ld   l, c
 665  891C 01 00 A4         ld   bc, -23552
 666  891F 09               add  hl, bc
 667  8920
 668  8920                  ; PortalX = (Offset & 31) * 8

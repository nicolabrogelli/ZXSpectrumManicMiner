 482+ 7FC7              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7FC7              ; -------------------------------------------------------------------
 484+ 7FC7              Enemy_DrawSingleSlot:
 485+ 7FC7 C5               push bc
 486+ 7FC8 D5               push de

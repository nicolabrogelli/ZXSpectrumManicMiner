1182+ 646F 21 8D 5C         ld   hl, ATTR_P
1183+ 6472 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1184+ 6473 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1185+ 6476 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1186+ 6478 3E 07            ld   a, $07
1187+ 647A 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1188+ 647D
1189+ 647D                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1190+ 647D                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1191+ 647D 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1192+ 6480 DD 21 31 89      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1193+ 6484 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1194+ 6487
1195+ 6487                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1196+ 6487 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1197+ 648A DD 21 39 89      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1198+ 648E CD 3F 5E         call Gfx_DrawPixelSprite8x8

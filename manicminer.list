 431+ 82A2 87               add  a, a                      ; *2
 432+ 82A3 87               add  a, a                      ; *4
 433+ 82A4 87               add  a, a                      ; *8
 434+ 82A5 5F               ld   e, a                      ; E = ItemLeft
 435+ 82A6 C6 07            add  a, 7
 436+ 82A8 57               ld   d, a                      ; D = ItemRight
 437+ 82A9
 438+ 82A9 ED 4B DE C6      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 82AD
 440+ 82AD                  ; WillyLeft <= ItemRight
 441+ 82AD 79               ld   a, c                      ; A = WillyX
 442+ 82AE BA               cp   d                         ; D = ItemRight
 443+ 82AF 28 04            jr   z, .x_ok
 444+ 82B1 38 02            jr   c, .x_ok
 445+ 82B3 18 31            jr   .no_collision
 446+ 82B5
 447+ 82B5              .x_ok:
 448+ 82B5                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 82B5 BB               cp   e                         ; E = ItemLeft
 450+ 82B6 28 0B            jr   z, .y_check
 451+ 82B8 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 82BA
 453+ 82BA                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 82BA C6 0F            add  a, 15
 455+ 82BC BB               cp   e
 456+ 82BD 28 04            jr   z, .y_check
 457+ 82BF 30 02            jr   nc, .y_check
 458+ 82C1 18 23            jr   .no_collision

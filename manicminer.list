 138+ 8171              ; Items_DrawRoom
 139+ 8171              ;
 140+ 8171              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 8171              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 8171              ; room_ptr + OFFSET_ITEM_GRAPHIC.

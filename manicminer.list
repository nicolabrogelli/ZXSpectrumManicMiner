   8+ 86C7              ; Audio_UpdateJumpSound
   9+ 86C7              ;
  10+ 86C7              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 86C7              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 86C7              ; -------------------------------------------------------------------
  13+ 86C7              Audio_UpdateJumpSound:
  14+ 86C7 F5               push af
  15+ 86C8 C5               push bc
  16+ 86C9 D5               push de
  17+ 86CA E5               push hl
  18+ 86CB
  19+ 86CB                  ; Controlla se il suono è attivo (note < 18)
  20+ 86CB 3A F1 E7         ld   a, (Audio_jump_sound_note)
  21+ 86CE FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86D0 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86D2
  24+ 86D2                  ; Carica la nota corrente da suonare
  25+ 86D2 5F               ld   e, a
  26+ 86D3 16 00            ld   d, 0
  27+ 86D5 21 01 87         ld   hl, Audio_JumpSoundDelays
  28+ 86D8 19               add  hl, de
  29+ 86D9 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86DA 57               ld   d, a                      ; D = delay della nota
  31+ 86DB
  32+ 86DB                  ; Suona la nota: 15 cicli
  33+ 86DB 06 0F            ld   b, 15
  34+ 86DD              .note_loop:
  35+ 86DD                  ; Speaker ON
  36+ 86DD 3A DE E1         ld   a, (room_border_color)
  37+ 86E0 F6 10            or   $10
  38+ 86E2 D3 FE            out  ($fe), a
  39+ 86E4 4A               ld   c, d
  40+ 86E5              .d1:
  41+ 86E5 0D               dec  c
  42+ 86E6 20 FD            jr   nz, .d1
  43+ 86E8
  44+ 86E8                  ; Speaker OFF
  45+ 86E8 3A DE E1         ld   a, (room_border_color)
  46+ 86EB E6 EF            and  $ef
  47+ 86ED D3 FE            out  ($fe), a
  48+ 86EF 4A               ld   c, d
  49+ 86F0              .d2:
  50+ 86F0 0D               dec  c
  51+ 86F1 20 FD            jr   nz, .d2
  52+ 86F3
  53+ 86F3 10 E8            djnz .note_loop
  54+ 86F5
  55+ 86F5                  ; Passa alla nota successiva
  56+ 86F5 3A F1 E7         ld   a, (Audio_jump_sound_note)
  57+ 86F8 3C               inc  a
  58+ 86F9 32 F1 E7         ld   (Audio_jump_sound_note), a
  59+ 86FC
  60+ 86FC              .done:
  61+ 86FC E1               pop  hl
  62+ 86FD D1               pop  de
  63+ 86FE C1               pop  bc
  64+ 86FF F1               pop  af
  65+ 8700 C9               ret
  66+ 8701
  67+ 8701              Audio_JumpSoundDelays:
  68+ 8701 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 8705 19 13 0C 06
  68+ 8709 0C 13 19 20
  68+ 870D 26 2D 33 3A
  68+ 8711 40 47

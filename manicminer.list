   7+ 7ED0              ; -------------------------------------------------------------------
   8+ 7ED0              ; Audio_UpdateJumpSound
   9+ 7ED0              ;
  10+ 7ED0              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7ED0              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7ED0              ; -------------------------------------------------------------------
  13+ 7ED0              Audio_UpdateJumpSound:
  14+ 7ED0 F5               push af
  15+ 7ED1 C5               push bc
  16+ 7ED2 D5               push de
  17+ 7ED3 E5               push hl
  18+ 7ED4
  19+ 7ED4                  ; Controlla se il suono è attivo (note < 18)
  20+ 7ED4 3A BD 93         ld   a, (Audio_jump_sound_note)
  21+ 7ED7 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7ED9 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7EDB
  24+ 7EDB                  ; Carica la nota corrente da suonare
  25+ 7EDB 5F               ld   e, a
  26+ 7EDC 16 00            ld   d, 0
  27+ 7EDE 21 0A 7F         ld   hl, Audio_JumpSoundDelays
  28+ 7EE1 19               add  hl, de
  29+ 7EE2 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7EE3 57               ld   d, a                      ; D = delay della nota
  31+ 7EE4
  32+ 7EE4                  ; Suona la nota: 15 cicli
  33+ 7EE4 06 0F            ld   b, 15
  34+ 7EE6              .note_loop:
  35+ 7EE6                  ; Speaker ON
  36+ 7EE6 3A B3 8D         ld   a, (room_border_color)
  37+ 7EE9 F6 10            or   $10
  38+ 7EEB D3 FE            out  ($fe), a
  39+ 7EED 4A               ld   c, d
  40+ 7EEE              .d1:
  41+ 7EEE 0D               dec  c
  42+ 7EEF 20 FD            jr   nz, .d1
  43+ 7EF1
  44+ 7EF1                  ; Speaker OFF
  45+ 7EF1 3A B3 8D         ld   a, (room_border_color)
  46+ 7EF4 E6 EF            and  $ef
  47+ 7EF6 D3 FE            out  ($fe), a
  48+ 7EF8 4A               ld   c, d
  49+ 7EF9              .d2:
  50+ 7EF9 0D               dec  c
  51+ 7EFA 20 FD            jr   nz, .d2
  52+ 7EFC
  53+ 7EFC 10 E8            djnz .note_loop
  54+ 7EFE
  55+ 7EFE                  ; Passa alla nota successiva
  56+ 7EFE 3A BD 93         ld   a, (Audio_jump_sound_note)
  57+ 7F01 3C               inc  a
  58+ 7F02 32 BD 93         ld   (Audio_jump_sound_note), a
  59+ 7F05
  60+ 7F05              .done:
  61+ 7F05 E1               pop  hl
  62+ 7F06 D1               pop  de
  63+ 7F07 C1               pop  bc
  64+ 7F08 F1               pop  af
  65+ 7F09 C9               ret
  66+ 7F0A
  67+ 7F0A              Audio_JumpSoundDelays:
  68+ 7F0A 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7F0E 19 13 0C 06
  68+ 7F12 0C 13 19 20
  68+ 7F16 26 2D 33 3A
  68+ 7F1A 40 47
  69+ 7F1C
  70+ 7F1C                  IF ENABLE_MUSIC != 0
  71+ 7F1C ~            ; -------------------------------------------------------------------
  72+ 7F1C ~            ; Audio_UpdateMusic
  73+ 7F1C ~            ;
  74+ 7F1C ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7F1C ~            ; Viene chiamata a ogni frame.
  76+ 7F1C ~            ; -------------------------------------------------------------------
  77+ 7F1C ~            Audio_UpdateMusic:
  78+ 7F1C ~                push af
  79+ 7F1C ~                push bc
  80+ 7F1C ~                push de
  81+ 7F1C ~                push hl
  82+ 7F1C ~
  83+ 7F1C ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7F1C ~                ld   a, (Audio_jump_sound_note)
  85+ 7F1C ~                cp   18
  86+ 7F1C ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7F1C ~
  88+ 7F1C ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7F1C ~                ld   a, (Audio_music_frame_counter)
  90+ 7F1C ~                dec  a
  91+ 7F1C ~                ld   (Audio_music_frame_counter), a
  92+ 7F1C ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7F1C ~
  94+ 7F1C ~                ; Altrimenti carica la nota successiva
  95+ 7F1C ~                ld   a, (Audio_music_note_idx)
  96+ 7F1C ~                inc  a
  97+ 7F1C ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7F1C ~                jr   c, .no_wrap
  99+ 7F1C ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7F1C ~            .no_wrap:
 101+ 7F1C ~                ld   (Audio_music_note_idx), a
 102+ 7F1C ~
 103+ 7F1C ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7F1C ~                ld   e, a
 105+ 7F1C ~                ld   d, 0
 106+ 7F1C ~                ld   hl, Audio_MusicSheet
 107+ 7F1C ~                add  hl, de
 108+ 7F1C ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7F1C ~
 110+ 7F1C ~                ; Leggi durata (secondo byte)
 111+ 7F1C ~                inc  hl
 112+ 7F1C ~                ld   a, (hl)
 113+ 7F1C ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7F1C ~                jr   nz, .dur_ok
 115+ 7F1C ~                ld   a, 1
 116+ 7F1C ~            .dur_ok:
 117+ 7F1C ~                ld   (Audio_music_frame_counter), a
 118+ 7F1C ~
 119+ 7F1C ~            .play_current_note:
 120+ 7F1C ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7F1C ~                ld   a, (Audio_music_note_idx)
 122+ 7F1C ~                ld   e, a
 123+ 7F1C ~                ld   d, 0
 124+ 7F1C ~                ld   hl, Audio_MusicSheet
 125+ 7F1C ~                add  hl, de
 126+ 7F1C ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7F1C ~                ld   a, (hl)                  ; A = delay
 128+ 7F1C ~                or   a
 129+ 7F1C ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7F1C ~
 131+ 7F1C ~                ; Suona la nota: 2 cicli
 132+ 7F1C ~                ld   d, a                     ; D = delay
 133+ 7F1C ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7F1C ~            .note_loop:
 135+ 7F1C ~                ; Speaker ON
 136+ 7F1C ~                ld   a, (room_border_color)
 137+ 7F1C ~                or   $10
 138+ 7F1C ~                out  ($fe), a
 139+ 7F1C ~                ld   c, d
 140+ 7F1C ~            .d1:
 141+ 7F1C ~                push af
 142+ 7F1C ~                pop  af
 143+ 7F1C ~                dec  c
 144+ 7F1C ~                jr   nz, .d1
 145+ 7F1C ~
 146+ 7F1C ~                ; Speaker OFF
 147+ 7F1C ~                ld   a, (room_border_color)
 148+ 7F1C ~                and  $ef
 149+ 7F1C ~                out  ($fe), a
 150+ 7F1C ~                ld   c, d
 151+ 7F1C ~            .d2:
 152+ 7F1C ~                push af
 153+ 7F1C ~                pop  af
 154+ 7F1C ~                dec  c
 155+ 7F1C ~                jr   nz, .d2
 156+ 7F1C ~
 157+ 7F1C ~                djnz .note_loop
 158+ 7F1C ~
 159+ 7F1C ~            .done:
 160+ 7F1C ~                pop  hl
 161+ 7F1C ~                pop  de
 162+ 7F1C ~                pop  bc
 163+ 7F1C ~                pop  af
 164+ 7F1C ~                ret
 165+ 7F1C ~
 166+ 7F1C ~            Audio_MusicSheet:
 167+ 7F1C ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7F1C ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7F1C ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7F1C ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7F1C ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7F1C ~                db 90, 10, 107, 20, 68, 65
 173+ 7F1C                  ELSE
 174+ 7F1C              Audio_UpdateMusic:
 175+ 7F1C C9               ret
 176+ 7F1D                  ENDIF

 518+ 8003              ; CheckCollision
 519+ 8003              ;
 520+ 8003              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 8003              ; Output:
 522+ 8003              ;   Carry Set = Collisione con guardiano
 523+ 8003              ;   Carry Clear = Nessuna collisione
 524+ 8003              ; -------------------------------------------------------------------
 525+ 8003              CheckCollision:
 526+ 8003 DD E5            push ix
 527+ 8005 C5               push bc
 528+ 8006 D5               push de
 529+ 8007 E5               push hl
 530+ 8008
 531+ 8008                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 8008 3A 59 A2         ld   a, (willy_safety_timer)
 533+ 800B B7               or   a
 534+ 800C 20 3B            jr   nz, .no_collision_found
 535+ 800E
 536+ 800E DD 21 FB 7C      ld   ix, ActiveEnemies
 537+ 8012 06 08            ld   b, 8                      ; 8 slot
 538+ 8014
 539+ 8014              .collision_loop:
 540+ 8014 DD 7E 00         ld   a, (ix+0)
 541+ 8017 E6 80            and  $80                       ; Active?
 542+ 8019 28 26            jr   z, .next_enemy
 543+ 801B
 544+ 801B C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 801C
 546+ 801C                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 801C ED 4B 4E 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 8020 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 8023
 550+ 8023                  ; Calcola differenza X
 551+ 8023 91               sub  c                         ; A = EnemyX - WillyX
 552+ 8024 30 02            jr   nc, .x_diff_pos
 553+ 8026 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 8028              .x_diff_pos:
 555+ 8028 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 802A 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 802C
 558+ 802C                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 802C DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 802F 90               sub  b                         ; A = EnemyY - WillyY
 561+ 8030 30 02            jr   nc, .y_diff_pos
 562+ 8032 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 8034              .y_diff_pos:
 564+ 8034 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8036 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 8038
 567+ 8038                  ; Collisione trovata!
 568+ 8038 C1               pop  bc                        ; Ripristina stack
 569+ 8039 E1               pop  hl
 570+ 803A D1               pop  de
 571+ 803B C1               pop  bc
 572+ 803C DD E1            pop  ix
 573+ 803E 37               scf
 574+ 803F C9               ret
 575+ 8040
 576+ 8040              .no_x_hit:
 577+ 8040 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 8041
 579+ 8041              .next_enemy:
 580+ 8041 11 0B 00         ld   de, 11

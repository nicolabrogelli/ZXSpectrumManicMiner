1164+ 7898              ; Phys_CheckRampOnRoomChange
1165+ 7898              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 7898              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 7898              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 7898              ; -------------------------------------------------------------------
1169+ 7898              Phys_CheckRampOnRoomChange:
1170+ 7898 E5               push hl
1171+ 7899 D5               push de
1172+ 789A C5               push bc
1173+ 789B
1174+ 789B                  ; Offsets per RampData: DE + 218
1175+ 789B 21 DA 00         ld   hl, 218
1176+ 789E 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 789F
1178+ 789F 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 78A0 32 35 E2         ld   (ramp_dir), a
1180+ 78A3 23               inc  hl
1181+ 78A4 5E               ld   e, (hl)
1182+ 78A5 23               inc  hl
1183+ 78A6 56               ld   d, (hl)           ; DE = Location
1184+ 78A7 23               inc  hl
1185+ 78A8 7E               ld   a, (hl)           ; A = Length
1186+ 78A9 32 36 E2         ld   (ramp_len), a
1187+ 78AC
1188+ 78AC                  ; Controlla se DE (Location) è 0 o Length è 0
1189+ 78AC 7A               ld   a, d
1190+ 78AD B3               or   e
1191+ 78AE CA B5 79         jp   z, .no_ramp_change
1192+ 78B1 3A 36 E2         ld   a, (ramp_len)
1193+ 78B4 B7               or   a
1194+ 78B5 CA B5 79         jp   z, .no_ramp_change
1195+ 78B8
1196+ 78B8                  ; Calcola Row e Col: Offset = DE - 24064
1197+ 78B8 21 00 A2         ld   hl, -24064
1198+ 78BB 19               add  hl, de            ; HL = Offset
1199+ 78BC 54               ld   d, h
1200+ 78BD 5D               ld   e, l

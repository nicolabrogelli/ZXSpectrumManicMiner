 361+ 6CCB
 362+ 6CCB 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 363+ 6CCC CB 3F            srl  a
 364+ 6CCE F5               push af                        ; Salva PlayerY sullo stack

1231+ 64C5                  ; 7. Animazione: Discesa fluida di PiedeSprite dall'alto (Y=0) fino a Y=96 (alla parte alta della Botte)
1232+ 64C5 06 00            ld   b, 0                  ; B = Y iniziale (0)
1233+ 64C7              .foot_descent_loop:
1234+ 64C7 C5               push bc                    ; Salva B = Y corrente
1235+ 64C8
1236+ 64C8                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1237+ 64C8 78               ld   a, b
1238+ 64C9 B7               or   a
1239+ 64CA 28 1F            jr   z, .skip_clear_prev
1240+ 64CC D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1241+ 64CE 47               ld   b, a
1242+ 64CF 0E 78            ld   c, 120                ; X = 120
1243+ 64D1 CD 0F 61         call Gfx_Clear16x16_Black
1244+ 64D4
1245+ 64D4                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1246+ 64D4 78               ld   a, b
1247+ 64D5 CB 3F            srl  a
1248+ 64D7 CB 3F            srl  a
1249+ 64D9 CB 3F            srl  a                     ; A = Row da azzerare
1250+ 64DB 6F               ld   l, a
1251+ 64DC 26 00            ld   h, 0
1252+ 64DE 29               add  hl, hl                ; * 2
1253+ 64DF 29               add  hl, hl                ; * 4
1254+ 64E0 29               add  hl, hl                ; * 8
1255+ 64E1 29               add  hl, hl                ; * 16
1256+ 64E2 29               add  hl, hl                ; * 32
1257+ 64E3 11 0F 58         ld   de, $580f             ; $5800 + 15
1258+ 64E6 19               add  hl, de
1259+ 64E7 AF               xor  a
1260+ 64E8 77               ld   (hl), a               ; Col 15 = 0
1261+ 64E9 23               inc  hl
1262+ 64EA 77               ld   (hl), a               ; Col 16 = 0
1263+ 64EB
1264+ 64EB              .skip_clear_prev:
1265+ 64EB C1               pop  bc                    ; Ripristina B = Y corrente
1266+ 64EC C5               push bc
1267+ 64ED
1268+ 64ED                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1269+ 64ED 78               ld   a, b
1270+ 64EE FE 60            cp   96
1271+ 64F0 20 09            jr   nz, .draw_foot
1272+ 64F2 C5               push bc
1273+ 64F3 0E 78            ld   c, 120
1274+ 64F5 06 60            ld   b, 96
1275+ 64F7 CD 0F 61         call Gfx_Clear16x16_Black
1276+ 64FA C1               pop  bc
1277+ 64FB
1278+ 64FB              .draw_foot:
1279+ 64FB                  ; 7b. Disegna PiedeSprite alla coordinata corrente (X=120, Y)
1280+ 64FB 0E 78            ld   c, 120
1281+ 64FD DD 21 30 6B      ld   ix, PiedeSprite
1282+ 6501 CD 38 5F         call Gfx_DrawPixelSprite16x16
1283+ 6504
1284+ 6504                  ; 7c. Imposta colore Giallo Brillante per PiedeSprite
1285+ 6504 0E 78            ld   c, 120
1286+ 6506 3E 46            ld   a, YELLOW | $40
1287+ 6508 CD 38 6A         call Gfx_SetEnemyColorAttributes
1288+ 650B
1289+ 650B                  ; 7d. Pausa per movimento fluido a 50Hz
1290+ 650B 76               halt
1291+ 650C
1292+ 650C C1               pop  bc                    ; B = Y corrente
1293+ 650D 78               ld   a, b
1294+ 650E C6 02            add  a, 2                  ; Avanza di 2 pixel
1295+ 6510 47               ld   b, a
1296+ 6511 FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1297+ 6513 38 B2            jr   c, .foot_descent_loop
1298+ 6515
1299+ 6515                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1300+ 6515 06 23            ld   b, 35

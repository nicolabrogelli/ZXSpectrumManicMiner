  89+ F117              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  90+ F117 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  91+ F11A 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  92+ F11D 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  93+ F11E 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  94+ F11F 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  95+ F120 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  96+ F121 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  97+ F122 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  98+ F123 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  99+ F124

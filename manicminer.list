 287+ 7FAD              ; DrawItemGraphic
 288+ 7FAD              ;
 289+ 7FAD              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 290+ 7FAD              ; utilizzando una bitmap di 8 byte e un attributo colore.
 291+ 7FAD              ;
 292+ 7FAD              ; Input:
 293+ 7FAD              ;   B = Riga attributi (0..23)
 294+ 7FAD              ;   C = Colonna attributi (0..31)

 460+ 87A7              .y_check:
 461+ 87A7                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 87A7 7C               ld   a, h                      ; H = Item Row
 463+ 87A8 87               add  a, a                      ; *2
 464+ 87A9 87               add  a, a                      ; *4
 465+ 87AA 87               add  a, a                      ; *8

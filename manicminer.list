 725+ 76C6 3A B2 E4         ld   a, (conveyor_len)
 726+ 76C9 80               add  a, b              ; A = conveyor_col + conveyor_len
 727+ 76CA BB               cp   e
 728+ 76CB 28 07            jr   z, .not_solid     ; c == len (fuori)
 729+ 76CD 38 05            jr   c, .not_solid     ; c > len (fuori)

 288  886A              ; -------------------------------------------------------------------
 289  886A              ; ShowTitleScreen
 290  886A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 291  886A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 292  886A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 293  886A              ; -------------------------------------------------------------------
 294  886A              ShowTitleScreen:
 295  886A                  ; 1. Disegna la schermata iniziale
 296  886A CD 76 64         call Gfx_DrawTitleScreen
 297  886D
 298  886D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 299  886D              .wait_title_enter_release:
 300  886D 76               halt
 301  886E 3E BF            ld   a, $bf
 302  8870 DB FE            in   a, ($fe)
 303  8872 1F               rra
 304  8873 30 F8            jr   nc, .wait_title_enter_release
 305  8875
 306  8875                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 307  8875 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 308  8877              .title_loop:
 309  8877 76               halt
 310  8878
 311  8878                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 312  8878 0C               inc  c
 313  8879 79               ld   a, c
 314  887A CB 3F            srl  a
 315  887C CB 3F            srl  a
 316  887E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 317  8880 E6 07            and  7
 318  8882 5F               ld   e, a
 319  8883 16 00            ld   d, 0
 320  8885 21 6E 64         ld   hl, title_color_table
 321  8888 19               add  hl, de
 322  8889 7E               ld   a, (hl)               ; A = nuovo colore
 323  888A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 324  888D 06 20            ld   b, 32
 325  888F              .color_title_loop:
 326  888F 77               ld   (hl), a
 327  8890 23               inc  hl
 328  8891 10 FC            djnz .color_title_loop
 329  8893
 330  8893                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 331  8893 3E BF            ld   a, $bf
 332  8895 DB FE            in   a, ($fe)
 333  8897 1F               rra
 334  8898 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 335  889A
 336  889A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 337  889A              .wait_title_enter_release_after:
 338  889A 76               halt
 339  889B 3E BF            ld   a, $bf
 340  889D DB FE            in   a, ($fe)
 341  889F 1F               rra
 342  88A0 30 F8            jr   nc, .wait_title_enter_release_after
 343  88A2
 344  88A2                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 345  88A2 AF               xor  a
 346  88A3 D3 FE            out  ($fe), a              ; Bordo a nero
 347  88A5 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  88A8

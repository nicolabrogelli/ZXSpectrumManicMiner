 856  82D2              ; -------------------------------------------------------------------
 857  82D2              ; ResetFullGameState
 858  82D2              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 859  82D2              ; per l'avvio di una nuova partita dopo il Game Over.
 860  82D2              ; -------------------------------------------------------------------
 861  82D2              ResetFullGameState:
 862  82D2                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 863  82D2 AF               xor  a
 864  82D3 D3 FE            out  ($fe), a              ; Bordo a nero
 865  82D5 21 8D 5C         ld   hl, ATTR_P
 866  82D8 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 867  82D9 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 868  82DC 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 869  82DE 3E 07            ld   a, $07
 870  82E0 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 871  82E3
 872  82E3                  ; Ripristina il numero di vite iniziali
 873  82E3 3E 07            ld   a, INITIAL_LIVES
 874  82E5 32 F9 8D         ld   (willy_lives), a
 875  82E8
 876  82E8                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 877  82E8 AF               xor  a
 878  82E9 32 F6 8D         ld   (items_collected), a
 879  82EC 32 F2 8D         ld   (body_state), a
 880  82EF 32 05 8E         ld   (w_warp_state), a
 881  82F2 32 08 8E         ld   (w_key_prev), a
 882  82F5 32 09 8E         ld   (enter_key_prev), a
 883  82F8 32 FA 8D         ld   (velocity_y), a
 884  82FB 32 FC 8D         ld   (jump_pressed), a
 885  82FE 32 FE 8D         ld   (coyote_timer), a
 886  8301 32 01 8E         ld   (jump_frame), a
 887  8304 32 00 8E         ld   (jump_dir), a
 888  8307 32 72 91         ld   (transition_active), a
 889  830A 32 F6 91         ld   (willy_safety_timer), a
 890  830D 3E FF            ld   a, $ff
 891  830F 32 0A 8E         ld   (digit_key_prev), a
 892  8312 3E 01            ld   a, 1
 893  8314 32 03 8E         ld   (q_prev), a
 894  8317 32 04 8E         ld   (a_prev), a
 895  831A 32 FB 8D         ld   (on_ground), a
 896  831D
 897  831D                  ; Ripristina la stringa di testo dello status line a schermo a "000"
 898  831D 3E 30            ld   a, '0'
 899  831F 32 42 68         ld   (status_line + 16), a
 900  8322 32 43 68         ld   (status_line + 17), a
 901  8325 32 44 68         ld   (status_line + 18), a
 902  8328
 903  8328                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 904  8328 CD 5F 7C         call ResetItemsTable

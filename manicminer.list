1110+ 7838 CB 3F            srl  a
1111+ 783A CB 3F            srl  a                 ; A = r (0..15)
1112+ 783C
1113+ 783C                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1114+ 783C 5F               ld   e, a              ; E = r (Row)
1115+ 783D 79               ld   a, c
1116+ 783E CB 3F            srl  a
1117+ 7840 CB 3F            srl  a
1118+ 7842 CB 3F            srl  a                 ; A = c (0..31)
1119+ 7844 4F               ld   c, a              ; C = c (Col)
1120+ 7845
1121+ 7845                  ; Se la cella è sulla rampa, non considerarla un muro!
1122+ 7845 53               ld   d, e              ; D = Row
1123+ 7846 59               ld   e, c              ; E = Col
1124+ 7847 CD B3 77         call IsCellOnRamp
1125+ 784A 38 09            jr   c, .not_wall
1126+ 784C
1127+ 784C 7A               ld   a, d              ; A = Row
1128+ 784D 4B               ld   c, e              ; C = Col

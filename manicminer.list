  72+ 8728 ~            ; Audio_UpdateMusic
  73+ 8728 ~            ;
  74+ 8728 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8728 ~            ; Viene chiamata a ogni frame.
  76+ 8728 ~            ; -------------------------------------------------------------------
  77+ 8728 ~            Audio_UpdateMusic:
  78+ 8728 ~                push af
  79+ 8728 ~                push bc
  80+ 8728 ~                push de
  81+ 8728 ~                push hl
  82+ 8728 ~
  83+ 8728 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8728 ~                ld   a, (Audio_jump_sound_note)
  85+ 8728 ~                cp   18
  86+ 8728 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8728 ~
  88+ 8728 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8728 ~                ld   a, (Audio_music_frame_counter)
  90+ 8728 ~                dec  a
  91+ 8728 ~                ld   (Audio_music_frame_counter), a
  92+ 8728 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8728 ~
  94+ 8728 ~                ; Altrimenti carica la nota successiva
  95+ 8728 ~                ld   a, (Audio_music_note_idx)
  96+ 8728 ~                inc  a
  97+ 8728 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8728 ~                jr   c, .no_wrap
  99+ 8728 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8728 ~            .no_wrap:
 101+ 8728 ~                ld   (Audio_music_note_idx), a
 102+ 8728 ~
 103+ 8728 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8728 ~                ld   e, a
 105+ 8728 ~                ld   d, 0
 106+ 8728 ~                ld   hl, Audio_MusicSheet
 107+ 8728 ~                add  hl, de
 108+ 8728 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8728 ~
 110+ 8728 ~                ; Leggi durata (secondo byte)
 111+ 8728 ~                inc  hl
 112+ 8728 ~                ld   a, (hl)
 113+ 8728 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8728 ~                jr   nz, .dur_ok
 115+ 8728 ~                ld   a, 1
 116+ 8728 ~            .dur_ok:
 117+ 8728 ~                ld   (Audio_music_frame_counter), a

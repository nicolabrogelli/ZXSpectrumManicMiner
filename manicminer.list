2474+ 6AAD 87               add  a, a              ; *4
2475+ 6AAE 87               add  a, a              ; *8
2476+ 6AAF 4F               ld   c, a              ; C = X pixel
2477+ 6AB0 06 A8            ld   b, 168            ; B = Y pixel (Row 21)
2478+ 6AB2 DD 21 5D DA      ld   ix, Willy + 0*8   ; IX = head facing right
2479+ 6AB6 CD 3F 5E         call Gfx_DrawPixelSprite8x8
2480+ 6AB9

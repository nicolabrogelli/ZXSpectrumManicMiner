2786+ 6BD3 11 20 00         ld   de, 32
2787+ 6BD6 19               add  hl, de
2788+ 6BD7 4E               ld   c, (hl)
2789+ 6BD8 23               inc  hl
2790+ 6BD9 46               ld   b, (hl)               ; BC = AttrAddr (es. 23997)
2791+ 6BDA
2792+ 6BDA                  ; Calcola AttrOffset = BC - 23552
2793+ 6BDA 60               ld   h, b
2794+ 6BDB 69               ld   l, c
2795+ 6BDC 01 00 A4         ld   bc, -23552
2796+ 6BDF 09               add  hl, bc                ; HL = AttrOffset
2797+ 6BE0
2798+ 6BE0                  ; Col = AttrOffset & 31
2799+ 6BE0 7D               ld   a, l
2800+ 6BE1 E6 1F            and  31

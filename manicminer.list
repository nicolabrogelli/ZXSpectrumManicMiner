 560+ 7F9E 3E 01            ld   a, 1                      ; Cambia direzione a Up
 561+ 7FA0 DD 77 06         ld   (ix+6), a
 562+ 7FA3 C3 A6 7F         jp   .next
 563+ 7FA6
 564+ 7FA6              .next:
 565+ 7FA6 11 0B 00         ld   de, 11
 566+ 7FA9 DD 19            add  ix, de
 567+ 7FAB 05               dec  b

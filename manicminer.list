  52+ 7D41 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D45 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D49 DD 19            add  ix, de
  55+ 7D4B 10 F4            djnz .init_old_pos
  56+ 7D4D
  57+ 7D4D                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D4D DD 21 CE 7C      ld   ix, ActiveEnemies
  59+ 7D51 2A 89 99         ld   hl, (room_ptr)
  60+ 7D54 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D57 19               add  hl, de
  62+ 7D58
  63+ 7D58 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D5A              .load_h_loop:
  65+ 7D5A 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D5B FE FF            cp   $FF
  67+ 7D5D 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D5F B7               or   a
  69+ 7D60 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D62
  71+ 7D62                  ; Slot attivo
  72+ 7D62 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D66 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D69
  75+ 7D69 23               inc  hl
  76+ 7D6A 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D6B 23               inc  hl
  78+ 7D6C 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D6D
  80+ 7D6D                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D6D E5               push hl
  82+ 7D6E C5               push bc
  83+ 7D6F 67               ld   h, a
  84+ 7D70 69               ld   l, c
  85+ 7D71 01 00 A4         ld   bc, -23552
  86+ 7D74 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D75
  88+ 7D75                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D75 7D               ld   a, l
  90+ 7D76 E6 1F            and  31
  91+ 7D78 87               add  a, a
  91+ 7D79 87             add a, a
  91+ 7D7A 87             add a, a
  92+ 7D7B DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D7E
  94+ 7D7E                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D7E CB 3C            srl  h
  95+ 7D80 CB 1D          rr l
  96+ 7D82 CB 3C            srl  h
  96+ 7D84 CB 1D          rr l
  97+ 7D86 CB 3C            srl  h
  97+ 7D88 CB 1D          rr l
  98+ 7D8A CB 3C            srl  h
  98+ 7D8C CB 1D          rr l
  99+ 7D8E CB 3C            srl  h
  99+ 7D90 CB 1D          rr l
 100+ 7D92 7D               ld   a, l
 101+ 7D93 87               add  a, a
 101+ 7D94 87             add a, a
 101+ 7D95 87             add a, a
 102+ 7D96 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D99 C1               pop  bc
 104+ 7D9A E1               pop  hl
 105+ 7D9B
 106+ 7D9B 23               inc  hl
 107+ 7D9C 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D9D DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7DA1
 110+ 7DA1 23               inc  hl
 111+ 7DA2 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7DA3 E6 01            and  1
 113+ 7DA5 28 04            jr   z, .h_dir_right
 114+ 7DA7 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DA9 18 02            jr   .set_h_dir
 116+ 7DAB              .h_dir_right:
 117+ 7DAB 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DAD              .set_h_dir:
 119+ 7DAD DD 77 06         ld   (ix+6), a                 ; Direction

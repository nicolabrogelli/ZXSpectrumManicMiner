1241+ 7A63              ; -------------------------------------------------------------------
1242+ 7A63              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1243+ 7A63              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1244+ 7A63              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1245+ 7A63              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1246+ 7A63              ; -------------------------------------------------------------------
1247+ 7A63              UnpackRoomLayout:
1248+ 7A63 E5               push hl
1249+ 7A64 D5               push de
1250+ 7A65 C5               push bc
1251+ 7A66 DD E5            push ix
1252+ 7A68
1253+ 7A68 DD 2A 4B EF      ld   ix, (room_ptr)
1254+ 7A6C 11 20 02         ld   de, OFFSET_TILES
1255+ 7A6F DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1256+ 7A71
1257+ 7A71 2A 4B EF         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1258+ 7A74 11 F0 EC         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1259+ 7A77 01 00 02         ld   bc, 512               ; 512 celle
1260+ 7A7A
1261+ 7A7A              .byte_loop:
1262+ 7A7A 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1263+ 7A7B 23               inc  hl
1264+ 7A7C
1265+ 7A7C                  ; Confronta con le 8 definizioni di tile:
1266+ 7A7C DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1267+ 7A7F 28 23            jr   z, .is_bg
1268+ 7A81 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1269+ 7A84 28 29            jr   z, .is_wall
1270+ 7A86 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1271+ 7A89 28 1C            jr   z, .is_floor
1272+ 7A8B DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1273+ 7A8E 28 1B            jr   z, .is_crumbling
1274+ 7A90 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1275+ 7A93 28 1E            jr   z, .is_conveyor
1276+ 7A95 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1277+ 7A98 28 1D            jr   z, .is_nasty1
1278+ 7A9A DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1279+ 7A9D 28 1C            jr   z, .is_nasty2
1280+ 7A9F DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1281+ 7AA2 28 1B            jr   z, .is_extra

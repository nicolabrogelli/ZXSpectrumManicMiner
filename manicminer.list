   8+ 83C7              ; Audio_UpdateJumpSound
   9+ 83C7              ;
  10+ 83C7              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 83C7              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 83C7              ; -------------------------------------------------------------------
  13+ 83C7              Audio_UpdateJumpSound:
  14+ 83C7 F5               push af
  15+ 83C8 C5               push bc
  16+ 83C9 D5               push de
  17+ 83CA E5               push hl
  18+ 83CB
  19+ 83CB                  ; Controlla se il suono è attivo (note < 18)
  20+ 83CB 3A EB C0         ld   a, (Audio_jump_sound_note)
  21+ 83CE FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 83D0 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 83D2
  24+ 83D2                  ; Carica la nota corrente da suonare
  25+ 83D2 5F               ld   e, a
  26+ 83D3 16 00            ld   d, 0
  27+ 83D5 21 01 84         ld   hl, Audio_JumpSoundDelays
  28+ 83D8 19               add  hl, de
  29+ 83D9 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 83DA 57               ld   d, a                      ; D = delay della nota
  31+ 83DB
  32+ 83DB                  ; Suona la nota: 15 cicli
  33+ 83DB 06 0F            ld   b, 15
  34+ 83DD              .note_loop:
  35+ 83DD                  ; Speaker ON
  36+ 83DD 3A DB BA         ld   a, (room_border_color)
  37+ 83E0 F6 10            or   $10
  38+ 83E2 D3 FE            out  ($fe), a
  39+ 83E4 4A               ld   c, d
  40+ 83E5              .d1:
  41+ 83E5 0D               dec  c
  42+ 83E6 20 FD            jr   nz, .d1
  43+ 83E8
  44+ 83E8                  ; Speaker OFF
  45+ 83E8 3A DB BA         ld   a, (room_border_color)
  46+ 83EB E6 EF            and  $ef
  47+ 83ED D3 FE            out  ($fe), a
  48+ 83EF 4A               ld   c, d
  49+ 83F0              .d2:
  50+ 83F0 0D               dec  c
  51+ 83F1 20 FD            jr   nz, .d2
  52+ 83F3
  53+ 83F3 10 E8            djnz .note_loop
  54+ 83F5
  55+ 83F5                  ; Passa alla nota successiva
  56+ 83F5 3A EB C0         ld   a, (Audio_jump_sound_note)
  57+ 83F8 3C               inc  a
  58+ 83F9 32 EB C0         ld   (Audio_jump_sound_note), a

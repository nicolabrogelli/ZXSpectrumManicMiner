# file opened: macro.asm
   1+ 5DAD              ; Macro per inserire un oggetto calcolando l'ID della stanza a tempo di compilazione dall'offset in RoomsListTable
   2+ 5DAD                  MACRO ITEM room_sublabel, x, y, color, state
   3+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2, x, y, color, state
   4+ 5DAD                  ENDM
   5+ 5DAD
   6+ 5DAD
   7+ 5DAD                  MACRO ROOM room_sublabel
   8+ 5DAD ~                    db (room_sublabel - RoomsListTable) / 2
   9+ 5DAD                  ENDM
# file closed: macro.asm
  15  5DAD                  include "interrupts.asm"
# file opened: interrupts.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; interrupts.asm
   3+ 5DAD              ;===========================================================================
   4+ 5DAD
   5+ 5DAD              ; -------------------------------------------------------------------
   6+ 5DAD              ; Setup interrupt IM2
   7+ 5DAD              ; -------------------------------------------------------------------
   8+ 5DAD              SetupIM2:
   9+ 5DAD F3               di
  10+ 5DAE 11 00 FE         ld de,IM2_TABLE
  11+ 5DB1 21 FD FD         ld hl,IM2_VECTOR
  12+ 5DB4 7A               ld a,d
  13+ 5DB5 ED 47            ld i,a
  14+ 5DB7 7D               ld a,l
  15+ 5DB8              .fill_loop:
  16+ 5DB8 12               ld (de),a
  17+ 5DB9 1C               inc e
  18+ 5DBA C2 B8 5D         jp nz,.fill_loop
  19+ 5DBD 14               inc d
  20+ 5DBE 12               ld (de),a
  21+ 5DBF 36 C3            ld (hl),$C3
  22+ 5DC1 2C               inc l

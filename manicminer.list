1106+ 74A3 30 1F            jr   nc, .not_wall
1107+ 74A5
1108+ 74A5                  ; 2. Calcola riga di layout: r = Y / 8
1109+ 74A5 CB 3F            srl  a
1110+ 74A7 CB 3F            srl  a
1111+ 74A9 CB 3F            srl  a                 ; A = r (0..15)
1112+ 74AB
1113+ 74AB                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1114+ 74AB 5F               ld   e, a              ; E = r (Row)
1115+ 74AC 79               ld   a, c
1116+ 74AD CB 3F            srl  a
1117+ 74AF CB 3F            srl  a

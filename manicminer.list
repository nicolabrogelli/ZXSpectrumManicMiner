 831  8786
 832  8786                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  8786 3A 92 AD         ld   a, (conveyor_row)
 834  8789 87               add  a, a                  ; *2
 835  878A 87               add  a, a                  ; *4
 836  878B 87               add  a, a                  ; *8
 837  878C 5F               ld   e, a                  ; E = ConveyorTop
 838  878D C6 07            add  a, 7
 839  878F 57               ld   d, a                  ; D = ConveyorBottom
 840  8790
 841  8790                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  8790 78               ld   a, b                  ; WillyTop
 843  8791 BA               cp   d
 844  8792 28 04            jr   z, .y_overlap
 845  8794 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  8796 18 32            jr   .no_conv_collision
 847  8798

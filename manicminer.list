 580+ 6023              .draw_body:
 581+ 6023 ED 4B 94 8E      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 582+ 6027 78               ld   a, b
 583+ 6028 C6 08            add  a, 8
 584+ 602A 47               ld   b, a              ; B = PlayerY + 8
 585+ 602B CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna corpo

 907+ 617D 5F               ld   e, a
 908+ 617E 78               ld   a, b
 909+ 617F 93               sub  e
 910+ 6180 FE 02            cp   2
 911+ 6182 38 0D            jr   c, .not_empty         ; Se DeltaRow < 2 E DeltaCol < 2 -> È nel portale!
 912+ 6184
 913+ 6184              .check_layout_tile:
 914+ 6184                  ; 4. Controlla il tipo di tile in unpacked_layout
 915+ 6184 7C               ld   a, h                  ; A = Row
 916+ 6185 48               ld   c, b                  ; C = Col
 917+ 6186 CD 25 7A         call GetCellFromUnpacked   ; A = tile index (0..7)
 918+ 6189 B7               or   a
 919+ 618A 20 05            jr   nz, .not_empty        ; Se != 0, contiene un tile (Floor, Wall, Crumbling, Conveyor, Nasty...)

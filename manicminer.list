 721+ 60DB C6 08            add  a, 8
 722+ 60DD 47               ld   b, a
 723+ 60DE CD 51 5F         call Gfx_ErasePixelSprite8x8    ; Cancella corpo
 724+ 60E1 ED 4B 8E 97      ld   bc, (player_drawn_pos)
 725+ 60E5 CD 75 6B         call Gfx_RestoreEnemyColorAttributes ; Ripristina sfondo
 726+ 60E8
 727+ 60E8              .redraw_overlay_only:
 728+ 60E8                  ; Durante il timer di sicurezza, fa lampeggiare lo sprite

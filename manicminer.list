 172+ 7E35 69               ld   l, c
 173+ 7E36 01 00 A4         ld   bc, -23552
 174+ 7E39 09               add  hl, bc                    ; HL = AttrOffset
 175+ 7E3A
 176+ 7E3A                  ; Col = Offset & 31
 177+ 7E3A 7D               ld   a, l
 178+ 7E3B E6 1F            and  31
 179+ 7E3D 4F               ld   c, a                      ; C = Col (0..31)
 180+ 7E3E
 181+ 7E3E                  ; Row = Offset / 32
 182+ 7E3E CB 3C            srl  h
 182+ 7E40 CB 1D          rr l
 183+ 7E42 CB 3C            srl  h
 183+ 7E44 CB 1D          rr l
 184+ 7E46 CB 3C            srl  h
 184+ 7E48 CB 1D          rr l
 185+ 7E4A CB 3C            srl  h
 185+ 7E4C CB 1D          rr l
 186+ 7E4E CB 3C            srl  h

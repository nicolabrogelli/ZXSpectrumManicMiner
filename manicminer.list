  40+ 7D3F                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D3F 21 E2 7C         ld   hl, ActiveEnemies
  42+ 7D42 11 E3 7C         ld   de, ActiveEnemies + 1
  43+ 7D45 36 00            ld   (hl), 0
  44+ 7D47 01 57 00         ld   bc, 87
  45+ 7D4A ED B0            ldir
  46+ 7D4C
  47+ 7D4C                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D4C DD 21 E2 7C      ld   ix, ActiveEnemies
  49+ 7D50 06 08            ld   b, 8
  50+ 7D52 11 0B 00         ld   de, 11
  51+ 7D55              .init_old_pos:
  52+ 7D55 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D59 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D5D DD 19            add  ix, de
  55+ 7D5F 10 F4            djnz .init_old_pos
  56+ 7D61
  57+ 7D61                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D61 DD 21 E2 7C      ld   ix, ActiveEnemies
  59+ 7D65 2A B3 A1         ld   hl, (room_ptr)
  60+ 7D68 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D6B 19               add  hl, de
  62+ 7D6C
  63+ 7D6C 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D6E              .load_h_loop:
  65+ 7D6E 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D6F FE FF            cp   $FF
  67+ 7D71 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D73 B7               or   a
  69+ 7D74 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D76
  71+ 7D76                  ; Slot attivo
  72+ 7D76 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D7A DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D7D
  75+ 7D7D 23               inc  hl
  76+ 7D7E 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D7F 23               inc  hl
  78+ 7D80 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D81
  80+ 7D81                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D81 E5               push hl
  82+ 7D82 C5               push bc
  83+ 7D83 67               ld   h, a
  84+ 7D84 69               ld   l, c
  85+ 7D85 01 00 A4         ld   bc, -23552
  86+ 7D88 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D89
  88+ 7D89                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D89 7D               ld   a, l
  90+ 7D8A E6 1F            and  31
  91+ 7D8C 87               add  a, a
  91+ 7D8D 87             add a, a
  91+ 7D8E 87             add a, a
  92+ 7D8F DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D92
  94+ 7D92                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D92 CB 3C            srl  h
  95+ 7D94 CB 1D          rr l
  96+ 7D96 CB 3C            srl  h
  96+ 7D98 CB 1D          rr l
  97+ 7D9A CB 3C            srl  h
  97+ 7D9C CB 1D          rr l
  98+ 7D9E CB 3C            srl  h
  98+ 7DA0 CB 1D          rr l
  99+ 7DA2 CB 3C            srl  h
  99+ 7DA4 CB 1D          rr l
 100+ 7DA6 7D               ld   a, l
 101+ 7DA7 87               add  a, a
 101+ 7DA8 87             add a, a
 101+ 7DA9 87             add a, a
 102+ 7DAA DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7DAD C1               pop  bc
 104+ 7DAE E1               pop  hl
 105+ 7DAF
 106+ 7DAF 23               inc  hl
 107+ 7DB0 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7DB1 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7DB5
 110+ 7DB5 23               inc  hl
 111+ 7DB6 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7DB7 E6 01            and  1
 113+ 7DB9 28 04            jr   z, .h_dir_right
 114+ 7DBB 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DBD 18 02            jr   .set_h_dir
 116+ 7DBF              .h_dir_right:
 117+ 7DBF 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DC1              .set_h_dir:
 119+ 7DC1 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7DC4
 121+ 7DC4 23               inc  hl
 122+ 7DC5 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DC6 E6 1F            and  31
 124+ 7DC8 87               add  a, a
 124+ 7DC9 87             add a, a
 124+ 7DCA 87             add a, a
 125+ 7DCB DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DCE
 127+ 7DCE 23               inc  hl
 128+ 7DCF 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DD0 E6 1F            and  31
 130+ 7DD2 87               add  a, a
 130+ 7DD3 87             add a, a
 130+ 7DD4 87             add a, a
 131+ 7DD5 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DD8
 133+ 7DD8 23               inc  hl                        ; Prossimo guardiano
 134+ 7DD9 11 0B 00         ld   de, 11
 135+ 7DDC DD 19            add  ix, de
 136+ 7DDE 10 8E            djnz .load_h_loop

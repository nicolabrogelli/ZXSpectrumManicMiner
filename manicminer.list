 414+ 85EF              ; CheckWillyItemCollision
 415+ 85EF              ;
 416+ 85EF              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 85EF              ; Input:
 418+ 85EF              ;   A = Item Col (0..31)
 419+ 85EF              ;   H = Item Row (0..15)
 420+ 85EF              ; Output:
 421+ 85EF              ;   Carry Set = Collisione
 422+ 85EF              ;   Carry Clear = Nessuna collisione
 423+ 85EF              ; -------------------------------------------------------------------
 424+ 85EF              CheckWillyItemCollision:
 425+ 85EF C5               push bc
 426+ 85F0 D5               push de
 427+ 85F1 E5               push hl
 428+ 85F2
 429+ 85F2                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 85F2 6F               ld   l, a
 431+ 85F3 87               add  a, a                      ; *2
 432+ 85F4 87               add  a, a                      ; *4
 433+ 85F5 87               add  a, a                      ; *8

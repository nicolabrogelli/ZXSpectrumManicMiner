 886  87A8 BA               cp   d
 887  87A9 28 04            jr   z, .x_overlap
 888  87AB 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 889  87AD 18 0E            jr   .no_conv_collision
 890  87AF

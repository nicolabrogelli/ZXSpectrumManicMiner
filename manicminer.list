1053+ 7817              ; -------------------------------------------------------------------
1054+ 7817              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 7817              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 7817              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 7817              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 7817              ; -------------------------------------------------------------------
1059+ 7817              UnpackRoomLayout:
1060+ 7817 E5               push hl
1061+ 7818 D5               push de
1062+ 7819 C5               push bc
1063+ 781A DD E5            push ix
1064+ 781C
1065+ 781C DD 2A 1E E4      ld   ix, (room_ptr)
1066+ 7820 11 20 02         ld   de, OFFSET_TILES
1067+ 7823 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 7825
1069+ 7825 2A 1E E4         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 7828 11 C3 E1         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 782B 01 00 02         ld   bc, 512               ; 512 celle
1072+ 782E
1073+ 782E              .byte_loop:
1074+ 782E 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 782F 23               inc  hl
1076+ 7830
1077+ 7830                  ; Confronta con le 8 definizioni di tile:
1078+ 7830 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7833 28 23            jr   z, .is_bg
1080+ 7835 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 7838 28 29            jr   z, .is_wall
1082+ 783A DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 783D 28 1C            jr   z, .is_floor
1084+ 783F DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7842 28 1B            jr   z, .is_crumbling
1086+ 7844 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 7847 28 1E            jr   z, .is_conveyor
1088+ 7849 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 784C 28 1D            jr   z, .is_nasty1
1090+ 784E DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 7851 28 1C            jr   z, .is_nasty2
1092+ 7853 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 7856 28 1B            jr   z, .is_extra
1094+ 7858
1095+ 7858              .is_bg:
1096+ 7858                  ; Default: Tile 0 (Background)
1097+ 7858 AF               xor  a
1098+ 7859 18 1A            jr   .store_cell
1099+ 785B
1100+ 785B              .is_floor:
1101+ 785B 3E 01            ld   a, 1
1102+ 785D 18 16            jr   .store_cell
1103+ 785F              .is_crumbling:
1104+ 785F 3E 02            ld   a, 2
1105+ 7861 18 12            jr   .store_cell
1106+ 7863              .is_wall:
1107+ 7863 3E 03            ld   a, 3
1108+ 7865 18 0E            jr   .store_cell
1109+ 7867              .is_conveyor:
1110+ 7867 3E 04            ld   a, 4
1111+ 7869 18 0A            jr   .store_cell
1112+ 786B              .is_nasty1:
1113+ 786B 3E 05            ld   a, 5
1114+ 786D 18 06            jr   .store_cell
1115+ 786F              .is_nasty2:
1116+ 786F 3E 06            ld   a, 6
1117+ 7871 18 02            jr   .store_cell
1118+ 7873              .is_extra:
1119+ 7873 3E 07            ld   a, 7
1120+ 7875
1121+ 7875              .store_cell:
1122+ 7875 12               ld   (de), a
1123+ 7876 13               inc  de
1124+ 7877 0B               dec  bc
1125+ 7878 78               ld   a, b
1126+ 7879 B1               or   c
1127+ 787A 20 B2            jr   nz, .byte_loop
1128+ 787C
1129+ 787C DD E1            pop  ix
1130+ 787E C1               pop  bc
1131+ 787F D1               pop  de
1132+ 7880 E1               pop  hl
1133+ 7881 C9               ret
1134+ 7882
1135+ 7882              ; -------------------------------------------------------------------
1136+ 7882              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7882              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7882              ; Output: A = tipo di cella (0..3)
1139+ 7882              ; Preserva tutti gli altri registri.
1140+ 7882              ; -------------------------------------------------------------------
1141+ 7882              GetCellFromUnpacked:
1142+ 7882 E5               push hl
1143+ 7883 D5               push de
1144+ 7884
1145+ 7884 6F               ld   l, a
1146+ 7885 26 00            ld   h, 0
1147+ 7887 29               add  hl, hl
1148+ 7888 29               add  hl, hl
1149+ 7889 29               add  hl, hl
1150+ 788A 29               add  hl, hl
1151+ 788B 29               add  hl, hl            ; HL = Row * 32
1152+ 788C 59               ld   e, c
1153+ 788D 16 00            ld   d, 0
1154+ 788F 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 7890 11 C3 E1         ld   de, unpacked_layout
1156+ 7893 19               add  hl, de
1157+ 7894 7E               ld   a, (hl)           ; A = cell type
1158+ 7895
1159+ 7895 D1               pop  de
1160+ 7896 E1               pop  hl
1161+ 7897 C9               ret

1097+ 8344 0D               dec  c
1098+ 8345 20 FB            jr   nz, .shift_right_d_only
1099+ 8347 7A               ld   a, d                      ; A = fetta guardiano allineata
1100+ 8348
1101+ 8348              .test_willy_line:
1102+ 8348                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
1103+ 8348 B7               or   a
1104+ 8349 28 21            jr   z, .next_scanline
1105+ 834B

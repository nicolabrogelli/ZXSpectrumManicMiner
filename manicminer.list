 725  8BFC              ; -------------------------------------------------------------------
 726  8BFC              ; CheckWillyConveyorCollision
 727  8BFC              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8BFC              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8BFC              ; -------------------------------------------------------------------
 730  8BFC              CheckWillyConveyorCollision:
 731  8BFC C5               push bc
 732  8BFD D5               push de
 733  8BFE E5               push hl
 734  8BFF
 735  8BFF                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8BFF CD 5F 78         call CheckWillyOnConveyor
 737  8C02 38 49            jr   c, .collision_detected
 738  8C04
 739  8C04                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8C04 3A 19 EE         ld   a, (conveyor_len)
 741  8C07 B7               or   a
 742  8C08 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8C0A
 744  8C0A                  ; B = WillyY, C = WillyX
 745  8C0A ED 4B F1 EA      ld   bc, (PlayerPos)
 746  8C0E
 747  8C0E                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8C0E 3A 1A EE         ld   a, (conveyor_row)
 749  8C11 87               add  a, a                  ; *2
 750  8C12 87               add  a, a                  ; *4
 751  8C13 87               add  a, a                  ; *8
 752  8C14 5F               ld   e, a                  ; E = ConveyorTop
 753  8C15 C6 07            add  a, 7
 754  8C17 57               ld   d, a                  ; D = ConveyorBottom
 755  8C18
 756  8C18                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8C18 78               ld   a, b                  ; WillyTop
 758  8C19 BA               cp   d
 759  8C1A 28 04            jr   z, .y_overlap
 760  8C1C 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8C1E 18 32            jr   .no_conv_collision
 762  8C20
 763  8C20              .y_overlap:
 764  8C20 C6 0F            add  a, 15                 ; WillyBottom
 765  8C22 BB               cp   e
 766  8C23 28 04            jr   z, .x_check
 767  8C25 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8C27 18 29            jr   .no_conv_collision
 769  8C29
 770  8C29              .x_check:
 771  8C29                  ; ConveyorLeft = conveyor_col * 8
 772  8C29 3A 1B EE         ld   a, (conveyor_col)
 773  8C2C 87               add  a, a                  ; *2
 774  8C2D 87               add  a, a                  ; *4
 775  8C2E 87               add  a, a                  ; *8
 776  8C2F 5F               ld   e, a                  ; E = ConveyorLeft
 777  8C30
 778  8C30                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 779  8C30 21 19 EE         ld   hl, conveyor_len
 780  8C33 3A 1B EE         ld   a, (conveyor_col)
 781  8C36 86               add  a, (hl)
 782  8C37 87               add  a, a                  ; *2
 783  8C38 87               add  a, a                  ; *4
 784  8C39 87               add  a, a                  ; *8
 785  8C3A 3D               dec  a                     ; ConveyorRight
 786  8C3B 57               ld   d, a                  ; D = ConveyorRight
 787  8C3C
 788  8C3C                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 789  8C3C 79               ld   a, c                  ; WillyLeft
 790  8C3D BA               cp   d
 791  8C3E 28 04            jr   z, .x_overlap
 792  8C40 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8C42 18 0E            jr   .no_conv_collision
 794  8C44
 795  8C44              .x_overlap:
 796  8C44 C6 0F            add  a, 15                 ; WillyRight
 797  8C46 BB               cp   e
 798  8C47 28 04            jr   z, .collision_detected
 799  8C49 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 800  8C4B 18 05            jr   .no_conv_collision
 801  8C4D
 802  8C4D              .collision_detected:
 803  8C4D E1               pop  hl
 804  8C4E D1               pop  de
 805  8C4F C1               pop  bc
 806  8C50 37               scf
 807  8C51 C9               ret
 808  8C52
 809  8C52              .no_conv_collision:
 810  8C52 E1               pop  hl
 811  8C53 D1               pop  de
 812  8C54 C1               pop  bc
 813  8C55 B7               or   a
 814  8C56 C9               ret

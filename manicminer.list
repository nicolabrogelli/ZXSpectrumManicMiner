 683+ 86FF 3A C7 EF         ld   a, (player_score + 1)
 684+ 8702 C6 01            add  a, $01
 685+ 8704 27               daa
 686+ 8705 32 C7 EF         ld   (player_score + 1), a
 687+ 8708
 688+ 8708                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 8708 3A C8 EF         ld   a, (player_score + 2)
 690+ 870B CE 00            adc  a, 0
 691+ 870D 27               daa
 692+ 870E 32 C8 EF         ld   (player_score + 2), a
 693+ 8711
 694+ 8711                  ; Controlla se player_score ha superato high_score
 695+ 8711 CD 1C 87         call Score_CheckAndUpdateHighScore
 696+ 8714
 697+ 8714                  ; Aggiorna visualizzazione a schermo

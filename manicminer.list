 104+ 7D1D E1               pop  hl
 105+ 7D1E
 106+ 7D1E 23               inc  hl
 107+ 7D1F 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D20 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D24
 110+ 7D24 23               inc  hl
 111+ 7D25 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)

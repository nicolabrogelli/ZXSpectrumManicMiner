 316+ 7D21              ; Enemy_DrawSingleSlot
 317+ 7D21              ;
 318+ 7D21              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7D21              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7D21              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7D21              ; -------------------------------------------------------------------
 322+ 7D21              Enemy_DrawSingleSlot:
 323+ 7D21 C5               push bc
 324+ 7D22 D5               push de
 325+ 7D23 E5               push hl
 326+ 7D24 DD E5            push ix
 327+ 7D26
 328+ 7D26                  ; 1. Determina il frame di animazione (0..7)
 329+ 7D26                  ; Nei dati di Manic Miner:
 330+ 7D26                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7D26                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7D26 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7D29 E6 03            and  3
 334+ 7D2B 47               ld   b, a                      ; B = Anim subframe

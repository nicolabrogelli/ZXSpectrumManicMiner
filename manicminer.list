 293+ 7AD8 DD 7E 02         ld   a, (ix+2)
 294+ 7ADB DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7ADE DD 7E 03         ld   a, (ix+3)
 296+ 7AE1 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7AE4
 298+ 7AE4 C1               pop  bc
 299+ 7AE5
 300+ 7AE5              .next_draw:
 301+ 7AE5 11 0B 00         ld   de, 11
 302+ 7AE8 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7AEA 05               dec  b
 304+ 7AEB 20 BA            jr   nz, .draw_loop

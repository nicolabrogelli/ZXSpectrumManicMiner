 637  8534              ; -------------------------------------------------------------------
 638  8534              ; CheckPortalTransition
 639  8534              ; Verifica le condizioni per accedere alla stanza successiva:
 640  8534              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 641  8534              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 642  8534              ;
 643  8534              ; Output:
 644  8534              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 645  8534              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 646  8534              ; -------------------------------------------------------------------
 647  8534              CheckPortalTransition:
 648  8534 C5               push bc
 649  8535 D5               push de
 650  8536 E5               push hl
 651  8537
 652  8537                  ; 1. Tutti gli item della stanza sono stati raccolti?
 653  8537 CD C5 85         call CheckAllItemsCollected
 654  853A 30 4D            jr   nc, .no_transition
 655  853C
 656  853C                  ; 2. Willy collide con il portale (16x16 pixel)?
 657  853C                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 658  853C                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 659  853C 2A 57 98         ld   hl, (room_ptr)
 660  853F 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 661  8542 19               add  hl, de
 662  8543 4E               ld   c, (hl)
 663  8544 23               inc  hl
 664  8545 46               ld   b, (hl)                   ; BC = AttrAddr
 665  8546
 666  8546                  ; Offset = BC - 23552
 667  8546 60               ld   h, b
 668  8547 69               ld   l, c
 669  8548 01 00 A4         ld   bc, -23552
 670  854B 09               add  hl, bc
 671  854C
 672  854C                  ; PortalX = (Offset & 31) * 8
 673  854C 7D               ld   a, l
 674  854D E6 1F            and  31
 675  854F 87               add  a, a
 675  8550 87             add a, a
 675  8551 87             add a, a
 676  8552 5F               ld   e, a                      ; E = PortalX (0..248)

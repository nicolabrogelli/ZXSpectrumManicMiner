 358+ 7E27              ; RestoreBackgroundCell
 359+ 7E27              ;
 360+ 7E27              ; Ripristina il tile originale presente nella mappa della stanza.
 361+ 7E27              ; Chiamata quando un item viene raccolto.
 362+ 7E27              ;
 363+ 7E27              ; Input:
 364+ 7E27              ;   B = Row (0..15)
 365+ 7E27              ;   C = Col (0..31)
 366+ 7E27              ; -------------------------------------------------------------------
 367+ 7E27              RestoreBackgroundCell:
 368+ 7E27 FD E5            push iy
 369+ 7E29 C5               push bc
 370+ 7E2A D5               push de
 371+ 7E2B E5               push hl

  88+ 79B6                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 79B6 7D               ld   a, l
  90+ 79B7 E6 1F            and  31
  91+ 79B9 87               add  a, a
  91+ 79BA 87             add a, a
  91+ 79BB 87             add a, a
  92+ 79BC DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 79BF
  94+ 79BF                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 79BF CB 3C            srl  h
  95+ 79C1 CB 1D          rr l
  96+ 79C3 CB 3C            srl  h
  96+ 79C5 CB 1D          rr l
  97+ 79C7 CB 3C            srl  h
  97+ 79C9 CB 1D          rr l
  98+ 79CB CB 3C            srl  h
  98+ 79CD CB 1D          rr l
  99+ 79CF CB 3C            srl  h
  99+ 79D1 CB 1D          rr l
 100+ 79D3 7D               ld   a, l
 101+ 79D4 87               add  a, a
 101+ 79D5 87             add a, a
 101+ 79D6 87             add a, a
 102+ 79D7 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 79DA C1               pop  bc
 104+ 79DB E1               pop  hl
 105+ 79DC
 106+ 79DC 23               inc  hl
 107+ 79DD 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 79DE DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 79E2
 110+ 79E2 23               inc  hl
 111+ 79E3 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 79E4 E6 01            and  1
 113+ 79E6 28 04            jr   z, .h_dir_right
 114+ 79E8 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 79EA 18 02            jr   .set_h_dir
 116+ 79EC              .h_dir_right:
 117+ 79EC 3E 02            ld   a, 2                      ; 2 = Destra

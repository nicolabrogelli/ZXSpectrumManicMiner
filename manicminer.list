 408+ 828F              ; CheckWillyItemCollision
 409+ 828F              ;
 410+ 828F              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 828F              ; Input:
 412+ 828F              ;   A = Item Col (0..31)
 413+ 828F              ;   H = Item Row (0..15)
 414+ 828F              ; Output:
 415+ 828F              ;   Carry Set = Collisione
 416+ 828F              ;   Carry Clear = Nessuna collisione
 417+ 828F              ; -------------------------------------------------------------------
 418+ 828F              CheckWillyItemCollision:
 419+ 828F C5               push bc
 420+ 8290 D5               push de
 421+ 8291 E5               push hl
 422+ 8292
 423+ 8292                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 8292 6F               ld   l, a
 425+ 8293 87               add  a, a                      ; *2
 426+ 8294 87               add  a, a                      ; *4
 427+ 8295 87               add  a, a                      ; *8
 428+ 8296 5F               ld   e, a                      ; E = ItemLeft
 429+ 8297 C6 07            add  a, 7
 430+ 8299 57               ld   d, a                      ; D = ItemRight
 431+ 829A
 432+ 829A ED 4B CF BA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 829E
 434+ 829E                  ; WillyLeft <= ItemRight
 435+ 829E 79               ld   a, c                      ; A = WillyX
 436+ 829F BA               cp   d                         ; D = ItemRight
 437+ 82A0 28 04            jr   z, .x_ok
 438+ 82A2 38 02            jr   c, .x_ok
 439+ 82A4 18 31            jr   .no_collision
 440+ 82A6
 441+ 82A6              .x_ok:
 442+ 82A6                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 82A6 BB               cp   e                         ; E = ItemLeft
 444+ 82A7 28 0B            jr   z, .y_check
 445+ 82A9 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 82AB
 447+ 82AB                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 82AB C6 0F            add  a, 15
 449+ 82AD BB               cp   e
 450+ 82AE 28 04            jr   z, .y_check
 451+ 82B0 30 02            jr   nc, .y_check
 452+ 82B2 18 23            jr   .no_collision

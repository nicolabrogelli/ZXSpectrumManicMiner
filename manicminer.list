 414+ 87BE              ; CheckWillyItemCollision
 415+ 87BE              ;
 416+ 87BE              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 87BE              ; Input:
 418+ 87BE              ;   A = Item Col (0..31)
 419+ 87BE              ;   H = Item Row (0..15)
 420+ 87BE              ; Output:
 421+ 87BE              ;   Carry Set = Collisione
 422+ 87BE              ;   Carry Clear = Nessuna collisione
 423+ 87BE              ; -------------------------------------------------------------------
 424+ 87BE              CheckWillyItemCollision:
 425+ 87BE C5               push bc
 426+ 87BF D5               push de
 427+ 87C0 E5               push hl
 428+ 87C1
 429+ 87C1                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 87C1 6F               ld   l, a
 431+ 87C2 87               add  a, a                      ; *2
 432+ 87C3 87               add  a, a                      ; *4
 433+ 87C4 87               add  a, a                      ; *8
 434+ 87C5 5F               ld   e, a                      ; E = ItemLeft
 435+ 87C6 C6 07            add  a, 7
 436+ 87C8 57               ld   d, a                      ; D = ItemRight
 437+ 87C9
 438+ 87C9 ED 4B 72 EC      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 87CD
 440+ 87CD                  ; WillyLeft <= ItemRight
 441+ 87CD 79               ld   a, c                      ; A = WillyX
 442+ 87CE BA               cp   d                         ; D = ItemRight
 443+ 87CF 28 04            jr   z, .x_ok
 444+ 87D1 38 02            jr   c, .x_ok
 445+ 87D3 18 31            jr   .no_collision
 446+ 87D5
 447+ 87D5              .x_ok:
 448+ 87D5                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 87D5 BB               cp   e                         ; E = ItemLeft
 450+ 87D6 28 0B            jr   z, .y_check
 451+ 87D8 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 87DA
 453+ 87DA                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 87DA C6 07            add  a, 7
 455+ 87DC BB               cp   e
 456+ 87DD 28 04            jr   z, .y_check
 457+ 87DF 30 02            jr   nc, .y_check
 458+ 87E1 18 23            jr   .no_collision
 459+ 87E3
 460+ 87E3              .y_check:
 461+ 87E3                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 87E3 7C               ld   a, h                      ; H = Item Row
 463+ 87E4 87               add  a, a                      ; *2
 464+ 87E5 87               add  a, a                      ; *4
 465+ 87E6 87               add  a, a                      ; *8
 466+ 87E7 5F               ld   e, a                      ; E = ItemTop
 467+ 87E8 C6 07            add  a, 7
 468+ 87EA 57               ld   d, a                      ; D = ItemBottom
 469+ 87EB
 470+ 87EB                  ; WillyTop <= ItemBottom
 471+ 87EB 78               ld   a, b                      ; A = WillyY
 472+ 87EC BA               cp   d                         ; D = ItemBottom
 473+ 87ED 28 04            jr   z, .y_ok
 474+ 87EF 38 02            jr   c, .y_ok
 475+ 87F1 18 13            jr   .no_collision
 476+ 87F3
 477+ 87F3              .y_ok:
 478+ 87F3                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 87F3 BB               cp   e                         ; E = ItemTop
 480+ 87F4 28 0B            jr   z, .collision
 481+ 87F6 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 87F8
 483+ 87F8                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 87F8 C6 0F            add  a, 15
 485+ 87FA BB               cp   e
 486+ 87FB 28 04            jr   z, .collision
 487+ 87FD 30 02            jr   nc, .collision
 488+ 87FF 18 05            jr   .no_collision

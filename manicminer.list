  88+ E7E5              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ E7E5 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ E7E8 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ E7EB 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ E7EC 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ E7ED 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ E7EE 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ E7EF 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ E7F0 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ E7F1

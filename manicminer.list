2454+ 6A9A              Gfx_DrawWillyLifeIcon:
2455+ 6A9A                  ; Input: C = Colonna (0..31), A = Colore Gfx_Ink (1..7 / bright color)
2456+ 6A9A                  ; D = Colore, E = Colonna
2457+ 6A9A 57               ld   d, a              ; D = Colore

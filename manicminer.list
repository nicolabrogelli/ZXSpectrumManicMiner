 202+ 7D9D              ; -------------------------------------------------------------------
 203+ 7D9D              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 204+ 7D9D              ; -------------------------------------------------------------------
 205+ 7D9D              CheckEnemyWillyOverlap:
 206+ 7D9D 3A D2 B6         ld   a, (player_drawn_pos+1)
 207+ 7DA0 FE FF            cp   $FF
 208+ 7DA2 C8               ret  z                  ; Se Willy non è disegnato, esci
 209+ 7DA3
 210+ 7DA3                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 211+ 7DA3 3A D1 B6         ld   a, (player_drawn_pos)
 212+ 7DA6 E6 F8            and  $F8
 213+ 7DA8 5F               ld   e, a               ; E = WillyX & $F8
 214+ 7DA9 79               ld   a, c
 215+ 7DAA E6 F8            and  $F8                ; A = EnemyX & $F8
 216+ 7DAC 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 217+ 7DAD C6 10            add  a, 16
 218+ 7DAF FE 19            cp   25
 219+ 7DB1 D0               ret  nc                 ; Fuori portata X
 220+ 7DB2
 221+ 7DB2                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 222+ 7DB2 3A D2 B6         ld   a, (player_drawn_pos+1) ; A = WillyY
 223+ 7DB5 90               sub  b                  ; A = WillyY - EnemyY
 224+ 7DB6 C6 0F            add  a, 15
 225+ 7DB8 FE 1F            cp   31
 226+ 7DBA D0               ret  nc                 ; Fuori portata Y
 227+ 7DBB
 228+ 7DBB                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 229+ 7DBB 3E 01            ld   a, 1
 230+ 7DBD 32 D7 B6         ld   (willy_needs_redraw), a
 231+ 7DC0 C9               ret
 232+ 7DC1
 233+ 7DC1              ; -------------------------------------------------------------------
 234+ 7DC1              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 235+ 7DC1              ; -------------------------------------------------------------------
 236+ 7DC1              Enemy_EraseRoom:
 237+ 7DC1              Enemy_DrawRoom:
 238+ 7DC1              Enemy_RenderRoom:
 239+ 7DC1 E5               push hl
 240+ 7DC2 D5               push de
 241+ 7DC3 C5               push bc
 242+ 7DC4 DD E5            push ix
 243+ 7DC6
 244+ 7DC6                  ; ---------------------------------------------------------------
 245+ 7DC6                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 246+ 7DC6                  ; ---------------------------------------------------------------
 247+ 7DC6 DD 21 47 7C      ld   ix, ActiveEnemies
 248+ 7DCA 06 08            ld   b, 8              ; 8 slot
 249+ 7DCC              .erase_loop:
 250+ 7DCC DD 7E 00         ld   a, (ix+0)         ; Flags
 251+ 7DCF E6 80            and  $80               ; Active?
 252+ 7DD1 28 3A            jr   z, .next_erase
 253+ 7DD3
 254+ 7DD3                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 255+ 7DD3 DD 7E 08         ld   a, (ix+8)         ; Old X
 256+ 7DD6 FE FF            cp   $FF
 257+ 7DD8 28 33            jr   z, .next_erase
 258+ 7DDA
 259+ 7DDA                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 260+ 7DDA DD 7E 08         ld   a, (ix+8)         ; Old X
 261+ 7DDD DD BE 02         cp   (ix+2)            ; Current X
 262+ 7DE0 20 0E            jr   nz, .do_erase_slot
 263+ 7DE2 DD 7E 09         ld   a, (ix+9)         ; Old Y
 264+ 7DE5 DD BE 03         cp   (ix+3)            ; Current Y
 265+ 7DE8 20 06            jr   nz, .do_erase_slot
 266+ 7DEA
 267+ 7DEA 3A D5 B6         ld   a, (enemy_was_updated)
 268+ 7DED B7               or   a
 269+ 7DEE 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 270+ 7DF0
 271+ 7DF0              .do_erase_slot:
 272+ 7DF0 C5               push bc                ; Salva contatore ciclo
 273+ 7DF1
 274+ 7DF1                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 275+ 7DF1 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 276+ 7DF4 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 277+ 7DF7 CD 9D 7D         call CheckEnemyWillyOverlap
 278+ 7DFA
 279+ 7DFA                  ; Cancella il nemico nella VECCHIA posizione
 280+ 7DFA DD 4E 08         ld   c, (ix+8)         ; C = Old X
 281+ 7DFD DD 46 09         ld   b, (ix+9)         ; B = Old Y
 282+ 7E00 CD BD 5F         call Gfx_ErasePixelSprite16x16
 283+ 7E03 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 284+ 7E06 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 285+ 7E09 CD 73 6D         call Gfx_RestoreEnemyColorAttributes
 286+ 7E0C
 287+ 7E0C C1               pop  bc
 288+ 7E0D
 289+ 7E0D              .next_erase:
 290+ 7E0D 11 0B 00         ld   de, 11
 291+ 7E10 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 292+ 7E12 05               dec  b
 293+ 7E13 20 B7            jr   nz, .erase_loop
 294+ 7E15
 295+ 7E15                  ; ---------------------------------------------------------------
 296+ 7E15                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 297+ 7E15                  ; ---------------------------------------------------------------
 298+ 7E15 DD 21 47 7C      ld   ix, ActiveEnemies
 299+ 7E19 06 08            ld   b, 8              ; 8 slot
 300+ 7E1B              .draw_loop:
 301+ 7E1B DD 7E 00         ld   a, (ix+0)         ; Flags
 302+ 7E1E E6 80            and  $80               ; Active?
 303+ 7E20 28 37            jr   z, .next_draw
 304+ 7E22
 305+ 7E22                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 306+ 7E22 DD 7E 08         ld   a, (ix+8)         ; Old X
 307+ 7E25 FE FF            cp   $FF
 308+ 7E27 28 16            jr   z, .do_draw_slot
 309+ 7E29
 310+ 7E29                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 311+ 7E29 DD 7E 08         ld   a, (ix+8)         ; Old X
 312+ 7E2C DD BE 02         cp   (ix+2)            ; Current X
 313+ 7E2F 20 0E            jr   nz, .do_draw_slot
 314+ 7E31 DD 7E 09         ld   a, (ix+9)         ; Old Y
 315+ 7E34 DD BE 03         cp   (ix+3)            ; Current Y
 316+ 7E37 20 06            jr   nz, .do_draw_slot
 317+ 7E39
 318+ 7E39 3A D5 B6         ld   a, (enemy_was_updated)
 319+ 7E3C B7               or   a
 320+ 7E3D 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 321+ 7E3F
 322+ 7E3F              .do_draw_slot:
 323+ 7E3F C5               push bc                ; Salva contatore ciclo
 324+ 7E40
 325+ 7E40                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 326+ 7E40 CD 6B 7E         call Enemy_DrawSingleSlot
 327+ 7E43
 328+ 7E43                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 329+ 7E43 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 330+ 7E46 DD 46 03         ld   b, (ix+3)         ; B = Current Y
 331+ 7E49 CD 9D 7D         call CheckEnemyWillyOverlap
 332+ 7E4C
 333+ 7E4C                  ; Salva le coordinate effettivamente disegnate
 334+ 7E4C DD 7E 02         ld   a, (ix+2)
 335+ 7E4F DD 77 08         ld   (ix+8), a         ; Old X = Current X
 336+ 7E52 DD 7E 03         ld   a, (ix+3)
 337+ 7E55 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 338+ 7E58
 339+ 7E58 C1               pop  bc
 340+ 7E59
 341+ 7E59              .next_draw:
 342+ 7E59 11 0B 00         ld   de, 11
 343+ 7E5C DD 19            add  ix, de            ; Prossimo slot (11 byte)
 344+ 7E5E 05               dec  b
 345+ 7E5F 20 BA            jr   nz, .draw_loop
 346+ 7E61
 347+ 7E61 AF               xor  a
 348+ 7E62 32 D5 B6         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 349+ 7E65
 350+ 7E65 DD E1            pop  ix
 351+ 7E67 C1               pop  bc
 352+ 7E68 D1               pop  de
 353+ 7E69 E1               pop  hl

  89+ E79D 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ E7A0 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)

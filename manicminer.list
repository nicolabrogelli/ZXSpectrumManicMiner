1078+ 8332 18 14            jr   .test_willy_line
1079+ 8334
1080+ 8334              .shift_dx_gt_8:
1081+ 8334                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
1082+ 8334 D6 08            sub  8
1083+ 8336 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
1084+ 8337              .shift_left_e_only:
1085+ 8337 CB 23            sla  e
1086+ 8339 0D               dec  c
1087+ 833A 20 FB            jr   nz, .shift_left_e_only
1088+ 833C 7B               ld   a, e                      ; A = fetta guardiano allineata
1089+ 833D 18 09            jr   .test_willy_line
1090+ 833F
1091+ 833F              .shift_neg_dx:

 926  834D              ; -------------------------------------------------------------------
 927  834D              ; Time_UpdateClock
 928  834D              ; Gestisce lo scorrimento del tempo durante il gioco.
 929  834D              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 930  834D              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 931  834D              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 932  834D              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 933  834D              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 934  834D              ; sia completato, scatena immediatamente il Game Over.
 935  834D              ; -------------------------------------------------------------------
 936  834D              Time_UpdateClock:
 937  834D                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 938  834D 2A 0D 8E         ld   hl, (counter)
 939  8350 ED 5B FC 91      ld   de, (time_last_counter)
 940  8354 B7               or   a
 941  8355 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 942  8357
 943  8357                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 944  8357 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 945  835A B7               or   a
 946  835B ED 52            sbc  hl, de
 947  835D D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 948  835E
 949  835E                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 950  835E 2A FC 91         ld   hl, (time_last_counter)
 951  8361 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 952  8364 19               add  hl, de
 953  8365 22 FC 91         ld   (time_last_counter), hl
 954  8368
 955  8368                  ; Incrementa di 1 minuto il tempo di gioco
 956  8368 3A FA 91         ld   a, (time_minutes)
 957  836B 3C               inc  a
 958  836C FE 3C            cp   60
 959  836E 38 21            jr   c, .minutes_ok
 960  8370
 961  8370                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 962  8370 AF               xor  a
 963  8371 32 FA 91         ld   (time_minutes), a
 964  8374 3A F9 91         ld   a, (time_hours)
 965  8377 3C               inc  a
 966  8378 FE 0C            cp   12
 967  837A 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 968  837C FE 0D            cp   13
 969  837E 38 0E            jr   c, .hours_ok
 970  8380 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 971  8382 18 0A            jr   .hours_ok
 972  8384
 973  8384              .toggle_period:
 974  8384 F5               push af                     ; Salva A (valore 12)
 975  8385 3A FB 91         ld   a, (time_period)
 976  8388 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 977  838A 32 FB 91         ld   (time_period), a
 978  838D F1               pop  af                     ; Ripristina A = 12
 979  838E
 980  838E              .hours_ok:
 981  838E 32 F9 91         ld   (time_hours), a
 982  8391
 983  8391              .minutes_ok:
 984  8391 32 FA 91         ld   (time_minutes), a
 985  8394
 986  8394                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 987  8394 CD B4 67         call Gfx_UpdateTimeDisplay
 988  8397
 989  8397                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 990  8397 3A FE 91         ld   a, (game_objective_completed)
 991  839A B7               or   a
 992  839B C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 993  839C
 994  839C                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 995  839C 3A FB 91         ld   a, (time_period)
 996  839F B7               or   a
 997  83A0 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 998  83A1
 999  83A1 3A F9 91         ld   a, (time_hours)
1000  83A4 FE 0C            cp   12
1001  83A6 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1002  83A8 C9               ret
1003  83A9
1004  83A9              .time_limit_reached:
1005  83A9                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1006  83A9                  ; Scatena immediatamente il Game Over temporale!
1007  83A9 C3 63 80         jp   TriggerGameOver

 678  8553                  ; PortalY = (Offset / 32) * 8
 679  8553 CB 3C            srl  h
 679  8555 CB 1D          rr l
 680  8557 CB 3C            srl  h
 680  8559 CB 1D          rr l
 681  855B CB 3C            srl  h
 681  855D CB 1D          rr l
 682  855F CB 3C            srl  h

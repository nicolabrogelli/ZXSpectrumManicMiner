2497+ 6ABC ~            .not_3:
2498+ 6ABC ~                inc  a
2499+ 6ABC ~                jr   .calc_ix
2500+ 6ABC                  ELSE
2501+ 6ABC 3E 01            ld   a, 1              ; frame statico 1
2502+ 6ABE                  ENDIF

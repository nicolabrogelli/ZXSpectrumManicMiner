  84+ A45E
  85+ A45E              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ A45E 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ A461 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ A464 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ A465 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ A466 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ A467 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ A468 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ A469 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ A46A
  95+ A46A 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ A46B 00           Audio_jump_sound_timer:   db 0
  97+ A46C                  IF ENABLE_MUSIC != 0
  98+ A46C ~            Audio_music_note_idx:      db 0
  99+ A46C ~            Audio_music_frame_counter: db 1

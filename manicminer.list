 652+ 8805
 653+ 8805                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 8805 3A 41 F1         ld   a, (player_score + 2)
 655+ 8808 CE 00            adc  a, 0
 656+ 880A 27               daa
 657+ 880B 32 41 F1         ld   (player_score + 2), a
 658+ 880E
 659+ 880E                  ; Controlla se player_score ha superato high_score
 660+ 880E CD 3A 88         call Score_CheckAndUpdateHighScore
 661+ 8811

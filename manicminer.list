  29+ 7D21              ; Enemy_LoadRoom
  30+ 7D21              ;
  31+ 7D21              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7D21              ; Chiamato quando si entra in una stanza.
  33+ 7D21              ; -------------------------------------------------------------------
  34+ 7D21              Enemy_LoadRoom:
  35+ 7D21 E5               push hl
  36+ 7D22 D5               push de
  37+ 7D23 C5               push bc
  38+ 7D24 DD E5            push ix
  39+ 7D26
  40+ 7D26                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D26 21 C9 7C         ld   hl, ActiveEnemies
  42+ 7D29 11 CA 7C         ld   de, ActiveEnemies + 1
  43+ 7D2C 36 00            ld   (hl), 0
  44+ 7D2E 01 57 00         ld   bc, 87
  45+ 7D31 ED B0            ldir
  46+ 7D33
  47+ 7D33                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D33 DD 21 C9 7C      ld   ix, ActiveEnemies
  49+ 7D37 06 08            ld   b, 8
  50+ 7D39 11 0B 00         ld   de, 11
  51+ 7D3C              .init_old_pos:
  52+ 7D3C DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D40 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D44 DD 19            add  ix, de
  55+ 7D46 10 F4            djnz .init_old_pos
  56+ 7D48
  57+ 7D48                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D48 DD 21 C9 7C      ld   ix, ActiveEnemies
  59+ 7D4C 2A 80 A1         ld   hl, (room_ptr)
  60+ 7D4F 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D52 19               add  hl, de
  62+ 7D53
  63+ 7D53 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D55              .load_h_loop:
  65+ 7D55 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D56 FE FF            cp   $FF
  67+ 7D58 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D5A B7               or   a
  69+ 7D5B 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D5D
  71+ 7D5D                  ; Slot attivo
  72+ 7D5D DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D61 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D64
  75+ 7D64 23               inc  hl
  76+ 7D65 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D66 23               inc  hl
  78+ 7D67 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D68
  80+ 7D68                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D68 E5               push hl
  82+ 7D69 C5               push bc
  83+ 7D6A 67               ld   h, a
  84+ 7D6B 69               ld   l, c
  85+ 7D6C 01 00 A4         ld   bc, -23552
  86+ 7D6F 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D70
  88+ 7D70                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D70 7D               ld   a, l
  90+ 7D71 E6 1F            and  31
  91+ 7D73 87               add  a, a
  91+ 7D74 87             add a, a
  91+ 7D75 87             add a, a
  92+ 7D76 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D79
  94+ 7D79                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D79 CB 3C            srl  h
  95+ 7D7B CB 1D          rr l
  96+ 7D7D CB 3C            srl  h
  96+ 7D7F CB 1D          rr l
  97+ 7D81 CB 3C            srl  h
  97+ 7D83 CB 1D          rr l
  98+ 7D85 CB 3C            srl  h
  98+ 7D87 CB 1D          rr l
  99+ 7D89 CB 3C            srl  h
  99+ 7D8B CB 1D          rr l
 100+ 7D8D 7D               ld   a, l
 101+ 7D8E 87               add  a, a
 101+ 7D8F 87             add a, a
 101+ 7D90 87             add a, a
 102+ 7D91 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D94 C1               pop  bc
 104+ 7D95 E1               pop  hl
 105+ 7D96
 106+ 7D96 23               inc  hl
 107+ 7D97 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D98 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D9C
 110+ 7D9C 23               inc  hl
 111+ 7D9D 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D9E E6 01            and  1
 113+ 7DA0 28 04            jr   z, .h_dir_right
 114+ 7DA2 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DA4 18 02            jr   .set_h_dir
 116+ 7DA6              .h_dir_right:
 117+ 7DA6 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DA8              .set_h_dir:
 119+ 7DA8 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7DAB
 121+ 7DAB 23               inc  hl
 122+ 7DAC 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DAD E6 1F            and  31
 124+ 7DAF 87               add  a, a
 124+ 7DB0 87             add a, a
 124+ 7DB1 87             add a, a
 125+ 7DB2 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DB5
 127+ 7DB5 23               inc  hl
 128+ 7DB6 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DB7 E6 1F            and  31
 130+ 7DB9 87               add  a, a
 130+ 7DBA 87             add a, a
 130+ 7DBB 87             add a, a
 131+ 7DBC DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DBF
 133+ 7DBF 23               inc  hl                        ; Prossimo guardiano
 134+ 7DC0 11 0B 00         ld   de, 11
 135+ 7DC3 DD 19            add  ix, de
 136+ 7DC5 10 8E            djnz .load_h_loop
 137+ 7DC7
 138+ 7DC7              .done_h_guardians:
 139+ 7DC7                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DC7 2A 80 A1         ld   hl, (room_ptr)
 141+ 7DCA 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DCD 19               add  hl, de
 143+ 7DCE 7E               ld   a, (hl)
 144+ 7DCF FE FF            cp   $FF
 145+ 7DD1 28 0A            jr   z, .done_v_guardians
 146+ 7DD3 B7               or   a
 147+ 7DD4 28 07            jr   z, .done_v_guardians
 148+ 7DD6
 149+ 7DD6                  ; Slot attivo per guardiano verticale
 150+ 7DD6 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DDA DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DDD                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DDD
 154+ 7DDD              .done_v_guardians:
 155+ 7DDD DD E1            pop  ix
 156+ 7DDF C1               pop  bc
 157+ 7DE0 D1               pop  de
 158+ 7DE1 E1               pop  hl
 159+ 7DE2 C9               ret
 160+ 7DE3
 161+ 7DE3              ; -------------------------------------------------------------------
 162+ 7DE3              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DE3              ; -------------------------------------------------------------------
 164+ 7DE3              CheckEnemyWillyOverlap:
 165+ 7DE3 3A 06 A2         ld   a, (player_drawn_pos+1)
 166+ 7DE6 FE FF            cp   $FF
 167+ 7DE8 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7DE9
 169+ 7DE9                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7DE9 3A 05 A2         ld   a, (player_drawn_pos)
 171+ 7DEC E6 F8            and  $F8
 172+ 7DEE 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7DEF 79               ld   a, c
 174+ 7DF0 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7DF2 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7DF3 C6 10            add  a, 16
 177+ 7DF5 FE 19            cp   25
 178+ 7DF7 D0               ret  nc                 ; Fuori portata X
 179+ 7DF8
 180+ 7DF8                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7DF8 3A 06 A2         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7DFB 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7DFC C6 0F            add  a, 15
 184+ 7DFE FE 1F            cp   31
 185+ 7E00 D0               ret  nc                 ; Fuori portata Y
 186+ 7E01
 187+ 7E01                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7E01 3E 01            ld   a, 1
 189+ 7E03 32 0B A2         ld   (willy_needs_redraw), a
 190+ 7E06 C9               ret
 191+ 7E07
 192+ 7E07              ; -------------------------------------------------------------------
 193+ 7E07              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7E07              ; -------------------------------------------------------------------
 195+ 7E07              Enemy_EraseRoom:
 196+ 7E07              Enemy_DrawRoom:
 197+ 7E07              Enemy_RenderRoom:
 198+ 7E07 E5               push hl
 199+ 7E08 D5               push de
 200+ 7E09 C5               push bc
 201+ 7E0A DD E5            push ix
 202+ 7E0C
 203+ 7E0C                  ; ---------------------------------------------------------------
 204+ 7E0C                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7E0C                  ; ---------------------------------------------------------------
 206+ 7E0C DD 21 C9 7C      ld   ix, ActiveEnemies
 207+ 7E10 06 08            ld   b, 8              ; 8 slot
 208+ 7E12              .erase_loop:
 209+ 7E12 DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E15 E6 80            and  $80               ; Active?
 211+ 7E17 28 3A            jr   z, .next_erase
 212+ 7E19
 213+ 7E19                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E19 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E1C FE FF            cp   $FF
 216+ 7E1E 28 33            jr   z, .next_erase
 217+ 7E20
 218+ 7E20                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E20 DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E23 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E26 20 0E            jr   nz, .do_erase_slot
 222+ 7E28 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E2B DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E2E 20 06            jr   nz, .do_erase_slot
 225+ 7E30
 226+ 7E30 3A 09 A2         ld   a, (enemy_was_updated)
 227+ 7E33 B7               or   a
 228+ 7E34 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E36
 230+ 7E36              .do_erase_slot:
 231+ 7E36 C5               push bc                ; Salva contatore ciclo
 232+ 7E37
 233+ 7E37                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E37 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E3A DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E3D CD E3 7D         call CheckEnemyWillyOverlap
 237+ 7E40
 238+ 7E40                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E40 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E43 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7E46 CD E2 5F         call Gfx_ErasePixelSprite16x16
 242+ 7E49 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E4C DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E4F CD BE 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E52
 246+ 7E52 C1               pop  bc
 247+ 7E53
 248+ 7E53              .next_erase:
 249+ 7E53 11 0B 00         ld   de, 11
 250+ 7E56 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7E58 05               dec  b
 252+ 7E59 20 B7            jr   nz, .erase_loop
 253+ 7E5B
 254+ 7E5B                  ; ---------------------------------------------------------------
 255+ 7E5B                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7E5B                  ; ---------------------------------------------------------------
 257+ 7E5B DD 21 C9 7C      ld   ix, ActiveEnemies
 258+ 7E5F 06 08            ld   b, 8              ; 8 slot
 259+ 7E61              .draw_loop:
 260+ 7E61 DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7E64 E6 80            and  $80               ; Active?
 262+ 7E66 28 37            jr   z, .next_draw
 263+ 7E68
 264+ 7E68                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E68 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E6B FE FF            cp   $FF
 267+ 7E6D 28 16            jr   z, .do_draw_slot
 268+ 7E6F
 269+ 7E6F                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E6F DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E72 DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E75 20 0E            jr   nz, .do_draw_slot
 273+ 7E77 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E7A DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E7D 20 06            jr   nz, .do_draw_slot
 276+ 7E7F
 277+ 7E7F 3A 09 A2         ld   a, (enemy_was_updated)
 278+ 7E82 B7               or   a
 279+ 7E83 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7E85
 281+ 7E85              .do_draw_slot:
 282+ 7E85 C5               push bc                ; Salva contatore ciclo
 283+ 7E86
 284+ 7E86                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7E86 CD B1 7E         call Enemy_DrawSingleSlot
 286+ 7E89
 287+ 7E89                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 288+ 7E89 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 289+ 7E8C DD 46 03         ld   b, (ix+3)         ; B = Current Y
 290+ 7E8F CD E3 7D         call CheckEnemyWillyOverlap
 291+ 7E92
 292+ 7E92                  ; Salva le coordinate effettivamente disegnate
 293+ 7E92 DD 7E 02         ld   a, (ix+2)
 294+ 7E95 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7E98 DD 7E 03         ld   a, (ix+3)
 296+ 7E9B DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7E9E
 298+ 7E9E C1               pop  bc
 299+ 7E9F
 300+ 7E9F              .next_draw:
 301+ 7E9F 11 0B 00         ld   de, 11
 302+ 7EA2 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7EA4 05               dec  b
 304+ 7EA5 20 BA            jr   nz, .draw_loop
 305+ 7EA7
 306+ 7EA7 AF               xor  a
 307+ 7EA8 32 09 A2         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 308+ 7EAB
 309+ 7EAB DD E1            pop  ix
 310+ 7EAD C1               pop  bc
 311+ 7EAE D1               pop  de
 312+ 7EAF E1               pop  hl
 313+ 7EB0 C9               ret

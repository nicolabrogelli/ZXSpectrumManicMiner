 625+ 80F9              ; Score_AddItemPoints
 626+ 80F9              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 80F9              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 80F9              ; -------------------------------------------------------------------
 629+ 80F9              Score_AddItemPoints:
 630+ 80F9 F5               push af
 631+ 80FA C5               push bc
 632+ 80FB D5               push de
 633+ 80FC E5               push hl
 634+ 80FD
 635+ 80FD                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 80FD 3A 7B 9A         ld   a, (player_score + 1)
 637+ 8100 C6 01            add  a, $01
 638+ 8102 27               daa
 639+ 8103 32 7B 9A         ld   (player_score + 1), a
 640+ 8106
 641+ 8106                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8106 3A 7C 9A         ld   a, (player_score + 2)
 643+ 8109 CE 00            adc  a, 0
 644+ 810B 27               daa
 645+ 810C 32 7C 9A         ld   (player_score + 2), a
 646+ 810F
 647+ 810F                  ; Controlla se player_score ha superato high_score
 648+ 810F CD 1A 81         call Score_CheckAndUpdateHighScore
 649+ 8112
 650+ 8112                  ; Aggiorna visualizzazione a schermo

  12+ 7E8E              ; DetermineCurrentRoomID
  13+ 7E8E              ;
  14+ 7E8E              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7E8E              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7E8E              ;
  17+ 7E8E              ; Output:
  18+ 7E8E              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7E8E              ;   (current_room) = A
  20+ 7E8E              ; -------------------------------------------------------------------
  21+ 7E8E              DetermineCurrentRoomID:
  22+ 7E8E E5               push hl
  23+ 7E8F D5               push de
  24+ 7E90 C5               push bc
  25+ 7E91
  26+ 7E91 21 9D 71         ld   hl, RoomsListTable
  27+ 7E94 ED 5B EB 97      ld   de, (room_ptr)
  28+ 7E98 06 02            ld   b, NUM_ROOMS
  29+ 7E9A 0E 00            ld   c, 0
  30+ 7E9C
  31+ 7E9C              .loop:
  32+ 7E9C 7E               ld   a, (hl)
  33+ 7E9D BB               cp   e
  34+ 7E9E 20 06            jr   nz, .no_match
  35+ 7EA0 23               inc  hl
  36+ 7EA1 7E               ld   a, (hl)
  37+ 7EA2 BA               cp   d
  38+ 7EA3 28 08            jr   z, .found
  39+ 7EA5 2B               dec  hl
  40+ 7EA6
  41+ 7EA6              .no_match:
  42+ 7EA6 23               inc  hl
  43+ 7EA7 23               inc  hl
  44+ 7EA8 0C               inc  c
  45+ 7EA9 10 F1            djnz .loop
  46+ 7EAB
  47+ 7EAB 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7EAD
  49+ 7EAD              .found:
  50+ 7EAD 79               ld   a, c
  51+ 7EAE 32 91 97         ld   (current_room), a
  52+ 7EB1
  53+ 7EB1 C1               pop  bc
  54+ 7EB2 D1               pop  de
  55+ 7EB3 E1               pop  hl
  56+ 7EB4 C9               ret

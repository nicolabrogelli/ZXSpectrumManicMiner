 870  8457              ; -------------------------------------------------------------------
 871  8457              ; ResetFullGameState
 872  8457              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 873  8457              ; per l'avvio di una nuova partita dopo il Game Over.
 874  8457              ; -------------------------------------------------------------------
 875  8457              ResetFullGameState:
 876  8457                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 877  8457 AF               xor  a
 878  8458 D3 FE            out  ($fe), a              ; Bordo a nero
 879  845A 21 8D 5C         ld   hl, ATTR_P
 880  845D 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 881  845E CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 882  8461 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 883  8463 3E 07            ld   a, $07
 884  8465 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 885  8468
 886  8468                  ; Ripristina il numero di vite iniziali
 887  8468 3E 07            ld   a, INITIAL_LIVES
 888  846A 32 7E 8F         ld   (willy_lives), a
 889  846D
 890  846D                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 891  846D AF               xor  a
 892  846E 32 7B 8F         ld   (items_collected), a
 893  8471 32 77 8F         ld   (body_state), a
 894  8474 32 8A 8F         ld   (w_warp_state), a
 895  8477 32 8D 8F         ld   (w_key_prev), a
 896  847A 32 8E 8F         ld   (enter_key_prev), a

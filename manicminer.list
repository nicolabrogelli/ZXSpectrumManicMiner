 467+ 82BE 28 04            jr   z, .y_ok
 468+ 82C0 38 02            jr   c, .y_ok
 469+ 82C2 18 13            jr   .no_collision
 470+ 82C4
 471+ 82C4              .y_ok:
 472+ 82C4                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 82C4 BB               cp   e                         ; E = ItemTop
 474+ 82C5 28 0B            jr   z, .collision
 475+ 82C7 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 82C9
 477+ 82C9                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 82C9 C6 0F            add  a, 15
 479+ 82CB BB               cp   e
 480+ 82CC 28 04            jr   z, .collision

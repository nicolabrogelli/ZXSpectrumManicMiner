 386+ 7BAB              ; Enemy_Update
 387+ 7BAB              ;
 388+ 7BAB              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7BAB              ; -------------------------------------------------------------------
 390+ 7BAB              Enemy_Update:
 391+ 7BAB                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7BAB 3A 2F 96         ld   a, (enemy_update_rate)
 393+ 7BAE FE 01            cp   1
 394+ 7BB0 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7BB2
 396+ 7BB2 21 30 96         ld   hl, enemy_update_timer
 397+ 7BB5 34               inc  (hl)
 398+ 7BB6 7E               ld   a, (hl)
 399+ 7BB7 21 2F 96         ld   hl, enemy_update_rate
 400+ 7BBA BE               cp   (hl)
 401+ 7BBB D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7BBC AF               xor  a
 403+ 7BBD 32 30 96         ld   (enemy_update_timer), a
 404+ 7BC0
 405+ 7BC0              .do_update:
 406+ 7BC0 E5               push hl
 407+ 7BC1 D5               push de
 408+ 7BC2 C5               push bc
 409+ 7BC3 DD E5            push ix
 410+ 7BC5
 411+ 7BC5 3E 01            ld   a, 1
 412+ 7BC7 32 B6 96         ld   (enemy_was_updated), a
 413+ 7BCA
 414+ 7BCA DD 21 7B 79      ld   ix, ActiveEnemies
 415+ 7BCE 06 08            ld   b, 8                      ; 8 slot
 416+ 7BD0              .loop:
 417+ 7BD0 DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7BD3 E6 80            and  $80                       ; Active?
 419+ 7BD5 CA 74 7C         jp   z, .next
 420+ 7BD8
 421+ 7BD8                  ; 1. Aggiorna Anim State (0..3)
 422+ 7BD8 DD 7E 07         ld   a, (ix+7)
 423+ 7BDB 3C               inc  a
 424+ 7BDC E6 03            and  3
 425+ 7BDE DD 77 07         ld   (ix+7), a
 426+ 7BE1
 427+ 7BE1                  ; 2. Determina se orizzontale o verticale
 428+ 7BE1 DD 7E 00         ld   a, (ix+0)
 429+ 7BE4 E6 40            and  $40                       ; Vertical?
 430+ 7BE6 C2 30 7C         jp   nz, .vertical
 431+ 7BE9
 432+ 7BE9              .horizontal:
 433+ 7BE9 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7BEC FE 01            cp   1
 435+ 7BEE 20 20            jr   nz, .horiz_right
 436+ 7BF0
 437+ 7BF0              .horiz_left:
 438+ 7BF0 DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7BF3 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7BF5 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7BF8 28 08            jr   z, .h_rev_right
 442+ 7BFA 38 06            jr   c, .h_rev_right
 443+ 7BFC DD 77 02         ld   (ix+2), a
 444+ 7BFF C3 74 7C         jp   .next
 445+ 7C02
 446+ 7C02              .h_rev_right:
 447+ 7C02 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7C05 DD 77 02         ld   (ix+2), a
 449+ 7C08 3E 02            ld   a, 2
 450+ 7C0A DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7C0D C3 74 7C         jp   .next
 452+ 7C10
 453+ 7C10              .horiz_right:
 454+ 7C10 DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7C13 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7C15 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7C18 28 08            jr   z, .h_rev_left
 458+ 7C1A 30 06            jr   nc, .h_rev_left
 459+ 7C1C DD 77 02         ld   (ix+2), a
 460+ 7C1F C3 74 7C         jp   .next
 461+ 7C22
 462+ 7C22              .h_rev_left:
 463+ 7C22 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7C25 DD 77 02         ld   (ix+2), a
 465+ 7C28 3E 01            ld   a, 1
 466+ 7C2A DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7C2D C3 74 7C         jp   .next
 468+ 7C30
 469+ 7C30              .vertical:
 470+ 7C30 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7C33 FE 01            cp   1
 472+ 7C35 20 20            jr   nz, .vert_down
 473+ 7C37
 474+ 7C37              .vert_up:
 475+ 7C37 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 476+ 7C3A D6 02            sub  2
 477+ 7C3C DD BE 04         cp   (ix+4)
 478+ 7C3F 28 08            jr   z, .v_rev_down
 479+ 7C41 38 06            jr   c, .v_rev_down
 480+ 7C43 DD 77 03         ld   (ix+3), a
 481+ 7C46 C3 74 7C         jp   .next
 482+ 7C49
 483+ 7C49              .v_rev_down:
 484+ 7C49 DD 7E 04         ld   a, (ix+4)
 485+ 7C4C DD 77 03         ld   (ix+3), a
 486+ 7C4F 3E 02            ld   a, 2
 487+ 7C51 DD 77 06         ld   (ix+6), a
 488+ 7C54 C3 74 7C         jp   .next
 489+ 7C57
 490+ 7C57              .vert_down:
 491+ 7C57 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7C5A C6 02            add  a, 2
 493+ 7C5C DD BE 05         cp   (ix+5)
 494+ 7C5F 28 08            jr   z, .v_rev_up
 495+ 7C61 30 06            jr   nc, .v_rev_up
 496+ 7C63 DD 77 03         ld   (ix+3), a
 497+ 7C66 C3 74 7C         jp   .next
 498+ 7C69
 499+ 7C69              .v_rev_up:
 500+ 7C69 DD 7E 05         ld   a, (ix+5)
 501+ 7C6C DD 77 03         ld   (ix+3), a
 502+ 7C6F 3E 01            ld   a, 1
 503+ 7C71 DD 77 06         ld   (ix+6), a
 504+ 7C74
 505+ 7C74              .next:
 506+ 7C74 11 0B 00         ld   de, 11
 507+ 7C77 DD 19            add  ix, de
 508+ 7C79 05               dec  b
 509+ 7C7A C2 D0 7B         jp   nz, .loop
 510+ 7C7D
 511+ 7C7D DD E1            pop  ix
 512+ 7C7F C1               pop  bc
 513+ 7C80 D1               pop  de
 514+ 7C81 E1               pop  hl

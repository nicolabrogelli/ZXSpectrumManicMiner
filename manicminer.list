 142+ 84E8              ; Items_DrawRoom
 143+ 84E8              ;
 144+ 84E8              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 84E8              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 84E8              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 84E8              ;
 148+ 84E8              ; Record item nella stanza (5 byte):
 149+ 84E8              ;   +0 Color / Attributo
 150+ 84E8              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 84E8              ;   +2 Attr Address High
 152+ 84E8              ;   +3 Anim Mask (96)
 153+ 84E8              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 84E8              ; Fine lista: $FF
 155+ 84E8              ; -------------------------------------------------------------------
 156+ 84E8              Items_DrawRoom:
 157+ 84E8 E5               push hl
 158+ 84E9 D5               push de
 159+ 84EA C5               push bc
 160+ 84EB DD E5            push ix
 161+ 84ED FD E5            push iy

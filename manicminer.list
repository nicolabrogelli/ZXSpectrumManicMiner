 163+ 8550                  ; 1. Azzera items_grid (512 byte)
 164+ 8550 21 85 E8         ld   hl, items_grid
 165+ 8553 11 86 E8         ld   de, items_grid + 1
 166+ 8556 36 00            ld   (hl), 0
 167+ 8558 01 FF 01         ld   bc, 511
 168+ 855B ED B0            ldir
 169+ 855D
 170+ 855D                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 855D AF               xor  a
 172+ 855E 32 05 EE         ld   (num_room_items), a
 173+ 8561
 174+ 8561 FD 21 B5 ED      ld   iy, current_room_items
 175+ 8565
 176+ 8565                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 8565 2A 06 EE         ld   hl, (room_ptr)
 178+ 8568 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 856B 19               add  hl, de
 180+ 856C E5               push hl
 181+ 856D DD E1            pop  ix                        ; IX = bitmap item
 182+ 856F
 183+ 856F                  ; 4. HL = Inizio lista item nella stanza
 184+ 856F 2A 06 EE         ld   hl, (room_ptr)
 185+ 8572 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8575 19               add  hl, de
 187+ 8576
 188+ 8576              .loop:
 189+ 8576 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 8577 FE FF            cp   $FF
 191+ 8579 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 857B B7               or   a
 193+ 857C 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 857E
 195+ 857E 5F               ld   e, a                      ; E = Color
 196+ 857F 23               inc  hl
 197+ 8580 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8581 23               inc  hl

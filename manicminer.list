 314  8AA0 0C               inc  c
 315  8AA1 79               ld   a, c
 316  8AA2 CB 3F            srl  a
 317  8AA4 CB 3F            srl  a
 318  8AA6 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)

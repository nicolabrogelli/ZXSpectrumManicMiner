 631+ 8671              ; Score_AddItemPoints
 632+ 8671              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 633+ 8671              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 634+ 8671              ; -------------------------------------------------------------------
 635+ 8671              Score_AddItemPoints:
 636+ 8671 F5               push af
 637+ 8672 C5               push bc
 638+ 8673 D5               push de
 639+ 8674 E5               push hl
 640+ 8675
 641+ 8675                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 642+ 8675 3A E6 E7         ld   a, (player_score + 1)
 643+ 8678 C6 01            add  a, $01
 644+ 867A 27               daa
 645+ 867B 32 E6 E7         ld   (player_score + 1), a
 646+ 867E
 647+ 867E                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 648+ 867E 3A E7 E7         ld   a, (player_score + 2)
 649+ 8681 CE 00            adc  a, 0
 650+ 8683 27               daa
 651+ 8684 32 E7 E7         ld   (player_score + 2), a
 652+ 8687
 653+ 8687                  ; Controlla se player_score ha superato high_score
 654+ 8687 CD 92 86         call Score_CheckAndUpdateHighScore
 655+ 868A
 656+ 868A                  ; Aggiorna visualizzazione a schermo
 657+ 868A CD AE 68         call Gfx_UpdateScoreDisplay
 658+ 868D
 659+ 868D E1               pop  hl
 660+ 868E D1               pop  de
 661+ 868F C1               pop  bc
 662+ 8690 F1               pop  af
 663+ 8691 C9               ret
 664+ 8692
 665+ 8692              ; -------------------------------------------------------------------
 666+ 8692              ; Score_CheckAndUpdateHighScore
 667+ 8692              ; Se player_score > high_score, copia player_score in high_score.
 668+ 8692              ; -------------------------------------------------------------------
 669+ 8692              Score_CheckAndUpdateHighScore:
 670+ 8692                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 671+ 8692                  ; Byte 2:
 672+ 8692 3A E7 E7         ld   a, (player_score + 2)
 673+ 8695 47               ld   b, a
 674+ 8696 3A EA E7         ld   a, (high_score + 2)
 675+ 8699 B8               cp   b
 676+ 869A 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 677+ 869C 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 678+ 869E
 679+ 869E                  ; Byte 1:
 680+ 869E 3A E6 E7         ld   a, (player_score + 1)
 681+ 86A1 47               ld   b, a
 682+ 86A2 3A E9 E7         ld   a, (high_score + 1)
 683+ 86A5 B8               cp   b
 684+ 86A6 38 0C            jr   c, .new_high_score
 685+ 86A8 20 1C            jr   nz, .done_check
 686+ 86AA
 687+ 86AA                  ; Byte 0:
 688+ 86AA 3A E5 E7         ld   a, (player_score + 0)
 689+ 86AD 47               ld   b, a
 690+ 86AE 3A E8 E7         ld   a, (high_score + 0)
 691+ 86B1 B8               cp   b
 692+ 86B2 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 693+ 86B4
 694+ 86B4              .new_high_score:
 695+ 86B4 3A E5 E7         ld   a, (player_score + 0)
 696+ 86B7 32 E8 E7         ld   (high_score + 0), a
 697+ 86BA 3A E6 E7         ld   a, (player_score + 1)
 698+ 86BD 32 E9 E7         ld   (high_score + 1), a
 699+ 86C0 3A E7 E7         ld   a, (player_score + 2)
 700+ 86C3 32 EA E7         ld   (high_score + 2), a
 701+ 86C6
 702+ 86C6              .done_check:
 703+ 86C6 C9               ret

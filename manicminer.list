   8+ 85B3              ; Audio_UpdateJumpSound
   9+ 85B3              ;
  10+ 85B3              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 85B3              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 85B3              ; -------------------------------------------------------------------
  13+ 85B3              Audio_UpdateJumpSound:
  14+ 85B3 F5               push af
  15+ 85B4 C5               push bc
  16+ 85B5 D5               push de
  17+ 85B6 E5               push hl
  18+ 85B7
  19+ 85B7                  ; Controlla se il suono è attivo (note < 18)
  20+ 85B7 3A D8 E6         ld   a, (Audio_jump_sound_note)
  21+ 85BA FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 85BC 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 85BE
  24+ 85BE                  ; Carica la nota corrente da suonare
  25+ 85BE 5F               ld   e, a
  26+ 85BF 16 00            ld   d, 0
  27+ 85C1 21 ED 85         ld   hl, Audio_JumpSoundDelays
  28+ 85C4 19               add  hl, de
  29+ 85C5 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 85C6 57               ld   d, a                      ; D = delay della nota
  31+ 85C7
  32+ 85C7                  ; Suona la nota: 15 cicli
  33+ 85C7 06 0F            ld   b, 15
  34+ 85C9              .note_loop:
  35+ 85C9                  ; Speaker ON
  36+ 85C9 3A C7 E0         ld   a, (room_border_color)
  37+ 85CC F6 10            or   $10
  38+ 85CE D3 FE            out  ($fe), a
  39+ 85D0 4A               ld   c, d
  40+ 85D1              .d1:
  41+ 85D1 0D               dec  c
  42+ 85D2 20 FD            jr   nz, .d1
  43+ 85D4
  44+ 85D4                  ; Speaker OFF
  45+ 85D4 3A C7 E0         ld   a, (room_border_color)
  46+ 85D7 E6 EF            and  $ef
  47+ 85D9 D3 FE            out  ($fe), a
  48+ 85DB 4A               ld   c, d
  49+ 85DC              .d2:
  50+ 85DC 0D               dec  c
  51+ 85DD 20 FD            jr   nz, .d2
  52+ 85DF
  53+ 85DF 10 E8            djnz .note_loop
  54+ 85E1
  55+ 85E1                  ; Passa alla nota successiva
  56+ 85E1 3A D8 E6         ld   a, (Audio_jump_sound_note)
  57+ 85E4 3C               inc  a
  58+ 85E5 32 D8 E6         ld   (Audio_jump_sound_note), a
  59+ 85E8
  60+ 85E8              .done:
  61+ 85E8 E1               pop  hl
  62+ 85E9 D1               pop  de
  63+ 85EA C1               pop  bc
  64+ 85EB F1               pop  af
  65+ 85EC C9               ret
  66+ 85ED
  67+ 85ED              Audio_JumpSoundDelays:
  68+ 85ED 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 85F1 19 13 0C 06
  68+ 85F5 0C 13 19 20
  68+ 85F9 26 2D 33 3A
  68+ 85FD 40 47

 325+ 8152 23               inc  hl
 326+ 8153 05               dec  b
 327+ 8154 20 F9            jr   nz, .line_loop
 328+ 8156 C1               pop  bc
 329+ 8157
 330+ 8157                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 331+ 8157 26 00            ld   h, 0
 332+ 8159 68               ld   l, b
 333+ 815A 29               add  hl, hl
 334+ 815B 29               add  hl, hl
 335+ 815C 29               add  hl, hl
 336+ 815D 29               add  hl, hl
 337+ 815E 29               add  hl, hl                    ; Row * 32
 338+ 815F 79               ld   a, c

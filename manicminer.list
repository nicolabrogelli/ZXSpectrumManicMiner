 287+ 81BF              ; DrawItemGraphic
 288+ 81BF              ;
 289+ 81BF              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 290+ 81BF              ; utilizzando una bitmap di 8 byte e un attributo colore.
 291+ 81BF              ;
 292+ 81BF              ; Input:
 293+ 81BF              ;   B = Riga attributi (0..23)
 294+ 81BF              ;   C = Colonna attributi (0..31)
 295+ 81BF              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)

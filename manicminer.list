 413  860B
 414  860B                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  860B 01 FE DF         ld   bc, $dffe
 416  860E ED 78            in   a, (c)
 417  8610 CB 67            bit  4, a
 418  8612 28 2A            jr   z, .continue_chosen
 419  8614
 420  8614                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)

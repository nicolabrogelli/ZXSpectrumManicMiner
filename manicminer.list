 478+ 7F52              ; Enemy_DrawSingleSlot
 479+ 7F52              ;
 480+ 7F52              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7F52              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7F52              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F52              ; -------------------------------------------------------------------
 484+ 7F52              Enemy_DrawSingleSlot:
 485+ 7F52 C5               push bc
 486+ 7F53 D5               push de
 487+ 7F54 E5               push hl
 488+ 7F55 DD E5            push ix
 489+ 7F57
 490+ 7F57                  ; 1. Salva subito le coordinate X e Y dal record IX
 491+ 7F57 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 492+ 7F5A DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 493+ 7F5D
 494+ 7F5D                  ; Controlla se è Kong Beast ($A0)
 495+ 7F5D DD 7E 00         ld   a, (ix+0)
 496+ 7F60 FE A0            cp   $A0
 497+ 7F62 28 22            jr   z, .kong_frame
 498+ 7F64
 499+ 7F64                  ; Controlla se è guardiano verticale
 500+ 7F64 DD 7E 00         ld   a, (ix+0)
 501+ 7F67 E6 40            and  $40                       ; Vertical?
 502+ 7F69 20 22            jr   nz, .v_frame
 503+ 7F6B
 504+ 7F6B                  ; Guardiano Orizzontale:
 505+ 7F6B DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 506+ 7F6E E6 03            and  3
 507+ 7F70 5F               ld   e, a                      ; E = Anim subframe
 508+ 7F71
 509+ 7F71 3A 28 E6         ld   a, (room_has_v_guardians)
 510+ 7F74 B7               or   a
 511+ 7F75 20 0A            jr   nz, .h_use_second_half    ; Se ci sono guardiani verticali, i guardiani orizzontali usano la SECONDA METÀ (frame 4..7)!
 512+ 7F77
 513+ 7F77 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7F7A FE 01            cp   1                         ; Sinistra?
 515+ 7F7C 28 03            jr   z, .left_frames
 516+ 7F7E
 517+ 7F7E                  ; Movimento a Destra: Frame 0..3 (prima metà)
 518+ 7F7E 7B               ld   a, e
 519+ 7F7F 18 23            jr   .got_frame_idx
 520+ 7F81
 521+ 7F81              .h_use_second_half:
 522+ 7F81              .left_frames:
 523+ 7F81                  ; Movimento a Sinistra (o orizzontale in stanze con guardiani verticali): Frame 4..7 (seconda metà)
 524+ 7F81 3E 04            ld   a, 4
 525+ 7F83 83               add  a, e
 526+ 7F84 18 1E            jr   .got_frame_idx

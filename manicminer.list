 315  84BC E6 07            and  7
 316  84BE 5F               ld   e, a
 317  84BF 16 00            ld   d, 0
 318  84C1 21 F5 63         ld   hl, title_color_table
 319  84C4 19               add  hl, de
 320  84C5 7E               ld   a, (hl)               ; A = nuovo colore
 321  84C6 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 322  84C9 06 20            ld   b, 32
 323  84CB              .color_title_loop:
 324  84CB 77               ld   (hl), a
 325  84CC 23               inc  hl
 326  84CD 10 FC            djnz .color_title_loop
 327  84CF
 328  84CF                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 329  84CF 3E BF            ld   a, $bf
 330  84D1 DB FE            in   a, ($fe)
 331  84D3 1F               rra
 332  84D4 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 333  84D6
 334  84D6                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 335  84D6              .wait_title_enter_release_after:
 336  84D6 76               halt
 337  84D7 3E BF            ld   a, $bf
 338  84D9 DB FE            in   a, ($fe)
 339  84DB 1F               rra
 340  84DC 30 F8            jr   nc, .wait_title_enter_release_after
 341  84DE
 342  84DE                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 343  84DE AF               xor  a
 344  84DF D3 FE            out  ($fe), a              ; Bordo a nero
 345  84E1 21 8D 5C         ld   hl, ATTR_P
 346  84E4 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 347  84E5 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  84E8 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 349  84EA 3E 07            ld   a, $07
 350  84EC 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 351  84EF
 352  84EF                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 353  84EF CD 64 87         call ResetFullGameState
 354  84F2
 355  84F2                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 356  84F2 C3 77 83         jp   LoadRoomAndRestart
 357  84F5
 358  84F5              ; -------------------------------------------------------------------
 359  84F5              ; TriggerGameOver
 360  84F5              ; Scatena la schermata di Game Over per la stanza corrente.
 361  84F5              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 362  84F5              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 363  84F5              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 364  84F5              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 365  84F5              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 366  84F5              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 367  84F5              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 368  84F5              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 369  84F5              ; -------------------------------------------------------------------
 370  84F5              TriggerGameOver:
 371  84F5                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 372  84F5 CD DE 65         call Gfx_DrawGameOverScreen

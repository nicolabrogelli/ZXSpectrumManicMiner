 438+ 8486 ED 4B BB E0      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 848A
 440+ 848A                  ; WillyLeft <= ItemRight
 441+ 848A 79               ld   a, c                      ; A = WillyX
 442+ 848B BA               cp   d                         ; D = ItemRight
 443+ 848C 28 04            jr   z, .x_ok
 444+ 848E 38 02            jr   c, .x_ok
 445+ 8490 18 31            jr   .no_collision
 446+ 8492
 447+ 8492              .x_ok:
 448+ 8492                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8492 BB               cp   e                         ; E = ItemLeft
 450+ 8493 28 0B            jr   z, .y_check
 451+ 8495 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8497
 453+ 8497                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 8497 C6 0F            add  a, 15
 455+ 8499 BB               cp   e
 456+ 849A 28 04            jr   z, .y_check
 457+ 849C 30 02            jr   nc, .y_check
 458+ 849E 18 23            jr   .no_collision
 459+ 84A0
 460+ 84A0              .y_check:
 461+ 84A0                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 84A0 7C               ld   a, h                      ; H = Item Row
 463+ 84A1 87               add  a, a                      ; *2
 464+ 84A2 87               add  a, a                      ; *4
 465+ 84A3 87               add  a, a                      ; *8

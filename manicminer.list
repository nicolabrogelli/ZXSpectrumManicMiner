 358  8B4B              ; TriggerGameOver
 359  8B4B              ; Scatena la sequenza originale di Game Over:
 360  8B4B              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 361  8B4B              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 362  8B4B              ;   con suono beeper originale e lampeggio dello schermo.
 363  8B4B              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 364  8B4B              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 365  8B4B              ; -------------------------------------------------------------------
 366  8B4B              TriggerGameOver:
 367  8B4B                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 368  8B4B CD AF 88         call Score_CheckAndUpdateHighScore
 369  8B4E
 370  8B4E                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 371  8B4E CD 29 66         call Gfx_DrawGameOverScreen
 372  8B51
 373  8B51                  ; 3. Ritorna al Title Screen originale
 374  8B51 C3 07 8B         jp   ShowTitleScreen
 375  8B54
 376  8B54              ; -------------------------------------------------------------------
 377  8B54              ; TriggerVictory
 378  8B54              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 379  8B54              ; - Pulisce gli elementi di gioco della stanza.
 380  8B54              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 381  8B54              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 382  8B54              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 383  8B54              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 384  8B54              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 385  8B54              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 386  8B54              ; -------------------------------------------------------------------
 387  8B54              TriggerVictory:
 388  8B54                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 389  8B54 CD AF 88         call Score_CheckAndUpdateHighScore
 390  8B57
 391  8B57                  ; 2. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 392  8B57 CD 14 67         call Gfx_DrawVictoryScreen
 393  8B5A
 394  8B5A                  ; 3. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 395  8B5A              .wait_keys_release:
 396  8B5A 76               halt
 397  8B5B                  ; Controlla tasto Y (Porta $DF, bit 4)
 398  8B5B 01 FE DF         ld   bc, $dffe
 399  8B5E ED 78            in   a, (c)
 400  8B60 CB 67            bit  4, a
 401  8B62 28 F6            jr   z, .wait_keys_release
 402  8B64
 403  8B64                  ; Controlla tasto N (Porta $7F, bit 3)
 404  8B64 01 FE 7F         ld   bc, $7ffe
 405  8B67 ED 78            in   a, (c)
 406  8B69 CB 5F            bit  3, a
 407  8B6B 28 ED            jr   z, .wait_keys_release
 408  8B6D
 409  8B6D                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 410  8B6D 01 FE BF         ld   bc, $bffe
 411  8B70 ED 78            in   a, (c)
 412  8B72 CB 47            bit  0, a
 413  8B74 28 E4            jr   z, .wait_keys_release
 414  8B76
 415  8B76                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 416  8B76 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 417  8B78              .wait_choice_loop:
 418  8B78 76               halt
 419  8B79
 420  8B79                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 421  8B79 0C               inc  c
 422  8B7A 79               ld   a, c
 423  8B7B CB 3F            srl  a
 424  8B7D CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 425  8B7F E6 07            and  7
 426  8B81 5F               ld   e, a
 427  8B82 16 00            ld   d, 0
 428  8B84 21 0B 66         ld   hl, victory_color_table
 429  8B87 19               add  hl, de
 430  8B88 7E               ld   a, (hl)               ; A = nuovo colore attributo
 431  8B89 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 432  8B8C 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 433  8B8E              .color_cycle_loop:
 434  8B8E 77               ld   (hl), a
 435  8B8F 23               inc  hl
 436  8B90 10 FC            djnz .color_cycle_loop
 437  8B92
 438  8B92                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 439  8B92 01 FE DF         ld   bc, $dffe
 440  8B95 ED 78            in   a, (c)
 441  8B97 CB 67            bit  4, a
 442  8B99 28 2A            jr   z, .play_again_chosen
 443  8B9B
 444  8B9B                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 445  8B9B 01 FE 7F         ld   bc, $7ffe
 446  8B9E ED 78            in   a, (c)
 447  8BA0 CB 5F            bit  3, a
 448  8BA2 28 0B            jr   z, .quit_chosen
 449  8BA4
 450  8BA4                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 451  8BA4 01 FE BF         ld   bc, $bffe
 452  8BA7 ED 78            in   a, (c)
 453  8BA9 CB 47            bit  0, a
 454  8BAB 28 02            jr   z, .quit_chosen
 455  8BAD
 456  8BAD 18 C9            jr   .wait_choice_loop
 457  8BAF
 458  8BAF              .quit_chosen:
 459  8BAF                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 460  8BAF              .wait_quit_release:
 461  8BAF 76               halt
 462  8BB0 01 FE 7F         ld   bc, $7ffe
 463  8BB3 ED 78            in   a, (c)
 464  8BB5 CB 5F            bit  3, a
 465  8BB7 28 F6            jr   z, .wait_quit_release
 466  8BB9 01 FE BF         ld   bc, $bffe
 467  8BBC ED 78            in   a, (c)
 468  8BBE CB 47            bit  0, a
 469  8BC0 28 ED            jr   z, .wait_quit_release
 470  8BC2
 471  8BC2                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 472  8BC2 C3 07 8B         jp   ShowTitleScreen
 473  8BC5
 474  8BC5              .play_again_chosen:
 475  8BC5                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 476  8BC5              .wait_play_again_release:
 477  8BC5 76               halt
 478  8BC6 01 FE DF         ld   bc, $dffe
 479  8BC9 ED 78            in   a, (c)
 480  8BCB CB 67            bit  4, a
 481  8BCD 28 F6            jr   z, .wait_play_again_release
 482  8BCF
 483  8BCF                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 484  8BCF CD 09 8D         call ResetFullGameState
 485  8BD2 C3 C5 89         jp   LoadRoomAndRestart
 486  8BD5
 487  8BD5              ; -------------------------------------------------------------------
 488  8BD5              ; CheckPortalTransition
 489  8BD5              ; Verifica le condizioni per accedere alla stanza successiva:
 490  8BD5              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 491  8BD5              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 492  8BD5              ;
 493  8BD5              ; Output:
 494  8BD5              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 495  8BD5              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 496  8BD5              ; -------------------------------------------------------------------
 497  8BD5              CheckPortalTransition:
 498  8BD5 C5               push bc
 499  8BD6 D5               push de
 500  8BD7 E5               push hl
 501  8BD8
 502  8BD8                  ; 1. Tutti gli item della stanza sono stati raccolti?
 503  8BD8 CD 9C 8C         call CheckAllItemsCollected
 504  8BDB 30 4D            jr   nc, .no_transition
 505  8BDD
 506  8BDD                  ; 2. Willy collide con il portale (16x16 pixel)?
 507  8BDD                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 508  8BDD                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 509  8BDD 2A 25 EF         ld   hl, (room_ptr)
 510  8BE0 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 511  8BE3 19               add  hl, de
 512  8BE4 4E               ld   c, (hl)
 513  8BE5 23               inc  hl
 514  8BE6 46               ld   b, (hl)                   ; BC = AttrAddr
 515  8BE7
 516  8BE7                  ; Offset = BC - 23552
 517  8BE7 60               ld   h, b
 518  8BE8 69               ld   l, c
 519  8BE9 01 00 A4         ld   bc, -23552
 520  8BEC 09               add  hl, bc
 521  8BED
 522  8BED                  ; PortalX = (Offset & 31) * 8
 523  8BED 7D               ld   a, l
 524  8BEE E6 1F            and  31
 525  8BF0 87               add  a, a
 525  8BF1 87             add a, a
 525  8BF2 87             add a, a
 526  8BF3 5F               ld   e, a                      ; E = PortalX (0..248)
 527  8BF4
 528  8BF4                  ; PortalY = (Offset / 32) * 8
 529  8BF4 CB 3C            srl  h
 529  8BF6 CB 1D          rr l
 530  8BF8 CB 3C            srl  h
 530  8BFA CB 1D          rr l
 531  8BFC CB 3C            srl  h
 531  8BFE CB 1D          rr l
 532  8C00 CB 3C            srl  h
 532  8C02 CB 1D          rr l
 533  8C04 CB 3C            srl  h
 533  8C06 CB 1D          rr l
 534  8C08 7D               ld   a, l
 535  8C09 87               add  a, a
 535  8C0A 87             add a, a
 535  8C0B 87             add a, a
 536  8C0C 57               ld   d, a                      ; D = PortalY (0..120)
 537  8C0D
 538  8C0D                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 539  8C0D ED 4B A3 EB      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 540  8C11
 541  8C11                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 542  8C11 7B               ld   a, e
 543  8C12 91               sub  c
 544  8C13 30 02            jr   nc, .x_diff_pos
 545  8C15 ED 44            neg
 546  8C17              .x_diff_pos:
 547  8C17 FE 0C            cp   12
 548  8C19 30 0F            jr   nc, .no_transition
 549  8C1B
 550  8C1B                  ; Controllo verticale: |WillyY - PortalY| < 14
 551  8C1B 7A               ld   a, d
 552  8C1C 90               sub  b
 553  8C1D 30 02            jr   nc, .y_diff_pos
 554  8C1F ED 44            neg
 555  8C21              .y_diff_pos:
 556  8C21 FE 0E            cp   14
 557  8C23 30 05            jr   nc, .no_transition
 558  8C25
 559  8C25                  ; Transizione al portale attiva!
 560  8C25 E1               pop  hl
 561  8C26 D1               pop  de
 562  8C27 C1               pop  bc
 563  8C28 37               scf
 564  8C29 C9               ret
 565  8C2A
 566  8C2A              .no_transition:
 567  8C2A E1               pop  hl
 568  8C2B D1               pop  de
 569  8C2C C1               pop  bc
 570  8C2D B7               or   a
 571  8C2E C9               ret
 572  8C2F
 573  8C2F              ; Alias per retrocompatibilità
 574  8C2F              CheckVictoryCondition: EQU CheckPortalTransition
 575  8C2F
 576  8C2F              ; -------------------------------------------------------------------
 577  8C2F              ; TriggerPortalTransition
 578  8C2F              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 579  8C2F              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 580  8C2F              ; - Avanza all'indice della stanza successiva.
 581  8C2F              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 582  8C2F              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 583  8C2F              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 584  8C2F              ; -------------------------------------------------------------------
 585  8C2F              TriggerPortalTransition:
 586  8C2F                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 587  8C2F CD 66 8C         call Air_DepleteCountdown
 588  8C32
 589  8C32                  ; 1. Determina l'ID della stanza corrente
 590  8C32 CD F0 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 591  8C35
 592  8C35                  ; 2. Calcola l'indice della stanza successiva
 593  8C35 3A CA EE         ld   a, (current_room)
 594  8C38 3C               inc  a
 595  8C39 FE 14            cp   NUM_ROOMS
 596  8C3B 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 597  8C3D
 598  8C3D                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 599  8C3D 21 3D 74         ld   hl, RoomsListTable
 600  8C40 5F               ld   e, a
 601  8C41 16 00            ld   d, 0
 602  8C43 19               add  hl, de
 603  8C44 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 604  8C45 5E               ld   e, (hl)
 605  8C46 23               inc  hl
 606  8C47 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 607  8C48 ED 53 25 EF      ld   (room_ptr), de
 608  8C4C
 609  8C4C                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 610  8C4C AF               xor  a
 611  8C4D 32 2B EF         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 612  8C50 32 B1 EB         ld   (velocity_y), a
 613  8C53 32 BD F1         ld   (game_objective_completed), a
 614  8C56 3E 01            ld   a, 1
 615  8C58 32 B2 EB         ld   (on_ground), a
 616  8C5B
 617  8C5B                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 618  8C5B 3E 07            ld   a, $07
 619  8C5D CD 9D 62         call Gfx_ClearScreenDirect
 620  8C60
 621  8C60 C3 C5 89         jp   LoadRoomAndRestart
 622  8C63
 623  8C63              .all_rooms_completed:
 624  8C63                  ; Tutte le stanze sono state completate con successo!
 625  8C63                  IF ENABLE_VICTORY_SCREEN != 0
 626  8C63 C3 54 8B         jp   TriggerVictory
 627  8C66                  ELSE
 628  8C66 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 629  8C66 ~                ld   de, (RoomsListTable)
 630  8C66 ~                ld   (room_ptr), de
 631  8C66 ~                xor  a
 632  8C66 ~                ld   (transition_active), a
 633  8C66 ~                ld   (velocity_y), a
 634  8C66 ~                ld   (game_objective_completed), a
 635  8C66 ~                ld   a, 1
 636  8C66 ~                ld   (on_ground), a
 637  8C66 ~                ld   a, $07
 638  8C66 ~                call Gfx_ClearScreenDirect
 639  8C66 ~                jp   LoadRoomAndRestart
 640  8C66                  ENDIF
 641  8C66
 642  8C66              ; -------------------------------------------------------------------
 643  8C66              ; Air_DepleteCountdown
 644  8C66              ; Animazione originale di completamento livello (Manic Miner):
 645  8C66              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 646  8C66              ; - Ad ogni pixel decrementato:
 647  8C66              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 648  8C66              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 649  8C66              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 650  8C66              ; -------------------------------------------------------------------
 651  8C66              Air_DepleteCountdown:
 652  8C66 F5               push af
 653  8C67 C5               push bc
 654  8C68 D5               push de
 655  8C69 E5               push hl
 656  8C6A
 657  8C6A              .countdown_loop:
 658  8C6A 3A C6 F1         ld   a, (air_pixels)
 659  8C6D B7               or   a
 660  8C6E 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 661  8C70
 662  8C70 3D               dec  a
 663  8C71 32 C6 F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 664  8C74
 665  8C74                  ; Aggiorna la barra grafica dell'aria
 666  8C74 CD 42 6A         call Gfx_UpdateAirBar
 667  8C77
 668  8C77                  ; Aggiungi 1 punto allo score
 669  8C77 CD 64 88         call Score_Add1Point
 670  8C7A
 671  8C7A                  ; Genera l'effetto sonoro originale di Manic Miner:
 672  8C7A                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 673  8C7A 3A C6 F1         ld   a, (air_pixels)
 674  8C7D 2F               cpl
 675  8C7E E6 3F            and  63
 676  8C80 07               rlca
 677  8C81 3C               inc  a
 678  8C82 57               ld   d, a                      ; D = ritardo semionda audio
 679  8C83
 680  8C83 0E 03            ld   c, 3                      ; Durata impulso
 681  8C85              .audio_loop:
 682  8C85 AF               xor  a
 683  8C86 D3 FE            out  ($fe), a
 684  8C88 42               ld   b, d
 685  8C89 10 FE        .w1: djnz .w1
 686  8C8B
 687  8C8B 3E 18            ld   a, $18
 688  8C8D D3 FE            out  ($fe), a
 689  8C8F 42               ld   b, d
 690  8C90 10 FE        .w2: djnz .w2
 691  8C92
 692  8C92 0D               dec  c
 693  8C93 20 F0            jr   nz, .audio_loop
 694  8C95
 695  8C95 18 D3            jr   .countdown_loop
 696  8C97
 697  8C97              .done_countdown:
 698  8C97 E1               pop  hl
 699  8C98 D1               pop  de
 700  8C99 C1               pop  bc
 701  8C9A F1               pop  af
 702  8C9B C9               ret
 703  8C9C
 704  8C9C              ; -------------------------------------------------------------------
 705  8C9C              ; CheckAllItemsCollected
 706  8C9C              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 707  8C9C              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8C9C              ; -------------------------------------------------------------------
 709  8C9C              CheckAllItemsCollected:
 710  8C9C 3A BD F1         ld   a, (game_objective_completed)
 711  8C9F B7               or   a
 712  8CA0 20 08            jr   nz, .all_collected
 713  8CA2 3A 24 EF         ld   a, (num_room_items)
 714  8CA5 B7               or   a
 715  8CA6 28 02            jr   z, .all_collected
 716  8CA8 B7               or   a
 717  8CA9 C9               ret
 718  8CAA              .all_collected:
 719  8CAA 37               scf
 720  8CAB C9               ret
 721  8CAC
 722  8CAC              ; -------------------------------------------------------------------
 723  8CAC              ; CheckInMasterBedroom (alias per retrocompatibilità)
 724  8CAC              ; -------------------------------------------------------------------
 725  8CAC              CheckInMasterBedroom:
 726  8CAC 37               scf
 727  8CAD C9               ret
 728  8CAE
 729  8CAE              ; -------------------------------------------------------------------
 730  8CAE              ; CheckWillyConveyorCollision
 731  8CAE              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 732  8CAE              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 733  8CAE              ; -------------------------------------------------------------------
 734  8CAE              CheckWillyConveyorCollision:
 735  8CAE C5               push bc
 736  8CAF D5               push de
 737  8CB0 E5               push hl
 738  8CB1
 739  8CB1                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 740  8CB1 CD 0C 79         call CheckWillyOnConveyor
 741  8CB4 38 49            jr   c, .collision_detected
 742  8CB6
 743  8CB6                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 744  8CB6 3A CC EE         ld   a, (conveyor_len)
 745  8CB9 B7               or   a
 746  8CBA 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 747  8CBC
 748  8CBC                  ; B = WillyY, C = WillyX
 749  8CBC ED 4B A3 EB      ld   bc, (PlayerPos)
 750  8CC0
 751  8CC0                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 752  8CC0 3A CD EE         ld   a, (conveyor_row)
 753  8CC3 87               add  a, a                  ; *2
 754  8CC4 87               add  a, a                  ; *4
 755  8CC5 87               add  a, a                  ; *8
 756  8CC6 5F               ld   e, a                  ; E = ConveyorTop
 757  8CC7 C6 07            add  a, 7
 758  8CC9 57               ld   d, a                  ; D = ConveyorBottom
 759  8CCA
 760  8CCA                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 761  8CCA 78               ld   a, b                  ; WillyTop
 762  8CCB BA               cp   d
 763  8CCC 28 04            jr   z, .y_overlap
 764  8CCE 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 765  8CD0 18 32            jr   .no_conv_collision
 766  8CD2
 767  8CD2              .y_overlap:
 768  8CD2 C6 0F            add  a, 15                 ; WillyBottom
 769  8CD4 BB               cp   e
 770  8CD5 28 04            jr   z, .x_check
 771  8CD7 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 772  8CD9 18 29            jr   .no_conv_collision
 773  8CDB
 774  8CDB              .x_check:
 775  8CDB                  ; ConveyorLeft = conveyor_col * 8
 776  8CDB 3A CE EE         ld   a, (conveyor_col)
 777  8CDE 87               add  a, a                  ; *2
 778  8CDF 87               add  a, a                  ; *4
 779  8CE0 87               add  a, a                  ; *8
 780  8CE1 5F               ld   e, a                  ; E = ConveyorLeft
 781  8CE2
 782  8CE2                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 783  8CE2 21 CC EE         ld   hl, conveyor_len
 784  8CE5 3A CE EE         ld   a, (conveyor_col)
 785  8CE8 86               add  a, (hl)
 786  8CE9 87               add  a, a                  ; *2
 787  8CEA 87               add  a, a                  ; *4
 788  8CEB 87               add  a, a                  ; *8
 789  8CEC 3D               dec  a                     ; ConveyorRight
 790  8CED 57               ld   d, a                  ; D = ConveyorRight
 791  8CEE
 792  8CEE                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 793  8CEE 79               ld   a, c                  ; WillyLeft
 794  8CEF BA               cp   d
 795  8CF0 28 04            jr   z, .x_overlap
 796  8CF2 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 797  8CF4 18 0E            jr   .no_conv_collision
 798  8CF6
 799  8CF6              .x_overlap:
 800  8CF6 C6 0F            add  a, 15                 ; WillyRight
 801  8CF8 BB               cp   e
 802  8CF9 28 04            jr   z, .collision_detected
 803  8CFB 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 804  8CFD 18 05            jr   .no_conv_collision
 805  8CFF
 806  8CFF              .collision_detected:
 807  8CFF E1               pop  hl
 808  8D00 D1               pop  de
 809  8D01 C1               pop  bc
 810  8D02 37               scf
 811  8D03 C9               ret
 812  8D04
 813  8D04              .no_conv_collision:
 814  8D04 E1               pop  hl
 815  8D05 D1               pop  de
 816  8D06 C1               pop  bc
 817  8D07 B7               or   a
 818  8D08 C9               ret
 819  8D09
 820  8D09              ; -------------------------------------------------------------------
 821  8D09              ; ResetFullGameState
 822  8D09              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 823  8D09              ; per l'avvio di una nuova partita dopo il Game Over.
 824  8D09              ; -------------------------------------------------------------------
 825  8D09              ResetFullGameState:
 826  8D09                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 827  8D09 AF               xor  a
 828  8D0A D3 FE            out  ($fe), a              ; Bordo a nero
 829  8D0C CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 830  8D0F
 831  8D0F                  ; Ripristina il numero di vite iniziali
 832  8D0F 3E 07            ld   a, INITIAL_LIVES
 833  8D11 32 B0 EB         ld   (willy_lives), a
 834  8D14
 835  8D14                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 836  8D14 AF               xor  a
 837  8D15 32 AD EB         ld   (items_collected), a
 838  8D18 32 A9 EB         ld   (body_state), a
 839  8D1B 32 BD EB         ld   (w_warp_state), a
 840  8D1E 32 C0 EB         ld   (w_key_prev), a
 841  8D21 32 C1 EB         ld   (enter_key_prev), a
 842  8D24 32 B1 EB         ld   (velocity_y), a
 843  8D27 32 B3 EB         ld   (jump_pressed), a
 844  8D2A 32 B5 EB         ld   (coyote_timer), a
 845  8D2D 32 B8 EB         ld   (jump_frame), a
 846  8D30 32 B7 EB         ld   (jump_dir), a
 847  8D33 32 2B EF         ld   (transition_active), a
 848  8D36 32 B0 EF         ld   (willy_safety_timer), a

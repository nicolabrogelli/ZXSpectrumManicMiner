  59+ 805E              ; ResetItemsTable
  60+ 805E              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 805E              ; per tutte le stanze registrate in RoomsListTable.
  62+ 805E              ; -------------------------------------------------------------------
  63+ 805E              ResetItemsTable:
  64+ 805E E5               push hl
  65+ 805F D5               push de
  66+ 8060 C5               push bc
  67+ 8061
  68+ 8061 21 7C 73         ld   hl, RoomsListTable
  69+ 8064 06 04            ld   b, NUM_ROOMS
  70+ 8066

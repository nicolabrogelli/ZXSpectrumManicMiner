 121+ 7D29 23               inc  hl
 122+ 7D2A 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7D2B E6 1F            and  31
 124+ 7D2D 87               add  a, a
 124+ 7D2E 87             add a, a
 124+ 7D2F 87             add a, a
 125+ 7D30 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7D33
 127+ 7D33 23               inc  hl
 128+ 7D34 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7D35 E6 1F            and  31
 130+ 7D37 87               add  a, a
 130+ 7D38 87             add a, a
 130+ 7D39 87             add a, a
 131+ 7D3A DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7D3D
 133+ 7D3D 23               inc  hl                        ; Prossimo guardiano
 134+ 7D3E 11 0B 00         ld   de, 11
 135+ 7D41 DD 19            add  ix, de
 136+ 7D43 10 8E            djnz .load_h_loop

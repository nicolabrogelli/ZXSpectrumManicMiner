 208+ 7BAF              .erase_loop:
 209+ 7BAF DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7BB2 E6 80            and  $80               ; Active?
 211+ 7BB4 28 3A            jr   z, .next_erase
 212+ 7BB6
 213+ 7BB6                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7BB6 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7BB9 FE FF            cp   $FF
 216+ 7BBB 28 33            jr   z, .next_erase
 217+ 7BBD

  37+ 7179 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 717B
  39+ 717B                  ; Q è premuto: debounce tramite (q_prev).
  40+ 717B                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 717B 3A E0 EB         ld   a, (q_prev)
  42+ 717E B7               or   a
  43+ 717F 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 7181
  45+ 7181                  ; ── Primo frame di pressione di Q ──

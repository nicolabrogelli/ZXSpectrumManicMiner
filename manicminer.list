 811  89A8              ; CheckWillyConveyorCollision
 812  89A8              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  89A8              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  89A8              ; -------------------------------------------------------------------
 815  89A8              CheckWillyConveyorCollision:
 816  89A8 C5               push bc
 817  89A9 D5               push de
 818  89AA E5               push hl
 819  89AB
 820  89AB                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  89AB CD CB 76         call CheckWillyOnConveyor
 822  89AE 38 49            jr   c, .collision_detected
 823  89B0
 824  89B0                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  89B0 3A C5 E3         ld   a, (conveyor_len)
 826  89B3 B7               or   a
 827  89B4 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  89B6
 829  89B6                  ; B = WillyY, C = WillyX
 830  89B6 ED 4B 9D E0      ld   bc, (PlayerPos)
 831  89BA
 832  89BA                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  89BA 3A C6 E3         ld   a, (conveyor_row)
 834  89BD 87               add  a, a                  ; *2
 835  89BE 87               add  a, a                  ; *4
 836  89BF 87               add  a, a                  ; *8
 837  89C0 5F               ld   e, a                  ; E = ConveyorTop
 838  89C1 C6 07            add  a, 7
 839  89C3 57               ld   d, a                  ; D = ConveyorBottom
 840  89C4
 841  89C4                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  89C4 78               ld   a, b                  ; WillyTop
 843  89C5 BA               cp   d
 844  89C6 28 04            jr   z, .y_overlap
 845  89C8 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  89CA 18 32            jr   .no_conv_collision
 847  89CC
 848  89CC              .y_overlap:
 849  89CC C6 0F            add  a, 15                 ; WillyBottom
 850  89CE BB               cp   e
 851  89CF 28 04            jr   z, .x_check
 852  89D1 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  89D3 18 29            jr   .no_conv_collision
 854  89D5
 855  89D5              .x_check:
 856  89D5                  ; ConveyorLeft = conveyor_col * 8
 857  89D5 3A C7 E3         ld   a, (conveyor_col)
 858  89D8 87               add  a, a                  ; *2
 859  89D9 87               add  a, a                  ; *4
 860  89DA 87               add  a, a                  ; *8
 861  89DB 5F               ld   e, a                  ; E = ConveyorLeft
 862  89DC
 863  89DC                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  89DC 21 C5 E3         ld   hl, conveyor_len
 865  89DF 3A C7 E3         ld   a, (conveyor_col)
 866  89E2 86               add  a, (hl)
 867  89E3 87               add  a, a                  ; *2
 868  89E4 87               add  a, a                  ; *4
 869  89E5 87               add  a, a                  ; *8
 870  89E6 3D               dec  a                     ; ConveyorRight
 871  89E7 57               ld   d, a                  ; D = ConveyorRight
 872  89E8
 873  89E8                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  89E8 79               ld   a, c                  ; WillyLeft
 875  89E9 BA               cp   d
 876  89EA 28 04            jr   z, .x_overlap
 877  89EC 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  89EE 18 0E            jr   .no_conv_collision
 879  89F0
 880  89F0              .x_overlap:
 881  89F0 C6 0F            add  a, 15                 ; WillyRight
 882  89F2 BB               cp   e
 883  89F3 28 04            jr   z, .collision_detected
 884  89F5 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  89F7 18 05            jr   .no_conv_collision
 886  89F9

 286+ 7E59              ; -------------------------------------------------------------------
 287+ 7E59              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 288+ 7E59              ; -------------------------------------------------------------------
 289+ 7E59              CheckEnemyWillyOverlap:
 290+ 7E59 3A A4 E4         ld   a, (player_drawn_pos+1)
 291+ 7E5C FE FF            cp   $FF
 292+ 7E5E C8               ret  z                  ; Se Willy non è disegnato, esci
 293+ 7E5F
 294+ 7E5F                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 295+ 7E5F 3A A3 E4         ld   a, (player_drawn_pos)
 296+ 7E62 E6 F8            and  $F8
 297+ 7E64 5F               ld   e, a               ; E = WillyX & $F8
 298+ 7E65 79               ld   a, c
 299+ 7E66 E6 F8            and  $F8                ; A = EnemyX & $F8
 300+ 7E68 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 301+ 7E69 C6 10            add  a, 16
 302+ 7E6B FE 19            cp   25
 303+ 7E6D D0               ret  nc                 ; Fuori portata X
 304+ 7E6E
 305+ 7E6E                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 306+ 7E6E 3A A4 E4         ld   a, (player_drawn_pos+1) ; A = WillyY
 307+ 7E71 90               sub  b                  ; A = WillyY - EnemyY
 308+ 7E72 C6 0F            add  a, 15
 309+ 7E74 FE 1F            cp   31
 310+ 7E76 D0               ret  nc                 ; Fuori portata Y
 311+ 7E77
 312+ 7E77                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 313+ 7E77 3E 01            ld   a, 1
 314+ 7E79 32 AA E4         ld   (willy_needs_redraw), a
 315+ 7E7C C9               ret

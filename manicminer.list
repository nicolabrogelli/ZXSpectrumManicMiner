 405+ 6FE4                  ; Salva coordinate (C = X, B = Y)
 406+ 6FE4 ED 43 DA DF      ld   (PlayerPos), bc
 407+ 6FE8 ED 43 DC DF      ld   (PlayerPosOld), bc

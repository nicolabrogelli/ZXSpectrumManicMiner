 368+ 700C 23               inc  hl                        ; Byte 3 (Airborne)
 369+ 700D 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 370+ 700E 4E               ld   c, (hl)
 371+ 700F 23               inc  hl                        ; Byte 5 (AttrAddr High)
 372+ 7010 7E               ld   a, (hl)

  96+ 7D74 87             add a, a
  96+ 7D75 87             add a, a
  97+ 7D76 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7D79
  99+ 7D79                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7D79 CB 3C            srl  h
 100+ 7D7B CB 1D          rr l
 101+ 7D7D CB 3C            srl  h
 101+ 7D7F CB 1D          rr l

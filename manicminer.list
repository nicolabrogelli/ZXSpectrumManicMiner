 316+ 7BE4              ; Enemy_DrawSingleSlot
 317+ 7BE4              ;
 318+ 7BE4              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7BE4              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7BE4              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7BE4              ; -------------------------------------------------------------------
 322+ 7BE4              Enemy_DrawSingleSlot:
 323+ 7BE4 C5               push bc
 324+ 7BE5 D5               push de
 325+ 7BE6 E5               push hl
 326+ 7BE7 DD E5            push ix
 327+ 7BE9
 328+ 7BE9                  ; 1. Determina il frame di animazione (0..7)
 329+ 7BE9                  ; Nei dati di Manic Miner:
 330+ 7BE9                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7BE9                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7BE9 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7BEC E6 03            and  3
 334+ 7BEE 47               ld   b, a                      ; B = Anim subframe
 335+ 7BEF
 336+ 7BEF DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7BF2 FE 01            cp   1                         ; Sinistra?
 338+ 7BF4 28 03            jr   z, .left_frames
 339+ 7BF6
 340+ 7BF6                  ; Movimento a Destra: Frame 0..3
 341+ 7BF6 78               ld   a, b
 342+ 7BF7 18 03            jr   .got_frame_idx
 343+ 7BF9
 344+ 7BF9              .left_frames:
 345+ 7BF9                  ; Movimento a Sinistra: Frame 4..7
 346+ 7BF9 3E 04            ld   a, 4
 347+ 7BFB 80               add  a, b
 348+ 7BFC
 349+ 7BFC              .got_frame_idx:
 350+ 7BFC                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7BFC 6F               ld   l, a
 352+ 7BFD 26 00            ld   h, 0
 353+ 7BFF 29               add  hl, hl                    ; *2
 354+ 7C00 29               add  hl, hl                    ; *4
 355+ 7C01 29               add  hl, hl                    ; *8
 356+ 7C02 29               add  hl, hl                    ; *16
 357+ 7C03 29               add  hl, hl                    ; *32
 358+ 7C04
 359+ 7C04 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7C07 19               add  hl, de
 361+ 7C08 ED 5B 14 92      ld   de, (room_ptr)
 362+ 7C0C 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7C0D E5               push hl
 364+ 7C0E DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7C10
 366+ 7C10                  ; 2. Coordinate e colore
 367+ 7C10 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7C12 FD E5            push iy
 369+ 7C14
 370+ 7C14 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7C17 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7C1A FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7C1D
 374+ 7C1D                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7C1D CD 38 5F         call Gfx_DrawPixelSprite16x16
 376+ 7C20 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7C23 CD BB 6A         call Gfx_SetEnemyColorAttributes
 378+ 7C26
 379+ 7C26 DD E1            pop  ix
 380+ 7C28 E1               pop  hl
 381+ 7C29 D1               pop  de
 382+ 7C2A C1               pop  bc
 383+ 7C2B C9               ret

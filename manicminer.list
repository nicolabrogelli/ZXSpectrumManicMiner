   8+ 81BB              ; Audio_UpdateJumpSound
   9+ 81BB              ;
  10+ 81BB              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 81BB              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 81BB              ; -------------------------------------------------------------------
  13+ 81BB              Audio_UpdateJumpSound:
  14+ 81BB F5               push af
  15+ 81BC C5               push bc
  16+ 81BD D5               push de
  17+ 81BE E5               push hl
  18+ 81BF
  19+ 81BF                  ; Controlla se il suono è attivo (note < 18)
  20+ 81BF 3A F0 9A         ld   a, (Audio_jump_sound_note)
  21+ 81C2 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 81C4 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 81C6
  24+ 81C6                  ; Carica la nota corrente da suonare
  25+ 81C6 5F               ld   e, a
  26+ 81C7 16 00            ld   d, 0
  27+ 81C9 21 F5 81         ld   hl, Audio_JumpSoundDelays
  28+ 81CC 19               add  hl, de
  29+ 81CD 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 81CE 57               ld   d, a                      ; D = delay della nota
  31+ 81CF
  32+ 81CF                  ; Suona la nota: 15 cicli
  33+ 81CF 06 0F            ld   b, 15
  34+ 81D1              .note_loop:
  35+ 81D1                  ; Speaker ON
  36+ 81D1 3A E3 94         ld   a, (room_border_color)
  37+ 81D4 F6 10            or   $10
  38+ 81D6 D3 FE            out  ($fe), a
  39+ 81D8 4A               ld   c, d
  40+ 81D9              .d1:
  41+ 81D9 0D               dec  c
  42+ 81DA 20 FD            jr   nz, .d1
  43+ 81DC
  44+ 81DC                  ; Speaker OFF
  45+ 81DC 3A E3 94         ld   a, (room_border_color)
  46+ 81DF E6 EF            and  $ef
  47+ 81E1 D3 FE            out  ($fe), a
  48+ 81E3 4A               ld   c, d
  49+ 81E4              .d2:
  50+ 81E4 0D               dec  c
  51+ 81E5 20 FD            jr   nz, .d2
  52+ 81E7
  53+ 81E7 10 E8            djnz .note_loop
  54+ 81E9
  55+ 81E9                  ; Passa alla nota successiva
  56+ 81E9 3A F0 9A         ld   a, (Audio_jump_sound_note)
  57+ 81EC 3C               inc  a
  58+ 81ED 32 F0 9A         ld   (Audio_jump_sound_note), a
  59+ 81F0
  60+ 81F0              .done:
  61+ 81F0 E1               pop  hl
  62+ 81F1 D1               pop  de
  63+ 81F2 C1               pop  bc
  64+ 81F3 F1               pop  af
  65+ 81F4 C9               ret
  66+ 81F5
  67+ 81F5              Audio_JumpSoundDelays:
  68+ 81F5 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 81F9 19 13 0C 06
  68+ 81FD 0C 13 19 20
  68+ 8201 26 2D 33 3A
  68+ 8205 40 47
  69+ 8207

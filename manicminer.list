1815+ 67A9 C6 30            add  a, '0'
1816+ 67AB 77               ld   (hl), a
1817+ 67AC 23               inc  hl
1818+ 67AD
1819+ 67AD                  ; Cifra 1 (decine di migliaia)
1820+ 67AD DD 7E 02         ld   a, (ix+2)
1821+ 67B0 E6 0F            and  $0f
1822+ 67B2 C6 30            add  a, '0'
1823+ 67B4 77               ld   (hl), a
1824+ 67B5 23               inc  hl
1825+ 67B6
1826+ 67B6                  ; Cifra 2 (migliaia)
1827+ 67B6 DD 7E 01         ld   a, (ix+1)
1828+ 67B9 0F               rrca
1829+ 67BA 0F               rrca
1830+ 67BB 0F               rrca
1831+ 67BC 0F               rrca
1832+ 67BD E6 0F            and  $0f
1833+ 67BF C6 30            add  a, '0'
1834+ 67C1 77               ld   (hl), a
1835+ 67C2 23               inc  hl
1836+ 67C3
1837+ 67C3                  ; Cifra 3 (centinaia)
1838+ 67C3 DD 7E 01         ld   a, (ix+1)
1839+ 67C6 E6 0F            and  $0f
1840+ 67C8 C6 30            add  a, '0'
1841+ 67CA 77               ld   (hl), a
1842+ 67CB 23               inc  hl
1843+ 67CC
1844+ 67CC                  ; Cifra 4 (decine)
1845+ 67CC DD 7E 00         ld   a, (ix+0)
1846+ 67CF 0F               rrca
1847+ 67D0 0F               rrca
1848+ 67D1 0F               rrca
1849+ 67D2 0F               rrca
1850+ 67D3 E6 0F            and  $0f
1851+ 67D5 C6 30            add  a, '0'
1852+ 67D7 77               ld   (hl), a
1853+ 67D8 23               inc  hl
1854+ 67D9
1855+ 67D9                  ; Cifra 5 (unità)
1856+ 67D9 DD 7E 00         ld   a, (ix+0)
1857+ 67DC E6 0F            and  $0f
1858+ 67DE C6 30            add  a, '0'
1859+ 67E0 77               ld   (hl), a
1860+ 67E1 23               inc  hl
1861+ 67E2 C9               ret

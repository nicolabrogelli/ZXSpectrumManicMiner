 472  8596 CD 86 80         call Items_ResetCurrentRoomItems
 473  8599
 474  8599                  ; - Ripristina le vite di Willy al valore iniziale
 475  8599 3E 07            ld   a, INITIAL_LIVES
 476  859B 32 3F 9E         ld   (willy_lives), a

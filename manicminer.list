 455  8954 28 F6            jr   z, .wait_continue_release
 456  8956
 457  8956                  ; 5b. Ripristina lo stato per continuare la partita:
 458  8956                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 459  8956 CD 2F 84         call Items_ResetCurrentRoomItems
 460  8959
 461  8959                  ; - Ripristina le vite di Willy al valore iniziale
 462  8959 3E 07            ld   a, INITIAL_LIVES
 463  895B 32 1F E2         ld   (willy_lives), a
 464  895E
 465  895E                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 466  895E 2A 33 E2         ld   hl, (counter)
 467  8961 22 36 E2         ld   (last_frame_counter), hl
 468  8964
 469  8964                  ; - Reimposta la fisica e le variabili di stato di Willy
 470  8964 AF               xor  a
 471  8965 32 20 E2         ld   (velocity_y), a
 472  8968 32 22 E2         ld   (jump_pressed), a
 473  896B 32 24 E2         ld   (coyote_timer), a
 474  896E 32 27 E2         ld   (jump_frame), a
 475  8971 32 26 E2         ld   (jump_dir), a
 476  8974 32 18 E2         ld   (body_state), a
 477  8977 32 2B E2         ld   (w_warp_state), a
 478  897A 32 2E E2         ld   (w_key_prev), a
 479  897D 32 2F E2         ld   (enter_key_prev), a
 480  8980 32 1B E2         ld   (collision_active), a
 481  8983 32 1A E2         ld   (flags), a
 482  8986 32 14 E6         ld   (ramp_entry_guard), a
 483  8989 32 20 E6         ld   (willy_on_ramp), a
 484  898C 32 1F E6         ld   (willy_needs_redraw), a
 485  898F 3E FF            ld   a, $ff
 486  8991 32 30 E2         ld   (digit_key_prev), a
 487  8994 32 19 E6         ld   (player_drawn_pos+1), a
 488  8997 32 1A E6         ld   (player_old_dir), a
 489  899A 32 1B E6         ld   (player_old_body), a
 490  899D 3E 01            ld   a, 1
 491  899F 32 29 E2         ld   (q_prev), a
 492  89A2 32 2A E2         ld   (a_prev), a
 493  89A5 32 21 E2         ld   (on_ground), a
 494  89A8 32 1C E6         ld   (enemy_was_updated), a
 495  89AB
 496  89AB                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 497  89AB 3E 00            ld   a, RESPAWN_SAFETY_TIME
 498  89AD 32 1E E6         ld   (willy_safety_timer), a
 499  89B0
 500  89B0                  ; - Ripristina lo stato audio
 501  89B0 3E 12            ld   a, 18
 502  89B2 32 31 E8         ld   (Audio_jump_sound_note), a
 503  89B5 AF               xor  a
 504  89B6 32 32 E8         ld   (Audio_jump_sound_timer), a
 505  89B9                  IF ENABLE_MUSIC != 0
 506  89B9 ~                ld   (Audio_music_note_idx), a
 507  89B9 ~                ld   a, 1
 508  89B9 ~                ld   (Audio_music_frame_counter), a
 509  89B9                  ENDIF
 510  89B9
 511  89B9                  ; - Riposiziona Willy nel punto di default definito nella stanza
 512  89B9 AF               xor  a
 513  89BA 32 99 E5         ld   (transition_active), a
 514  89BD
 515  89BD                  ; - Cancella lo schermo a nero prima del caricamento
 516  89BD AF               xor  a
 517  89BE D3 FE            out  ($fe), a
 518  89C0 CD 9D 62         call Gfx_ClearScreenDirect
 519  89C3
 520  89C3                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 521  89C3 C3 61 87         jp   LoadRoomAndRestart
 522  89C6
 523  89C6              ; -------------------------------------------------------------------
 524  89C6              ; TriggerVictory
 525  89C6              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 526  89C6              ; - Pulisce gli elementi di gioco della stanza.
 527  89C6              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 528  89C6              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 529  89C6              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 530  89C6              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 531  89C6              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 532  89C6              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 533  89C6              ; -------------------------------------------------------------------
 534  89C6              TriggerVictory:
 535  89C6                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 536  89C6 CD F7 66         call Gfx_DrawVictoryScreen
 537  89C9
 538  89C9                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 539  89C9              .wait_keys_release:
 540  89C9 76               halt
 541  89CA                  ; Controlla tasto Y (Porta $DF, bit 4)
 542  89CA 01 FE DF         ld   bc, $dffe
 543  89CD ED 78            in   a, (c)
 544  89CF CB 67            bit  4, a
 545  89D1 28 F6            jr   z, .wait_keys_release
 546  89D3
 547  89D3                  ; Controlla tasto N (Porta $7F, bit 3)
 548  89D3 01 FE 7F         ld   bc, $7ffe
 549  89D6 ED 78            in   a, (c)
 550  89D8 CB 5F            bit  3, a
 551  89DA 28 ED            jr   z, .wait_keys_release
 552  89DC
 553  89DC                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 554  89DC 01 FE BF         ld   bc, $bffe
 555  89DF ED 78            in   a, (c)
 556  89E1 CB 47            bit  0, a
 557  89E3 28 E4            jr   z, .wait_keys_release
 558  89E5
 559  89E5                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 560  89E5 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 561  89E7              .wait_choice_loop:
 562  89E7 76               halt
 563  89E8
 564  89E8                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 565  89E8 0C               inc  c
 566  89E9 79               ld   a, c
 567  89EA CB 3F            srl  a
 568  89EC CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 569  89EE E6 07            and  7
 570  89F0 5F               ld   e, a
 571  89F1 16 00            ld   d, 0
 572  89F3 21 11 66         ld   hl, victory_color_table
 573  89F6 19               add  hl, de
 574  89F7 7E               ld   a, (hl)               ; A = nuovo colore attributo
 575  89F8 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 576  89FB 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 577  89FD              .color_cycle_loop:
 578  89FD 77               ld   (hl), a
 579  89FE 23               inc  hl
 580  89FF 10 FC            djnz .color_cycle_loop
 581  8A01
 582  8A01                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 583  8A01 01 FE DF         ld   bc, $dffe
 584  8A04 ED 78            in   a, (c)
 585  8A06 CB 67            bit  4, a
 586  8A08 28 2A            jr   z, .play_again_chosen
 587  8A0A
 588  8A0A                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 589  8A0A 01 FE 7F         ld   bc, $7ffe
 590  8A0D ED 78            in   a, (c)
 591  8A0F CB 5F            bit  3, a
 592  8A11 28 0B            jr   z, .quit_chosen
 593  8A13
 594  8A13                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 595  8A13 01 FE BF         ld   bc, $bffe
 596  8A16 ED 78            in   a, (c)
 597  8A18 CB 47            bit  0, a
 598  8A1A 28 02            jr   z, .quit_chosen
 599  8A1C
 600  8A1C 18 C9            jr   .wait_choice_loop
 601  8A1E
 602  8A1E              .quit_chosen:
 603  8A1E                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 604  8A1E              .wait_quit_release:
 605  8A1E 76               halt
 606  8A1F 01 FE 7F         ld   bc, $7ffe
 607  8A22 ED 78            in   a, (c)
 608  8A24 CB 5F            bit  3, a
 609  8A26 28 F6            jr   z, .wait_quit_release
 610  8A28 01 FE BF         ld   bc, $bffe
 611  8A2B ED 78            in   a, (c)
 612  8A2D CB 47            bit  0, a
 613  8A2F 28 ED            jr   z, .wait_quit_release
 614  8A31
 615  8A31                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 616  8A31 C3 9A 88         jp   ShowTitleScreen
 617  8A34
 618  8A34              .play_again_chosen:
 619  8A34                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 620  8A34              .wait_play_again_release:
 621  8A34 76               halt
 622  8A35 01 FE DF         ld   bc, $dffe
 623  8A38 ED 78            in   a, (c)
 624  8A3A CB 67            bit  4, a
 625  8A3C 28 F6            jr   z, .wait_play_again_release
 626  8A3E
 627  8A3E                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 628  8A3E CD 78 8B         call ResetFullGameState
 629  8A41 C3 61 87         jp   LoadRoomAndRestart
 630  8A44
 631  8A44              ; -------------------------------------------------------------------
 632  8A44              ; CheckPortalTransition
 633  8A44              ; Verifica le condizioni per accedere alla stanza successiva:
 634  8A44              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 635  8A44              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 636  8A44              ;
 637  8A44              ; Output:
 638  8A44              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 639  8A44              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 640  8A44              ; -------------------------------------------------------------------
 641  8A44              CheckPortalTransition:
 642  8A44 C5               push bc
 643  8A45 D5               push de
 644  8A46 E5               push hl
 645  8A47
 646  8A47                  ; 1. Tutti gli item della stanza sono stati raccolti?
 647  8A47 CD 0B 8B         call CheckAllItemsCollected
 648  8A4A 30 4D            jr   nc, .no_transition
 649  8A4C
 650  8A4C                  ; 2. Willy collide con il portale (16x16 pixel)?
 651  8A4C                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 652  8A4C                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 653  8A4C 2A 93 E5         ld   hl, (room_ptr)
 654  8A4F 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 655  8A52 19               add  hl, de
 656  8A53 4E               ld   c, (hl)
 657  8A54 23               inc  hl
 658  8A55 46               ld   b, (hl)                   ; BC = AttrAddr
 659  8A56
 660  8A56                  ; Offset = BC - 23552
 661  8A56 60               ld   h, b
 662  8A57 69               ld   l, c
 663  8A58 01 00 A4         ld   bc, -23552
 664  8A5B 09               add  hl, bc
 665  8A5C
 666  8A5C                  ; PortalX = (Offset & 31) * 8
 667  8A5C 7D               ld   a, l
 668  8A5D E6 1F            and  31
 669  8A5F 87               add  a, a
 669  8A60 87             add a, a
 669  8A61 87             add a, a
 670  8A62 5F               ld   e, a                      ; E = PortalX (0..248)
 671  8A63
 672  8A63                  ; PortalY = (Offset / 32) * 8
 673  8A63 CB 3C            srl  h
 673  8A65 CB 1D          rr l
 674  8A67 CB 3C            srl  h
 674  8A69 CB 1D          rr l
 675  8A6B CB 3C            srl  h
 675  8A6D CB 1D          rr l
 676  8A6F CB 3C            srl  h
 676  8A71 CB 1D          rr l
 677  8A73 CB 3C            srl  h
 677  8A75 CB 1D          rr l
 678  8A77 7D               ld   a, l
 679  8A78 87               add  a, a
 679  8A79 87             add a, a
 679  8A7A 87             add a, a
 680  8A7B 57               ld   d, a                      ; D = PortalY (0..120)
 681  8A7C
 682  8A7C                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 683  8A7C ED 4B 12 E2      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 684  8A80
 685  8A80                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 686  8A80 7B               ld   a, e
 687  8A81 91               sub  c
 688  8A82 30 02            jr   nc, .x_diff_pos
 689  8A84 ED 44            neg
 690  8A86              .x_diff_pos:
 691  8A86 FE 0C            cp   12
 692  8A88 30 0F            jr   nc, .no_transition
 693  8A8A
 694  8A8A                  ; Controllo verticale: |WillyY - PortalY| < 14
 695  8A8A 7A               ld   a, d
 696  8A8B 90               sub  b
 697  8A8C 30 02            jr   nc, .y_diff_pos
 698  8A8E ED 44            neg
 699  8A90              .y_diff_pos:
 700  8A90 FE 0E            cp   14
 701  8A92 30 05            jr   nc, .no_transition
 702  8A94
 703  8A94                  ; Transizione al portale attiva!
 704  8A94 E1               pop  hl
 705  8A95 D1               pop  de
 706  8A96 C1               pop  bc
 707  8A97 37               scf
 708  8A98 C9               ret
 709  8A99
 710  8A99              .no_transition:
 711  8A99 E1               pop  hl
 712  8A9A D1               pop  de
 713  8A9B C1               pop  bc
 714  8A9C B7               or   a
 715  8A9D C9               ret
 716  8A9E
 717  8A9E              ; Alias per retrocompatibilità
 718  8A9E              CheckVictoryCondition: EQU CheckPortalTransition
 719  8A9E
 720  8A9E              ; -------------------------------------------------------------------
 721  8A9E              ; TriggerPortalTransition
 722  8A9E              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 723  8A9E              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 724  8A9E              ; - Avanza all'indice della stanza successiva.
 725  8A9E              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 726  8A9E              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 727  8A9E              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 728  8A9E              ; -------------------------------------------------------------------
 729  8A9E              TriggerPortalTransition:
 730  8A9E                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 731  8A9E CD D5 8A         call Air_DepleteCountdown
 732  8AA1
 733  8AA1                  ; 1. Determina l'ID della stanza corrente
 734  8AA1 CD DD 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8AA4
 736  8AA4                  ; 2. Calcola l'indice della stanza successiva
 737  8AA4 3A 38 E5         ld   a, (current_room)
 738  8AA7 3C               inc  a
 739  8AA8 FE 14            cp   NUM_ROOMS
 740  8AAA 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8AAC
 742  8AAC                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8AAC 21 19 73         ld   hl, RoomsListTable
 744  8AAF 5F               ld   e, a
 745  8AB0 16 00            ld   d, 0
 746  8AB2 19               add  hl, de
 747  8AB3 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8AB4 5E               ld   e, (hl)
 749  8AB5 23               inc  hl
 750  8AB6 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8AB7 ED 53 93 E5      ld   (room_ptr), de
 752  8ABB
 753  8ABB                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8ABB AF               xor  a
 755  8ABC 32 99 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8ABF 32 20 E2         ld   (velocity_y), a
 757  8AC2 32 2B E8         ld   (game_objective_completed), a
 758  8AC5 3E 01            ld   a, 1
 759  8AC7 32 21 E2         ld   (on_ground), a
 760  8ACA
 761  8ACA                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8ACA 3E 07            ld   a, $07
 763  8ACC CD 9D 62         call Gfx_ClearScreenDirect
 764  8ACF
 765  8ACF C3 61 87         jp   LoadRoomAndRestart
 766  8AD2
 767  8AD2              .all_rooms_completed:
 768  8AD2                  ; Tutte le stanze sono state completate con successo!
 769  8AD2                  IF ENABLE_VICTORY_SCREEN != 0
 770  8AD2 C3 C6 89         jp   TriggerVictory
 771  8AD5                  ELSE
 772  8AD5 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8AD5 ~                ld   de, (RoomsListTable)
 774  8AD5 ~                ld   (room_ptr), de
 775  8AD5 ~                xor  a
 776  8AD5 ~                ld   (transition_active), a
 777  8AD5 ~                ld   (velocity_y), a
 778  8AD5 ~                ld   (game_objective_completed), a
 779  8AD5 ~                ld   a, 1
 780  8AD5 ~                ld   (on_ground), a
 781  8AD5 ~                ld   a, $07
 782  8AD5 ~                call Gfx_ClearScreenDirect
 783  8AD5 ~                jp   LoadRoomAndRestart
 784  8AD5                  ENDIF
 785  8AD5
 786  8AD5              ; -------------------------------------------------------------------
 787  8AD5              ; Air_DepleteCountdown
 788  8AD5              ; Animazione originale di completamento livello (Manic Miner):
 789  8AD5              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 790  8AD5              ; - Ad ogni pixel decrementato:
 791  8AD5              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 792  8AD5              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 793  8AD5              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 794  8AD5              ; -------------------------------------------------------------------
 795  8AD5              Air_DepleteCountdown:
 796  8AD5 F5               push af
 797  8AD6 C5               push bc
 798  8AD7 D5               push de
 799  8AD8 E5               push hl
 800  8AD9
 801  8AD9              .countdown_loop:
 802  8AD9 3A 33 E8         ld   a, (air_pixels)
 803  8ADC B7               or   a
 804  8ADD 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 805  8ADF
 806  8ADF 3D               dec  a
 807  8AE0 32 33 E8         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 808  8AE3
 809  8AE3                  ; Aggiorna la barra grafica dell'aria
 810  8AE3 CD 27 6A         call Gfx_UpdateAirBar
 811  8AE6
 812  8AE6                  ; Aggiungi 1 punto allo score
 813  8AE6 CD 51 86         call Score_Add1Point
 814  8AE9
 815  8AE9                  ; Genera l'effetto sonoro originale di Manic Miner:
 816  8AE9                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 817  8AE9 3A 33 E8         ld   a, (air_pixels)
 818  8AEC 2F               cpl
 819  8AED E6 3F            and  63
 820  8AEF 07               rlca
 821  8AF0 3C               inc  a
 822  8AF1 57               ld   d, a                      ; D = ritardo semionda audio
 823  8AF2
 824  8AF2 0E 03            ld   c, 3                      ; Durata impulso
 825  8AF4              .audio_loop:
 826  8AF4 AF               xor  a
 827  8AF5 D3 FE            out  ($fe), a
 828  8AF7 42               ld   b, d
 829  8AF8 10 FE        .w1: djnz .w1
 830  8AFA
 831  8AFA 3E 18            ld   a, $18
 832  8AFC D3 FE            out  ($fe), a
 833  8AFE 42               ld   b, d
 834  8AFF 10 FE        .w2: djnz .w2
 835  8B01
 836  8B01 0D               dec  c
 837  8B02 20 F0            jr   nz, .audio_loop
 838  8B04
 839  8B04 18 D3            jr   .countdown_loop
 840  8B06
 841  8B06              .done_countdown:
 842  8B06 E1               pop  hl
 843  8B07 D1               pop  de
 844  8B08 C1               pop  bc
 845  8B09 F1               pop  af
 846  8B0A C9               ret
 847  8B0B
 848  8B0B              ; -------------------------------------------------------------------
 849  8B0B              ; CheckAllItemsCollected
 850  8B0B              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 851  8B0B              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 852  8B0B              ; -------------------------------------------------------------------
 853  8B0B              CheckAllItemsCollected:
 854  8B0B 3A 2B E8         ld   a, (game_objective_completed)
 855  8B0E B7               or   a
 856  8B0F 20 08            jr   nz, .all_collected
 857  8B11 3A 92 E5         ld   a, (num_room_items)
 858  8B14 B7               or   a
 859  8B15 28 02            jr   z, .all_collected
 860  8B17 B7               or   a
 861  8B18 C9               ret
 862  8B19              .all_collected:
 863  8B19 37               scf
 864  8B1A C9               ret
 865  8B1B
 866  8B1B              ; -------------------------------------------------------------------
 867  8B1B              ; CheckInMasterBedroom (alias per retrocompatibilità)
 868  8B1B              ; -------------------------------------------------------------------
 869  8B1B              CheckInMasterBedroom:
 870  8B1B 37               scf
 871  8B1C C9               ret
 872  8B1D
 873  8B1D              ; -------------------------------------------------------------------
 874  8B1D              ; CheckWillyConveyorCollision
 875  8B1D              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 876  8B1D              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 877  8B1D              ; -------------------------------------------------------------------
 878  8B1D              CheckWillyConveyorCollision:
 879  8B1D C5               push bc
 880  8B1E D5               push de
 881  8B1F E5               push hl
 882  8B20
 883  8B20                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 884  8B20 CD FF 76         call CheckWillyOnConveyor

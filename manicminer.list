  72+ 8713 ~            ; Audio_UpdateMusic
  73+ 8713 ~            ;
  74+ 8713 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8713 ~            ; Viene chiamata a ogni frame.
  76+ 8713 ~            ; -------------------------------------------------------------------
  77+ 8713 ~            Audio_UpdateMusic:
  78+ 8713 ~                push af
  79+ 8713 ~                push bc
  80+ 8713 ~                push de
  81+ 8713 ~                push hl
  82+ 8713 ~
  83+ 8713 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8713 ~                ld   a, (Audio_jump_sound_note)
  85+ 8713 ~                cp   18
  86+ 8713 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8713 ~
  88+ 8713 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8713 ~                ld   a, (Audio_music_frame_counter)
  90+ 8713 ~                dec  a
  91+ 8713 ~                ld   (Audio_music_frame_counter), a
  92+ 8713 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8713 ~
  94+ 8713 ~                ; Altrimenti carica la nota successiva
  95+ 8713 ~                ld   a, (Audio_music_note_idx)
  96+ 8713 ~                inc  a
  97+ 8713 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8713 ~                jr   c, .no_wrap
  99+ 8713 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8713 ~            .no_wrap:
 101+ 8713 ~                ld   (Audio_music_note_idx), a
 102+ 8713 ~
 103+ 8713 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8713 ~                ld   e, a
 105+ 8713 ~                ld   d, 0
 106+ 8713 ~                ld   hl, Audio_MusicSheet
 107+ 8713 ~                add  hl, de
 108+ 8713 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8713 ~
 110+ 8713 ~                ; Leggi durata (secondo byte)
 111+ 8713 ~                inc  hl
 112+ 8713 ~                ld   a, (hl)
 113+ 8713 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8713 ~                jr   nz, .dur_ok
 115+ 8713 ~                ld   a, 1
 116+ 8713 ~            .dur_ok:
 117+ 8713 ~                ld   (Audio_music_frame_counter), a
 118+ 8713 ~
 119+ 8713 ~            .play_current_note:
 120+ 8713 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8713 ~                ld   a, (Audio_music_note_idx)
 122+ 8713 ~                ld   e, a
 123+ 8713 ~                ld   d, 0
 124+ 8713 ~                ld   hl, Audio_MusicSheet
 125+ 8713 ~                add  hl, de
 126+ 8713 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8713 ~                ld   a, (hl)                  ; A = delay
 128+ 8713 ~                or   a
 129+ 8713 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8713 ~
 131+ 8713 ~                ; Suona la nota: 2 cicli
 132+ 8713 ~                ld   d, a                     ; D = delay
 133+ 8713 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8713 ~            .note_loop:
 135+ 8713 ~                ; Speaker ON
 136+ 8713 ~                ld   a, (room_border_color)
 137+ 8713 ~                or   $10
 138+ 8713 ~                out  ($fe), a
 139+ 8713 ~                ld   c, d
 140+ 8713 ~            .d1:
 141+ 8713 ~                push af
 142+ 8713 ~                pop  af
 143+ 8713 ~                dec  c
 144+ 8713 ~                jr   nz, .d1
 145+ 8713 ~
 146+ 8713 ~                ; Speaker OFF
 147+ 8713 ~                ld   a, (room_border_color)
 148+ 8713 ~                and  $ef
 149+ 8713 ~                out  ($fe), a
 150+ 8713 ~                ld   c, d
 151+ 8713 ~            .d2:
 152+ 8713 ~                push af
 153+ 8713 ~                pop  af
 154+ 8713 ~                dec  c
 155+ 8713 ~                jr   nz, .d2
 156+ 8713 ~
 157+ 8713 ~                djnz .note_loop
 158+ 8713 ~
 159+ 8713 ~            .done:
 160+ 8713 ~                pop  hl
 161+ 8713 ~                pop  de
 162+ 8713 ~                pop  bc
 163+ 8713 ~                pop  af
 164+ 8713 ~                ret
 165+ 8713 ~
 166+ 8713 ~            Audio_MusicSheet:
 167+ 8713 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8713 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8713 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8713 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8713 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5

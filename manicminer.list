   1+ 7C5D              ;===========================================================================
   2+ 7C5D              ; enemy.asm
   3+ 7C5D              ;
   4+ 7C5D              ; Gestione dei Guardiani (Nemici) per Manic Miner.
   5+ 7C5D              ; I dati e le sprite dei guardiani (8 frame da 16x16 pixel) sono definiti
   6+ 7C5D              ; direttamente all'interno della stanza (OFFSET_H_GUARDIANS, OFFSET_V_GUARDIANS,
   7+ 7C5D              ; OFFSET_GUARDIAN_GRAPHICS).
   8+ 7C5D              ;===========================================================================
   9+ 7C5D
  10+ 7C5D              ; -------------------------------------------------------------------
  11+ 7C5D              ; Struttura dati per i nemici attivi della stanza corrente (RAM)
  12+ 7C5D              ; 8 slot, 11 byte ciascuno:
  13+ 7C5D              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7C5D              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C5D              ; Offset 2: Current X
  16+ 7C5D              ; Offset 3: Current Y
  17+ 7C5D              ; Offset 4: Min Limit
  18+ 7C5D              ; Offset 5: Max Limit
  19+ 7C5D              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)

 138+ 7DE6              .done_h_guardians:
 139+ 7DE6                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DE6 2A C1 AE         ld   hl, (room_ptr)
 141+ 7DE9 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DEC 19               add  hl, de
 143+ 7DED 7E               ld   a, (hl)
 144+ 7DEE FE FF            cp   $FF
 145+ 7DF0 28 0A            jr   z, .done_v_guardians
 146+ 7DF2 B7               or   a
 147+ 7DF3 28 07            jr   z, .done_v_guardians
 148+ 7DF5
 149+ 7DF5                  ; Slot attivo per guardiano verticale
 150+ 7DF5 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DF9 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DFC                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DFC
 154+ 7DFC              .done_v_guardians:
 155+ 7DFC DD E1            pop  ix
 156+ 7DFE C1               pop  bc
 157+ 7DFF D1               pop  de
 158+ 7E00 E1               pop  hl
 159+ 7E01 C9               ret

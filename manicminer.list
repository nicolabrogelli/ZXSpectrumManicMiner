1119+ 74B3 4F               ld   c, a              ; C = c (Col)
1120+ 74B4
1121+ 74B4                  ; Se la cella è sulla rampa, non considerarla un muro!
1122+ 74B4 53               ld   d, e              ; D = Row
1123+ 74B5 59               ld   e, c              ; E = Col
1124+ 74B6 CD 22 74         call IsCellOnRamp
1125+ 74B9 38 09            jr   c, .not_wall
1126+ 74BB
1127+ 74BB 7A               ld   a, d              ; A = Row

 138+ 810B              ; Items_DrawRoom
 139+ 810B              ;
 140+ 810B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 810B              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 810B              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 810B              ;
 144+ 810B              ; Record item nella stanza (5 byte):
 145+ 810B              ;   +0 Color / Attributo
 146+ 810B              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 810B              ;   +2 Attr Address High

 519+ 800E 18 23            jr   .got_frame_idx
 520+ 8010
 521+ 8010              .h_use_second_half:
 522+ 8010              .left_frames:
 523+ 8010                  ; Movimento a Sinistra (o orizzontale in stanze con guardiani verticali): Frame 7..4 (seconda metà invertita)
 524+ 8010 3E 07            ld   a, 7
 525+ 8012 93               sub  e
 526+ 8013 18 1E            jr   .got_frame_idx

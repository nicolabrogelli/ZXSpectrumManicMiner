 408+ 820A              ; CheckWillyItemCollision
 409+ 820A              ;
 410+ 820A              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 820A              ; Input:
 412+ 820A              ;   A = Item Col (0..31)
 413+ 820A              ;   H = Item Row (0..15)
 414+ 820A              ; Output:
 415+ 820A              ;   Carry Set = Collisione
 416+ 820A              ;   Carry Clear = Nessuna collisione
 417+ 820A              ; -------------------------------------------------------------------
 418+ 820A              CheckWillyItemCollision:
 419+ 820A C5               push bc
 420+ 820B D5               push de
 421+ 820C E5               push hl
 422+ 820D
 423+ 820D                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 820D 6F               ld   l, a
 425+ 820E 87               add  a, a                      ; *2
 426+ 820F 87               add  a, a                      ; *4
 427+ 8210 87               add  a, a                      ; *8
 428+ 8211 5F               ld   e, a                      ; E = ItemLeft

 226+ 7A76 3A B0 91         ld   a, (enemy_was_updated)
 227+ 7A79 B7               or   a
 228+ 7A7A 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7A7C
 230+ 7A7C              .do_erase_slot:
 231+ 7A7C C5               push bc                ; Salva contatore ciclo
 232+ 7A7D
 233+ 7A7D                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7A7D DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7A80 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7A83 CD 29 7A         call CheckEnemyWillyOverlap
 237+ 7A86
 238+ 7A86                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7A86 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7A89 DD 46 09         ld   b, (ix+9)         ; B = Old Y

1218+ 7996 28 1C            jr   z, .is_floor
1219+ 7998 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1220+ 799B 28 1B            jr   z, .is_crumbling
1221+ 799D DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1222+ 79A0 28 1E            jr   z, .is_conveyor
1223+ 79A2 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1224+ 79A5 28 1D            jr   z, .is_nasty1
1225+ 79A7 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?

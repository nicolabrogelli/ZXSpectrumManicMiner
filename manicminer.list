1201+ 7566 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1202+ 7568
1203+ 7568 2A 2D 96         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 756B 11 D3 93         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 756E 01 00 02         ld   bc, 512               ; 512 celle

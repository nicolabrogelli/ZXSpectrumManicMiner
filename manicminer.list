 492  85D6 32 6A 9E         ld   (w_key_prev), a
 493  85D9 32 6B 9E         ld   (enter_key_prev), a
 494  85DC 32 57 9E         ld   (collision_active), a
 495  85DF 32 56 9E         ld   (flags), a
 496  85E2 32 50 A2         ld   (ramp_entry_guard), a
 497  85E5 32 5B A2         ld   (willy_on_ramp), a
 498  85E8 32 5A A2         ld   (willy_needs_redraw), a
 499  85EB 3E FF            ld   a, $ff
 500  85ED 32 6C 9E         ld   (digit_key_prev), a
 501  85F0 32 55 A2         ld   (player_drawn_pos+1), a
 502  85F3 32 56 A2         ld   (player_old_dir), a
 503  85F6 32 57 A2         ld   (player_old_body), a
 504  85F9 3E 01            ld   a, 1
 505  85FB 32 65 9E         ld   (q_prev), a
 506  85FE 32 66 9E         ld   (a_prev), a
 507  8601 32 5D 9E         ld   (on_ground), a
 508  8604 32 58 A2         ld   (enemy_was_updated), a
 509  8607
 510  8607                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 511  8607 3E 00            ld   a, RESPAWN_SAFETY_TIME
 512  8609 32 59 A2         ld   (willy_safety_timer), a

 518+ 7FCF              ; CheckCollision
 519+ 7FCF              ;
 520+ 7FCF              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FCF              ; Output:
 522+ 7FCF              ;   Carry Set = Collisione con guardiano
 523+ 7FCF              ;   Carry Clear = Nessuna collisione
 524+ 7FCF              ; -------------------------------------------------------------------
 525+ 7FCF              CheckCollision:
 526+ 7FCF DD E5            push ix
 527+ 7FD1 C5               push bc
 528+ 7FD2 D5               push de
 529+ 7FD3 E5               push hl
 530+ 7FD4
 531+ 7FD4                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FD4 3A 0C 9E         ld   a, (willy_safety_timer)
 533+ 7FD7 B7               or   a
 534+ 7FD8 20 3B            jr   nz, .no_collision_found
 535+ 7FDA
 536+ 7FDA DD 21 C7 7C      ld   ix, ActiveEnemies
 537+ 7FDE 06 08            ld   b, 8                      ; 8 slot
 538+ 7FE0
 539+ 7FE0              .collision_loop:
 540+ 7FE0 DD 7E 00         ld   a, (ix+0)
 541+ 7FE3 E6 80            and  $80                       ; Active?
 542+ 7FE5 28 26            jr   z, .next_enemy
 543+ 7FE7
 544+ 7FE7 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7FE8
 546+ 7FE8                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7FE8 ED 4B 02 9A      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7FEC DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7FEF
 550+ 7FEF                  ; Calcola differenza X
 551+ 7FEF 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7FF0 30 02            jr   nc, .x_diff_pos
 553+ 7FF2 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7FF4              .x_diff_pos:
 555+ 7FF4 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7FF6 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7FF8
 558+ 7FF8                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7FF8 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7FFB 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7FFC 30 02            jr   nc, .y_diff_pos
 562+ 7FFE ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 8000              .y_diff_pos:
 564+ 8000 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8002 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 8004
 567+ 8004                  ; Collisione trovata!
 568+ 8004 C1               pop  bc                        ; Ripristina stack
 569+ 8005 E1               pop  hl
 570+ 8006 D1               pop  de
 571+ 8007 C1               pop  bc
 572+ 8008 DD E1            pop  ix
 573+ 800A 37               scf
 574+ 800B C9               ret
 575+ 800C
 576+ 800C              .no_x_hit:
 577+ 800C C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 800D
 579+ 800D              .next_enemy:

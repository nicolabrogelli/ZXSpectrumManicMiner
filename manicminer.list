  46+ 831C E6 EF            and  $ef
  47+ 831E D3 FE            out  ($fe), a
  48+ 8320 4A               ld   c, d
  49+ 8321              .d2:
  50+ 8321 0D               dec  c
  51+ 8322 20 FD            jr   nz, .d2
  52+ 8324
  53+ 8324 10 E8            djnz .note_loop
  54+ 8326
  55+ 8326                  ; Passa alla nota successiva
  56+ 8326 3A 4E A4         ld   a, (Audio_jump_sound_note)
  57+ 8329 3C               inc  a
  58+ 832A 32 4E A4         ld   (Audio_jump_sound_note), a

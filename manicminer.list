 492+ 800B C6 02            add  a, 2
 493+ 800D DD BE 05         cp   (ix+5)
 494+ 8010 28 08            jr   z, .v_rev_up
 495+ 8012 30 06            jr   nc, .v_rev_up
 496+ 8014 DD 77 03         ld   (ix+3), a
 497+ 8017 C3 25 80         jp   .next
 498+ 801A
 499+ 801A              .v_rev_up:

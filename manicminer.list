1153+ 7914 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1154+ 7916
1155+ 7916 2A C8 ED         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1156+ 7919 11 6D EB         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1157+ 791C 01 00 02         ld   bc, 512               ; 512 celle
1158+ 791F
1159+ 791F              .byte_loop:

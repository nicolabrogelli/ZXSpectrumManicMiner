 518+ 8034              ; CheckCollision
 519+ 8034              ;
 520+ 8034              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 8034              ; Output:
 522+ 8034              ;   Carry Set = Collisione con guardiano
 523+ 8034              ;   Carry Clear = Nessuna collisione
 524+ 8034              ; -------------------------------------------------------------------
 525+ 8034              CheckCollision:
 526+ 8034 DD E5            push ix
 527+ 8036 C5               push bc
 528+ 8037 D5               push de
 529+ 8038 E5               push hl
 530+ 8039
 531+ 8039                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 8039 3A 71 9A         ld   a, (willy_safety_timer)
 533+ 803C B7               or   a
 534+ 803D 20 3B            jr   nz, .no_collision_found
 535+ 803F
 536+ 803F DD 21 2C 7D      ld   ix, ActiveEnemies
 537+ 8043 06 08            ld   b, 8                      ; 8 slot
 538+ 8045
 539+ 8045              .collision_loop:
 540+ 8045 DD 7E 00         ld   a, (ix+0)
 541+ 8048 E6 80            and  $80                       ; Active?
 542+ 804A 28 26            jr   z, .next_enemy
 543+ 804C
 544+ 804C C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 804D
 546+ 804D                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 804D ED 4B 67 96      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 8051 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 8054
 550+ 8054                  ; Calcola differenza X
 551+ 8054 91               sub  c                         ; A = EnemyX - WillyX
 552+ 8055 30 02            jr   nc, .x_diff_pos
 553+ 8057 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 8059              .x_diff_pos:
 555+ 8059 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 805B 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 805D
 558+ 805D                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 805D DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 8060 90               sub  b                         ; A = EnemyY - WillyY
 561+ 8061 30 02            jr   nc, .y_diff_pos
 562+ 8063 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 8065              .y_diff_pos:
 564+ 8065 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8067 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 8069
 567+ 8069                  ; Collisione trovata!
 568+ 8069 C1               pop  bc                        ; Ripristina stack
 569+ 806A E1               pop  hl
 570+ 806B D1               pop  de
 571+ 806C C1               pop  bc
 572+ 806D DD E1            pop  ix
 573+ 806F 37               scf
 574+ 8070 C9               ret
 575+ 8071
 576+ 8071              .no_x_hit:
 577+ 8071 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 8072
 579+ 8072              .next_enemy:
 580+ 8072 11 0B 00         ld   de, 11
 581+ 8075 DD 19            add  ix, de
 582+ 8077 05               dec  b
 583+ 8078 20 CB            jr   nz, .collision_loop
 584+ 807A
 585+ 807A              .no_collision_found:
 586+ 807A E1               pop  hl
 587+ 807B D1               pop  de
 588+ 807C C1               pop  bc
 589+ 807D DD E1            pop  ix
 590+ 807F B7               or   a
 591+ 8080 C9               ret

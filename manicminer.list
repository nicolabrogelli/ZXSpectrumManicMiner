 796+ 611A              ; -------------------------------------------------------------------
 797+ 611A              ; IsCellEmptyBackground
 798+ 611A              ; Verifica se la cella (H = Row 0..15, B = Col 0..31) è spazio vuoto (tile 0).
 799+ 611A              ; Output:
 800+ 611A              ;   Carry Set   = Cella vuota (nessun tile, nessun item, nessun portale)
 801+ 611A              ;   Carry Clear = Cella occupata da un tile della stanza, item o portale
 802+ 611A              ; -------------------------------------------------------------------
 803+ 611A              IsCellEmptyBackground:
 804+ 611A E5               push hl
 805+ 611B D5               push de
 806+ 611C C5               push bc
 807+ 611D
 808+ 611D                  ; 1. Se Row >= 16, fuori dal layout di gioco
 809+ 611D 7C               ld   a, h
 810+ 611E FE 10            cp   16
 811+ 6120 30 50            jr   nc, .not_empty
 812+ 6122
 813+ 6122                  ; 2. Controlla se c'è un Item attivo
 814+ 6122 C5               push bc
 815+ 6123 4C               ld   c, h                  ; C = Row
 816+ 6124 CD 67 82         call CheckActiveItemAtCell
 817+ 6127 C1               pop  bc
 818+ 6128 38 48            jr   c, .not_empty
 819+ 612A
 820+ 612A                  ; 3. Controlla se appartiene al Portale (16x16)
 821+ 612A E5               push hl
 822+ 612B D5               push de
 823+ 612C C5               push bc
 824+ 612D 2A 80 99         ld   hl, (room_ptr)
 825+ 6130 11 B0 02         ld   de, OFFSET_PORTAL + 33
 826+ 6133 19               add  hl, de
 827+ 6134 7E               ld   a, (hl)
 828+ 6135 23               inc  hl
 829+ 6136 66               ld   h, (hl)
 830+ 6137 6F               ld   l, a                  ; HL = AttrAddr
 831+ 6138 11 00 A4         ld   de, -23552
 832+ 613B 19               add  hl, de                ; HL = AttrOffset
 833+ 613C
 834+ 613C 7D               ld   a, l
 835+ 613D E6 1F            and  31
 836+ 613F 57               ld   d, a                  ; D = PortalCol
 837+ 6140
 838+ 6140 CB 3C            srl  h
 838+ 6142 CB 1D          rr l
 839+ 6144 CB 3C            srl  h
 839+ 6146 CB 1D          rr l
 840+ 6148 CB 3C            srl  h
 840+ 614A CB 1D          rr l
 841+ 614C CB 3C            srl  h
 841+ 614E CB 1D          rr l
 842+ 6150 CB 3C            srl  h
 842+ 6152 CB 1D          rr l
 843+ 6154 7D               ld   a, l                  ; A = PortalRow
 844+ 6155
 845+ 6155 C1               pop  bc                    ; B = Col
 846+ 6156 D1               pop  de
 847+ 6157 E1               pop  hl                    ; H = Row
 848+ 6158
 849+ 6158                  ; DeltaRow = H - PortalRow (in A)
 850+ 6158 94               sub  h

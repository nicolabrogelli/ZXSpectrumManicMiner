 300+ 7EB8              .next_draw:
 301+ 7EB8 11 0B 00         ld   de, 11
 302+ 7EBB DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7EBD 05               dec  b
 304+ 7EBE 20 BA            jr   nz, .draw_loop
 305+ 7EC0

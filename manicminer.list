 438+ 8675 ED 4B 85 EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 8679
 440+ 8679                  ; WillyLeft <= ItemRight
 441+ 8679 79               ld   a, c                      ; A = WillyX
 442+ 867A BA               cp   d                         ; D = ItemRight
 443+ 867B 28 04            jr   z, .x_ok
 444+ 867D 38 02            jr   c, .x_ok
 445+ 867F 18 31            jr   .no_collision
 446+ 8681
 447+ 8681              .x_ok:
 448+ 8681                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8681 BB               cp   e                         ; E = ItemLeft
 450+ 8682 28 0B            jr   z, .y_check
 451+ 8684 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8686
 453+ 8686                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 8686 C6 0F            add  a, 15
 455+ 8688 BB               cp   e
 456+ 8689 28 04            jr   z, .y_check
 457+ 868B 30 02            jr   nc, .y_check
 458+ 868D 18 23            jr   .no_collision
 459+ 868F
 460+ 868F              .y_check:
 461+ 868F                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 868F 7C               ld   a, h                      ; H = Item Row

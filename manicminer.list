 123+ 7EEC 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 7EED 23               inc  hl                        ; +2 (Attr Address High)
 125+ 7EEE 23               inc  hl                        ; +3 (Anim mask)
 126+ 7EEF 23               inc  hl                        ; +4 (Collected flag)
 127+ 7EF0 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 7EF2 23               inc  hl                        ; Avanza al prossimo item
 129+ 7EF3 18 F2            jr   .item_loop

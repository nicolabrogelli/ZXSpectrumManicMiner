 439  80D2 01 FE BF         ld   bc, $bffe
 440  80D5 ED 78            in   a, (c)
 441  80D7 CB 47            bit  0, a
 442  80D9 28 ED            jr   z, .wait_quit_release
 443  80DB
 444  80DB                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 445  80DB C3 21 80         jp   ShowTitleScreen
 446  80DE
 447  80DE              .continue_chosen:
 448  80DE                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 449  80DE              .wait_continue_release:
 450  80DE 76               halt
 451  80DF 01 FE DF         ld   bc, $dffe
 452  80E2 ED 78            in   a, (c)
 453  80E4 CB 67            bit  4, a
 454  80E6 28 F6            jr   z, .wait_continue_release
 455  80E8
 456  80E8                  ; 5b. Ripristina lo stato per continuare la partita:

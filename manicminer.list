 216+ 7E23 28 33            jr   z, .next_erase
 217+ 7E25
 218+ 7E25                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E25 DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E28 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E2B 20 0E            jr   nz, .do_erase_slot
 222+ 7E2D DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E30 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E33 20 06            jr   nz, .do_erase_slot
 225+ 7E35
 226+ 7E35 3A 12 9A         ld   a, (enemy_was_updated)
 227+ 7E38 B7               or   a
 228+ 7E39 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E3B
 230+ 7E3B              .do_erase_slot:
 231+ 7E3B C5               push bc                ; Salva contatore ciclo
 232+ 7E3C
 233+ 7E3C                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E3C DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E3F DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E42 CD E8 7D         call CheckEnemyWillyOverlap
 237+ 7E45
 238+ 7E45                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E45 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E48 DD 46 09         ld   b, (ix+9)         ; B = Old Y

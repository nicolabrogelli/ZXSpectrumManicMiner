1141+ 7868              GetCellFromUnpacked:
1142+ 7868 E5               push hl
1143+ 7869 D5               push de
1144+ 786A
1145+ 786A 6F               ld   l, a
1146+ 786B 26 00            ld   h, 0
1147+ 786D 29               add  hl, hl
1148+ 786E 29               add  hl, hl
1149+ 786F 29               add  hl, hl
1150+ 7870 29               add  hl, hl
1151+ 7871 29               add  hl, hl            ; HL = Row * 32
1152+ 7872 59               ld   e, c
1153+ 7873 16 00            ld   d, 0
1154+ 7875 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 7876 11 8F AB         ld   de, unpacked_layout
1156+ 7879 19               add  hl, de
1157+ 787A 7E               ld   a, (hl)           ; A = cell type
1158+ 787B
1159+ 787B D1               pop  de
1160+ 787C E1               pop  hl
1161+ 787D C9               ret

1219+ 7661 28 1B            jr   z, .is_crumbling
1220+ 7663 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 7666 28 1E            jr   z, .is_conveyor
1222+ 7668 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 766B 28 1D            jr   z, .is_nasty1
1224+ 766D DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 7670 28 1C            jr   z, .is_nasty2

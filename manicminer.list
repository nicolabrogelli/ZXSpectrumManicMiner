1092+ 786E              ; -------------------------------------------------------------------
1093+ 786E              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1094+ 786E              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1095+ 786E              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1096+ 786E              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1097+ 786E              ; -------------------------------------------------------------------
1098+ 786E              UnpackRoomLayout:
1099+ 786E E5               push hl
1100+ 786F D5               push de
1101+ 7870 C5               push bc
1102+ 7871 DD E5            push ix
1103+ 7873
1104+ 7873 DD 2A 85 A1      ld   ix, (room_ptr)
1105+ 7877 11 20 02         ld   de, OFFSET_TILES
1106+ 787A DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1107+ 787C
1108+ 787C 2A 85 A1         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1109+ 787F 11 2A 9F         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1110+ 7882 01 00 02         ld   bc, 512               ; 512 celle
1111+ 7885
1112+ 7885              .byte_loop:
1113+ 7885 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1114+ 7886 23               inc  hl
1115+ 7887
1116+ 7887                  ; Confronta con le 8 definizioni di tile:
1117+ 7887 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1118+ 788A 28 23            jr   z, .is_bg
1119+ 788C DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1120+ 788F 28 29            jr   z, .is_wall
1121+ 7891 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1122+ 7894 28 1C            jr   z, .is_floor
1123+ 7896 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1124+ 7899 28 1B            jr   z, .is_crumbling
1125+ 789B DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1126+ 789E 28 1E            jr   z, .is_conveyor
1127+ 78A0 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1128+ 78A3 28 1D            jr   z, .is_nasty1
1129+ 78A5 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1130+ 78A8 28 1C            jr   z, .is_nasty2
1131+ 78AA DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1132+ 78AD 28 1B            jr   z, .is_extra
1133+ 78AF
1134+ 78AF              .is_bg:
1135+ 78AF                  ; Default: Tile 0 (Background)
1136+ 78AF AF               xor  a
1137+ 78B0 18 1A            jr   .store_cell
1138+ 78B2
1139+ 78B2              .is_floor:
1140+ 78B2 3E 01            ld   a, 1
1141+ 78B4 18 16            jr   .store_cell
1142+ 78B6              .is_crumbling:
1143+ 78B6 3E 02            ld   a, 2
1144+ 78B8 18 12            jr   .store_cell
1145+ 78BA              .is_wall:
1146+ 78BA 3E 03            ld   a, 3
1147+ 78BC 18 0E            jr   .store_cell
1148+ 78BE              .is_conveyor:
1149+ 78BE 3E 04            ld   a, 4
1150+ 78C0 18 0A            jr   .store_cell
1151+ 78C2              .is_nasty1:
1152+ 78C2 3E 05            ld   a, 5
1153+ 78C4 18 06            jr   .store_cell
1154+ 78C6              .is_nasty2:
1155+ 78C6 3E 06            ld   a, 6
1156+ 78C8 18 02            jr   .store_cell
1157+ 78CA              .is_extra:
1158+ 78CA 3E 07            ld   a, 7
1159+ 78CC
1160+ 78CC              .store_cell:
1161+ 78CC 12               ld   (de), a
1162+ 78CD 13               inc  de
1163+ 78CE 0B               dec  bc
1164+ 78CF 78               ld   a, b
1165+ 78D0 B1               or   c
1166+ 78D1 20 B2            jr   nz, .byte_loop
1167+ 78D3
1168+ 78D3 DD E1            pop  ix
1169+ 78D5 C1               pop  bc
1170+ 78D6 D1               pop  de
1171+ 78D7 E1               pop  hl
1172+ 78D8 C9               ret
1173+ 78D9
1174+ 78D9              ; -------------------------------------------------------------------
1175+ 78D9              ; Legge il tipo di cella dal buffer decompresso in RAM
1176+ 78D9              ; Input: A = Row (0..15), C = Col (0..31)
1177+ 78D9              ; Output: A = tipo di cella (0..3)
1178+ 78D9              ; Preserva tutti gli altri registri.
1179+ 78D9              ; -------------------------------------------------------------------
1180+ 78D9              GetCellFromUnpacked:

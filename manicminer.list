 331  81BE 77               ld   (hl), a
 332  81BF 23               inc  hl
 333  81C0 10 FC            djnz .color_title_loop
 334  81C2
 335  81C2                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 336  81C2 3E BF            ld   a, $bf
 337  81C4 DB FE            in   a, ($fe)
 338  81C6 1F               rra
 339  81C7 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 340  81C9
 341  81C9                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 342  81C9              .wait_title_enter_release_after:
 343  81C9 76               halt

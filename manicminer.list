 145  89AB                  IF ENABLE_ANIMATE_LIVES != 0
 146  89AB ~                call Gfx_PrintWillyLives
 147  89AB                  ENDIF
 148  89AB
 149  89AB
 150  89AB                  ; 7. Salva le posizioni correnti del player per il prossimo frame
 151  89AB ED 4B F1 EA      ld   bc, (PlayerPos)
 152  89AF ED 43 F3 EA      ld   (PlayerPosOld), bc
 153  89B3
 154  89B3                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 155  89B3 CD D6 70         call Input_CheckCtrl
 156  89B6 CD F9 6E         call MovePlayer
 157  89B9 CD 3B 74         call Phys_ApplyGravity
 158  89BC                  IF ENABLE_FALL_DEATH != 0
 159  89BC DA E1 89         jp   c, .willy_dies
 160  89BF                  ENDIF
 161  89BF CD 18 81         call Enemy_Update
 162  89C2 CD 23 87         call Items_CheckCollision
 163  89C5 CD 38 88         call Items_Animate
 164  89C8 CD 60 84         call Kong_CheckSwitches
 165  89CB
 166  89CB                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 167  89CB CD 23 8B         call CheckPortalTransition
 168  89CE DA 7D 8B         jp   c, TriggerPortalTransition
 169  89D1
 170  89D1                  ; Controlla collisione con Nasties (morte di Willy)
 171  89D1                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 172  89D1 CD 9A 7C         call Phys_CheckNastyCollision
 173  89D4 38 0B            jr   c, .willy_dies
 174  89D6                  ENDIF
 175  89D6
 176  89D6                  ; Controlla collisione con guardiani
 177  89D6 CD DC 82         call CheckCollision
 178  89D9 38 03            jr   c, .guardian_collision_found
 179  89DB
 180  89DB                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 181  89DB                  IF ENABLE_RAMP_DEBUG_BARS != 0
 182  89DB ~                ld   a, (willy_on_ramp)
 183  89DB ~                or   a
 184  89DB ~                jp   nz, .draw_raster_bars
 185  89DB                  ENDIF
 186  89DB
 187  89DB C3 50 8A         jp   .no_collision
 188  89DE
 189  89DE              .guardian_collision_found:
 190  89DE                  ; C'è collisione con un guardiano!
 191  89DE                  ; Controlla se la morte per collisione con i guardiani è abilitata
 192  89DE                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 193  89DE C3 E1 89         jp   .willy_dies
 194  89E1                  ELSE
 195  89E1 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 196  89E1 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 197  89E1 ~                    ELSE
 198  89E1 ~                    jp   .no_collision
 199  89E1 ~                    ENDIF
 200  89E1                  ENDIF

  63+ 6F1F                  ; Controlla se Willy è sopra un nastro trasportatore (Conveyor)
  64+ 6F1F                  ; ---------------------------------------------------------------
  65+ 6F1F CD 5F 78         call CheckWillyOnConveyor
  66+ 6F22 38 20            jr   c, .on_conveyor_ground
  67+ 6F24
  68+ 6F24                  ; ---------------------------------------------------------------
  69+ 6F24                  ; Terreno normale (non su conveyor):
  70+ 6F24                  ; Resetta lo stato di cattura del conveyor
  71+ 6F24                  ; ---------------------------------------------------------------
  72+ 6F24 AF               xor  a
  73+ 6F25 32 15 EE         ld   (conveyor_caught), a

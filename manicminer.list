 635+ 8375                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8375 3A E0 C0         ld   a, (player_score + 1)
 637+ 8378 C6 01            add  a, $01
 638+ 837A 27               daa
 639+ 837B 32 E0 C0         ld   (player_score + 1), a
 640+ 837E
 641+ 837E                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 837E 3A E1 C0         ld   a, (player_score + 2)
 643+ 8381 CE 00            adc  a, 0
 644+ 8383 27               daa
 645+ 8384 32 E1 C0         ld   (player_score + 2), a

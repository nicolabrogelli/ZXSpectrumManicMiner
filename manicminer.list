 316+ 7EB6              ; Enemy_DrawSingleSlot
 317+ 7EB6              ;
 318+ 7EB6              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7EB6              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7EB6              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7EB6              ; -------------------------------------------------------------------
 322+ 7EB6              Enemy_DrawSingleSlot:
 323+ 7EB6 C5               push bc
 324+ 7EB7 D5               push de
 325+ 7EB8 E5               push hl
 326+ 7EB9 DD E5            push ix
 327+ 7EBB
 328+ 7EBB                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EBB                  ; Nei dati di Manic Miner:
 330+ 7EBB                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EBB                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EBB DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EBE E6 03            and  3
 334+ 7EC0 47               ld   b, a                      ; B = Anim subframe
 335+ 7EC1
 336+ 7EC1 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EC4 FE 01            cp   1                         ; Sinistra?
 338+ 7EC6 28 03            jr   z, .left_frames
 339+ 7EC8
 340+ 7EC8                  ; Movimento a Destra: Frame 0..3
 341+ 7EC8 78               ld   a, b
 342+ 7EC9 18 03            jr   .got_frame_idx
 343+ 7ECB
 344+ 7ECB              .left_frames:
 345+ 7ECB                  ; Movimento a Sinistra: Frame 4..7
 346+ 7ECB 3E 04            ld   a, 4
 347+ 7ECD 80               add  a, b
 348+ 7ECE
 349+ 7ECE              .got_frame_idx:
 350+ 7ECE                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7ECE 6F               ld   l, a
 352+ 7ECF 26 00            ld   h, 0
 353+ 7ED1 29               add  hl, hl                    ; *2
 354+ 7ED2 29               add  hl, hl                    ; *4
 355+ 7ED3 29               add  hl, hl                    ; *8
 356+ 7ED4 29               add  hl, hl                    ; *16
 357+ 7ED5 29               add  hl, hl                    ; *32
 358+ 7ED6
 359+ 7ED6 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7ED9 19               add  hl, de
 361+ 7EDA ED 5B 89 99      ld   de, (room_ptr)
 362+ 7EDE 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7EDF E5               push hl
 364+ 7EE0 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7EE2
 366+ 7EE2                  ; 2. Coordinate e colore
 367+ 7EE2 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7EE4 FD E5            push iy
 369+ 7EE6
 370+ 7EE6 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7EE9 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7EEC FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7EEF
 374+ 7EEF                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7EEF CD 6B 5F         call Gfx_DrawPixelSprite16x16
 376+ 7EF2 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7EF5 CD 5B 6D         call Gfx_SetEnemyColorAttributes
 378+ 7EF8
 379+ 7EF8 DD E1            pop  ix
 380+ 7EFA E1               pop  hl
 381+ 7EFB D1               pop  de
 382+ 7EFC C1               pop  bc
 383+ 7EFD C9               ret
 384+ 7EFE
 385+ 7EFE              ; -------------------------------------------------------------------
 386+ 7EFE              ; Enemy_Update
 387+ 7EFE              ;
 388+ 7EFE              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7EFE              ; -------------------------------------------------------------------
 390+ 7EFE              Enemy_Update:
 391+ 7EFE                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7EFE 3A 8B 99         ld   a, (enemy_update_rate)
 393+ 7F01 FE 01            cp   1
 394+ 7F03 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7F05
 396+ 7F05 21 8C 99         ld   hl, enemy_update_timer
 397+ 7F08 34               inc  (hl)
 398+ 7F09 7E               ld   a, (hl)
 399+ 7F0A 21 8B 99         ld   hl, enemy_update_rate
 400+ 7F0D BE               cp   (hl)
 401+ 7F0E D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7F0F AF               xor  a
 403+ 7F10 32 8C 99         ld   (enemy_update_timer), a
 404+ 7F13
 405+ 7F13              .do_update:
 406+ 7F13 E5               push hl
 407+ 7F14 D5               push de
 408+ 7F15 C5               push bc
 409+ 7F16 DD E5            push ix
 410+ 7F18
 411+ 7F18 3E 01            ld   a, 1
 412+ 7F1A 32 12 9A         ld   (enemy_was_updated), a
 413+ 7F1D
 414+ 7F1D DD 21 CE 7C      ld   ix, ActiveEnemies
 415+ 7F21 06 08            ld   b, 8                      ; 8 slot
 416+ 7F23              .loop:
 417+ 7F23 DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7F26 E6 80            and  $80                       ; Active?
 419+ 7F28 CA C7 7F         jp   z, .next
 420+ 7F2B
 421+ 7F2B                  ; 1. Aggiorna Anim State (0..3)
 422+ 7F2B DD 7E 07         ld   a, (ix+7)
 423+ 7F2E 3C               inc  a
 424+ 7F2F E6 03            and  3
 425+ 7F31 DD 77 07         ld   (ix+7), a
 426+ 7F34
 427+ 7F34                  ; 2. Determina se orizzontale o verticale
 428+ 7F34 DD 7E 00         ld   a, (ix+0)
 429+ 7F37 E6 40            and  $40                       ; Vertical?
 430+ 7F39 C2 83 7F         jp   nz, .vertical
 431+ 7F3C
 432+ 7F3C              .horizontal:
 433+ 7F3C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7F3F FE 01            cp   1
 435+ 7F41 20 20            jr   nz, .horiz_right
 436+ 7F43
 437+ 7F43              .horiz_left:
 438+ 7F43 DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7F46 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7F48 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7F4B 28 08            jr   z, .h_rev_right
 442+ 7F4D 38 06            jr   c, .h_rev_right
 443+ 7F4F DD 77 02         ld   (ix+2), a
 444+ 7F52 C3 C7 7F         jp   .next
 445+ 7F55
 446+ 7F55              .h_rev_right:
 447+ 7F55 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7F58 DD 77 02         ld   (ix+2), a
 449+ 7F5B 3E 02            ld   a, 2
 450+ 7F5D DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7F60 C3 C7 7F         jp   .next
 452+ 7F63
 453+ 7F63              .horiz_right:
 454+ 7F63 DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7F66 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7F68 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7F6B 28 08            jr   z, .h_rev_left
 458+ 7F6D 30 06            jr   nc, .h_rev_left
 459+ 7F6F DD 77 02         ld   (ix+2), a
 460+ 7F72 C3 C7 7F         jp   .next
 461+ 7F75
 462+ 7F75              .h_rev_left:
 463+ 7F75 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7F78 DD 77 02         ld   (ix+2), a
 465+ 7F7B 3E 01            ld   a, 1
 466+ 7F7D DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7F80 C3 C7 7F         jp   .next
 468+ 7F83
 469+ 7F83              .vertical:
 470+ 7F83 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7F86 FE 01            cp   1
 472+ 7F88 20 20            jr   nz, .vert_down
 473+ 7F8A
 474+ 7F8A              .vert_up:
 475+ 7F8A DD 7E 03         ld   a, (ix+3)                 ; Current Y
 476+ 7F8D D6 02            sub  2
 477+ 7F8F DD BE 04         cp   (ix+4)
 478+ 7F92 28 08            jr   z, .v_rev_down
 479+ 7F94 38 06            jr   c, .v_rev_down
 480+ 7F96 DD 77 03         ld   (ix+3), a
 481+ 7F99 C3 C7 7F         jp   .next
 482+ 7F9C
 483+ 7F9C              .v_rev_down:
 484+ 7F9C DD 7E 04         ld   a, (ix+4)
 485+ 7F9F DD 77 03         ld   (ix+3), a
 486+ 7FA2 3E 02            ld   a, 2
 487+ 7FA4 DD 77 06         ld   (ix+6), a
 488+ 7FA7 C3 C7 7F         jp   .next
 489+ 7FAA
 490+ 7FAA              .vert_down:
 491+ 7FAA DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7FAD C6 02            add  a, 2
 493+ 7FAF DD BE 05         cp   (ix+5)
 494+ 7FB2 28 08            jr   z, .v_rev_up
 495+ 7FB4 30 06            jr   nc, .v_rev_up
 496+ 7FB6 DD 77 03         ld   (ix+3), a
 497+ 7FB9 C3 C7 7F         jp   .next
 498+ 7FBC
 499+ 7FBC              .v_rev_up:
 500+ 7FBC DD 7E 05         ld   a, (ix+5)
 501+ 7FBF DD 77 03         ld   (ix+3), a
 502+ 7FC2 3E 01            ld   a, 1
 503+ 7FC4 DD 77 06         ld   (ix+6), a
 504+ 7FC7
 505+ 7FC7              .next:
 506+ 7FC7 11 0B 00         ld   de, 11
 507+ 7FCA DD 19            add  ix, de
 508+ 7FCC 05               dec  b
 509+ 7FCD C2 23 7F         jp   nz, .loop
 510+ 7FD0
 511+ 7FD0 DD E1            pop  ix
 512+ 7FD2 C1               pop  bc
 513+ 7FD3 D1               pop  de
 514+ 7FD4 E1               pop  hl

 287  85CA              ; -------------------------------------------------------------------
 288  85CA              ; ShowTitleScreen
 289  85CA              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  85CA              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  85CA              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  85CA              ; -------------------------------------------------------------------
 293  85CA              ShowTitleScreen:
 294  85CA                  ; 1. Disegna la schermata iniziale
 295  85CA CD 76 64         call Gfx_DrawTitleScreen
 296  85CD
 297  85CD                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  85CD              .wait_title_enter_release:
 299  85CD 76               halt
 300  85CE 3E BF            ld   a, $bf
 301  85D0 DB FE            in   a, ($fe)
 302  85D2 1F               rra
 303  85D3 30 F8            jr   nc, .wait_title_enter_release
 304  85D5
 305  85D5                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  85D5 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  85D7              .title_loop:
 308  85D7 76               halt
 309  85D8
 310  85D8                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  85D8 0C               inc  c
 312  85D9 79               ld   a, c
 313  85DA CB 3F            srl  a
 314  85DC CB 3F            srl  a
 315  85DE CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85E0 E6 07            and  7
 317  85E2 5F               ld   e, a
 318  85E3 16 00            ld   d, 0
 319  85E5 21 6E 64         ld   hl, title_color_table
 320  85E8 19               add  hl, de
 321  85E9 7E               ld   a, (hl)               ; A = nuovo colore
 322  85EA 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85ED 06 20            ld   b, 32
 324  85EF              .color_title_loop:
 325  85EF 77               ld   (hl), a
 326  85F0 23               inc  hl
 327  85F1 10 FC            djnz .color_title_loop
 328  85F3
 329  85F3                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85F3 3E BF            ld   a, $bf
 331  85F5 DB FE            in   a, ($fe)
 332  85F7 1F               rra
 333  85F8 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  85FA
 335  85FA                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  85FA              .wait_title_enter_release_after:
 337  85FA 76               halt
 338  85FB 3E BF            ld   a, $bf
 339  85FD DB FE            in   a, ($fe)
 340  85FF 1F               rra
 341  8600 30 F8            jr   nc, .wait_title_enter_release_after
 342  8602
 343  8602                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  8602 AF               xor  a
 345  8603 D3 FE            out  ($fe), a              ; Bordo a nero
 346  8605 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  8608
 348  8608                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 349  8608 CD 6F 88         call ResetFullGameState

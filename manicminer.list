 673+ 82B6                  ; Byte 1:
 674+ 82B6 3A 10 A4         ld   a, (player_score + 1)
 675+ 82B9 47               ld   b, a
 676+ 82BA 3A 13 A4         ld   a, (high_score + 1)
 677+ 82BD B8               cp   b
 678+ 82BE 38 0C            jr   c, .new_high_score
 679+ 82C0 20 1C            jr   nz, .done_check
 680+ 82C2
 681+ 82C2                  ; Byte 0:
 682+ 82C2 3A 0F A4         ld   a, (player_score + 0)
 683+ 82C5 47               ld   b, a
 684+ 82C6 3A 12 A4         ld   a, (high_score + 0)
 685+ 82C9 B8               cp   b
 686+ 82CA 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

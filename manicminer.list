  72+ 8869 ~            ; Audio_UpdateMusic
  73+ 8869 ~            ;
  74+ 8869 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8869 ~            ; Viene chiamata a ogni frame.
  76+ 8869 ~            ; -------------------------------------------------------------------
  77+ 8869 ~            Audio_UpdateMusic:
  78+ 8869 ~                push af
  79+ 8869 ~                push bc
  80+ 8869 ~                push de
  81+ 8869 ~                push hl
  82+ 8869 ~
  83+ 8869 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8869 ~                ld   a, (Audio_jump_sound_note)
  85+ 8869 ~                cp   18
  86+ 8869 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8869 ~
  88+ 8869 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8869 ~                ld   a, (Audio_music_frame_counter)
  90+ 8869 ~                dec  a
  91+ 8869 ~                ld   (Audio_music_frame_counter), a
  92+ 8869 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8869 ~
  94+ 8869 ~                ; Altrimenti carica la nota successiva
  95+ 8869 ~                ld   a, (Audio_music_note_idx)
  96+ 8869 ~                inc  a
  97+ 8869 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8869 ~                jr   c, .no_wrap
  99+ 8869 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8869 ~            .no_wrap:
 101+ 8869 ~                ld   (Audio_music_note_idx), a
 102+ 8869 ~
 103+ 8869 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8869 ~                ld   e, a
 105+ 8869 ~                ld   d, 0
 106+ 8869 ~                ld   hl, Audio_MusicSheet
 107+ 8869 ~                add  hl, de
 108+ 8869 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8869 ~
 110+ 8869 ~                ; Leggi durata (secondo byte)
 111+ 8869 ~                inc  hl
 112+ 8869 ~                ld   a, (hl)
 113+ 8869 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8869 ~                jr   nz, .dur_ok
 115+ 8869 ~                ld   a, 1
 116+ 8869 ~            .dur_ok:
 117+ 8869 ~                ld   (Audio_music_frame_counter), a
 118+ 8869 ~
 119+ 8869 ~            .play_current_note:
 120+ 8869 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8869 ~                ld   a, (Audio_music_note_idx)
 122+ 8869 ~                ld   e, a
 123+ 8869 ~                ld   d, 0
 124+ 8869 ~                ld   hl, Audio_MusicSheet
 125+ 8869 ~                add  hl, de
 126+ 8869 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8869 ~                ld   a, (hl)                  ; A = delay
 128+ 8869 ~                or   a
 129+ 8869 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8869 ~
 131+ 8869 ~                ; Suona la nota: 2 cicli
 132+ 8869 ~                ld   d, a                     ; D = delay
 133+ 8869 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8869 ~            .note_loop:
 135+ 8869 ~                ; Speaker ON
 136+ 8869 ~                ld   a, (room_border_color)
 137+ 8869 ~                or   $10
 138+ 8869 ~                out  ($fe), a
 139+ 8869 ~                ld   c, d
 140+ 8869 ~            .d1:
 141+ 8869 ~                push af
 142+ 8869 ~                pop  af
 143+ 8869 ~                dec  c
 144+ 8869 ~                jr   nz, .d1
 145+ 8869 ~
 146+ 8869 ~                ; Speaker OFF
 147+ 8869 ~                ld   a, (room_border_color)
 148+ 8869 ~                and  $ef
 149+ 8869 ~                out  ($fe), a
 150+ 8869 ~                ld   c, d
 151+ 8869 ~            .d2:
 152+ 8869 ~                push af
 153+ 8869 ~                pop  af
 154+ 8869 ~                dec  c
 155+ 8869 ~                jr   nz, .d2
 156+ 8869 ~
 157+ 8869 ~                djnz .note_loop
 158+ 8869 ~
 159+ 8869 ~            .done:
 160+ 8869 ~                pop  hl
 161+ 8869 ~                pop  de
 162+ 8869 ~                pop  bc
 163+ 8869 ~                pop  af
 164+ 8869 ~                ret
 165+ 8869 ~
 166+ 8869 ~            Audio_MusicSheet:
 167+ 8869 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8869 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8869 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8869 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8869 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8869 ~                db 90, 10, 107, 20, 68, 65
 173+ 8869                  ELSE
 174+ 8869              Audio_UpdateMusic:
 175+ 8869 C9               ret
 176+ 886A                  ENDIF

 722+ 86AB 47               ld   b, a
 723+ 86AC 3A 29 E8         ld   a, (high_score + 1)
 724+ 86AF B8               cp   b
 725+ 86B0 38 0C            jr   c, .new_high_score
 726+ 86B2 20 1C            jr   nz, .done_check
 727+ 86B4
 728+ 86B4                  ; Byte 0:
 729+ 86B4 3A 25 E8         ld   a, (player_score + 0)
 730+ 86B7 47               ld   b, a
 731+ 86B8 3A 28 E8         ld   a, (high_score + 0)
 732+ 86BB B8               cp   b
 733+ 86BC 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

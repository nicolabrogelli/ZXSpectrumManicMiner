 161+ 7B71              ; -------------------------------------------------------------------
 162+ 7B71              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7B71              ; -------------------------------------------------------------------
 164+ 7B71              CheckEnemyWillyOverlap:
 165+ 7B71 3A 8F 97         ld   a, (player_drawn_pos+1)
 166+ 7B74 FE FF            cp   $FF
 167+ 7B76 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7B77
 169+ 7B77                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7B77 3A 8E 97         ld   a, (player_drawn_pos)
 171+ 7B7A E6 F8            and  $F8
 172+ 7B7C 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7B7D 79               ld   a, c
 174+ 7B7E E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7B80 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7B81 C6 10            add  a, 16
 177+ 7B83 FE 19            cp   25
 178+ 7B85 D0               ret  nc                 ; Fuori portata X
 179+ 7B86
 180+ 7B86                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7B86 3A 8F 97         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7B89 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7B8A C6 0F            add  a, 15
 184+ 7B8C FE 1F            cp   31
 185+ 7B8E D0               ret  nc                 ; Fuori portata Y
 186+ 7B8F
 187+ 7B8F                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7B8F 3E 01            ld   a, 1
 189+ 7B91 32 94 97         ld   (willy_needs_redraw), a
 190+ 7B94 C9               ret

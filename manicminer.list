 384+ 7D9A 57               ld   d, a                      ; D = ItemRight
 385+ 7D9B
 386+ 7D9B ED 4B EC 8D      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 387+ 7D9F
 388+ 7D9F                  ; WillyLeft <= ItemRight
 389+ 7D9F 79               ld   a, c
 390+ 7DA0 BA               cp   d
 391+ 7DA1 28 04            jr   z, .x_ok
 392+ 7DA3 38 02            jr   c, .x_ok
 393+ 7DA5 18 29            jr   .no_collision
 394+ 7DA7

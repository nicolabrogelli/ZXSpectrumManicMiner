1292+ 6512 76               halt
1293+ 6513 10 FD            djnz .pause_after_foot
1294+ 6515
1295+ 6515                  ; 9. Solo DOPO la pausa, fa comparire GAME OVER al centro dello schermo a riga 5, colonna 11
1296+ 6515 3E 16            ld   a, 22                 ; AT (22)
1297+ 6517 D7               rst  $10
1298+ 6518 3E 05            ld   a, 5                  ; Riga 5
1299+ 651A D7               rst  $10
1300+ 651B 3E 0B            ld   a, 11                 ; Colonna 11

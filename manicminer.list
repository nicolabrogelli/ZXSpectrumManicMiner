 629+ 6065 BE               cp   (hl)
 630+ 6066 20 08            jr   nz, .player_moved
 631+ 6068
 632+ 6068                  ; Willy non si è mosso. Ma se un nemico lo ha sovrascritto, ridisegnalo senza prima cancellarlo!
 633+ 6068 3A 9F 92         ld   a, (willy_needs_redraw)
 634+ 606B B7               or   a

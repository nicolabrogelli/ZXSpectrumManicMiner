 142+ 8445              ; Items_DrawRoom
 143+ 8445              ;
 144+ 8445              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 8445              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 8445              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 8445              ;
 148+ 8445              ; Record item nella stanza (5 byte):
 149+ 8445              ;   +0 Color / Attributo
 150+ 8445              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 8445              ;   +2 Attr Address High
 152+ 8445              ;   +3 Anim Mask (96)
 153+ 8445              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 8445              ; Fine lista: $FF
 155+ 8445              ; -------------------------------------------------------------------
 156+ 8445              Items_DrawRoom:
 157+ 8445 E5               push hl
 158+ 8446 D5               push de
 159+ 8447 C5               push bc
 160+ 8448 DD E5            push ix
 161+ 844A FD E5            push iy
 162+ 844C
 163+ 844C                  ; 1. Azzera items_grid (512 byte)
 164+ 844C 21 A9 DF         ld   hl, items_grid
 165+ 844F 11 AA DF         ld   de, items_grid + 1
 166+ 8452 36 00            ld   (hl), 0
 167+ 8454 01 FF 01         ld   bc, 511
 168+ 8457 ED B0            ldir
 169+ 8459
 170+ 8459                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 8459 AF               xor  a
 172+ 845A 32 29 E5         ld   (num_room_items), a
 173+ 845D
 174+ 845D FD 21 D9 E4      ld   iy, current_room_items
 175+ 8461
 176+ 8461                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 8461 2A 2A E5         ld   hl, (room_ptr)
 178+ 8464 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 8467 19               add  hl, de
 180+ 8468 E5               push hl
 181+ 8469 DD E1            pop  ix                        ; IX = bitmap item
 182+ 846B
 183+ 846B                  ; 4. HL = Inizio lista item nella stanza
 184+ 846B 2A 2A E5         ld   hl, (room_ptr)
 185+ 846E 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8471 19               add  hl, de
 187+ 8472
 188+ 8472              .loop:
 189+ 8472 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 8473 FE FF            cp   $FF
 191+ 8475 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 8477 B7               or   a
 193+ 8478 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 847A
 195+ 847A 5F               ld   e, a                      ; E = Color
 196+ 847B 23               inc  hl
 197+ 847C 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 847D 23               inc  hl
 199+ 847E 46               ld   b, (hl)                   ; B = AttrAddr High

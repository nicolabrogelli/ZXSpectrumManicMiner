   8+ 8889              ; Audio_UpdateJumpSound
   9+ 8889              ;
  10+ 8889              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8889              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8889              ; -------------------------------------------------------------------
  13+ 8889              Audio_UpdateJumpSound:
  14+ 8889 F5               push af
  15+ 888A C5               push bc
  16+ 888B D5               push de
  17+ 888C E5               push hl
  18+ 888D
  19+ 888D                  ; Controlla se il suono è attivo (note < 18)
  20+ 888D 3A 11 F1         ld   a, (Audio_jump_sound_note)
  21+ 8890 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8892 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8894
  24+ 8894                  ; Carica la nota corrente da suonare
  25+ 8894 5F               ld   e, a
  26+ 8895 16 00            ld   d, 0
  27+ 8897 21 C3 88         ld   hl, Audio_JumpSoundDelays
  28+ 889A 19               add  hl, de
  29+ 889B 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 889C 57               ld   d, a                      ; D = delay della nota
  31+ 889D
  32+ 889D                  ; Suona la nota: 15 cicli
  33+ 889D 06 0F            ld   b, 15
  34+ 889F              .note_loop:
  35+ 889F                  ; Speaker ON
  36+ 889F 3A FD EA         ld   a, (room_border_color)
  37+ 88A2 F6 10            or   $10
  38+ 88A4 D3 FE            out  ($fe), a
  39+ 88A6 4A               ld   c, d
  40+ 88A7              .d1:
  41+ 88A7 0D               dec  c
  42+ 88A8 20 FD            jr   nz, .d1
  43+ 88AA
  44+ 88AA                  ; Speaker OFF
  45+ 88AA 3A FD EA         ld   a, (room_border_color)
  46+ 88AD E6 EF            and  $ef
  47+ 88AF D3 FE            out  ($fe), a
  48+ 88B1 4A               ld   c, d
  49+ 88B2              .d2:
  50+ 88B2 0D               dec  c
  51+ 88B3 20 FD            jr   nz, .d2
  52+ 88B5
  53+ 88B5 10 E8            djnz .note_loop
  54+ 88B7
  55+ 88B7                  ; Passa alla nota successiva
  56+ 88B7 3A 11 F1         ld   a, (Audio_jump_sound_note)
  57+ 88BA 3C               inc  a
  58+ 88BB 32 11 F1         ld   (Audio_jump_sound_note), a
  59+ 88BE
  60+ 88BE              .done:
  61+ 88BE E1               pop  hl
  62+ 88BF D1               pop  de
  63+ 88C0 C1               pop  bc
  64+ 88C1 F1               pop  af
  65+ 88C2 C9               ret
  66+ 88C3
  67+ 88C3              Audio_JumpSoundDelays:
  68+ 88C3 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 88C7 19 13 0C 06
  68+ 88CB 0C 13 19 20
  68+ 88CF 26 2D 33 3A
  68+ 88D3 40 47

 848+ 774D              ; -------------------------------------------------------------------
 849+ 774D              IsCellOnRamp:
 850+ 774D C5               push bc
 851+ 774E E5               push hl
 852+ 774F
 853+ 774F 3A D6 E4         ld   a, (ramp_len)
 854+ 7752 B7               or   a
 855+ 7753 28 6B            jr   z, .no
 856+ 7755
 857+ 7755                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 858+ 7755 3A D5 E4         ld   a, (ramp_dir)
 859+ 7758 B7               or   a
 860+ 7759 28 1A            jr   z, .range_left
 861+ 775B              .range_right:
 862+ 775B 3A D8 E4         ld   a, (ramp_col)
 863+ 775E 47               ld   b, a              ; B = ramp_col
 864+ 775F 3A D6 E4         ld   a, (ramp_len)
 865+ 7762 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7763 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7764
 868+ 7764 7B               ld   a, e              ; A = Col
 869+ 7765 B8               cp   b
 870+ 7766 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7768 B9               cp   c
 872+ 7769 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 776B
 874+ 776B                  ; Calcola B = Col - ramp_col
 875+ 776B 7B               ld   a, e
 876+ 776C 90               sub  b
 877+ 776D 47               ld   b, a              ; B = offset (0..ramp_len-1)
 878+ 776E
 879+ 776E                  ; SlopeRow = ramp_row - B
 880+ 776E 3A D7 E4         ld   a, (ramp_row)

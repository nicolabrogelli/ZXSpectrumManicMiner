 210+ 852B 69               ld   l, c
 211+ 852C 01 00 A4         ld   bc, -23552
 212+ 852F 09               add  hl, bc                    ; HL = AttrOffset
 213+ 8530
 214+ 8530                  ; Col = Offset & 31
 215+ 8530 7D               ld   a, l
 216+ 8531 E6 1F            and  31
 217+ 8533 4F               ld   c, a                      ; C = Col (0..31)
 218+ 8534
 219+ 8534                  ; Row = Offset / 32
 220+ 8534 CB 3C            srl  h
 220+ 8536 CB 1D          rr l
 221+ 8538 CB 3C            srl  h
 221+ 853A CB 1D          rr l
 222+ 853C CB 3C            srl  h
 222+ 853E CB 1D          rr l
 223+ 8540 CB 3C            srl  h
 223+ 8542 CB 1D          rr l
 224+ 8544 CB 3C            srl  h
 224+ 8546 CB 1D          rr l
 225+ 8548 7D               ld   a, l
 226+ 8549 47               ld   b, a                      ; B = Row (0..15)

 254+ 7E2B D5               push de
 255+ 7E2C E5               push hl
 256+ 7E2D
 257+ 7E2D                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 258+ 7E2D 78               ld   a, b
 259+ 7E2E E6 18            and  $18

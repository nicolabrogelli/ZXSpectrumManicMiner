 138+ 80A2              ; Items_DrawRoom
 139+ 80A2              ;
 140+ 80A2              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 80A2              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 80A2              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 80A2              ;
 144+ 80A2              ; Record item nella stanza (5 byte):
 145+ 80A2              ;   +0 Color / Attributo
 146+ 80A2              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 80A2              ;   +2 Attr Address High
 148+ 80A2              ;   +3 Anim Mask (96)
 149+ 80A2              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 80A2              ; Fine lista: $FF
 151+ 80A2              ; -------------------------------------------------------------------
 152+ 80A2              Items_DrawRoom:
 153+ 80A2 E5               push hl
 154+ 80A3 D5               push de
 155+ 80A4 C5               push bc
 156+ 80A5 DD E5            push ix
 157+ 80A7 FD E5            push iy
 158+ 80A9
 159+ 80A9                  ; 1. Azzera items_grid (512 byte)
 160+ 80A9 21 32 9C         ld   hl, items_grid
 161+ 80AC 11 33 9C         ld   de, items_grid + 1
 162+ 80AF 36 00            ld   (hl), 0
 163+ 80B1 01 FF 01         ld   bc, 511
 164+ 80B4 ED B0            ldir
 165+ 80B6
 166+ 80B6                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 80B6 AF               xor  a
 168+ 80B7 32 B2 A1         ld   (num_room_items), a
 169+ 80BA
 170+ 80BA FD 21 62 A1      ld   iy, current_room_items
 171+ 80BE
 172+ 80BE                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80BE 2A B3 A1         ld   hl, (room_ptr)
 174+ 80C1 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80C4 19               add  hl, de
 176+ 80C5 E5               push hl
 177+ 80C6 DD E1            pop  ix                        ; IX = bitmap item
 178+ 80C8
 179+ 80C8                  ; 4. HL = Inizio lista item nella stanza
 180+ 80C8 2A B3 A1         ld   hl, (room_ptr)
 181+ 80CB 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80CE 19               add  hl, de
 183+ 80CF
 184+ 80CF              .loop:
 185+ 80CF 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80D0 FE FF            cp   $FF
 187+ 80D2 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80D4
 189+ 80D4 5F               ld   e, a                      ; E = Color
 190+ 80D5 23               inc  hl
 191+ 80D6 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80D7 23               inc  hl
 193+ 80D8 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80D9 23               inc  hl                        ; Salta Anim Byte
 195+ 80DA 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80DB
 197+ 80DB 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80DC FE FF            cp   $FF
 199+ 80DE 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 80E0
 201+ 80E0                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 80E0 E5               push hl
 203+ 80E1 60               ld   h, b
 204+ 80E2 69               ld   l, c
 205+ 80E3 01 00 A4         ld   bc, -23552
 206+ 80E6 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80E7
 208+ 80E7                  ; Col = Offset & 31

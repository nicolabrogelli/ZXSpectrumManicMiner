 397  80F9 21 06 64         ld   hl, game_over_color_table
 398  80FC 19               add  hl, de
 399  80FD 7E               ld   a, (hl)               ; A = nuovo colore attributo
 400  80FE 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 401  8101 06 09            ld   b, 9

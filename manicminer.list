   8+ 83E2              ; Audio_UpdateJumpSound
   9+ 83E2              ;
  10+ 83E2              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 83E2              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 83E2              ; -------------------------------------------------------------------
  13+ 83E2              Audio_UpdateJumpSound:
  14+ 83E2 F5               push af
  15+ 83E3 C5               push bc
  16+ 83E4 D5               push de
  17+ 83E5 E5               push hl
  18+ 83E6
  19+ 83E6                  ; Controlla se il suono è attivo (note < 18)
  20+ 83E6 3A 06 E5         ld   a, (Audio_jump_sound_note)
  21+ 83E9 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 83EB 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 83ED
  24+ 83ED                  ; Carica la nota corrente da suonare
  25+ 83ED 5F               ld   e, a
  26+ 83EE 16 00            ld   d, 0
  27+ 83F0 21 1C 84         ld   hl, Audio_JumpSoundDelays
  28+ 83F3 19               add  hl, de
  29+ 83F4 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 83F5 57               ld   d, a                      ; D = delay della nota
  31+ 83F6
  32+ 83F6                  ; Suona la nota: 15 cicli
  33+ 83F6 06 0F            ld   b, 15
  34+ 83F8              .note_loop:
  35+ 83F8                  ; Speaker ON
  36+ 83F8 3A F6 DE         ld   a, (room_border_color)
  37+ 83FB F6 10            or   $10
  38+ 83FD D3 FE            out  ($fe), a
  39+ 83FF 4A               ld   c, d
  40+ 8400              .d1:
  41+ 8400 0D               dec  c
  42+ 8401 20 FD            jr   nz, .d1
  43+ 8403
  44+ 8403                  ; Speaker OFF
  45+ 8403 3A F6 DE         ld   a, (room_border_color)
  46+ 8406 E6 EF            and  $ef
  47+ 8408 D3 FE            out  ($fe), a
  48+ 840A 4A               ld   c, d
  49+ 840B              .d2:
  50+ 840B 0D               dec  c
  51+ 840C 20 FD            jr   nz, .d2
  52+ 840E
  53+ 840E 10 E8            djnz .note_loop
  54+ 8410
  55+ 8410                  ; Passa alla nota successiva
  56+ 8410 3A 06 E5         ld   a, (Audio_jump_sound_note)
  57+ 8413 3C               inc  a
  58+ 8414 32 06 E5         ld   (Audio_jump_sound_note), a

 163  7F9C ~                ld   a, (willy_on_ramp)
 164  7F9C ~                or   a
 165  7F9C ~                jp   nz, .draw_raster_bars
 166  7F9C                  ENDIF
 167  7F9C
 168  7F9C C3 19 80         jp   .no_collision
 169  7F9F
 170  7F9F              .guardian_collision_found:
 171  7F9F                  ; C'è collisione con un guardiano!
 172  7F9F                  ; Controlla se la morte per collisione con i guardiani è abilitata
 173  7F9F                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 174  7F9F C3 A2 7F         jp   .willy_dies
 175  7FA2                  ELSE
 176  7FA2 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 177  7FA2 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 178  7FA2 ~                    ELSE
 179  7FA2 ~                    jp   .no_collision
 180  7FA2 ~                    ENDIF
 181  7FA2                  ENDIF
 182  7FA2
 183  7FA2              .willy_dies:
 184  7FA2                  ; 1. Decrementa le vite
 185  7FA2 21 06 8E         ld   hl, willy_lives
 186  7FA5 7E               ld   a, (hl)
 187  7FA6 B7               or   a
 188  7FA7 28 05            jr   z, .check_game_over
 189  7FA9 35               dec  (hl)
 190  7FAA 28 02            jr   z, .check_game_over
 191  7FAC 18 03            jr   .normal_respawn
 192  7FAE
 193  7FAE              .check_game_over:
 194  7FAE                  IF ENABLE_GAME_OVER_RESTART != 0
 195  7FAE C3 70 80         jp   TriggerGameOver
 196  7FB1                  ELSE
 197  7FB1 ~                ld   a, 1
 198  7FB1 ~                ld   (willy_lives), a
 199  7FB1 ~                jr   .normal_respawn
 200  7FB1                  ENDIF
 201  7FB1
 202  7FB1              .normal_respawn:
 203  7FB1                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  7FB1 AF               xor  a
 205  7FB2 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  7FB4 21 8D 5C         ld   hl, ATTR_P
 207  7FB7 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  7FB8 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  7FBB 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  7FBD 3E 07            ld   a, $07
 211  7FBF 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  7FC2
 213  7FC2                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  7FC2 06 19            ld   b, 25
 215  7FC4              .death_pause:
 216  7FC4 76               halt
 217  7FC5 10 FD            djnz .death_pause
 218  7FC7
 219  7FC7                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  7FC7 AF               xor  a
 221  7FC8 32 07 8E         ld   (velocity_y), a
 222  7FCB 32 09 8E         ld   (jump_pressed), a
 223  7FCE 32 0B 8E         ld   (coyote_timer), a
 224  7FD1 32 0E 8E         ld   (jump_frame), a
 225  7FD4 32 0D 8E         ld   (jump_dir), a
 226  7FD7 3E 01            ld   a, 1
 227  7FD9 32 08 8E         ld   (on_ground), a
 228  7FDC
 229  7FDC 3E 32            ld   a, RESPAWN_SAFETY_TIME
 230  7FDE 32 03 92         ld   (willy_safety_timer), a
 231  7FE1
 232  7FE1                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  7FE1 CD 45 7C         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  7FE4 21 80 91         ld   hl, room_entry_positions
 235  7FE7 5F               ld   e, a
 236  7FE8 16 00            ld   d, 0
 237  7FEA 19               add  hl, de
 238  7FEB 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  7FEC 4E               ld   c, (hl)                   ; C = X ingresso
 240  7FED 23               inc  hl
 241  7FEE 46               ld   b, (hl)                   ; B = Y ingresso
 242  7FEF ED 43 F9 8D      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  7FF3 ED 43 FB 8D      ld   (PlayerPosOld), bc
 244  7FF7
 245  7FF7 3E 01            ld   a, 1
 246  7FF9 32 7F 91         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  7FFC
 248  7FFC                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  7FFC C3 03 7F         jp   LoadRoomAndRestart
 250  7FFF
 251  7FFF              .draw_raster_bars:
 252  7FFF                  ; Collisione attiva: disegna le raster bar nel bordo
 253  7FFF 3A 1A 8E         ld   a, (counter)
 254  8002 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  8004 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  8006              .raster_loop:
 257  8006 D3 FE            out  ($fe), a
 258  8008 3C               inc  a
 259  8009 E6 07            and  7
 260  800B 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  800D              .delay:
 262  800D 0D               dec  c
 263  800E 20 FD            jr   nz, .delay
 264  8010 10 F4            djnz .raster_loop
 265  8012
 266  8012                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8012 3A 05 8E         ld   a, (room_border_color)
 268  8015 D3 FE            out  ($fe), a
 269  8017 18 05            jr   .no_collision_change
 270  8019
 271  8019              .no_collision:
 272  8019                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 273  8019 3A 05 8E         ld   a, (room_border_color)
 274  801C D3 FE            out  ($fe), a
 275  801E
 276  801E              .no_collision_change:
 277  801E C3 49 7F         jp   Main_loop
 278  8021
 279  8021              ; -------------------------------------------------------------------
 280  8021              ; ShowTitleScreen
 281  8021              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  8021              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  8021              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  8021              ; -------------------------------------------------------------------
 285  8021              ShowTitleScreen:
 286  8021                  ; 1. Disegna la schermata iniziale
 287  8021 CD 64 62         call Gfx_DrawTitleScreen
 288  8024
 289  8024                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8024              .wait_title_enter_release:
 291  8024 76               halt
 292  8025 3E BF            ld   a, $bf
 293  8027 DB FE            in   a, ($fe)
 294  8029 1F               rra
 295  802A 30 F8            jr   nc, .wait_title_enter_release
 296  802C
 297  802C                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  802C 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  802E              .title_loop:
 300  802E 76               halt
 301  802F
 302  802F                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  802F 0C               inc  c
 304  8030 79               ld   a, c
 305  8031 CB 3F            srl  a
 306  8033 CB 3F            srl  a
 307  8035 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  8037 E6 07            and  7
 309  8039 5F               ld   e, a
 310  803A 16 00            ld   d, 0
 311  803C 21 5C 62         ld   hl, title_color_table
 312  803F 19               add  hl, de
 313  8040 7E               ld   a, (hl)               ; A = nuovo colore
 314  8041 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  8044 06 20            ld   b, 32
 316  8046              .color_title_loop:
 317  8046 77               ld   (hl), a
 318  8047 23               inc  hl
 319  8048 10 FC            djnz .color_title_loop
 320  804A
 321  804A                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  804A 3E BF            ld   a, $bf
 323  804C DB FE            in   a, ($fe)
 324  804E 1F               rra
 325  804F 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  8051
 327  8051                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  8051              .wait_title_enter_release_after:
 329  8051 76               halt
 330  8052 3E BF            ld   a, $bf
 331  8054 DB FE            in   a, ($fe)
 332  8056 1F               rra
 333  8057 30 F8            jr   nc, .wait_title_enter_release_after
 334  8059
 335  8059                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  8059 AF               xor  a
 337  805A D3 FE            out  ($fe), a              ; Bordo a nero
 338  805C 21 8D 5C         ld   hl, ATTR_P
 339  805F 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  8060 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  8063 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  8065 3E 07            ld   a, $07
 343  8067 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  806A
 345  806A                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  806A CD DF 82         call ResetFullGameState
 347  806D
 348  806D                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  806D C3 03 7F         jp   LoadRoomAndRestart
 350  8070
 351  8070              ; -------------------------------------------------------------------
 352  8070              ; TriggerGameOver
 353  8070              ; Scatena la schermata di Game Over per la stanza corrente.
 354  8070              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 355  8070              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 356  8070              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 357  8070              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 358  8070              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 359  8070              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 360  8070              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 361  8070              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 362  8070              ; -------------------------------------------------------------------
 363  8070              TriggerGameOver:
 364  8070                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 365  8070 CD 45 64         call Gfx_DrawGameOverScreen
 366  8073
 367  8073                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 368  8073              .wait_keys_release:
 369  8073 76               halt
 370  8074                  ; Controlla tasto Y (Porta $DF, bit 4)
 371  8074 01 FE DF         ld   bc, $dffe
 372  8077 ED 78            in   a, (c)
 373  8079 CB 67            bit  4, a
 374  807B 28 F6            jr   z, .wait_keys_release
 375  807D
 376  807D                  ; Controlla tasto N (Porta $7F, bit 3)
 377  807D 01 FE 7F         ld   bc, $7ffe
 378  8080 ED 78            in   a, (c)
 379  8082 CB 5F            bit  3, a
 380  8084 28 ED            jr   z, .wait_keys_release
 381  8086
 382  8086                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 383  8086 01 FE BF         ld   bc, $bffe
 384  8089 ED 78            in   a, (c)
 385  808B CB 47            bit  0, a
 386  808D 28 E4            jr   z, .wait_keys_release
 387  808F
 388  808F                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 389  808F 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 390  8091              .wait_choice_loop:
 391  8091 76               halt
 392  8092
 393  8092                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 394  8092 0C               inc  c
 395  8093 79               ld   a, c
 396  8094 CB 3F            srl  a
 397  8096 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 398  8098 E6 07            and  7
 399  809A 5F               ld   e, a
 400  809B 16 00            ld   d, 0
 401  809D 21 01 64         ld   hl, game_over_color_table
 402  80A0 19               add  hl, de
 403  80A1 7E               ld   a, (hl)               ; A = nuovo colore attributo
 404  80A2 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 405  80A5 06 09            ld   b, 9
 406  80A7              .color_cycle_loop:
 407  80A7 77               ld   (hl), a
 408  80A8 23               inc  hl
 409  80A9 10 FC            djnz .color_cycle_loop
 410  80AB
 411  80AB                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 412  80AB 01 FE DF         ld   bc, $dffe
 413  80AE ED 78            in   a, (c)
 414  80B0 CB 67            bit  4, a
 415  80B2 28 2A            jr   z, .continue_chosen
 416  80B4
 417  80B4                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 418  80B4 01 FE 7F         ld   bc, $7ffe
 419  80B7 ED 78            in   a, (c)
 420  80B9 CB 5F            bit  3, a
 421  80BB 28 0B            jr   z, .quit_chosen
 422  80BD
 423  80BD                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 424  80BD 01 FE BF         ld   bc, $bffe
 425  80C0 ED 78            in   a, (c)
 426  80C2 CB 47            bit  0, a
 427  80C4 28 02            jr   z, .quit_chosen
 428  80C6
 429  80C6 18 C9            jr   .wait_choice_loop
 430  80C8
 431  80C8              .quit_chosen:
 432  80C8                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 433  80C8              .wait_quit_release:
 434  80C8 76               halt
 435  80C9 01 FE 7F         ld   bc, $7ffe

  72+ 889A ~            ; Audio_UpdateMusic
  73+ 889A ~            ;
  74+ 889A ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 889A ~            ; Viene chiamata a ogni frame.
  76+ 889A ~            ; -------------------------------------------------------------------
  77+ 889A ~            Audio_UpdateMusic:
  78+ 889A ~                push af
  79+ 889A ~                push bc
  80+ 889A ~                push de
  81+ 889A ~                push hl
  82+ 889A ~
  83+ 889A ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 889A ~                ld   a, (Audio_jump_sound_note)
  85+ 889A ~                cp   18
  86+ 889A ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 889A ~
  88+ 889A ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 889A ~                ld   a, (Audio_music_frame_counter)
  90+ 889A ~                dec  a
  91+ 889A ~                ld   (Audio_music_frame_counter), a
  92+ 889A ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 889A ~
  94+ 889A ~                ; Altrimenti carica la nota successiva
  95+ 889A ~                ld   a, (Audio_music_note_idx)
  96+ 889A ~                inc  a
  97+ 889A ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 889A ~                jr   c, .no_wrap
  99+ 889A ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 889A ~            .no_wrap:
 101+ 889A ~                ld   (Audio_music_note_idx), a
 102+ 889A ~
 103+ 889A ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 889A ~                ld   e, a
 105+ 889A ~                ld   d, 0
 106+ 889A ~                ld   hl, Audio_MusicSheet
 107+ 889A ~                add  hl, de
 108+ 889A ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 889A ~
 110+ 889A ~                ; Leggi durata (secondo byte)
 111+ 889A ~                inc  hl
 112+ 889A ~                ld   a, (hl)
 113+ 889A ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 889A ~                jr   nz, .dur_ok
 115+ 889A ~                ld   a, 1
 116+ 889A ~            .dur_ok:
 117+ 889A ~                ld   (Audio_music_frame_counter), a
 118+ 889A ~
 119+ 889A ~            .play_current_note:
 120+ 889A ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 889A ~                ld   a, (Audio_music_note_idx)
 122+ 889A ~                ld   e, a
 123+ 889A ~                ld   d, 0
 124+ 889A ~                ld   hl, Audio_MusicSheet
 125+ 889A ~                add  hl, de
 126+ 889A ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 889A ~                ld   a, (hl)                  ; A = delay
 128+ 889A ~                or   a
 129+ 889A ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 889A ~
 131+ 889A ~                ; Suona la nota: 2 cicli
 132+ 889A ~                ld   d, a                     ; D = delay
 133+ 889A ~                ld   b, 2                     ; 2 cicli per frame
 134+ 889A ~            .note_loop:
 135+ 889A ~                ; Speaker ON
 136+ 889A ~                ld   a, (room_border_color)
 137+ 889A ~                or   $10
 138+ 889A ~                out  ($fe), a
 139+ 889A ~                ld   c, d
 140+ 889A ~            .d1:
 141+ 889A ~                push af
 142+ 889A ~                pop  af
 143+ 889A ~                dec  c
 144+ 889A ~                jr   nz, .d1
 145+ 889A ~
 146+ 889A ~                ; Speaker OFF
 147+ 889A ~                ld   a, (room_border_color)
 148+ 889A ~                and  $ef
 149+ 889A ~                out  ($fe), a
 150+ 889A ~                ld   c, d
 151+ 889A ~            .d2:
 152+ 889A ~                push af
 153+ 889A ~                pop  af
 154+ 889A ~                dec  c
 155+ 889A ~                jr   nz, .d2
 156+ 889A ~
 157+ 889A ~                djnz .note_loop
 158+ 889A ~
 159+ 889A ~            .done:
 160+ 889A ~                pop  hl
 161+ 889A ~                pop  de
 162+ 889A ~                pop  bc
 163+ 889A ~                pop  af
 164+ 889A ~                ret
 165+ 889A ~
 166+ 889A ~            Audio_MusicSheet:
 167+ 889A ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 889A ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 889A ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 889A ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 889A ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 889A ~                db 90, 10, 107, 20, 68, 65

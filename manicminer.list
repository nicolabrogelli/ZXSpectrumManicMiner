 638  8B79              ; -------------------------------------------------------------------
 639  8B79              ; Air_DepleteCountdown
 640  8B79              ; Animazione originale di completamento livello (Manic Miner):
 641  8B79              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8B79              ; - Ad ogni pixel decrementato:
 643  8B79              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8B79              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8B79              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8B79              ; -------------------------------------------------------------------
 647  8B79              Air_DepleteCountdown:
 648  8B79 F5               push af
 649  8B7A C5               push bc
 650  8B7B D5               push de
 651  8B7C E5               push hl
 652  8B7D
 653  8B7D              .countdown_loop:
 654  8B7D 3A D8 F0         ld   a, (air_pixels)
 655  8B80 B7               or   a
 656  8B81 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8B83
 658  8B83 3D               dec  a
 659  8B84 32 D8 F0         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8B87
 661  8B87                  ; Aggiorna la barra grafica dell'aria
 662  8B87 CD 2D 6A         call Gfx_UpdateAirBar
 663  8B8A
 664  8B8A                  ; Aggiungi 1 punto allo score
 665  8B8A CD 7D 87         call Score_Add1Point
 666  8B8D
 667  8B8D                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8B8D                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8B8D 3A D8 F0         ld   a, (air_pixels)
 670  8B90 2F               cpl
 671  8B91 E6 3F            and  63
 672  8B93 07               rlca
 673  8B94 3C               inc  a
 674  8B95 57               ld   d, a                      ; D = ritardo semionda audio
 675  8B96
 676  8B96 0E 03            ld   c, 3                      ; Durata impulso
 677  8B98              .audio_loop:
 678  8B98 AF               xor  a
 679  8B99 D3 FE            out  ($fe), a
 680  8B9B 42               ld   b, d
 681  8B9C 10 FE        .w1: djnz .w1
 682  8B9E
 683  8B9E 3E 18            ld   a, $18
 684  8BA0 D3 FE            out  ($fe), a
 685  8BA2 42               ld   b, d
 686  8BA3 10 FE        .w2: djnz .w2
 687  8BA5
 688  8BA5 0D               dec  c
 689  8BA6 20 F0            jr   nz, .audio_loop
 690  8BA8
 691  8BA8 18 D3            jr   .countdown_loop
 692  8BAA
 693  8BAA              .done_countdown:
 694  8BAA E1               pop  hl
 695  8BAB D1               pop  de
 696  8BAC C1               pop  bc
 697  8BAD F1               pop  af
 698  8BAE C9               ret

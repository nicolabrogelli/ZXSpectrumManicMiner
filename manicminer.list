 929+ 77FF 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 930+ 7800 47               ld   b, a              ; B = limit_left
 931+ 7801
 932+ 7801 3A 61 A1         ld   a, (ramp_col)
 933+ 7804 3C               inc  a
 934+ 7805 4F               ld   c, a              ; C = limit_right (exclusive)
 935+ 7806
 936+ 7806 7B               ld   a, e              ; A = Col
 937+ 7807 B8               cp   b
 938+ 7808 38 15            jr   c, .check_platform_case
 939+ 780A B9               cp   c
 940+ 780B 30 12            jr   nc, .check_platform_case
 941+ 780D
 942+ 780D                  ; Calcola B = ramp_col - Col
 943+ 780D 3A 61 A1         ld   a, (ramp_col)
 944+ 7810 93               sub  e
 945+ 7811 47               ld   b, a              ; B = offset
 946+ 7812
 947+ 7812                  ; SlopeRow = ramp_row - B
 948+ 7812 3A 60 A1         ld   a, (ramp_row)
 949+ 7815 90               sub  b

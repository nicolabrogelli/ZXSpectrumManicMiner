 142+ 85A2              ; Items_DrawRoom
 143+ 85A2              ;
 144+ 85A2              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 85A2              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 85A2              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 85A2              ;
 148+ 85A2              ; Record item nella stanza (5 byte):
 149+ 85A2              ;   +0 Color / Attributo
 150+ 85A2              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 85A2              ;   +2 Attr Address High
 152+ 85A2              ;   +3 Anim Mask (96)

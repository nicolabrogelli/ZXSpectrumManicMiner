 313  81A6              .title_loop:
 314  81A6 76               halt
 315  81A7
 316  81A7                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 317  81A7 0C               inc  c
 318  81A8 79               ld   a, c
 319  81A9 CB 3F            srl  a
 320  81AB CB 3F            srl  a
 321  81AD CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 322  81AF E6 07            and  7
 323  81B1 5F               ld   e, a
 324  81B2 16 00            ld   d, 0
 325  81B4 21 7D 62         ld   hl, title_color_table
 326  81B7 19               add  hl, de
 327  81B8 7E               ld   a, (hl)               ; A = nuovo colore
 328  81B9 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 329  81BC 06 20            ld   b, 32

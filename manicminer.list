 437+ 7EBC              ; Enemy_Update
 438+ 7EBC              ;
 439+ 7EBC              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 440+ 7EBC              ; -------------------------------------------------------------------
 441+ 7EBC              Enemy_Update:
 442+ 7EBC                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 443+ 7EBC 3A 4E B6         ld   a, (enemy_update_rate)
 444+ 7EBF FE 01            cp   1
 445+ 7EC1 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 446+ 7EC3
 447+ 7EC3 21 4F B6         ld   hl, enemy_update_timer
 448+ 7EC6 34               inc  (hl)
 449+ 7EC7 7E               ld   a, (hl)
 450+ 7EC8 21 4E B6         ld   hl, enemy_update_rate
 451+ 7ECB BE               cp   (hl)
 452+ 7ECC D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 453+ 7ECD AF               xor  a
 454+ 7ECE 32 4F B6         ld   (enemy_update_timer), a

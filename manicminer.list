 180  7F95 ~                    ENDIF
 181  7F95                  ENDIF
 182  7F95
 183  7F95              .willy_dies:
 184  7F95                  ; 1. Decrementa le vite
 185  7F95 21 F9 8D         ld   hl, willy_lives
 186  7F98 7E               ld   a, (hl)
 187  7F99 B7               or   a
 188  7F9A 28 05            jr   z, .check_game_over
 189  7F9C 35               dec  (hl)
 190  7F9D 28 02            jr   z, .check_game_over
 191  7F9F 18 03            jr   .normal_respawn
 192  7FA1
 193  7FA1              .check_game_over:
 194  7FA1                  IF ENABLE_GAME_OVER_RESTART != 0
 195  7FA1 C3 63 80         jp   TriggerGameOver
 196  7FA4                  ELSE
 197  7FA4 ~                ld   a, 1
 198  7FA4 ~                ld   (willy_lives), a
 199  7FA4 ~                jr   .normal_respawn
 200  7FA4                  ENDIF
 201  7FA4
 202  7FA4              .normal_respawn:
 203  7FA4                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 204  7FA4 AF               xor  a
 205  7FA5 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 206  7FA7 21 8D 5C         ld   hl, ATTR_P
 207  7FAA 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 208  7FAB CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 209  7FAE 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 210  7FB0 3E 07            ld   a, $07
 211  7FB2 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 212  7FB5
 213  7FB5                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 214  7FB5 06 19            ld   b, 25
 215  7FB7              .death_pause:
 216  7FB7 76               halt
 217  7FB8 10 FD            djnz .death_pause
 218  7FBA
 219  7FBA                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 220  7FBA AF               xor  a
 221  7FBB 32 FA 8D         ld   (velocity_y), a
 222  7FBE 32 FC 8D         ld   (jump_pressed), a
 223  7FC1 32 FE 8D         ld   (coyote_timer), a
 224  7FC4 32 01 8E         ld   (jump_frame), a
 225  7FC7 32 00 8E         ld   (jump_dir), a
 226  7FCA 3E 01            ld   a, 1
 227  7FCC 32 FB 8D         ld   (on_ground), a
 228  7FCF
 229  7FCF 3E 32            ld   a, RESPAWN_SAFETY_TIME
 230  7FD1 32 F6 91         ld   (willy_safety_timer), a
 231  7FD4
 232  7FD4                  ; 5. Riposiziona Willy nel punto di ingresso dell'ultima stanza raggiunta
 233  7FD4 CD 38 7C         call DetermineCurrentRoomID    ; A = ID stanza corrente (0..60)
 234  7FD7 21 73 91         ld   hl, room_entry_positions
 235  7FDA 5F               ld   e, a
 236  7FDB 16 00            ld   d, 0
 237  7FDD 19               add  hl, de
 238  7FDE 19               add  hl, de                    ; HL = room_entry_positions + (current_room * 2)
 239  7FDF 4E               ld   c, (hl)                   ; C = X ingresso
 240  7FE0 23               inc  hl
 241  7FE1 46               ld   b, (hl)                   ; B = Y ingresso
 242  7FE2 ED 43 EC 8D      ld   (PlayerPos), bc           ; Imposta le coordinate di respawn al punto di ingresso
 243  7FE6 ED 43 EE 8D      ld   (PlayerPosOld), bc
 244  7FEA
 245  7FEA 3E 01            ld   a, 1
 246  7FEC 32 72 91         ld   (transition_active), a    ; Evita sovrascrittura con OFFSET_POS_WILLY in LoadRoomAndRestart
 247  7FEF
 248  7FEF                  ; 6. Ridisegna completamente la stanza e riposiziona Willy nel punto di ingresso
 249  7FEF C3 F6 7E         jp   LoadRoomAndRestart
 250  7FF2
 251  7FF2              .draw_raster_bars:
 252  7FF2                  ; Collisione attiva: disegna le raster bar nel bordo
 253  7FF2 3A 0D 8E         ld   a, (counter)
 254  7FF5 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 255  7FF7 06 1E            ld   b, 30             ; Numero di righe della barra raster
 256  7FF9              .raster_loop:
 257  7FF9 D3 FE            out  ($fe), a
 258  7FFB 3C               inc  a
 259  7FFC E6 07            and  7
 260  7FFE 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 261  8000              .delay:

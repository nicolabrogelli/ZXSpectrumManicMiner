 293+ 85C2              ; DrawItemGraphic
 294+ 85C2              ;
 295+ 85C2              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 85C2              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 85C2              ;
 298+ 85C2              ; Input:
 299+ 85C2              ;   B = Riga attributi (0..23)
 300+ 85C2              ;   C = Colonna attributi (0..31)
 301+ 85C2              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 85C2              ;   E = Attributo colore
 303+ 85C2              ; -------------------------------------------------------------------
 304+ 85C2              DrawItemGraphic:
 305+ 85C2 C5               push bc
 306+ 85C3 D5               push de
 307+ 85C4 E5               push hl
 308+ 85C5
 309+ 85C5                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 310+ 85C5 78               ld   a, b
 311+ 85C6 E6 18            and  $18
 312+ 85C8 C6 40            add  a, $40
 313+ 85CA 57               ld   d, a                      ; Byte alto indirizzo video
 314+ 85CB
 315+ 85CB 78               ld   a, b
 316+ 85CC E6 07            and  7
 317+ 85CE 87               add  a, a                      ; *2
 318+ 85CF 87               add  a, a                      ; *4
 319+ 85D0 87               add  a, a                      ; *8
 320+ 85D1 87               add  a, a                      ; *16
 321+ 85D2 87               add  a, a                      ; *32
 322+ 85D3 81               add  a, c                      ; + Col
 323+ 85D4 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 85D5
 325+ 85D5 C5               push bc
 326+ 85D6 06 08            ld   b, 8                      ; 8 scanline
 327+ 85D8              .line_loop:
 328+ 85D8 7E               ld   a, (hl)
 329+ 85D9 12               ld   (de), a
 330+ 85DA 14               inc  d
 331+ 85DB 23               inc  hl
 332+ 85DC 05               dec  b
 333+ 85DD 20 F9            jr   nz, .line_loop
 334+ 85DF C1               pop  bc
 335+ 85E0
 336+ 85E0                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 337+ 85E0 26 00            ld   h, 0
 338+ 85E2 68               ld   l, b
 339+ 85E3 29               add  hl, hl
 340+ 85E4 29               add  hl, hl
 341+ 85E5 29               add  hl, hl
 342+ 85E6 29               add  hl, hl
 343+ 85E7 29               add  hl, hl                    ; Row * 32
 344+ 85E8 79               ld   a, c
 345+ 85E9 85               add  a, l
 346+ 85EA 6F               ld   l, a
 347+ 85EB 30 01            jr   nc, .no_carry
 348+ 85ED 24               inc  h
 349+ 85EE              .no_carry:
 350+ 85EE 11 00 58         ld   de, $5800
 351+ 85F1 19               add  hl, de
 352+ 85F2
 353+ 85F2 C1               pop  bc                        ; Recupera HL originale
 354+ 85F3 D1               pop  de                        ; Recupera DE originale (E = colore)
 355+ 85F4 7B               ld   a, e
 356+ 85F5 77               ld   (hl), a                   ; Scrive l'attributo colore
 357+ 85F6
 358+ 85F6 C5               push bc
 359+ 85F7 E1               pop  hl
 360+ 85F8 C1               pop  bc
 361+ 85F9 C9               ret

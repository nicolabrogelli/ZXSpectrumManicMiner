 416  8529 10 FC            djnz .color_cycle_loop
 417  852B
 418  852B                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 419  852B 01 FE DF         ld   bc, $dffe
 420  852E ED 78            in   a, (c)
 421  8530 CB 67            bit  4, a
 422  8532 28 2A            jr   z, .continue_chosen
 423  8534
 424  8534                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)

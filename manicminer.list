 497  86DA 32 4C AF         ld   (willy_needs_redraw), a
 498  86DD 3E FF            ld   a, $ff
 499  86DF 32 5E AB         ld   (digit_key_prev), a
 500  86E2 32 47 AF         ld   (player_drawn_pos+1), a

  29+ 7EDF              ; Enemy_LoadRoom
  30+ 7EDF              ;
  31+ 7EDF              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7EDF              ; Chiamato quando si entra in una stanza.
  33+ 7EDF              ; -------------------------------------------------------------------
  34+ 7EDF              Enemy_LoadRoom:
  35+ 7EDF E5               push hl
  36+ 7EE0 D5               push de
  37+ 7EE1 C5               push bc
  38+ 7EE2 DD E5            push ix
  39+ 7EE4
  40+ 7EE4                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7EE4 21 87 7E         ld   hl, ActiveEnemies
  42+ 7EE7 11 88 7E         ld   de, ActiveEnemies + 1
  43+ 7EEA 36 00            ld   (hl), 0
  44+ 7EEC 01 57 00         ld   bc, 87
  45+ 7EEF ED B0            ldir
  46+ 7EF1
  47+ 7EF1                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7EF1 DD 21 87 7E      ld   ix, ActiveEnemies
  49+ 7EF5 06 08            ld   b, 8
  50+ 7EF7 11 0B 00         ld   de, 11
  51+ 7EFA              .init_old_pos:
  52+ 7EFA DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7EFE DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7F02 DD 19            add  ix, de
  55+ 7F04 10 F4            djnz .init_old_pos
  56+ 7F06
  57+ 7F06                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7F06 DD 21 87 7E      ld   ix, ActiveEnemies
  59+ 7F0A 2A F5 EF         ld   hl, (room_ptr)
  60+ 7F0D 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7F10 19               add  hl, de
  62+ 7F11
  63+ 7F11 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7F13              .load_h_loop:
  65+ 7F13 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7F14 FE FF            cp   $FF
  67+ 7F16 CA 99 7F         jp   z, .done_h_guardians      ; $FF = terminatore
  68+ 7F19 B7               or   a
  69+ 7F1A 28 75            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7F1C
  71+ 7F1C                  ; Slot attivo
  72+ 7F1C DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7F20 CB 7F            bit  7, a
  74+ 7F22 28 04            jr   z, .h_speed_normal
  75+ 7F24 DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)
  76+ 7F28              .h_speed_normal:
  77+ 7F28 E6 7F            and  $7F                       ; Rimuove bit 7 (velocità) per isolare l'attributo colore ed evitare il FLASH hardware
  78+ 7F2A DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7F2D
  80+ 7F2D 23               inc  hl
  81+ 7F2E 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7F2F 23               inc  hl
  83+ 7F30 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7F31
  85+ 7F31                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7F31 E5               push hl
  87+ 7F32 C5               push bc
  88+ 7F33 67               ld   h, a
  89+ 7F34 69               ld   l, c
  90+ 7F35 01 00 A4         ld   bc, -23552
  91+ 7F38 09               add  hl, bc                    ; HL = AttrOffset
  92+ 7F39
  93+ 7F39                  ; Col = Offset & 31 -> StartX = Col * 8
  94+ 7F39 7D               ld   a, l
  95+ 7F3A E6 1F            and  31
  96+ 7F3C 87               add  a, a
  96+ 7F3D 87             add a, a
  96+ 7F3E 87             add a, a
  97+ 7F3F DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7F42
  99+ 7F42                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7F42 CB 3C            srl  h
 100+ 7F44 CB 1D          rr l
 101+ 7F46 CB 3C            srl  h
 101+ 7F48 CB 1D          rr l
 102+ 7F4A CB 3C            srl  h
 102+ 7F4C CB 1D          rr l
 103+ 7F4E CB 3C            srl  h
 103+ 7F50 CB 1D          rr l
 104+ 7F52 CB 3C            srl  h
 104+ 7F54 CB 1D          rr l
 105+ 7F56 7D               ld   a, l
 106+ 7F57 87               add  a, a
 106+ 7F58 87             add a, a
 106+ 7F59 87             add a, a
 107+ 7F5A DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 108+ 7F5D C1               pop  bc
 109+ 7F5E E1               pop  hl
 110+ 7F5F
 111+ 7F5F 23               inc  hl
 112+ 7F60 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 113+ 7F61
 114+ 7F61 23               inc  hl
 115+ 7F62 7E               ld   a, (hl)                   ; Byte 4: Initial Frame (0..7, in Manic Miner: 0=Destra, 7=Sinistra)
 116+ 7F63 E6 07            and  7
 117+ 7F65 DD 77 07         ld   (ix+7), a                 ; Frame iniziale (0..7)
 118+ 7F68 FE 04            cp   4
 119+ 7F6A 30 04            jr   nc, .h_dir_left
 120+ 7F6C 3E 02            ld   a, 2                      ; 2 = Destra (Frame 0..3)
 121+ 7F6E 18 02            jr   .set_h_dir
 122+ 7F70              .h_dir_left:
 123+ 7F70 3E 01            ld   a, 1                      ; 1 = Sinistra (Frame 4..7)
 124+ 7F72              .set_h_dir:
 125+ 7F72 DD 77 06         ld   (ix+6), a                 ; Direction
 126+ 7F75
 127+ 7F75 23               inc  hl
 128+ 7F76 7E               ld   a, (hl)                   ; Byte 5: Min limit
 129+ 7F77 E6 1F            and  31
 130+ 7F79 87               add  a, a
 130+ 7F7A 87             add a, a
 130+ 7F7B 87             add a, a
 131+ 7F7C DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel, multiplo di 8)
 132+ 7F7F
 133+ 7F7F 23               inc  hl
 134+ 7F80 7E               ld   a, (hl)                   ; Byte 6: Max limit
 135+ 7F81 E6 1F            and  31
 136+ 7F83 87               add  a, a
 136+ 7F84 87             add a, a
 136+ 7F85 87             add a, a
 137+ 7F86 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel, multiplo di 8)
 138+ 7F89
 139+ 7F89 23               inc  hl                        ; Prossimo guardiano
 140+ 7F8A 11 0B 00         ld   de, 11
 141+ 7F8D DD 19            add  ix, de
 142+ 7F8F 18 04            jr   .next_h_loop
 143+ 7F91
 144+ 7F91              .skip_h_guardian:
 145+ 7F91 11 07 00         ld   de, 7
 146+ 7F94 19               add  hl, de                    ; Salta 7 byte dei dati stanza
 147+ 7F95
 148+ 7F95              .next_h_loop:
 149+ 7F95 05               dec  b
 150+ 7F96 C2 13 7F         jp   nz, .load_h_loop
 151+ 7F99
 152+ 7F99              .done_h_guardians:
 153+ 7F99                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 154+ 7F99 2A F5 EF         ld   hl, (room_ptr)
 155+ 7F9C 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 156+ 7F9F 19               add  hl, de
 157+ 7FA0
 158+ 7FA0 7E               ld   a, (hl)
 159+ 7FA1 FE FF            cp   $FF
 160+ 7FA3 28 0A            jr   z, .no_v_guardians
 161+ 7FA5 B7               or   a
 162+ 7FA6 28 07            jr   z, .no_v_guardians
 163+ 7FA8 3E 01            ld   a, 1
 164+ 7FAA 32 7F F0         ld   (room_has_v_guardians), a
 165+ 7FAD 18 06            jr   .has_v_guardians
 166+ 7FAF
 167+ 7FAF              .no_v_guardians:
 168+ 7FAF AF               xor  a
 169+ 7FB0 32 7F F0         ld   (room_has_v_guardians), a
 170+ 7FB3 18 4B            jr   .done_v_guardians
 171+ 7FB5
 172+ 7FB5              .has_v_guardians:
 173+ 7FB5 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 174+ 7FB7              .load_v_loop:
 175+ 7FB7 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 176+ 7FB8 FE FF            cp   $FF
 177+ 7FBA 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 178+ 7FBC B7               or   a
 179+ 7FBD 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 180+ 7FBF
 181+ 7FBF                  ; Slot attivo per guardiano verticale
 182+ 7FBF DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 183+ 7FC3 E6 7F            and  $7F                       ; Rimuove bit 7
 184+ 7FC5 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 185+ 7FC8
 186+ 7FC8 23               inc  hl
 187+ 7FC9 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 188+ 7FCA E6 03            and  3                         ; Frame 0..3 nella prima metà dei dati grafici
 189+ 7FCC DD 77 01         ld   (ix+1), a                 ; Frame index (0..3)
 190+ 7FCF
 191+ 7FCF 23               inc  hl
 192+ 7FD0 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 193+ 7FD1 DD 77 03         ld   (ix+3), a                 ; Current Y
 194+ 7FD4
 195+ 7FD4 23               inc  hl
 196+ 7FD5 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 197+ 7FD6 E6 1F            and  31
 198+ 7FD8 87               add  a, a
 198+ 7FD9 87             add a, a
 198+ 7FDA 87             add a, a ; * 8 -> X pixel
 199+ 7FDB DD 77 02         ld   (ix+2), a                 ; Current X
 200+ 7FDE
 201+ 7FDE 23               inc  hl
 202+ 7FDF 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 203+ 7FE0 E6 03            and  3
 204+ 7FE2 20 02            jr   nz, .v_step_ok
 205+ 7FE4 3E 01            ld   a, 1
 206+ 7FE6              .v_step_ok:
 207+ 7FE6 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 208+ 7FE9 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 209+ 7FEB DD 77 06         ld   (ix+6), a
 210+ 7FEE
 211+ 7FEE 23               inc  hl
 212+ 7FEF 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 213+ 7FF0 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 214+ 7FF3
 215+ 7FF3 23               inc  hl
 216+ 7FF4 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 217+ 7FF5 DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 218+ 7FF8
 219+ 7FF8 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 220+ 7FF9 11 0B 00         ld   de, 11
 221+ 7FFC DD 19            add  ix, de
 222+ 7FFE 10 B7            djnz .load_v_loop
 223+ 8000
 224+ 8000              .done_v_guardians:
 225+ 8000                  ; 4. Controlla se la stanza corrente è Eugene's Lair (Caverna 04)
 226+ 8000 2A F5 EF         ld   hl, (room_ptr)
 227+ 8003 11 32 9E         ld   de, EugeneLairLayout
 228+ 8006 B7               or   a
 229+ 8007 ED 52            sbc  hl, de
 230+ 8009 20 30            jr   nz, .not_eugene
 231+ 800B
 232+ 800B                  ; Inizializza Eugene nello Slot 4 (offset 44) di ActiveEnemies
 233+ 800B DD 21 B3 7E      ld   ix, ActiveEnemies + 44
 234+ 800F DD 36 00 E0      ld   (ix+0), $E0               ; Active = 1, Vertical = 1, Eugene = 1
 235+ 8013 DD 36 01 00      ld   (ix+1), 0                 ; Frame = 0
 236+ 8017 DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 237+ 801B DD 36 03 58      ld   (ix+3), 88                ; Initial Y = 88
 238+ 801F DD 36 04 00      ld   (ix+4), 0                 ; Min Limit Y = 0
 239+ 8023 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88
 240+ 8027 DD 36 06 01      ld   (ix+6), 1                 ; Direction = 1 (Up)
 241+ 802B DD 36 07 01      ld   (ix+7), 1                 ; Speed = 1
 242+ 802F DD 36 08 FF      ld   (ix+8), $FF               ; Old X = $FF
 243+ 8033 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y = $FF
 244+ 8037 DD 36 0A 17      ld   (ix+10), 23               ; Paper 2 (Red), Ink 7 (White) -> 23
 245+ 803B
 246+ 803B              .not_eugene:
 247+ 803B                  ; 5. Controlla se la stanza corrente ha il boss Kong Beast (Caverna 07 o Caverna 11)
 248+ 803B 2A F5 EF         ld   hl, (room_ptr)
 249+ 803E 11 32 AA         ld   de, MinerWillymeetstheKongBeastLayout
 250+ 8041 B7               or   a
 251+ 8042 ED 52            sbc  hl, de
 252+ 8044 28 0F            jr   z, .is_kong_room1
 253+ 8046
 254+ 8046 2A F5 EF         ld   hl, (room_ptr)
 255+ 8049 11 32 BA         ld   de, ReturnoftheAlienKongBeastLayout
 256+ 804C B7               or   a
 257+ 804D ED 52            sbc  hl, de
 258+ 804F 20 43            jr   nz, .not_kong
 259+ 8051
 260+ 8051              .is_kong_room2:
 261+ 8051 3E 46            ld   a, 70                     ; Kong colore in Return of the Alien Kong: Bright 1, Paper 0, Ink 6 (Giallo) -> 70
 262+ 8053 18 02            jr   .init_kong_slot
 263+ 8055
 264+ 8055              .is_kong_room1:
 265+ 8055 3E 44            ld   a, 68                     ; Kong colore in Miner Willy meets the Kong Beast: Bright 1, Paper 0, Ink 4 (Verde) -> 68
 266+ 8057
 267+ 8057              .init_kong_slot:
 268+ 8057 F5               push af
 269+ 8058 3E 01            ld   a, 1
 270+ 805A 32 7F F0         ld   (room_has_v_guardians), a ; Segnala che i nemici orizzontali usano la seconda metà (frame 4..7)
 271+ 805D
 272+ 805D                  ; Inizializza Kong Beast nello Slot 3 (offset 33) di ActiveEnemies
 273+ 805D DD 21 A8 7E      ld   ix, ActiveEnemies + 33
 274+ 8061 DD 36 00 A0      ld   (ix+0), $A0               ; Active = 1, Kong = 1 (Bit 7 + Bit 5)
 275+ 8065 DD 36 01 00      ld   (ix+1), 0                 ; Frame iniziale = 0
 276+ 8069 DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 277+ 806D DD 36 03 00      ld   (ix+3), 0                 ; Y = 0 (Ledge in alto)
 278+ 8071 DD 36 04 00      ld   (ix+4), 0                 ; Min Y = 0
 279+ 8075 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88
 280+ 8079 DD 36 06 00      ld   (ix+6), 0                 ; Kong status = 0 (on ledge)
 281+ 807D DD 36 07 00      ld   (ix+7), 0
 282+ 8081 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
 283+ 8085 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
 284+ 8089 F1               pop  af
 285+ 808A DD 77 0A         ld   (ix+10), a                ; Colore Kong
 286+ 808D
 287+ 808D                  ; Resetta lo stato degli interruttori di Kong
 288+ 808D AF               xor  a
 289+ 808E 32 83 F0         ld   (kong_switch_left), a
 290+ 8091 32 84 F0         ld   (kong_switch_right), a
 291+ 8094
 292+ 8094              .not_kong:
 293+ 8094 DD E1            pop  ix
 294+ 8096 C1               pop  bc
 295+ 8097 D1               pop  de
 296+ 8098 E1               pop  hl
 297+ 8099 C9               ret
 298+ 809A
 299+ 809A              ; -------------------------------------------------------------------
 300+ 809A              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 301+ 809A              ; -------------------------------------------------------------------
 302+ 809A              CheckEnemyWillyOverlap:
 303+ 809A 3A 7B F0         ld   a, (player_drawn_pos+1)
 304+ 809D FE FF            cp   $FF
 305+ 809F C8               ret  z                  ; Se Willy non è disegnato, esci
 306+ 80A0
 307+ 80A0                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 308+ 80A0 3A 7A F0         ld   a, (player_drawn_pos)
 309+ 80A3 E6 F8            and  $F8
 310+ 80A5 5F               ld   e, a               ; E = WillyX & $F8
 311+ 80A6 79               ld   a, c
 312+ 80A7 E6 F8            and  $F8                ; A = EnemyX & $F8
 313+ 80A9 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 314+ 80AA C6 10            add  a, 16
 315+ 80AC FE 19            cp   25
 316+ 80AE D0               ret  nc                 ; Fuori portata X
 317+ 80AF
 318+ 80AF                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 319+ 80AF 3A 7B F0         ld   a, (player_drawn_pos+1) ; A = WillyY
 320+ 80B2 90               sub  b                  ; A = WillyY - EnemyY
 321+ 80B3 C6 0F            add  a, 15
 322+ 80B5 FE 1F            cp   31
 323+ 80B7 D0               ret  nc                 ; Fuori portata Y
 324+ 80B8
 325+ 80B8                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 326+ 80B8 3E 01            ld   a, 1
 327+ 80BA 32 81 F0         ld   (willy_needs_redraw), a
 328+ 80BD C9               ret
 329+ 80BE
 330+ 80BE              ; -------------------------------------------------------------------
 331+ 80BE              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 332+ 80BE              ; -------------------------------------------------------------------
 333+ 80BE              Enemy_EraseRoom:
 334+ 80BE              Enemy_DrawRoom:
 335+ 80BE              Enemy_RenderRoom:
 336+ 80BE E5               push hl
 337+ 80BF D5               push de
 338+ 80C0 C5               push bc
 339+ 80C1 DD E5            push ix
 340+ 80C3
 341+ 80C3                  ; ---------------------------------------------------------------
 342+ 80C3                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 343+ 80C3                  ; ---------------------------------------------------------------
 344+ 80C3 DD 21 87 7E      ld   ix, ActiveEnemies
 345+ 80C7 06 08            ld   b, 8              ; 8 slot
 346+ 80C9              .erase_loop:
 347+ 80C9                  ; Se Old X == $FF (non ancora disegnato o già cancellato), non c'è nulla da cancellare
 348+ 80C9 DD 7E 08         ld   a, (ix+8)         ; Old X
 349+ 80CC FE FF            cp   $FF
 350+ 80CE 28 63            jr   z, .next_erase
 351+ 80D0
 352+ 80D0                  ; Controlla se lo slot è diventato inattivo (es. Kong caduto e morto)
 353+ 80D0 DD 7E 00         ld   a, (ix+0)         ; Flags
 354+ 80D3 E6 80            and  $80               ; Active?
 355+ 80D5 28 35            jr   z, .do_erase_inactive_slot
 356+ 80D7
 357+ 80D7                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 358+ 80D7 DD 7E 08         ld   a, (ix+8)         ; Old X

1069+ 7840              ; -------------------------------------------------------------------
1070+ 7840              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1071+ 7840              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1072+ 7840              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1073+ 7840              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1074+ 7840              ; -------------------------------------------------------------------
1075+ 7840              UnpackRoomLayout:
1076+ 7840 E5               push hl
1077+ 7841 D5               push de
1078+ 7842 C5               push bc
1079+ 7843 DD E5            push ix
1080+ 7845
1081+ 7845 DD 2A 88 E5      ld   ix, (room_ptr)
1082+ 7849 11 20 02         ld   de, OFFSET_TILES
1083+ 784C DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1084+ 784E
1085+ 784E 2A 88 E5         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1086+ 7851 11 2D E3         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1087+ 7854 01 00 02         ld   bc, 512               ; 512 celle
1088+ 7857
1089+ 7857              .byte_loop:
1090+ 7857 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1091+ 7858 23               inc  hl
1092+ 7859
1093+ 7859                  ; Confronta con le 8 definizioni di tile:
1094+ 7859 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1095+ 785C 28 23            jr   z, .is_bg
1096+ 785E DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1097+ 7861 28 29            jr   z, .is_wall
1098+ 7863 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1099+ 7866 28 1C            jr   z, .is_floor
1100+ 7868 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1101+ 786B 28 1B            jr   z, .is_crumbling
1102+ 786D DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1103+ 7870 28 1E            jr   z, .is_conveyor
1104+ 7872 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1105+ 7875 28 1D            jr   z, .is_nasty1
1106+ 7877 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1107+ 787A 28 1C            jr   z, .is_nasty2
1108+ 787C DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1109+ 787F 28 1B            jr   z, .is_extra
1110+ 7881
1111+ 7881              .is_bg:
1112+ 7881                  ; Default: Tile 0 (Background)
1113+ 7881 AF               xor  a
1114+ 7882 18 1A            jr   .store_cell
1115+ 7884
1116+ 7884              .is_floor:
1117+ 7884 3E 01            ld   a, 1
1118+ 7886 18 16            jr   .store_cell
1119+ 7888              .is_crumbling:
1120+ 7888 3E 02            ld   a, 2
1121+ 788A 18 12            jr   .store_cell
1122+ 788C              .is_wall:
1123+ 788C 3E 03            ld   a, 3
1124+ 788E 18 0E            jr   .store_cell
1125+ 7890              .is_conveyor:
1126+ 7890 3E 04            ld   a, 4
1127+ 7892 18 0A            jr   .store_cell
1128+ 7894              .is_nasty1:
1129+ 7894 3E 05            ld   a, 5
1130+ 7896 18 06            jr   .store_cell
1131+ 7898              .is_nasty2:
1132+ 7898 3E 06            ld   a, 6
1133+ 789A 18 02            jr   .store_cell
1134+ 789C              .is_extra:
1135+ 789C 3E 07            ld   a, 7
1136+ 789E
1137+ 789E              .store_cell:
1138+ 789E 12               ld   (de), a
1139+ 789F 13               inc  de
1140+ 78A0 0B               dec  bc
1141+ 78A1 78               ld   a, b
1142+ 78A2 B1               or   c
1143+ 78A3 20 B2            jr   nz, .byte_loop
1144+ 78A5
1145+ 78A5 DD E1            pop  ix
1146+ 78A7 C1               pop  bc
1147+ 78A8 D1               pop  de
1148+ 78A9 E1               pop  hl
1149+ 78AA C9               ret
1150+ 78AB
1151+ 78AB              ; -------------------------------------------------------------------
1152+ 78AB              ; Legge il tipo di cella dal buffer decompresso in RAM
1153+ 78AB              ; Input: A = Row (0..15), C = Col (0..31)
1154+ 78AB              ; Output: A = tipo di cella (0..3)
1155+ 78AB              ; Preserva tutti gli altri registri.
1156+ 78AB              ; -------------------------------------------------------------------
1157+ 78AB              GetCellFromUnpacked:
1158+ 78AB E5               push hl
1159+ 78AC D5               push de
1160+ 78AD
1161+ 78AD 6F               ld   l, a
1162+ 78AE 26 00            ld   h, 0
1163+ 78B0 29               add  hl, hl
1164+ 78B1 29               add  hl, hl
1165+ 78B2 29               add  hl, hl
1166+ 78B3 29               add  hl, hl
1167+ 78B4 29               add  hl, hl            ; HL = Row * 32
1168+ 78B5 59               ld   e, c
1169+ 78B6 16 00            ld   d, 0
1170+ 78B8 19               add  hl, de            ; HL = Row * 32 + Col
1171+ 78B9 11 2D E3         ld   de, unpacked_layout
1172+ 78BC 19               add  hl, de
1173+ 78BD 7E               ld   a, (hl)           ; A = cell type
1174+ 78BE
1175+ 78BE D1               pop  de
1176+ 78BF E1               pop  hl
1177+ 78C0 C9               ret

 428  8578 ED 78            in   a, (c)
 429  857A CB 67            bit  4, a
 430  857C 28 2A            jr   z, .continue_chosen
 431  857E
 432  857E                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 433  857E 01 FE 7F         ld   bc, $7ffe
 434  8581 ED 78            in   a, (c)
 435  8583 CB 5F            bit  3, a
 436  8585 28 0B            jr   z, .quit_chosen
 437  8587
 438  8587                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 439  8587 01 FE BF         ld   bc, $bffe
 440  858A ED 78            in   a, (c)
 441  858C CB 47            bit  0, a
 442  858E 28 02            jr   z, .quit_chosen
 443  8590
 444  8590 18 C9            jr   .wait_choice_loop
 445  8592
 446  8592              .quit_chosen:
 447  8592                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 448  8592              .wait_quit_release:
 449  8592 76               halt
 450  8593 01 FE 7F         ld   bc, $7ffe
 451  8596 ED 78            in   a, (c)
 452  8598 CB 5F            bit  3, a
 453  859A 28 F6            jr   z, .wait_quit_release
 454  859C 01 FE BF         ld   bc, $bffe
 455  859F ED 78            in   a, (c)
 456  85A1 CB 47            bit  0, a
 457  85A3 28 ED            jr   z, .wait_quit_release
 458  85A5
 459  85A5                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 460  85A5 C3 EB 84         jp   ShowTitleScreen
 461  85A8
 462  85A8              .continue_chosen:
 463  85A8                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 464  85A8              .wait_continue_release:
 465  85A8 76               halt
 466  85A9 01 FE DF         ld   bc, $dffe
 467  85AC ED 78            in   a, (c)
 468  85AE CB 67            bit  4, a

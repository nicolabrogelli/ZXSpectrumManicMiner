  71+ 8329 ~            ; -------------------------------------------------------------------
  72+ 8329 ~            ; Audio_UpdateMusic
  73+ 8329 ~            ;
  74+ 8329 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8329 ~            ; Viene chiamata a ogni frame.
  76+ 8329 ~            ; -------------------------------------------------------------------
  77+ 8329 ~            Audio_UpdateMusic:
  78+ 8329 ~                push af
  79+ 8329 ~                push bc
  80+ 8329 ~                push de
  81+ 8329 ~                push hl
  82+ 8329 ~
  83+ 8329 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8329 ~                ld   a, (Audio_jump_sound_note)
  85+ 8329 ~                cp   18
  86+ 8329 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8329 ~
  88+ 8329 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8329 ~                ld   a, (Audio_music_frame_counter)
  90+ 8329 ~                dec  a
  91+ 8329 ~                ld   (Audio_music_frame_counter), a
  92+ 8329 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8329 ~
  94+ 8329 ~                ; Altrimenti carica la nota successiva
  95+ 8329 ~                ld   a, (Audio_music_note_idx)
  96+ 8329 ~                inc  a
  97+ 8329 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8329 ~                jr   c, .no_wrap
  99+ 8329 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8329 ~            .no_wrap:
 101+ 8329 ~                ld   (Audio_music_note_idx), a
 102+ 8329 ~
 103+ 8329 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8329 ~                ld   e, a
 105+ 8329 ~                ld   d, 0
 106+ 8329 ~                ld   hl, Audio_MusicSheet
 107+ 8329 ~                add  hl, de
 108+ 8329 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8329 ~
 110+ 8329 ~                ; Leggi durata (secondo byte)
 111+ 8329 ~                inc  hl
 112+ 8329 ~                ld   a, (hl)
 113+ 8329 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8329 ~                jr   nz, .dur_ok
 115+ 8329 ~                ld   a, 1
 116+ 8329 ~            .dur_ok:
 117+ 8329 ~                ld   (Audio_music_frame_counter), a
 118+ 8329 ~
 119+ 8329 ~            .play_current_note:
 120+ 8329 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8329 ~                ld   a, (Audio_music_note_idx)
 122+ 8329 ~                ld   e, a
 123+ 8329 ~                ld   d, 0
 124+ 8329 ~                ld   hl, Audio_MusicSheet
 125+ 8329 ~                add  hl, de
 126+ 8329 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8329 ~                ld   a, (hl)                  ; A = delay
 128+ 8329 ~                or   a
 129+ 8329 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8329 ~
 131+ 8329 ~                ; Suona la nota: 2 cicli
 132+ 8329 ~                ld   d, a                     ; D = delay
 133+ 8329 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8329 ~            .note_loop:
 135+ 8329 ~                ; Speaker ON
 136+ 8329 ~                ld   a, (room_border_color)
 137+ 8329 ~                or   $10
 138+ 8329 ~                out  ($fe), a
 139+ 8329 ~                ld   c, d
 140+ 8329 ~            .d1:
 141+ 8329 ~                push af
 142+ 8329 ~                pop  af
 143+ 8329 ~                dec  c
 144+ 8329 ~                jr   nz, .d1
 145+ 8329 ~
 146+ 8329 ~                ; Speaker OFF
 147+ 8329 ~                ld   a, (room_border_color)
 148+ 8329 ~                and  $ef
 149+ 8329 ~                out  ($fe), a
 150+ 8329 ~                ld   c, d
 151+ 8329 ~            .d2:
 152+ 8329 ~                push af
 153+ 8329 ~                pop  af
 154+ 8329 ~                dec  c
 155+ 8329 ~                jr   nz, .d2
 156+ 8329 ~
 157+ 8329 ~                djnz .note_loop
 158+ 8329 ~
 159+ 8329 ~            .done:
 160+ 8329 ~                pop  hl
 161+ 8329 ~                pop  de
 162+ 8329 ~                pop  bc
 163+ 8329 ~                pop  af
 164+ 8329 ~                ret
 165+ 8329 ~
 166+ 8329 ~            Audio_MusicSheet:
 167+ 8329 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8329 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8329 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8329 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8329 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8329 ~                db 90, 10, 107, 20, 68, 65
 173+ 8329                  ELSE
 174+ 8329              Audio_UpdateMusic:
 175+ 8329 C9               ret

 304+ 85C4              DrawItemGraphic:
 305+ 85C4 C5               push bc
 306+ 85C5 D5               push de
 307+ 85C6 E5               push hl
 308+ 85C7
 309+ 85C7                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 310+ 85C7 78               ld   a, b
 311+ 85C8 E6 18            and  $18
 312+ 85CA C6 40            add  a, $40
 313+ 85CC 57               ld   d, a                      ; Byte alto indirizzo video
 314+ 85CD
 315+ 85CD 78               ld   a, b
 316+ 85CE E6 07            and  7
 317+ 85D0 87               add  a, a                      ; *2
 318+ 85D1 87               add  a, a                      ; *4
 319+ 85D2 87               add  a, a                      ; *8
 320+ 85D3 87               add  a, a                      ; *16
 321+ 85D4 87               add  a, a                      ; *32
 322+ 85D5 81               add  a, c                      ; + Col
 323+ 85D6 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 85D7
 325+ 85D7 C5               push bc
 326+ 85D8 06 08            ld   b, 8                      ; 8 scanline
 327+ 85DA              .line_loop:
 328+ 85DA 7E               ld   a, (hl)
 329+ 85DB 12               ld   (de), a

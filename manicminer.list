  52+ 7978 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 797C DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7980 DD 19            add  ix, de
  55+ 7982 10 F4            djnz .init_old_pos
  56+ 7984
  57+ 7984                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7984 DD 21 05 79      ld   ix, ActiveEnemies
  59+ 7988 2A 79 91         ld   hl, (room_ptr)
  60+ 798B 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 798E 19               add  hl, de
  62+ 798F
  63+ 798F 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7991              .load_h_loop:
  65+ 7991 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7992 FE FF            cp   $FF
  67+ 7994 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore

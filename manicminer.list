 503+ 7C02              ; CheckCollision
 504+ 7C02              ;
 505+ 7C02              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 506+ 7C02              ; Output:
 507+ 7C02              ;   Carry Set = Collisione con guardiano
 508+ 7C02              ;   Carry Clear = Nessuna collisione
 509+ 7C02              ; -------------------------------------------------------------------
 510+ 7C02              CheckCollision:
 511+ 7C02 DD E5            push ix
 512+ 7C04 C5               push bc
 513+ 7C05 D5               push de
 514+ 7C06 E5               push hl
 515+ 7C07
 516+ 7C07                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 517+ 7C07 3A B1 91         ld   a, (willy_safety_timer)
 518+ 7C0A B7               or   a
 519+ 7C0B 20 3B            jr   nz, .no_collision_found
 520+ 7C0D
 521+ 7C0D DD 21 0F 79      ld   ix, ActiveEnemies
 522+ 7C11 06 08            ld   b, 8                      ; 8 slot
 523+ 7C13
 524+ 7C13              .collision_loop:
 525+ 7C13 DD 7E 00         ld   a, (ix+0)
 526+ 7C16 E6 80            and  $80                       ; Active?
 527+ 7C18 28 26            jr   z, .next_enemy
 528+ 7C1A
 529+ 7C1A C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 530+ 7C1B
 531+ 7C1B                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 532+ 7C1B ED 4B A7 8D      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 533+ 7C1F DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 534+ 7C22
 535+ 7C22                  ; Calcola differenza X
 536+ 7C22 91               sub  c                         ; A = EnemyX - WillyX
 537+ 7C23 30 02            jr   nc, .x_diff_pos
 538+ 7C25 ED 44            neg                            ; A = |EnemyX - WillyX|
 539+ 7C27              .x_diff_pos:
 540+ 7C27 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 541+ 7C29 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 542+ 7C2B
 543+ 7C2B                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 544+ 7C2B DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 545+ 7C2E 90               sub  b                         ; A = EnemyY - WillyY
 546+ 7C2F 30 02            jr   nc, .y_diff_pos
 547+ 7C31 ED 44            neg                            ; A = |EnemyY - WillyY|
 548+ 7C33              .y_diff_pos:
 549+ 7C33 FE 0E            cp   14                        ; Sovrapposizione verticale?
 550+ 7C35 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 551+ 7C37
 552+ 7C37                  ; Collisione trovata!
 553+ 7C37 C1               pop  bc                        ; Ripristina stack
 554+ 7C38 E1               pop  hl
 555+ 7C39 D1               pop  de
 556+ 7C3A C1               pop  bc
 557+ 7C3B DD E1            pop  ix
 558+ 7C3D 37               scf
 559+ 7C3E C9               ret
 560+ 7C3F
 561+ 7C3F              .no_x_hit:
 562+ 7C3F C1               pop  bc                        ; Ripristina B (contatore ciclo)
 563+ 7C40

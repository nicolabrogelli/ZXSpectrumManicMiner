2234+ 6941 C6 30            add  a, '0'
2235+ 6943 77               ld   (hl), a
2236+ 6944 23               inc  hl
2237+ 6945
2238+ 6945                  ; Cifra 3 (centinaia)
2239+ 6945 DD 7E 01         ld   a, (ix+1)
2240+ 6948 E6 0F            and  $0f
2241+ 694A C6 30            add  a, '0'
2242+ 694C 77               ld   (hl), a
2243+ 694D 23               inc  hl
2244+ 694E
2245+ 694E                  ; Cifra 4 (decine)
2246+ 694E DD 7E 00         ld   a, (ix+0)
2247+ 6951 0F               rrca
2248+ 6952 0F               rrca
2249+ 6953 0F               rrca
2250+ 6954 0F               rrca
2251+ 6955 E6 0F            and  $0f
2252+ 6957 C6 30            add  a, '0'
2253+ 6959 77               ld   (hl), a

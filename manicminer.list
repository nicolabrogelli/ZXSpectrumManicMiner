 323  88B4 77               ld   (hl), a
 324  88B5 23               inc  hl
 325  88B6 10 FC            djnz .color_title_loop
 326  88B8
 327  88B8                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 328  88B8 3E BF            ld   a, $bf
 329  88BA DB FE            in   a, ($fe)
 330  88BC 1F               rra
 331  88BD 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 332  88BF

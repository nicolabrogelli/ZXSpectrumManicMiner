1737+ 7AFB                  ; Punto 2: Top-Right (X + 7, Y)
1738+ 7AFB 79               ld   a, c
1739+ 7AFC C6 07            add  a, 7
1740+ 7AFE 4F               ld   c, a
1741+ 7AFF CD BF 7A         call CheckNastyCell
1742+ 7B02 38 2F            jr   c, .collision
1743+ 7B04
1744+ 7B04                  ; Punto 3: Mid-Left (X, Y + 7)
1745+ 7B04 ED 4B 69 AA      ld   bc, (PlayerPos)
1746+ 7B08 78               ld   a, b
1747+ 7B09 C6 07            add  a, 7
1748+ 7B0B 47               ld   b, a
1749+ 7B0C CD BF 7A         call CheckNastyCell
1750+ 7B0F 38 22            jr   c, .collision
1751+ 7B11

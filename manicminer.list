1070+ 6248                  ; 1. Calcola indirizzo bitmap nel font_buffer (font_buffer + A * 8)
1071+ 6248 6F               ld   l, a
1072+ 6249 26 00            ld   h, 0
1073+ 624B 29               add  hl, hl                ; *2
1074+ 624C 29               add  hl, hl                ; *4
1075+ 624D 29               add  hl, hl                ; *8
1076+ 624E 01 69 A4         ld   bc, font_buffer
1077+ 6251 09               add  hl, bc
1078+ 6252 E5               push hl
1079+ 6253 DD E1            pop  ix                    ; IX = font bitmap (8 byte)
1080+ 6255
1081+ 6255                  ; 2. Calcola indirizzo VRAM scanline 0 per (Row D, Col E)
1082+ 6255                  ; HighByte = $40 + (D & $18)
1083+ 6255 7A               ld   a, d
1084+ 6256 E6 18            and  $18
1085+ 6258 C6 40            add  a, $40
1086+ 625A 67               ld   h, a
1087+ 625B
1088+ 625B                  ; LowByte = ((D & 7) * 32) + E
1089+ 625B 7A               ld   a, d
1090+ 625C E6 07            and  7
1091+ 625E 87               add  a, a                  ; *2
1092+ 625F 87               add  a, a                  ; *4
1093+ 6260 87               add  a, a                  ; *8
1094+ 6261 87               add  a, a                  ; *16
1095+ 6262 87               add  a, a                  ; *32
1096+ 6263 83               add  a, e                  ; + Col E
1097+ 6264 6F               ld   l, a                  ; HL = VRAM address scanline 0
1098+ 6265

  71+ 832B ~            ; -------------------------------------------------------------------
  72+ 832B ~            ; Audio_UpdateMusic
  73+ 832B ~            ;
  74+ 832B ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 832B ~            ; Viene chiamata a ogni frame.
  76+ 832B ~            ; -------------------------------------------------------------------
  77+ 832B ~            Audio_UpdateMusic:
  78+ 832B ~                push af
  79+ 832B ~                push bc
  80+ 832B ~                push de
  81+ 832B ~                push hl
  82+ 832B ~
  83+ 832B ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 832B ~                ld   a, (Audio_jump_sound_note)
  85+ 832B ~                cp   18
  86+ 832B ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 832B ~
  88+ 832B ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 832B ~                ld   a, (Audio_music_frame_counter)
  90+ 832B ~                dec  a
  91+ 832B ~                ld   (Audio_music_frame_counter), a
  92+ 832B ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 832B ~
  94+ 832B ~                ; Altrimenti carica la nota successiva
  95+ 832B ~                ld   a, (Audio_music_note_idx)
  96+ 832B ~                inc  a
  97+ 832B ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 832B ~                jr   c, .no_wrap
  99+ 832B ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 832B ~            .no_wrap:
 101+ 832B ~                ld   (Audio_music_note_idx), a
 102+ 832B ~
 103+ 832B ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 832B ~                ld   e, a
 105+ 832B ~                ld   d, 0
 106+ 832B ~                ld   hl, Audio_MusicSheet
 107+ 832B ~                add  hl, de
 108+ 832B ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 832B ~
 110+ 832B ~                ; Leggi durata (secondo byte)
 111+ 832B ~                inc  hl
 112+ 832B ~                ld   a, (hl)
 113+ 832B ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 832B ~                jr   nz, .dur_ok
 115+ 832B ~                ld   a, 1
 116+ 832B ~            .dur_ok:
 117+ 832B ~                ld   (Audio_music_frame_counter), a
 118+ 832B ~
 119+ 832B ~            .play_current_note:
 120+ 832B ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 832B ~                ld   a, (Audio_music_note_idx)
 122+ 832B ~                ld   e, a
 123+ 832B ~                ld   d, 0
 124+ 832B ~                ld   hl, Audio_MusicSheet
 125+ 832B ~                add  hl, de
 126+ 832B ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 832B ~                ld   a, (hl)                  ; A = delay
 128+ 832B ~                or   a
 129+ 832B ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 832B ~
 131+ 832B ~                ; Suona la nota: 2 cicli
 132+ 832B ~                ld   d, a                     ; D = delay
 133+ 832B ~                ld   b, 2                     ; 2 cicli per frame
 134+ 832B ~            .note_loop:
 135+ 832B ~                ; Speaker ON
 136+ 832B ~                ld   a, (room_border_color)
 137+ 832B ~                or   $10
 138+ 832B ~                out  ($fe), a
 139+ 832B ~                ld   c, d
 140+ 832B ~            .d1:
 141+ 832B ~                push af
 142+ 832B ~                pop  af
 143+ 832B ~                dec  c
 144+ 832B ~                jr   nz, .d1
 145+ 832B ~
 146+ 832B ~                ; Speaker OFF
 147+ 832B ~                ld   a, (room_border_color)
 148+ 832B ~                and  $ef
 149+ 832B ~                out  ($fe), a
 150+ 832B ~                ld   c, d
 151+ 832B ~            .d2:
 152+ 832B ~                push af
 153+ 832B ~                pop  af
 154+ 832B ~                dec  c
 155+ 832B ~                jr   nz, .d2
 156+ 832B ~
 157+ 832B ~                djnz .note_loop
 158+ 832B ~
 159+ 832B ~            .done:
 160+ 832B ~                pop  hl
 161+ 832B ~                pop  de
 162+ 832B ~                pop  bc
 163+ 832B ~                pop  af
 164+ 832B ~                ret
 165+ 832B ~
 166+ 832B ~            Audio_MusicSheet:
 167+ 832B ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 832B ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 832B ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 832B ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 832B ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 832B ~                db 90, 10, 107, 20, 68, 65
 173+ 832B                  ELSE
 174+ 832B              Audio_UpdateMusic:
 175+ 832B C9               ret
 176+ 832C                  ENDIF

1680+ 7ACD 30 1B            jr   nc, .not_nasty
1681+ 7ACF
1682+ 7ACF                  ; 2. Calcola riga di layout: r = Y / 8
1683+ 7ACF CB 3F            srl  a
1684+ 7AD1 CB 3F            srl  a
1685+ 7AD3 CB 3F            srl  a                 ; A = r (0..15)
1686+ 7AD5
1687+ 7AD5                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1688+ 7AD5 5F               ld   e, a              ; E = r
1689+ 7AD6 79               ld   a, c
1690+ 7AD7 CB 3F            srl  a
1691+ 7AD9 CB 3F            srl  a
1692+ 7ADB CB 3F            srl  a                 ; A = c (0..31)
1693+ 7ADD 4F               ld   c, a              ; C = c
1694+ 7ADE 7B               ld   a, e              ; A = r
1695+ 7ADF
1696+ 7ADF CD 70 78         call GetCellFromUnpacked ; A = cell type

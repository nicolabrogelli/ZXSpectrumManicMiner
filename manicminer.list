2114+ 7CD6              ; Phys_UpdateAir
2115+ 7CD6              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2116+ 7CD6              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2117+ 7CD6              ; Output:
2118+ 7CD6              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2119+ 7CD6              ;   Carry Clear = Aria ancora disponibile
2120+ 7CD6              ; -------------------------------------------------------------------
2121+ 7CD6              Phys_UpdateAir:
2122+ 7CD6                  ; Incrementa il timer dei frame
2123+ 7CD6 3A 6D A4         ld   a, (air_timer)
2124+ 7CD9 3C               inc  a
2125+ 7CDA 32 6D A4         ld   (air_timer), a
2126+ 7CDD 21 6E A4         ld   hl, air_deplete_rate
2127+ 7CE0 BE               cp   (hl)
2128+ 7CE1 38 14            jr   c, .no_deplete
2129+ 7CE3
2130+ 7CE3                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2131+ 7CE3 AF               xor  a
2132+ 7CE4 32 6D A4         ld   (air_timer), a
2133+ 7CE7
2134+ 7CE7 3A 6C A4         ld   a, (air_pixels)
2135+ 7CEA B7               or   a
2136+ 7CEB 28 0C            jr   z, .air_finished
2137+ 7CED
2138+ 7CED 3D               dec  a
2139+ 7CEE 32 6C A4         ld   (air_pixels), a
2140+ 7CF1 CD 6C 6A         call Gfx_UpdateAirBar
2141+ 7CF4
2142+ 7CF4 B7               or   a
2143+ 7CF5 28 02            jr   z, .air_finished
2144+ 7CF7
2145+ 7CF7              .no_deplete:
2146+ 7CF7 B7               or   a                     ; Carry Clear = Ok
2147+ 7CF8 C9               ret
2148+ 7CF9
2149+ 7CF9              .air_finished:
2150+ 7CF9 37               scf                        ; Carry Set = Morte per esaurimento aria
2151+ 7CFA C9               ret

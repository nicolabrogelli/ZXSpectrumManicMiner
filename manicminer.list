 316+ 7F14              ; Enemy_DrawSingleSlot
 317+ 7F14              ;
 318+ 7F14              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7F14              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7F14              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7F14              ; -------------------------------------------------------------------
 322+ 7F14              Enemy_DrawSingleSlot:
 323+ 7F14 C5               push bc
 324+ 7F15 D5               push de
 325+ 7F16 E5               push hl
 326+ 7F17 DD E5            push ix
 327+ 7F19
 328+ 7F19                  ; 1. Determina il frame di animazione (0..7)
 329+ 7F19                  ; Nei dati di Manic Miner:
 330+ 7F19                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7F19                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7F19 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7F1C E6 03            and  3
 334+ 7F1E 47               ld   b, a                      ; B = Anim subframe
 335+ 7F1F
 336+ 7F1F DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7F22 FE 01            cp   1                         ; Sinistra?
 338+ 7F24 28 03            jr   z, .left_frames
 339+ 7F26
 340+ 7F26                  ; Movimento a Destra: Frame 0..3
 341+ 7F26 78               ld   a, b
 342+ 7F27 18 03            jr   .got_frame_idx
 343+ 7F29
 344+ 7F29              .left_frames:
 345+ 7F29                  ; Movimento a Sinistra: Frame 4..7
 346+ 7F29 3E 04            ld   a, 4
 347+ 7F2B 80               add  a, b
 348+ 7F2C
 349+ 7F2C              .got_frame_idx:
 350+ 7F2C                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7F2C 6F               ld   l, a
 352+ 7F2D 26 00            ld   h, 0
 353+ 7F2F 29               add  hl, hl                    ; *2
 354+ 7F30 29               add  hl, hl                    ; *4
 355+ 7F31 29               add  hl, hl                    ; *8
 356+ 7F32 29               add  hl, hl                    ; *16
 357+ 7F33 29               add  hl, hl                    ; *32
 358+ 7F34
 359+ 7F34 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7F37 19               add  hl, de
 361+ 7F38 ED 5B E7 99      ld   de, (room_ptr)
 362+ 7F3C 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7F3D E5               push hl
 364+ 7F3E DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7F40
 366+ 7F40                  ; 2. Coordinate e colore
 367+ 7F40 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7F42 FD E5            push iy
 369+ 7F44
 370+ 7F44 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7F47 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7F4A FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7F4D
 374+ 7F4D                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7F4D CD 90 5F         call Gfx_DrawPixelSprite16x16
 376+ 7F50 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7F53 CD C4 6D         call Gfx_SetEnemyColorAttributes
 378+ 7F56
 379+ 7F56 DD E1            pop  ix
 380+ 7F58 E1               pop  hl
 381+ 7F59 D1               pop  de
 382+ 7F5A C1               pop  bc
 383+ 7F5B C9               ret

  53+ 7CD6 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CDA DD 19            add  ix, de
  55+ 7CDC 10 F4            djnz .init_old_pos
  56+ 7CDE
  57+ 7CDE                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CDE DD 21 5F 7C      ld   ix, ActiveEnemies
  59+ 7CE2 2A 53 E5         ld   hl, (room_ptr)

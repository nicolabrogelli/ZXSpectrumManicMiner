   7+ 86AC              ; -------------------------------------------------------------------
   8+ 86AC              ; Audio_UpdateJumpSound
   9+ 86AC              ;
  10+ 86AC              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 86AC              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 86AC              ; -------------------------------------------------------------------
  13+ 86AC              Audio_UpdateJumpSound:
  14+ 86AC F5               push af
  15+ 86AD C5               push bc
  16+ 86AE D5               push de
  17+ 86AF E5               push hl
  18+ 86B0
  19+ 86B0                  ; Controlla se il suono è attivo (note < 18)
  20+ 86B0 3A 0C E8         ld   a, (Audio_jump_sound_note)
  21+ 86B3 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86B5 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86B7
  24+ 86B7                  ; Carica la nota corrente da suonare
  25+ 86B7 5F               ld   e, a
  26+ 86B8 16 00            ld   d, 0
  27+ 86BA 21 E6 86         ld   hl, Audio_JumpSoundDelays
  28+ 86BD 19               add  hl, de
  29+ 86BE 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86BF 57               ld   d, a                      ; D = delay della nota
  31+ 86C0
  32+ 86C0                  ; Suona la nota: 15 cicli
  33+ 86C0 06 0F            ld   b, 15
  34+ 86C2              .note_loop:
  35+ 86C2                  ; Speaker ON
  36+ 86C2 3A F9 E1         ld   a, (room_border_color)
  37+ 86C5 F6 10            or   $10
  38+ 86C7 D3 FE            out  ($fe), a
  39+ 86C9 4A               ld   c, d
  40+ 86CA              .d1:
  41+ 86CA 0D               dec  c
  42+ 86CB 20 FD            jr   nz, .d1
  43+ 86CD
  44+ 86CD                  ; Speaker OFF
  45+ 86CD 3A F9 E1         ld   a, (room_border_color)
  46+ 86D0 E6 EF            and  $ef
  47+ 86D2 D3 FE            out  ($fe), a
  48+ 86D4 4A               ld   c, d
  49+ 86D5              .d2:
  50+ 86D5 0D               dec  c
  51+ 86D6 20 FD            jr   nz, .d2
  52+ 86D8
  53+ 86D8 10 E8            djnz .note_loop
  54+ 86DA
  55+ 86DA                  ; Passa alla nota successiva
  56+ 86DA 3A 0C E8         ld   a, (Audio_jump_sound_note)
  57+ 86DD 3C               inc  a
  58+ 86DE 32 0C E8         ld   (Audio_jump_sound_note), a
  59+ 86E1
  60+ 86E1              .done:
  61+ 86E1 E1               pop  hl
  62+ 86E2 D1               pop  de
  63+ 86E3 C1               pop  bc
  64+ 86E4 F1               pop  af
  65+ 86E5 C9               ret

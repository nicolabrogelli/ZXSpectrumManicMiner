 922  87A9              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 923  87A9              ; per l'avvio di una nuova partita dopo il Game Over.
 924  87A9              ; -------------------------------------------------------------------
 925  87A9              ResetFullGameState:
 926  87A9                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 927  87A9 AF               xor  a
 928  87AA D3 FE            out  ($fe), a              ; Bordo a nero
 929  87AC 21 8D 5C         ld   hl, ATTR_P
 930  87AF 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 931  87B0 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 932  87B3 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 933  87B5 3E 07            ld   a, $07
 934  87B7 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 935  87BA

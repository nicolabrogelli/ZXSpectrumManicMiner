1163+ 7882              ; -------------------------------------------------------------------
1164+ 7882              ; Phys_CheckRampOnRoomChange
1165+ 7882              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 7882              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 7882              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 7882              ; -------------------------------------------------------------------
1169+ 7882              Phys_CheckRampOnRoomChange:
1170+ 7882 E5               push hl
1171+ 7883 D5               push de
1172+ 7884 C5               push bc
1173+ 7885
1174+ 7885                  ; Offsets per RampData: DE + 218
1175+ 7885 21 DA 00         ld   hl, 218
1176+ 7888 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 7889
1178+ 7889 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 788A 32 F7 B5         ld   (ramp_dir), a
1180+ 788D 23               inc  hl
1181+ 788E 5E               ld   e, (hl)
1182+ 788F 23               inc  hl
1183+ 7890 56               ld   d, (hl)           ; DE = Location
1184+ 7891 23               inc  hl
1185+ 7892 7E               ld   a, (hl)           ; A = Length
1186+ 7893 32 F8 B5         ld   (ramp_len), a
1187+ 7896
1188+ 7896                  ; Controlla se DE (Location) è 0 o Length è 0
1189+ 7896 7A               ld   a, d
1190+ 7897 B3               or   e
1191+ 7898 CA 9F 79         jp   z, .no_ramp_change
1192+ 789B 3A F8 B5         ld   a, (ramp_len)

 269+ 7E25              ; -------------------------------------------------------------------
 270+ 7E25              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 271+ 7E25              ; -------------------------------------------------------------------
 272+ 7E25              Enemy_EraseRoom:
 273+ 7E25              Enemy_DrawRoom:
 274+ 7E25              Enemy_RenderRoom:
 275+ 7E25 E5               push hl
 276+ 7E26 D5               push de
 277+ 7E27 C5               push bc
 278+ 7E28 DD E5            push ix
 279+ 7E2A
 280+ 7E2A                  ; ---------------------------------------------------------------
 281+ 7E2A                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 282+ 7E2A                  ; ---------------------------------------------------------------
 283+ 7E2A DD 21 5D 7C      ld   ix, ActiveEnemies
 284+ 7E2E 06 08            ld   b, 8              ; 8 slot
 285+ 7E30              .erase_loop:
 286+ 7E30 DD 7E 00         ld   a, (ix+0)         ; Flags
 287+ 7E33 E6 80            and  $80               ; Active?
 288+ 7E35 28 3A            jr   z, .next_erase
 289+ 7E37
 290+ 7E37                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 291+ 7E37 DD 7E 08         ld   a, (ix+8)         ; Old X
 292+ 7E3A FE FF            cp   $FF
 293+ 7E3C 28 33            jr   z, .next_erase
 294+ 7E3E
 295+ 7E3E                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 296+ 7E3E DD 7E 08         ld   a, (ix+8)         ; Old X
 297+ 7E41 DD BE 02         cp   (ix+2)            ; Current X
 298+ 7E44 20 0E            jr   nz, .do_erase_slot
 299+ 7E46 DD 7E 09         ld   a, (ix+9)         ; Old Y
 300+ 7E49 DD BE 03         cp   (ix+3)            ; Current Y
 301+ 7E4C 20 06            jr   nz, .do_erase_slot
 302+ 7E4E
 303+ 7E4E 3A E4 E3         ld   a, (enemy_was_updated)
 304+ 7E51 B7               or   a
 305+ 7E52 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 306+ 7E54
 307+ 7E54              .do_erase_slot:
 308+ 7E54 C5               push bc                ; Salva contatore ciclo
 309+ 7E55
 310+ 7E55                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 311+ 7E55 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 312+ 7E58 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 313+ 7E5B CD 01 7E         call CheckEnemyWillyOverlap
 314+ 7E5E
 315+ 7E5E                  ; Cancella il nemico nella VECCHIA posizione
 316+ 7E5E DD 4E 08         ld   c, (ix+8)         ; C = Old X
 317+ 7E61 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 318+ 7E64 CD BD 5F         call Gfx_ErasePixelSprite16x16
 319+ 7E67 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 320+ 7E6A DD 46 09         ld   b, (ix+9)         ; B = Old Y
 321+ 7E6D CD 73 6D         call Gfx_RestoreEnemyColorAttributes
 322+ 7E70
 323+ 7E70 C1               pop  bc
 324+ 7E71
 325+ 7E71              .next_erase:
 326+ 7E71 11 0B 00         ld   de, 11
 327+ 7E74 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 328+ 7E76 05               dec  b
 329+ 7E77 20 B7            jr   nz, .erase_loop
 330+ 7E79
 331+ 7E79                  ; ---------------------------------------------------------------
 332+ 7E79                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 333+ 7E79                  ; ---------------------------------------------------------------
 334+ 7E79 DD 21 5D 7C      ld   ix, ActiveEnemies
 335+ 7E7D 06 08            ld   b, 8              ; 8 slot
 336+ 7E7F              .draw_loop:
 337+ 7E7F DD 7E 00         ld   a, (ix+0)         ; Flags
 338+ 7E82 E6 80            and  $80               ; Active?
 339+ 7E84 28 37            jr   z, .next_draw
 340+ 7E86
 341+ 7E86                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 342+ 7E86 DD 7E 08         ld   a, (ix+8)         ; Old X
 343+ 7E89 FE FF            cp   $FF
 344+ 7E8B 28 16            jr   z, .do_draw_slot
 345+ 7E8D
 346+ 7E8D                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 347+ 7E8D DD 7E 08         ld   a, (ix+8)         ; Old X
 348+ 7E90 DD BE 02         cp   (ix+2)            ; Current X
 349+ 7E93 20 0E            jr   nz, .do_draw_slot
 350+ 7E95 DD 7E 09         ld   a, (ix+9)         ; Old Y
 351+ 7E98 DD BE 03         cp   (ix+3)            ; Current Y
 352+ 7E9B 20 06            jr   nz, .do_draw_slot
 353+ 7E9D
 354+ 7E9D 3A E4 E3         ld   a, (enemy_was_updated)
 355+ 7EA0 B7               or   a
 356+ 7EA1 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 357+ 7EA3
 358+ 7EA3              .do_draw_slot:
 359+ 7EA3 C5               push bc                ; Salva contatore ciclo
 360+ 7EA4
 361+ 7EA4                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 362+ 7EA4 CD CF 7E         call Enemy_DrawSingleSlot
 363+ 7EA7
 364+ 7EA7                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 365+ 7EA7 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 366+ 7EAA DD 46 03         ld   b, (ix+3)         ; B = Current Y
 367+ 7EAD CD 01 7E         call CheckEnemyWillyOverlap
 368+ 7EB0
 369+ 7EB0                  ; Salva le coordinate effettivamente disegnate
 370+ 7EB0 DD 7E 02         ld   a, (ix+2)
 371+ 7EB3 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 372+ 7EB6 DD 7E 03         ld   a, (ix+3)
 373+ 7EB9 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 374+ 7EBC
 375+ 7EBC C1               pop  bc
 376+ 7EBD
 377+ 7EBD              .next_draw:
 378+ 7EBD 11 0B 00         ld   de, 11
 379+ 7EC0 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 380+ 7EC2 05               dec  b
 381+ 7EC3 20 BA            jr   nz, .draw_loop
 382+ 7EC5
 383+ 7EC5 AF               xor  a
 384+ 7EC6 32 E4 E3         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 385+ 7EC9
 386+ 7EC9 DD E1            pop  ix
 387+ 7ECB C1               pop  bc
 388+ 7ECC D1               pop  de
 389+ 7ECD E1               pop  hl
 390+ 7ECE C9               ret

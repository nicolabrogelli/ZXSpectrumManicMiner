 852+ 615B FE 02            cp   2
 853+ 615D 30 06            jr   nc, .check_layout_tile
 854+ 615F
 855+ 615F                  ; DeltaCol = B - PortalCol (in D)
 856+ 615F 78               ld   a, b
 857+ 6160 92               sub  d
 858+ 6161 FE 02            cp   2
 859+ 6163 38 0D            jr   c, .not_empty         ; Se DeltaRow < 2 E DeltaCol < 2 -> È nel portale!
 860+ 6165
 861+ 6165              .check_layout_tile:
 862+ 6165                  ; 4. Controlla il tipo di tile in unpacked_layout
 863+ 6165 7C               ld   a, h                  ; A = Row
 864+ 6166 48               ld   c, b                  ; C = Col
 865+ 6167 CD EA 78         call GetCellFromUnpacked   ; A = tile index (0..7)
 866+ 616A B7               or   a
 867+ 616B 20 05            jr   nz, .not_empty        ; Se != 0, contiene un tile (Floor, Wall, Crumbling, Conveyor, Nasty...)
 868+ 616D
 869+ 616D                  ; La cella è completamente vuota!
 870+ 616D C1               pop  bc
 871+ 616E D1               pop  de
 872+ 616F E1               pop  hl

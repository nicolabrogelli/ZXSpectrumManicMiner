1875+ 7BA6              ; Phys_UpdateCrumblingFloors
1876+ 7BA6              ; Aggiorna l'animazione di tutti i blocchi sgretolabili attivi.
1877+ 7BA6              ; Quando un blocco completa lo sgretolamento (stadio > 8), viene
1878+ 7BA6              ; definitivamente rimosso dalla fisica (unpacked_layout) e dallo schermo.
1879+ 7BA6              ; -------------------------------------------------------------------
1880+ 7BA6              Phys_UpdateCrumblingFloors:
1881+ 7BA6 3A 77 B0         ld   a, (crumbling_active_count)
1882+ 7BA9 B7               or   a
1883+ 7BAA C8               ret  z                     ; Nessun blocco attivo -> uscita immediata
1884+ 7BAB
1885+ 7BAB                  ; Avanza l'animazione ogni 2 frame (approx 25Hz per 8 stadi = ~0.32s)
1886+ 7BAB 21 78 B0         ld   hl, crumbling_anim_timer
1887+ 7BAE 34               inc  (hl)
1888+ 7BAF 7E               ld   a, (hl)
1889+ 7BB0 E6 01            and  1
1890+ 7BB2 C0               ret  nz
1891+ 7BB3
1892+ 7BB3 E5               push hl
1893+ 7BB4 D5               push de
1894+ 7BB5 C5               push bc
1895+ 7BB6 DD E5            push ix
1896+ 7BB8
1897+ 7BB8 DD 21 77 AE      ld   ix, crumbling_grid
1898+ 7BBC 01 00 02         ld   bc, 512               ; 512 celle
1899+ 7BBF 16 00            ld   d, 0                  ; D = Row (0..15)
1900+ 7BC1 1E 00            ld   e, 0                  ; E = Col (0..31)
1901+ 7BC3
1902+ 7BC3              .loop:
1903+ 7BC3 DD 7E 00         ld   a, (ix+0)             ; A = Stage (0..8)
1904+ 7BC6 B7               or   a
1905+ 7BC7 28 3F            jr   z, .next
1906+ 7BC9
1907+ 7BC9 3C               inc  a                     ; Avanza di 1 stadio
1908+ 7BCA DD 77 00         ld   (ix+0), a
1909+ 7BCD
1910+ 7BCD FE 09            cp   9
1911+ 7BCF 30 0C            jr   nc, .finish_crumble
1912+ 7BD1
1913+ 7BD1                  ; Stadio 1..8: ridisegna la tile nello stadio corrente
1914+ 7BD1 C5               push bc
1915+ 7BD2 D5               push de
1916+ 7BD3 42               ld   b, d                  ; B = Row
1917+ 7BD4 4B               ld   c, e                  ; C = Col

 545+ 802A              .eugene_frame:
 546+ 802A                  ; Eugene usa la grafica speciale a OFFSET_EXTRA_GRAPHIC (736)
 547+ 802A 2A A5 ED         ld   hl, (room_ptr)
 548+ 802D 11 E0 02         ld   de, OFFSET_EXTRA_GRAPHIC

 287  849D              ; ShowTitleScreen
 288  849D              ; Visualizza la schermata iniziale del gioco (Title Screen).
 289  849D              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 290  849D              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 291  849D              ; -------------------------------------------------------------------
 292  849D              ShowTitleScreen:
 293  849D                  ; 1. Disegna la schermata iniziale
 294  849D CD E2 63         call Gfx_DrawTitleScreen
 295  84A0
 296  84A0                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 297  84A0              .wait_title_enter_release:
 298  84A0 76               halt
 299  84A1 3E BF            ld   a, $bf
 300  84A3 DB FE            in   a, ($fe)
 301  84A5 1F               rra
 302  84A6 30 F8            jr   nc, .wait_title_enter_release
 303  84A8
 304  84A8                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 305  84A8 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 306  84AA              .title_loop:
 307  84AA 76               halt
 308  84AB
 309  84AB                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 310  84AB 0C               inc  c
 311  84AC 79               ld   a, c
 312  84AD CB 3F            srl  a
 313  84AF CB 3F            srl  a
 314  84B1 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 315  84B3 E6 07            and  7
 316  84B5 5F               ld   e, a
 317  84B6 16 00            ld   d, 0
 318  84B8 21 DA 63         ld   hl, title_color_table
 319  84BB 19               add  hl, de
 320  84BC 7E               ld   a, (hl)               ; A = nuovo colore
 321  84BD 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 322  84C0 06 20            ld   b, 32
 323  84C2              .color_title_loop:
 324  84C2 77               ld   (hl), a
 325  84C3 23               inc  hl
 326  84C4 10 FC            djnz .color_title_loop
 327  84C6
 328  84C6                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 329  84C6 3E BF            ld   a, $bf
 330  84C8 DB FE            in   a, ($fe)
 331  84CA 1F               rra
 332  84CB 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 333  84CD
 334  84CD                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 335  84CD              .wait_title_enter_release_after:
 336  84CD 76               halt
 337  84CE 3E BF            ld   a, $bf
 338  84D0 DB FE            in   a, ($fe)
 339  84D2 1F               rra
 340  84D3 30 F8            jr   nc, .wait_title_enter_release_after
 341  84D5
 342  84D5                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 343  84D5 AF               xor  a
 344  84D6 D3 FE            out  ($fe), a              ; Bordo a nero
 345  84D8 21 8D 5C         ld   hl, ATTR_P
 346  84DB 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 347  84DC CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  84DF 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 349  84E1 3E 07            ld   a, $07
 350  84E3 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07

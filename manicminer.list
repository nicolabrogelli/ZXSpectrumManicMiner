 498+ 7EA6              ; -------------------------------------------------------------------
 499+ 7EA6              ; Items_CheckCollision
 500+ 7EA6              ;
 501+ 7EA6              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 502+ 7EA6              ; -------------------------------------------------------------------
 503+ 7EA6              Items_CheckCollision:
 504+ 7EA6 E5               push hl
 505+ 7EA7 D5               push de
 506+ 7EA8 C5               push bc
 507+ 7EA9 FD E5            push iy
 508+ 7EAB
 509+ 7EAB 3A 2C 96         ld   a, (num_room_items)
 510+ 7EAE B7               or   a
 511+ 7EAF 28 66            jr   z, .done
 512+ 7EB1
 513+ 7EB1 FD 21 DC 95      ld   iy, current_room_items
 514+ 7EB5
 515+ 7EB5              .loop:
 516+ 7EB5 FD 7E 02         ld   a, (iy+2)                 ; Color / Active / Terminator ($FF)
 517+ 7EB8 FE FF            cp   $FF
 518+ 7EBA 28 5B            jr   z, .done                  ; Fine lista item della stanza
 519+ 7EBC B7               or   a
 520+ 7EBD 28 51            jr   z, .next_item             ; Item già raccolto -> controlla il successivo
 521+ 7EBF
 522+ 7EBF FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 523+ 7EC2 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 524+ 7EC5
 525+ 7EC5 79               ld   a, c
 526+ 7EC6 CD 59 7E         call CheckWillyItemCollision
 527+ 7EC9 30 45            jr   nc, .next_item
 528+ 7ECB
 529+ 7ECB                  ; --- ITEM RACCOLTO ---
 530+ 7ECB                  ; 1. Imposta il flag collected nei dati stanza
 531+ 7ECB FD 6E 03         ld   l, (iy+3)
 532+ 7ECE FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 533+ 7ED1 36 00            ld   (hl), 0                   ; 0 = raccolto
 534+ 7ED3
 535+ 7ED3                  ; 2. Rimuovi dalla griglia items_grid
 536+ 7ED3 FD 4E 00         ld   c, (iy+0)
 537+ 7ED6 FD 46 01         ld   b, (iy+1)
 538+ 7ED9 C5               push bc
 539+ 7EDA 26 00            ld   h, 0
 540+ 7EDC 68               ld   l, b
 541+ 7EDD 29               add  hl, hl
 541+ 7EDE 29             add hl, hl
 541+ 7EDF 29             add hl, hl
 541+ 7EE0 29             add hl, hl
 541+ 7EE1 29             add hl, hl
 542+ 7EE2 59               ld   e, c
 543+ 7EE3 16 00            ld   d, 0
 544+ 7EE5 19               add  hl, de
 545+ 7EE6 11 AD 90         ld   de, items_grid
 546+ 7EE9 19               add  hl, de
 547+ 7EEA 36 00            ld   (hl), 0
 548+ 7EEC C1               pop  bc
 549+ 7EED
 550+ 7EED                  ; 3. Disattiva lo slot nella cache
 551+ 7EED FD 36 02 00      ld   (iy+2), 0
 552+ 7EF1
 553+ 7EF1                  ; 4. Decrementa il numero di item rimanenti nella stanza corrente
 554+ 7EF1 21 2C 96         ld   hl, num_room_items
 555+ 7EF4 7E               ld   a, (hl)
 556+ 7EF5 B7               or   a
 557+ 7EF6 28 08            jr   z, .no_dec_room
 558+ 7EF8 35               dec  (hl)
 559+ 7EF9 20 05            jr   nz, .no_dec_room
 560+ 7EFB                  ; Ultimo item della stanza raccolto -> Attiva il portale!
 561+ 7EFB 3E 01            ld   a, 1
 562+ 7EFD 32 C2 98         ld   (game_objective_completed), a
 563+ 7F00              .no_dec_room:
 564+ 7F00
 565+ 7F00                  ; Incrementa il conteggio globale degli item raccolti
 566+ 7F00 3A B7 92         ld   a, (items_collected)
 567+ 7F03 3C               inc  a
 568+ 7F04 32 B7 92         ld   (items_collected), a
 569+ 7F07
 570+ 7F07                  ; 5. Aggiungi 100 punti allo Score, aggiorna High Score e aggiorna la visualizzazione HUD
 571+ 7F07 CD 3B 7F         call Score_AddItemPoints
 572+ 7F0A
 573+ 7F0A                  ; 6. Ripristina il tile di sfondo
 574+ 7F0A CD 27 7E         call RestoreBackgroundCell
 575+ 7F0D
 576+ 7F0D                  ; 7. Suono di raccolta
 577+ 7F0D CD DE 7F         call Audio_PlayCollectSound
 578+ 7F10
 579+ 7F10              .next_item:
 580+ 7F10 11 05 00         ld   de, 5
 581+ 7F13 FD 19            add  iy, de
 582+ 7F15 18 9E            jr   .loop
 583+ 7F17
 584+ 7F17              .done:
 585+ 7F17 FD E1            pop  iy
 586+ 7F19 C1               pop  bc
 587+ 7F1A D1               pop  de
 588+ 7F1B E1               pop  hl
 589+ 7F1C C9               ret
 590+ 7F1D
 591+ 7F1D              ; -------------------------------------------------------------------
 592+ 7F1D              ; CheckActiveItemAtCell
 593+ 7F1D              ;
 594+ 7F1D              ; Verifica rapida su griglia se c'è un item attivo alla cella (B=Col, C=Row)
 595+ 7F1D              ; Output: Carry Set = Item presente, Carry Clear = Nessun item
 596+ 7F1D              ; -------------------------------------------------------------------
 597+ 7F1D              CheckActiveItemAtCell:
 598+ 7F1D D5               push de
 599+ 7F1E E5               push hl
 600+ 7F1F
 601+ 7F1F 26 00            ld   h, 0
 602+ 7F21 69               ld   l, c                      ; HL = Row
 603+ 7F22 29               add  hl, hl
 603+ 7F23 29             add hl, hl
 603+ 7F24 29             add hl, hl
 603+ 7F25 29             add hl, hl
 603+ 7F26 29             add hl, hl
 604+ 7F27 58               ld   e, b
 605+ 7F28 16 00            ld   d, 0
 606+ 7F2A 19               add  hl, de
 607+ 7F2B 11 AD 90         ld   de, items_grid
 608+ 7F2E 19               add  hl, de
 609+ 7F2F 7E               ld   a, (hl)
 610+ 7F30 B7               or   a
 611+ 7F31 28 04            jr   z, .not_active
 612+ 7F33
 613+ 7F33 E1               pop  hl
 614+ 7F34 D1               pop  de
 615+ 7F35 37               scf
 616+ 7F36 C9               ret
 617+ 7F37
 618+ 7F37              .not_active:
 619+ 7F37 E1               pop  hl
 620+ 7F38 D1               pop  de
 621+ 7F39 B7               or   a
 622+ 7F3A C9               ret
 623+ 7F3B
 624+ 7F3B              ; -------------------------------------------------------------------
 625+ 7F3B              ; Score_AddItemPoints
 626+ 7F3B              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 7F3B              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 7F3B              ; -------------------------------------------------------------------
 629+ 7F3B              Score_AddItemPoints:
 630+ 7F3B F5               push af
 631+ 7F3C C5               push bc
 632+ 7F3D D5               push de
 633+ 7F3E E5               push hl
 634+ 7F3F
 635+ 7F3F                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 7F3F 3A BD 98         ld   a, (player_score + 1)
 637+ 7F42 C6 01            add  a, $01
 638+ 7F44 27               daa
 639+ 7F45 32 BD 98         ld   (player_score + 1), a
 640+ 7F48
 641+ 7F48                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 7F48 3A BE 98         ld   a, (player_score + 2)
 643+ 7F4B CE 00            adc  a, 0
 644+ 7F4D 27               daa
 645+ 7F4E 32 BE 98         ld   (player_score + 2), a
 646+ 7F51
 647+ 7F51                  ; Controlla se player_score ha superato high_score
 648+ 7F51 CD 5C 7F         call Score_CheckAndUpdateHighScore
 649+ 7F54
 650+ 7F54                  ; Aggiorna visualizzazione a schermo
 651+ 7F54 CD 63 67         call Gfx_UpdateScoreDisplay
 652+ 7F57
 653+ 7F57 E1               pop  hl
 654+ 7F58 D1               pop  de
 655+ 7F59 C1               pop  bc
 656+ 7F5A F1               pop  af
 657+ 7F5B C9               ret
 658+ 7F5C
 659+ 7F5C              ; -------------------------------------------------------------------
 660+ 7F5C              ; Score_CheckAndUpdateHighScore
 661+ 7F5C              ; Se player_score > high_score, copia player_score in high_score.
 662+ 7F5C              ; -------------------------------------------------------------------
 663+ 7F5C              Score_CheckAndUpdateHighScore:
 664+ 7F5C                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 7F5C                  ; Byte 2:
 666+ 7F5C 3A BE 98         ld   a, (player_score + 2)
 667+ 7F5F 47               ld   b, a
 668+ 7F60 3A C1 98         ld   a, (high_score + 2)
 669+ 7F63 B8               cp   b
 670+ 7F64 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 7F66 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 7F68
 673+ 7F68                  ; Byte 1:
 674+ 7F68 3A BD 98         ld   a, (player_score + 1)
 675+ 7F6B 47               ld   b, a
 676+ 7F6C 3A C0 98         ld   a, (high_score + 1)
 677+ 7F6F B8               cp   b

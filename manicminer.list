 417  862F CB 67            bit  4, a
 418  8631 28 2A            jr   z, .continue_chosen
 419  8633
 420  8633                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  8633 01 FE 7F         ld   bc, $7ffe

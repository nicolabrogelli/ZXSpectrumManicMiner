 737+ 60DB E1               pop  hl
 738+ 60DC
 739+ 60DC E5               push hl
 740+ 60DD 5F               ld   e, a                  ; E = attributo originale del tile
 741+ 60DE 6C               ld   l, h
 742+ 60DF 26 00            ld   h, 0
 743+ 60E1 29               add  hl, hl
 743+ 60E2 29             add hl, hl
 743+ 60E3 29             add hl, hl
 743+ 60E4 29             add hl, hl
 743+ 60E5 29             add hl, hl
 744+ 60E6 78               ld   a, b
 745+ 60E7 85               add  a, l
 746+ 60E8 6F               ld   l, a
 747+ 60E9 30 01            jr   nc, .no_c_tile
 748+ 60EB 24               inc  h
 749+ 60EC              .no_c_tile:
 750+ 60EC 7C               ld   a, h
 751+ 60ED C6 58            add  a, $58

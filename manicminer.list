 855+ 626D 21 8D 5C         ld   hl, ATTR_P
 856+ 6270 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 857+ 6271 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 858+ 6274 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 859+ 6276 3E 07            ld   a, $07
 860+ 6278 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 861+ 627B
 862+ 627B                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
 863+ 627B 3E 16            ld   a, 22
 864+ 627D D7               rst  $10
 865+ 627E 3E 01            ld   a, 1
 866+ 6280 D7               rst  $10
 867+ 6281 3E 00            ld   a, 0
 868+ 6283 D7               rst  $10

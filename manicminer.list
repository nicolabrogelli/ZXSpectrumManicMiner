 489  859B 32 0C A2         ld   (willy_on_ramp), a
 490  859E 32 0B A2         ld   (willy_needs_redraw), a
 491  85A1 3E FF            ld   a, $ff
 492  85A3 32 1E 9E         ld   (digit_key_prev), a
 493  85A6 32 06 A2         ld   (player_drawn_pos+1), a
 494  85A9 32 07 A2         ld   (player_old_dir), a
 495  85AC 32 08 A2         ld   (player_old_body), a
 496  85AF 3E 01            ld   a, 1
 497  85B1 32 17 9E         ld   (q_prev), a
 498  85B4 32 18 9E         ld   (a_prev), a

   8+ 87E1              ; Audio_UpdateJumpSound
   9+ 87E1              ;
  10+ 87E1              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 87E1              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 87E1              ; -------------------------------------------------------------------
  13+ 87E1              Audio_UpdateJumpSound:
  14+ 87E1 F5               push af
  15+ 87E2 C5               push bc
  16+ 87E3 D5               push de
  17+ 87E4 E5               push hl
  18+ 87E5
  19+ 87E5                  ; Controlla se il suono è attivo (note < 18)
  20+ 87E5 3A 69 F0         ld   a, (Audio_jump_sound_note)
  21+ 87E8 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 87EA 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 87EC
  24+ 87EC                  ; Carica la nota corrente da suonare
  25+ 87EC 5F               ld   e, a
  26+ 87ED 16 00            ld   d, 0
  27+ 87EF 21 1B 88         ld   hl, Audio_JumpSoundDelays
  28+ 87F2 19               add  hl, de
  29+ 87F3 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 87F4 57               ld   d, a                      ; D = delay della nota
  31+ 87F5
  32+ 87F5                  ; Suona la nota: 15 cicli
  33+ 87F5 06 0F            ld   b, 15
  34+ 87F7              .note_loop:
  35+ 87F7                  ; Speaker ON
  36+ 87F7 3A 55 EA         ld   a, (room_border_color)
  37+ 87FA F6 10            or   $10
  38+ 87FC D3 FE            out  ($fe), a
  39+ 87FE 4A               ld   c, d
  40+ 87FF              .d1:
  41+ 87FF 0D               dec  c
  42+ 8800 20 FD            jr   nz, .d1
  43+ 8802
  44+ 8802                  ; Speaker OFF
  45+ 8802 3A 55 EA         ld   a, (room_border_color)
  46+ 8805 E6 EF            and  $ef
  47+ 8807 D3 FE            out  ($fe), a
  48+ 8809 4A               ld   c, d
  49+ 880A              .d2:
  50+ 880A 0D               dec  c
  51+ 880B 20 FD            jr   nz, .d2
  52+ 880D
  53+ 880D 10 E8            djnz .note_loop
  54+ 880F
  55+ 880F                  ; Passa alla nota successiva
  56+ 880F 3A 69 F0         ld   a, (Audio_jump_sound_note)
  57+ 8812 3C               inc  a
  58+ 8813 32 69 F0         ld   (Audio_jump_sound_note), a

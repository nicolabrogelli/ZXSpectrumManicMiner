 138+ 7E17              ; Items_DrawRoom
 139+ 7E17              ;
 140+ 7E17              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 7E17              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 7E17              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 7E17              ;
 144+ 7E17              ; Record item nella stanza (5 byte):
 145+ 7E17              ;   +0 Color / Attributo
 146+ 7E17              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 7E17              ;   +2 Attr Address High
 148+ 7E17              ;   +3 Anim Mask (96)
 149+ 7E17              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 7E17              ; Fine lista: $FF
 151+ 7E17              ; -------------------------------------------------------------------
 152+ 7E17              Items_DrawRoom:
 153+ 7E17 E5               push hl
 154+ 7E18 D5               push de
 155+ 7E19 C5               push bc

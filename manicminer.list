 714+ 806D              .calc_guard_ptr:
 715+ 806D                  ; Offset = Frame * 32
 716+ 806D 6F               ld   l, a
 717+ 806E 26 00            ld   h, 0
 718+ 8070 29               add  hl, hl                    ; *2
 719+ 8071 29               add  hl, hl                    ; *4
 720+ 8072 29               add  hl, hl                    ; *8
 721+ 8073 29               add  hl, hl                    ; *16
 722+ 8074 29               add  hl, hl                    ; *32
 723+ 8075 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 724+ 8078 19               add  hl, de
 725+ 8079 ED 5B 8A E2      ld   de, (room_ptr)
 726+ 807D 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 727+ 807E 22 2F E5         ld   (guard_sprite_ptr), hl
 728+ 8081
 729+ 8081                  ; ---------------------------------------------------------------
 730+ 8081                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 731+ 8081                  ; ---------------------------------------------------------------
 732+ 8081 3A 32 E5         ld   a, (collision_delta_y)
 733+ 8084 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 734+ 8086 20 12            jr   nz, .willy_higher
 735+ 8088
 736+ 8088                  ; Willy lower or equal (DeltaY >= 0):
 737+ 8088                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 738+ 8088 32 33 E5         ld   (row_enemy_cur), a
 739+ 808B AF               xor  a
 740+ 808C 32 34 E5         ld   (row_willy_cur), a
 741+ 808F 3E 10            ld   a, 16
 742+ 8091 21 32 E5         ld   hl, collision_delta_y
 743+ 8094 96               sub  (hl)
 744+ 8095 32 35 E5         ld   (overlap_num_lines), a
 745+ 8098 18 12            jr   .check_lines_loop
 746+ 809A
 747+ 809A              .willy_higher:
 748+ 809A                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 749+ 809A ED 44            neg                            ; A = -DeltaY (1..15)
 750+ 809C 32 34 E5         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 751+ 809F AF               xor  a
 752+ 80A0 32 33 E5         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 753+ 80A3 3E 10            ld   a, 16
 754+ 80A5 21 34 E5         ld   hl, row_willy_cur
 755+ 80A8 96               sub  (hl)
 756+ 80A9 32 35 E5         ld   (overlap_num_lines), a
 757+ 80AC
 758+ 80AC              .check_lines_loop:
 759+ 80AC                  ; ---------------------------------------------------------------
 760+ 80AC                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 761+ 80AC                  ; ---------------------------------------------------------------
 762+ 80AC 3A 35 E5         ld   a, (overlap_num_lines)
 763+ 80AF 47               ld   b, a                      ; B = numero di scanlines da controllare
 764+ 80B0
 765+ 80B0              .scanline_loop:
 766+ 80B0 C5               push bc                        ; Salva contatore scanlines
 767+ 80B1
 768+ 80B1                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 769+ 80B1 3A 33 E5         ld   a, (row_enemy_cur)
 770+ 80B4 87               add  a, a                      ; row * 2
 771+ 80B5 5F               ld   e, a
 772+ 80B6 16 00            ld   d, 0
 773+ 80B8 2A 2F E5         ld   hl, (guard_sprite_ptr)
 774+ 80BB 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 775+ 80BC 56               ld   d, (hl)                   ; D = Enemy Byte 0
 776+ 80BD 23               inc  hl
 777+ 80BE 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 778+ 80BF
 779+ 80BF                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 780+ 80BF 3A 31 E5         ld   a, (collision_delta_x)
 781+ 80C2 CB 7F            bit  7, a
 782+ 80C4 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 783+ 80C6
 784+ 80C6                  ; DeltaX >= 0:
 785+ 80C6 FE 09            cp   9
 786+ 80C8 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 787+ 80CA
 788+ 80CA                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 789+ 80CA B7               or   a
 790+ 80CB 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 791+ 80CD 4F               ld   c, a                      ; C = DeltaX (1..8)
 792+ 80CE              .shift_left_16bit:
 793+ 80CE CB 23            sla  e
 794+ 80D0 CB 12            rl   d
 795+ 80D2 0D               dec  c
 796+ 80D3 20 F9            jr   nz, .shift_left_16bit
 797+ 80D5              .slice_ready_in_d:

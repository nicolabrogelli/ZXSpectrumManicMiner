 938+ 77C0 20 0B            jr   nz, .no
 939+ 77C2
 940+ 77C2 3A B8 E4         ld   a, (ramp_row)
 941+ 77C5 21 B7 E4         ld   hl, ramp_len
 942+ 77C8 96               sub  (hl)
 943+ 77C9 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 944+ 77CA BA               cp   d                 ; Compare with Row
 945+ 77CB 28 04            jr   z, .yes

   8+ 8595              ; Audio_UpdateJumpSound
   9+ 8595              ;
  10+ 8595              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8595              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8595              ; -------------------------------------------------------------------
  13+ 8595              Audio_UpdateJumpSound:
  14+ 8595 F5               push af
  15+ 8596 C5               push bc
  16+ 8597 D5               push de
  17+ 8598 E5               push hl
  18+ 8599
  19+ 8599                  ; Controlla se il suono è attivo (note < 18)
  20+ 8599 3A BA E6         ld   a, (Audio_jump_sound_note)
  21+ 859C FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 859E 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 85A0
  24+ 85A0                  ; Carica la nota corrente da suonare
  25+ 85A0 5F               ld   e, a
  26+ 85A1 16 00            ld   d, 0
  27+ 85A3 21 CF 85         ld   hl, Audio_JumpSoundDelays
  28+ 85A6 19               add  hl, de
  29+ 85A7 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 85A8 57               ld   d, a                      ; D = delay della nota
  31+ 85A9
  32+ 85A9                  ; Suona la nota: 15 cicli
  33+ 85A9 06 0F            ld   b, 15
  34+ 85AB              .note_loop:
  35+ 85AB                  ; Speaker ON
  36+ 85AB 3A A9 E0         ld   a, (room_border_color)
  37+ 85AE F6 10            or   $10
  38+ 85B0 D3 FE            out  ($fe), a
  39+ 85B2 4A               ld   c, d
  40+ 85B3              .d1:
  41+ 85B3 0D               dec  c
  42+ 85B4 20 FD            jr   nz, .d1
  43+ 85B6
  44+ 85B6                  ; Speaker OFF
  45+ 85B6 3A A9 E0         ld   a, (room_border_color)
  46+ 85B9 E6 EF            and  $ef
  47+ 85BB D3 FE            out  ($fe), a
  48+ 85BD 4A               ld   c, d
  49+ 85BE              .d2:
  50+ 85BE 0D               dec  c
  51+ 85BF 20 FD            jr   nz, .d2
  52+ 85C1
  53+ 85C1 10 E8            djnz .note_loop
  54+ 85C3
  55+ 85C3                  ; Passa alla nota successiva
  56+ 85C3 3A BA E6         ld   a, (Audio_jump_sound_note)
  57+ 85C6 3C               inc  a
  58+ 85C7 32 BA E6         ld   (Audio_jump_sound_note), a
  59+ 85CA
  60+ 85CA              .done:
  61+ 85CA E1               pop  hl
  62+ 85CB D1               pop  de
  63+ 85CC C1               pop  bc
  64+ 85CD F1               pop  af
  65+ 85CE C9               ret

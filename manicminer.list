  72+ 890C ~            ; Audio_UpdateMusic
  73+ 890C ~            ;
  74+ 890C ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 890C ~            ; Viene chiamata a ogni frame.
  76+ 890C ~            ; -------------------------------------------------------------------
  77+ 890C ~            Audio_UpdateMusic:
  78+ 890C ~                push af
  79+ 890C ~                push bc
  80+ 890C ~                push de
  81+ 890C ~                push hl
  82+ 890C ~
  83+ 890C ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 890C ~                ld   a, (Audio_jump_sound_note)
  85+ 890C ~                cp   18
  86+ 890C ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 890C ~
  88+ 890C ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 890C ~                ld   a, (Audio_music_frame_counter)
  90+ 890C ~                dec  a
  91+ 890C ~                ld   (Audio_music_frame_counter), a
  92+ 890C ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 890C ~
  94+ 890C ~                ; Altrimenti carica la nota successiva
  95+ 890C ~                ld   a, (Audio_music_note_idx)
  96+ 890C ~                inc  a
  97+ 890C ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 890C ~                jr   c, .no_wrap
  99+ 890C ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 890C ~            .no_wrap:
 101+ 890C ~                ld   (Audio_music_note_idx), a
 102+ 890C ~
 103+ 890C ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 890C ~                ld   e, a
 105+ 890C ~                ld   d, 0
 106+ 890C ~                ld   hl, Audio_MusicSheet
 107+ 890C ~                add  hl, de
 108+ 890C ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 890C ~
 110+ 890C ~                ; Leggi durata (secondo byte)
 111+ 890C ~                inc  hl
 112+ 890C ~                ld   a, (hl)
 113+ 890C ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 890C ~                jr   nz, .dur_ok
 115+ 890C ~                ld   a, 1
 116+ 890C ~            .dur_ok:
 117+ 890C ~                ld   (Audio_music_frame_counter), a
 118+ 890C ~
 119+ 890C ~            .play_current_note:
 120+ 890C ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 890C ~                ld   a, (Audio_music_note_idx)
 122+ 890C ~                ld   e, a
 123+ 890C ~                ld   d, 0
 124+ 890C ~                ld   hl, Audio_MusicSheet
 125+ 890C ~                add  hl, de
 126+ 890C ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 890C ~                ld   a, (hl)                  ; A = delay
 128+ 890C ~                or   a
 129+ 890C ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 890C ~
 131+ 890C ~                ; Suona la nota: 2 cicli
 132+ 890C ~                ld   d, a                     ; D = delay
 133+ 890C ~                ld   b, 2                     ; 2 cicli per frame
 134+ 890C ~            .note_loop:
 135+ 890C ~                ; Speaker ON
 136+ 890C ~                ld   a, (room_border_color)
 137+ 890C ~                or   $10
 138+ 890C ~                out  ($fe), a
 139+ 890C ~                ld   c, d
 140+ 890C ~            .d1:
 141+ 890C ~                push af
 142+ 890C ~                pop  af
 143+ 890C ~                dec  c
 144+ 890C ~                jr   nz, .d1
 145+ 890C ~
 146+ 890C ~                ; Speaker OFF
 147+ 890C ~                ld   a, (room_border_color)
 148+ 890C ~                and  $ef
 149+ 890C ~                out  ($fe), a
 150+ 890C ~                ld   c, d
 151+ 890C ~            .d2:
 152+ 890C ~                push af
 153+ 890C ~                pop  af
 154+ 890C ~                dec  c
 155+ 890C ~                jr   nz, .d2
 156+ 890C ~
 157+ 890C ~                djnz .note_loop
 158+ 890C ~
 159+ 890C ~            .done:
 160+ 890C ~                pop  hl
 161+ 890C ~                pop  de
 162+ 890C ~                pop  bc
 163+ 890C ~                pop  af
 164+ 890C ~                ret
 165+ 890C ~

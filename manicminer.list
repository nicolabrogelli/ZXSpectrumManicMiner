1690+ 66A3              .draw_foot:
1691+ 66A3                  ; 7b. Disegna PiedeSprite alla coordinata corrente (X=120, Y)
1692+ 66A3 0E 78            ld   c, 120
1693+ 66A5 DD 21 24 6E      ld   ix, PiedeSprite
1694+ 66A9 CD 6F 5F         call Gfx_DrawPixelSprite16x16
1695+ 66AC
1696+ 66AC                  ; 7c. Imposta colore Giallo Brillante per PiedeSprite
1697+ 66AC 0E 78            ld   c, 120
1698+ 66AE 3E 46            ld   a, YELLOW | $40
1699+ 66B0 CD 1F 6D         call Gfx_SetEnemyColorAttributes
1700+ 66B3
1701+ 66B3                  ; 7d. Pausa per movimento fluido a 50Hz
1702+ 66B3 76               halt
1703+ 66B4
1704+ 66B4 C1               pop  bc                    ; B = Y corrente
1705+ 66B5 78               ld   a, b
1706+ 66B6 C6 02            add  a, 2                  ; Avanza di 2 pixel
1707+ 66B8 47               ld   b, a
1708+ 66B9 FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1709+ 66BB 38 B2            jr   c, .foot_descent_loop
1710+ 66BD
1711+ 66BD                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1712+ 66BD 06 23            ld   b, 35

 640+ 8630
 641+ 8630                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 642+ 8630 3A 9E E7         ld   a, (player_score + 1)
 643+ 8633 C6 01            add  a, $01
 644+ 8635 27               daa
 645+ 8636 32 9E E7         ld   (player_score + 1), a
 646+ 8639
 647+ 8639                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 648+ 8639 3A 9F E7         ld   a, (player_score + 2)
 649+ 863C CE 00            adc  a, 0
 650+ 863E 27               daa

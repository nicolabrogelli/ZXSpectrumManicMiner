2223+ 696D 23               inc  hl
2224+ 696E
2225+ 696E                  ; Cifra 1 (decine di migliaia)
2226+ 696E DD 7E 02         ld   a, (ix+2)
2227+ 6971 E6 0F            and  $0f
2228+ 6973 C6 30            add  a, '0'
2229+ 6975 77               ld   (hl), a

 627  864E C3 A1 84         jp   ShowTitleScreen
 628  8651
 629  8651              .play_again_chosen:
 630  8651                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 631  8651              .wait_play_again_release:
 632  8651 76               halt
 633  8652 01 FE DF         ld   bc, $dffe
 634  8655 ED 78            in   a, (c)
 635  8657 CB 67            bit  4, a
 636  8659 28 F6            jr   z, .wait_play_again_release
 637  865B
 638  865B                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 639  865B CD 5F 87         call ResetFullGameState
 640  865E C3 72 83         jp   LoadRoomAndRestart
 641  8661
 642  8661              ; -------------------------------------------------------------------
 643  8661              ; CheckPortalTransition
 644  8661              ; Verifica le condizioni per accedere alla stanza successiva:
 645  8661              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 646  8661              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 647  8661              ;
 648  8661              ; Output:
 649  8661              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 650  8661              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 651  8661              ; -------------------------------------------------------------------
 652  8661              CheckPortalTransition:
 653  8661 C5               push bc
 654  8662 D5               push de
 655  8663 E5               push hl
 656  8664
 657  8664                  ; 1. Tutti gli item della stanza sono stati raccolti?
 658  8664 CD F2 86         call CheckAllItemsCollected
 659  8667 30 4D            jr   nc, .no_transition
 660  8669
 661  8669                  ; 2. Willy collide con il portale (16x16 pixel)?
 662  8669                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 663  8669                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 664  8669 2A 80 A1         ld   hl, (room_ptr)
 665  866C 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 666  866F 19               add  hl, de
 667  8670 4E               ld   c, (hl)
 668  8671 23               inc  hl
 669  8672 46               ld   b, (hl)                   ; BC = AttrAddr
 670  8673
 671  8673                  ; Offset = BC - 23552
 672  8673 60               ld   h, b
 673  8674 69               ld   l, c
 674  8675 01 00 A4         ld   bc, -23552
 675  8678 09               add  hl, bc
 676  8679
 677  8679                  ; PortalX = (Offset & 31) * 8
 678  8679 7D               ld   a, l
 679  867A E6 1F            and  31
 680  867C 87               add  a, a
 680  867D 87             add a, a
 680  867E 87             add a, a
 681  867F 5F               ld   e, a                      ; E = PortalX (0..248)
 682  8680
 683  8680                  ; PortalY = (Offset / 32) * 8
 684  8680 CB 3C            srl  h
 684  8682 CB 1D          rr l
 685  8684 CB 3C            srl  h
 685  8686 CB 1D          rr l
 686  8688 CB 3C            srl  h
 686  868A CB 1D          rr l
 687  868C CB 3C            srl  h
 687  868E CB 1D          rr l
 688  8690 CB 3C            srl  h
 688  8692 CB 1D          rr l
 689  8694 7D               ld   a, l
 690  8695 87               add  a, a
 690  8696 87             add a, a
 690  8697 87             add a, a
 691  8698 57               ld   d, a                      ; D = PortalY (0..120)
 692  8699
 693  8699                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 694  8699 ED 4B 00 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 695  869D
 696  869D                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 697  869D 7B               ld   a, e
 698  869E 91               sub  c
 699  869F 30 02            jr   nc, .x_diff_pos
 700  86A1 ED 44            neg
 701  86A3              .x_diff_pos:
 702  86A3 FE 0C            cp   12
 703  86A5 30 0F            jr   nc, .no_transition
 704  86A7
 705  86A7                  ; Controllo verticale: |WillyY - PortalY| < 14
 706  86A7 7A               ld   a, d
 707  86A8 90               sub  b
 708  86A9 30 02            jr   nc, .y_diff_pos
 709  86AB ED 44            neg
 710  86AD              .y_diff_pos:
 711  86AD FE 0E            cp   14
 712  86AF 30 05            jr   nc, .no_transition
 713  86B1
 714  86B1                  ; Transizione al portale attiva!
 715  86B1 E1               pop  hl
 716  86B2 D1               pop  de
 717  86B3 C1               pop  bc
 718  86B4 37               scf
 719  86B5 C9               ret
 720  86B6
 721  86B6              .no_transition:
 722  86B6 E1               pop  hl
 723  86B7 D1               pop  de
 724  86B8 C1               pop  bc
 725  86B9 B7               or   a
 726  86BA C9               ret
 727  86BB
 728  86BB              ; Alias per retrocompatibilità
 729  86BB              CheckVictoryCondition: EQU CheckPortalTransition
 730  86BB
 731  86BB              ; -------------------------------------------------------------------
 732  86BB              ; TriggerPortalTransition
 733  86BB              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 734  86BB              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 735  86BB              ; - Avanza all'indice della stanza successiva.
 736  86BB              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 737  86BB              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 738  86BB              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 739  86BB              ; -------------------------------------------------------------------
 740  86BB              TriggerPortalTransition:
 741  86BB                  ; 1. Determina l'ID della stanza corrente
 742  86BB CD 1E 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 743  86BE
 744  86BE                  ; 2. Calcola l'indice della stanza successiva
 745  86BE 3A 26 A1         ld   a, (current_room)
 746  86C1 3C               inc  a
 747  86C2 FE 04            cp   NUM_ROOMS
 748  86C4 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 749  86C6
 750  86C6                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 751  86C6 21 04 73         ld   hl, RoomsListTable
 752  86C9 5F               ld   e, a
 753  86CA 16 00            ld   d, 0
 754  86CC 19               add  hl, de
 755  86CD 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 756  86CE 5E               ld   e, (hl)
 757  86CF 23               inc  hl
 758  86D0 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 759  86D1 ED 53 80 A1      ld   (room_ptr), de
 760  86D5
 761  86D5                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 762  86D5 AF               xor  a
 763  86D6 32 86 A1         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 764  86D9 32 0E 9E         ld   (velocity_y), a
 765  86DC 32 15 A4         ld   (game_objective_completed), a
 766  86DF 3E 01            ld   a, 1

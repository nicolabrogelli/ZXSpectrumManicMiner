 330+ 6FA5              ; LoadPositionPlayeinRoom
 331+ 6FA5              ;
 332+ 6FA5              ; Inizializza la posizione del player (Willy) quando entra
 333+ 6FA5              ; in una nuova stanza.
 334+ 6FA5              ;
 335+ 6FA5              ; La posizione viene letta direttamente dai dati della stanza
 336+ 6FA5              ; (layout/metadata) a partire da room_ptr.
 337+ 6FA5              ;
 338+ 6FA5              ; Output:
 339+ 6FA5              ;   PlayerPos     = posizione iniziale (Y, X)
 340+ 6FA5              ;   PlayerPosOld  = copia della posizione iniziale
 341+ 6FA5              ;
 342+ 6FA5              ; Struttura dati stanza:
 343+ 6FA5              ;   OFFSET_POS_WILLY:
 344+ 6FA5              ;       +0 = X
 345+ 6FA5              ;       +1 = Y
 346+ 6FA5              ; -------------------------------------------------------------------
 347+ 6FA5              LoadPositionPlayeinRoom:
 348+ 6FA5                  ; ---------------------------------------------------------------
 349+ 6FA5                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 350+ 6FA5                  ; ---------------------------------------------------------------
 351+ 6FA5 2A EA AD         ld   hl, (room_ptr)
 352+ 6FA8 11 68 02         ld   de, OFFSET_POS_WILLY
 353+ 6FAB 19               add  hl, de
 354+ 6FAC
 355+ 6FAC                  ; Byte 0: Y * 2
 356+ 6FAC 7E               ld   a, (hl)
 357+ 6FAD CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 358+ 6FAF 57               ld   d, a                      ; D = PlayerY
 359+ 6FB0
 360+ 6FB0                  ; Byte 1: Anim frame
 361+ 6FB0 23               inc  hl
 362+ 6FB1 7E               ld   a, (hl)
 363+ 6FB2 E6 03            and  3                         ; Garanzia valore valido (0..3)
 364+ 6FB4 FE 03            cp   3
 365+ 6FB6 38 01            jr   c, .valid_anim
 366+ 6FB8 AF               xor  a
 367+ 6FB9              .valid_anim:
 368+ 6FB9 32 6F AA         ld   (body_state), a
 369+ 6FBC 32 72 AE         ld   (player_old_body), a
 370+ 6FBF
 371+ 6FBF                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 372+ 6FBF 23               inc  hl                        ; Byte 2 (Direction)
 373+ 6FC0 7E               ld   a, (hl)
 374+ 6FC1 E6 01            and  1
 375+ 6FC3 28 04            jr   z, .facing_right
 376+ 6FC5 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 377+ 6FC7 18 02            jr   .set_dir
 378+ 6FC9              .facing_right:
 379+ 6FC9 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 380+ 6FCB              .set_dir:
 381+ 6FCB 32 70 AA         ld   (direction), a
 382+ 6FCE 32 71 AE         ld   (player_old_dir), a
 383+ 6FD1
 384+ 6FD1                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 385+ 6FD1 23               inc  hl                        ; Byte 3 (Airborne)
 386+ 6FD2 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 387+ 6FD3 4E               ld   c, (hl)
 388+ 6FD4 23               inc  hl                        ; Byte 5 (AttrAddr High)
 389+ 6FD5 7E               ld   a, (hl)
 390+ 6FD6
 391+ 6FD6                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 392+ 6FD6 67               ld   h, a
 393+ 6FD7 69               ld   l, c
 394+ 6FD8 01 00 A4         ld   bc, -23552
 395+ 6FDB 09               add  hl, bc
 396+ 6FDC
 397+ 6FDC 7D               ld   a, l
 398+ 6FDD E6 1F            and  31
 399+ 6FDF 87               add  a, a                      ; *2
 400+ 6FE0 87               add  a, a                      ; *4
 401+ 6FE1 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 402+ 6FE2 4F               ld   c, a                      ; C = PlayerX
 403+ 6FE3 42               ld   b, d                      ; B = PlayerY
 404+ 6FE4
 405+ 6FE4                  ; Salva coordinate (C = X, B = Y)
 406+ 6FE4 ED 43 69 AA      ld   (PlayerPos), bc
 407+ 6FE8 ED 43 6B AA      ld   (PlayerPosOld), bc
 408+ 6FEC
 409+ 6FEC                  ; Reset completi di stato player e rendering
 410+ 6FEC AF               xor  a
 411+ 6FED 32 74 AA         ld   (sprite_shift), a
 412+ 6FF0 32 72 AA         ld   (collision_active), a
 413+ 6FF3 32 75 AE         ld   (willy_needs_redraw), a
 414+ 6FF6 32 7F AA         ld   (current_input_dir), a
 415+ 6FF9 32 94 AD         ld   (conveyor_caught), a
 416+ 6FFC 3E FF            ld   a, $FF
 417+ 6FFE 32 6F AE         ld   (player_drawn_pos), a
 418+ 7001 32 70 AE         ld   (player_drawn_pos+1), a

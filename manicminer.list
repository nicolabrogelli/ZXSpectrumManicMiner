 179+ 8714              ; Audio_PlayCollectSound
 180+ 8714              ;
 181+ 8714              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8714              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8714              ; -------------------------------------------------------------------
 184+ 8714              Audio_PlayCollectSound:
 185+ 8714 C5               push bc
 186+ 8715 D5               push de
 187+ 8716
 188+ 8716 06 78            ld   b, 120
 189+ 8718              .sound_loop:
 190+ 8718 3A DE E1         ld   a, (room_border_color)
 191+ 871B F6 10            or   $10               ; speaker ON
 192+ 871D D3 FE            out  ($fe), a
 193+ 871F
 194+ 871F 0E 3C            ld   c, 60
 195+ 8721              .d1:
 196+ 8721 0D               dec  c
 197+ 8722 20 FD            jr   nz, .d1
 198+ 8724
 199+ 8724 3A DE E1         ld   a, (room_border_color)
 200+ 8727 E6 EF            and  $ef              ; speaker OFF
 201+ 8729 D3 FE            out  ($fe), a
 202+ 872B

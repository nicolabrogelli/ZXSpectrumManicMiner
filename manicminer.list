1849+ 7D19              ; Verifica se c'è una cella Nasty (tipo 3) alle coordinate pixel (X, Y)
1850+ 7D19              ; Input: C = X, B = Y
1851+ 7D19              ; Output: Carry flag impostato se è Nasty, altrimenti resettato
1852+ 7D19              ; -------------------------------------------------------------------
1853+ 7D19              CheckNastyCell:
1854+ 7D19 E5               push hl
1855+ 7D1A D5               push de
1856+ 7D1B C5               push bc
1857+ 7D1C
1858+ 7D1C                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1859+ 7D1C 78               ld   a, b
1860+ 7D1D FE 80            cp   128
1861+ 7D1F 30 1B            jr   nc, .not_nasty
1862+ 7D21
1863+ 7D21                  ; 2. Calcola riga di layout: r = Y / 8
1864+ 7D21 CB 3F            srl  a
1865+ 7D23 CB 3F            srl  a
1866+ 7D25 CB 3F            srl  a                 ; A = r (0..15)
1867+ 7D27
1868+ 7D27                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1869+ 7D27 5F               ld   e, a              ; E = r
1870+ 7D28 79               ld   a, c
1871+ 7D29 CB 3F            srl  a
1872+ 7D2B CB 3F            srl  a
1873+ 7D2D CB 3F            srl  a                 ; A = c (0..31)
1874+ 7D2F 4F               ld   c, a              ; C = c
1875+ 7D30 7B               ld   a, e              ; A = r
1876+ 7D31
1877+ 7D31 CD BD 7A         call GetCellFromUnpacked ; A = cell type
1878+ 7D34
1879+ 7D34                  ; Controlla se è Nasty 1 (5) o Nasty 2 (6)
1880+ 7D34 FE 05            cp   5
1881+ 7D36 28 09            jr   z, .is_nasty
1882+ 7D38 FE 06            cp   6
1883+ 7D3A 28 05            jr   z, .is_nasty

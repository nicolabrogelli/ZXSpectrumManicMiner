  26+ 800C 21 4E 73         ld   hl, RoomsListTable
  27+ 800F ED 5B 85 A1      ld   de, (room_ptr)
  28+ 8013 06 04            ld   b, NUM_ROOMS
  29+ 8015 0E 00            ld   c, 0
  30+ 8017
  31+ 8017              .loop:
  32+ 8017 7E               ld   a, (hl)
  33+ 8018 BB               cp   e
  34+ 8019 20 06            jr   nz, .no_match
  35+ 801B 23               inc  hl
  36+ 801C 7E               ld   a, (hl)
  37+ 801D BA               cp   d
  38+ 801E 28 08            jr   z, .found
  39+ 8020 2B               dec  hl
  40+ 8021
  41+ 8021              .no_match:
  42+ 8021 23               inc  hl
  43+ 8022 23               inc  hl
  44+ 8023 0C               inc  c
  45+ 8024 10 F1            djnz .loop
  46+ 8026
  47+ 8026 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 8028
  49+ 8028              .found:

 293+ 84FC              ; DrawItemGraphic
 294+ 84FC              ;
 295+ 84FC              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 84FC              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 84FC              ;
 298+ 84FC              ; Input:
 299+ 84FC              ;   B = Riga attributi (0..23)
 300+ 84FC              ;   C = Colonna attributi (0..31)
 301+ 84FC              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 84FC              ;   E = Attributo colore
 303+ 84FC              ; -------------------------------------------------------------------
 304+ 84FC              DrawItemGraphic:
 305+ 84FC C5               push bc
 306+ 84FD D5               push de
 307+ 84FE E5               push hl
 308+ 84FF
 309+ 84FF                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 310+ 84FF 78               ld   a, b
 311+ 8500 E6 18            and  $18
 312+ 8502 C6 40            add  a, $40
 313+ 8504 57               ld   d, a                      ; Byte alto indirizzo video
 314+ 8505
 315+ 8505 78               ld   a, b
 316+ 8506 E6 07            and  7
 317+ 8508 87               add  a, a                      ; *2
 318+ 8509 87               add  a, a                      ; *4
 319+ 850A 87               add  a, a                      ; *8
 320+ 850B 87               add  a, a                      ; *16
 321+ 850C 87               add  a, a                      ; *32
 322+ 850D 81               add  a, c                      ; + Col
 323+ 850E 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 850F
 325+ 850F C5               push bc
 326+ 8510 06 08            ld   b, 8                      ; 8 scanline
 327+ 8512              .line_loop:
 328+ 8512 7E               ld   a, (hl)
 329+ 8513 12               ld   (de), a
 330+ 8514 14               inc  d
 331+ 8515 23               inc  hl
 332+ 8516 05               dec  b
 333+ 8517 20 F9            jr   nz, .line_loop
 334+ 8519 C1               pop  bc
 335+ 851A
 336+ 851A                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 337+ 851A 26 00            ld   h, 0
 338+ 851C 68               ld   l, b
 339+ 851D 29               add  hl, hl
 340+ 851E 29               add  hl, hl
 341+ 851F 29               add  hl, hl
 342+ 8520 29               add  hl, hl
 343+ 8521 29               add  hl, hl                    ; Row * 32
 344+ 8522 79               ld   a, c
 345+ 8523 85               add  a, l
 346+ 8524 6F               ld   l, a
 347+ 8525 30 01            jr   nc, .no_carry
 348+ 8527 24               inc  h

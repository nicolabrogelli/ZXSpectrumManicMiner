 106+ 7C87              ; Items_DrawRoom
 107+ 7C87              ;
 108+ 7C87              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 109+ 7C87              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 110+ 7C87              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 111+ 7C87              ;
 112+ 7C87              ; Record item nella stanza (5 byte):
 113+ 7C87              ;   +0 Color / Attributo
 114+ 7C87              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 115+ 7C87              ;   +2 Attr Address High
 116+ 7C87              ;   +3 Anim Mask (96)
 117+ 7C87              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 118+ 7C87              ; Fine lista: $FF
 119+ 7C87              ; -------------------------------------------------------------------
 120+ 7C87              Items_DrawRoom:
 121+ 7C87 E5               push hl
 122+ 7C88 D5               push de
 123+ 7C89 C5               push bc
 124+ 7C8A DD E5            push ix
 125+ 7C8C FD E5            push iy
 126+ 7C8E
 127+ 7C8E                  ; 1. Azzera items_grid (512 byte)
 128+ 7C8E 21 EC 8B         ld   hl, items_grid
 129+ 7C91 11 ED 8B         ld   de, items_grid + 1
 130+ 7C94 36 00            ld   (hl), 0
 131+ 7C96 01 FF 01         ld   bc, 511
 132+ 7C99 ED B0            ldir
 133+ 7C9B
 134+ 7C9B                  ; 2. Nessun item attivo inizialmente nella cache
 135+ 7C9B AF               xor  a
 136+ 7C9C 32 6B 91         ld   (num_room_items), a
 137+ 7C9F
 138+ 7C9F FD 21 1B 91      ld   iy, current_room_items
 139+ 7CA3
 140+ 7CA3                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)

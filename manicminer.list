   7+ 707D              ; Input_CheckCtrl
   8+ 707D              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 707D              ;
  10+ 707D              ; Output:
  11+ 707D              ;   D = bitmask tasti attivi:
  12+ 707D              ;       bit 0 → sinistra (O)
  13+ 707D              ;       bit 1 → destra   (P)
  14+ 707D              ;       bit 2 → salto    (Z)
  15+ 707D              ;
  16+ 707D              ; Effetti collaterali in RAM:

   7+ 83C3              ; -------------------------------------------------------------------
   8+ 83C3              ; Audio_UpdateJumpSound
   9+ 83C3              ;
  10+ 83C3              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 83C3              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 83C3              ; -------------------------------------------------------------------
  13+ 83C3              Audio_UpdateJumpSound:
  14+ 83C3 F5               push af
  15+ 83C4 C5               push bc
  16+ 83C5 D5               push de
  17+ 83C6 E5               push hl
  18+ 83C7
  19+ 83C7                  ; Controlla se il suono è attivo (note < 18)
  20+ 83C7 3A E7 B8         ld   a, (Audio_jump_sound_note)
  21+ 83CA FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 83CC 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 83CE
  24+ 83CE                  ; Carica la nota corrente da suonare
  25+ 83CE 5F               ld   e, a
  26+ 83CF 16 00            ld   d, 0
  27+ 83D1 21 FD 83         ld   hl, Audio_JumpSoundDelays
  28+ 83D4 19               add  hl, de
  29+ 83D5 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 83D6 57               ld   d, a                      ; D = delay della nota
  31+ 83D7
  32+ 83D7                  ; Suona la nota: 15 cicli
  33+ 83D7 06 0F            ld   b, 15
  34+ 83D9              .note_loop:
  35+ 83D9                  ; Speaker ON
  36+ 83D9 3A D7 B2         ld   a, (room_border_color)
  37+ 83DC F6 10            or   $10
  38+ 83DE D3 FE            out  ($fe), a
  39+ 83E0 4A               ld   c, d
  40+ 83E1              .d1:
  41+ 83E1 0D               dec  c
  42+ 83E2 20 FD            jr   nz, .d1
  43+ 83E4
  44+ 83E4                  ; Speaker OFF
  45+ 83E4 3A D7 B2         ld   a, (room_border_color)
  46+ 83E7 E6 EF            and  $ef
  47+ 83E9 D3 FE            out  ($fe), a
  48+ 83EB 4A               ld   c, d
  49+ 83EC              .d2:
  50+ 83EC 0D               dec  c
  51+ 83ED 20 FD            jr   nz, .d2
  52+ 83EF
  53+ 83EF 10 E8            djnz .note_loop
  54+ 83F1
  55+ 83F1                  ; Passa alla nota successiva
  56+ 83F1 3A E7 B8         ld   a, (Audio_jump_sound_note)
  57+ 83F4 3C               inc  a
  58+ 83F5 32 E7 B8         ld   (Audio_jump_sound_note), a
  59+ 83F8
  60+ 83F8              .done:
  61+ 83F8 E1               pop  hl
  62+ 83F9 D1               pop  de
  63+ 83FA C1               pop  bc
  64+ 83FB F1               pop  af
  65+ 83FC C9               ret

1900+ 7D46              ; Controlla la collisione di Willy con le celle Nasty (tipo 3)
1901+ 7D46              ; Controlla 6 punti strategici della bounding box di Willy (16x8 pixel)
1902+ 7D46              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1903+ 7D46              ; -------------------------------------------------------------------
1904+ 7D46              Phys_CheckNastyCollision:
1905+ 7D46                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
1906+ 7D46 3A B0 EF         ld   a, (willy_safety_timer)
1907+ 7D49 B7               or   a
1908+ 7D4A C0               ret  nz                     ; Nessuna collisione (Carry = 0)
1909+ 7D4B
1910+ 7D4B C5               push bc
1911+ 7D4C
1912+ 7D4C ED 4B A3 EB      ld   bc, (PlayerPos)   ; B = Y, C = X
1913+ 7D50
1914+ 7D50                  ; Punto 1: Top-Left (X, Y)
1915+ 7D50 CD 19 7D         call CheckNastyCell
1916+ 7D53 38 38            jr   c, .collision
1917+ 7D55
1918+ 7D55                  ; Punto 2: Top-Right (X + 7, Y)
1919+ 7D55 79               ld   a, c
1920+ 7D56 C6 07            add  a, 7
1921+ 7D58 4F               ld   c, a
1922+ 7D59 CD 19 7D         call CheckNastyCell
1923+ 7D5C 38 2F            jr   c, .collision
1924+ 7D5E
1925+ 7D5E                  ; Punto 3: Mid-Left (X, Y + 7)
1926+ 7D5E ED 4B A3 EB      ld   bc, (PlayerPos)
1927+ 7D62 78               ld   a, b
1928+ 7D63 C6 07            add  a, 7
1929+ 7D65 47               ld   b, a
1930+ 7D66 CD 19 7D         call CheckNastyCell
1931+ 7D69 38 22            jr   c, .collision
1932+ 7D6B
1933+ 7D6B                  ; Punto 4: Mid-Right (X + 7, Y + 7)
1934+ 7D6B 79               ld   a, c
1935+ 7D6C C6 07            add  a, 7
1936+ 7D6E 4F               ld   c, a
1937+ 7D6F CD 19 7D         call CheckNastyCell
1938+ 7D72 38 19            jr   c, .collision
1939+ 7D74
1940+ 7D74                  ; Punto 5: Bottom-Left (X, Y + 15)
1941+ 7D74 ED 4B A3 EB      ld   bc, (PlayerPos)
1942+ 7D78 78               ld   a, b
1943+ 7D79 C6 0F            add  a, 15
1944+ 7D7B 47               ld   b, a
1945+ 7D7C CD 19 7D         call CheckNastyCell
1946+ 7D7F 38 0C            jr   c, .collision
1947+ 7D81
1948+ 7D81                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1949+ 7D81 79               ld   a, c
1950+ 7D82 C6 07            add  a, 7
1951+ 7D84 4F               ld   c, a
1952+ 7D85 CD 19 7D         call CheckNastyCell
1953+ 7D88 38 03            jr   c, .collision
1954+ 7D8A
1955+ 7D8A C1               pop  bc
1956+ 7D8B B7               or   a                 ; Clear carry
1957+ 7D8C C9               ret

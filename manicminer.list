 681+ 6098 3A 93 97         ld   a, (willy_safety_timer)
 682+ 609B B7               or   a
 683+ 609C 20 2A            jr   nz, .player_moved
 684+ 609E
 685+ 609E                  ; 1. Controlla se la posizione o l'animazione sono cambiate
 686+ 609E ED 4B 89 93      ld   bc, (PlayerPos)            ; C = PlayerX, B = PlayerY
 687+ 60A2 ED 5B 8E 97      ld   de, (player_drawn_pos)     ; E = Drawn X, D = Drawn Y
 688+ 60A6 78               ld   a, b
 689+ 60A7 BA               cp   d
 690+ 60A8 20 1E            jr   nz, .player_moved
 691+ 60AA 79               ld   a, c
 692+ 60AB BB               cp   e
 693+ 60AC 20 1A            jr   nz, .player_moved
 694+ 60AE
 695+ 60AE 3A 90 93         ld   a, (direction)

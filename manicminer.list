 180+ 835F E5               push hl
 181+ 8360 DD E1            pop  ix                        ; IX = bitmap item
 182+ 8362
 183+ 8362                  ; 4. HL = Inizio lista item nella stanza
 184+ 8362 2A 1E E4         ld   hl, (room_ptr)
 185+ 8365 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8368 19               add  hl, de
 187+ 8369
 188+ 8369              .loop:
 189+ 8369 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 836A FE FF            cp   $FF
 191+ 836C 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 836E B7               or   a
 193+ 836F 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 8371
 195+ 8371 5F               ld   e, a                      ; E = Color
 196+ 8372 23               inc  hl
 197+ 8373 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8374 23               inc  hl

  12+ 857B              ; DetermineCurrentRoomID
  13+ 857B              ;
  14+ 857B              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 857B              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 857B              ;
  17+ 857B              ; Output:
  18+ 857B              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 857B              ;   (current_room) = A
  20+ 857B              ; -------------------------------------------------------------------
  21+ 857B              DetermineCurrentRoomID:
  22+ 857B E5               push hl

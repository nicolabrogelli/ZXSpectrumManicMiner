 283+ 7DE9              ; -------------------------------------------------------------------
 284+ 7DE9              ; DrawItemGraphic
 285+ 7DE9              ;
 286+ 7DE9              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 287+ 7DE9              ; utilizzando una bitmap di 8 byte e un attributo colore.
 288+ 7DE9              ;
 289+ 7DE9              ; Input:
 290+ 7DE9              ;   B = Riga attributi (0..23)
 291+ 7DE9              ;   C = Colonna attributi (0..31)
 292+ 7DE9              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 293+ 7DE9              ;   E = Attributo colore
 294+ 7DE9              ; -------------------------------------------------------------------
 295+ 7DE9              DrawItemGraphic:
 296+ 7DE9 C5               push bc
 297+ 7DEA D5               push de
 298+ 7DEB E5               push hl
 299+ 7DEC
 300+ 7DEC                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 301+ 7DEC 78               ld   a, b
 302+ 7DED E6 18            and  $18
 303+ 7DEF C6 40            add  a, $40
 304+ 7DF1 57               ld   d, a                      ; Byte alto indirizzo video
 305+ 7DF2
 306+ 7DF2 78               ld   a, b
 307+ 7DF3 E6 07            and  7
 308+ 7DF5 87               add  a, a                      ; *2
 309+ 7DF6 87               add  a, a                      ; *4
 310+ 7DF7 87               add  a, a                      ; *8
 311+ 7DF8 87               add  a, a                      ; *16
 312+ 7DF9 87               add  a, a                      ; *32
 313+ 7DFA 81               add  a, c                      ; + Col
 314+ 7DFB 5F               ld   e, a                      ; Byte basso indirizzo video
 315+ 7DFC
 316+ 7DFC C5               push bc
 317+ 7DFD 06 08            ld   b, 8                      ; 8 scanline
 318+ 7DFF              .line_loop:
 319+ 7DFF 7E               ld   a, (hl)
 320+ 7E00 12               ld   (de), a
 321+ 7E01 14               inc  d
 322+ 7E02 23               inc  hl
 323+ 7E03 05               dec  b
 324+ 7E04 20 F9            jr   nz, .line_loop
 325+ 7E06 C1               pop  bc
 326+ 7E07
 327+ 7E07                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 328+ 7E07 26 00            ld   h, 0
 329+ 7E09 68               ld   l, b
 330+ 7E0A 29               add  hl, hl
 331+ 7E0B 29               add  hl, hl
 332+ 7E0C 29               add  hl, hl
 333+ 7E0D 29               add  hl, hl
 334+ 7E0E 29               add  hl, hl                    ; Row * 32
 335+ 7E0F 79               ld   a, c
 336+ 7E10 85               add  a, l
 337+ 7E11 6F               ld   l, a
 338+ 7E12 30 01            jr   nc, .no_carry
 339+ 7E14 24               inc  h
 340+ 7E15              .no_carry:
 341+ 7E15 11 00 58         ld   de, $5800
 342+ 7E18 19               add  hl, de
 343+ 7E19
 344+ 7E19 C1               pop  bc                        ; Recupera HL originale
 345+ 7E1A D1               pop  de                        ; Recupera DE originale (E = colore)
 346+ 7E1B 7B               ld   a, e
 347+ 7E1C 77               ld   (hl), a                   ; Scrive l'attributo colore
 348+ 7E1D
 349+ 7E1D C5               push bc
 350+ 7E1E E1               pop  hl
 351+ 7E1F C1               pop  bc
 352+ 7E20 C9               ret

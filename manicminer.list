   6+ 7048              ; -------------------------------------------------------------------
   7+ 7048              ; Input_CheckCtrl
   8+ 7048              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 7048              ;
  10+ 7048              ; Output:
  11+ 7048              ;   D = bitmask tasti attivi:
  12+ 7048              ;       bit 0 → sinistra (O)
  13+ 7048              ;       bit 1 → destra   (P)
  14+ 7048              ;       bit 2 → salto    (Z)
  15+ 7048              ;
  16+ 7048              ; Effetti collaterali in RAM:
  17+ 7048              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 7048              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 7048              ;   (jump_prev)     → debounce tasto salto
  20+ 7048              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 7048              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 7048              ; -------------------------------------------------------------------
  23+ 7048
  24+ 7048              Input_CheckCtrl:
  25+ 7048 AF               xor  a
  26+ 7049 32 64 9E         ld   (current_input_dir), a
  27+ 704C
  28+ 704C                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 704C                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 704C                  ;
  31+ 704C                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 704C                  ; Se bit 0 = 0, Q è premuto.
  33+ 704C
  34+ 704C 01 FE FB         ld   bc, $fbfe
  35+ 704F ED 78            in   a, (c)
  36+ 7051 CB 47            bit  0, a
  37+ 7053 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 7055
  39+ 7055                  ; Q è premuto: debounce tramite (q_prev).
  40+ 7055                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 7055 3A 65 9E         ld   a, (q_prev)
  42+ 7058 B7               or   a
  43+ 7059 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 705B
  45+ 705B                  ; ── Primo frame di pressione di Q ──
  46+ 705B 3E 01            ld   a, 1

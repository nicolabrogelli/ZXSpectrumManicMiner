  75+ 7EC0 56               ld   d, (hl)
  76+ 7EC1 23               inc  hl
  77+ 7EC2 E5               push hl
  78+ 7EC3
  79+ 7EC3                  ; DE = room_ptr
  80+ 7EC3 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7EC6 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7EC7
  83+ 7EC7              .item_loop:
  84+ 7EC7 7E               ld   a, (hl)
  85+ 7EC8 FE FF            cp   $FF
  86+ 7ECA 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 7ECC 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 7ECD 23               inc  hl                        ; +2 (Attr Address High)
  89+ 7ECE 23               inc  hl                        ; +3 (Anim mask)
  90+ 7ECF 23               inc  hl                        ; +4 (Collected flag)
  91+ 7ED0 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 7ED2 23               inc  hl                        ; Avanza al prossimo item
  93+ 7ED3 18 F2            jr   .item_loop
  94+ 7ED5
  95+ 7ED5              .next_room:
  96+ 7ED5 E1               pop  hl
  97+ 7ED6 C1               pop  bc
  98+ 7ED7 10 E4            djnz .room_loop
  99+ 7ED9
 100+ 7ED9 C1               pop  bc
 101+ 7EDA D1               pop  de
 102+ 7EDB E1               pop  hl
 103+ 7EDC C9               ret

 580  81AD 28 ED            jr   z, .wait_keys_release
 581  81AF
 582  81AF                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 583  81AF 01 FE BF         ld   bc, $bffe
 584  81B2 ED 78            in   a, (c)
 585  81B4 CB 47            bit  0, a
 586  81B6 28 E4            jr   z, .wait_keys_release

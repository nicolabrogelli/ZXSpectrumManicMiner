  92+ 7D10
  93+ 7D10                  ; Col = Offset & 31 -> StartX = Col * 8
  94+ 7D10 7D               ld   a, l
  95+ 7D11 E6 1F            and  31
  96+ 7D13 87               add  a, a
  96+ 7D14 87             add a, a
  96+ 7D15 87             add a, a
  97+ 7D16 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7D19
  99+ 7D19                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7D19 CB 3C            srl  h
 100+ 7D1B CB 1D          rr l
 101+ 7D1D CB 3C            srl  h
 101+ 7D1F CB 1D          rr l
 102+ 7D21 CB 3C            srl  h
 102+ 7D23 CB 1D          rr l

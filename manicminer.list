 290  8A6A              ; -------------------------------------------------------------------
 291  8A6A              ; ShowTitleScreen
 292  8A6A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 293  8A6A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 294  8A6A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 295  8A6A              ; -------------------------------------------------------------------
 296  8A6A              ShowTitleScreen:
 297  8A6A                  ; 1. Disegna la schermata iniziale
 298  8A6A CD 7A 64         call Gfx_DrawTitleScreen
 299  8A6D
 300  8A6D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 301  8A6D              .wait_title_enter_release:
 302  8A6D 76               halt
 303  8A6E 3E BF            ld   a, $bf
 304  8A70 DB FE            in   a, ($fe)
 305  8A72 1F               rra
 306  8A73 30 F8            jr   nc, .wait_title_enter_release
 307  8A75
 308  8A75                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 309  8A75 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 310  8A77              .title_loop:
 311  8A77 76               halt
 312  8A78
 313  8A78                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 314  8A78 0C               inc  c
 315  8A79 79               ld   a, c
 316  8A7A CB 3F            srl  a
 317  8A7C CB 3F            srl  a
 318  8A7E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 319  8A80 E6 07            and  7
 320  8A82 5F               ld   e, a
 321  8A83 16 00            ld   d, 0
 322  8A85 21 72 64         ld   hl, title_color_table
 323  8A88 19               add  hl, de
 324  8A89 7E               ld   a, (hl)               ; A = nuovo colore
 325  8A8A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 326  8A8D 06 20            ld   b, 32
 327  8A8F              .color_title_loop:
 328  8A8F 77               ld   (hl), a
 329  8A90 23               inc  hl
 330  8A91 10 FC            djnz .color_title_loop
 331  8A93
 332  8A93                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 333  8A93 3E BF            ld   a, $bf
 334  8A95 DB FE            in   a, ($fe)
 335  8A97 1F               rra
 336  8A98 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 337  8A9A
 338  8A9A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 339  8A9A              .wait_title_enter_release_after:
 340  8A9A 76               halt
 341  8A9B 3E BF            ld   a, $bf
 342  8A9D DB FE            in   a, ($fe)
 343  8A9F 1F               rra
 344  8AA0 30 F8            jr   nc, .wait_title_enter_release_after
 345  8AA2
 346  8AA2                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 347  8AA2 AF               xor  a
 348  8AA3 D3 FE            out  ($fe), a              ; Bordo a nero
 349  8AA5 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 350  8AA8

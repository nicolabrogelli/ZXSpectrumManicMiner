 430+ 7CC2 C2 0C 7D         jp   nz, .vertical
 431+ 7CC5
 432+ 7CC5              .horizontal:
 433+ 7CC5 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7CC8 FE 01            cp   1
 435+ 7CCA 20 20            jr   nz, .horiz_right
 436+ 7CCC
 437+ 7CCC              .horiz_left:
 438+ 7CCC DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7CCF D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7CD1 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7CD4 28 08            jr   z, .h_rev_right
 442+ 7CD6 38 06            jr   c, .h_rev_right
 443+ 7CD8 DD 77 02         ld   (ix+2), a
 444+ 7CDB C3 50 7D         jp   .next
 445+ 7CDE
 446+ 7CDE              .h_rev_right:
 447+ 7CDE DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7CE1 DD 77 02         ld   (ix+2), a
 449+ 7CE4 3E 02            ld   a, 2
 450+ 7CE6 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7CE9 C3 50 7D         jp   .next
 452+ 7CEC
 453+ 7CEC              .horiz_right:
 454+ 7CEC DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7CEF C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7CF1 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7CF4 28 08            jr   z, .h_rev_left
 458+ 7CF6 30 06            jr   nc, .h_rev_left
 459+ 7CF8 DD 77 02         ld   (ix+2), a
 460+ 7CFB C3 50 7D         jp   .next
 461+ 7CFE
 462+ 7CFE              .h_rev_left:

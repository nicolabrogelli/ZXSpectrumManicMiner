 660+ 82DC              ; Score_CheckAndUpdateHighScore
 661+ 82DC              ; Se player_score > high_score, copia player_score in high_score.
 662+ 82DC              ; -------------------------------------------------------------------
 663+ 82DC              Score_CheckAndUpdateHighScore:
 664+ 82DC                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 82DC                  ; Byte 2:
 666+ 82DC 3A 60 A4         ld   a, (player_score + 2)
 667+ 82DF 47               ld   b, a
 668+ 82E0 3A 63 A4         ld   a, (high_score + 2)
 669+ 82E3 B8               cp   b
 670+ 82E4 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 82E6 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 82E8
 673+ 82E8                  ; Byte 1:
 674+ 82E8 3A 5F A4         ld   a, (player_score + 1)
 675+ 82EB 47               ld   b, a
 676+ 82EC 3A 62 A4         ld   a, (high_score + 1)
 677+ 82EF B8               cp   b
 678+ 82F0 38 0C            jr   c, .new_high_score
 679+ 82F2 20 1C            jr   nz, .done_check
 680+ 82F4
 681+ 82F4                  ; Byte 0:

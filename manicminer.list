  89+ F0C9 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ F0CC 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)

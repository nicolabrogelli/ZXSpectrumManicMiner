  74+ 8327 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8327 ~            ; Viene chiamata a ogni frame.
  76+ 8327 ~            ; -------------------------------------------------------------------
  77+ 8327 ~            Audio_UpdateMusic:
  78+ 8327 ~                push af
  79+ 8327 ~                push bc
  80+ 8327 ~                push de
  81+ 8327 ~                push hl
  82+ 8327 ~
  83+ 8327 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8327 ~                ld   a, (Audio_jump_sound_note)
  85+ 8327 ~                cp   18
  86+ 8327 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8327 ~
  88+ 8327 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8327 ~                ld   a, (Audio_music_frame_counter)
  90+ 8327 ~                dec  a
  91+ 8327 ~                ld   (Audio_music_frame_counter), a
  92+ 8327 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8327 ~
  94+ 8327 ~                ; Altrimenti carica la nota successiva
  95+ 8327 ~                ld   a, (Audio_music_note_idx)
  96+ 8327 ~                inc  a
  97+ 8327 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8327 ~                jr   c, .no_wrap
  99+ 8327 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8327 ~            .no_wrap:
 101+ 8327 ~                ld   (Audio_music_note_idx), a
 102+ 8327 ~
 103+ 8327 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8327 ~                ld   e, a
 105+ 8327 ~                ld   d, 0
 106+ 8327 ~                ld   hl, Audio_MusicSheet
 107+ 8327 ~                add  hl, de
 108+ 8327 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8327 ~
 110+ 8327 ~                ; Leggi durata (secondo byte)
 111+ 8327 ~                inc  hl
 112+ 8327 ~                ld   a, (hl)
 113+ 8327 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8327 ~                jr   nz, .dur_ok
 115+ 8327 ~                ld   a, 1
 116+ 8327 ~            .dur_ok:
 117+ 8327 ~                ld   (Audio_music_frame_counter), a
 118+ 8327 ~
 119+ 8327 ~            .play_current_note:
 120+ 8327 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8327 ~                ld   a, (Audio_music_note_idx)
 122+ 8327 ~                ld   e, a
 123+ 8327 ~                ld   d, 0
 124+ 8327 ~                ld   hl, Audio_MusicSheet
 125+ 8327 ~                add  hl, de
 126+ 8327 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8327 ~                ld   a, (hl)                  ; A = delay
 128+ 8327 ~                or   a
 129+ 8327 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8327 ~
 131+ 8327 ~                ; Suona la nota: 2 cicli
 132+ 8327 ~                ld   d, a                     ; D = delay
 133+ 8327 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8327 ~            .note_loop:
 135+ 8327 ~                ; Speaker ON
 136+ 8327 ~                ld   a, (room_border_color)
 137+ 8327 ~                or   $10
 138+ 8327 ~                out  ($fe), a
 139+ 8327 ~                ld   c, d
 140+ 8327 ~            .d1:
 141+ 8327 ~                push af
 142+ 8327 ~                pop  af
 143+ 8327 ~                dec  c
 144+ 8327 ~                jr   nz, .d1
 145+ 8327 ~
 146+ 8327 ~                ; Speaker OFF
 147+ 8327 ~                ld   a, (room_border_color)
 148+ 8327 ~                and  $ef
 149+ 8327 ~                out  ($fe), a
 150+ 8327 ~                ld   c, d
 151+ 8327 ~            .d2:
 152+ 8327 ~                push af
 153+ 8327 ~                pop  af
 154+ 8327 ~                dec  c
 155+ 8327 ~                jr   nz, .d2
 156+ 8327 ~
 157+ 8327 ~                djnz .note_loop
 158+ 8327 ~
 159+ 8327 ~            .done:
 160+ 8327 ~                pop  hl
 161+ 8327 ~                pop  de
 162+ 8327 ~                pop  bc
 163+ 8327 ~                pop  af
 164+ 8327 ~                ret
 165+ 8327 ~
 166+ 8327 ~            Audio_MusicSheet:
 167+ 8327 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8327 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8327 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8327 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8327 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8327 ~                db 90, 10, 107, 20, 68, 65
 173+ 8327                  ELSE
 174+ 8327              Audio_UpdateMusic:
 175+ 8327 C9               ret
 176+ 8328                  ENDIF

 687  8395 30 4D            jr   nc, .no_victory
 688  8397
 689  8397                  ; 2. Willy collide con il portale (16x16)?
 690  8397 2A F1 92         ld   hl, (room_ptr)
 691  839A 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 692  839D 19               add  hl, de
 693  839E 4E               ld   c, (hl)
 694  839F 23               inc  hl
 695  83A0 46               ld   b, (hl)                   ; BC = AttrAddr
 696  83A1
 697  83A1                  ; Offset = BC - 23552
 698  83A1 60               ld   h, b
 699  83A2 69               ld   l, c
 700  83A3 01 00 A4         ld   bc, -23552
 701  83A6 09               add  hl, bc
 702  83A7
 703  83A7                  ; PortalX = (Offset & 31) * 8, PortalY = (Offset / 32) * 8
 704  83A7 7D               ld   a, l
 705  83A8 E6 1F            and  31
 706  83AA 87               add  a, a
 706  83AB 87             add a, a
 706  83AC 87             add a, a
 707  83AD 5F               ld   e, a                      ; E = PortalX
 708  83AE
 709  83AE CB 3C            srl  h
 709  83B0 CB 1D          rr l
 710  83B2 CB 3C            srl  h
 710  83B4 CB 1D          rr l
 711  83B6 CB 3C            srl  h
 711  83B8 CB 1D          rr l
 712  83BA CB 3C            srl  h
 712  83BC CB 1D          rr l
 713  83BE CB 3C            srl  h
 713  83C0 CB 1D          rr l
 714  83C2 7D               ld   a, l
 715  83C3 87               add  a, a
 715  83C4 87             add a, a
 715  83C5 87             add a, a
 716  83C6 57               ld   d, a                      ; D = PortalY
 717  83C7
 718  83C7                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 719  83C7 ED 4B 71 8F      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 720  83CB
 721  83CB                  ; |WillyX - PortalX| < 12
 722  83CB 7B               ld   a, e
 723  83CC 91               sub  c
 724  83CD 30 02            jr   nc, .x_diff_pos
 725  83CF ED 44            neg
 726  83D1              .x_diff_pos:
 727  83D1 FE 0C            cp   12
 728  83D3 30 0F            jr   nc, .no_victory
 729  83D5
 730  83D5                  ; |WillyY - PortalY| < 14

 737  8B58 38 49            jr   c, .collision_detected
 738  8B5A
 739  8B5A                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8B5A 3A 6F ED         ld   a, (conveyor_len)
 741  8B5D B7               or   a
 742  8B5E 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8B60
 744  8B60                  ; B = WillyY, C = WillyX
 745  8B60 ED 4B 47 EA      ld   bc, (PlayerPos)
 746  8B64
 747  8B64                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8B64 3A 70 ED         ld   a, (conveyor_row)
 749  8B67 87               add  a, a                  ; *2
 750  8B68 87               add  a, a                  ; *4
 751  8B69 87               add  a, a                  ; *8
 752  8B6A 5F               ld   e, a                  ; E = ConveyorTop
 753  8B6B C6 07            add  a, 7
 754  8B6D 57               ld   d, a                  ; D = ConveyorBottom
 755  8B6E
 756  8B6E                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8B6E 78               ld   a, b                  ; WillyTop
 758  8B6F BA               cp   d
 759  8B70 28 04            jr   z, .y_overlap
 760  8B72 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8B74 18 32            jr   .no_conv_collision
 762  8B76
 763  8B76              .y_overlap:
 764  8B76 C6 0F            add  a, 15                 ; WillyBottom
 765  8B78 BB               cp   e
 766  8B79 28 04            jr   z, .x_check
 767  8B7B 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8B7D 18 29            jr   .no_conv_collision
 769  8B7F

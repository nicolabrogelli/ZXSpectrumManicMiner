 298+ 7D69 11 00 58         ld   de, $5800
 299+ 7D6C 19               add  hl, de
 300+ 7D6D
 301+ 7D6D C1               pop  bc                        ; Recupera HL originale
 302+ 7D6E D1               pop  de                        ; Recupera DE originale (E = colore)
 303+ 7D6F 7B               ld   a, e
 304+ 7D70 77               ld   (hl), a                   ; Scrive l'attributo colore
 305+ 7D71
 306+ 7D71 C5               push bc
 307+ 7D72 E1               pop  hl
 308+ 7D73 C1               pop  bc
 309+ 7D74 C9               ret

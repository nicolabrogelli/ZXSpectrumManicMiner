1187+ 7888              ; -------------------------------------------------------------------
1188+ 7888              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1189+ 7888              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1190+ 7888              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1191+ 7888              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1192+ 7888              ; -------------------------------------------------------------------
1193+ 7888              UnpackRoomLayout:
1194+ 7888 E5               push hl
1195+ 7889 D5               push de
1196+ 788A C5               push bc
1197+ 788B DD E5            push ix
1198+ 788D
1199+ 788D DD 2A 89 99      ld   ix, (room_ptr)
1200+ 7891 11 20 02         ld   de, OFFSET_TILES
1201+ 7894 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1202+ 7896
1203+ 7896 2A 89 99         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 7899 11 2F 97         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 789C 01 00 02         ld   bc, 512               ; 512 celle
1206+ 789F
1207+ 789F              .byte_loop:
1208+ 789F 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1209+ 78A0 23               inc  hl
1210+ 78A1
1211+ 78A1                  ; Confronta con le 8 definizioni di tile:
1212+ 78A1 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 78A4 28 23            jr   z, .is_bg
1214+ 78A6 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 78A9 28 29            jr   z, .is_wall
1216+ 78AB DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 78AE 28 1C            jr   z, .is_floor
1218+ 78B0 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 78B3 28 1B            jr   z, .is_crumbling
1220+ 78B5 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 78B8 28 1E            jr   z, .is_conveyor
1222+ 78BA DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 78BD 28 1D            jr   z, .is_nasty1
1224+ 78BF DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 78C2 28 1C            jr   z, .is_nasty2
1226+ 78C4 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 78C7 28 1B            jr   z, .is_extra
1228+ 78C9
1229+ 78C9              .is_bg:
1230+ 78C9                  ; Default: Tile 0 (Background)
1231+ 78C9 AF               xor  a

 705+ 60C0                  ; Willy non si è mosso. Ma se un nemico lo ha sovrascritto, ridisegnalo senza prima cancellarlo!
 706+ 60C0 3A 94 97         ld   a, (willy_needs_redraw)
 707+ 60C3 B7               or   a
 708+ 60C4 20 22            jr   nz, .redraw_overlay_only
 709+ 60C6 18 48            jr   .player_no_change
 710+ 60C8
 711+ 60C8              .player_moved:
 712+ 60C8                  ; 2. Cancella lo sprite dalla posizione precedentemente disegnata solo se Willy si è mosso
 713+ 60C8 3A 8F 97         ld   a, (player_drawn_pos+1)
 714+ 60CB FE FF            cp   $FF
 715+ 60CD 28 19            jr   z, .redraw_overlay_only
 716+ 60CF
 717+ 60CF ED 4B 8E 97      ld   bc, (player_drawn_pos)

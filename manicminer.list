2047+ 7DF8 78               ld   a, b
2048+ 7DF9 C6 10            add  a, 16
2049+ 7DFB CB 3F            srl  a
2049+ 7DFD CB 3F          srl  a
2049+ 7DFF CB 3F          srl  a
2050+ 7E01 47               ld   b, a                  ; B = Row
2051+ 7E02
2052+ 7E02 79               ld   a, c
2053+ 7E03 C6 07            add  a, 7

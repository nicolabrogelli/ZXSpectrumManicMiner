 736+ 60F5
 737+ 60F5              .do_print:
 738+ 60F5                  ; 3. Disegna il player nella nuova posizione
 739+ 60F5 CD 33 60         call Gfx_PrintPlayer
 740+ 60F8
 741+ 60F8              .skip_print_blink:
 742+ 60F8                  ; 4. Registra lo stato disegnato a schermo

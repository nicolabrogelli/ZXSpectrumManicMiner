 121+ 807D FE FF            cp   $FF
 122+ 807F 28 09            jr   z, .done                  ; $FF = fine lista item della stanza
 123+ 8081 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 8082 23               inc  hl                        ; +2 (Attr Address High)
 125+ 8083 23               inc  hl                        ; +3 (Anim mask)
 126+ 8084 23               inc  hl                        ; +4 (Collected flag)
 127+ 8085 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 8087 23               inc  hl                        ; Avanza al prossimo item
 129+ 8088 18 F2            jr   .item_loop
 130+ 808A
 131+ 808A              .done:

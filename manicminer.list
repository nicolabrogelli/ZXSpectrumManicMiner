 780  83FC              ; CheckWillyConveyorCollision
 781  83FC              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 782  83FC              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 783  83FC              ; -------------------------------------------------------------------
 784  83FC              CheckWillyConveyorCollision:
 785  83FC C5               push bc
 786  83FD D5               push de
 787  83FE E5               push hl
 788  83FF
 789  83FF                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 790  83FF CD 27 75         call CheckWillyOnConveyor
 791  8402 38 49            jr   c, .collision_detected
 792  8404
 793  8404                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 794  8404 3A 99 92         ld   a, (conveyor_len)
 795  8407 B7               or   a
 796  8408 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 797  840A
 798  840A                  ; B = WillyY, C = WillyX
 799  840A ED 4B 71 8F      ld   bc, (PlayerPos)
 800  840E
 801  840E                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 802  840E 3A 9A 92         ld   a, (conveyor_row)
 803  8411 87               add  a, a                  ; *2
 804  8412 87               add  a, a                  ; *4
 805  8413 87               add  a, a                  ; *8
 806  8414 5F               ld   e, a                  ; E = ConveyorTop
 807  8415 C6 07            add  a, 7
 808  8417 57               ld   d, a                  ; D = ConveyorBottom
 809  8418
 810  8418                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 811  8418 78               ld   a, b                  ; WillyTop
 812  8419 BA               cp   d
 813  841A 28 04            jr   z, .y_overlap
 814  841C 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 815  841E 18 32            jr   .no_conv_collision
 816  8420
 817  8420              .y_overlap:
 818  8420 C6 0F            add  a, 15                 ; WillyBottom
 819  8422 BB               cp   e
 820  8423 28 04            jr   z, .x_check
 821  8425 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 822  8427 18 29            jr   .no_conv_collision
 823  8429
 824  8429              .x_check:
 825  8429                  ; ConveyorLeft = conveyor_col * 8

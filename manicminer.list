1075+ 784B              ; -------------------------------------------------------------------
1076+ 784B              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1077+ 784B              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1078+ 784B              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1079+ 784B              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1080+ 784B              ; -------------------------------------------------------------------
1081+ 784B              UnpackRoomLayout:
1082+ 784B E5               push hl
1083+ 784C D5               push de
1084+ 784D C5               push bc
1085+ 784E DD E5            push ix
1086+ 7850
1087+ 7850 DD 2A 93 E5      ld   ix, (room_ptr)
1088+ 7854 11 20 02         ld   de, OFFSET_TILES
1089+ 7857 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1090+ 7859
1091+ 7859 2A 93 E5         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1092+ 785C 11 38 E3         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1093+ 785F 01 00 02         ld   bc, 512               ; 512 celle
1094+ 7862
1095+ 7862              .byte_loop:
1096+ 7862 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1097+ 7863 23               inc  hl
1098+ 7864
1099+ 7864                  ; Confronta con le 8 definizioni di tile:
1100+ 7864 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1101+ 7867 28 23            jr   z, .is_bg
1102+ 7869 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1103+ 786C 28 29            jr   z, .is_wall
1104+ 786E DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1105+ 7871 28 1C            jr   z, .is_floor
1106+ 7873 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1107+ 7876 28 1B            jr   z, .is_crumbling
1108+ 7878 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1109+ 787B 28 1E            jr   z, .is_conveyor
1110+ 787D DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1111+ 7880 28 1D            jr   z, .is_nasty1
1112+ 7882 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1113+ 7885 28 1C            jr   z, .is_nasty2
1114+ 7887 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1115+ 788A 28 1B            jr   z, .is_extra
1116+ 788C
1117+ 788C              .is_bg:
1118+ 788C                  ; Default: Tile 0 (Background)
1119+ 788C AF               xor  a
1120+ 788D 18 1A            jr   .store_cell
1121+ 788F
1122+ 788F              .is_floor:
1123+ 788F 3E 01            ld   a, 1
1124+ 7891 18 16            jr   .store_cell
1125+ 7893              .is_crumbling:
1126+ 7893 3E 02            ld   a, 2
1127+ 7895 18 12            jr   .store_cell
1128+ 7897              .is_wall:
1129+ 7897 3E 03            ld   a, 3
1130+ 7899 18 0E            jr   .store_cell
1131+ 789B              .is_conveyor:
1132+ 789B 3E 04            ld   a, 4
1133+ 789D 18 0A            jr   .store_cell
1134+ 789F              .is_nasty1:
1135+ 789F 3E 05            ld   a, 5
1136+ 78A1 18 06            jr   .store_cell
1137+ 78A3              .is_nasty2:
1138+ 78A3 3E 06            ld   a, 6
1139+ 78A5 18 02            jr   .store_cell
1140+ 78A7              .is_extra:
1141+ 78A7 3E 07            ld   a, 7
1142+ 78A9
1143+ 78A9              .store_cell:
1144+ 78A9 12               ld   (de), a
1145+ 78AA 13               inc  de
1146+ 78AB 0B               dec  bc
1147+ 78AC 78               ld   a, b
1148+ 78AD B1               or   c
1149+ 78AE 20 B2            jr   nz, .byte_loop
1150+ 78B0
1151+ 78B0 DD E1            pop  ix
1152+ 78B2 C1               pop  bc
1153+ 78B3 D1               pop  de
1154+ 78B4 E1               pop  hl
1155+ 78B5 C9               ret
1156+ 78B6
1157+ 78B6              ; -------------------------------------------------------------------
1158+ 78B6              ; Legge il tipo di cella dal buffer decompresso in RAM
1159+ 78B6              ; Input: A = Row (0..15), C = Col (0..31)
1160+ 78B6              ; Output: A = tipo di cella (0..3)
1161+ 78B6              ; Preserva tutti gli altri registri.
1162+ 78B6              ; -------------------------------------------------------------------
1163+ 78B6              GetCellFromUnpacked:
1164+ 78B6 E5               push hl
1165+ 78B7 D5               push de
1166+ 78B8
1167+ 78B8 6F               ld   l, a
1168+ 78B9 26 00            ld   h, 0
1169+ 78BB 29               add  hl, hl
1170+ 78BC 29               add  hl, hl
1171+ 78BD 29               add  hl, hl
1172+ 78BE 29               add  hl, hl
1173+ 78BF 29               add  hl, hl            ; HL = Row * 32
1174+ 78C0 59               ld   e, c
1175+ 78C1 16 00            ld   d, 0
1176+ 78C3 19               add  hl, de            ; HL = Row * 32 + Col
1177+ 78C4 11 38 E3         ld   de, unpacked_layout
1178+ 78C7 19               add  hl, de

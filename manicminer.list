 625+ 82EC              ; Score_AddItemPoints
 626+ 82EC              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 82EC              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 82EC              ; -------------------------------------------------------------------
 629+ 82EC              Score_AddItemPoints:
 630+ 82EC F5               push af
 631+ 82ED C5               push bc
 632+ 82EE D5               push de
 633+ 82EF E5               push hl
 634+ 82F0
 635+ 82F0                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 82F0 3A 77 9C         ld   a, (player_score + 1)
 637+ 82F3 C6 01            add  a, $01
 638+ 82F5 27               daa
 639+ 82F6 32 77 9C         ld   (player_score + 1), a
 640+ 82F9
 641+ 82F9                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 82F9 3A 78 9C         ld   a, (player_score + 2)
 643+ 82FC CE 00            adc  a, 0
 644+ 82FE 27               daa
 645+ 82FF 32 78 9C         ld   (player_score + 2), a
 646+ 8302
 647+ 8302                  ; Controlla se player_score ha superato high_score
 648+ 8302 CD 0D 83         call Score_CheckAndUpdateHighScore
 649+ 8305
 650+ 8305                  ; Aggiorna visualizzazione a schermo
 651+ 8305 CD 43 69         call Gfx_UpdateScoreDisplay

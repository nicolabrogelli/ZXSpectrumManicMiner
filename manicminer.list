 408+ 81A5              ; CheckWillyItemCollision
 409+ 81A5              ;
 410+ 81A5              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81A5              ; Input:
 412+ 81A5              ;   A = Item Col (0..31)
 413+ 81A5              ;   H = Item Row (0..15)
 414+ 81A5              ; Output:
 415+ 81A5              ;   Carry Set = Collisione
 416+ 81A5              ;   Carry Clear = Nessuna collisione
 417+ 81A5              ; -------------------------------------------------------------------
 418+ 81A5              CheckWillyItemCollision:
 419+ 81A5 C5               push bc
 420+ 81A6 D5               push de
 421+ 81A7 E5               push hl
 422+ 81A8
 423+ 81A8                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

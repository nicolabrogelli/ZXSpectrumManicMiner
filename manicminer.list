 138+ 8074              ; Items_DrawRoom
 139+ 8074              ;
 140+ 8074              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 8074              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 8074              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 8074              ;
 144+ 8074              ; Record item nella stanza (5 byte):
 145+ 8074              ;   +0 Color / Attributo
 146+ 8074              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 8074              ;   +2 Attr Address High
 148+ 8074              ;   +3 Anim Mask (96)
 149+ 8074              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 8074              ; Fine lista: $FF
 151+ 8074              ; -------------------------------------------------------------------
 152+ 8074              Items_DrawRoom:
 153+ 8074 E5               push hl
 154+ 8075 D5               push de
 155+ 8076 C5               push bc
 156+ 8077 DD E5            push ix
 157+ 8079 FD E5            push iy
 158+ 807B
 159+ 807B                  ; 1. Azzera items_grid (512 byte)
 160+ 807B 21 04 9C         ld   hl, items_grid
 161+ 807E 11 05 9C         ld   de, items_grid + 1
 162+ 8081 36 00            ld   (hl), 0
 163+ 8083 01 FF 01         ld   bc, 511
 164+ 8086 ED B0            ldir
 165+ 8088
 166+ 8088                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 8088 AF               xor  a
 168+ 8089 32 84 A1         ld   (num_room_items), a
 169+ 808C
 170+ 808C FD 21 34 A1      ld   iy, current_room_items
 171+ 8090
 172+ 8090                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 8090 2A 85 A1         ld   hl, (room_ptr)
 174+ 8093 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 8096 19               add  hl, de
 176+ 8097 E5               push hl
 177+ 8098 DD E1            pop  ix                        ; IX = bitmap item
 178+ 809A
 179+ 809A                  ; 4. HL = Inizio lista item nella stanza
 180+ 809A 2A 85 A1         ld   hl, (room_ptr)
 181+ 809D 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80A0 19               add  hl, de
 183+ 80A1
 184+ 80A1              .loop:
 185+ 80A1 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80A2 FE FF            cp   $FF
 187+ 80A4 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80A6
 189+ 80A6 5F               ld   e, a                      ; E = Color
 190+ 80A7 23               inc  hl
 191+ 80A8 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80A9 23               inc  hl
 193+ 80AA 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80AB 23               inc  hl                        ; Salta Anim Byte
 195+ 80AC 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80AD
 197+ 80AD 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80AE FE FF            cp   $FF
 199+ 80B0 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 80B2
 201+ 80B2                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 80B2 E5               push hl
 203+ 80B3 60               ld   h, b
 204+ 80B4 69               ld   l, c
 205+ 80B5 01 00 A4         ld   bc, -23552
 206+ 80B8 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80B9
 208+ 80B9                  ; Col = Offset & 31
 209+ 80B9 7D               ld   a, l
 210+ 80BA E6 1F            and  31
 211+ 80BC 4F               ld   c, a                      ; C = Col (0..31)
 212+ 80BD
 213+ 80BD                  ; Row = Offset / 32
 214+ 80BD CB 3C            srl  h
 214+ 80BF CB 1D          rr l
 215+ 80C1 CB 3C            srl  h
 215+ 80C3 CB 1D          rr l
 216+ 80C5 CB 3C            srl  h
 216+ 80C7 CB 1D          rr l
 217+ 80C9 CB 3C            srl  h
 217+ 80CB CB 1D          rr l
 218+ 80CD CB 3C            srl  h
 218+ 80CF CB 1D          rr l
 219+ 80D1 7D               ld   a, l
 220+ 80D2 47               ld   b, a                      ; B = Row (0..15)
 221+ 80D3
 222+ 80D3                  ; Disegna l'item sullo schermo
 223+ 80D3 DD E5            push ix
 224+ 80D5 E1               pop  hl                        ; HL = puntatore bitmap
 225+ 80D6 CD 28 81         call DrawItemGraphic
 226+ 80D9
 227+ 80D9                  ; Aggiorna items_grid: offset = Row * 32 + Col
 228+ 80D9 D5               push de
 229+ 80DA 26 00            ld   h, 0
 230+ 80DC 68               ld   l, b                      ; HL = Row
 231+ 80DD 29               add  hl, hl
 232+ 80DE 29               add  hl, hl
 233+ 80DF 29               add  hl, hl
 234+ 80E0 29               add  hl, hl
 235+ 80E1 29               add  hl, hl                    ; Row * 32
 236+ 80E2 59               ld   e, c
 237+ 80E3 16 00            ld   d, 0
 238+ 80E5 19               add  hl, de                    ; Row * 32 + Col
 239+ 80E6 11 04 9C         ld   de, items_grid
 240+ 80E9 19               add  hl, de

 293+ 8718              ; DrawItemGraphic
 294+ 8718              ;
 295+ 8718              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 8718              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 8718              ;
 298+ 8718              ; Input:
 299+ 8718              ;   B = Riga attributi (0..23)

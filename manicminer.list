   8+ 7F80              ; Audio_UpdateJumpSound
   9+ 7F80              ;
  10+ 7F80              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7F80              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7F80              ; -------------------------------------------------------------------
  13+ 7F80              Audio_UpdateJumpSound:
  14+ 7F80 F5               push af
  15+ 7F81 C5               push bc
  16+ 7F82 D5               push de
  17+ 7F83 E5               push hl
  18+ 7F84
  19+ 7F84                  ; Controlla se il suono è attivo (note < 18)
  20+ 7F84 3A 7D 94         ld   a, (Audio_jump_sound_note)
  21+ 7F87 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7F89 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7F8B
  24+ 7F8B                  ; Carica la nota corrente da suonare
  25+ 7F8B 5F               ld   e, a
  26+ 7F8C 16 00            ld   d, 0
  27+ 7F8E 21 BA 7F         ld   hl, Audio_JumpSoundDelays
  28+ 7F91 19               add  hl, de
  29+ 7F92 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7F93 57               ld   d, a                      ; D = delay della nota
  31+ 7F94
  32+ 7F94                  ; Suona la nota: 15 cicli
  33+ 7F94 06 0F            ld   b, 15
  34+ 7F96              .note_loop:
  35+ 7F96                  ; Speaker ON
  36+ 7F96 3A 71 8E         ld   a, (room_border_color)
  37+ 7F99 F6 10            or   $10
  38+ 7F9B D3 FE            out  ($fe), a
  39+ 7F9D 4A               ld   c, d
  40+ 7F9E              .d1:
  41+ 7F9E 0D               dec  c
  42+ 7F9F 20 FD            jr   nz, .d1
  43+ 7FA1
  44+ 7FA1                  ; Speaker OFF
  45+ 7FA1 3A 71 8E         ld   a, (room_border_color)
  46+ 7FA4 E6 EF            and  $ef
  47+ 7FA6 D3 FE            out  ($fe), a
  48+ 7FA8 4A               ld   c, d
  49+ 7FA9              .d2:
  50+ 7FA9 0D               dec  c
  51+ 7FAA 20 FD            jr   nz, .d2
  52+ 7FAC
  53+ 7FAC 10 E8            djnz .note_loop
  54+ 7FAE
  55+ 7FAE                  ; Passa alla nota successiva
  56+ 7FAE 3A 7D 94         ld   a, (Audio_jump_sound_note)
  57+ 7FB1 3C               inc  a
  58+ 7FB2 32 7D 94         ld   (Audio_jump_sound_note), a
  59+ 7FB5
  60+ 7FB5              .done:
  61+ 7FB5 E1               pop  hl
  62+ 7FB6 D1               pop  de
  63+ 7FB7 C1               pop  bc
  64+ 7FB8 F1               pop  af
  65+ 7FB9 C9               ret
  66+ 7FBA
  67+ 7FBA              Audio_JumpSoundDelays:
  68+ 7FBA 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7FBE 19 13 0C 06
  68+ 7FC2 0C 13 19 20
  68+ 7FC6 26 2D 33 3A
  68+ 7FCA 40 47

 467+ 7FDE C3 25 80         jp   .next
 468+ 7FE1
 469+ 7FE1              .vertical:
 470+ 7FE1 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7FE4 FE 01            cp   1
 472+ 7FE6 20 20            jr   nz, .vert_down
 473+ 7FE8
 474+ 7FE8              .vert_up:

 414+ 845D              ; CheckWillyItemCollision
 415+ 845D              ;
 416+ 845D              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 845D              ; Input:
 418+ 845D              ;   A = Item Col (0..31)
 419+ 845D              ;   H = Item Row (0..15)
 420+ 845D              ; Output:
 421+ 845D              ;   Carry Set = Collisione
 422+ 845D              ;   Carry Clear = Nessuna collisione
 423+ 845D              ; -------------------------------------------------------------------
 424+ 845D              CheckWillyItemCollision:
 425+ 845D C5               push bc
 426+ 845E D5               push de
 427+ 845F E5               push hl
 428+ 8460
 429+ 8460                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8460 6F               ld   l, a
 431+ 8461 87               add  a, a                      ; *2
 432+ 8462 87               add  a, a                      ; *4
 433+ 8463 87               add  a, a                      ; *8
 434+ 8464 5F               ld   e, a                      ; E = ItemLeft
 435+ 8465 C6 07            add  a, 7
 436+ 8467 57               ld   d, a                      ; D = ItemRight

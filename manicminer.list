 561  86DB                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  86DB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  86DD              .wait_choice_loop:
 564  86DD 76               halt
 565  86DE
 566  86DE                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  86DE 0C               inc  c
 568  86DF 79               ld   a, c
 569  86E0 CB 3F            srl  a
 570  86E2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  86E4 E6 07            and  7
 572  86E6 5F               ld   e, a
 573  86E7 16 00            ld   d, 0
 574  86E9 21 0D 66         ld   hl, victory_color_table
 575  86EC 19               add  hl, de
 576  86ED 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  86EE 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  86F1 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  86F3              .color_cycle_loop:
 580  86F3 77               ld   (hl), a
 581  86F4 23               inc  hl
 582  86F5 10 FC            djnz .color_cycle_loop
 583  86F7
 584  86F7                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  86F7 01 FE DF         ld   bc, $dffe

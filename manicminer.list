 198+ 702D              ; -------------------------------------------------------------------
 199+ 702D              ; GetPlayerAirSpeed
 200+ 702D              ;
 201+ 702D              ; Calcola la velocità orizzontale in volo (pixel per frame) in base al
 202+ 702D              ; preset configurato in player_air_speed (DEFAULT_AIR_SPEED_PRESET).
 203+ 702D              ;
 204+ 702D              ; Presets:
 205+ 702D              ;   0 = 1.0 px/frame costante  (parabola stretta)
 206+ 702D              ;   1 = 1.5 px/frame alternato (parabola corta: alterna 1 e 2 px)
 207+ 702D              ;   2 = 2.0 px/frame costante  (parabola media)
 208+ 702D              ;   3 = 2.5 px/frame alternato (parabola standard MM: alterna 2 e 3 px)
 209+ 702D              ;   4 = 3.0 px/frame costante  (parabola estesa)
 210+ 702D              ;
 211+ 702D              ; Output:
 212+ 702D              ;   A = pixel di spostamento orizzontale per il frame corrente
 213+ 702D              ; -------------------------------------------------------------------
 214+ 702D              GetPlayerAirSpeed:
 215+ 702D 3A 67 EF         ld   a, (player_air_speed)
 216+ 7030 B7               or   a
 217+ 7031 28 0E            jr   z, .speed_1_0
 218+ 7033 3D               dec  a
 219+ 7034 28 0E            jr   z, .speed_1_5
 220+ 7036 3D               dec  a
 221+ 7037 28 15            jr   z, .speed_2_0
 222+ 7039 3D               dec  a
 223+ 703A 28 15            jr   z, .speed_2_5
 224+ 703C 3D               dec  a
 225+ 703D 28 1C            jr   z, .speed_3_0
 226+ 703F
 227+ 703F                  ; Default: se valore diverso, usa 2.0 px/frame
 228+ 703F 18 0D            jr   .speed_2_0
 229+ 7041
 230+ 7041              .speed_1_0:
 231+ 7041 3E 01            ld   a, 1
 232+ 7043 C9               ret
 233+ 7044
 234+ 7044              .speed_1_5:
 235+ 7044 3E 01            ld   a, 1
 236+ 7046 21 F4 EB         ld   hl, jump_frame
 237+ 7049 CB 46            bit  0, (hl)
 238+ 704B C8               ret  z
 239+ 704C 3C               inc  a                      ; Alterna 1 e 2 px
 240+ 704D C9               ret
 241+ 704E
 242+ 704E              .speed_2_0:
 243+ 704E 3E 02            ld   a, 2
 244+ 7050 C9               ret
 245+ 7051
 246+ 7051              .speed_2_5:
 247+ 7051 3E 02            ld   a, 2
 248+ 7053 21 F4 EB         ld   hl, jump_frame
 249+ 7056 CB 46            bit  0, (hl)
 250+ 7058 C8               ret  z
 251+ 7059 3C               inc  a                      ; Alterna 2 e 3 px (standard MM)
 252+ 705A C9               ret
 253+ 705B
 254+ 705B              .speed_3_0:
 255+ 705B 3E 03            ld   a, 3
 256+ 705D C9               ret
 257+ 705E
 258+ 705E              ; ===============================================================
 259+ 705E              ; MOVIMENTO SINISTRA
 260+ 705E              ; ===============================================================
 261+ 705E              movePlayer_left:
 262+ 705E                  ; Calcola nuova posizione: X - speed
 263+ 705E 3A EE EB         ld   a, (on_ground)
 264+ 7061 B7               or   a
 265+ 7062 28 05            jr   z, .air_left
 266+ 7064 3A 66 EF         ld   a, (player_speed)
 267+ 7067 18 03            jr   .speed_left_ok
 268+ 7069              .air_left:
 269+ 7069 CD 2D 70         call GetPlayerAirSpeed
 270+ 706C              .speed_left_ok:
 271+ 706C 5F               ld   e, a
 272+ 706D
 273+ 706D 79               ld   a, c
 274+ 706E 93               sub  e

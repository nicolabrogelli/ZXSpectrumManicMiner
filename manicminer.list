 408+ 81C0              ; CheckWillyItemCollision
 409+ 81C0              ;
 410+ 81C0              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81C0              ; Input:
 412+ 81C0              ;   A = Item Col (0..31)
 413+ 81C0              ;   H = Item Row (0..15)
 414+ 81C0              ; Output:
 415+ 81C0              ;   Carry Set = Collisione
 416+ 81C0              ;   Carry Clear = Nessuna collisione
 417+ 81C0              ; -------------------------------------------------------------------
 418+ 81C0              CheckWillyItemCollision:
 419+ 81C0 C5               push bc
 420+ 81C1 D5               push de
 421+ 81C2 E5               push hl
 422+ 81C3
 423+ 81C3                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 81C3 6F               ld   l, a
 425+ 81C4 87               add  a, a                      ; *2
 426+ 81C5 87               add  a, a                      ; *4
 427+ 81C6 87               add  a, a                      ; *8
 428+ 81C7 5F               ld   e, a                      ; E = ItemLeft
 429+ 81C8 C6 07            add  a, 7
 430+ 81CA 57               ld   d, a                      ; D = ItemRight
 431+ 81CB
 432+ 81CB ED 4B 32 9E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81CF
 434+ 81CF                  ; WillyLeft <= ItemRight
 435+ 81CF 79               ld   a, c                      ; A = WillyX
 436+ 81D0 BA               cp   d                         ; D = ItemRight
 437+ 81D1 28 04            jr   z, .x_ok
 438+ 81D3 38 02            jr   c, .x_ok
 439+ 81D5 18 31            jr   .no_collision
 440+ 81D7
 441+ 81D7              .x_ok:
 442+ 81D7                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81D7 BB               cp   e                         ; E = ItemLeft
 444+ 81D8 28 0B            jr   z, .y_check
 445+ 81DA 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81DC
 447+ 81DC                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81DC C6 0F            add  a, 15
 449+ 81DE BB               cp   e
 450+ 81DF 28 04            jr   z, .y_check
 451+ 81E1 30 02            jr   nc, .y_check
 452+ 81E3 18 23            jr   .no_collision
 453+ 81E5
 454+ 81E5              .y_check:
 455+ 81E5                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81E5 7C               ld   a, h                      ; H = Item Row
 457+ 81E6 87               add  a, a                      ; *2
 458+ 81E7 87               add  a, a                      ; *4
 459+ 81E8 87               add  a, a                      ; *8
 460+ 81E9 5F               ld   e, a                      ; E = ItemTop
 461+ 81EA C6 07            add  a, 7
 462+ 81EC 57               ld   d, a                      ; D = ItemBottom
 463+ 81ED
 464+ 81ED                  ; WillyTop <= ItemBottom
 465+ 81ED 78               ld   a, b                      ; A = WillyY
 466+ 81EE BA               cp   d                         ; D = ItemBottom
 467+ 81EF 28 04            jr   z, .y_ok
 468+ 81F1 38 02            jr   c, .y_ok
 469+ 81F3 18 13            jr   .no_collision
 470+ 81F5
 471+ 81F5              .y_ok:
 472+ 81F5                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81F5 BB               cp   e                         ; E = ItemTop
 474+ 81F6 28 0B            jr   z, .collision
 475+ 81F8 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81FA
 477+ 81FA                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81FA C6 0F            add  a, 15
 479+ 81FC BB               cp   e
 480+ 81FD 28 04            jr   z, .collision
 481+ 81FF 30 02            jr   nc, .collision
 482+ 8201 18 05            jr   .no_collision

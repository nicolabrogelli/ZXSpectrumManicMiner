 535+ 7F56 DD BE 04         cp   (ix+4)                    ; Min Limit Y
 536+ 7F59 28 08            jr   z, .v_rev_down
 537+ 7F5B 38 06            jr   c, .v_rev_down
 538+ 7F5D DD 77 03         ld   (ix+3), a
 539+ 7F60 C3 90 7F         jp   .next

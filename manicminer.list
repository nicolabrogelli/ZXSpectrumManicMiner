 680+ 6086 CB 3F            srl  a
 680+ 6088 CB 3F          srl a
 680+ 608A CB 3F          srl a
 681+ 608C 4F               ld   c, a                  ; C = ColEnd (0..31)
 682+ 608D
 683+ 608D                  ; Calcola RowStart (H) e RowEnd (L) per uno sprite alto 16 pixel (Y .. Y+15)
 684+ 608D 78               ld   a, b
 685+ 608E CB 3F            srl  a
 685+ 6090 CB 3F          srl a
 685+ 6092 CB 3F          srl a

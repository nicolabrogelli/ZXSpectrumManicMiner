 198+ 801A
 199+ 801A 3A A0 8E         ld   a, (room_border_color)
 200+ 801D E6 EF            and  $ef              ; speaker OFF
 201+ 801F D3 FE            out  ($fe), a
 202+ 8021
 203+ 8021 0E 3C            ld   c, 60
 204+ 8023              .d2:
 205+ 8023 0D               dec  c
 206+ 8024 20 FD            jr   nz, .d2
 207+ 8026
 208+ 8026 10 E6            djnz .sound_loop
 209+ 8028

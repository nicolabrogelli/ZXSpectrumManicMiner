 287+ 7ECB              ; DrawItemGraphic
 288+ 7ECB              ;
 289+ 7ECB              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 290+ 7ECB              ; utilizzando una bitmap di 8 byte e un attributo colore.
 291+ 7ECB              ;
 292+ 7ECB              ; Input:
 293+ 7ECB              ;   B = Riga attributi (0..23)
 294+ 7ECB              ;   C = Colonna attributi (0..31)
 295+ 7ECB              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 296+ 7ECB              ;   E = Attributo colore
 297+ 7ECB              ; -------------------------------------------------------------------
 298+ 7ECB              DrawItemGraphic:
 299+ 7ECB C5               push bc
 300+ 7ECC D5               push de
 301+ 7ECD E5               push hl
 302+ 7ECE
 303+ 7ECE                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 304+ 7ECE 78               ld   a, b
 305+ 7ECF E6 18            and  $18
 306+ 7ED1 C6 40            add  a, $40
 307+ 7ED3 57               ld   d, a                      ; Byte alto indirizzo video
 308+ 7ED4
 309+ 7ED4 78               ld   a, b
 310+ 7ED5 E6 07            and  7
 311+ 7ED7 87               add  a, a                      ; *2
 312+ 7ED8 87               add  a, a                      ; *4
 313+ 7ED9 87               add  a, a                      ; *8
 314+ 7EDA 87               add  a, a                      ; *16
 315+ 7EDB 87               add  a, a                      ; *32
 316+ 7EDC 81               add  a, c                      ; + Col
 317+ 7EDD 5F               ld   e, a                      ; Byte basso indirizzo video
 318+ 7EDE
 319+ 7EDE C5               push bc
 320+ 7EDF 06 08            ld   b, 8                      ; 8 scanline
 321+ 7EE1              .line_loop:
 322+ 7EE1 7E               ld   a, (hl)
 323+ 7EE2 12               ld   (de), a
 324+ 7EE3 14               inc  d
 325+ 7EE4 23               inc  hl
 326+ 7EE5 05               dec  b
 327+ 7EE6 20 F9            jr   nz, .line_loop
 328+ 7EE8 C1               pop  bc
 329+ 7EE9
 330+ 7EE9                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 331+ 7EE9 26 00            ld   h, 0
 332+ 7EEB 68               ld   l, b
 333+ 7EEC 29               add  hl, hl
 334+ 7EED 29               add  hl, hl
 335+ 7EEE 29               add  hl, hl
 336+ 7EEF 29               add  hl, hl
 337+ 7EF0 29               add  hl, hl                    ; Row * 32
 338+ 7EF1 79               ld   a, c
 339+ 7EF2 85               add  a, l
 340+ 7EF3 6F               ld   l, a
 341+ 7EF4 30 01            jr   nc, .no_carry
 342+ 7EF6 24               inc  h
 343+ 7EF7              .no_carry:
 344+ 7EF7 11 00 58         ld   de, $5800
 345+ 7EFA 19               add  hl, de
 346+ 7EFB
 347+ 7EFB C1               pop  bc                        ; Recupera HL originale
 348+ 7EFC D1               pop  de                        ; Recupera DE originale (E = colore)
 349+ 7EFD 7B               ld   a, e
 350+ 7EFE 77               ld   (hl), a                   ; Scrive l'attributo colore
 351+ 7EFF
 352+ 7EFF C5               push bc
 353+ 7F00 E1               pop  hl
 354+ 7F01 C1               pop  bc
 355+ 7F02 C9               ret

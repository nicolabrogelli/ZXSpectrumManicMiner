 408+ 81AC              ; CheckWillyItemCollision
 409+ 81AC              ;
 410+ 81AC              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81AC              ; Input:
 412+ 81AC              ;   A = Item Col (0..31)
 413+ 81AC              ;   H = Item Row (0..15)
 414+ 81AC              ; Output:
 415+ 81AC              ;   Carry Set = Collisione
 416+ 81AC              ;   Carry Clear = Nessuna collisione
 417+ 81AC              ; -------------------------------------------------------------------
 418+ 81AC              CheckWillyItemCollision:
 419+ 81AC C5               push bc
 420+ 81AD D5               push de
 421+ 81AE E5               push hl
 422+ 81AF
 423+ 81AF                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 81AF 6F               ld   l, a
 425+ 81B0 87               add  a, a                      ; *2
 426+ 81B1 87               add  a, a                      ; *4
 427+ 81B2 87               add  a, a                      ; *8
 428+ 81B3 5F               ld   e, a                      ; E = ItemLeft
 429+ 81B4 C6 07            add  a, 7
 430+ 81B6 57               ld   d, a                      ; D = ItemRight
 431+ 81B7
 432+ 81B7 ED 4B 09 96      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81BB
 434+ 81BB                  ; WillyLeft <= ItemRight
 435+ 81BB 79               ld   a, c                      ; A = WillyX
 436+ 81BC BA               cp   d                         ; D = ItemRight
 437+ 81BD 28 04            jr   z, .x_ok
 438+ 81BF 38 02            jr   c, .x_ok
 439+ 81C1 18 31            jr   .no_collision
 440+ 81C3
 441+ 81C3              .x_ok:
 442+ 81C3                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81C3 BB               cp   e                         ; E = ItemLeft
 444+ 81C4 28 0B            jr   z, .y_check
 445+ 81C6 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81C8
 447+ 81C8                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81C8 C6 0F            add  a, 15
 449+ 81CA BB               cp   e
 450+ 81CB 28 04            jr   z, .y_check
 451+ 81CD 30 02            jr   nc, .y_check
 452+ 81CF 18 23            jr   .no_collision
 453+ 81D1
 454+ 81D1              .y_check:
 455+ 81D1                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81D1 7C               ld   a, h                      ; H = Item Row
 457+ 81D2 87               add  a, a                      ; *2
 458+ 81D3 87               add  a, a                      ; *4
 459+ 81D4 87               add  a, a                      ; *8
 460+ 81D5 5F               ld   e, a                      ; E = ItemTop
 461+ 81D6 C6 07            add  a, 7
 462+ 81D8 57               ld   d, a                      ; D = ItemBottom
 463+ 81D9
 464+ 81D9                  ; WillyTop <= ItemBottom
 465+ 81D9 78               ld   a, b                      ; A = WillyY
 466+ 81DA BA               cp   d                         ; D = ItemBottom
 467+ 81DB 28 04            jr   z, .y_ok
 468+ 81DD 38 02            jr   c, .y_ok
 469+ 81DF 18 13            jr   .no_collision
 470+ 81E1
 471+ 81E1              .y_ok:
 472+ 81E1                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81E1 BB               cp   e                         ; E = ItemTop
 474+ 81E2 28 0B            jr   z, .collision
 475+ 81E4 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81E6
 477+ 81E6                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81E6 C6 0F            add  a, 15
 479+ 81E8 BB               cp   e
 480+ 81E9 28 04            jr   z, .collision
 481+ 81EB 30 02            jr   nc, .collision
 482+ 81ED 18 05            jr   .no_collision

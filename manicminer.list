1926+ 7BE5 DD 36 00 00      ld   (ix+0), 0             ; Reset in crumbling_grid
1927+ 7BE9
1928+ 7BE9                  ; 1. Rimuovi definitivamente da unpacked_layout (imposta a 0 = Background)
1929+ 7BE9 C5               push bc
1930+ 7BEA D5               push de
1931+ 7BEB E5               push hl
1932+ 7BEC 6A               ld   l, d                  ; L = Row
1933+ 7BED 26 00            ld   h, 0
1934+ 7BEF 29               add  hl, hl
1934+ 7BF0 29             add hl, hl
1934+ 7BF1 29             add hl, hl
1934+ 7BF2 29             add hl, hl
1934+ 7BF3 29             add hl, hl

1589+ 6631 D3 FE            out  ($fe), a              ; Bordo a nero
1590+ 6633 21 8D 5C         ld   hl, ATTR_P
1591+ 6636 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1592+ 6637 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1593+ 663A 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1594+ 663C 3E 07            ld   a, $07
1595+ 663E 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1596+ 6641
1597+ 6641                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1598+ 6641                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1599+ 6641 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1600+ 6644 DD 21 27 90      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1601+ 6648 CD 3F 5E         call Gfx_DrawPixelSprite8x8

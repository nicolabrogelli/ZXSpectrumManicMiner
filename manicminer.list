 286  88A5              ; ShowTitleScreen
 287  88A5              ; Visualizza la schermata iniziale del gioco (Title Screen).
 288  88A5              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 289  88A5              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 290  88A5              ; -------------------------------------------------------------------
 291  88A5              ShowTitleScreen:
 292  88A5                  ; 1. Disegna la schermata iniziale
 293  88A5 CD 7A 64         call Gfx_DrawTitleScreen
 294  88A8
 295  88A8                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 296  88A8              .wait_title_enter_release:
 297  88A8 76               halt
 298  88A9 3E BF            ld   a, $bf
 299  88AB DB FE            in   a, ($fe)
 300  88AD 1F               rra
 301  88AE 30 F8            jr   nc, .wait_title_enter_release
 302  88B0
 303  88B0                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 304  88B0 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 305  88B2              .title_loop:
 306  88B2 76               halt
 307  88B3
 308  88B3                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 309  88B3 0C               inc  c
 310  88B4 79               ld   a, c
 311  88B5 CB 3F            srl  a
 312  88B7 CB 3F            srl  a
 313  88B9 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 314  88BB E6 07            and  7
 315  88BD 5F               ld   e, a
 316  88BE 16 00            ld   d, 0
 317  88C0 21 72 64         ld   hl, title_color_table
 318  88C3 19               add  hl, de
 319  88C4 7E               ld   a, (hl)               ; A = nuovo colore
 320  88C5 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  88C8 06 20            ld   b, 32
 322  88CA              .color_title_loop:
 323  88CA 77               ld   (hl), a
 324  88CB 23               inc  hl
 325  88CC 10 FC            djnz .color_title_loop
 326  88CE
 327  88CE                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 328  88CE 3E BF            ld   a, $bf
 329  88D0 DB FE            in   a, ($fe)
 330  88D2 1F               rra
 331  88D3 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 332  88D5
 333  88D5                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 334  88D5              .wait_title_enter_release_after:
 335  88D5 76               halt
 336  88D6 3E BF            ld   a, $bf
 337  88D8 DB FE            in   a, ($fe)

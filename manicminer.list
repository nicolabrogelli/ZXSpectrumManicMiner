 286  8504              ; -------------------------------------------------------------------
 287  8504              ; ShowTitleScreen
 288  8504              ; Visualizza la schermata iniziale del gioco (Title Screen).
 289  8504              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 290  8504              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 291  8504              ; -------------------------------------------------------------------
 292  8504              ShowTitleScreen:
 293  8504                  ; 1. Disegna la schermata iniziale
 294  8504 CD 49 64         call Gfx_DrawTitleScreen
 295  8507
 296  8507                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 297  8507              .wait_title_enter_release:
 298  8507 76               halt
 299  8508 3E BF            ld   a, $bf
 300  850A DB FE            in   a, ($fe)
 301  850C 1F               rra
 302  850D 30 F8            jr   nc, .wait_title_enter_release
 303  850F
 304  850F                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 305  850F 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 306  8511              .title_loop:
 307  8511 76               halt
 308  8512
 309  8512                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 310  8512 0C               inc  c
 311  8513 79               ld   a, c
 312  8514 CB 3F            srl  a
 313  8516 CB 3F            srl  a
 314  8518 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 315  851A E6 07            and  7
 316  851C 5F               ld   e, a
 317  851D 16 00            ld   d, 0
 318  851F 21 41 64         ld   hl, title_color_table
 319  8522 19               add  hl, de
 320  8523 7E               ld   a, (hl)               ; A = nuovo colore
 321  8524 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 322  8527 06 20            ld   b, 32
 323  8529              .color_title_loop:
 324  8529 77               ld   (hl), a
 325  852A 23               inc  hl
 326  852B 10 FC            djnz .color_title_loop
 327  852D
 328  852D                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 329  852D 3E BF            ld   a, $bf
 330  852F DB FE            in   a, ($fe)
 331  8531 1F               rra
 332  8532 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 333  8534
 334  8534                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 335  8534              .wait_title_enter_release_after:
 336  8534 76               halt
 337  8535 3E BF            ld   a, $bf
 338  8537 DB FE            in   a, ($fe)
 339  8539 1F               rra
 340  853A 30 F8            jr   nc, .wait_title_enter_release_after
 341  853C
 342  853C                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 343  853C AF               xor  a
 344  853D D3 FE            out  ($fe), a              ; Bordo a nero
 345  853F 21 8D 5C         ld   hl, ATTR_P
 346  8542 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 347  8543 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  8546 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 349  8548 3E 07            ld   a, $07
 350  854A 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 351  854D
 352  854D                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 353  854D CD C2 87         call ResetFullGameState
 354  8550
 355  8550                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 356  8550 C3 D5 83         jp   LoadRoomAndRestart

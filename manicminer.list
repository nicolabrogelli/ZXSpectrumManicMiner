 353  8275              ; -------------------------------------------------------------------
 354  8275              ; TriggerGameOver
 355  8275              ; Scatena la schermata di Game Over per la stanza corrente.
 356  8275              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 357  8275              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 358  8275              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 359  8275              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 360  8275              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 361  8275              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 362  8275              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 363  8275              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 364  8275              ; -------------------------------------------------------------------
 365  8275              TriggerGameOver:
 366  8275                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 367  8275 CD A2 64         call Gfx_DrawGameOverScreen
 368  8278
 369  8278                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 370  8278              .wait_keys_release:
 371  8278 76               halt
 372  8279                  ; Controlla tasto Y (Porta $DF, bit 4)
 373  8279 01 FE DF         ld   bc, $dffe
 374  827C ED 78            in   a, (c)
 375  827E CB 67            bit  4, a
 376  8280 28 F6            jr   z, .wait_keys_release
 377  8282
 378  8282                  ; Controlla tasto N (Porta $7F, bit 3)
 379  8282 01 FE 7F         ld   bc, $7ffe
 380  8285 ED 78            in   a, (c)
 381  8287 CB 5F            bit  3, a
 382  8289 28 ED            jr   z, .wait_keys_release
 383  828B
 384  828B                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 385  828B 01 FE BF         ld   bc, $bffe
 386  828E ED 78            in   a, (c)
 387  8290 CB 47            bit  0, a
 388  8292 28 E4            jr   z, .wait_keys_release
 389  8294
 390  8294                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 391  8294 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 392  8296              .wait_choice_loop:
 393  8296 76               halt
 394  8297
 395  8297                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 396  8297 0C               inc  c
 397  8298 79               ld   a, c
 398  8299 CB 3F            srl  a
 399  829B CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 400  829D E6 07            and  7
 401  829F 5F               ld   e, a
 402  82A0 16 00            ld   d, 0
 403  82A2 21 5E 64         ld   hl, game_over_color_table
 404  82A5 19               add  hl, de
 405  82A6 7E               ld   a, (hl)               ; A = nuovo colore attributo
 406  82A7 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 407  82AA 06 09            ld   b, 9
 408  82AC              .color_cycle_loop:
 409  82AC 77               ld   (hl), a
 410  82AD 23               inc  hl
 411  82AE 10 FC            djnz .color_cycle_loop
 412  82B0
 413  82B0                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 414  82B0 01 FE DF         ld   bc, $dffe
 415  82B3 ED 78            in   a, (c)
 416  82B5 CB 67            bit  4, a
 417  82B7 28 2A            jr   z, .continue_chosen
 418  82B9
 419  82B9                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 420  82B9 01 FE 7F         ld   bc, $7ffe
 421  82BC ED 78            in   a, (c)
 422  82BE CB 5F            bit  3, a
 423  82C0 28 0B            jr   z, .quit_chosen
 424  82C2
 425  82C2                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 426  82C2 01 FE BF         ld   bc, $bffe
 427  82C5 ED 78            in   a, (c)
 428  82C7 CB 47            bit  0, a
 429  82C9 28 02            jr   z, .quit_chosen
 430  82CB
 431  82CB 18 C9            jr   .wait_choice_loop
 432  82CD
 433  82CD              .quit_chosen:
 434  82CD                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 435  82CD              .wait_quit_release:
 436  82CD 76               halt
 437  82CE 01 FE 7F         ld   bc, $7ffe
 438  82D1 ED 78            in   a, (c)
 439  82D3 CB 5F            bit  3, a
 440  82D5 28 F6            jr   z, .wait_quit_release
 441  82D7 01 FE BF         ld   bc, $bffe
 442  82DA ED 78            in   a, (c)
 443  82DC CB 47            bit  0, a
 444  82DE 28 ED            jr   z, .wait_quit_release
 445  82E0
 446  82E0                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 447  82E0 C3 26 82         jp   ShowTitleScreen
 448  82E3
 449  82E3              .continue_chosen:
 450  82E3                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 451  82E3              .wait_continue_release:
 452  82E3 76               halt
 453  82E4 01 FE DF         ld   bc, $dffe
 454  82E7 ED 78            in   a, (c)
 455  82E9 CB 67            bit  4, a

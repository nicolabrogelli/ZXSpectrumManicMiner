 357+ 7DA3 C1               pop  bc
 358+ 7DA4 FD E1            pop  iy
 359+ 7DA6 C9               ret
 360+ 7DA7
 361+ 7DA7              ; -------------------------------------------------------------------
 362+ 7DA7              ; CheckWillyItemCollision
 363+ 7DA7              ;
 364+ 7DA7              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 365+ 7DA7              ; Input:
 366+ 7DA7              ;   A = Item Col (0..31)
 367+ 7DA7              ;   H = Item Row (0..15)
 368+ 7DA7              ; Output:
 369+ 7DA7              ;   Carry Set = Collisione
 370+ 7DA7              ;   Carry Clear = Nessuna collisione
 371+ 7DA7              ; -------------------------------------------------------------------
 372+ 7DA7              CheckWillyItemCollision:
 373+ 7DA7 C5               push bc
 374+ 7DA8 D5               push de
 375+ 7DA9 E5               push hl
 376+ 7DAA
 377+ 7DAA                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 378+ 7DAA 6F               ld   l, a
 379+ 7DAB 87               add  a, a                      ; *2
 380+ 7DAC 87               add  a, a                      ; *4
 381+ 7DAD 87               add  a, a                      ; *8
 382+ 7DAE 5F               ld   e, a                      ; E = ItemLeft
 383+ 7DAF C6 07            add  a, 7
 384+ 7DB1 57               ld   d, a                      ; D = ItemRight
 385+ 7DB2
 386+ 7DB2 ED 4B A7 8D      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 387+ 7DB6
 388+ 7DB6                  ; WillyLeft <= ItemRight
 389+ 7DB6 79               ld   a, c
 390+ 7DB7 BA               cp   d
 391+ 7DB8 28 04            jr   z, .x_ok
 392+ 7DBA 38 02            jr   c, .x_ok
 393+ 7DBC 18 29            jr   .no_collision
 394+ 7DBE
 395+ 7DBE              .x_ok:
 396+ 7DBE                  ; WillyRight >= ItemLeft (WillyRight = WillyX + 7 o 15)
 397+ 7DBE C6 07            add  a, 7
 398+ 7DC0 BB               cp   e
 399+ 7DC1 28 04            jr   z, .y_check
 400+ 7DC3 30 02            jr   nc, .y_check
 401+ 7DC5 18 20            jr   .no_collision
 402+ 7DC7
 403+ 7DC7              .y_check:
 404+ 7DC7 E1               pop  hl
 405+ 7DC8 E5               push hl
 406+ 7DC9
 407+ 7DC9                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 408+ 7DC9 7C               ld   a, h
 409+ 7DCA 87               add  a, a                      ; *2
 410+ 7DCB 87               add  a, a                      ; *4
 411+ 7DCC 87               add  a, a                      ; *8
 412+ 7DCD 5F               ld   e, a                      ; ItemTop
 413+ 7DCE C6 07            add  a, 7
 414+ 7DD0 57               ld   d, a                      ; ItemBottom
 415+ 7DD1
 416+ 7DD1                  ; WillyTop <= ItemBottom
 417+ 7DD1 78               ld   a, b
 418+ 7DD2 BA               cp   d
 419+ 7DD3 28 04            jr   z, .y_ok
 420+ 7DD5 38 02            jr   c, .y_ok
 421+ 7DD7 18 0E            jr   .no_collision
 422+ 7DD9
 423+ 7DD9              .y_ok:
 424+ 7DD9                  ; WillyBottom >= ItemTop (WillyBottom = WillyY + 15)
 425+ 7DD9 C6 0F            add  a, 15
 426+ 7DDB BB               cp   e
 427+ 7DDC 28 04            jr   z, .collision
 428+ 7DDE 30 02            jr   nc, .collision
 429+ 7DE0 18 05            jr   .no_collision
 430+ 7DE2
 431+ 7DE2              .collision:
 432+ 7DE2 E1               pop  hl
 433+ 7DE3 D1               pop  de
 434+ 7DE4 C1               pop  bc
 435+ 7DE5 37               scf
 436+ 7DE6 C9               ret
 437+ 7DE7
 438+ 7DE7              .no_collision:
 439+ 7DE7 E1               pop  hl
 440+ 7DE8 D1               pop  de
 441+ 7DE9 C1               pop  bc
 442+ 7DEA B7               or   a
 443+ 7DEB C9               ret
 444+ 7DEC
 445+ 7DEC              ; -------------------------------------------------------------------
 446+ 7DEC              ; Items_CheckCollision
 447+ 7DEC              ;
 448+ 7DEC              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 449+ 7DEC              ; -------------------------------------------------------------------
 450+ 7DEC              Items_CheckCollision:
 451+ 7DEC E5               push hl
 452+ 7DED D5               push de
 453+ 7DEE C5               push bc
 454+ 7DEF FD E5            push iy
 455+ 7DF1
 456+ 7DF1 3A 26 91         ld   a, (num_room_items)
 457+ 7DF4 B7               or   a
 458+ 7DF5 28 5F            jr   z, .done
 459+ 7DF7
 460+ 7DF7 47               ld   b, a                      ; B = numero item attivi
 461+ 7DF8 FD 21 D6 90      ld   iy, current_room_items
 462+ 7DFC
 463+ 7DFC              .loop:
 464+ 7DFC FD 7E 02         ld   a, (iy+2)                 ; Color / Active
 465+ 7DFF B7               or   a
 466+ 7E00 28 4D            jr   z, .next_item
 467+ 7E02
 468+ 7E02 FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 469+ 7E05 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 470+ 7E08
 471+ 7E08 79               ld   a, c
 472+ 7E09 CD A7 7D         call CheckWillyItemCollision
 473+ 7E0C 30 41            jr   nc, .next_item
 474+ 7E0E
 475+ 7E0E                  ; --- ITEM RACCOLTO ---
 476+ 7E0E                  ; 1. Imposta il flag collected nei dati stanza
 477+ 7E0E FD 6E 03         ld   l, (iy+3)
 478+ 7E11 FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 479+ 7E14 36 00            ld   (hl), 0                   ; 0 = raccolto
 480+ 7E16
 481+ 7E16                  ; 2. Rimuovi dalla griglia items_grid
 482+ 7E16 FD 4E 00         ld   c, (iy+0)
 483+ 7E19 FD 46 01         ld   b, (iy+1)
 484+ 7E1C C5               push bc
 485+ 7E1D 26 00            ld   h, 0
 486+ 7E1F 68               ld   l, b
 487+ 7E20 29               add  hl, hl
 487+ 7E21 29             add hl, hl
 487+ 7E22 29             add hl, hl
 487+ 7E23 29             add hl, hl
 487+ 7E24 29             add hl, hl
 488+ 7E25 59               ld   e, c
 489+ 7E26 16 00            ld   d, 0
 490+ 7E28 19               add  hl, de
 491+ 7E29 11 A7 8B         ld   de, items_grid
 492+ 7E2C 19               add  hl, de
 493+ 7E2D 36 00            ld   (hl), 0
 494+ 7E2F C1               pop  bc
 495+ 7E30
 496+ 7E30                  ; 3. Disattiva lo slot nella cache
 497+ 7E30 FD 36 02 00      ld   (iy+2), 0
 498+ 7E34
 499+ 7E34                  ; 4. Incrementa il conteggio globale degli item raccolti
 500+ 7E34 3A B1 8D         ld   a, (items_collected)
 501+ 7E37 3C               inc  a
 502+ 7E38 32 B1 8D         ld   (items_collected), a
 503+ 7E3B
 504+ 7E3B FE 05            cp   TOTAL_ITEMS
 505+ 7E3D 38 07            jr   c, .objective_not_yet
 506+ 7E3F F5               push af
 507+ 7E40 3E 01            ld   a, 1
 508+ 7E42 32 BC 93         ld   (game_objective_completed), a
 509+ 7E45 F1               pop  af
 510+ 7E46              .objective_not_yet:
 511+ 7E46                  ; 5. Aggiungi 100 punti allo Score, aggiorna High Score e aggiorna la visualizzazione HUD
 512+ 7E46 CD 7A 7E         call Score_AddItemPoints
 513+ 7E49
 514+ 7E49                  ; 6. Ripristina il tile di sfondo
 515+ 7E49 CD 75 7D         call RestoreBackgroundCell
 516+ 7E4C
 517+ 7E4C                  ; 7. Suono di raccolta
 518+ 7E4C CD 1D 7F         call Audio_PlayCollectSound
 519+ 7E4F
 520+ 7E4F              .next_item:
 521+ 7E4F 11 05 00         ld   de, 5
 522+ 7E52 FD 19            add  iy, de
 523+ 7E54 10 A6            djnz .loop
 524+ 7E56
 525+ 7E56              .done:
 526+ 7E56 FD E1            pop  iy
 527+ 7E58 C1               pop  bc
 528+ 7E59 D1               pop  de
 529+ 7E5A E1               pop  hl
 530+ 7E5B C9               ret
 531+ 7E5C
 532+ 7E5C              ; -------------------------------------------------------------------
 533+ 7E5C              ; CheckActiveItemAtCell
 534+ 7E5C              ;
 535+ 7E5C              ; Verifica rapida su griglia se c'è un item attivo alla cella (B=Col, C=Row)
 536+ 7E5C              ; Output: Carry Set = Item presente, Carry Clear = Nessun item
 537+ 7E5C              ; -------------------------------------------------------------------
 538+ 7E5C              CheckActiveItemAtCell:
 539+ 7E5C D5               push de
 540+ 7E5D E5               push hl
 541+ 7E5E
 542+ 7E5E 26 00            ld   h, 0
 543+ 7E60 69               ld   l, c                      ; HL = Row
 544+ 7E61 29               add  hl, hl
 544+ 7E62 29             add hl, hl
 544+ 7E63 29             add hl, hl
 544+ 7E64 29             add hl, hl
 544+ 7E65 29             add hl, hl
 545+ 7E66 58               ld   e, b
 546+ 7E67 16 00            ld   d, 0
 547+ 7E69 19               add  hl, de
 548+ 7E6A 11 A7 8B         ld   de, items_grid
 549+ 7E6D 19               add  hl, de
 550+ 7E6E 7E               ld   a, (hl)
 551+ 7E6F B7               or   a
 552+ 7E70 28 04            jr   z, .not_active
 553+ 7E72
 554+ 7E72 E1               pop  hl
 555+ 7E73 D1               pop  de
 556+ 7E74 37               scf
 557+ 7E75 C9               ret
 558+ 7E76
 559+ 7E76              .not_active:
 560+ 7E76 E1               pop  hl
 561+ 7E77 D1               pop  de
 562+ 7E78 B7               or   a
 563+ 7E79 C9               ret
 564+ 7E7A
 565+ 7E7A              ; -------------------------------------------------------------------
 566+ 7E7A              ; Score_AddItemPoints
 567+ 7E7A              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 568+ 7E7A              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 569+ 7E7A              ; -------------------------------------------------------------------
 570+ 7E7A              Score_AddItemPoints:
 571+ 7E7A F5               push af
 572+ 7E7B C5               push bc
 573+ 7E7C D5               push de
 574+ 7E7D E5               push hl
 575+ 7E7E
 576+ 7E7E                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 577+ 7E7E 3A B7 93         ld   a, (player_score + 1)
 578+ 7E81 C6 01            add  a, $01
 579+ 7E83 27               daa
 580+ 7E84 32 B7 93         ld   (player_score + 1), a
 581+ 7E87
 582+ 7E87                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 583+ 7E87 3A B8 93         ld   a, (player_score + 2)
 584+ 7E8A CE 00            adc  a, 0
 585+ 7E8C 27               daa
 586+ 7E8D 32 B8 93         ld   (player_score + 2), a
 587+ 7E90
 588+ 7E90                  ; Controlla se player_score ha superato high_score
 589+ 7E90 CD 9B 7E         call Score_CheckAndUpdateHighScore
 590+ 7E93
 591+ 7E93                  ; Aggiorna visualizzazione a schermo
 592+ 7E93 CD 63 67         call Gfx_UpdateScoreDisplay
 593+ 7E96
 594+ 7E96 E1               pop  hl
 595+ 7E97 D1               pop  de
 596+ 7E98 C1               pop  bc
 597+ 7E99 F1               pop  af
 598+ 7E9A C9               ret
 599+ 7E9B
 600+ 7E9B              ; -------------------------------------------------------------------
 601+ 7E9B              ; Score_CheckAndUpdateHighScore
 602+ 7E9B              ; Se player_score > high_score, copia player_score in high_score.
 603+ 7E9B              ; -------------------------------------------------------------------
 604+ 7E9B              Score_CheckAndUpdateHighScore:
 605+ 7E9B                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 606+ 7E9B                  ; Byte 2:
 607+ 7E9B 3A B8 93         ld   a, (player_score + 2)
 608+ 7E9E 47               ld   b, a
 609+ 7E9F 3A BB 93         ld   a, (high_score + 2)
 610+ 7EA2 B8               cp   b
 611+ 7EA3 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 612+ 7EA5 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 613+ 7EA7
 614+ 7EA7                  ; Byte 1:
 615+ 7EA7 3A B7 93         ld   a, (player_score + 1)
 616+ 7EAA 47               ld   b, a
 617+ 7EAB 3A BA 93         ld   a, (high_score + 1)
 618+ 7EAE B8               cp   b
 619+ 7EAF 38 0C            jr   c, .new_high_score
 620+ 7EB1 20 1C            jr   nz, .done_check
 621+ 7EB3
 622+ 7EB3                  ; Byte 0:
 623+ 7EB3 3A B6 93         ld   a, (player_score + 0)
 624+ 7EB6 47               ld   b, a
 625+ 7EB7 3A B9 93         ld   a, (high_score + 0)
 626+ 7EBA B8               cp   b
 627+ 7EBB 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 628+ 7EBD
 629+ 7EBD              .new_high_score:
 630+ 7EBD 3A B6 93         ld   a, (player_score + 0)
 631+ 7EC0 32 B9 93         ld   (high_score + 0), a
 632+ 7EC3 3A B7 93         ld   a, (player_score + 1)
 633+ 7EC6 32 BA 93         ld   (high_score + 1), a
 634+ 7EC9 3A B8 93         ld   a, (player_score + 2)
 635+ 7ECC 32 BB 93         ld   (high_score + 2), a
 636+ 7ECF
 637+ 7ECF              .done_check:
 638+ 7ECF C9               ret
 639+ 7ED0

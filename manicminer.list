 330+ 7029              ; LoadPositionPlayeinRoom
 331+ 7029              ;
 332+ 7029              ; Inizializza la posizione del player (Willy) quando entra
 333+ 7029              ; in una nuova stanza.
 334+ 7029              ;
 335+ 7029              ; La posizione viene letta direttamente dai dati della stanza
 336+ 7029              ; (layout/metadata) a partire da room_ptr.
 337+ 7029              ;
 338+ 7029              ; Output:
 339+ 7029              ;   PlayerPos     = posizione iniziale (Y, X)
 340+ 7029              ;   PlayerPosOld  = copia della posizione iniziale
 341+ 7029              ;
 342+ 7029              ; Struttura dati stanza:
 343+ 7029              ;   OFFSET_POS_WILLY:
 344+ 7029              ;       +0 = X
 345+ 7029              ;       +1 = Y
 346+ 7029              ; -------------------------------------------------------------------
 347+ 7029              LoadPositionPlayeinRoom:
 348+ 7029                  ; ---------------------------------------------------------------
 349+ 7029                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 350+ 7029                  ; ---------------------------------------------------------------
 351+ 7029 2A C8 ED         ld   hl, (room_ptr)
 352+ 702C 11 68 02         ld   de, OFFSET_POS_WILLY
 353+ 702F 19               add  hl, de
 354+ 7030
 355+ 7030                  ; Byte 0: Y * 2
 356+ 7030 7E               ld   a, (hl)
 357+ 7031 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 358+ 7033 57               ld   d, a                      ; D = PlayerY
 359+ 7034
 360+ 7034                  ; Byte 1: Anim frame
 361+ 7034 23               inc  hl
 362+ 7035 7E               ld   a, (hl)
 363+ 7036 E6 03            and  3                         ; Garanzia valore valido (0..3)
 364+ 7038 FE 03            cp   3
 365+ 703A 38 01            jr   c, .valid_anim
 366+ 703C AF               xor  a
 367+ 703D              .valid_anim:
 368+ 703D 32 4D EA         ld   (body_state), a
 369+ 7040 32 50 EE         ld   (player_old_body), a
 370+ 7043
 371+ 7043                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 372+ 7043 23               inc  hl                        ; Byte 2 (Direction)
 373+ 7044 7E               ld   a, (hl)
 374+ 7045 E6 01            and  1
 375+ 7047 28 04            jr   z, .facing_right
 376+ 7049 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 377+ 704B 18 02            jr   .set_dir
 378+ 704D              .facing_right:
 379+ 704D 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 380+ 704F              .set_dir:
 381+ 704F 32 4E EA         ld   (direction), a
 382+ 7052 32 4F EE         ld   (player_old_dir), a
 383+ 7055
 384+ 7055                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 385+ 7055 23               inc  hl                        ; Byte 3 (Airborne)
 386+ 7056 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 387+ 7057 4E               ld   c, (hl)
 388+ 7058 23               inc  hl                        ; Byte 5 (AttrAddr High)
 389+ 7059 7E               ld   a, (hl)
 390+ 705A
 391+ 705A                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 392+ 705A 67               ld   h, a
 393+ 705B 69               ld   l, c
 394+ 705C 01 00 A4         ld   bc, -23552
 395+ 705F 09               add  hl, bc
 396+ 7060
 397+ 7060 7D               ld   a, l
 398+ 7061 E6 1F            and  31
 399+ 7063 87               add  a, a                      ; *2
 400+ 7064 87               add  a, a                      ; *4

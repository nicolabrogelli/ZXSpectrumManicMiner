1309+ 651D                  ; 9. Solo DOPO la pausa, fa comparire GAME OVER al centro dello schermo a riga 5, colonna 11
1310+ 651D 3E 16            ld   a, 22                 ; AT (22)
1311+ 651F D7               rst  $10
1312+ 6520 3E 05            ld   a, 5                  ; Riga 5
1313+ 6522 D7               rst  $10
1314+ 6523 3E 0B            ld   a, 11                 ; Colonna 11
1315+ 6525 D7               rst  $10

2781+ 6BCF 23               inc  hl
2782+ 6BD0 E5               push hl
2783+ 6BD1 DD E1            pop  ix                    ; IX = inizio bitmap 32 byte del portale
2784+ 6BD3
2785+ 6BD3                  ; Salta 32 byte bitmap per leggere AttrAddr (offset 688)
2786+ 6BD3 11 20 00         ld   de, 32
2787+ 6BD6 19               add  hl, de
2788+ 6BD7 4E               ld   c, (hl)
2789+ 6BD8 23               inc  hl
2790+ 6BD9 46               ld   b, (hl)               ; BC = AttrAddr (es. 23997)
2791+ 6BDA
2792+ 6BDA                  ; Calcola AttrOffset = BC - 23552
2793+ 6BDA 60               ld   h, b
2794+ 6BDB 69               ld   l, c
2795+ 6BDC 01 00 A4         ld   bc, -23552
2796+ 6BDF 09               add  hl, bc                ; HL = AttrOffset
2797+ 6BE0
2798+ 6BE0                  ; Col = AttrOffset & 31
2799+ 6BE0 7D               ld   a, l
2800+ 6BE1 E6 1F            and  31
2801+ 6BE3 32 F6 E5         ld   (portal_col), a
2802+ 6BE6 4F               ld   c, a                  ; C = Col (0..31)
2803+ 6BE7
2804+ 6BE7                  ; Row = AttrOffset / 32
2805+ 6BE7 CB 3C            srl  h
2805+ 6BE9 CB 1D          rr l
2806+ 6BEB CB 3C            srl  h
2806+ 6BED CB 1D          rr l
2807+ 6BEF CB 3C            srl  h
2807+ 6BF1 CB 1D          rr l
2808+ 6BF3 CB 3C            srl  h
2808+ 6BF5 CB 1D          rr l

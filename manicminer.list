  92+ F0D0 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ F0D1 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ F0D2 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F0D3 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F0D4 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

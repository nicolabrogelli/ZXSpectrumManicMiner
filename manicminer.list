  55+ 7D3C 10 F4            djnz .init_old_pos
  56+ 7D3E
  57+ 7D3E                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D3E DD 21 BF 7C      ld   ix, ActiveEnemies

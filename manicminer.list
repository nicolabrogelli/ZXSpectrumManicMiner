   7+ 6C87              ; Input_CheckCtrl
   8+ 6C87              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6C87              ;
  10+ 6C87              ; Output:
  11+ 6C87              ;   D = bitmask tasti attivi:
  12+ 6C87              ;       bit 0 → sinistra (O)
  13+ 6C87              ;       bit 1 → destra   (P)
  14+ 6C87              ;       bit 2 → salto    (Z)
  15+ 6C87              ;
  16+ 6C87              ; Effetti collaterali in RAM:
  17+ 6C87              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6C87              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6C87              ;   (jump_prev)     → debounce tasto salto
  20+ 6C87              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6C87              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 6C87              ; -------------------------------------------------------------------
  23+ 6C87
  24+ 6C87              Input_CheckCtrl:
  25+ 6C87 AF               xor  a
  26+ 6C88 32 BD 8D         ld   (current_input_dir), a
  27+ 6C8B
  28+ 6C8B                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 6C8B                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 6C8B                  ;
  31+ 6C8B                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 6C8B                  ; Se bit 0 = 0, Q è premuto.
  33+ 6C8B
  34+ 6C8B 01 FE FB         ld   bc, $fbfe
  35+ 6C8E ED 78            in   a, (c)
  36+ 6C90 CB 47            bit  0, a
  37+ 6C92 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 6C94
  39+ 6C94                  ; Q è premuto: debounce tramite (q_prev).
  40+ 6C94                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 6C94 3A BE 8D         ld   a, (q_prev)
  42+ 6C97 B7               or   a
  43+ 6C98 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 6C9A
  45+ 6C9A                  ; ── Primo frame di pressione di Q ──
  46+ 6C9A 3E 01            ld   a, 1
  47+ 6C9C 32 BE 8D         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 6C9F
  49+ 6C9F                  ; NOTA sullo stack:
  50+ 6C9F                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 6C9F                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 6C9F                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 6C9F                  ; poi JP salta direttamente.
  54+ 6C9F E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 6CA0 C3 52 6D         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 6CA3
  57+ 6CA3              .q_not_pressed:
  58+ 6CA3 AF               xor  a
  59+ 6CA4 32 BE 8D         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 6CA7
  61+ 6CA7              .q_handled:
  62+ 6CA7
  63+ 6CA7                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 6CA7                  ;
  65+ 6CA7                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 6CA7                  ; Se bit 0 = 0, A è premuto.
  67+ 6CA7
  68+ 6CA7 01 FE FD         ld   bc, $fdfe
  69+ 6CAA ED 78            in   a, (c)
  70+ 6CAC CB 47            bit  0, a
  71+ 6CAE 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 6CB0
  73+ 6CB0                  ; A è premuto: debounce tramite (a_prev).
  74+ 6CB0 3A BF 8D         ld   a, (a_prev)
  75+ 6CB3 B7               or   a
  76+ 6CB4 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 6CB6
  78+ 6CB6                  ; ── Primo frame di pressione di A ──
  79+ 6CB6 3E 01            ld   a, 1
  80+ 6CB8 32 BF 8D         ld   (a_prev), a            ; marca "A era premuto"
  81+ 6CBB
  82+ 6CBB E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 6CBC C3 56 6D         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 6CBF
  85+ 6CBF              .a_not_pressed:
  86+ 6CBF AF               xor  a
  87+ 6CC0 32 BF 8D         ld   (a_prev), a            ; A rilasciato → azzera debounce
  88+ 6CC3
  89+ 6CC3              .a_handled:
  90+ 6CC3 CD B7 6D         call Input_CheckWarpKeys
  91+ 6CC6                  ENDIF
  92+ 6CC6

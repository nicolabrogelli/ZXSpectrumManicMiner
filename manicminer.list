  71+ 7EBC ~            ; -------------------------------------------------------------------
  72+ 7EBC ~            ; Audio_UpdateMusic
  73+ 7EBC ~            ;
  74+ 7EBC ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7EBC ~            ; Viene chiamata a ogni frame.
  76+ 7EBC ~            ; -------------------------------------------------------------------
  77+ 7EBC ~            Audio_UpdateMusic:
  78+ 7EBC ~                push af
  79+ 7EBC ~                push bc
  80+ 7EBC ~                push de
  81+ 7EBC ~                push hl
  82+ 7EBC ~
  83+ 7EBC ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7EBC ~                ld   a, (Audio_jump_sound_note)
  85+ 7EBC ~                cp   18
  86+ 7EBC ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7EBC ~
  88+ 7EBC ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7EBC ~                ld   a, (Audio_music_frame_counter)
  90+ 7EBC ~                dec  a
  91+ 7EBC ~                ld   (Audio_music_frame_counter), a
  92+ 7EBC ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7EBC ~
  94+ 7EBC ~                ; Altrimenti carica la nota successiva
  95+ 7EBC ~                ld   a, (Audio_music_note_idx)
  96+ 7EBC ~                inc  a
  97+ 7EBC ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7EBC ~                jr   c, .no_wrap
  99+ 7EBC ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7EBC ~            .no_wrap:
 101+ 7EBC ~                ld   (Audio_music_note_idx), a
 102+ 7EBC ~
 103+ 7EBC ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7EBC ~                ld   e, a
 105+ 7EBC ~                ld   d, 0
 106+ 7EBC ~                ld   hl, Audio_MusicSheet
 107+ 7EBC ~                add  hl, de
 108+ 7EBC ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7EBC ~
 110+ 7EBC ~                ; Leggi durata (secondo byte)
 111+ 7EBC ~                inc  hl
 112+ 7EBC ~                ld   a, (hl)
 113+ 7EBC ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7EBC ~                jr   nz, .dur_ok
 115+ 7EBC ~                ld   a, 1
 116+ 7EBC ~            .dur_ok:
 117+ 7EBC ~                ld   (Audio_music_frame_counter), a
 118+ 7EBC ~
 119+ 7EBC ~            .play_current_note:
 120+ 7EBC ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7EBC ~                ld   a, (Audio_music_note_idx)
 122+ 7EBC ~                ld   e, a
 123+ 7EBC ~                ld   d, 0
 124+ 7EBC ~                ld   hl, Audio_MusicSheet
 125+ 7EBC ~                add  hl, de
 126+ 7EBC ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7EBC ~                ld   a, (hl)                  ; A = delay
 128+ 7EBC ~                or   a
 129+ 7EBC ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7EBC ~
 131+ 7EBC ~                ; Suona la nota: 2 cicli
 132+ 7EBC ~                ld   d, a                     ; D = delay
 133+ 7EBC ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7EBC ~            .note_loop:
 135+ 7EBC ~                ; Speaker ON
 136+ 7EBC ~                ld   a, (room_border_color)
 137+ 7EBC ~                or   $10
 138+ 7EBC ~                out  ($fe), a
 139+ 7EBC ~                ld   c, d
 140+ 7EBC ~            .d1:
 141+ 7EBC ~                push af
 142+ 7EBC ~                pop  af
 143+ 7EBC ~                dec  c
 144+ 7EBC ~                jr   nz, .d1
 145+ 7EBC ~
 146+ 7EBC ~                ; Speaker OFF
 147+ 7EBC ~                ld   a, (room_border_color)
 148+ 7EBC ~                and  $ef
 149+ 7EBC ~                out  ($fe), a
 150+ 7EBC ~                ld   c, d
 151+ 7EBC ~            .d2:
 152+ 7EBC ~                push af
 153+ 7EBC ~                pop  af
 154+ 7EBC ~                dec  c
 155+ 7EBC ~                jr   nz, .d2
 156+ 7EBC ~
 157+ 7EBC ~                djnz .note_loop
 158+ 7EBC ~
 159+ 7EBC ~            .done:
 160+ 7EBC ~                pop  hl
 161+ 7EBC ~                pop  de
 162+ 7EBC ~                pop  bc
 163+ 7EBC ~                pop  af
 164+ 7EBC ~                ret
 165+ 7EBC ~
 166+ 7EBC ~            Audio_MusicSheet:
 167+ 7EBC ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7EBC ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7EBC ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7EBC ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7EBC ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7EBC ~                db 90, 10, 107, 20, 68, 65
 173+ 7EBC                  ELSE
 174+ 7EBC              Audio_UpdateMusic:
 175+ 7EBC C9               ret
 176+ 7EBD                  ENDIF

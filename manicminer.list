1575+ 6615              ; -------------------------------------------------------------------
1576+ 6615              ; Gfx_DrawGameOverScreen
1577+ 6615              ; Esegue la sequenza animata di Game Over:
1578+ 6615              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1579+ 6615              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1580+ 6615              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1581+ 6615              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1582+ 6615              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1583+ 6615              ; -------------------------------------------------------------------
1584+ 6615              Gfx_DrawGameOverScreen:
1585+ 6615 F5               push af
1586+ 6616 C5               push bc
1587+ 6617 D5               push de
1588+ 6618 E5               push hl
1589+ 6619 DD E5            push ix
1590+ 661B
1591+ 661B                  ; 1. Bordo hardware e schermo a nero
1592+ 661B AF               xor  a
1593+ 661C D3 FE            out  ($fe), a              ; Bordo a nero
1594+ 661E CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutti i pixel e gli attributi a nero
1595+ 6621
1596+ 6621                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1597+ 6621                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1598+ 6621 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1599+ 6624 DD 21 9A D9      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1600+ 6628 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1601+ 662B
1602+ 662B                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1603+ 662B 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1604+ 662E DD 21 A2 D9      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1605+ 6632 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1606+ 6635
1607+ 6635                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96
1608+ 6635 01 7C 60         ld   bc, $607c             ; B = Y = 96, C = X = 124
1609+ 6638 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1610+ 663A CD 12 6D         call Gfx_SetEnemyColorAttributes
1611+ 663D
1612+ 663D                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1613+ 663D 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1614+ 6640 DD 21 35 6E      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1615+ 6644 CD 6B 5F         call Gfx_DrawPixelSprite16x16
1616+ 6647
1617+ 6647                  ; 3b. Imposta attributi colore per BotteSprite (Rosso Brillante) a X=120, Y=112
1618+ 6647 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1619+ 664A 3E 42            ld   a, RED | $40          ; Rosso Brillante
1620+ 664C CD 12 6D         call Gfx_SetEnemyColorAttributes
1621+ 664F
1622+ 664F                  ; 4. Stampa il Nome della Stanza a riga 16
1623+ 664F CD BC 62         call Gfx_PrintRoomName
1624+ 6652
1625+ 6652                  ; 5. Stampa la riga di stato a riga 18
1626+ 6652 21 5B 69         ld   hl, status_line       ; HL = indirizzo stringa di stato
1627+ 6655 06 20            ld   b, 32                 ; B = 32 caratteri
1628+ 6657 16 12            ld   d, 18
1629+ 6659 1E 00            ld   e, 0
1630+ 665B CD 3D 62         call Gfx_PrintDirectText
1631+ 665E

  91+ F1F4 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  92+ F1F7 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  93+ F1FA 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  94+ F1FB 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  95+ F1FC 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  96+ F1FD 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  97+ F1FE 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  98+ F1FF 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  99+ F200 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
 100+ F201
 101+ F201 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 102+ F202 00           Audio_jump_sound_timer:   db 0
 103+ F203                  IF ENABLE_MUSIC != 0
 104+ F203 ~            Audio_music_note_idx:      db 0
 105+ F203 ~            Audio_music_frame_counter: db 1
 106+ F203                  ENDIF
 107+ F203
 108+ F203              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 109+ F203 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 110+ F204 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 111+ F205 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 112+ F206
 113+ F206              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 114+ F206 00 00        willy_head_ptr:         dw 0
 115+ F208 00 00        willy_body_ptr:         dw 0
 116+ F20A 00 00        guard_sprite_ptr:       dw 0
 117+ F20C 00           collision_delta_x:      db 0
 118+ F20D 00           collision_delta_y:      db 0
 119+ F20E 00           row_enemy_cur:          db 0
 120+ F20F 00           row_willy_cur:          db 0
 121+ F210 00           overlap_num_lines:      db 0
 122+ F211
 123+ F211              ; Interrupt
 124+ F211              IM2_TABLE   = $FE00
 125+ F211              IM2_VECTOR  = $FDFD
 126+ F211              SCREEN_LINE = $4860
 127+ F211              SCREEN_MEMORY = $4000

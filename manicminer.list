 541  85E3              ; -------------------------------------------------------------------
 542  85E3              ; TriggerVictory
 543  85E3              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 544  85E3              ; - Pulisce gli elementi di gioco della stanza.
 545  85E3              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 546  85E3              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 547  85E3              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 548  85E3              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 549  85E3              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 550  85E3              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 551  85E3              ; -------------------------------------------------------------------
 552  85E3              TriggerVictory:
 553  85E3                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 554  85E3 CD F7 66         call Gfx_DrawVictoryScreen
 555  85E6
 556  85E6                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 557  85E6              .wait_keys_release:
 558  85E6 76               halt
 559  85E7                  ; Controlla tasto Y (Porta $DF, bit 4)
 560  85E7 01 FE DF         ld   bc, $dffe
 561  85EA ED 78            in   a, (c)
 562  85EC CB 67            bit  4, a
 563  85EE 28 F6            jr   z, .wait_keys_release
 564  85F0
 565  85F0                  ; Controlla tasto N (Porta $7F, bit 3)
 566  85F0 01 FE 7F         ld   bc, $7ffe
 567  85F3 ED 78            in   a, (c)
 568  85F5 CB 5F            bit  3, a
 569  85F7 28 ED            jr   z, .wait_keys_release
 570  85F9
 571  85F9                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 572  85F9 01 FE BF         ld   bc, $bffe
 573  85FC ED 78            in   a, (c)
 574  85FE CB 47            bit  0, a
 575  8600 28 E4            jr   z, .wait_keys_release
 576  8602
 577  8602                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 578  8602 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 579  8604              .wait_choice_loop:
 580  8604 76               halt
 581  8605
 582  8605                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 583  8605 0C               inc  c
 584  8606 79               ld   a, c
 585  8607 CB 3F            srl  a
 586  8609 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 587  860B E6 07            and  7
 588  860D 5F               ld   e, a
 589  860E 16 00            ld   d, 0
 590  8610 21 D6 65         ld   hl, victory_color_table
 591  8613 19               add  hl, de
 592  8614 7E               ld   a, (hl)               ; A = nuovo colore attributo
 593  8615 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 594  8618 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 595  861A              .color_cycle_loop:
 596  861A 77               ld   (hl), a
 597  861B 23               inc  hl
 598  861C 10 FC            djnz .color_cycle_loop
 599  861E
 600  861E                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 601  861E 01 FE DF         ld   bc, $dffe
 602  8621 ED 78            in   a, (c)
 603  8623 CB 67            bit  4, a
 604  8625 28 2A            jr   z, .play_again_chosen
 605  8627
 606  8627                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 607  8627 01 FE 7F         ld   bc, $7ffe
 608  862A ED 78            in   a, (c)
 609  862C CB 5F            bit  3, a
 610  862E 28 0B            jr   z, .quit_chosen
 611  8630

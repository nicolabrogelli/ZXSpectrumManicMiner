 596+ 7FCE              ; CheckCollision
 597+ 7FCE              ;
 598+ 7FCE              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 599+ 7FCE              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 600+ 7FCE              ; Output:
 601+ 7FCE              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 602+ 7FCE              ;   Carry Clear = Nessuna collisione
 603+ 7FCE              ; -------------------------------------------------------------------
 604+ 7FCE              CheckCollision:
 605+ 7FCE DD E5            push ix
 606+ 7FD0 C5               push bc
 607+ 7FD1 D5               push de
 608+ 7FD2 E5               push hl
 609+ 7FD3
 610+ 7FD3                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 611+ 7FD3 3A 15 E3         ld   a, (willy_safety_timer)
 612+ 7FD6 B7               or   a
 613+ 7FD7 C2 27 81         jp   nz, .no_collision_found
 614+ 7FDA
 615+ 7FDA                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 616+ 7FDA 3A 10 DF         ld   a, (direction)
 617+ 7FDD FE 01            cp   1                         ; Sinistra?
 618+ 7FDF 20 1A            jr   nz, .willy_right
 619+ 7FE1
 620+ 7FE1                  ; Willy a Sinistra:
 621+ 7FE1 21 E9 D8         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 622+ 7FE4 22 2B E5         ld   (willy_head_ptr), hl

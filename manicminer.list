 408+ 81A7              ; CheckWillyItemCollision
 409+ 81A7              ;
 410+ 81A7              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81A7              ; Input:
 412+ 81A7              ;   A = Item Col (0..31)
 413+ 81A7              ;   H = Item Row (0..15)
 414+ 81A7              ; Output:
 415+ 81A7              ;   Carry Set = Collisione
 416+ 81A7              ;   Carry Clear = Nessuna collisione
 417+ 81A7              ; -------------------------------------------------------------------
 418+ 81A7              CheckWillyItemCollision:
 419+ 81A7 C5               push bc
 420+ 81A8 D5               push de
 421+ 81A9 E5               push hl
 422+ 81AA
 423+ 81AA                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 81AA 6F               ld   l, a
 425+ 81AB 87               add  a, a                      ; *2
 426+ 81AC 87               add  a, a                      ; *4
 427+ 81AD 87               add  a, a                      ; *8
 428+ 81AE 5F               ld   e, a                      ; E = ItemLeft
 429+ 81AF C6 07            add  a, 7
 430+ 81B1 57               ld   d, a                      ; D = ItemRight
 431+ 81B2
 432+ 81B2 ED 4B 00 9E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81B6
 434+ 81B6                  ; WillyLeft <= ItemRight
 435+ 81B6 79               ld   a, c                      ; A = WillyX
 436+ 81B7 BA               cp   d                         ; D = ItemRight
 437+ 81B8 28 04            jr   z, .x_ok
 438+ 81BA 38 02            jr   c, .x_ok
 439+ 81BC 18 31            jr   .no_collision
 440+ 81BE
 441+ 81BE              .x_ok:
 442+ 81BE                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81BE BB               cp   e                         ; E = ItemLeft
 444+ 81BF 28 0B            jr   z, .y_check
 445+ 81C1 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81C3
 447+ 81C3                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81C3 C6 0F            add  a, 15
 449+ 81C5 BB               cp   e
 450+ 81C6 28 04            jr   z, .y_check
 451+ 81C8 30 02            jr   nc, .y_check
 452+ 81CA 18 23            jr   .no_collision
 453+ 81CC
 454+ 81CC              .y_check:
 455+ 81CC                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81CC 7C               ld   a, h                      ; H = Item Row
 457+ 81CD 87               add  a, a                      ; *2
 458+ 81CE 87               add  a, a                      ; *4
 459+ 81CF 87               add  a, a                      ; *8

 703+ 60AF CB 3F            srl  a
 703+ 60B1 CB 3F          srl a
 703+ 60B3 CB 3F          srl a
 704+ 60B5 67               ld   h, a                  ; H = RowStart (0..15)
 705+ 60B6
 706+ 60B6 78               ld   a, b
 707+ 60B7 C6 0F            add  a, 15
 708+ 60B9 CB 3F            srl  a
 708+ 60BB CB 3F          srl a

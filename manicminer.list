 192+ 8873 D3 FE            out  ($fe), a
 193+ 8875
 194+ 8875 0E 3C            ld   c, 60
 195+ 8877              .d1:
 196+ 8877 0D               dec  c
 197+ 8878 20 FD            jr   nz, .d1
 198+ 887A
 199+ 887A 3A 91 EA         ld   a, (room_border_color)
 200+ 887D E6 EF            and  $ef              ; speaker OFF
 201+ 887F D3 FE            out  ($fe), a
 202+ 8881
 203+ 8881 0E 3C            ld   c, 60
 204+ 8883              .d2:
 205+ 8883 0D               dec  c
 206+ 8884 20 FD            jr   nz, .d2
 207+ 8886
 208+ 8886 10 E6            djnz .sound_loop

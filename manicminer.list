 219+ 7BBD DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7BC0 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7BC3 20 0E            jr   nz, .do_erase_slot
 222+ 7BC5 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7BC8 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7BCB 20 06            jr   nz, .do_erase_slot
 225+ 7BCD
 226+ 7BCD 3A 7A 93         ld   a, (enemy_was_updated)
 227+ 7BD0 B7               or   a
 228+ 7BD1 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7BD3

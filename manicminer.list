 121+ 7D96 23               inc  hl
 122+ 7D97 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7D98 E6 1F            and  31
 124+ 7D9A 87               add  a, a
 124+ 7D9B 87             add a, a
 124+ 7D9C 87             add a, a
 125+ 7D9D DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DA0
 127+ 7DA0 23               inc  hl
 128+ 7DA1 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DA2 E6 1F            and  31
 130+ 7DA4 87               add  a, a
 130+ 7DA5 87             add a, a
 130+ 7DA6 87             add a, a
 131+ 7DA7 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DAA
 133+ 7DAA 23               inc  hl                        ; Prossimo guardiano
 134+ 7DAB 11 0B 00         ld   de, 11
 135+ 7DAE DD 19            add  ix, de
 136+ 7DB0 10 8E            djnz .load_h_loop

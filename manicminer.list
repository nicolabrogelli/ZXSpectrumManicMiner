 888+ 77D0              IsCellOnRamp:
 889+ 77D0 C5               push bc
 890+ 77D1 E5               push hl
 891+ 77D2
 892+ 77D2 3A 5F A1         ld   a, (ramp_len)
 893+ 77D5 B7               or   a
 894+ 77D6 28 6B            jr   z, .no
 895+ 77D8
 896+ 77D8                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 897+ 77D8 3A 5E A1         ld   a, (ramp_dir)
 898+ 77DB B7               or   a
 899+ 77DC 28 1A            jr   z, .range_left
 900+ 77DE              .range_right:
 901+ 77DE 3A 61 A1         ld   a, (ramp_col)
 902+ 77E1 47               ld   b, a              ; B = ramp_col
 903+ 77E2 3A 5F A1         ld   a, (ramp_len)
 904+ 77E5 80               add  a, b              ; A = ramp_col + ramp_len
 905+ 77E6 4F               ld   c, a              ; C = limit_right (exclusive)
 906+ 77E7
 907+ 77E7 7B               ld   a, e              ; A = Col
 908+ 77E8 B8               cp   b
 909+ 77E9 38 34            jr   c, .check_platform_case ; Col < ramp_col
 910+ 77EB B9               cp   c
 911+ 77EC 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 912+ 77EE
 913+ 77EE                  ; Calcola B = Col - ramp_col
 914+ 77EE 7B               ld   a, e
 915+ 77EF 90               sub  b
 916+ 77F0 47               ld   b, a              ; B = offset (0..ramp_len-1)
 917+ 77F1
 918+ 77F1                  ; SlopeRow = ramp_row - B
 919+ 77F1 3A 60 A1         ld   a, (ramp_row)
 920+ 77F4 90               sub  b

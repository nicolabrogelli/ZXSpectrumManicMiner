 294  84A1              ; ShowTitleScreen
 295  84A1              ; Visualizza la schermata iniziale del gioco (Title Screen).
 296  84A1              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 297  84A1              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 298  84A1              ; -------------------------------------------------------------------
 299  84A1              ShowTitleScreen:
 300  84A1                  ; 1. Disegna la schermata iniziale
 301  84A1 CD FD 63         call Gfx_DrawTitleScreen
 302  84A4
 303  84A4                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 304  84A4              .wait_title_enter_release:
 305  84A4 76               halt
 306  84A5 3E BF            ld   a, $bf
 307  84A7 DB FE            in   a, ($fe)
 308  84A9 1F               rra
 309  84AA 30 F8            jr   nc, .wait_title_enter_release
 310  84AC
 311  84AC                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 312  84AC 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 313  84AE              .title_loop:
 314  84AE 76               halt
 315  84AF
 316  84AF                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 317  84AF 0C               inc  c
 318  84B0 79               ld   a, c
 319  84B1 CB 3F            srl  a
 320  84B3 CB 3F            srl  a
 321  84B5 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 322  84B7 E6 07            and  7
 323  84B9 5F               ld   e, a
 324  84BA 16 00            ld   d, 0
 325  84BC 21 F5 63         ld   hl, title_color_table
 326  84BF 19               add  hl, de
 327  84C0 7E               ld   a, (hl)               ; A = nuovo colore
 328  84C1 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 329  84C4 06 20            ld   b, 32

 472+ 83C8 BA               cp   d                         ; D = ItemBottom
 473+ 83C9 28 04            jr   z, .y_ok
 474+ 83CB 38 02            jr   c, .y_ok
 475+ 83CD 18 13            jr   .no_collision
 476+ 83CF
 477+ 83CF              .y_ok:
 478+ 83CF                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 83CF BB               cp   e                         ; E = ItemTop
 480+ 83D0 28 0B            jr   z, .collision
 481+ 83D2 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 83D4
 483+ 83D4                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop

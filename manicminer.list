 430+ 7EE0
 431+ 7EE0                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 432+ 7EE0 DD 7E 08         ld   a, (ix+8)         ; Old X
 433+ 7EE3 DD BE 02         cp   (ix+2)            ; Current X
 434+ 7EE6 20 0E            jr   nz, .do_draw_slot
 435+ 7EE8 DD 7E 09         ld   a, (ix+9)         ; Old Y
 436+ 7EEB DD BE 03         cp   (ix+3)            ; Current Y
 437+ 7EEE 20 06            jr   nz, .do_draw_slot
 438+ 7EF0
 439+ 7EF0 3A 94 E5         ld   a, (enemy_was_updated)
 440+ 7EF3 B7               or   a
 441+ 7EF4 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!

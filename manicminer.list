  58+ 5E10
  59+ 5E10              ; -------------------------------------------------------------------
  60+ 5E10              ; Calcola indirizzo schermo da coordinate pixel (X, Y)
  61+ 5E10              ; Input: H = Y (0..191), L = X (0..255)
  62+ 5E10              ; Output: HL = indirizzo schermo
  63+ 5E10              ; -------------------------------------------------------------------
  64+ 5E10              Gfx_GetScreenAddr:
  65+ 5E10 7C               ld a, h
  66+ 5E11 E6 07            and %00000111     ; A = y2 y1 y0 (scanline offset)
  67+ 5E13 F6 40            or  %01000000     ; Base dello schermo ($40)
  68+ 5E15 57               ld  d, a          ; D = high byte parziale
  69+ 5E16
  70+ 5E16 7C               ld  a, h
  71+ 5E17 E6 C0            and %11000000     ; A = y7 y6 000000 (third select)
  72+ 5E19 0F               rrca
  73+ 5E1A 0F               rrca
  74+ 5E1B 0F               rrca              ; Shift a destra di 3 -> 000 y7 y6 000
  75+ 5E1C B2               or  d
  76+ 5E1D 57               ld  d, a          ; D = high byte completo (010 y7 y6 y2 y1 y0)
  77+ 5E1E
  78+ 5E1E 7C               ld  a, h
  79+ 5E1F E6 38            and %00111000     ; A = 00 y5 y4 y3 000 (character row)
  80+ 5E21 87               add a, a
  81+ 5E22 87               add a, a          ; Shift a sinistra di 2 -> y5 y4 y3 00000
  82+ 5E23 5F               ld  e, a          ; E = low byte parziale
  83+ 5E24
  84+ 5E24 7D               ld  a, l
  85+ 5E25 CB 3F            srl a
  86+ 5E27 CB 3F            srl a
  87+ 5E29 CB 3F            srl a              ; A = X / 8 (colonna)
  88+ 5E2B B3               or  e
  89+ 5E2C 5F               ld  e, a          ; E = low byte completo
  90+ 5E2D
  91+ 5E2D 62               ld  h, d
  92+ 5E2E 6B               ld  l, e          ; HL = indirizzo finale
  93+ 5E2F C9               ret
  94+ 5E30
  95+ 5E30              ; -------------------------------------------------------------------
  96+ 5E30              ; Incrementa indirizzo schermo alla riga (scanline) successiva
  97+ 5E30              ; Input/Output: HL = indirizzo schermo
  98+ 5E30              ; -------------------------------------------------------------------
  99+ 5E30              Gfx_IncScreenLine:
 100+ 5E30 24               inc h             ; Vai alla riga successiva
 101+ 5E31 7C               ld  a, h
 102+ 5E32 E6 07            and 7             ; Controlla se la scanline è tornata a 0 (wrap)
 103+ 5E34 C0               ret nz            ; Se non è 0, abbiamo finito!
 104+ 5E35
 105+ 5E35 7D               ld  a, l
 106+ 5E36 C6 20            add a, 32         ; Altrimenti passa alla riga di caratteri successiva
 107+ 5E38 6F               ld  l, a
 108+ 5E39 D8               ret c             ; Se c'è carry, abbiamo cambiato terzo e H è già corretto!
 109+ 5E3A
 110+ 5E3A                  ; Se non c'è carry, rimaniamo nello stesso terzo. Ripristina il terzo corretto in H.
 111+ 5E3A 7C               ld  a, h
 112+ 5E3B D6 08            sub 8
 113+ 5E3D 67               ld  h, a
 114+ 5E3E C9               ret

 285  891A              ; -------------------------------------------------------------------
 286  891A              ; ShowTitleScreen
 287  891A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 288  891A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 289  891A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 290  891A              ; -------------------------------------------------------------------
 291  891A              ShowTitleScreen:
 292  891A                  ; 1. Disegna la schermata iniziale
 293  891A CD 7A 64         call Gfx_DrawTitleScreen
 294  891D
 295  891D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 296  891D              .wait_title_enter_release:
 297  891D 76               halt
 298  891E 3E BF            ld   a, $bf
 299  8920 DB FE            in   a, ($fe)
 300  8922 1F               rra
 301  8923 30 F8            jr   nc, .wait_title_enter_release
 302  8925
 303  8925                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 304  8925 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 305  8927              .title_loop:
 306  8927 76               halt
 307  8928
 308  8928                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 309  8928 0C               inc  c
 310  8929 79               ld   a, c
 311  892A CB 3F            srl  a
 312  892C CB 3F            srl  a
 313  892E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 314  8930 E6 07            and  7
 315  8932 5F               ld   e, a
 316  8933 16 00            ld   d, 0
 317  8935 21 72 64         ld   hl, title_color_table
 318  8938 19               add  hl, de
 319  8939 7E               ld   a, (hl)               ; A = nuovo colore
 320  893A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  893D 06 20            ld   b, 32
 322  893F              .color_title_loop:
 323  893F 77               ld   (hl), a
 324  8940 23               inc  hl
 325  8941 10 FC            djnz .color_title_loop
 326  8943
 327  8943                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 328  8943 3E BF            ld   a, $bf
 329  8945 DB FE            in   a, ($fe)
 330  8947 1F               rra
 331  8948 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 332  894A
 333  894A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 334  894A              .wait_title_enter_release_after:
 335  894A 76               halt
 336  894B 3E BF            ld   a, $bf
 337  894D DB FE            in   a, ($fe)
 338  894F 1F               rra
 339  8950 30 F8            jr   nc, .wait_title_enter_release_after

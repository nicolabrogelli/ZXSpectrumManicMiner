 260+ 7E27 3E 46            ld   a, 70                     ; Kong colore in Return of the Alien Kong: Bright 1, Paper 0, Ink 6 (Giallo) -> 70
 261+ 7E29 18 02            jr   .init_kong_slot
 262+ 7E2B
 263+ 7E2B              .is_kong_room1:

  87+ 89BD ~
  88+ 89BD ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 89BD ~                ld   a, (Audio_music_frame_counter)
  90+ 89BD ~                dec  a
  91+ 89BD ~                ld   (Audio_music_frame_counter), a
  92+ 89BD ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 89BD ~
  94+ 89BD ~                ; Altrimenti carica la nota successiva
  95+ 89BD ~                ld   a, (Audio_music_note_idx)
  96+ 89BD ~                inc  a
  97+ 89BD ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 89BD ~                jr   c, .no_wrap
  99+ 89BD ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 89BD ~            .no_wrap:
 101+ 89BD ~                ld   (Audio_music_note_idx), a
 102+ 89BD ~
 103+ 89BD ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 89BD ~                ld   e, a
 105+ 89BD ~                ld   d, 0
 106+ 89BD ~                ld   hl, Audio_MusicSheet
 107+ 89BD ~                add  hl, de
 108+ 89BD ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 89BD ~
 110+ 89BD ~                ; Leggi durata (secondo byte)
 111+ 89BD ~                inc  hl
 112+ 89BD ~                ld   a, (hl)
 113+ 89BD ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 89BD ~                jr   nz, .dur_ok
 115+ 89BD ~                ld   a, 1
 116+ 89BD ~            .dur_ok:
 117+ 89BD ~                ld   (Audio_music_frame_counter), a
 118+ 89BD ~
 119+ 89BD ~            .play_current_note:
 120+ 89BD ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 89BD ~                ld   a, (Audio_music_note_idx)
 122+ 89BD ~                ld   e, a
 123+ 89BD ~                ld   d, 0
 124+ 89BD ~                ld   hl, Audio_MusicSheet
 125+ 89BD ~                add  hl, de
 126+ 89BD ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 89BD ~                ld   a, (hl)                  ; A = delay
 128+ 89BD ~                or   a
 129+ 89BD ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 89BD ~
 131+ 89BD ~                ; Suona la nota: 2 cicli
 132+ 89BD ~                ld   d, a                     ; D = delay
 133+ 89BD ~                ld   b, 2                     ; 2 cicli per frame
 134+ 89BD ~            .note_loop:
 135+ 89BD ~                ; Speaker ON
 136+ 89BD ~                ld   a, (room_border_color)
 137+ 89BD ~                or   $10
 138+ 89BD ~                out  ($fe), a
 139+ 89BD ~                ld   c, d
 140+ 89BD ~            .d1:
 141+ 89BD ~                push af
 142+ 89BD ~                pop  af

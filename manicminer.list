 568  8B7D
 569  8B7D              ; Alias per retrocompatibilità
 570  8B7D              CheckVictoryCondition: EQU CheckPortalTransition
 571  8B7D
 572  8B7D              ; -------------------------------------------------------------------
 573  8B7D              ; TriggerPortalTransition
 574  8B7D              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8B7D              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8B7D              ; - Avanza all'indice della stanza successiva.
 577  8B7D              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8B7D              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8B7D              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8B7D              ; -------------------------------------------------------------------
 581  8B7D              TriggerPortalTransition:
 582  8B7D                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8B7D CD B4 8B         call Air_DepleteCountdown
 584  8B80
 585  8B80                  ; 1. Determina l'ID della stanza corrente
 586  8B80 CD 44 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8B83
 588  8B83                  ; 2. Calcola l'indice della stanza successiva
 589  8B83 3A 17 EE         ld   a, (current_room)
 590  8B86 3C               inc  a
 591  8B87 FE 14            cp   NUM_ROOMS
 592  8B89 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8B8B
 594  8B8B                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8B8B 21 A2 73         ld   hl, RoomsListTable
 596  8B8E 5F               ld   e, a
 597  8B8F 16 00            ld   d, 0
 598  8B91 19               add  hl, de
 599  8B92 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8B93 5E               ld   e, (hl)
 601  8B94 23               inc  hl
 602  8B95 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8B96 ED 53 72 EE      ld   (room_ptr), de
 604  8B9A
 605  8B9A                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8B9A AF               xor  a
 607  8B9B 32 78 EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8B9E 32 FF EA         ld   (velocity_y), a
 609  8BA1 32 0A F1         ld   (game_objective_completed), a
 610  8BA4 3E 01            ld   a, 1
 611  8BA6 32 00 EB         ld   (on_ground), a
 612  8BA9
 613  8BA9                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8BA9 3E 07            ld   a, $07
 615  8BAB CD 9D 62         call Gfx_ClearScreenDirect
 616  8BAE
 617  8BAE C3 19 89         jp   LoadRoomAndRestart
 618  8BB1
 619  8BB1              .all_rooms_completed:
 620  8BB1                  ; Tutte le stanze sono state completate con successo!
 621  8BB1                  IF ENABLE_VICTORY_SCREEN != 0
 622  8BB1 C3 A5 8A         jp   TriggerVictory
 623  8BB4                  ELSE
 624  8BB4 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8BB4 ~                ld   de, (RoomsListTable)
 626  8BB4 ~                ld   (room_ptr), de
 627  8BB4 ~                xor  a
 628  8BB4 ~                ld   (transition_active), a
 629  8BB4 ~                ld   (velocity_y), a
 630  8BB4 ~                ld   (game_objective_completed), a
 631  8BB4 ~                ld   a, 1
 632  8BB4 ~                ld   (on_ground), a
 633  8BB4 ~                ld   a, $07
 634  8BB4 ~                call Gfx_ClearScreenDirect
 635  8BB4 ~                jp   LoadRoomAndRestart
 636  8BB4                  ENDIF
 637  8BB4
 638  8BB4              ; -------------------------------------------------------------------
 639  8BB4              ; Air_DepleteCountdown
 640  8BB4              ; Animazione originale di completamento livello (Manic Miner):
 641  8BB4              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8BB4              ; - Ad ogni pixel decrementato:
 643  8BB4              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8BB4              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8BB4              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8BB4              ; -------------------------------------------------------------------
 647  8BB4              Air_DepleteCountdown:
 648  8BB4 F5               push af
 649  8BB5 C5               push bc
 650  8BB6 D5               push de
 651  8BB7 E5               push hl
 652  8BB8
 653  8BB8              .countdown_loop:
 654  8BB8 3A 13 F1         ld   a, (air_pixels)
 655  8BBB B7               or   a
 656  8BBC 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8BBE
 658  8BBE 3D               dec  a
 659  8BBF 32 13 F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8BC2
 661  8BC2                  ; Aggiorna la barra grafica dell'aria
 662  8BC2 CD 2D 6A         call Gfx_UpdateAirBar
 663  8BC5
 664  8BC5                  ; Aggiungi 1 punto allo score
 665  8BC5 CD B8 87         call Score_Add1Point
 666  8BC8
 667  8BC8                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8BC8                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8BC8 3A 13 F1         ld   a, (air_pixels)
 670  8BCB 2F               cpl
 671  8BCC E6 3F            and  63
 672  8BCE 07               rlca
 673  8BCF 3C               inc  a
 674  8BD0 57               ld   d, a                      ; D = ritardo semionda audio
 675  8BD1
 676  8BD1 0E 03            ld   c, 3                      ; Durata impulso
 677  8BD3              .audio_loop:
 678  8BD3 AF               xor  a
 679  8BD4 D3 FE            out  ($fe), a
 680  8BD6 42               ld   b, d
 681  8BD7 10 FE        .w1: djnz .w1
 682  8BD9
 683  8BD9 3E 18            ld   a, $18
 684  8BDB D3 FE            out  ($fe), a
 685  8BDD 42               ld   b, d
 686  8BDE 10 FE        .w2: djnz .w2
 687  8BE0
 688  8BE0 0D               dec  c
 689  8BE1 20 F0            jr   nz, .audio_loop
 690  8BE3
 691  8BE3 18 D3            jr   .countdown_loop
 692  8BE5
 693  8BE5              .done_countdown:
 694  8BE5 E1               pop  hl
 695  8BE6 D1               pop  de
 696  8BE7 C1               pop  bc
 697  8BE8 F1               pop  af
 698  8BE9 C9               ret
 699  8BEA
 700  8BEA              ; -------------------------------------------------------------------
 701  8BEA              ; CheckAllItemsCollected
 702  8BEA              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8BEA              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8BEA              ; -------------------------------------------------------------------
 705  8BEA              CheckAllItemsCollected:
 706  8BEA 3A 0A F1         ld   a, (game_objective_completed)
 707  8BED B7               or   a
 708  8BEE 20 08            jr   nz, .all_collected
 709  8BF0 3A 71 EE         ld   a, (num_room_items)
 710  8BF3 B7               or   a
 711  8BF4 28 02            jr   z, .all_collected
 712  8BF6 B7               or   a
 713  8BF7 C9               ret
 714  8BF8              .all_collected:
 715  8BF8 37               scf
 716  8BF9 C9               ret

 864+ 776C 3A 1A E5         ld   a, (ramp_len)
 865+ 776F 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7770 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7771
 868+ 7771 7B               ld   a, e              ; A = Col
 869+ 7772 B8               cp   b
 870+ 7773 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7775 B9               cp   c
 872+ 7776 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 7778

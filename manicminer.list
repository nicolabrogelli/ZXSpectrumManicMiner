 766  8277              ; CheckWillyConveyorCollision
 767  8277              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 768  8277              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 769  8277              ; -------------------------------------------------------------------
 770  8277              CheckWillyConveyorCollision:
 771  8277 C5               push bc
 772  8278 D5               push de
 773  8279 E5               push hl
 774  827A
 775  827A                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 776  827A CD AE 74         call CheckWillyOnConveyor
 777  827D 38 49            jr   c, .collision_detected
 778  827F
 779  827F                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 780  827F 3A 14 91         ld   a, (conveyor_len)
 781  8282 B7               or   a
 782  8283 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 783  8285
 784  8285                  ; B = WillyY, C = WillyX
 785  8285 ED 4B EC 8D      ld   bc, (PlayerPos)
 786  8289
 787  8289                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 788  8289 3A 15 91         ld   a, (conveyor_row)
 789  828C 87               add  a, a                  ; *2
 790  828D 87               add  a, a                  ; *4
 791  828E 87               add  a, a                  ; *8
 792  828F 5F               ld   e, a                  ; E = ConveyorTop
 793  8290 C6 07            add  a, 7
 794  8292 57               ld   d, a                  ; D = ConveyorBottom
 795  8293
 796  8293                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 797  8293 78               ld   a, b                  ; WillyTop
 798  8294 BA               cp   d
 799  8295 28 04            jr   z, .y_overlap
 800  8297 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 801  8299 18 32            jr   .no_conv_collision
 802  829B
 803  829B              .y_overlap:
 804  829B C6 0F            add  a, 15                 ; WillyBottom
 805  829D BB               cp   e
 806  829E 28 04            jr   z, .x_check
 807  82A0 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 808  82A2 18 29            jr   .no_conv_collision
 809  82A4
 810  82A4              .x_check:
 811  82A4                  ; ConveyorLeft = conveyor_col * 8
 812  82A4 3A 16 91         ld   a, (conveyor_col)
 813  82A7 87               add  a, a                  ; *2
 814  82A8 87               add  a, a                  ; *4
 815  82A9 87               add  a, a                  ; *8
 816  82AA 5F               ld   e, a                  ; E = ConveyorLeft
 817  82AB
 818  82AB                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 819  82AB 21 14 91         ld   hl, conveyor_len
 820  82AE 3A 16 91         ld   a, (conveyor_col)
 821  82B1 86               add  a, (hl)
 822  82B2 87               add  a, a                  ; *2
 823  82B3 87               add  a, a                  ; *4
 824  82B4 87               add  a, a                  ; *8
 825  82B5 3D               dec  a                     ; ConveyorRight
 826  82B6 57               ld   d, a                  ; D = ConveyorRight
 827  82B7
 828  82B7                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 829  82B7 79               ld   a, c                  ; WillyLeft
 830  82B8 BA               cp   d
 831  82B9 28 04            jr   z, .x_overlap
 832  82BB 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 833  82BD 18 0E            jr   .no_conv_collision
 834  82BF
 835  82BF              .x_overlap:
 836  82BF C6 0F            add  a, 15                 ; WillyRight
 837  82C1 BB               cp   e
 838  82C2 28 04            jr   z, .collision_detected
 839  82C4 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 840  82C6 18 05            jr   .no_conv_collision
 841  82C8
 842  82C8              .collision_detected:
 843  82C8 E1               pop  hl
 844  82C9 D1               pop  de

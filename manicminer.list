 837  8C6F 32 0E EB         ld   (enter_key_prev), a
 838  8C72 32 FF EA         ld   (velocity_y), a
 839  8C75 32 01 EB         ld   (jump_pressed), a
 840  8C78 32 03 EB         ld   (coyote_timer), a
 841  8C7B 32 06 EB         ld   (jump_frame), a
 842  8C7E 32 05 EB         ld   (jump_dir), a
 843  8C81 32 78 EE         ld   (transition_active), a
 844  8C84 32 FD EE         ld   (willy_safety_timer), a
 845  8C87 3E FF            ld   a, $ff
 846  8C89 32 0F EB         ld   (digit_key_prev), a
 847  8C8C 3E 01            ld   a, 1
 848  8C8E 32 08 EB         ld   (q_prev), a
 849  8C91 32 09 EB         ld   (a_prev), a
 850  8C94 32 00 EB         ld   (on_ground), a

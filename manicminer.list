1875+ 7BC2              ; Phys_UpdateCrumblingFloors
1876+ 7BC2              ; Aggiorna l'animazione di tutti i blocchi sgretolabili attivi.
1877+ 7BC2              ; Quando un blocco completa lo sgretolamento (stadio > 8), viene
1878+ 7BC2              ; definitivamente rimosso dalla fisica (unpacked_layout) e dallo schermo.
1879+ 7BC2              ; -------------------------------------------------------------------
1880+ 7BC2              Phys_UpdateCrumblingFloors:
1881+ 7BC2 3A E3 E7         ld   a, (crumbling_active_count)
1882+ 7BC5 B7               or   a
1883+ 7BC6 C8               ret  z                     ; Nessun blocco attivo -> uscita immediata
1884+ 7BC7
1885+ 7BC7                  ; Avanza l'animazione ogni 2 frame (approx 25Hz per 8 stadi = ~0.32s)
1886+ 7BC7 21 E4 E7         ld   hl, crumbling_anim_timer
1887+ 7BCA 34               inc  (hl)
1888+ 7BCB 7E               ld   a, (hl)
1889+ 7BCC E6 01            and  1
1890+ 7BCE C0               ret  nz
1891+ 7BCF
1892+ 7BCF E5               push hl
1893+ 7BD0 D5               push de
1894+ 7BD1 C5               push bc

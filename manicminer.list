 179+ 7FCD              ; Audio_PlayCollectSound
 180+ 7FCD              ;
 181+ 7FCD              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7FCD              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7FCD              ; -------------------------------------------------------------------
 184+ 7FCD              Audio_PlayCollectSound:
 185+ 7FCD C5               push bc
 186+ 7FCE D5               push de
 187+ 7FCF
 188+ 7FCF 06 78            ld   b, 120
 189+ 7FD1              .sound_loop:
 190+ 7FD1 3A 71 8E         ld   a, (room_border_color)
 191+ 7FD4 F6 10            or   $10               ; speaker ON
 192+ 7FD6 D3 FE            out  ($fe), a
 193+ 7FD8
 194+ 7FD8 0E 3C            ld   c, 60
 195+ 7FDA              .d1:
 196+ 7FDA 0D               dec  c
 197+ 7FDB 20 FD            jr   nz, .d1
 198+ 7FDD
 199+ 7FDD 3A 71 8E         ld   a, (room_border_color)
 200+ 7FE0 E6 EF            and  $ef              ; speaker OFF
 201+ 7FE2 D3 FE            out  ($fe), a
 202+ 7FE4
 203+ 7FE4 0E 3C            ld   c, 60
 204+ 7FE6              .d2:
 205+ 7FE6 0D               dec  c
 206+ 7FE7 20 FD            jr   nz, .d2
 207+ 7FE9
 208+ 7FE9 10 E6            djnz .sound_loop
 209+ 7FEB
 210+ 7FEB D1               pop  de
 211+ 7FEC C1               pop  bc
 212+ 7FED C9               ret

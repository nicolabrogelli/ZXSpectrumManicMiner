  64+ 7D4B              .load_h_loop:
  65+ 7D4B 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D4C FE FF            cp   $FF
  67+ 7D4E 28 7F            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D50 B7               or   a

  89+ 9C20 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  90+ 9C21 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  91+ 9C22 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  92+ 9C23 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

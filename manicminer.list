1812+ 7B8F              ; Phys_CheckCrumblingTrigger
1813+ 7B8F              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1814+ 7B8F              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1815+ 7B8F              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1816+ 7B8F              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1817+ 7B8F              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1818+ 7B8F              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1819+ 7B8F              ; -------------------------------------------------------------------
1820+ 7B8F              Phys_CheckCrumblingTrigger:
1821+ 7B8F C5               push bc
1822+ 7B90 D5               push de
1823+ 7B91 E5               push hl
1824+ 7B92
1825+ 7B92 ED 4B 1D E2      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1826+ 7B96
1827+ 7B96                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1828+ 7B96 78               ld   a, b
1829+ 7B97 C6 10            add  a, 16
1830+ 7B99 FE 80            cp   128
1831+ 7B9B 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1832+ 7B9D
1833+ 7B9D CB 3F            srl  a
1833+ 7B9F CB 3F          srl  a
1833+ 7BA1 CB 3F          srl  a   ; A = Row (0..15)
1834+ 7BA3 47               ld   b, a                  ; B = Row
1835+ 7BA4
1836+ 7BA4                  ; Piede sinistro: Col1 = PlayerX / 8
1837+ 7BA4 79               ld   a, c
1838+ 7BA5 CB 3F            srl  a
1838+ 7BA7 CB 3F          srl  a
1838+ 7BA9 CB 3F          srl  a   ; A = Col1 (0..31)
1839+ 7BAB 4F               ld   c, a                  ; C = Col1
1840+ 7BAC
1841+ 7BAC                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1842+ 7BAC 78               ld   a, b
1843+ 7BAD CD C1 78         call GetCellFromUnpacked
1844+ 7BB0 FE 02            cp   2
1845+ 7BB2 20 03            jr   nz, .check_col2
1846+ 7BB4
1847+ 7BB4                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1848+ 7BB4 CD EA 7B         call .advance_crumble_cell
1849+ 7BB7
1850+ 7BB7              .check_col2:
1851+ 7BB7                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1852+ 7BB7 ED 4B 1D E2      ld   bc, (PlayerPos)
1853+ 7BBB 78               ld   a, b
1854+ 7BBC C6 10            add  a, 16
1855+ 7BBE CB 3F            srl  a
1855+ 7BC0 CB 3F          srl  a
1855+ 7BC2 CB 3F          srl  a
1856+ 7BC4 47               ld   b, a                  ; B = Row
1857+ 7BC5
1858+ 7BC5 79               ld   a, c
1859+ 7BC6 C6 07            add  a, 7
1860+ 7BC8 CB 3F            srl  a
1860+ 7BCA CB 3F          srl  a
1860+ 7BCC CB 3F          srl  a   ; A = Col2 (0..31)
1861+ 7BCE 4F               ld   c, a                  ; C = Col2
1862+ 7BCF
1863+ 7BCF                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1864+ 7BCF 3A 1D E2         ld   a, (PlayerPos)        ; A = PlayerX
1865+ 7BD2 CB 3F            srl  a
1865+ 7BD4 CB 3F          srl  a
1865+ 7BD6 CB 3F          srl  a   ; A = Col1
1866+ 7BD8 B9               cp   c
1867+ 7BD9 28 0B            jr   z, .done_trigger
1868+ 7BDB
1869+ 7BDB 78               ld   a, b
1870+ 7BDC CD C1 78         call GetCellFromUnpacked
1871+ 7BDF FE 02            cp   2
1872+ 7BE1 20 03            jr   nz, .done_trigger
1873+ 7BE3
1874+ 7BE3                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1875+ 7BE3 CD EA 7B         call .advance_crumble_cell
1876+ 7BE6
1877+ 7BE6              .done_trigger:
1878+ 7BE6 E1               pop  hl
1879+ 7BE7 D1               pop  de
1880+ 7BE8 C1               pop  bc
1881+ 7BE9 C9               ret
1882+ 7BEA
1883+ 7BEA              .advance_crumble_cell:
1884+ 7BEA                  ; Input: B = Row, C = Col
1885+ 7BEA C5               push bc
1886+ 7BEB D5               push de
1887+ 7BEC E5               push hl
1888+ 7BED
1889+ 7BED                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1890+ 7BED 68               ld   l, b
1891+ 7BEE 26 00            ld   h, 0
1892+ 7BF0 29               add  hl, hl
1892+ 7BF1 29             add hl, hl
1892+ 7BF2 29             add hl, hl
1892+ 7BF3 29             add hl, hl
1892+ 7BF4 29             add hl, hl
1893+ 7BF5 59               ld   e, c
1894+ 7BF6 16 00            ld   d, 0
1895+ 7BF8 19               add  hl, de
1896+ 7BF9 11 2E E6         ld   de, crumbling_grid
1897+ 7BFC 19               add  hl, de
1898+ 7BFD
1899+ 7BFD                  ; 2. Avanza di 1 stadio
1900+ 7BFD 7E               ld   a, (hl)               ; A = Stage (0..8)
1901+ 7BFE FE 08            cp   8
1902+ 7C00 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
1903+ 7C02
1904+ 7C02 3C               inc  a                     ; Avanza di 1 scanline (1..8)
1905+ 7C03 77               ld   (hl), a
1906+ 7C04 5F               ld   e, a                  ; E = nuovo Stage (1..8)
1907+ 7C05
1908+ 7C05                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
1909+ 7C05 E5               push hl
1910+ 7C06 CD 24 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
1911+ 7C09 E1               pop  hl
1912+ 7C0A
1913+ 7C0A                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
1914+ 7C0A 7E               ld   a, (hl)
1915+ 7C0B FE 08            cp   8
1916+ 7C0D 38 12            jr   c, .done_advance
1917+ 7C0F
1918+ 7C0F                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
1919+ 7C0F 68               ld   l, b                  ; L = Row
1920+ 7C10 26 00            ld   h, 0
1921+ 7C12 29               add  hl, hl
1921+ 7C13 29             add hl, hl
1921+ 7C14 29             add hl, hl
1921+ 7C15 29             add hl, hl
1921+ 7C16 29             add hl, hl
1922+ 7C17 59               ld   e, c
1923+ 7C18 16 00            ld   d, 0
1924+ 7C1A 19               add  hl, de
1925+ 7C1B 11 43 E3         ld   de, unpacked_layout
1926+ 7C1E 19               add  hl, de
1927+ 7C1F 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
1928+ 7C21
1929+ 7C21              .done_advance:
1930+ 7C21 E1               pop  hl
1931+ 7C22 D1               pop  de
1932+ 7C23 C1               pop  bc
1933+ 7C24 C9               ret

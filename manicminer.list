 198+ 833C
 199+ 833C 3A 0C 9E         ld   a, (room_border_color)
 200+ 833F E6 EF            and  $ef              ; speaker OFF
 201+ 8341 D3 FE            out  ($fe), a
 202+ 8343
 203+ 8343 0E 3C            ld   c, 60
 204+ 8345              .d2:
 205+ 8345 0D               dec  c
 206+ 8346 20 FD            jr   nz, .d2
 207+ 8348
 208+ 8348 10 E6            djnz .sound_loop
 209+ 834A
 210+ 834A D1               pop  de
 211+ 834B C1               pop  bc
 212+ 834C C9               ret

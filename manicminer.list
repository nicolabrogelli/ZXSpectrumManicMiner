1070+ 6248                  ; 1. Calcola indirizzo bitmap nel font_buffer (font_buffer + A * 8)
1071+ 6248 6F               ld   l, a
1072+ 6249 26 00            ld   h, 0
1073+ 624B 29               add  hl, hl                ; *2
1074+ 624C 29               add  hl, hl                ; *4
1075+ 624D 29               add  hl, hl                ; *8
1076+ 624E 01 EA D8         ld   bc, font_buffer
1077+ 6251 09               add  hl, bc
1078+ 6252 E5               push hl
1079+ 6253 DD E1            pop  ix                    ; IX = font bitmap (8 byte)
1080+ 6255
1081+ 6255                  ; 2. Calcola indirizzo VRAM scanline 0 per (Row D, Col E)
1082+ 6255                  ; HighByte = $40 + (D & $18)
1083+ 6255 7A               ld   a, d
1084+ 6256 E6 18            and  $18
1085+ 6258 C6 40            add  a, $40
1086+ 625A 67               ld   h, a
1087+ 625B
1088+ 625B                  ; LowByte = ((D & 7) * 32) + E
1089+ 625B 7A               ld   a, d
1090+ 625C E6 07            and  7
1091+ 625E 87               add  a, a                  ; *2
1092+ 625F 87               add  a, a                  ; *4
1093+ 6260 87               add  a, a                  ; *8
1094+ 6261 87               add  a, a                  ; *16
1095+ 6262 87               add  a, a                  ; *32
1096+ 6263 83               add  a, e                  ; + Col E
1097+ 6264 6F               ld   l, a                  ; HL = VRAM address scanline 0
1098+ 6265
1099+ 6265                  ; Copia le 8 scanline direttamente in VRAM
1100+ 6265 DD 7E 00         ld   a, (ix+0)
1100+ 6268 77             ld (hl), a
1100+ 6269 24             inc h
1101+ 626A DD 7E 01         ld   a, (ix+1)
1101+ 626D 77             ld (hl), a
1101+ 626E 24             inc h
1102+ 626F DD 7E 02         ld   a, (ix+2)
1102+ 6272 77             ld (hl), a
1102+ 6273 24             inc h
1103+ 6274 DD 7E 03         ld   a, (ix+3)
1103+ 6277 77             ld (hl), a
1103+ 6278 24             inc h
1104+ 6279 DD 7E 04         ld   a, (ix+4)
1104+ 627C 77             ld (hl), a
1104+ 627D 24             inc h
1105+ 627E DD 7E 05         ld   a, (ix+5)
1105+ 6281 77             ld (hl), a
1105+ 6282 24             inc h
1106+ 6283 DD 7E 06         ld   a, (ix+6)
1106+ 6286 77             ld (hl), a
1106+ 6287 24             inc h
1107+ 6288 DD 7E 07         ld   a, (ix+7)
1107+ 628B 77             ld (hl), a
1108+ 628C
1109+ 628C D1               pop  de
1110+ 628D C1               pop  bc
1111+ 628E E1               pop  hl
1112+ 628F
1113+ 628F 1C               inc  e                     ; Prossima colonna
1114+ 6290 10 B1            djnz .char_loop

 138+ 7DB2              .done_h_guardians:
 139+ 7DB2                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DB2 2A 85 A1         ld   hl, (room_ptr)
 141+ 7DB5 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DB8 19               add  hl, de
 143+ 7DB9 7E               ld   a, (hl)
 144+ 7DBA FE FF            cp   $FF
 145+ 7DBC 28 0A            jr   z, .done_v_guardians
 146+ 7DBE B7               or   a
 147+ 7DBF 28 07            jr   z, .done_v_guardians
 148+ 7DC1
 149+ 7DC1                  ; Slot attivo per guardiano verticale
 150+ 7DC1 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DC5 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DC8                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DC8
 154+ 7DC8              .done_v_guardians:
 155+ 7DC8 DD E1            pop  ix
 156+ 7DCA C1               pop  bc
 157+ 7DCB D1               pop  de
 158+ 7DCC E1               pop  hl
 159+ 7DCD C9               ret
 160+ 7DCE
 161+ 7DCE              ; -------------------------------------------------------------------
 162+ 7DCE              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DCE              ; -------------------------------------------------------------------
 164+ 7DCE              CheckEnemyWillyOverlap:
 165+ 7DCE 3A 0B A2         ld   a, (player_drawn_pos+1)
 166+ 7DD1 FE FF            cp   $FF
 167+ 7DD3 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7DD4
 169+ 7DD4                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7DD4 3A 0A A2         ld   a, (player_drawn_pos)
 171+ 7DD7 E6 F8            and  $F8
 172+ 7DD9 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7DDA 79               ld   a, c
 174+ 7DDB E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7DDD 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7DDE C6 10            add  a, 16
 177+ 7DE0 FE 19            cp   25
 178+ 7DE2 D0               ret  nc                 ; Fuori portata X
 179+ 7DE3
 180+ 7DE3                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7DE3 3A 0B A2         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7DE6 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7DE7 C6 0F            add  a, 15
 184+ 7DE9 FE 1F            cp   31
 185+ 7DEB D0               ret  nc                 ; Fuori portata Y
 186+ 7DEC
 187+ 7DEC                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7DEC 3E 01            ld   a, 1
 189+ 7DEE 32 10 A2         ld   (willy_needs_redraw), a
 190+ 7DF1 C9               ret

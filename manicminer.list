 319  832D 77               ld   (hl), a
 320  832E 23               inc  hl
 321  832F 10 FC            djnz .color_title_loop
 322  8331
 323  8331                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 324  8331 3E BF            ld   a, $bf
 325  8333 DB FE            in   a, ($fe)
 326  8335 1F               rra
 327  8336 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop

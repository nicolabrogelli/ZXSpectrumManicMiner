 725  8364
 726  8364              ; -------------------------------------------------------------------
 727  8364              ; TriggerPortalTransition
 728  8364              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 729  8364              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 730  8364              ; - Avanza all'indice della stanza successiva.
 731  8364              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 732  8364              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 733  8364              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 734  8364              ; -------------------------------------------------------------------
 735  8364              TriggerPortalTransition:
 736  8364                  ; 1. Determina l'ID della stanza corrente
 737  8364 CD D0 7C         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 738  8367
 739  8367                  ; 2. Calcola l'indice della stanza successiva
 740  8367 3A D3 95         ld   a, (current_room)
 741  836A 3C               inc  a
 742  836B FE 02            cp   NUM_ROOMS
 743  836D 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 744  836F
 745  836F                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 746  836F 21 DF 6F         ld   hl, RoomsListTable
 747  8372 5F               ld   e, a
 748  8373 16 00            ld   d, 0
 749  8375 19               add  hl, de
 750  8376 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 751  8377 5E               ld   e, (hl)
 752  8378 23               inc  hl
 753  8379 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 754  837A ED 53 2D 96      ld   (room_ptr), de
 755  837E
 756  837E                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 757  837E AF               xor  a
 758  837F 32 33 96         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 759  8382 32 BB 92         ld   (velocity_y), a
 760  8385 32 C2 98         ld   (game_objective_completed), a
 761  8388 3E 01            ld   a, 1
 762  838A 32 BC 92         ld   (on_ground), a
 763  838D
 764  838D                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 765  838D 21 8D 5C         ld   hl, ATTR_P
 766  8390 36 07            ld   (hl), $07
 767  8392 CD AF 0D         call CLS
 768  8395
 769  8395 C3 24 80         jp   LoadRoomAndRestart
 770  8398
 771  8398              .all_rooms_completed:
 772  8398                  ; Tutte le stanze sono state completate con successo!
 773  8398                  IF ENABLE_VICTORY_SCREEN != 0
 774  8398 C3 8C 82         jp   TriggerVictory
 775  839B                  ELSE
 776  839B ~                ; Ricomincia dalla prima stanza (Stanza 00)
 777  839B ~                ld   de, (RoomsListTable)
 778  839B ~                ld   (room_ptr), de
 779  839B ~                xor  a
 780  839B ~                ld   (transition_active), a
 781  839B ~                ld   (velocity_y), a
 782  839B ~                ld   (game_objective_completed), a
 783  839B ~                ld   a, 1
 784  839B ~                ld   (on_ground), a
 785  839B ~                ld   hl, ATTR_P
 786  839B ~                ld   (hl), $07
 787  839B ~                call CLS
 788  839B ~                jp   LoadRoomAndRestart
 789  839B                  ENDIF

 359  8B87              ; Scatena la sequenza originale di Game Over:
 360  8B87              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 361  8B87              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 362  8B87              ;   con suono beeper originale e lampeggio dello schermo.
 363  8B87              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 364  8B87              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 365  8B87              ; -------------------------------------------------------------------
 366  8B87              TriggerGameOver:
 367  8B87                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 368  8B87 CD EB 88         call Score_CheckAndUpdateHighScore
 369  8B8A
 370  8B8A                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 371  8B8A CD 29 66         call Gfx_DrawGameOverScreen
 372  8B8D
 373  8B8D                  ; 3. Ritorna al Title Screen originale
 374  8B8D C3 43 8B         jp   ShowTitleScreen
 375  8B90
 376  8B90              ; -------------------------------------------------------------------
 377  8B90              ; TriggerVictory
 378  8B90              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 379  8B90              ; - Pulisce gli elementi di gioco della stanza.
 380  8B90              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 381  8B90              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 382  8B90              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 383  8B90              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 384  8B90              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 385  8B90              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 386  8B90              ; -------------------------------------------------------------------
 387  8B90              TriggerVictory:
 388  8B90                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 389  8B90 CD EB 88         call Score_CheckAndUpdateHighScore
 390  8B93
 391  8B93                  ; 2. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 392  8B93 CD 14 67         call Gfx_DrawVictoryScreen
 393  8B96
 394  8B96                  ; 3. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 395  8B96              .wait_keys_release:
 396  8B96 76               halt
 397  8B97                  ; Controlla tasto Y (Porta $DF, bit 4)
 398  8B97 01 FE DF         ld   bc, $dffe
 399  8B9A ED 78            in   a, (c)
 400  8B9C CB 67            bit  4, a
 401  8B9E 28 F6            jr   z, .wait_keys_release
 402  8BA0
 403  8BA0                  ; Controlla tasto N (Porta $7F, bit 3)
 404  8BA0 01 FE 7F         ld   bc, $7ffe
 405  8BA3 ED 78            in   a, (c)
 406  8BA5 CB 5F            bit  3, a
 407  8BA7 28 ED            jr   z, .wait_keys_release
 408  8BA9
 409  8BA9                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 410  8BA9 01 FE BF         ld   bc, $bffe
 411  8BAC ED 78            in   a, (c)
 412  8BAE CB 47            bit  0, a
 413  8BB0 28 E4            jr   z, .wait_keys_release
 414  8BB2
 415  8BB2                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 416  8BB2 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 417  8BB4              .wait_choice_loop:
 418  8BB4 76               halt
 419  8BB5
 420  8BB5                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 421  8BB5 0C               inc  c
 422  8BB6 79               ld   a, c
 423  8BB7 CB 3F            srl  a
 424  8BB9 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 425  8BBB E6 07            and  7
 426  8BBD 5F               ld   e, a
 427  8BBE 16 00            ld   d, 0
 428  8BC0 21 0B 66         ld   hl, victory_color_table
 429  8BC3 19               add  hl, de
 430  8BC4 7E               ld   a, (hl)               ; A = nuovo colore attributo
 431  8BC5 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 432  8BC8 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 433  8BCA              .color_cycle_loop:
 434  8BCA 77               ld   (hl), a
 435  8BCB 23               inc  hl
 436  8BCC 10 FC            djnz .color_cycle_loop
 437  8BCE
 438  8BCE                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 439  8BCE 01 FE DF         ld   bc, $dffe
 440  8BD1 ED 78            in   a, (c)
 441  8BD3 CB 67            bit  4, a
 442  8BD5 28 2A            jr   z, .play_again_chosen
 443  8BD7
 444  8BD7                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 445  8BD7 01 FE 7F         ld   bc, $7ffe
 446  8BDA ED 78            in   a, (c)
 447  8BDC CB 5F            bit  3, a
 448  8BDE 28 0B            jr   z, .quit_chosen
 449  8BE0
 450  8BE0                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 451  8BE0 01 FE BF         ld   bc, $bffe
 452  8BE3 ED 78            in   a, (c)
 453  8BE5 CB 47            bit  0, a
 454  8BE7 28 02            jr   z, .quit_chosen
 455  8BE9
 456  8BE9 18 C9            jr   .wait_choice_loop
 457  8BEB
 458  8BEB              .quit_chosen:
 459  8BEB                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 460  8BEB              .wait_quit_release:
 461  8BEB 76               halt
 462  8BEC 01 FE 7F         ld   bc, $7ffe
 463  8BEF ED 78            in   a, (c)
 464  8BF1 CB 5F            bit  3, a
 465  8BF3 28 F6            jr   z, .wait_quit_release
 466  8BF5 01 FE BF         ld   bc, $bffe
 467  8BF8 ED 78            in   a, (c)
 468  8BFA CB 47            bit  0, a
 469  8BFC 28 ED            jr   z, .wait_quit_release
 470  8BFE
 471  8BFE                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 472  8BFE C3 43 8B         jp   ShowTitleScreen
 473  8C01
 474  8C01              .play_again_chosen:
 475  8C01                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 476  8C01              .wait_play_again_release:
 477  8C01 76               halt
 478  8C02 01 FE DF         ld   bc, $dffe
 479  8C05 ED 78            in   a, (c)
 480  8C07 CB 67            bit  4, a
 481  8C09 28 F6            jr   z, .wait_play_again_release
 482  8C0B
 483  8C0B                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 484  8C0B CD 45 8D         call ResetFullGameState
 485  8C0E C3 01 8A         jp   LoadRoomAndRestart
 486  8C11
 487  8C11              ; -------------------------------------------------------------------
 488  8C11              ; CheckPortalTransition
 489  8C11              ; Verifica le condizioni per accedere alla stanza successiva:
 490  8C11              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 491  8C11              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 492  8C11              ;
 493  8C11              ; Output:
 494  8C11              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 495  8C11              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 496  8C11              ; -------------------------------------------------------------------
 497  8C11              CheckPortalTransition:
 498  8C11 C5               push bc
 499  8C12 D5               push de
 500  8C13 E5               push hl
 501  8C14
 502  8C14                  ; 1. Tutti gli item della stanza sono stati raccolti?
 503  8C14 CD D8 8C         call CheckAllItemsCollected
 504  8C17 30 4D            jr   nc, .no_transition
 505  8C19
 506  8C19                  ; 2. Willy collide con il portale (16x16 pixel)?
 507  8C19                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 508  8C19                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 509  8C19 2A 62 EF         ld   hl, (room_ptr)
 510  8C1C 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 511  8C1F 19               add  hl, de
 512  8C20 4E               ld   c, (hl)
 513  8C21 23               inc  hl
 514  8C22 46               ld   b, (hl)                   ; BC = AttrAddr
 515  8C23
 516  8C23                  ; Offset = BC - 23552
 517  8C23 60               ld   h, b
 518  8C24 69               ld   l, c
 519  8C25 01 00 A4         ld   bc, -23552
 520  8C28 09               add  hl, bc
 521  8C29
 522  8C29                  ; PortalX = (Offset & 31) * 8
 523  8C29 7D               ld   a, l
 524  8C2A E6 1F            and  31
 525  8C2C 87               add  a, a
 525  8C2D 87             add a, a
 525  8C2E 87             add a, a
 526  8C2F 5F               ld   e, a                      ; E = PortalX (0..248)
 527  8C30
 528  8C30                  ; PortalY = (Offset / 32) * 8
 529  8C30 CB 3C            srl  h
 529  8C32 CB 1D          rr l
 530  8C34 CB 3C            srl  h
 530  8C36 CB 1D          rr l
 531  8C38 CB 3C            srl  h
 531  8C3A CB 1D          rr l
 532  8C3C CB 3C            srl  h
 532  8C3E CB 1D          rr l
 533  8C40 CB 3C            srl  h
 533  8C42 CB 1D          rr l
 534  8C44 7D               ld   a, l
 535  8C45 87               add  a, a
 535  8C46 87             add a, a
 535  8C47 87             add a, a
 536  8C48 57               ld   d, a                      ; D = PortalY (0..120)
 537  8C49
 538  8C49                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 539  8C49 ED 4B DF EB      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 540  8C4D
 541  8C4D                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 542  8C4D 7B               ld   a, e
 543  8C4E 91               sub  c
 544  8C4F 30 02            jr   nc, .x_diff_pos
 545  8C51 ED 44            neg
 546  8C53              .x_diff_pos:
 547  8C53 FE 0C            cp   12
 548  8C55 30 0F            jr   nc, .no_transition
 549  8C57
 550  8C57                  ; Controllo verticale: |WillyY - PortalY| < 14
 551  8C57 7A               ld   a, d
 552  8C58 90               sub  b
 553  8C59 30 02            jr   nc, .y_diff_pos
 554  8C5B ED 44            neg
 555  8C5D              .y_diff_pos:
 556  8C5D FE 0E            cp   14
 557  8C5F 30 05            jr   nc, .no_transition
 558  8C61
 559  8C61                  ; Transizione al portale attiva!
 560  8C61 E1               pop  hl
 561  8C62 D1               pop  de
 562  8C63 C1               pop  bc
 563  8C64 37               scf
 564  8C65 C9               ret
 565  8C66
 566  8C66              .no_transition:
 567  8C66 E1               pop  hl
 568  8C67 D1               pop  de
 569  8C68 C1               pop  bc
 570  8C69 B7               or   a
 571  8C6A C9               ret
 572  8C6B
 573  8C6B              ; Alias per retrocompatibilità
 574  8C6B              CheckVictoryCondition: EQU CheckPortalTransition
 575  8C6B
 576  8C6B              ; -------------------------------------------------------------------
 577  8C6B              ; TriggerPortalTransition
 578  8C6B              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 579  8C6B              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 580  8C6B              ; - Avanza all'indice della stanza successiva.
 581  8C6B              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 582  8C6B              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 583  8C6B              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 584  8C6B              ; -------------------------------------------------------------------
 585  8C6B              TriggerPortalTransition:
 586  8C6B                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 587  8C6B CD A2 8C         call Air_DepleteCountdown
 588  8C6E
 589  8C6E                  ; 1. Determina l'ID della stanza corrente
 590  8C6E CD 2C 86         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 591  8C71
 592  8C71                  ; 2. Calcola l'indice della stanza successiva
 593  8C71 3A 07 EF         ld   a, (current_room)
 594  8C74 3C               inc  a
 595  8C75 FE 14            cp   NUM_ROOMS
 596  8C77 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 597  8C79
 598  8C79                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 599  8C79 21 3D 74         ld   hl, RoomsListTable
 600  8C7C 5F               ld   e, a
 601  8C7D 16 00            ld   d, 0
 602  8C7F 19               add  hl, de
 603  8C80 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 604  8C81 5E               ld   e, (hl)
 605  8C82 23               inc  hl
 606  8C83 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 607  8C84 ED 53 62 EF      ld   (room_ptr), de
 608  8C88
 609  8C88                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 610  8C88 AF               xor  a
 611  8C89 32 68 EF         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 612  8C8C 32 ED EB         ld   (velocity_y), a
 613  8C8F 32 FA F1         ld   (game_objective_completed), a
 614  8C92 3E 01            ld   a, 1
 615  8C94 32 EE EB         ld   (on_ground), a
 616  8C97
 617  8C97                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 618  8C97 3E 07            ld   a, $07
 619  8C99 CD 9D 62         call Gfx_ClearScreenDirect
 620  8C9C
 621  8C9C C3 01 8A         jp   LoadRoomAndRestart
 622  8C9F
 623  8C9F              .all_rooms_completed:
 624  8C9F                  ; Tutte le stanze sono state completate con successo!
 625  8C9F                  IF ENABLE_VICTORY_SCREEN != 0
 626  8C9F C3 90 8B         jp   TriggerVictory
 627  8CA2                  ELSE
 628  8CA2 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 629  8CA2 ~                ld   de, (RoomsListTable)
 630  8CA2 ~                ld   (room_ptr), de
 631  8CA2 ~                xor  a
 632  8CA2 ~                ld   (transition_active), a
 633  8CA2 ~                ld   (velocity_y), a
 634  8CA2 ~                ld   (game_objective_completed), a
 635  8CA2 ~                ld   a, 1
 636  8CA2 ~                ld   (on_ground), a
 637  8CA2 ~                ld   a, $07
 638  8CA2 ~                call Gfx_ClearScreenDirect
 639  8CA2 ~                jp   LoadRoomAndRestart
 640  8CA2                  ENDIF
 641  8CA2
 642  8CA2              ; -------------------------------------------------------------------
 643  8CA2              ; Air_DepleteCountdown
 644  8CA2              ; Animazione originale di completamento livello (Manic Miner):
 645  8CA2              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 646  8CA2              ; - Ad ogni pixel decrementato:
 647  8CA2              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 648  8CA2              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 649  8CA2              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 650  8CA2              ; -------------------------------------------------------------------
 651  8CA2              Air_DepleteCountdown:
 652  8CA2 F5               push af
 653  8CA3 C5               push bc
 654  8CA4 D5               push de
 655  8CA5 E5               push hl
 656  8CA6
 657  8CA6              .countdown_loop:
 658  8CA6 3A 03 F2         ld   a, (air_pixels)
 659  8CA9 B7               or   a
 660  8CAA 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 661  8CAC
 662  8CAC 3D               dec  a
 663  8CAD 32 03 F2         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 664  8CB0
 665  8CB0                  ; Aggiorna la barra grafica dell'aria
 666  8CB0 CD 42 6A         call Gfx_UpdateAirBar
 667  8CB3
 668  8CB3                  ; Aggiungi 1 punto allo score
 669  8CB3 CD A0 88         call Score_Add1Point
 670  8CB6
 671  8CB6                  ; Genera l'effetto sonoro originale di Manic Miner:
 672  8CB6                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 673  8CB6 3A 03 F2         ld   a, (air_pixels)
 674  8CB9 2F               cpl
 675  8CBA E6 3F            and  63
 676  8CBC 07               rlca
 677  8CBD 3C               inc  a
 678  8CBE 57               ld   d, a                      ; D = ritardo semionda audio
 679  8CBF
 680  8CBF 0E 03            ld   c, 3                      ; Durata impulso
 681  8CC1              .audio_loop:
 682  8CC1 AF               xor  a
 683  8CC2 D3 FE            out  ($fe), a
 684  8CC4 42               ld   b, d
 685  8CC5 10 FE        .w1: djnz .w1
 686  8CC7
 687  8CC7 3E 18            ld   a, $18
 688  8CC9 D3 FE            out  ($fe), a
 689  8CCB 42               ld   b, d
 690  8CCC 10 FE        .w2: djnz .w2
 691  8CCE
 692  8CCE 0D               dec  c
 693  8CCF 20 F0            jr   nz, .audio_loop
 694  8CD1
 695  8CD1 18 D3            jr   .countdown_loop
 696  8CD3
 697  8CD3              .done_countdown:
 698  8CD3 E1               pop  hl
 699  8CD4 D1               pop  de
 700  8CD5 C1               pop  bc
 701  8CD6 F1               pop  af
 702  8CD7 C9               ret
 703  8CD8
 704  8CD8              ; -------------------------------------------------------------------
 705  8CD8              ; CheckAllItemsCollected
 706  8CD8              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 707  8CD8              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8CD8              ; -------------------------------------------------------------------
 709  8CD8              CheckAllItemsCollected:
 710  8CD8 3A FA F1         ld   a, (game_objective_completed)
 711  8CDB B7               or   a
 712  8CDC 20 08            jr   nz, .all_collected
 713  8CDE 3A 61 EF         ld   a, (num_room_items)
 714  8CE1 B7               or   a
 715  8CE2 28 02            jr   z, .all_collected
 716  8CE4 B7               or   a
 717  8CE5 C9               ret
 718  8CE6              .all_collected:
 719  8CE6 37               scf
 720  8CE7 C9               ret
 721  8CE8
 722  8CE8              ; -------------------------------------------------------------------
 723  8CE8              ; CheckInMasterBedroom (alias per retrocompatibilità)
 724  8CE8              ; -------------------------------------------------------------------
 725  8CE8              CheckInMasterBedroom:
 726  8CE8 37               scf
 727  8CE9 C9               ret
 728  8CEA
 729  8CEA              ; -------------------------------------------------------------------
 730  8CEA              ; CheckWillyConveyorCollision
 731  8CEA              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 732  8CEA              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 733  8CEA              ; -------------------------------------------------------------------
 734  8CEA              CheckWillyConveyorCollision:
 735  8CEA C5               push bc
 736  8CEB D5               push de
 737  8CEC E5               push hl
 738  8CED
 739  8CED                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 740  8CED CD 1D 79         call CheckWillyOnConveyor
 741  8CF0 38 49            jr   c, .collision_detected
 742  8CF2
 743  8CF2                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 744  8CF2 3A 09 EF         ld   a, (conveyor_len)
 745  8CF5 B7               or   a
 746  8CF6 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 747  8CF8
 748  8CF8                  ; B = WillyY, C = WillyX
 749  8CF8 ED 4B DF EB      ld   bc, (PlayerPos)
 750  8CFC
 751  8CFC                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 752  8CFC 3A 0A EF         ld   a, (conveyor_row)
 753  8CFF 87               add  a, a                  ; *2
 754  8D00 87               add  a, a                  ; *4
 755  8D01 87               add  a, a                  ; *8
 756  8D02 5F               ld   e, a                  ; E = ConveyorTop
 757  8D03 C6 07            add  a, 7
 758  8D05 57               ld   d, a                  ; D = ConveyorBottom
 759  8D06
 760  8D06                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 761  8D06 78               ld   a, b                  ; WillyTop
 762  8D07 BA               cp   d
 763  8D08 28 04            jr   z, .y_overlap
 764  8D0A 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 765  8D0C 18 32            jr   .no_conv_collision
 766  8D0E
 767  8D0E              .y_overlap:
 768  8D0E C6 0F            add  a, 15                 ; WillyBottom
 769  8D10 BB               cp   e
 770  8D11 28 04            jr   z, .x_check
 771  8D13 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 772  8D15 18 29            jr   .no_conv_collision
 773  8D17
 774  8D17              .x_check:
 775  8D17                  ; ConveyorLeft = conveyor_col * 8
 776  8D17 3A 0B EF         ld   a, (conveyor_col)
 777  8D1A 87               add  a, a                  ; *2
 778  8D1B 87               add  a, a                  ; *4
 779  8D1C 87               add  a, a                  ; *8
 780  8D1D 5F               ld   e, a                  ; E = ConveyorLeft
 781  8D1E
 782  8D1E                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 783  8D1E 21 09 EF         ld   hl, conveyor_len
 784  8D21 3A 0B EF         ld   a, (conveyor_col)
 785  8D24 86               add  a, (hl)
 786  8D25 87               add  a, a                  ; *2
 787  8D26 87               add  a, a                  ; *4
 788  8D27 87               add  a, a                  ; *8
 789  8D28 3D               dec  a                     ; ConveyorRight
 790  8D29 57               ld   d, a                  ; D = ConveyorRight
 791  8D2A
 792  8D2A                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 793  8D2A 79               ld   a, c                  ; WillyLeft
 794  8D2B BA               cp   d
 795  8D2C 28 04            jr   z, .x_overlap

 353  88DE              ; TriggerGameOver
 354  88DE              ; Scatena la schermata di Game Over per la stanza corrente.
 355  88DE              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 356  88DE              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 357  88DE              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 358  88DE              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 359  88DE              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 360  88DE              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 361  88DE              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 362  88DE              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 363  88DE              ; -------------------------------------------------------------------
 364  88DE              TriggerGameOver:
 365  88DE                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 366  88DE CD 19 66         call Gfx_DrawGameOverScreen
 367  88E1
 368  88E1                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 369  88E1              .wait_keys_release:
 370  88E1 76               halt
 371  88E2                  ; Controlla tasto Y (Porta $DF, bit 4)
 372  88E2 01 FE DF         ld   bc, $dffe
 373  88E5 ED 78            in   a, (c)
 374  88E7 CB 67            bit  4, a
 375  88E9 28 F6            jr   z, .wait_keys_release
 376  88EB
 377  88EB                  ; Controlla tasto N (Porta $7F, bit 3)
 378  88EB 01 FE 7F         ld   bc, $7ffe
 379  88EE ED 78            in   a, (c)
 380  88F0 CB 5F            bit  3, a
 381  88F2 28 ED            jr   z, .wait_keys_release
 382  88F4
 383  88F4                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 384  88F4 01 FE BF         ld   bc, $bffe
 385  88F7 ED 78            in   a, (c)
 386  88F9 CB 47            bit  0, a
 387  88FB 28 E4            jr   z, .wait_keys_release
 388  88FD
 389  88FD                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 390  88FD 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 391  88FF              .wait_choice_loop:
 392  88FF 76               halt
 393  8900
 394  8900                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 395  8900 0C               inc  c
 396  8901 79               ld   a, c
 397  8902 CB 3F            srl  a
 398  8904 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 399  8906 E6 07            and  7
 400  8908 5F               ld   e, a
 401  8909 16 00            ld   d, 0
 402  890B 21 D5 65         ld   hl, game_over_color_table
 403  890E 19               add  hl, de
 404  890F 7E               ld   a, (hl)               ; A = nuovo colore attributo
 405  8910 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 406  8913 06 09            ld   b, 9
 407  8915              .color_cycle_loop:
 408  8915 77               ld   (hl), a
 409  8916 23               inc  hl
 410  8917 10 FC            djnz .color_cycle_loop
 411  8919
 412  8919                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 413  8919 01 FE DF         ld   bc, $dffe
 414  891C ED 78            in   a, (c)
 415  891E CB 67            bit  4, a
 416  8920 28 2A            jr   z, .continue_chosen
 417  8922
 418  8922                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 419  8922 01 FE 7F         ld   bc, $7ffe
 420  8925 ED 78            in   a, (c)
 421  8927 CB 5F            bit  3, a
 422  8929 28 0B            jr   z, .quit_chosen
 423  892B
 424  892B                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 425  892B 01 FE BF         ld   bc, $bffe
 426  892E ED 78            in   a, (c)
 427  8930 CB 47            bit  0, a
 428  8932 28 02            jr   z, .quit_chosen
 429  8934
 430  8934 18 C9            jr   .wait_choice_loop

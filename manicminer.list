 691+ 882B 27               daa
 692+ 882C 32 41 F1         ld   (player_score + 2), a
 693+ 882F
 694+ 882F                  ; Controlla se player_score ha superato high_score
 695+ 882F CD 3A 88         call Score_CheckAndUpdateHighScore

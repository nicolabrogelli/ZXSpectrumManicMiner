1026+ 7868                  ; Se la cella è sulla rampa, non considerarla un muro!
1027+ 7868 53               ld   d, e              ; D = Row
1028+ 7869 59               ld   e, c              ; E = Col
1029+ 786A CD D6 77         call IsCellOnRamp
1030+ 786D 38 09            jr   c, .not_wall
1031+ 786F
1032+ 786F 7A               ld   a, d              ; A = Row
1033+ 7870 4B               ld   c, e              ; C = Col
1034+ 7871 CD 0D 79         call GetCellFromUnpacked ; A = cell type

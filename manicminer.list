1960+ 7CE4              ; Phys_CheckCrumblingTrigger
1961+ 7CE4              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1962+ 7CE4              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1963+ 7CE4              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1964+ 7CE4              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1965+ 7CE4              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1966+ 7CE4              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1967+ 7CE4              ; -------------------------------------------------------------------
1968+ 7CE4              Phys_CheckCrumblingTrigger:
1969+ 7CE4 C5               push bc
1970+ 7CE5 D5               push de
1971+ 7CE6 E5               push hl
1972+ 7CE7
1973+ 7CE7 ED 4B EA EA      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1974+ 7CEB
1975+ 7CEB                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1976+ 7CEB 78               ld   a, b
1977+ 7CEC C6 10            add  a, 16
1978+ 7CEE FE 80            cp   128
1979+ 7CF0 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1980+ 7CF2
1981+ 7CF2 CB 3F            srl  a
1981+ 7CF4 CB 3F          srl  a
1981+ 7CF6 CB 3F          srl  a   ; A = Row (0..15)
1982+ 7CF8 47               ld   b, a                  ; B = Row
1983+ 7CF9
1984+ 7CF9                  ; Piede sinistro: Col1 = PlayerX / 8
1985+ 7CF9 79               ld   a, c
1986+ 7CFA CB 3F            srl  a
1986+ 7CFC CB 3F          srl  a
1986+ 7CFE CB 3F          srl  a   ; A = Col1 (0..31)
1987+ 7D00 4F               ld   c, a                  ; C = Col1
1988+ 7D01
1989+ 7D01                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1990+ 7D01 78               ld   a, b
1991+ 7D02 CD 16 7A         call GetCellFromUnpacked
1992+ 7D05 FE 02            cp   2
1993+ 7D07 20 03            jr   nz, .check_col2
1994+ 7D09
1995+ 7D09                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1996+ 7D09 CD 3F 7D         call .advance_crumble_cell
1997+ 7D0C
1998+ 7D0C              .check_col2:
1999+ 7D0C                  ; Piede destro: Col2 = (PlayerX + 7) / 8
2000+ 7D0C ED 4B EA EA      ld   bc, (PlayerPos)
2001+ 7D10 78               ld   a, b
2002+ 7D11 C6 10            add  a, 16
2003+ 7D13 CB 3F            srl  a
2003+ 7D15 CB 3F          srl  a
2003+ 7D17 CB 3F          srl  a
2004+ 7D19 47               ld   b, a                  ; B = Row
2005+ 7D1A
2006+ 7D1A 79               ld   a, c
2007+ 7D1B C6 07            add  a, 7
2008+ 7D1D CB 3F            srl  a
2008+ 7D1F CB 3F          srl  a
2008+ 7D21 CB 3F          srl  a   ; A = Col2 (0..31)
2009+ 7D23 4F               ld   c, a                  ; C = Col2
2010+ 7D24
2011+ 7D24                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2012+ 7D24 3A EA EA         ld   a, (PlayerPos)        ; A = PlayerX
2013+ 7D27 CB 3F            srl  a
2013+ 7D29 CB 3F          srl  a
2013+ 7D2B CB 3F          srl  a   ; A = Col1
2014+ 7D2D B9               cp   c
2015+ 7D2E 28 0B            jr   z, .done_trigger
2016+ 7D30
2017+ 7D30 78               ld   a, b
2018+ 7D31 CD 16 7A         call GetCellFromUnpacked
2019+ 7D34 FE 02            cp   2
2020+ 7D36 20 03            jr   nz, .done_trigger
2021+ 7D38
2022+ 7D38                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
2023+ 7D38 CD 3F 7D         call .advance_crumble_cell
2024+ 7D3B
2025+ 7D3B              .done_trigger:
2026+ 7D3B E1               pop  hl
2027+ 7D3C D1               pop  de
2028+ 7D3D C1               pop  bc
2029+ 7D3E C9               ret

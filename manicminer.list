 476+ 7D16 D6 02            sub  2
 477+ 7D18 DD BE 04         cp   (ix+4)
 478+ 7D1B 28 08            jr   z, .v_rev_down
 479+ 7D1D 38 06            jr   c, .v_rev_down
 480+ 7D1F DD 77 03         ld   (ix+3), a
 481+ 7D22 C3 50 7D         jp   .next
 482+ 7D25
 483+ 7D25              .v_rev_down:
 484+ 7D25 DD 7E 04         ld   a, (ix+4)
 485+ 7D28 DD 77 03         ld   (ix+3), a
 486+ 7D2B 3E 02            ld   a, 2
 487+ 7D2D DD 77 06         ld   (ix+6), a
 488+ 7D30 C3 50 7D         jp   .next
 489+ 7D33
 490+ 7D33              .vert_down:
 491+ 7D33 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7D36 C6 02            add  a, 2
 493+ 7D38 DD BE 05         cp   (ix+5)
 494+ 7D3B 28 08            jr   z, .v_rev_up
 495+ 7D3D 30 06            jr   nc, .v_rev_up
 496+ 7D3F DD 77 03         ld   (ix+3), a
 497+ 7D42 C3 50 7D         jp   .next
 498+ 7D45
 499+ 7D45              .v_rev_up:
 500+ 7D45 DD 7E 05         ld   a, (ix+5)
 501+ 7D48 DD 77 03         ld   (ix+3), a
 502+ 7D4B 3E 01            ld   a, 1
 503+ 7D4D DD 77 06         ld   (ix+6), a
 504+ 7D50
 505+ 7D50              .next:
 506+ 7D50 11 0B 00         ld   de, 11
 507+ 7D53 DD 19            add  ix, de
 508+ 7D55 05               dec  b
 509+ 7D56 C2 AC 7C         jp   nz, .loop
 510+ 7D59
 511+ 7D59 DD E1            pop  ix
 512+ 7D5B C1               pop  bc
 513+ 7D5C D1               pop  de
 514+ 7D5D E1               pop  hl
 515+ 7D5E C9               ret
 516+ 7D5F
 517+ 7D5F              ; -------------------------------------------------------------------
 518+ 7D5F              ; CheckCollision
 519+ 7D5F              ;
 520+ 7D5F              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7D5F              ; Output:
 522+ 7D5F              ;   Carry Set = Collisione con guardiano
 523+ 7D5F              ;   Carry Clear = Nessuna collisione
 524+ 7D5F              ; -------------------------------------------------------------------
 525+ 7D5F              CheckCollision:
 526+ 7D5F DD E5            push ix
 527+ 7D61 C5               push bc
 528+ 7D62 D5               push de
 529+ 7D63 E5               push hl
 530+ 7D64
 531+ 7D64                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7D64 3A 93 97         ld   a, (willy_safety_timer)
 533+ 7D67 B7               or   a
 534+ 7D68 20 3B            jr   nz, .no_collision_found
 535+ 7D6A
 536+ 7D6A DD 21 57 7A      ld   ix, ActiveEnemies
 537+ 7D6E 06 08            ld   b, 8                      ; 8 slot
 538+ 7D70
 539+ 7D70              .collision_loop:
 540+ 7D70 DD 7E 00         ld   a, (ix+0)
 541+ 7D73 E6 80            and  $80                       ; Active?
 542+ 7D75 28 26            jr   z, .next_enemy
 543+ 7D77
 544+ 7D77 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7D78
 546+ 7D78                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7D78 ED 4B 89 93      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7D7C DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7D7F
 550+ 7D7F                  ; Calcola differenza X
 551+ 7D7F 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7D80 30 02            jr   nc, .x_diff_pos
 553+ 7D82 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7D84              .x_diff_pos:
 555+ 7D84 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7D86 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7D88
 558+ 7D88                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7D88 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7D8B 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7D8C 30 02            jr   nc, .y_diff_pos
 562+ 7D8E ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7D90              .y_diff_pos:
 564+ 7D90 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7D92 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7D94
 567+ 7D94                  ; Collisione trovata!
 568+ 7D94 C1               pop  bc                        ; Ripristina stack
 569+ 7D95 E1               pop  hl
 570+ 7D96 D1               pop  de
 571+ 7D97 C1               pop  bc
 572+ 7D98 DD E1            pop  ix
 573+ 7D9A 37               scf
 574+ 7D9B C9               ret
 575+ 7D9C
 576+ 7D9C              .no_x_hit:

 121+ 8456 ~                ld   a, (Audio_music_note_idx)
 122+ 8456 ~                ld   e, a
 123+ 8456 ~                ld   d, 0
 124+ 8456 ~                ld   hl, Audio_MusicSheet
 125+ 8456 ~                add  hl, de
 126+ 8456 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8456 ~                ld   a, (hl)                  ; A = delay
 128+ 8456 ~                or   a
 129+ 8456 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8456 ~
 131+ 8456 ~                ; Suona la nota: 2 cicli
 132+ 8456 ~                ld   d, a                     ; D = delay
 133+ 8456 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8456 ~            .note_loop:
 135+ 8456 ~                ; Speaker ON
 136+ 8456 ~                ld   a, (room_border_color)
 137+ 8456 ~                or   $10
 138+ 8456 ~                out  ($fe), a
 139+ 8456 ~                ld   c, d

 663+ 609D
 664+ 609D              .do_print:
 665+ 609D                  ; 3. Disegna il player nella nuova posizione
 666+ 609D CD DB 5F         call Gfx_PrintPlayer
 667+ 60A0
 668+ 60A0              .skip_print_blink:
 669+ 60A0                  ; 4. Registra lo stato disegnato a schermo
 670+ 60A0 ED 4B 71 8F      ld   bc, (PlayerPos)
 671+ 60A4 ED 43 76 93      ld   (player_drawn_pos), bc
 672+ 60A8 3A 78 8F         ld   a, (direction)
 673+ 60AB 32 78 93         ld   (player_old_dir), a

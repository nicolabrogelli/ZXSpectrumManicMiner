  45+ 7D94 ED B0            ldir
  46+ 7D96
  47+ 7D96                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D96 DD 21 2C 7D      ld   ix, ActiveEnemies
  49+ 7D9A 06 08            ld   b, 8
  50+ 7D9C 11 0B 00         ld   de, 11
  51+ 7D9F              .init_old_pos:
  52+ 7D9F DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7DA3 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7DA7 DD 19            add  ix, de
  55+ 7DA9 10 F4            djnz .init_old_pos
  56+ 7DAB
  57+ 7DAB                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7DAB DD 21 2C 7D      ld   ix, ActiveEnemies
  59+ 7DAF 2A E7 99         ld   hl, (room_ptr)

 348  81D1
 349  81D1                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 350  81D1 AF               xor  a
 351  81D2 D3 FE            out  ($fe), a              ; Bordo a nero
 352  81D4 21 8D 5C         ld   hl, ATTR_P
 353  81D7 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 354  81D8 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 355  81DB 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 356  81DD 3E 07            ld   a, $07

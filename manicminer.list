 861+ 7759              .range_right:
 862+ 7759 3A CC E3         ld   a, (ramp_col)
 863+ 775C 47               ld   b, a              ; B = ramp_col
 864+ 775D 3A CA E3         ld   a, (ramp_len)
 865+ 7760 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7761 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7762
 868+ 7762 7B               ld   a, e              ; A = Col
 869+ 7763 B8               cp   b
 870+ 7764 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7766 B9               cp   c
 872+ 7767 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 7769
 874+ 7769                  ; Calcola B = Col - ramp_col
 875+ 7769 7B               ld   a, e
 876+ 776A 90               sub  b
 877+ 776B 47               ld   b, a              ; B = offset (0..ramp_len-1)
 878+ 776C

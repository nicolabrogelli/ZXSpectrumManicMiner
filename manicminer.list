 991+ 832A              .calc_guard_ptr:
 992+ 832A                  ; Offset = Frame * 32
 993+ 832A 6F               ld   l, a
 994+ 832B 26 00            ld   h, 0
 995+ 832D 29               add  hl, hl                    ; *2
 996+ 832E 29               add  hl, hl                    ; *4
 997+ 832F 29               add  hl, hl                    ; *8
 998+ 8330 29               add  hl, hl                    ; *16
 999+ 8331 29               add  hl, hl                    ; *32
1000+ 8332 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
1001+ 8335 19               add  hl, de
1002+ 8336 ED 5B 06 EE      ld   de, (room_ptr)
1003+ 833A 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
1004+ 833B 22 AE F0         ld   (guard_sprite_ptr), hl
1005+ 833E
1006+ 833E              .guard_ptr_ready:
1007+ 833E
1008+ 833E                  ; ---------------------------------------------------------------
1009+ 833E                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
1010+ 833E                  ; ---------------------------------------------------------------
1011+ 833E 3A B1 F0         ld   a, (collision_delta_y)
1012+ 8341 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
1013+ 8343 20 12            jr   nz, .willy_higher
1014+ 8345
1015+ 8345                  ; Willy lower or equal (DeltaY >= 0):
1016+ 8345                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
1017+ 8345 32 B2 F0         ld   (row_enemy_cur), a
1018+ 8348 AF               xor  a
1019+ 8349 32 B3 F0         ld   (row_willy_cur), a
1020+ 834C 3E 10            ld   a, 16
1021+ 834E 21 B1 F0         ld   hl, collision_delta_y
1022+ 8351 96               sub  (hl)
1023+ 8352 32 B4 F0         ld   (overlap_num_lines), a
1024+ 8355 18 12            jr   .check_lines_loop
1025+ 8357
1026+ 8357              .willy_higher:
1027+ 8357                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
1028+ 8357 ED 44            neg                            ; A = -DeltaY (1..15)
1029+ 8359 32 B3 F0         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
1030+ 835C AF               xor  a
1031+ 835D 32 B2 F0         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
1032+ 8360 3E 10            ld   a, 16
1033+ 8362 21 B3 F0         ld   hl, row_willy_cur
1034+ 8365 96               sub  (hl)
1035+ 8366 32 B4 F0         ld   (overlap_num_lines), a
1036+ 8369
1037+ 8369              .check_lines_loop:
1038+ 8369                  ; ---------------------------------------------------------------
1039+ 8369                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
1040+ 8369                  ; ---------------------------------------------------------------
1041+ 8369 3A B4 F0         ld   a, (overlap_num_lines)
1042+ 836C 47               ld   b, a                      ; B = numero di scanlines da controllare
1043+ 836D
1044+ 836D              .scanline_loop:
1045+ 836D C5               push bc                        ; Salva contatore scanlines
1046+ 836E
1047+ 836E                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
1048+ 836E 3A B2 F0         ld   a, (row_enemy_cur)
1049+ 8371 87               add  a, a                      ; row * 2
1050+ 8372 5F               ld   e, a
1051+ 8373 16 00            ld   d, 0
1052+ 8375 2A AE F0         ld   hl, (guard_sprite_ptr)
1053+ 8378 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
1054+ 8379 56               ld   d, (hl)                   ; D = Enemy Byte 0
1055+ 837A 23               inc  hl
1056+ 837B 5E               ld   e, (hl)                   ; E = Enemy Byte 1
1057+ 837C
1058+ 837C                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
1059+ 837C 3A B0 F0         ld   a, (collision_delta_x)
1060+ 837F CB 7F            bit  7, a
1061+ 8381 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
1062+ 8383
1063+ 8383                  ; DeltaX >= 0:
1064+ 8383 FE 09            cp   9
1065+ 8385 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
1066+ 8387
1067+ 8387                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
1068+ 8387 B7               or   a
1069+ 8388 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
1070+ 838A 4F               ld   c, a                      ; C = DeltaX (1..8)
1071+ 838B              .shift_left_16bit:
1072+ 838B CB 23            sla  e
1073+ 838D CB 12            rl   d
1074+ 838F 0D               dec  c
1075+ 8390 20 F9            jr   nz, .shift_left_16bit
1076+ 8392              .slice_ready_in_d:

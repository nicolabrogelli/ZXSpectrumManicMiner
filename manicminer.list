 106+ 7C94              ; Items_DrawRoom
 107+ 7C94              ;
 108+ 7C94              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 109+ 7C94              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 110+ 7C94              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 111+ 7C94              ;
 112+ 7C94              ; Record item nella stanza (5 byte):
 113+ 7C94              ;   +0 Color / Attributo
 114+ 7C94              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 115+ 7C94              ;   +2 Attr Address High
 116+ 7C94              ;   +3 Anim Mask (96)
 117+ 7C94              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 118+ 7C94              ; Fine lista: $FF
 119+ 7C94              ; -------------------------------------------------------------------
 120+ 7C94              Items_DrawRoom:
 121+ 7C94 E5               push hl
 122+ 7C95 D5               push de
 123+ 7C96 C5               push bc
 124+ 7C97 DD E5            push ix
 125+ 7C99 FD E5            push iy
 126+ 7C9B
 127+ 7C9B                  ; 1. Azzera items_grid (512 byte)
 128+ 7C9B 21 F9 8B         ld   hl, items_grid
 129+ 7C9E 11 FA 8B         ld   de, items_grid + 1
 130+ 7CA1 36 00            ld   (hl), 0
 131+ 7CA3 01 FF 01         ld   bc, 511
 132+ 7CA6 ED B0            ldir
 133+ 7CA8
 134+ 7CA8                  ; 2. Nessun item attivo inizialmente nella cache
 135+ 7CA8 AF               xor  a
 136+ 7CA9 32 78 91         ld   (num_room_items), a
 137+ 7CAC
 138+ 7CAC FD 21 28 91      ld   iy, current_room_items
 139+ 7CB0
 140+ 7CB0                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 141+ 7CB0 2A 79 91         ld   hl, (room_ptr)
 142+ 7CB3 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 143+ 7CB6 19               add  hl, de
 144+ 7CB7 E5               push hl
 145+ 7CB8 DD E1            pop  ix                        ; IX = bitmap item
 146+ 7CBA
 147+ 7CBA                  ; 4. HL = Inizio lista item nella stanza
 148+ 7CBA 2A 79 91         ld   hl, (room_ptr)
 149+ 7CBD 11 75 02         ld   de, OFFSET_ITEMS
 150+ 7CC0 19               add  hl, de
 151+ 7CC1
 152+ 7CC1              .loop:
 153+ 7CC1 7E               ld   a, (hl)                   ; Byte 0: Color
 154+ 7CC2 FE FF            cp   $FF
 155+ 7CC4 28 65            jr   z, .done                  ; $FF = fine lista item
 156+ 7CC6
 157+ 7CC6 5F               ld   e, a                      ; E = Color
 158+ 7CC7 23               inc  hl
 159+ 7CC8 4E               ld   c, (hl)                   ; C = AttrAddr Low
 160+ 7CC9 23               inc  hl
 161+ 7CCA 46               ld   b, (hl)                   ; B = AttrAddr High
 162+ 7CCB 23               inc  hl                        ; Salta Anim Byte
 163+ 7CCC 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 164+ 7CCD
 165+ 7CCD 7E               ld   a, (hl)                   ; A = Collected flag
 166+ 7CCE FE FF            cp   $FF
 167+ 7CD0 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 168+ 7CD2
 169+ 7CD2                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 170+ 7CD2 E5               push hl

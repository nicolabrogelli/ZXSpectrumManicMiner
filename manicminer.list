 717+ 86A4 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 86A6 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento

   8+ 7F91              ; Audio_UpdateJumpSound
   9+ 7F91              ;
  10+ 7F91              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7F91              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7F91              ; -------------------------------------------------------------------
  13+ 7F91              Audio_UpdateJumpSound:
  14+ 7F91 F5               push af
  15+ 7F92 C5               push bc
  16+ 7F93 D5               push de
  17+ 7F94 E5               push hl
  18+ 7F95
  19+ 7F95                  ; Controlla se il suono è attivo (note < 18)
  20+ 7F95 3A C5 98         ld   a, (Audio_jump_sound_note)
  21+ 7F98 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7F9A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7F9C
  24+ 7F9C                  ; Carica la nota corrente da suonare
  25+ 7F9C 5F               ld   e, a
  26+ 7F9D 16 00            ld   d, 0
  27+ 7F9F 21 CB 7F         ld   hl, Audio_JumpSoundDelays
  28+ 7FA2 19               add  hl, de
  29+ 7FA3 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7FA4 57               ld   d, a                      ; D = delay della nota
  31+ 7FA5
  32+ 7FA5                  ; Suona la nota: 15 cicli
  33+ 7FA5 06 0F            ld   b, 15
  34+ 7FA7              .note_loop:
  35+ 7FA7                  ; Speaker ON
  36+ 7FA7 3A B9 92         ld   a, (room_border_color)
  37+ 7FAA F6 10            or   $10
  38+ 7FAC D3 FE            out  ($fe), a
  39+ 7FAE 4A               ld   c, d
  40+ 7FAF              .d1:
  41+ 7FAF 0D               dec  c
  42+ 7FB0 20 FD            jr   nz, .d1
  43+ 7FB2
  44+ 7FB2                  ; Speaker OFF
  45+ 7FB2 3A B9 92         ld   a, (room_border_color)
  46+ 7FB5 E6 EF            and  $ef
  47+ 7FB7 D3 FE            out  ($fe), a
  48+ 7FB9 4A               ld   c, d
  49+ 7FBA              .d2:
  50+ 7FBA 0D               dec  c
  51+ 7FBB 20 FD            jr   nz, .d2
  52+ 7FBD
  53+ 7FBD 10 E8            djnz .note_loop
  54+ 7FBF
  55+ 7FBF                  ; Passa alla nota successiva
  56+ 7FBF 3A C5 98         ld   a, (Audio_jump_sound_note)
  57+ 7FC2 3C               inc  a
  58+ 7FC3 32 C5 98         ld   (Audio_jump_sound_note), a
  59+ 7FC6
  60+ 7FC6              .done:
  61+ 7FC6 E1               pop  hl
  62+ 7FC7 D1               pop  de
  63+ 7FC8 C1               pop  bc
  64+ 7FC9 F1               pop  af
  65+ 7FCA C9               ret
  66+ 7FCB
  67+ 7FCB              Audio_JumpSoundDelays:
  68+ 7FCB 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7FCF 19 13 0C 06
  68+ 7FD3 0C 13 19 20
  68+ 7FD7 26 2D 33 3A
  68+ 7FDB 40 47
  69+ 7FDD

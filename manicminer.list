  93+ E822 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ E823 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ E824 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ E825 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

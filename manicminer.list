 134+ 7E85 7E               ld   a, (hl)                   ; Byte 6: Max limit
 135+ 7E86 E6 1F            and  31
 136+ 7E88 87               add  a, a
 136+ 7E89 87             add a, a
 136+ 7E8A 87             add a, a

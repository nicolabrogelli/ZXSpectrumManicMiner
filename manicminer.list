 621  86C4                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  86C4              .wait_play_again_release:
 623  86C4 76               halt
 624  86C5 01 FE DF         ld   bc, $dffe
 625  86C8 ED 78            in   a, (c)
 626  86CA CB 67            bit  4, a

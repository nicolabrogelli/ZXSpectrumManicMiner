 864+ 6270 D3 FE            out  ($fe), a              ; Bordo a nero
 865+ 6272 21 8D 5C         ld   hl, ATTR_P
 866+ 6275 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 867+ 6276 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 868+ 6279 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 869+ 627B 3E 07            ld   a, $07
 870+ 627D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 871+ 6280
 872+ 6280                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
 873+ 6280 3E 16            ld   a, 22
 874+ 6282 D7               rst  $10
 875+ 6283 3E 01            ld   a, 1
 876+ 6285 D7               rst  $10
 877+ 6286 3E 00            ld   a, 0
 878+ 6288 D7               rst  $10

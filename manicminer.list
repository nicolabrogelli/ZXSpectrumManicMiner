 822  8704              ; CheckWillyConveyorCollision
 823  8704              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 824  8704              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 825  8704              ; -------------------------------------------------------------------
 826  8704              CheckWillyConveyorCollision:
 827  8704 C5               push bc
 828  8705 D5               push de
 829  8706 E5               push hl
 830  8707
 831  8707                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 832  8707 CD 65 77         call CheckWillyOnConveyor
 833  870A 38 49            jr   c, .collision_detected
 834  870C
 835  870C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 836  870C 3A 28 A1         ld   a, (conveyor_len)
 837  870F B7               or   a
 838  8710 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 839  8712
 840  8712                  ; B = WillyY, C = WillyX
 841  8712 ED 4B 00 9E      ld   bc, (PlayerPos)
 842  8716
 843  8716                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 844  8716 3A 29 A1         ld   a, (conveyor_row)
 845  8719 87               add  a, a                  ; *2
 846  871A 87               add  a, a                  ; *4
 847  871B 87               add  a, a                  ; *8
 848  871C 5F               ld   e, a                  ; E = ConveyorTop
 849  871D C6 07            add  a, 7
 850  871F 57               ld   d, a                  ; D = ConveyorBottom
 851  8720
 852  8720                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 853  8720 78               ld   a, b                  ; WillyTop
 854  8721 BA               cp   d
 855  8722 28 04            jr   z, .y_overlap
 856  8724 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 857  8726 18 32            jr   .no_conv_collision
 858  8728
 859  8728              .y_overlap:
 860  8728 C6 0F            add  a, 15                 ; WillyBottom
 861  872A BB               cp   e
 862  872B 28 04            jr   z, .x_check
 863  872D 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 864  872F 18 29            jr   .no_conv_collision
 865  8731
 866  8731              .x_check:
 867  8731                  ; ConveyorLeft = conveyor_col * 8
 868  8731 3A 2A A1         ld   a, (conveyor_col)
 869  8734 87               add  a, a                  ; *2
 870  8735 87               add  a, a                  ; *4
 871  8736 87               add  a, a                  ; *8
 872  8737 5F               ld   e, a                  ; E = ConveyorLeft
 873  8738
 874  8738                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 875  8738 21 28 A1         ld   hl, conveyor_len
 876  873B 3A 2A A1         ld   a, (conveyor_col)
 877  873E 86               add  a, (hl)
 878  873F 87               add  a, a                  ; *2
 879  8740 87               add  a, a                  ; *4
 880  8741 87               add  a, a                  ; *8
 881  8742 3D               dec  a                     ; ConveyorRight
 882  8743 57               ld   d, a                  ; D = ConveyorRight
 883  8744
 884  8744                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 885  8744 79               ld   a, c                  ; WillyLeft
 886  8745 BA               cp   d
 887  8746 28 04            jr   z, .x_overlap
 888  8748 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 889  874A 18 0E            jr   .no_conv_collision
 890  874C
 891  874C              .x_overlap:
 892  874C C6 0F            add  a, 15                 ; WillyRight
 893  874E BB               cp   e
 894  874F 28 04            jr   z, .collision_detected
 895  8751 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 896  8753 18 05            jr   .no_conv_collision
 897  8755
 898  8755              .collision_detected:

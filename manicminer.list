 935+ 7799 96               sub  (hl)              ; A = ramp_col - ramp_len
 936+ 779A              .compare_plat:
 937+ 779A BB               cp   e                 ; Compare with Col
 938+ 779B 20 0B            jr   nz, .no
 939+ 779D
 940+ 779D 3A F9 B5         ld   a, (ramp_row)
 941+ 77A0 21 F8 B5         ld   hl, ramp_len
 942+ 77A3 96               sub  (hl)
 943+ 77A4 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 944+ 77A5 BA               cp   d                 ; Compare with Row
 945+ 77A6 28 04            jr   z, .yes

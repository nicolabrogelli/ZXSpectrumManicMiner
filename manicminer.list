 315+ 7D8D              ; -------------------------------------------------------------------
 316+ 7D8D              ; Enemy_DrawSingleSlot
 317+ 7D8D              ;
 318+ 7D8D              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7D8D              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7D8D              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7D8D              ; -------------------------------------------------------------------
 322+ 7D8D              Enemy_DrawSingleSlot:
 323+ 7D8D C5               push bc
 324+ 7D8E D5               push de
 325+ 7D8F E5               push hl
 326+ 7D90 DD E5            push ix
 327+ 7D92
 328+ 7D92                  ; 1. Determina il frame di animazione (0..7)
 329+ 7D92                  ; Nei dati di Manic Miner:
 330+ 7D92                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7D92                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7D92 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7D95 E6 03            and  3
 334+ 7D97 47               ld   b, a                      ; B = Anim subframe
 335+ 7D98
 336+ 7D98 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7D9B FE 01            cp   1                         ; Sinistra?
 338+ 7D9D 28 03            jr   z, .left_frames
 339+ 7D9F
 340+ 7D9F                  ; Movimento a Destra: Frame 0..3
 341+ 7D9F 78               ld   a, b
 342+ 7DA0 18 03            jr   .got_frame_idx
 343+ 7DA2
 344+ 7DA2              .left_frames:
 345+ 7DA2                  ; Movimento a Sinistra: Frame 4..7
 346+ 7DA2 3E 04            ld   a, 4
 347+ 7DA4 80               add  a, b
 348+ 7DA5
 349+ 7DA5              .got_frame_idx:
 350+ 7DA5                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7DA5 6F               ld   l, a
 352+ 7DA6 26 00            ld   h, 0
 353+ 7DA8 29               add  hl, hl                    ; *2
 354+ 7DA9 29               add  hl, hl                    ; *4
 355+ 7DAA 29               add  hl, hl                    ; *8
 356+ 7DAB 29               add  hl, hl                    ; *16
 357+ 7DAC 29               add  hl, hl                    ; *32
 358+ 7DAD
 359+ 7DAD 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7DB0 19               add  hl, de
 361+ 7DB1 ED 5B 57 98      ld   de, (room_ptr)
 362+ 7DB5 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7DB6 E5               push hl
 364+ 7DB7 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7DB9
 366+ 7DB9                  ; 2. Coordinate e colore
 367+ 7DB9 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7DBB FD E5            push iy
 369+ 7DBD
 370+ 7DBD FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7DC0 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7DC3 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7DC6
 374+ 7DC6                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7DC6 CD 90 5F         call Gfx_DrawPixelSprite16x16
 376+ 7DC9 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7DCC CD 62 6C         call Gfx_SetEnemyColorAttributes
 378+ 7DCF
 379+ 7DCF DD E1            pop  ix
 380+ 7DD1 E1               pop  hl
 381+ 7DD2 D1               pop  de
 382+ 7DD3 C1               pop  bc
 383+ 7DD4 C9               ret

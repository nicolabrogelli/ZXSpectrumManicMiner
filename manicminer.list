  72+ 88C2 ~            ; Audio_UpdateMusic
  73+ 88C2 ~            ;
  74+ 88C2 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 88C2 ~            ; Viene chiamata a ogni frame.
  76+ 88C2 ~            ; -------------------------------------------------------------------
  77+ 88C2 ~            Audio_UpdateMusic:
  78+ 88C2 ~                push af
  79+ 88C2 ~                push bc
  80+ 88C2 ~                push de
  81+ 88C2 ~                push hl
  82+ 88C2 ~
  83+ 88C2 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 88C2 ~                ld   a, (Audio_jump_sound_note)
  85+ 88C2 ~                cp   18
  86+ 88C2 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 88C2 ~
  88+ 88C2 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 88C2 ~                ld   a, (Audio_music_frame_counter)
  90+ 88C2 ~                dec  a
  91+ 88C2 ~                ld   (Audio_music_frame_counter), a
  92+ 88C2 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 88C2 ~
  94+ 88C2 ~                ; Altrimenti carica la nota successiva
  95+ 88C2 ~                ld   a, (Audio_music_note_idx)
  96+ 88C2 ~                inc  a
  97+ 88C2 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 88C2 ~                jr   c, .no_wrap
  99+ 88C2 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 88C2 ~            .no_wrap:
 101+ 88C2 ~                ld   (Audio_music_note_idx), a
 102+ 88C2 ~
 103+ 88C2 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 88C2 ~                ld   e, a
 105+ 88C2 ~                ld   d, 0
 106+ 88C2 ~                ld   hl, Audio_MusicSheet
 107+ 88C2 ~                add  hl, de
 108+ 88C2 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 88C2 ~
 110+ 88C2 ~                ; Leggi durata (secondo byte)
 111+ 88C2 ~                inc  hl
 112+ 88C2 ~                ld   a, (hl)
 113+ 88C2 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 88C2 ~                jr   nz, .dur_ok
 115+ 88C2 ~                ld   a, 1
 116+ 88C2 ~            .dur_ok:
 117+ 88C2 ~                ld   (Audio_music_frame_counter), a
 118+ 88C2 ~
 119+ 88C2 ~            .play_current_note:
 120+ 88C2 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 88C2 ~                ld   a, (Audio_music_note_idx)
 122+ 88C2 ~                ld   e, a
 123+ 88C2 ~                ld   d, 0
 124+ 88C2 ~                ld   hl, Audio_MusicSheet
 125+ 88C2 ~                add  hl, de
 126+ 88C2 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 88C2 ~                ld   a, (hl)                  ; A = delay
 128+ 88C2 ~                or   a
 129+ 88C2 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 88C2 ~
 131+ 88C2 ~                ; Suona la nota: 2 cicli
 132+ 88C2 ~                ld   d, a                     ; D = delay
 133+ 88C2 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 88C2 ~            .note_loop:
 135+ 88C2 ~                ; Speaker ON
 136+ 88C2 ~                ld   a, (room_border_color)
 137+ 88C2 ~                or   $10
 138+ 88C2 ~                out  ($fe), a
 139+ 88C2 ~                ld   c, d
 140+ 88C2 ~            .d1:
 141+ 88C2 ~                push af
 142+ 88C2 ~                pop  af
 143+ 88C2 ~                dec  c
 144+ 88C2 ~                jr   nz, .d1
 145+ 88C2 ~
 146+ 88C2 ~                ; Speaker OFF
 147+ 88C2 ~                ld   a, (room_border_color)
 148+ 88C2 ~                and  $ef
 149+ 88C2 ~                out  ($fe), a
 150+ 88C2 ~                ld   c, d
 151+ 88C2 ~            .d2:
 152+ 88C2 ~                push af
 153+ 88C2 ~                pop  af
 154+ 88C2 ~                dec  c
 155+ 88C2 ~                jr   nz, .d2
 156+ 88C2 ~
 157+ 88C2 ~                djnz .note_loop
 158+ 88C2 ~
 159+ 88C2 ~            .done:
 160+ 88C2 ~                pop  hl
 161+ 88C2 ~                pop  de
 162+ 88C2 ~                pop  bc
 163+ 88C2 ~                pop  af
 164+ 88C2 ~                ret
 165+ 88C2 ~
 166+ 88C2 ~            Audio_MusicSheet:
 167+ 88C2 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 88C2 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 88C2 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 88C2 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 88C2 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 88C2 ~                db 90, 10, 107, 20, 68, 65
 173+ 88C2                  ELSE
 174+ 88C2              Audio_UpdateMusic:
 175+ 88C2 C9               ret
 176+ 88C3                  ENDIF

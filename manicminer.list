 640+ 6070 3A 77 93         ld   a, (player_drawn_pos+1)
 641+ 6073 FE FF            cp   $FF
 642+ 6075 28 19            jr   z, .redraw_overlay_only
 643+ 6077
 644+ 6077 ED 4B 76 93      ld   bc, (player_drawn_pos)
 645+ 607B CD F9 5E         call Gfx_ErasePixelSprite8x8    ; Cancella testa
 646+ 607E ED 4B 76 93      ld   bc, (player_drawn_pos)

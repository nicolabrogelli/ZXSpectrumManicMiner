 178+ 7FDE              ; -------------------------------------------------------------------
 179+ 7FDE              ; Audio_PlayCollectSound
 180+ 7FDE              ;
 181+ 7FDE              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7FDE              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7FDE              ; -------------------------------------------------------------------
 184+ 7FDE              Audio_PlayCollectSound:
 185+ 7FDE C5               push bc
 186+ 7FDF D5               push de
 187+ 7FE0
 188+ 7FE0 06 78            ld   b, 120
 189+ 7FE2              .sound_loop:
 190+ 7FE2 3A B9 92         ld   a, (room_border_color)
 191+ 7FE5 F6 10            or   $10               ; speaker ON
 192+ 7FE7 D3 FE            out  ($fe), a
 193+ 7FE9
 194+ 7FE9 0E 3C            ld   c, 60
 195+ 7FEB              .d1:
 196+ 7FEB 0D               dec  c
 197+ 7FEC 20 FD            jr   nz, .d1
 198+ 7FEE
 199+ 7FEE 3A B9 92         ld   a, (room_border_color)
 200+ 7FF1 E6 EF            and  $ef              ; speaker OFF
 201+ 7FF3 D3 FE            out  ($fe), a
 202+ 7FF5
 203+ 7FF5 0E 3C            ld   c, 60
 204+ 7FF7              .d2:
 205+ 7FF7 0D               dec  c
 206+ 7FF8 20 FD            jr   nz, .d2
 207+ 7FFA
 208+ 7FFA 10 E6            djnz .sound_loop
 209+ 7FFC
 210+ 7FFC D1               pop  de
 211+ 7FFD C1               pop  bc
 212+ 7FFE C9               ret

 127+ 8712 ~                ld   a, (hl)                  ; A = delay
 128+ 8712 ~                or   a
 129+ 8712 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8712 ~
 131+ 8712 ~                ; Suona la nota: 2 cicli
 132+ 8712 ~                ld   d, a                     ; D = delay
 133+ 8712 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8712 ~            .note_loop:
 135+ 8712 ~                ; Speaker ON
 136+ 8712 ~                ld   a, (room_border_color)
 137+ 8712 ~                or   $10
 138+ 8712 ~                out  ($fe), a
 139+ 8712 ~                ld   c, d
 140+ 8712 ~            .d1:
 141+ 8712 ~                push af
 142+ 8712 ~                pop  af

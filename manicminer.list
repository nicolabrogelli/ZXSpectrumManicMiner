1628+ 666F 6F               ld   l, a
1629+ 6670 26 00            ld   h, 0
1630+ 6672 29               add  hl, hl                ; * 2
1631+ 6673 29               add  hl, hl                ; * 4
1632+ 6674 29               add  hl, hl                ; * 8
1633+ 6675 29               add  hl, hl                ; * 16
1634+ 6676 29               add  hl, hl                ; * 32

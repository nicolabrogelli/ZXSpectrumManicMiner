 229+ 7DE1 DD 36 03 58      ld   (ix+3), 88                ; Initial Y = 88
 230+ 7DE5 DD 36 04 00      ld   (ix+4), 0                 ; Min Limit Y = 0
 231+ 7DE9 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88

 408+ 82CE              ; CheckWillyItemCollision
 409+ 82CE              ;
 410+ 82CE              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 82CE              ; Input:
 412+ 82CE              ;   A = Item Col (0..31)
 413+ 82CE              ;   H = Item Row (0..15)
 414+ 82CE              ; Output:
 415+ 82CE              ;   Carry Set = Collisione
 416+ 82CE              ;   Carry Clear = Nessuna collisione
 417+ 82CE              ; -------------------------------------------------------------------
 418+ 82CE              CheckWillyItemCollision:
 419+ 82CE C5               push bc
 420+ 82CF D5               push de
 421+ 82D0 E5               push hl
 422+ 82D1
 423+ 82D1                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

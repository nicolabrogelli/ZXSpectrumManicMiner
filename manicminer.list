 261  898C              .draw_raster_bars:
 262  898C                  ; Collisione attiva: disegna le raster bar nel bordo
 263  898C 3A 68 EA         ld   a, (counter)
 264  898F E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 265  8991 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  8993              .raster_loop:
 267  8993 D3 FE            out  ($fe), a
 268  8995 3C               inc  a
 269  8996 E6 07            and  7
 270  8998 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  899A              .delay:
 272  899A 0D               dec  c
 273  899B 20 FD            jr   nz, .delay
 274  899D 10 F4            djnz .raster_loop
 275  899F
 276  899F                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  899F 3A 53 EA         ld   a, (room_border_color)
 278  89A2 D3 FE            out  ($fe), a
 279  89A4 18 05            jr   .no_collision_change
 280  89A6
 281  89A6              .no_collision:
 282  89A6                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 283  89A6 3A 53 EA         ld   a, (room_border_color)
 284  89A9 D3 FE            out  ($fe), a
 285  89AB
 286  89AB              .no_collision_change:
 287  89AB C3 D2 88         jp   Main_loop
 288  89AE
 289  89AE              ; -------------------------------------------------------------------
 290  89AE              ; ShowTitleScreen
 291  89AE              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  89AE              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  89AE              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  89AE              ; -------------------------------------------------------------------
 295  89AE              ShowTitleScreen:
 296  89AE                  ; 1. Disegna la schermata iniziale
 297  89AE CD 7A 64         call Gfx_DrawTitleScreen
 298  89B1
 299  89B1                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  89B1              .wait_title_enter_release:
 301  89B1 76               halt
 302  89B2 3E BF            ld   a, $bf
 303  89B4 DB FE            in   a, ($fe)
 304  89B6 1F               rra
 305  89B7 30 F8            jr   nc, .wait_title_enter_release
 306  89B9
 307  89B9                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  89B9 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  89BB              .title_loop:
 310  89BB 76               halt
 311  89BC
 312  89BC                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  89BC 0C               inc  c
 314  89BD 79               ld   a, c
 315  89BE CB 3F            srl  a
 316  89C0 CB 3F            srl  a
 317  89C2 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  89C4 E6 07            and  7
 319  89C6 5F               ld   e, a
 320  89C7 16 00            ld   d, 0
 321  89C9 21 72 64         ld   hl, title_color_table
 322  89CC 19               add  hl, de
 323  89CD 7E               ld   a, (hl)               ; A = nuovo colore
 324  89CE 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  89D1 06 20            ld   b, 32
 326  89D3              .color_title_loop:
 327  89D3 77               ld   (hl), a
 328  89D4 23               inc  hl
 329  89D5 10 FC            djnz .color_title_loop
 330  89D7
 331  89D7                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  89D7 3E BF            ld   a, $bf
 333  89D9 DB FE            in   a, ($fe)
 334  89DB 1F               rra
 335  89DC 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  89DE
 337  89DE                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  89DE              .wait_title_enter_release_after:
 339  89DE 76               halt
 340  89DF 3E BF            ld   a, $bf
 341  89E1 DB FE            in   a, ($fe)
 342  89E3 1F               rra
 343  89E4 30 F8            jr   nc, .wait_title_enter_release_after
 344  89E6
 345  89E6                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  89E6 AF               xor  a
 347  89E7 D3 FE            out  ($fe), a              ; Bordo a nero
 348  89E9 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  89EC
 350  89EC                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  89EC CD AD 8B         call ResetFullGameState
 352  89EF
 353  89EF                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  89EF C3 6F 88         jp   LoadRoomAndRestart
 355  89F2
 356  89F2              ; -------------------------------------------------------------------
 357  89F2              ; TriggerGameOver
 358  89F2              ; Scatena la sequenza originale di Game Over:
 359  89F2              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  89F2              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  89F2              ;   con suono beeper originale e lampeggio dello schermo.
 362  89F2              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  89F2              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  89F2              ; -------------------------------------------------------------------
 365  89F2              TriggerGameOver:
 366  89F2                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  89F2 CD 59 87         call Score_CheckAndUpdateHighScore
 368  89F5
 369  89F5                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  89F5 CD 12 66         call Gfx_DrawGameOverScreen
 371  89F8
 372  89F8                  ; 3. Ritorna al Title Screen originale
 373  89F8 C3 AE 89         jp   ShowTitleScreen
 374  89FB
 375  89FB              ; -------------------------------------------------------------------
 376  89FB              ; TriggerVictory
 377  89FB              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  89FB              ; - Pulisce gli elementi di gioco della stanza.
 379  89FB              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  89FB              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  89FB              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  89FB              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  89FB              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  89FB              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  89FB              ; -------------------------------------------------------------------
 386  89FB              TriggerVictory:
 387  89FB                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  89FB CD FD 66         call Gfx_DrawVictoryScreen
 389  89FE
 390  89FE                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  89FE              .wait_keys_release:
 392  89FE 76               halt
 393  89FF                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  89FF 01 FE DF         ld   bc, $dffe
 395  8A02 ED 78            in   a, (c)
 396  8A04 CB 67            bit  4, a
 397  8A06 28 F6            jr   z, .wait_keys_release
 398  8A08
 399  8A08                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8A08 01 FE 7F         ld   bc, $7ffe
 401  8A0B ED 78            in   a, (c)
 402  8A0D CB 5F            bit  3, a
 403  8A0F 28 ED            jr   z, .wait_keys_release
 404  8A11
 405  8A11                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8A11 01 FE BF         ld   bc, $bffe
 407  8A14 ED 78            in   a, (c)
 408  8A16 CB 47            bit  0, a
 409  8A18 28 E4            jr   z, .wait_keys_release
 410  8A1A
 411  8A1A                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8A1A 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8A1C              .wait_choice_loop:
 414  8A1C 76               halt
 415  8A1D
 416  8A1D                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8A1D 0C               inc  c
 418  8A1E 79               ld   a, c
 419  8A1F CB 3F            srl  a
 420  8A21 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8A23 E6 07            and  7
 422  8A25 5F               ld   e, a
 423  8A26 16 00            ld   d, 0
 424  8A28 21 F4 65         ld   hl, victory_color_table
 425  8A2B 19               add  hl, de
 426  8A2C 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8A2D 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8A30 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8A32              .color_cycle_loop:
 430  8A32 77               ld   (hl), a
 431  8A33 23               inc  hl
 432  8A34 10 FC            djnz .color_cycle_loop
 433  8A36
 434  8A36                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8A36 01 FE DF         ld   bc, $dffe
 436  8A39 ED 78            in   a, (c)
 437  8A3B CB 67            bit  4, a
 438  8A3D 28 2A            jr   z, .play_again_chosen
 439  8A3F
 440  8A3F                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8A3F 01 FE 7F         ld   bc, $7ffe
 442  8A42 ED 78            in   a, (c)
 443  8A44 CB 5F            bit  3, a
 444  8A46 28 0B            jr   z, .quit_chosen
 445  8A48
 446  8A48                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8A48 01 FE BF         ld   bc, $bffe
 448  8A4B ED 78            in   a, (c)
 449  8A4D CB 47            bit  0, a
 450  8A4F 28 02            jr   z, .quit_chosen
 451  8A51
 452  8A51 18 C9            jr   .wait_choice_loop
 453  8A53
 454  8A53              .quit_chosen:
 455  8A53                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8A53              .wait_quit_release:
 457  8A53 76               halt
 458  8A54 01 FE 7F         ld   bc, $7ffe
 459  8A57 ED 78            in   a, (c)
 460  8A59 CB 5F            bit  3, a
 461  8A5B 28 F6            jr   z, .wait_quit_release
 462  8A5D 01 FE BF         ld   bc, $bffe
 463  8A60 ED 78            in   a, (c)
 464  8A62 CB 47            bit  0, a
 465  8A64 28 ED            jr   z, .wait_quit_release
 466  8A66
 467  8A66                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8A66 C3 AE 89         jp   ShowTitleScreen
 469  8A69
 470  8A69              .play_again_chosen:
 471  8A69                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8A69              .wait_play_again_release:
 473  8A69 76               halt
 474  8A6A 01 FE DF         ld   bc, $dffe
 475  8A6D ED 78            in   a, (c)
 476  8A6F CB 67            bit  4, a
 477  8A71 28 F6            jr   z, .wait_play_again_release
 478  8A73
 479  8A73                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8A73 CD AD 8B         call ResetFullGameState
 481  8A76 C3 6F 88         jp   LoadRoomAndRestart
 482  8A79
 483  8A79              ; -------------------------------------------------------------------
 484  8A79              ; CheckPortalTransition
 485  8A79              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8A79              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8A79              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8A79              ;
 489  8A79              ; Output:
 490  8A79              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8A79              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8A79              ; -------------------------------------------------------------------
 493  8A79              CheckPortalTransition:
 494  8A79 C5               push bc
 495  8A7A D5               push de
 496  8A7B E5               push hl
 497  8A7C
 498  8A7C                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8A7C CD 40 8B         call CheckAllItemsCollected
 500  8A7F 30 4D            jr   nc, .no_transition
 501  8A81
 502  8A81                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8A81                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8A81                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8A81 2A C8 ED         ld   hl, (room_ptr)
 506  8A84 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8A87 19               add  hl, de
 508  8A88 4E               ld   c, (hl)
 509  8A89 23               inc  hl
 510  8A8A 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8A8B
 512  8A8B                  ; Offset = BC - 23552
 513  8A8B 60               ld   h, b
 514  8A8C 69               ld   l, c
 515  8A8D 01 00 A4         ld   bc, -23552
 516  8A90 09               add  hl, bc
 517  8A91
 518  8A91                  ; PortalX = (Offset & 31) * 8
 519  8A91 7D               ld   a, l
 520  8A92 E6 1F            and  31
 521  8A94 87               add  a, a
 521  8A95 87             add a, a
 521  8A96 87             add a, a
 522  8A97 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8A98
 524  8A98                  ; PortalY = (Offset / 32) * 8
 525  8A98 CB 3C            srl  h
 525  8A9A CB 1D          rr l
 526  8A9C CB 3C            srl  h
 526  8A9E CB 1D          rr l
 527  8AA0 CB 3C            srl  h
 527  8AA2 CB 1D          rr l
 528  8AA4 CB 3C            srl  h
 528  8AA6 CB 1D          rr l
 529  8AA8 CB 3C            srl  h
 529  8AAA CB 1D          rr l
 530  8AAC 7D               ld   a, l
 531  8AAD 87               add  a, a
 531  8AAE 87             add a, a
 531  8AAF 87             add a, a
 532  8AB0 57               ld   d, a                      ; D = PortalY (0..120)
 533  8AB1
 534  8AB1                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8AB1 ED 4B 47 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8AB5
 537  8AB5                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8AB5 7B               ld   a, e
 539  8AB6 91               sub  c
 540  8AB7 30 02            jr   nc, .x_diff_pos
 541  8AB9 ED 44            neg
 542  8ABB              .x_diff_pos:
 543  8ABB FE 0C            cp   12
 544  8ABD 30 0F            jr   nc, .no_transition
 545  8ABF
 546  8ABF                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8ABF 7A               ld   a, d
 548  8AC0 90               sub  b
 549  8AC1 30 02            jr   nc, .y_diff_pos
 550  8AC3 ED 44            neg
 551  8AC5              .y_diff_pos:
 552  8AC5 FE 0E            cp   14
 553  8AC7 30 05            jr   nc, .no_transition
 554  8AC9
 555  8AC9                  ; Transizione al portale attiva!
 556  8AC9 E1               pop  hl
 557  8ACA D1               pop  de
 558  8ACB C1               pop  bc
 559  8ACC 37               scf
 560  8ACD C9               ret
 561  8ACE
 562  8ACE              .no_transition:
 563  8ACE E1               pop  hl
 564  8ACF D1               pop  de
 565  8AD0 C1               pop  bc
 566  8AD1 B7               or   a
 567  8AD2 C9               ret
 568  8AD3
 569  8AD3              ; Alias per retrocompatibilità
 570  8AD3              CheckVictoryCondition: EQU CheckPortalTransition
 571  8AD3
 572  8AD3              ; -------------------------------------------------------------------
 573  8AD3              ; TriggerPortalTransition
 574  8AD3              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8AD3              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8AD3              ; - Avanza all'indice della stanza successiva.
 577  8AD3              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8AD3              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8AD3              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8AD3              ; -------------------------------------------------------------------
 581  8AD3              TriggerPortalTransition:
 582  8AD3                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8AD3 CD 0A 8B         call Air_DepleteCountdown
 584  8AD6
 585  8AD6                  ; 1. Determina l'ID della stanza corrente
 586  8AD6 CD 9A 84         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8AD9
 588  8AD9                  ; 2. Calcola l'indice della stanza successiva
 589  8AD9 3A 6D ED         ld   a, (current_room)
 590  8ADC 3C               inc  a
 591  8ADD FE 14            cp   NUM_ROOMS
 592  8ADF 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8AE1
 594  8AE1                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8AE1 21 8E 73         ld   hl, RoomsListTable
 596  8AE4 5F               ld   e, a
 597  8AE5 16 00            ld   d, 0
 598  8AE7 19               add  hl, de
 599  8AE8 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8AE9 5E               ld   e, (hl)
 601  8AEA 23               inc  hl
 602  8AEB 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8AEC ED 53 C8 ED      ld   (room_ptr), de
 604  8AF0
 605  8AF0                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8AF0 AF               xor  a
 607  8AF1 32 CE ED         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8AF4 32 55 EA         ld   (velocity_y), a
 609  8AF7 32 60 F0         ld   (game_objective_completed), a
 610  8AFA 3E 01            ld   a, 1
 611  8AFC 32 56 EA         ld   (on_ground), a
 612  8AFF
 613  8AFF                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8AFF 3E 07            ld   a, $07
 615  8B01 CD 9D 62         call Gfx_ClearScreenDirect
 616  8B04
 617  8B04 C3 6F 88         jp   LoadRoomAndRestart
 618  8B07
 619  8B07              .all_rooms_completed:
 620  8B07                  ; Tutte le stanze sono state completate con successo!
 621  8B07                  IF ENABLE_VICTORY_SCREEN != 0
 622  8B07 C3 FB 89         jp   TriggerVictory
 623  8B0A                  ELSE
 624  8B0A ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8B0A ~                ld   de, (RoomsListTable)
 626  8B0A ~                ld   (room_ptr), de
 627  8B0A ~                xor  a
 628  8B0A ~                ld   (transition_active), a
 629  8B0A ~                ld   (velocity_y), a
 630  8B0A ~                ld   (game_objective_completed), a
 631  8B0A ~                ld   a, 1
 632  8B0A ~                ld   (on_ground), a
 633  8B0A ~                ld   a, $07
 634  8B0A ~                call Gfx_ClearScreenDirect
 635  8B0A ~                jp   LoadRoomAndRestart
 636  8B0A                  ENDIF
 637  8B0A
 638  8B0A              ; -------------------------------------------------------------------
 639  8B0A              ; Air_DepleteCountdown
 640  8B0A              ; Animazione originale di completamento livello (Manic Miner):
 641  8B0A              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8B0A              ; - Ad ogni pixel decrementato:
 643  8B0A              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8B0A              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8B0A              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8B0A              ; -------------------------------------------------------------------
 647  8B0A              Air_DepleteCountdown:
 648  8B0A F5               push af
 649  8B0B C5               push bc
 650  8B0C D5               push de
 651  8B0D E5               push hl
 652  8B0E
 653  8B0E              .countdown_loop:
 654  8B0E 3A 69 F0         ld   a, (air_pixels)
 655  8B11 B7               or   a
 656  8B12 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8B14
 658  8B14 3D               dec  a
 659  8B15 32 69 F0         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8B18
 661  8B18                  ; Aggiorna la barra grafica dell'aria
 662  8B18 CD 2D 6A         call Gfx_UpdateAirBar
 663  8B1B
 664  8B1B                  ; Aggiungi 1 punto allo score
 665  8B1B CD 0E 87         call Score_Add1Point
 666  8B1E
 667  8B1E                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8B1E                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8B1E 3A 69 F0         ld   a, (air_pixels)
 670  8B21 2F               cpl
 671  8B22 E6 3F            and  63
 672  8B24 07               rlca
 673  8B25 3C               inc  a
 674  8B26 57               ld   d, a                      ; D = ritardo semionda audio
 675  8B27
 676  8B27 0E 03            ld   c, 3                      ; Durata impulso
 677  8B29              .audio_loop:
 678  8B29 AF               xor  a
 679  8B2A D3 FE            out  ($fe), a
 680  8B2C 42               ld   b, d
 681  8B2D 10 FE        .w1: djnz .w1
 682  8B2F
 683  8B2F 3E 18            ld   a, $18
 684  8B31 D3 FE            out  ($fe), a
 685  8B33 42               ld   b, d
 686  8B34 10 FE        .w2: djnz .w2
 687  8B36
 688  8B36 0D               dec  c
 689  8B37 20 F0            jr   nz, .audio_loop
 690  8B39
 691  8B39 18 D3            jr   .countdown_loop
 692  8B3B
 693  8B3B              .done_countdown:
 694  8B3B E1               pop  hl
 695  8B3C D1               pop  de
 696  8B3D C1               pop  bc
 697  8B3E F1               pop  af
 698  8B3F C9               ret

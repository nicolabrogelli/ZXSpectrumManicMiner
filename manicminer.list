1135+ 7882              ; -------------------------------------------------------------------
1136+ 7882              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7882              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7882              ; Output: A = tipo di cella (0..3)
1139+ 7882              ; Preserva tutti gli altri registri.
1140+ 7882              ; -------------------------------------------------------------------
1141+ 7882              GetCellFromUnpacked:
1142+ 7882 E5               push hl
1143+ 7883 D5               push de
1144+ 7884
1145+ 7884 6F               ld   l, a
1146+ 7885 26 00            ld   h, 0
1147+ 7887 29               add  hl, hl
1148+ 7888 29               add  hl, hl
1149+ 7889 29               add  hl, hl
1150+ 788A 29               add  hl, hl
1151+ 788B 29               add  hl, hl            ; HL = Row * 32
1152+ 788C 59               ld   e, c
1153+ 788D 16 00            ld   d, 0
1154+ 788F 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 7890 11 10 E0         ld   de, unpacked_layout
1156+ 7893 19               add  hl, de
1157+ 7894 7E               ld   a, (hl)           ; A = cell type
1158+ 7895
1159+ 7895 D1               pop  de
1160+ 7896 E1               pop  hl
1161+ 7897 C9               ret

  86+ 808C 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 808E 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 808F 23               inc  hl                        ; +2 (Attr Address High)
  89+ 8090 23               inc  hl                        ; +3 (Anim mask)
  90+ 8091 23               inc  hl                        ; +4 (Collected flag)
  91+ 8092 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 8094 23               inc  hl                        ; Avanza al prossimo item
  93+ 8095 18 F2            jr   .item_loop
  94+ 8097
  95+ 8097              .next_room:
  96+ 8097 E1               pop  hl
  97+ 8098 C1               pop  bc
  98+ 8099 10 E4            djnz .room_loop
  99+ 809B
 100+ 809B C1               pop  bc
 101+ 809C D1               pop  de
 102+ 809D E1               pop  hl

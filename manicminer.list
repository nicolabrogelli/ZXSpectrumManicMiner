 353+ 7AFE 29               add  hl, hl                    ; *2
 354+ 7AFF 29               add  hl, hl                    ; *4
 355+ 7B00 29               add  hl, hl                    ; *8
 356+ 7B01 29               add  hl, hl                    ; *16
 357+ 7B02 29               add  hl, hl                    ; *32
 358+ 7B03
 359+ 7B03 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7B06 19               add  hl, de

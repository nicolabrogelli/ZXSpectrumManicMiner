2127+ 7CAE BE               cp   (hl)
2128+ 7CAF 38 14            jr   c, .no_deplete
2129+ 7CB1
2130+ 7CB1                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2131+ 7CB1 AF               xor  a
2132+ 7CB2 32 1C A4         ld   (air_timer), a
2133+ 7CB5
2134+ 7CB5 3A 1B A4         ld   a, (air_pixels)
2135+ 7CB8 B7               or   a
2136+ 7CB9 28 0C            jr   z, .air_finished
2137+ 7CBB
2138+ 7CBB 3D               dec  a
2139+ 7CBC 32 1B A4         ld   (air_pixels), a
2140+ 7CBF CD 51 6A         call Gfx_UpdateAirBar
2141+ 7CC2
2142+ 7CC2 B7               or   a
2143+ 7CC3 28 02            jr   z, .air_finished

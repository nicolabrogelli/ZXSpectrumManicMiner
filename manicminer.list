 464+ 82FB                  ; WillyTop <= ItemBottom
 465+ 82FB 78               ld   a, b                      ; A = WillyY
 466+ 82FC BA               cp   d                         ; D = ItemBottom
 467+ 82FD 28 04            jr   z, .y_ok
 468+ 82FF 38 02            jr   c, .y_ok
 469+ 8301 18 13            jr   .no_collision
 470+ 8303
 471+ 8303              .y_ok:
 472+ 8303                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 8303 BB               cp   e                         ; E = ItemTop
 474+ 8304 28 0B            jr   z, .collision
 475+ 8306 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 8308
 477+ 8308                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 8308 C6 0F            add  a, 15
 479+ 830A BB               cp   e
 480+ 830B 28 04            jr   z, .collision
 481+ 830D 30 02            jr   nc, .collision

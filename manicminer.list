 374  85E7 01 FE DF         ld   bc, $dffe
 375  85EA ED 78            in   a, (c)
 376  85EC CB 67            bit  4, a
 377  85EE 28 F6            jr   z, .wait_keys_release
 378  85F0
 379  85F0                  ; Controlla tasto N (Porta $7F, bit 3)
 380  85F0 01 FE 7F         ld   bc, $7ffe
 381  85F3 ED 78            in   a, (c)
 382  85F5 CB 5F            bit  3, a
 383  85F7 28 ED            jr   z, .wait_keys_release
 384  85F9
 385  85F9                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  85F9 01 FE BF         ld   bc, $bffe
 387  85FC ED 78            in   a, (c)
 388  85FE CB 47            bit  0, a
 389  8600 28 E4            jr   z, .wait_keys_release

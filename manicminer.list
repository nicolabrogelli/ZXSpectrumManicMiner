 408+ 8083              ; CheckWillyItemCollision
 409+ 8083              ;
 410+ 8083              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 8083              ; Input:
 412+ 8083              ;   A = Item Col (0..31)
 413+ 8083              ;   H = Item Row (0..15)
 414+ 8083              ; Output:
 415+ 8083              ;   Carry Set = Collisione
 416+ 8083              ;   Carry Clear = Nessuna collisione
 417+ 8083              ; -------------------------------------------------------------------
 418+ 8083              CheckWillyItemCollision:
 419+ 8083 C5               push bc
 420+ 8084 D5               push de
 421+ 8085 E5               push hl
 422+ 8086
 423+ 8086                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 8086 6F               ld   l, a
 425+ 8087 87               add  a, a                      ; *2
 426+ 8088 87               add  a, a                      ; *4
 427+ 8089 87               add  a, a                      ; *8
 428+ 808A 5F               ld   e, a                      ; E = ItemLeft
 429+ 808B C6 07            add  a, 7
 430+ 808D 57               ld   d, a                      ; D = ItemRight
 431+ 808E
 432+ 808E ED 4B D7 94      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 8092
 434+ 8092                  ; WillyLeft <= ItemRight
 435+ 8092 79               ld   a, c                      ; A = WillyX
 436+ 8093 BA               cp   d                         ; D = ItemRight
 437+ 8094 28 04            jr   z, .x_ok
 438+ 8096 38 02            jr   c, .x_ok
 439+ 8098 18 31            jr   .no_collision
 440+ 809A
 441+ 809A              .x_ok:
 442+ 809A                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 809A BB               cp   e                         ; E = ItemLeft
 444+ 809B 28 0B            jr   z, .y_check
 445+ 809D 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 809F
 447+ 809F                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 809F C6 0F            add  a, 15
 449+ 80A1 BB               cp   e
 450+ 80A2 28 04            jr   z, .y_check
 451+ 80A4 30 02            jr   nc, .y_check
 452+ 80A6 18 23            jr   .no_collision
 453+ 80A8
 454+ 80A8              .y_check:
 455+ 80A8                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 80A8 7C               ld   a, h                      ; H = Item Row
 457+ 80A9 87               add  a, a                      ; *2
 458+ 80AA 87               add  a, a                      ; *4
 459+ 80AB 87               add  a, a                      ; *8
 460+ 80AC 5F               ld   e, a                      ; E = ItemTop

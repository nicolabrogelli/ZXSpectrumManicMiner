 731  871E              ; -------------------------------------------------------------------
 732  871E              ; TriggerPortalTransition
 733  871E              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 734  871E              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 735  871E              ; - Avanza all'indice della stanza successiva.
 736  871E              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 737  871E              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 738  871E              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 739  871E              ; -------------------------------------------------------------------
 740  871E              TriggerPortalTransition:
 741  871E                  ; 1. Determina l'ID della stanza corrente
 742  871E CD 81 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 743  8721
 744  8721                  ; 2. Calcola l'indice della stanza successiva
 745  8721 3A 8D 99         ld   a, (current_room)
 746  8724 3C               inc  a
 747  8725 FE 02            cp   NUM_ROOMS
 748  8727 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 749  8729
 750  8729                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 751  8729 21 6B 73         ld   hl, RoomsListTable
 752  872C 5F               ld   e, a
 753  872D 16 00            ld   d, 0
 754  872F 19               add  hl, de
 755  8730 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 756  8731 5E               ld   e, (hl)
 757  8732 23               inc  hl
 758  8733 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 759  8734 ED 53 E7 99      ld   (room_ptr), de
 760  8738
 761  8738                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 762  8738 AF               xor  a
 763  8739 32 ED 99         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 764  873C 32 75 96         ld   (velocity_y), a
 765  873F 32 7C 9C         ld   (game_objective_completed), a
 766  8742 3E 01            ld   a, 1
 767  8744 32 76 96         ld   (on_ground), a
 768  8747
 769  8747                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 770  8747 21 8D 5C         ld   hl, ATTR_P
 771  874A 36 07            ld   (hl), $07
 772  874C CD AF 0D         call CLS
 773  874F
 774  874F C3 D5 83         jp   LoadRoomAndRestart
 775  8752
 776  8752              .all_rooms_completed:
 777  8752                  ; Tutte le stanze sono state completate con successo!
 778  8752                  IF ENABLE_VICTORY_SCREEN != 0
 779  8752 C3 46 86         jp   TriggerVictory
 780  8755                  ELSE
 781  8755 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 782  8755 ~                ld   de, (RoomsListTable)
 783  8755 ~                ld   (room_ptr), de
 784  8755 ~                xor  a
 785  8755 ~                ld   (transition_active), a
 786  8755 ~                ld   (velocity_y), a
 787  8755 ~                ld   (game_objective_completed), a
 788  8755 ~                ld   a, 1
 789  8755 ~                ld   (on_ground), a
 790  8755 ~                ld   hl, ATTR_P
 791  8755 ~                ld   (hl), $07
 792  8755 ~                call CLS
 793  8755 ~                jp   LoadRoomAndRestart
 794  8755                  ENDIF

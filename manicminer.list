1643+ 666D                  ; 7. Animazione: Discesa fluida di PiedeSprite dall'alto (Y=0) fino a Y=96 (alla parte alta della Botte)
1644+ 666D 06 00            ld   b, 0                  ; B = Y iniziale (0)
1645+ 666F              .foot_descent_loop:
1646+ 666F C5               push bc                    ; Salva B = Y corrente
1647+ 6670
1648+ 6670                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1649+ 6670 78               ld   a, b
1650+ 6671 B7               or   a
1651+ 6672 28 1F            jr   z, .skip_clear_prev
1652+ 6674 D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1653+ 6676 47               ld   b, a
1654+ 6677 0E 78            ld   c, 120                ; X = 120
1655+ 6679 CD 20 63         call Gfx_Clear16x16_Black
1656+ 667C
1657+ 667C                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1658+ 667C 78               ld   a, b
1659+ 667D CB 3F            srl  a
1660+ 667F CB 3F            srl  a
1661+ 6681 CB 3F            srl  a                     ; A = Row da azzerare
1662+ 6683 6F               ld   l, a
1663+ 6684 26 00            ld   h, 0
1664+ 6686 29               add  hl, hl                ; * 2
1665+ 6687 29               add  hl, hl                ; * 4
1666+ 6688 29               add  hl, hl                ; * 8
1667+ 6689 29               add  hl, hl                ; * 16
1668+ 668A 29               add  hl, hl                ; * 32
1669+ 668B 11 0F 58         ld   de, $580f             ; $5800 + 15
1670+ 668E 19               add  hl, de
1671+ 668F AF               xor  a
1672+ 6690 77               ld   (hl), a               ; Col 15 = 0
1673+ 6691 23               inc  hl
1674+ 6692 77               ld   (hl), a               ; Col 16 = 0

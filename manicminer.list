 405+ 7EFC
 406+ 7EFC                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 407+ 7EFC DD 7E 08         ld   a, (ix+8)         ; Old X
 408+ 7EFF DD BE 02         cp   (ix+2)            ; Current X
 409+ 7F02 20 0E            jr   nz, .do_draw_slot

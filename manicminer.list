 702  8BFC              ; CheckAllItemsCollected
 703  8BFC              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 704  8BFC              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 705  8BFC              ; -------------------------------------------------------------------
 706  8BFC              CheckAllItemsCollected:
 707  8BFC 3A 1D F1         ld   a, (game_objective_completed)
 708  8BFF B7               or   a
 709  8C00 20 08            jr   nz, .all_collected
 710  8C02 3A 84 EE         ld   a, (num_room_items)
 711  8C05 B7               or   a
 712  8C06 28 02            jr   z, .all_collected
 713  8C08 B7               or   a
 714  8C09 C9               ret
 715  8C0A              .all_collected:
 716  8C0A 37               scf
 717  8C0B C9               ret

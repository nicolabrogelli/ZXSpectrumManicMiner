2130+ 7E62              ; Phys_UpdateAir
2131+ 7E62              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2132+ 7E62              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2133+ 7E62              ; Output:
2134+ 7E62              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2135+ 7E62              ;   Carry Clear = Aria ancora disponibile
2136+ 7E62              ; -------------------------------------------------------------------
2137+ 7E62              Phys_UpdateAir:
2138+ 7E62                  ; Incrementa il timer dei frame
2139+ 7E62 3A 04 F2         ld   a, (air_timer)
2140+ 7E65 3C               inc  a
2141+ 7E66 32 04 F2         ld   (air_timer), a
2142+ 7E69 21 05 F2         ld   hl, air_deplete_rate
2143+ 7E6C BE               cp   (hl)
2144+ 7E6D 38 14            jr   c, .no_deplete
2145+ 7E6F
2146+ 7E6F                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2147+ 7E6F AF               xor  a
2148+ 7E70 32 04 F2         ld   (air_timer), a
2149+ 7E73
2150+ 7E73 3A 03 F2         ld   a, (air_pixels)
2151+ 7E76 B7               or   a
2152+ 7E77 28 0C            jr   z, .air_finished
2153+ 7E79
2154+ 7E79 3D               dec  a
2155+ 7E7A 32 03 F2         ld   (air_pixels), a
2156+ 7E7D CD 42 6A         call Gfx_UpdateAirBar
2157+ 7E80
2158+ 7E80 B7               or   a
2159+ 7E81 28 02            jr   z, .air_finished
2160+ 7E83
2161+ 7E83              .no_deplete:
2162+ 7E83 B7               or   a                     ; Carry Clear = Ok
2163+ 7E84 C9               ret
2164+ 7E85
2165+ 7E85              .air_finished:
2166+ 7E85 37               scf                        ; Carry Set = Morte per esaurimento aria
2167+ 7E86 C9               ret

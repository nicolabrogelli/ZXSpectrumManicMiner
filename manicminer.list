2245+ 6987 E6 0F            and  $0f
2246+ 6989 C6 30            add  a, '0'
2247+ 698B 77               ld   (hl), a
2248+ 698C 23               inc  hl
2249+ 698D
2250+ 698D                  ; Cifra 4 (decine)
2251+ 698D DD 7E 00         ld   a, (ix+0)
2252+ 6990 0F               rrca
2253+ 6991 0F               rrca
2254+ 6992 0F               rrca

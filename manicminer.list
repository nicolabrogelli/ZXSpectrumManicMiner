1071+ 6249 E5               push hl
1072+ 624A C5               push bc
1073+ 624B D5               push de
1074+ 624C
1075+ 624C                  ; 1. Calcola indirizzo bitmap nel font_buffer (font_buffer + A * 8)
1076+ 624C 6F               ld   l, a
1077+ 624D 26 00            ld   h, 0
1078+ 624F 29               add  hl, hl                ; *2
1079+ 6250 29               add  hl, hl                ; *4
1080+ 6251 29               add  hl, hl                ; *8
1081+ 6252 01 03 E5         ld   bc, font_buffer
1082+ 6255 09               add  hl, bc
1083+ 6256 E5               push hl
1084+ 6257 DD E1            pop  ix                    ; IX = font bitmap (8 byte)
1085+ 6259
1086+ 6259                  ; 2. Calcola indirizzo VRAM scanline 0 per (Row D, Col E)
1087+ 6259                  ; HighByte = $40 + (D & $18)
1088+ 6259 7A               ld   a, d
1089+ 625A E6 18            and  $18
1090+ 625C C6 40            add  a, $40
1091+ 625E 67               ld   h, a
1092+ 625F
1093+ 625F                  ; LowByte = ((D & 7) * 32) + E
1094+ 625F 7A               ld   a, d
1095+ 6260 E6 07            and  7
1096+ 6262 87               add  a, a                  ; *2
1097+ 6263 87               add  a, a                  ; *4
1098+ 6264 87               add  a, a                  ; *8
1099+ 6265 87               add  a, a                  ; *16
1100+ 6266 87               add  a, a                  ; *32
1101+ 6267 83               add  a, e                  ; + Col E
1102+ 6268 6F               ld   l, a                  ; HL = VRAM address scanline 0
1103+ 6269
1104+ 6269                  ; Copia le 8 scanline direttamente in VRAM
1105+ 6269 DD 7E 00         ld   a, (ix+0)
1105+ 626C 77             ld (hl), a
1105+ 626D 24             inc h
1106+ 626E DD 7E 01         ld   a, (ix+1)
1106+ 6271 77             ld (hl), a
1106+ 6272 24             inc h
1107+ 6273 DD 7E 02         ld   a, (ix+2)
1107+ 6276 77             ld (hl), a
1107+ 6277 24             inc h
1108+ 6278 DD 7E 03         ld   a, (ix+3)
1108+ 627B 77             ld (hl), a
1108+ 627C 24             inc h
1109+ 627D DD 7E 04         ld   a, (ix+4)
1109+ 6280 77             ld (hl), a
1109+ 6281 24             inc h
1110+ 6282 DD 7E 05         ld   a, (ix+5)
1110+ 6285 77             ld (hl), a
1110+ 6286 24             inc h
1111+ 6287 DD 7E 06         ld   a, (ix+6)
1111+ 628A 77             ld (hl), a
1111+ 628B 24             inc h
1112+ 628C DD 7E 07         ld   a, (ix+7)
1112+ 628F 77             ld (hl), a

 736  8705              ; Alias per retrocompatibilità
 737  8705              CheckVictoryCondition: EQU CheckPortalTransition
 738  8705
 739  8705              ; -------------------------------------------------------------------
 740  8705              ; TriggerPortalTransition
 741  8705              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 742  8705              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 743  8705              ; - Avanza all'indice della stanza successiva.
 744  8705              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 745  8705              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 746  8705              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 747  8705              ; -------------------------------------------------------------------
 748  8705              TriggerPortalTransition:
 749  8705                  ; 1. Determina l'ID della stanza corrente
 750  8705 CD 50 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 751  8708
 752  8708                  ; 2. Calcola l'indice della stanza successiva
 753  8708 3A 74 A1         ld   a, (current_room)
 754  870B 3C               inc  a
 755  870C FE 04            cp   NUM_ROOMS
 756  870E 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 757  8710
 758  8710                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 759  8710 21 36 73         ld   hl, RoomsListTable
 760  8713 5F               ld   e, a
 761  8714 16 00            ld   d, 0
 762  8716 19               add  hl, de
 763  8717 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 764  8718 5E               ld   e, (hl)
 765  8719 23               inc  hl
 766  871A 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 767  871B ED 53 CF A1      ld   (room_ptr), de
 768  871F
 769  871F                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 770  871F AF               xor  a
 771  8720 32 D5 A1         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 772  8723 32 5C 9E         ld   (velocity_y), a
 773  8726 32 64 A4         ld   (game_objective_completed), a
 774  8729 3E 01            ld   a, 1
 775  872B 32 5D 9E         ld   (on_ground), a
 776  872E
 777  872E                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 778  872E 21 8D 5C         ld   hl, ATTR_P
 779  8731 36 07            ld   (hl), $07
 780  8733 CD AF 0D         call CLS
 781  8736
 782  8736 C3 A4 83         jp   LoadRoomAndRestart
 783  8739
 784  8739              .all_rooms_completed:
 785  8739                  ; Tutte le stanze sono state completate con successo!
 786  8739                  IF ENABLE_VICTORY_SCREEN != 0
 787  8739 C3 2D 86         jp   TriggerVictory
 788  873C                  ELSE
 789  873C ~                ; Ricomincia dalla prima stanza (Stanza 00)
 790  873C ~                ld   de, (RoomsListTable)
 791  873C ~                ld   (room_ptr), de
 792  873C ~                xor  a
 793  873C ~                ld   (transition_active), a
 794  873C ~                ld   (velocity_y), a
 795  873C ~                ld   (game_objective_completed), a
 796  873C ~                ld   a, 1
 797  873C ~                ld   (on_ground), a
 798  873C ~                ld   hl, ATTR_P
 799  873C ~                ld   (hl), $07
 800  873C ~                call CLS
 801  873C ~                jp   LoadRoomAndRestart
 802  873C                  ENDIF

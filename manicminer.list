 722  872E              ; -------------------------------------------------------------------
 723  872E              ; TriggerPortalTransition
 724  872E              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  872E              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  872E              ; - Avanza all'indice della stanza successiva.
 727  872E              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  872E              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  872E              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  872E              ; -------------------------------------------------------------------
 731  872E              TriggerPortalTransition:
 732  872E                  ; 1. Determina l'ID della stanza corrente
 733  872E CD A0 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  8731
 735  8731                  ; 2. Calcola l'indice della stanza successiva
 736  8731 3A 8F AD         ld   a, (current_room)
 737  8734 3C               inc  a
 738  8735 FE 07            cp   NUM_ROOMS
 739  8737 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  8739
 741  8739                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  8739 21 0A 73         ld   hl, RoomsListTable
 743  873C 5F               ld   e, a
 744  873D 16 00            ld   d, 0
 745  873F 19               add  hl, de
 746  8740 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  8741 5E               ld   e, (hl)
 748  8742 23               inc  hl
 749  8743 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  8744 ED 53 EA AD      ld   (room_ptr), de
 751  8748
 752  8748                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  8748 AF               xor  a
 754  8749 32 F0 AD         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  874C 32 77 AA         ld   (velocity_y), a
 756  874F 32 7F B0         ld   (game_objective_completed), a
 757  8752 3E 01            ld   a, 1
 758  8754 32 78 AA         ld   (on_ground), a
 759  8757
 760  8757                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  8757 3E 07            ld   a, $07
 762  8759 CD 99 62         call Gfx_ClearScreenDirect
 763  875C
 764  875C C3 F1 83         jp   LoadRoomAndRestart
 765  875F
 766  875F              .all_rooms_completed:
 767  875F                  ; Tutte le stanze sono state completate con successo!
 768  875F                  IF ENABLE_VICTORY_SCREEN != 0
 769  875F C3 56 86         jp   TriggerVictory
 770  8762                  ELSE
 771  8762 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  8762 ~                ld   de, (RoomsListTable)
 773  8762 ~                ld   (room_ptr), de
 774  8762 ~                xor  a
 775  8762 ~                ld   (transition_active), a
 776  8762 ~                ld   (velocity_y), a
 777  8762 ~                ld   (game_objective_completed), a
 778  8762 ~                ld   a, 1
 779  8762 ~                ld   (on_ground), a
 780  8762 ~                ld   a, $07
 781  8762 ~                call Gfx_ClearScreenDirect
 782  8762 ~                jp   LoadRoomAndRestart
 783  8762                  ENDIF

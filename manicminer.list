 313+ 7D75              ;
 314+ 7D75              ; Ripristina il tile originale presente nella mappa della stanza.
 315+ 7D75              ; Chiamata quando un item viene raccolto.
 316+ 7D75              ;
 317+ 7D75              ; Input:
 318+ 7D75              ;   B = Row (0..15)
 319+ 7D75              ;   C = Col (0..31)
 320+ 7D75              ; -------------------------------------------------------------------
 321+ 7D75              RestoreBackgroundCell:

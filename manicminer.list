1037+ 8308              .check_lines_loop:
1038+ 8308                  ; ---------------------------------------------------------------
1039+ 8308                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
1040+ 8308                  ; ---------------------------------------------------------------
1041+ 8308 3A 53 F0         ld   a, (overlap_num_lines)
1042+ 830B 47               ld   b, a                      ; B = numero di scanlines da controllare
1043+ 830C
1044+ 830C              .scanline_loop:
1045+ 830C C5               push bc                        ; Salva contatore scanlines
1046+ 830D
1047+ 830D                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
1048+ 830D 3A 51 F0         ld   a, (row_enemy_cur)
1049+ 8310 87               add  a, a                      ; row * 2
1050+ 8311 5F               ld   e, a
1051+ 8312 16 00            ld   d, 0
1052+ 8314 2A 4D F0         ld   hl, (guard_sprite_ptr)
1053+ 8317 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
1054+ 8318 56               ld   d, (hl)                   ; D = Enemy Byte 0
1055+ 8319 23               inc  hl
1056+ 831A 5E               ld   e, (hl)                   ; E = Enemy Byte 1
1057+ 831B
1058+ 831B                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
1059+ 831B 3A 4F F0         ld   a, (collision_delta_x)
1060+ 831E CB 7F            bit  7, a
1061+ 8320 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
1062+ 8322
1063+ 8322                  ; DeltaX >= 0:
1064+ 8322 FE 09            cp   9
1065+ 8324 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
1066+ 8326
1067+ 8326                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
1068+ 8326 B7               or   a
1069+ 8327 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
1070+ 8329 4F               ld   c, a                      ; C = DeltaX (1..8)
1071+ 832A              .shift_left_16bit:
1072+ 832A CB 23            sla  e
1073+ 832C CB 12            rl   d
1074+ 832E 0D               dec  c
1075+ 832F 20 F9            jr   nz, .shift_left_16bit
1076+ 8331              .slice_ready_in_d:

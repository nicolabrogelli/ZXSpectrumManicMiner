  81  8141 2A 09 97         ld   hl, (room_ptr)
  82  8144 11 73 02         ld   de, OFFSET_BORDER_COLOR
  83  8147 19               add  hl, de
  84  8148 7E               ld   a, (hl)
  85  8149 E6 07            and  $07               ; Garantisci un valore valido 0..7
  86  814B 32 95 93         ld   (room_border_color), a
  87  814E D3 FE            out  ($fe), a          ; Imposta colore bordo hardware
  88  8150
  89  8150                  ; Aggiorna BORDCR per la ROM in modo sicuro (Paper = border, Ink = white)
  90  8150 07               rlca
  91  8151 07               rlca
  92  8152 07               rlca                   ; Sposta nei bit 3-5
  93  8153 F6 07            or   $07               ; Ink bianco nei bit 0-2
  94  8155 32 48 5C         ld   (BORDCR), a
  95  8158
  96  8158 3E FF            ld   a, $ff
  97  815A 32 8F 97         ld   (player_drawn_pos+1), a
  98  815D CD 33 60         call Gfx_PrintPlayer
  99  8160
 100  8160              Main_loop:
 101  8160              .sync_loop:
 102  8160 76               halt
 103  8161 2A AA 93         ld   hl, (counter)
 104  8164 ED 5B AD 93      ld   de, (last_frame_counter)
 105  8168 B7               or   a
 106  8169 ED 52            sbc  hl, de
 107  816B 7D               ld   a, l
 108  816C FE 02            cp   GAME_SPEED_DELAY
 109  816E 38 F0            jr   c, .sync_loop
 110  8170
 111  8170 2A AA 93         ld   hl, (counter)
 112  8173 22 AD 93         ld   (last_frame_counter), hl
 113  8176
 114  8176                  ; Aggiorna il timer di sicurezza (invulnerabilità post-morte)
 115  8176 3A 93 97         ld   a, (willy_safety_timer)
 116  8179 B7               or   a
 117  817A 28 04            jr   z, .no_safety_dec
 118  817C 3D               dec  a
 119  817D 32 93 97         ld   (willy_safety_timer), a
 120  8180              .no_safety_dec:
 121  8180
 122  8180                  ; 1. Rendering atomico nemici ed estrazione sovrapposizioni
 123  8180 CD 95 7B         call Enemy_RenderRoom
 124  8183
 125  8183                  ; 2. Rendering del giocatore (ridisegna Willy in primo piano se mosso o se coperto da un guardiano)
 126  8183 CD 95 60         call Gfx_UpdatePlayer
 127  8186
 128  8186                  ; 3. Aggiorna animazione e rimozione dei pavimenti sgretolabili (Crumbling Floor)
 129  8186 CD DF 79         call Phys_UpdateCrumblingFloors
 130  8189
 131  8189                  ; 4. Aggiorna animazione lampeggio del portale (se attivo)
 132  8189 CD 9B 69         call Gfx_AnimatePortal
 133  818C
 134  818C                  ; 5. Aggiornamento audio
 135  818C                  IF ENABLE_EFFECTS != 0
 136  818C ~                call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 137  818C                  ENDIF
 138  818C
 139  818C                  IF ENABLE_MUSIC != 0
 140  818C ~                call Audio_UpdateMusic        ; Aggiorna la musica
 141  818C                  ENDIF
 142  818C
 143  818C                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 144  818C                  IF ENABLE_ANIMATE_LIVES != 0
 145  818C ~                call Gfx_PrintWillyLives
 146  818C                  ENDIF
 147  818C
 148  818C
 149  818C                  ; 6. Salva le posizioni correnti del player per il prossimo frame
 150  818C ED 4B 89 93      ld   bc, (PlayerPos)
 151  8190 ED 43 8B 93      ld   (PlayerPosOld), bc
 152  8194
 153  8194                  ; 7. Aggiorna le posizioni dei personaggi per il prossimo frame
 154  8194 CD CD 6D         call Input_CheckCtrl
 155  8197 CD 6C 6C         call MovePlayer
 156  819A CD 00 71         call Phys_ApplyGravity
 157  819D CD 8A 74         call Phys_ApplyConveyor
 158  81A0 CD 87 7C         call Enemy_Update
 159  81A3 CD 82 7F         call Items_CheckCollision
 160  81A6
 161  81A6                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 162  81A6 CD E6 83         call CheckPortalTransition
 163  81A9 DA 40 84         jp   c, TriggerPortalTransition
 164  81AC
 165  81AC                  ; Controlla collisione con Nasties (morte di Willy)
 166  81AC                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 167  81AC CD 25 79         call Phys_CheckNastyCollision
 168  81AF 38 0B            jr   c, .willy_dies
 169  81B1                  ENDIF
 170  81B1
 171  81B1                  ; Controlla collisione con guardiani
 172  81B1 CD 5F 7D         call CheckCollision
 173  81B4 38 03            jr   c, .guardian_collision_found
 174  81B6
 175  81B6                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 176  81B6                  IF ENABLE_RAMP_DEBUG_BARS != 0
 177  81B6 ~                ld   a, (willy_on_ramp)
 178  81B6 ~                or   a
 179  81B6 ~                jp   nz, .draw_raster_bars
 180  81B6                  ENDIF
 181  81B6
 182  81B6 C3 1E 82         jp   .no_collision
 183  81B9
 184  81B9              .guardian_collision_found:
 185  81B9                  ; C'è collisione con un guardiano!
 186  81B9                  ; Controlla se la morte per collisione con i guardiani è abilitata
 187  81B9                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 188  81B9 C3 BC 81         jp   .willy_dies
 189  81BC                  ELSE
 190  81BC ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 191  81BC ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 192  81BC ~                    ELSE
 193  81BC ~                    jp   .no_collision
 194  81BC ~                    ENDIF
 195  81BC                  ENDIF
 196  81BC
 197  81BC              .willy_dies:
 198  81BC                  ; 1. Decrementa le vite
 199  81BC 21 96 93         ld   hl, willy_lives
 200  81BF 7E               ld   a, (hl)
 201  81C0 B7               or   a
 202  81C1 28 05            jr   z, .check_game_over
 203  81C3 35               dec  (hl)
 204  81C4 28 02            jr   z, .check_game_over
 205  81C6 18 03            jr   .normal_respawn
 206  81C8
 207  81C8              .check_game_over:
 208  81C8                  IF ENABLE_GAME_OVER_RESTART != 0
 209  81C8 C3 75 82         jp   TriggerGameOver
 210  81CB                  ELSE
 211  81CB ~                ld   a, 1
 212  81CB ~                ld   (willy_lives), a
 213  81CB ~                jr   .normal_respawn
 214  81CB                  ENDIF
 215  81CB
 216  81CB              .normal_respawn:
 217  81CB                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 218  81CB CD FB 7D         call Items_ResetCurrentRoomItems
 219  81CE
 220  81CE                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 221  81CE AF               xor  a
 222  81CF D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 223  81D1 21 8D 5C         ld   hl, ATTR_P
 224  81D4 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 225  81D5 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 226  81D8 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 227  81DA 3E 07            ld   a, $07
 228  81DC 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 229  81DF
 230  81DF                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 231  81DF 06 19            ld   b, 25
 232  81E1              .death_pause:
 233  81E1 76               halt
 234  81E2 10 FD            djnz .death_pause
 235  81E4
 236  81E4                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 237  81E4 AF               xor  a
 238  81E5 32 97 93         ld   (velocity_y), a
 239  81E8 32 99 93         ld   (jump_pressed), a
 240  81EB 32 9B 93         ld   (coyote_timer), a
 241  81EE 32 9E 93         ld   (jump_frame), a
 242  81F1 32 9D 93         ld   (jump_dir), a
 243  81F4 32 0F 97         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 244  81F7 3E 01            ld   a, 1
 245  81F9 32 98 93         ld   (on_ground), a
 246  81FC
 247  81FC 3E 00            ld   a, RESPAWN_SAFETY_TIME
 248  81FE 32 93 97         ld   (willy_safety_timer), a
 249  8201
 250  8201                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 251  8201 C3 00 81         jp   LoadRoomAndRestart

 562  861A CB 67            bit  4, a
 563  861C 28 F6            jr   z, .wait_keys_release
 564  861E
 565  861E                  ; Controlla tasto N (Porta $7F, bit 3)
 566  861E 01 FE 7F         ld   bc, $7ffe
 567  8621 ED 78            in   a, (c)

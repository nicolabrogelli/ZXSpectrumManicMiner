 327+ 8143 20 F9            jr   nz, .line_loop
 328+ 8145 C1               pop  bc
 329+ 8146
 330+ 8146                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 331+ 8146 26 00            ld   h, 0
 332+ 8148 68               ld   l, b
 333+ 8149 29               add  hl, hl
 334+ 814A 29               add  hl, hl
 335+ 814B 29               add  hl, hl
 336+ 814C 29               add  hl, hl
 337+ 814D 29               add  hl, hl                    ; Row * 32

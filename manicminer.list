 693+ 609D CB 3F            srl  a
 693+ 609F CB 3F          srl a
 693+ 60A1 CB 3F          srl a
 694+ 60A3 5F               ld   e, a                  ; E = ColStart (0..31)
 695+ 60A4
 696+ 60A4 79               ld   a, c

 684+ 8682 C6 01            add  a, $01
 685+ 8684 27               daa
 686+ 8685 32 26 E8         ld   (player_score + 1), a
 687+ 8688
 688+ 8688                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 8688 3A 27 E8         ld   a, (player_score + 2)
 690+ 868B CE 00            adc  a, 0
 691+ 868D 27               daa
 692+ 868E 32 27 E8         ld   (player_score + 2), a
 693+ 8691
 694+ 8691                  ; Controlla se player_score ha superato high_score
 695+ 8691 CD 9C 86         call Score_CheckAndUpdateHighScore

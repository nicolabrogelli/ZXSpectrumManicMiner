  13+ 7C43              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7C43              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C43              ; Offset 2: Current X
  16+ 7C43              ; Offset 3: Current Y
  17+ 7C43              ; Offset 4: Min Limit
  18+ 7C43              ; Offset 5: Max Limit
  19+ 7C43              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7C43              ; Offset 7: Anim State (0..3)
  21+ 7C43              ; Offset 8: Old X
  22+ 7C43              ; Offset 9: Old Y
  23+ 7C43              ; Offset 10: Color (Attributo Spectrum)
  24+ 7C43              ; -------------------------------------------------------------------

 309  831C CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 310  831E E6 07            and  7
 311  8320 5F               ld   e, a
 312  8321 16 00            ld   d, 0
 313  8323 21 9B 63         ld   hl, title_color_table
 314  8326 19               add  hl, de
 315  8327 7E               ld   a, (hl)               ; A = nuovo colore
 316  8328 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 317  832B 06 20            ld   b, 32

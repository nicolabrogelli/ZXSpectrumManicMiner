1053+ 7819              ; -------------------------------------------------------------------
1054+ 7819              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 7819              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 7819              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 7819              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 7819              ; -------------------------------------------------------------------
1059+ 7819              UnpackRoomLayout:
1060+ 7819 E5               push hl
1061+ 781A D5               push de
1062+ 781B C5               push bc
1063+ 781C DD E5            push ix
1064+ 781E
1065+ 781E DD 2A 2A E5      ld   ix, (room_ptr)
1066+ 7822 11 20 02         ld   de, OFFSET_TILES
1067+ 7825 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 7827
1069+ 7827 2A 2A E5         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 782A 11 CF E2         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 782D 01 00 02         ld   bc, 512               ; 512 celle
1072+ 7830
1073+ 7830              .byte_loop:
1074+ 7830 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 7831 23               inc  hl
1076+ 7832
1077+ 7832                  ; Confronta con le 8 definizioni di tile:
1078+ 7832 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7835 28 23            jr   z, .is_bg
1080+ 7837 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 783A 28 29            jr   z, .is_wall
1082+ 783C DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 783F 28 1C            jr   z, .is_floor
1084+ 7841 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7844 28 1B            jr   z, .is_crumbling
1086+ 7846 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 7849 28 1E            jr   z, .is_conveyor
1088+ 784B DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 784E 28 1D            jr   z, .is_nasty1
1090+ 7850 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 7853 28 1C            jr   z, .is_nasty2
1092+ 7855 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 7858 28 1B            jr   z, .is_extra
1094+ 785A
1095+ 785A              .is_bg:
1096+ 785A                  ; Default: Tile 0 (Background)
1097+ 785A AF               xor  a
1098+ 785B 18 1A            jr   .store_cell
1099+ 785D
1100+ 785D              .is_floor:
1101+ 785D 3E 01            ld   a, 1
1102+ 785F 18 16            jr   .store_cell
1103+ 7861              .is_crumbling:
1104+ 7861 3E 02            ld   a, 2
1105+ 7863 18 12            jr   .store_cell
1106+ 7865              .is_wall:
1107+ 7865 3E 03            ld   a, 3
1108+ 7867 18 0E            jr   .store_cell
1109+ 7869              .is_conveyor:
1110+ 7869 3E 04            ld   a, 4
1111+ 786B 18 0A            jr   .store_cell
1112+ 786D              .is_nasty1:
1113+ 786D 3E 05            ld   a, 5
1114+ 786F 18 06            jr   .store_cell
1115+ 7871              .is_nasty2:
1116+ 7871 3E 06            ld   a, 6
1117+ 7873 18 02            jr   .store_cell
1118+ 7875              .is_extra:
1119+ 7875 3E 07            ld   a, 7
1120+ 7877
1121+ 7877              .store_cell:
1122+ 7877 12               ld   (de), a
1123+ 7878 13               inc  de
1124+ 7879 0B               dec  bc
1125+ 787A 78               ld   a, b
1126+ 787B B1               or   c
1127+ 787C 20 B2            jr   nz, .byte_loop
1128+ 787E
1129+ 787E DD E1            pop  ix
1130+ 7880 C1               pop  bc
1131+ 7881 D1               pop  de
1132+ 7882 E1               pop  hl
1133+ 7883 C9               ret
1134+ 7884
1135+ 7884              ; -------------------------------------------------------------------
1136+ 7884              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7884              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7884              ; Output: A = tipo di cella (0..3)
1139+ 7884              ; Preserva tutti gli altri registri.
1140+ 7884              ; -------------------------------------------------------------------
1141+ 7884              GetCellFromUnpacked:
1142+ 7884 E5               push hl
1143+ 7885 D5               push de
1144+ 7886
1145+ 7886 6F               ld   l, a
1146+ 7887 26 00            ld   h, 0
1147+ 7889 29               add  hl, hl
1148+ 788A 29               add  hl, hl
1149+ 788B 29               add  hl, hl
1150+ 788C 29               add  hl, hl
1151+ 788D 29               add  hl, hl            ; HL = Row * 32
1152+ 788E 59               ld   e, c
1153+ 788F 16 00            ld   d, 0
1154+ 7891 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 7892 11 CF E2         ld   de, unpacked_layout
1156+ 7895 19               add  hl, de
1157+ 7896 7E               ld   a, (hl)           ; A = cell type
1158+ 7897
1159+ 7897 D1               pop  de
1160+ 7898 E1               pop  hl
1161+ 7899 C9               ret

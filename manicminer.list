 672+ 8738              ; Score_AddItemPoints
 673+ 8738              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 674+ 8738              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 675+ 8738              ; -------------------------------------------------------------------
 676+ 8738              Score_AddItemPoints:
 677+ 8738 F5               push af
 678+ 8739 C5               push bc
 679+ 873A D5               push de
 680+ 873B E5               push hl
 681+ 873C
 682+ 873C                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 683+ 873C 3A 5B F0         ld   a, (player_score + 1)
 684+ 873F C6 01            add  a, $01
 685+ 8741 27               daa
 686+ 8742 32 5B F0         ld   (player_score + 1), a
 687+ 8745
 688+ 8745                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 8745 3A 5C F0         ld   a, (player_score + 2)
 690+ 8748 CE 00            adc  a, 0
 691+ 874A 27               daa
 692+ 874B 32 5C F0         ld   (player_score + 2), a
 693+ 874E
 694+ 874E                  ; Controlla se player_score ha superato high_score
 695+ 874E CD 59 87         call Score_CheckAndUpdateHighScore
 696+ 8751
 697+ 8751                  ; Aggiorna visualizzazione a schermo
 698+ 8751 CD B8 68         call Gfx_UpdateScoreDisplay
 699+ 8754
 700+ 8754 E1               pop  hl
 701+ 8755 D1               pop  de
 702+ 8756 C1               pop  bc
 703+ 8757 F1               pop  af

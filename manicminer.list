1323+ 7ACE              ; -------------------------------------------------------------------
1324+ 7ACE              ; Legge il tipo di cella dal buffer decompresso in RAM
1325+ 7ACE              ; Input: A = Row (0..15), C = Col (0..31)
1326+ 7ACE              ; Output: A = tipo di cella (0..3)
1327+ 7ACE              ; Preserva tutti gli altri registri.
1328+ 7ACE              ; -------------------------------------------------------------------
1329+ 7ACE              GetCellFromUnpacked:
1330+ 7ACE E5               push hl
1331+ 7ACF D5               push de
1332+ 7AD0
1333+ 7AD0 6F               ld   l, a
1334+ 7AD1 26 00            ld   h, 0
1335+ 7AD3 29               add  hl, hl
1336+ 7AD4 29               add  hl, hl
1337+ 7AD5 29               add  hl, hl
1338+ 7AD6 29               add  hl, hl
1339+ 7AD7 29               add  hl, hl            ; HL = Row * 32
1340+ 7AD8 59               ld   e, c
1341+ 7AD9 16 00            ld   d, 0
1342+ 7ADB 19               add  hl, de            ; HL = Row * 32 + Col
1343+ 7ADC 11 F0 EC         ld   de, unpacked_layout
1344+ 7ADF 19               add  hl, de
1345+ 7AE0 7E               ld   a, (hl)           ; A = cell type
1346+ 7AE1
1347+ 7AE1 D1               pop  de
1348+ 7AE2 E1               pop  hl

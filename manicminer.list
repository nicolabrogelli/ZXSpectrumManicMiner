 192+ 7DA7 DD 77 03         ld   (ix+3), a                 ; Current Y
 193+ 7DAA
 194+ 7DAA 23               inc  hl
 195+ 7DAB 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 196+ 7DAC E6 1F            and  31

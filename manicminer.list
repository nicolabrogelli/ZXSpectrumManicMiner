 443+ 83AB 28 04            jr   z, .x_ok
 444+ 83AD 38 02            jr   c, .x_ok
 445+ 83AF 18 31            jr   .no_collision
 446+ 83B1
 447+ 83B1              .x_ok:
 448+ 83B1                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 83B1 BB               cp   e                         ; E = ItemLeft
 450+ 83B2 28 0B            jr   z, .y_check
 451+ 83B4 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 83B6
 453+ 83B6                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 83B6 C6 0F            add  a, 15
 455+ 83B8 BB               cp   e
 456+ 83B9 28 04            jr   z, .y_check
 457+ 83BB 30 02            jr   nc, .y_check
 458+ 83BD 18 23            jr   .no_collision
 459+ 83BF
 460+ 83BF              .y_check:
 461+ 83BF                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 83BF 7C               ld   a, h                      ; H = Item Row
 463+ 83C0 87               add  a, a                      ; *2
 464+ 83C1 87               add  a, a                      ; *4
 465+ 83C2 87               add  a, a                      ; *8

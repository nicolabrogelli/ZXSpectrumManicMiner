 424+ 7CC9 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 425+ 7CCB DD BE 04         cp   (ix+4)                    ; Min Limit
 426+ 7CCE 28 08            jr   z, .h_rev_right
 427+ 7CD0 38 06            jr   c, .h_rev_right
 428+ 7CD2 DD 77 02         ld   (ix+2), a
 429+ 7CD5 C3 4A 7D         jp   .next

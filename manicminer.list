 267  84C9                  ; Collisione attiva: disegna le raster bar nel bordo
 268  84C9 3A 6F 9E         ld   a, (counter)
 269  84CC E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 270  84CE 06 1E            ld   b, 30             ; Numero di righe della barra raster
 271  84D0              .raster_loop:
 272  84D0 D3 FE            out  ($fe), a
 273  84D2 3C               inc  a
 274  84D3 E6 07            and  7
 275  84D5 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 276  84D7              .delay:
 277  84D7 0D               dec  c
 278  84D8 20 FD            jr   nz, .delay
 279  84DA 10 F4            djnz .raster_loop
 280  84DC
 281  84DC                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 282  84DC 3A 5A 9E         ld   a, (room_border_color)
 283  84DF D3 FE            out  ($fe), a
 284  84E1 18 05            jr   .no_collision_change
 285  84E3
 286  84E3              .no_collision:
 287  84E3                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 288  84E3 3A 5A 9E         ld   a, (room_border_color)
 289  84E6 D3 FE            out  ($fe), a
 290  84E8
 291  84E8              .no_collision_change:
 292  84E8 C3 07 84         jp   Main_loop
 293  84EB
 294  84EB              ; -------------------------------------------------------------------
 295  84EB              ; ShowTitleScreen
 296  84EB              ; Visualizza la schermata iniziale del gioco (Title Screen).
 297  84EB              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 298  84EB              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 299  84EB              ; -------------------------------------------------------------------
 300  84EB              ShowTitleScreen:
 301  84EB                  ; 1. Disegna la schermata iniziale
 302  84EB CD FD 63         call Gfx_DrawTitleScreen
 303  84EE
 304  84EE                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 305  84EE              .wait_title_enter_release:
 306  84EE 76               halt
 307  84EF 3E BF            ld   a, $bf
 308  84F1 DB FE            in   a, ($fe)
 309  84F3 1F               rra
 310  84F4 30 F8            jr   nc, .wait_title_enter_release
 311  84F6
 312  84F6                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 313  84F6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 314  84F8              .title_loop:
 315  84F8 76               halt
 316  84F9
 317  84F9                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 318  84F9 0C               inc  c
 319  84FA 79               ld   a, c
 320  84FB CB 3F            srl  a
 321  84FD CB 3F            srl  a
 322  84FF CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 323  8501 E6 07            and  7
 324  8503 5F               ld   e, a
 325  8504 16 00            ld   d, 0
 326  8506 21 F5 63         ld   hl, title_color_table
 327  8509 19               add  hl, de
 328  850A 7E               ld   a, (hl)               ; A = nuovo colore
 329  850B 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 330  850E 06 20            ld   b, 32
 331  8510              .color_title_loop:
 332  8510 77               ld   (hl), a
 333  8511 23               inc  hl
 334  8512 10 FC            djnz .color_title_loop
 335  8514
 336  8514                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 337  8514 3E BF            ld   a, $bf
 338  8516 DB FE            in   a, ($fe)
 339  8518 1F               rra
 340  8519 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 341  851B
 342  851B                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 343  851B              .wait_title_enter_release_after:
 344  851B 76               halt
 345  851C 3E BF            ld   a, $bf
 346  851E DB FE            in   a, ($fe)
 347  8520 1F               rra
 348  8521 30 F8            jr   nc, .wait_title_enter_release_after
 349  8523
 350  8523                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 351  8523 AF               xor  a
 352  8524 D3 FE            out  ($fe), a              ; Bordo a nero
 353  8526 21 8D 5C         ld   hl, ATTR_P
 354  8529 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 355  852A CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 356  852D 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 357  852F 3E 07            ld   a, $07
 358  8531 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 359  8534
 360  8534                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 361  8534 CD A9 87         call ResetFullGameState
 362  8537
 363  8537                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 364  8537 C3 A4 83         jp   LoadRoomAndRestart
 365  853A
 366  853A              ; -------------------------------------------------------------------
 367  853A              ; TriggerGameOver
 368  853A              ; Scatena la schermata di Game Over per la stanza corrente.
 369  853A              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 370  853A              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 371  853A              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 372  853A              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 373  853A              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 374  853A              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 375  853A              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 376  853A              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 377  853A              ; -------------------------------------------------------------------
 378  853A              TriggerGameOver:
 379  853A                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 380  853A CD DE 65         call Gfx_DrawGameOverScreen
 381  853D
 382  853D                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 383  853D              .wait_keys_release:
 384  853D 76               halt
 385  853E                  ; Controlla tasto Y (Porta $DF, bit 4)
 386  853E 01 FE DF         ld   bc, $dffe
 387  8541 ED 78            in   a, (c)
 388  8543 CB 67            bit  4, a
 389  8545 28 F6            jr   z, .wait_keys_release
 390  8547
 391  8547                  ; Controlla tasto N (Porta $7F, bit 3)
 392  8547 01 FE 7F         ld   bc, $7ffe
 393  854A ED 78            in   a, (c)
 394  854C CB 5F            bit  3, a
 395  854E 28 ED            jr   z, .wait_keys_release
 396  8550
 397  8550                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 398  8550 01 FE BF         ld   bc, $bffe
 399  8553 ED 78            in   a, (c)
 400  8555 CB 47            bit  0, a
 401  8557 28 E4            jr   z, .wait_keys_release
 402  8559
 403  8559                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 404  8559 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 405  855B              .wait_choice_loop:
 406  855B 76               halt
 407  855C
 408  855C                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 409  855C 0C               inc  c
 410  855D 79               ld   a, c
 411  855E CB 3F            srl  a
 412  8560 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 413  8562 E6 07            and  7
 414  8564 5F               ld   e, a
 415  8565 16 00            ld   d, 0
 416  8567 21 9A 65         ld   hl, game_over_color_table
 417  856A 19               add  hl, de
 418  856B 7E               ld   a, (hl)               ; A = nuovo colore attributo
 419  856C 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 420  856F 06 09            ld   b, 9

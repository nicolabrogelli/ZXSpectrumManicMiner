  59+ 7CF5              ; ResetItemsTable
  60+ 7CF5              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7CF5              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7CF5              ; -------------------------------------------------------------------
  63+ 7CF5              ResetItemsTable:
  64+ 7CF5 E5               push hl
  65+ 7CF6 D5               push de
  66+ 7CF7 C5               push bc
  67+ 7CF8
  68+ 7CF8 21 DF 6F         ld   hl, RoomsListTable
  69+ 7CFB 06 01            ld   b, NUM_ROOMS

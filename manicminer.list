 142+ 84CE              ; Items_DrawRoom
 143+ 84CE              ;
 144+ 84CE              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 84CE              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 84CE              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 84CE              ;
 148+ 84CE              ; Record item nella stanza (5 byte):
 149+ 84CE              ;   +0 Color / Attributo
 150+ 84CE              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 84CE              ;   +2 Attr Address High
 152+ 84CE              ;   +3 Anim Mask (96)
 153+ 84CE              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 84CE              ; Fine lista: $FF
 155+ 84CE              ; -------------------------------------------------------------------
 156+ 84CE              Items_DrawRoom:
 157+ 84CE E5               push hl
 158+ 84CF D5               push de
 159+ 84D0 C5               push bc
 160+ 84D1 DD E5            push ix
 161+ 84D3 FD E5            push iy
 162+ 84D5
 163+ 84D5                  ; 1. Azzera items_grid (512 byte)
 164+ 84D5 21 B3 E7         ld   hl, items_grid
 165+ 84D8 11 B4 E7         ld   de, items_grid + 1
 166+ 84DB 36 00            ld   (hl), 0
 167+ 84DD 01 FF 01         ld   bc, 511
 168+ 84E0 ED B0            ldir
 169+ 84E2
 170+ 84E2                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 84E2 AF               xor  a
 172+ 84E3 32 33 ED         ld   (num_room_items), a
 173+ 84E6
 174+ 84E6 FD 21 E3 EC      ld   iy, current_room_items
 175+ 84EA
 176+ 84EA                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 84EA 2A 34 ED         ld   hl, (room_ptr)
 178+ 84ED 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 84F0 19               add  hl, de
 180+ 84F1 E5               push hl
 181+ 84F2 DD E1            pop  ix                        ; IX = bitmap item
 182+ 84F4
 183+ 84F4                  ; 4. HL = Inizio lista item nella stanza
 184+ 84F4 2A 34 ED         ld   hl, (room_ptr)
 185+ 84F7 11 75 02         ld   de, OFFSET_ITEMS
 186+ 84FA 19               add  hl, de
 187+ 84FB
 188+ 84FB              .loop:
 189+ 84FB 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 84FC FE FF            cp   $FF
 191+ 84FE 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 8500 B7               or   a
 193+ 8501 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 8503
 195+ 8503 5F               ld   e, a                      ; E = Color
 196+ 8504 23               inc  hl
 197+ 8505 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8506 23               inc  hl
 199+ 8507 46               ld   b, (hl)                   ; B = AttrAddr High
 200+ 8508 23               inc  hl                        ; Salta Anim Byte
 201+ 8509 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 202+ 850A
 203+ 850A 7E               ld   a, (hl)                   ; A = Collected flag
 204+ 850B FE FF            cp   $FF

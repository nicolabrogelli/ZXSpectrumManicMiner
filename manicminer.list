 608+ 6040 3A 7B 93         ld   a, (willy_safety_timer)
 609+ 6043 B7               or   a
 610+ 6044 20 2A            jr   nz, .player_moved
 611+ 6046
 612+ 6046                  ; 1. Controlla se la posizione o l'animazione sono cambiate
 613+ 6046 ED 4B 71 8F      ld   bc, (PlayerPos)            ; C = PlayerX, B = PlayerY

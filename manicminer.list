 316+ 7E9C              ; Enemy_DrawSingleSlot
 317+ 7E9C              ;
 318+ 7E9C              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7E9C              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7E9C              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7E9C              ; -------------------------------------------------------------------
 322+ 7E9C              Enemy_DrawSingleSlot:
 323+ 7E9C C5               push bc
 324+ 7E9D D5               push de
 325+ 7E9E E5               push hl
 326+ 7E9F DD E5            push ix
 327+ 7EA1
 328+ 7EA1                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EA1                  ; Nei dati di Manic Miner:
 330+ 7EA1                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EA1                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EA1 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EA4 E6 03            and  3
 334+ 7EA6 47               ld   b, a                      ; B = Anim subframe
 335+ 7EA7
 336+ 7EA7 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EAA FE 01            cp   1                         ; Sinistra?
 338+ 7EAC 28 03            jr   z, .left_frames
 339+ 7EAE
 340+ 7EAE                  ; Movimento a Destra: Frame 0..3
 341+ 7EAE 78               ld   a, b
 342+ 7EAF 18 03            jr   .got_frame_idx
 343+ 7EB1
 344+ 7EB1              .left_frames:
 345+ 7EB1                  ; Movimento a Sinistra: Frame 4..7
 346+ 7EB1 3E 04            ld   a, 4
 347+ 7EB3 80               add  a, b
 348+ 7EB4
 349+ 7EB4              .got_frame_idx:
 350+ 7EB4                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7EB4 6F               ld   l, a
 352+ 7EB5 26 00            ld   h, 0

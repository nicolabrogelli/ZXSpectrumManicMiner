 617  863C 01 FE 7F         ld   bc, $7ffe
 618  863F ED 78            in   a, (c)
 619  8641 CB 5F            bit  3, a
 620  8643 28 F6            jr   z, .wait_quit_release
 621  8645 01 FE BF         ld   bc, $bffe
 622  8648 ED 78            in   a, (c)
 623  864A CB 47            bit  0, a
 624  864C 28 ED            jr   z, .wait_quit_release

 318+ 8507 87               add  a, a                      ; *4
 319+ 8508 87               add  a, a                      ; *8
 320+ 8509 87               add  a, a                      ; *16
 321+ 850A 87               add  a, a                      ; *32
 322+ 850B 81               add  a, c                      ; + Col
 323+ 850C 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 850D
 325+ 850D C5               push bc
 326+ 850E 06 08            ld   b, 8                      ; 8 scanline

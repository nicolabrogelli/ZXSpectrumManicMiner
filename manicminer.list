 427  861D 01 FE BF         ld   bc, $bffe
 428  8620 ED 78            in   a, (c)
 429  8622 CB 47            bit  0, a
 430  8624 28 02            jr   z, .quit_chosen
 431  8626
 432  8626 18 C9            jr   .wait_choice_loop

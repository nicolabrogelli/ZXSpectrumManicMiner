 601+ 7FD7              ; -------------------------------------------------------------------
 602+ 7FD7              ; CheckCollision
 603+ 7FD7              ;
 604+ 7FD7              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 605+ 7FD7              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 606+ 7FD7              ; Output:
 607+ 7FD7              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 608+ 7FD7              ;   Carry Clear = Nessuna collisione
 609+ 7FD7              ; -------------------------------------------------------------------
 610+ 7FD7              CheckCollision:
 611+ 7FD7 DD E5            push ix
 612+ 7FD9 C5               push bc
 613+ 7FDA D5               push de
 614+ 7FDB E5               push hl
 615+ 7FDC
 616+ 7FDC                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 617+ 7FDC 3A 1E E3         ld   a, (willy_safety_timer)
 618+ 7FDF B7               or   a
 619+ 7FE0 C2 30 81         jp   nz, .no_collision_found
 620+ 7FE3
 621+ 7FE3                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 622+ 7FE3 3A 19 DF         ld   a, (direction)
 623+ 7FE6 FE 01            cp   1                         ; Sinistra?
 624+ 7FE8 20 1A            jr   nz, .willy_right
 625+ 7FEA
 626+ 7FEA                  ; Willy a Sinistra:
 627+ 7FEA 21 F2 D8         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 628+ 7FED 22 34 E5         ld   (willy_head_ptr), hl
 629+ 7FF0 3A 18 DF         ld   a, (body_state)           ; 0, 1, 2
 630+ 7FF3 C6 05            add  a, 5                      ; tile 5, 6, 7
 631+ 7FF5 87               add  a, a
 631+ 7FF6 87             add a, a
 631+ 7FF7 87             add a, a ; * 8
 632+ 7FF8 5F               ld   e, a
 633+ 7FF9 16 00            ld   d, 0
 634+ 7FFB 21 D2 D8         ld   hl, Willy
 635+ 7FFE 19               add  hl, de
 636+ 7FFF 22 36 E5         ld   (willy_body_ptr), hl      ; Corpo sinistro
 637+ 8002 18 18            jr   .willy_ptrs_ready
 638+ 8004
 639+ 8004              .willy_right:
 640+ 8004                  ; Willy a Destra:
 641+ 8004 21 D2 D8         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 642+ 8007 22 34 E5         ld   (willy_head_ptr), hl
 643+ 800A 3A 18 DF         ld   a, (body_state)           ; 0, 1, 2
 644+ 800D C6 01            add  a, 1                      ; tile 1, 2, 3
 645+ 800F 87               add  a, a
 645+ 8010 87             add a, a
 645+ 8011 87             add a, a ; * 8
 646+ 8012 5F               ld   e, a

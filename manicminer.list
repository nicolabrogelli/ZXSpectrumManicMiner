2239+ 6993              ; Gfx_AnimatePortal
2240+ 6993              ; Esegue l'animazione di lampeggio continuo e fluido del portale quando
2241+ 6993              ; tutti gli item del livello sono stati raccolti (game_objective_completed != 0).
2242+ 6993              ; Riproduce l'effetto e il timing visivo dell'originale Manic Miner per ZX Spectrum.
2243+ 6993              ; -------------------------------------------------------------------
2244+ 6993              Gfx_AnimatePortal:
2245+ 6993                  ; 1. Verifica se il portale è attivo
2246+ 6993 3A 7A 94         ld   a, (game_objective_completed)

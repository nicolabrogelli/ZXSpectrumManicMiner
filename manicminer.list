1800+ 7B79              ; Phys_CheckCrumblingTrigger
1801+ 7B79              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1802+ 7B79              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1803+ 7B79              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1804+ 7B79              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1805+ 7B79              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1806+ 7B79              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1807+ 7B79              ; -------------------------------------------------------------------
1808+ 7B79              Phys_CheckCrumblingTrigger:
1809+ 7B79 C5               push bc
1810+ 7B7A D5               push de
1811+ 7B7B E5               push hl
1812+ 7B7C
1813+ 7B7C ED 4B 07 E2      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1814+ 7B80
1815+ 7B80                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1816+ 7B80 78               ld   a, b
1817+ 7B81 C6 10            add  a, 16
1818+ 7B83 FE 80            cp   128
1819+ 7B85 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1820+ 7B87
1821+ 7B87 CB 3F            srl  a
1821+ 7B89 CB 3F          srl  a
1821+ 7B8B CB 3F          srl  a   ; A = Row (0..15)
1822+ 7B8D 47               ld   b, a                  ; B = Row
1823+ 7B8E
1824+ 7B8E                  ; Piede sinistro: Col1 = PlayerX / 8
1825+ 7B8E 79               ld   a, c
1826+ 7B8F CB 3F            srl  a
1826+ 7B91 CB 3F          srl  a
1826+ 7B93 CB 3F          srl  a   ; A = Col1 (0..31)
1827+ 7B95 4F               ld   c, a                  ; C = Col1
1828+ 7B96
1829+ 7B96                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1830+ 7B96 78               ld   a, b
1831+ 7B97 CD AB 78         call GetCellFromUnpacked
1832+ 7B9A FE 02            cp   2
1833+ 7B9C 20 03            jr   nz, .check_col2
1834+ 7B9E
1835+ 7B9E                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1836+ 7B9E CD D4 7B         call .advance_crumble_cell
1837+ 7BA1
1838+ 7BA1              .check_col2:
1839+ 7BA1                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1840+ 7BA1 ED 4B 07 E2      ld   bc, (PlayerPos)
1841+ 7BA5 78               ld   a, b
1842+ 7BA6 C6 10            add  a, 16
1843+ 7BA8 CB 3F            srl  a
1843+ 7BAA CB 3F          srl  a
1843+ 7BAC CB 3F          srl  a
1844+ 7BAE 47               ld   b, a                  ; B = Row
1845+ 7BAF
1846+ 7BAF 79               ld   a, c
1847+ 7BB0 C6 07            add  a, 7
1848+ 7BB2 CB 3F            srl  a
1848+ 7BB4 CB 3F          srl  a
1848+ 7BB6 CB 3F          srl  a   ; A = Col2 (0..31)
1849+ 7BB8 4F               ld   c, a                  ; C = Col2
1850+ 7BB9
1851+ 7BB9                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1852+ 7BB9 3A 07 E2         ld   a, (PlayerPos)        ; A = PlayerX
1853+ 7BBC CB 3F            srl  a
1853+ 7BBE CB 3F          srl  a
1853+ 7BC0 CB 3F          srl  a   ; A = Col1
1854+ 7BC2 B9               cp   c
1855+ 7BC3 28 0B            jr   z, .done_trigger
1856+ 7BC5
1857+ 7BC5 78               ld   a, b
1858+ 7BC6 CD AB 78         call GetCellFromUnpacked
1859+ 7BC9 FE 02            cp   2
1860+ 7BCB 20 03            jr   nz, .done_trigger
1861+ 7BCD
1862+ 7BCD                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1863+ 7BCD CD D4 7B         call .advance_crumble_cell
1864+ 7BD0
1865+ 7BD0              .done_trigger:
1866+ 7BD0 E1               pop  hl
1867+ 7BD1 D1               pop  de
1868+ 7BD2 C1               pop  bc
1869+ 7BD3 C9               ret
1870+ 7BD4
1871+ 7BD4              .advance_crumble_cell:
1872+ 7BD4                  ; Input: B = Row, C = Col
1873+ 7BD4 C5               push bc
1874+ 7BD5 D5               push de
1875+ 7BD6 E5               push hl
1876+ 7BD7
1877+ 7BD7                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1878+ 7BD7 68               ld   l, b
1879+ 7BD8 26 00            ld   h, 0
1880+ 7BDA 29               add  hl, hl
1880+ 7BDB 29             add hl, hl
1880+ 7BDC 29             add hl, hl
1880+ 7BDD 29             add hl, hl
1880+ 7BDE 29             add hl, hl
1881+ 7BDF 59               ld   e, c
1882+ 7BE0 16 00            ld   d, 0
1883+ 7BE2 19               add  hl, de
1884+ 7BE3 11 18 E6         ld   de, crumbling_grid
1885+ 7BE6 19               add  hl, de
1886+ 7BE7
1887+ 7BE7                  ; 2. Avanza di 1 stadio
1888+ 7BE7 7E               ld   a, (hl)               ; A = Stage (0..8)
1889+ 7BE8 FE 08            cp   8
1890+ 7BEA 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
1891+ 7BEC
1892+ 7BEC 3C               inc  a                     ; Avanza di 1 scanline (1..8)
1893+ 7BED 77               ld   (hl), a
1894+ 7BEE 5F               ld   e, a                  ; E = nuovo Stage (1..8)
1895+ 7BEF
1896+ 7BEF                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
1897+ 7BEF E5               push hl
1898+ 7BF0 CD 24 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
1899+ 7BF3 E1               pop  hl
1900+ 7BF4
1901+ 7BF4                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
1902+ 7BF4 7E               ld   a, (hl)
1903+ 7BF5 FE 08            cp   8
1904+ 7BF7 38 12            jr   c, .done_advance
1905+ 7BF9
1906+ 7BF9                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
1907+ 7BF9 68               ld   l, b                  ; L = Row
1908+ 7BFA 26 00            ld   h, 0
1909+ 7BFC 29               add  hl, hl
1909+ 7BFD 29             add hl, hl
1909+ 7BFE 29             add hl, hl
1909+ 7BFF 29             add hl, hl
1909+ 7C00 29             add hl, hl
1910+ 7C01 59               ld   e, c
1911+ 7C02 16 00            ld   d, 0
1912+ 7C04 19               add  hl, de
1913+ 7C05 11 2D E3         ld   de, unpacked_layout
1914+ 7C08 19               add  hl, de
1915+ 7C09 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
1916+ 7C0B
1917+ 7C0B              .done_advance:
1918+ 7C0B E1               pop  hl
1919+ 7C0C D1               pop  de
1920+ 7C0D C1               pop  bc
1921+ 7C0E C9               ret

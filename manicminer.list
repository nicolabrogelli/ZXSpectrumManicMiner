 410  864E 77               ld   (hl), a
 411  864F 23               inc  hl
 412  8650 10 FC            djnz .color_cycle_loop
 413  8652
 414  8652                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  8652 01 FE DF         ld   bc, $dffe
 416  8655 ED 78            in   a, (c)
 417  8657 CB 67            bit  4, a
 418  8659 28 2A            jr   z, .continue_chosen
 419  865B
 420  865B                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  865B 01 FE 7F         ld   bc, $7ffe
 422  865E ED 78            in   a, (c)
 423  8660 CB 5F            bit  3, a
 424  8662 28 0B            jr   z, .quit_chosen
 425  8664
 426  8664                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  8664 01 FE BF         ld   bc, $bffe
 428  8667 ED 78            in   a, (c)
 429  8669 CB 47            bit  0, a
 430  866B 28 02            jr   z, .quit_chosen
 431  866D
 432  866D 18 C9            jr   .wait_choice_loop

 847+ 626C              ; Gfx_DrawTitleScreen
 848+ 626C              ; Disegna la schermata iniziale (Title Screen):
 849+ 626C              ; - Bordo nero e pulizia schermo.
 850+ 626C              ; - Titolo "JET SET WILLY" e sottotitolo.
 851+ 626C              ; - Separatori grafici.
 852+ 626C              ; - Sprite decorativi (Willy a sinistra, Maria a destra).
 853+ 626C              ; - Obiettivo di gioco.
 854+ 626C              ; - Messaggio "PRESS ENTER TO START".
 855+ 626C              ; - Riepilogo controlli (O, P, Z, ENTER).
 856+ 626C              ; - Copyright.
 857+ 626C              ; (Tutte le righe sono comprese tra 0 e 20 per evitare errori "Out of screen" della ROM)
 858+ 626C              ; -------------------------------------------------------------------
 859+ 626C              Gfx_DrawTitleScreen:
 860+ 626C F5               push af
 861+ 626D C5               push bc
 862+ 626E D5               push de
 863+ 626F E5               push hl
 864+ 6270 DD E5            push ix
 865+ 6272
 866+ 6272                  ; 1. Bordo hardware e schermo a nero
 867+ 6272 AF               xor  a
 868+ 6273 D3 FE            out  ($fe), a              ; Bordo a nero
 869+ 6275 21 8D 5C         ld   hl, ATTR_P
 870+ 6278 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 871+ 6279 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 872+ 627C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 873+ 627E 3E 07            ld   a, $07
 874+ 6280 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 875+ 6283
 876+ 6283                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
 877+ 6283 3E 16            ld   a, 22
 878+ 6285 D7               rst  $10
 879+ 6286 3E 01            ld   a, 1
 880+ 6288 D7               rst  $10
 881+ 6289 3E 00            ld   a, 0
 882+ 628B D7               rst  $10
 883+ 628C 21 44 61         ld   hl, title_banner_1
 884+ 628F 06 20            ld   b, 32
 885+ 6291 CD E8 60         call Gfx_PrintString
 886+ 6294
 887+ 6294                  ; Imposta attributi riga 1 a Giallo Brillante ($5820)
 888+ 6294 21 20 58         ld   hl, $5820
 889+ 6297 06 20            ld   b, 32
 890+ 6299 3E 46            ld   a, YELLOW | $40

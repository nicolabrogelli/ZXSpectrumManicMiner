 316  888E 16 00            ld   d, 0
 317  8890 21 72 64         ld   hl, title_color_table
 318  8893 19               add  hl, de
 319  8894 7E               ld   a, (hl)               ; A = nuovo colore
 320  8895 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  8898 06 20            ld   b, 32

 822  8767              ; CheckWillyConveyorCollision
 823  8767              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 824  8767              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 825  8767              ; -------------------------------------------------------------------
 826  8767              CheckWillyConveyorCollision:
 827  8767 C5               push bc
 828  8768 D5               push de
 829  8769 E5               push hl
 830  876A
 831  876A                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 832  876A CD C8 77         call CheckWillyOnConveyor
 833  876D 38 49            jr   c, .collision_detected
 834  876F
 835  876F                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 836  876F 3A 8F 99         ld   a, (conveyor_len)
 837  8772 B7               or   a
 838  8773 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 839  8775
 840  8775                  ; B = WillyY, C = WillyX
 841  8775 ED 4B 67 96      ld   bc, (PlayerPos)
 842  8779
 843  8779                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 844  8779 3A 90 99         ld   a, (conveyor_row)
 845  877C 87               add  a, a                  ; *2
 846  877D 87               add  a, a                  ; *4
 847  877E 87               add  a, a                  ; *8
 848  877F 5F               ld   e, a                  ; E = ConveyorTop
 849  8780 C6 07            add  a, 7
 850  8782 57               ld   d, a                  ; D = ConveyorBottom
 851  8783
 852  8783                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 853  8783 78               ld   a, b                  ; WillyTop
 854  8784 BA               cp   d
 855  8785 28 04            jr   z, .y_overlap
 856  8787 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 857  8789 18 32            jr   .no_conv_collision
 858  878B
 859  878B              .y_overlap:
 860  878B C6 0F            add  a, 15                 ; WillyBottom
 861  878D BB               cp   e
 862  878E 28 04            jr   z, .x_check
 863  8790 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 864  8792 18 29            jr   .no_conv_collision

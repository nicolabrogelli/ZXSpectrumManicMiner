 873+ 77FF              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 874+ 77FF              ; o sulla piattaforma adiacente in cima.
 875+ 77FF              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 876+ 77FF              ; -------------------------------------------------------------------
 877+ 77FF              IsCellOnRamp:
 878+ 77FF C5               push bc
 879+ 7800 E5               push hl
 880+ 7801
 881+ 7801 3A E0 EC         ld   a, (ramp_len)
 882+ 7804 B7               or   a
 883+ 7805 28 6B            jr   z, .no
 884+ 7807
 885+ 7807                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 886+ 7807 3A DF EC         ld   a, (ramp_dir)
 887+ 780A B7               or   a
 888+ 780B 28 1A            jr   z, .range_left
 889+ 780D              .range_right:
 890+ 780D 3A E2 EC         ld   a, (ramp_col)
 891+ 7810 47               ld   b, a              ; B = ramp_col
 892+ 7811 3A E0 EC         ld   a, (ramp_len)
 893+ 7814 80               add  a, b              ; A = ramp_col + ramp_len
 894+ 7815 4F               ld   c, a              ; C = limit_right (exclusive)
 895+ 7816
 896+ 7816 7B               ld   a, e              ; A = Col
 897+ 7817 B8               cp   b
 898+ 7818 38 34            jr   c, .check_platform_case ; Col < ramp_col
 899+ 781A B9               cp   c
 900+ 781B 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 901+ 781D
 902+ 781D                  ; Calcola B = Col - ramp_col
 903+ 781D 7B               ld   a, e
 904+ 781E 90               sub  b
 905+ 781F 47               ld   b, a              ; B = offset (0..ramp_len-1)
 906+ 7820
 907+ 7820                  ; SlopeRow = ramp_row - B
 908+ 7820 3A E1 EC         ld   a, (ramp_row)
 909+ 7823 90               sub  b
 910+ 7824 47               ld   b, a              ; B = SlopeRow
 911+ 7825 18 1F            jr   .check_row_match
 912+ 7827
 913+ 7827              .range_left:
 914+ 7827                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 915+ 7827 21 E0 EC         ld   hl, ramp_len
 916+ 782A 3A E2 EC         ld   a, (ramp_col)
 917+ 782D 96               sub  (hl)
 918+ 782E 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 919+ 782F 47               ld   b, a              ; B = limit_left
 920+ 7830
 921+ 7830 3A E2 EC         ld   a, (ramp_col)
 922+ 7833 3C               inc  a
 923+ 7834 4F               ld   c, a              ; C = limit_right (exclusive)
 924+ 7835
 925+ 7835 7B               ld   a, e              ; A = Col
 926+ 7836 B8               cp   b
 927+ 7837 38 15            jr   c, .check_platform_case
 928+ 7839 B9               cp   c
 929+ 783A 30 12            jr   nc, .check_platform_case
 930+ 783C
 931+ 783C                  ; Calcola B = ramp_col - Col
 932+ 783C 3A E2 EC         ld   a, (ramp_col)
 933+ 783F 93               sub  e
 934+ 7840 47               ld   b, a              ; B = offset
 935+ 7841
 936+ 7841                  ; SlopeRow = ramp_row - B
 937+ 7841 3A E1 EC         ld   a, (ramp_row)
 938+ 7844 90               sub  b
 939+ 7845 47               ld   b, a              ; B = SlopeRow
 940+ 7846
 941+ 7846              .check_row_match:
 942+ 7846                  ; D (Row) deve essere uguale a SlopeRow (in B) o SlopeRow + 1 (immediatamente sotto)
 943+ 7846 7A               ld   a, d              ; A = Row
 944+ 7847 B8               cp   b
 945+ 7848 28 2C            jr   z, .yes           ; Row == SlopeRow
 946+ 784A 04               inc  b                 ; B = SlopeRow + 1
 947+ 784B B8               cp   b
 948+ 784C 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 949+ 784E

 598+ 8653              ; CheckActiveItemAtCell
 599+ 8653              ;
 600+ 8653              ; Verifica rapida su griglia se c'è un item attivo alla cella (B=Col, C=Row)
 601+ 8653              ; Output: Carry Set = Item presente, Carry Clear = Nessun item
 602+ 8653              ; -------------------------------------------------------------------
 603+ 8653              CheckActiveItemAtCell:
 604+ 8653 D5               push de
 605+ 8654 E5               push hl
 606+ 8655
 607+ 8655 26 00            ld   h, 0
 608+ 8657 69               ld   l, c                      ; HL = Row
 609+ 8658 29               add  hl, hl
 609+ 8659 29             add hl, hl
 609+ 865A 29             add hl, hl
 609+ 865B 29             add hl, hl
 609+ 865C 29             add hl, hl
 610+ 865D 58               ld   e, b
 611+ 865E 16 00            ld   d, 0
 612+ 8660 19               add  hl, de
 613+ 8661 11 D2 DF         ld   de, items_grid
 614+ 8664 19               add  hl, de
 615+ 8665 7E               ld   a, (hl)
 616+ 8666 B7               or   a
 617+ 8667 28 04            jr   z, .not_active
 618+ 8669
 619+ 8669 E1               pop  hl
 620+ 866A D1               pop  de
 621+ 866B 37               scf
 622+ 866C C9               ret
 623+ 866D
 624+ 866D              .not_active:

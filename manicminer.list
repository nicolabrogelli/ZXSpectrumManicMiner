 414+ 8564              ; CheckWillyItemCollision
 415+ 8564              ;
 416+ 8564              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 8564              ; Input:
 418+ 8564              ;   A = Item Col (0..31)
 419+ 8564              ;   H = Item Row (0..15)
 420+ 8564              ; Output:
 421+ 8564              ;   Carry Set = Collisione
 422+ 8564              ;   Carry Clear = Nessuna collisione
 423+ 8564              ; -------------------------------------------------------------------
 424+ 8564              CheckWillyItemCollision:
 425+ 8564 C5               push bc
 426+ 8565 D5               push de
 427+ 8566 E5               push hl
 428+ 8567
 429+ 8567                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8567 6F               ld   l, a
 431+ 8568 87               add  a, a                      ; *2
 432+ 8569 87               add  a, a                      ; *4
 433+ 856A 87               add  a, a                      ; *8
 434+ 856B 5F               ld   e, a                      ; E = ItemLeft
 435+ 856C C6 07            add  a, 7
 436+ 856E 57               ld   d, a                      ; D = ItemRight
 437+ 856F
 438+ 856F ED 4B 07 E2      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 8573
 440+ 8573                  ; WillyLeft <= ItemRight
 441+ 8573 79               ld   a, c                      ; A = WillyX
 442+ 8574 BA               cp   d                         ; D = ItemRight
 443+ 8575 28 04            jr   z, .x_ok
 444+ 8577 38 02            jr   c, .x_ok
 445+ 8579 18 31            jr   .no_collision
 446+ 857B
 447+ 857B              .x_ok:
 448+ 857B                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)

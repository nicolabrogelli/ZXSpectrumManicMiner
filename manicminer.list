  29+ 8026 0E 00            ld   c, 0
  30+ 8028
  31+ 8028              .loop:
  32+ 8028 7E               ld   a, (hl)
  33+ 8029 BB               cp   e
  34+ 802A 20 06            jr   nz, .no_match
  35+ 802C 23               inc  hl
  36+ 802D 7E               ld   a, (hl)
  37+ 802E BA               cp   d
  38+ 802F 28 08            jr   z, .found
  39+ 8031 2B               dec  hl
  40+ 8032
  41+ 8032              .no_match:
  42+ 8032 23               inc  hl
  43+ 8033 23               inc  hl
  44+ 8034 0C               inc  c
  45+ 8035 10 F1            djnz .loop
  46+ 8037
  47+ 8037 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 8039

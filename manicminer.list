 689+ 83E7 47               ld   b, a
 690+ 83E8 3A 1D E5         ld   a, (high_score + 0)
 691+ 83EB B8               cp   b
 692+ 83EC 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

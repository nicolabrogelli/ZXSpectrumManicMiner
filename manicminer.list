 682+ 83B1 3A F2 CC         ld   a, (high_score + 1)
 683+ 83B4 B8               cp   b
 684+ 83B5 38 0C            jr   c, .new_high_score
 685+ 83B7 20 1C            jr   nz, .done_check
 686+ 83B9
 687+ 83B9                  ; Byte 0:
 688+ 83B9 3A EE CC         ld   a, (player_score + 0)
 689+ 83BC 47               ld   b, a
 690+ 83BD 3A F1 CC         ld   a, (high_score + 0)
 691+ 83C0 B8               cp   b
 692+ 83C1 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 693+ 83C3

 467+ 81D6 28 04            jr   z, .y_ok
 468+ 81D8 38 02            jr   c, .y_ok
 469+ 81DA 18 13            jr   .no_collision
 470+ 81DC
 471+ 81DC              .y_ok:
 472+ 81DC                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81DC BB               cp   e                         ; E = ItemTop
 474+ 81DD 28 0B            jr   z, .collision
 475+ 81DF 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81E1
 477+ 81E1                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81E1 C6 0F            add  a, 15
 479+ 81E3 BB               cp   e
 480+ 81E4 28 04            jr   z, .collision
 481+ 81E6 30 02            jr   nc, .collision

 467+ 81D4 28 04            jr   z, .y_ok
 468+ 81D6 38 02            jr   c, .y_ok
 469+ 81D8 18 13            jr   .no_collision
 470+ 81DA
 471+ 81DA              .y_ok:
 472+ 81DA                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81DA BB               cp   e                         ; E = ItemTop
 474+ 81DB 28 0B            jr   z, .collision
 475+ 81DD 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81DF
 477+ 81DF                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81DF C6 0F            add  a, 15
 479+ 81E1 BB               cp   e
 480+ 81E2 28 04            jr   z, .collision

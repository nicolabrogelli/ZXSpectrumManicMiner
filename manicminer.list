 248+ 8666 73               ld   (hl), e                   ; Salva colore nella griglia
 249+ 8667
 250+ 8667 E1               pop  hl                        ; HL = puntatore al flag Collected nei dati stanza
 251+ 8668
 252+ 8668                  ; Salva l'item nella cache current_room_items (5 byte: Col, Row, Color, FlagPtrLow, FlagPtrHigh)
 253+ 8668 FD 71 00         ld   (iy+0), c                 ; Colonna
 254+ 866B FD 70 01         ld   (iy+1), b                 ; Riga
 255+ 866E FD 73 02         ld   (iy+2), e                 ; Colore

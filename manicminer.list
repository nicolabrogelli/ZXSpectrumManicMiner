 119+ 8728 ~            .play_current_note:
 120+ 8728 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8728 ~                ld   a, (Audio_music_note_idx)
 122+ 8728 ~                ld   e, a
 123+ 8728 ~                ld   d, 0
 124+ 8728 ~                ld   hl, Audio_MusicSheet
 125+ 8728 ~                add  hl, de

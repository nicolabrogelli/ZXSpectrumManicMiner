 390+ 7F5C              Enemy_Update:
 391+ 7F5C                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7F5C 3A E9 99         ld   a, (enemy_update_rate)
 393+ 7F5F FE 01            cp   1
 394+ 7F61 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7F63
 396+ 7F63 21 EA 99         ld   hl, enemy_update_timer
 397+ 7F66 34               inc  (hl)
 398+ 7F67 7E               ld   a, (hl)
 399+ 7F68 21 E9 99         ld   hl, enemy_update_rate
 400+ 7F6B BE               cp   (hl)
 401+ 7F6C D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7F6D AF               xor  a
 403+ 7F6E 32 EA 99         ld   (enemy_update_timer), a

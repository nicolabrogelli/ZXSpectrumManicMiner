   8+ 86DC              ; Audio_UpdateJumpSound
   9+ 86DC              ;
  10+ 86DC              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 86DC              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 86DC              ; -------------------------------------------------------------------
  13+ 86DC              Audio_UpdateJumpSound:
  14+ 86DC F5               push af
  15+ 86DD C5               push bc
  16+ 86DE D5               push de
  17+ 86DF E5               push hl
  18+ 86E0
  19+ 86E0                  ; Controlla se il suono è attivo (note < 18)
  20+ 86E0 3A 3C E8         ld   a, (Audio_jump_sound_note)
  21+ 86E3 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86E5 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86E7
  24+ 86E7                  ; Carica la nota corrente da suonare
  25+ 86E7 5F               ld   e, a
  26+ 86E8 16 00            ld   d, 0
  27+ 86EA 21 16 87         ld   hl, Audio_JumpSoundDelays
  28+ 86ED 19               add  hl, de
  29+ 86EE 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86EF 57               ld   d, a                      ; D = delay della nota
  31+ 86F0
  32+ 86F0                  ; Suona la nota: 15 cicli
  33+ 86F0 06 0F            ld   b, 15
  34+ 86F2              .note_loop:
  35+ 86F2                  ; Speaker ON
  36+ 86F2 3A 29 E2         ld   a, (room_border_color)
  37+ 86F5 F6 10            or   $10
  38+ 86F7 D3 FE            out  ($fe), a
  39+ 86F9 4A               ld   c, d
  40+ 86FA              .d1:
  41+ 86FA 0D               dec  c
  42+ 86FB 20 FD            jr   nz, .d1
  43+ 86FD
  44+ 86FD                  ; Speaker OFF
  45+ 86FD 3A 29 E2         ld   a, (room_border_color)
  46+ 8700 E6 EF            and  $ef
  47+ 8702 D3 FE            out  ($fe), a
  48+ 8704 4A               ld   c, d
  49+ 8705              .d2:
  50+ 8705 0D               dec  c
  51+ 8706 20 FD            jr   nz, .d2
  52+ 8708
  53+ 8708 10 E8            djnz .note_loop
  54+ 870A
  55+ 870A                  ; Passa alla nota successiva
  56+ 870A 3A 3C E8         ld   a, (Audio_jump_sound_note)
  57+ 870D 3C               inc  a
  58+ 870E 32 3C E8         ld   (Audio_jump_sound_note), a
  59+ 8711
  60+ 8711              .done:
  61+ 8711 E1               pop  hl
  62+ 8712 D1               pop  de
  63+ 8713 C1               pop  bc
  64+ 8714 F1               pop  af
  65+ 8715 C9               ret

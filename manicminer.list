   2+ 8081              ; items.asm
   3+ 8081              ;
   4+ 8081              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 8081              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 8081              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 8081              ;===========================================================================
   8+ 8081
   9+ 8081              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 8081
  11+ 8081              ; -------------------------------------------------------------------
  12+ 8081              ; DetermineCurrentRoomID
  13+ 8081              ;
  14+ 8081              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 8081              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 8081              ;
  17+ 8081              ; Output:
  18+ 8081              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 8081              ;   (current_room) = A
  20+ 8081              ; -------------------------------------------------------------------
  21+ 8081              DetermineCurrentRoomID:
  22+ 8081 E5               push hl
  23+ 8082 D5               push de
  24+ 8083 C5               push bc
  25+ 8084
  26+ 8084 21 6B 73         ld   hl, RoomsListTable
  27+ 8087 ED 5B E7 99      ld   de, (room_ptr)
  28+ 808B 06 02            ld   b, NUM_ROOMS
  29+ 808D 0E 00            ld   c, 0
  30+ 808F
  31+ 808F              .loop:
  32+ 808F 7E               ld   a, (hl)
  33+ 8090 BB               cp   e
  34+ 8091 20 06            jr   nz, .no_match
  35+ 8093 23               inc  hl
  36+ 8094 7E               ld   a, (hl)
  37+ 8095 BA               cp   d
  38+ 8096 28 08            jr   z, .found
  39+ 8098 2B               dec  hl
  40+ 8099
  41+ 8099              .no_match:
  42+ 8099 23               inc  hl
  43+ 809A 23               inc  hl
  44+ 809B 0C               inc  c
  45+ 809C 10 F1            djnz .loop
  46+ 809E
  47+ 809E 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 80A0
  49+ 80A0              .found:
  50+ 80A0 79               ld   a, c
  51+ 80A1 32 8D 99         ld   (current_room), a
  52+ 80A4
  53+ 80A4 C1               pop  bc
  54+ 80A5 D1               pop  de
  55+ 80A6 E1               pop  hl
  56+ 80A7 C9               ret
  57+ 80A8

1233+ 79DD              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1234+ 79DD              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1235+ 79DD              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1236+ 79DD              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1237+ 79DD              ; -------------------------------------------------------------------
1238+ 79DD              UnpackRoomLayout:
1239+ 79DD E5               push hl
1240+ 79DE D5               push de
1241+ 79DF C5               push bc
1242+ 79E0 DD E5            push ix
1243+ 79E2
1244+ 79E2 DD 2A AD EE      ld   ix, (room_ptr)
1245+ 79E6 11 20 02         ld   de, OFFSET_TILES
1246+ 79E9 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1247+ 79EB
1248+ 79EB 2A AD EE         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1249+ 79EE 11 52 EC         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1250+ 79F1 01 00 02         ld   bc, 512               ; 512 celle
1251+ 79F4
1252+ 79F4              .byte_loop:
1253+ 79F4 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1254+ 79F5 23               inc  hl
1255+ 79F6
1256+ 79F6                  ; Confronta con le 8 definizioni di tile:
1257+ 79F6 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1258+ 79F9 28 23            jr   z, .is_bg
1259+ 79FB DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1260+ 79FE 28 29            jr   z, .is_wall
1261+ 7A00 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1262+ 7A03 28 1C            jr   z, .is_floor
1263+ 7A05 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1264+ 7A08 28 1B            jr   z, .is_crumbling
1265+ 7A0A DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1266+ 7A0D 28 1E            jr   z, .is_conveyor
1267+ 7A0F DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1268+ 7A12 28 1D            jr   z, .is_nasty1
1269+ 7A14 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1270+ 7A17 28 1C            jr   z, .is_nasty2
1271+ 7A19 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1272+ 7A1C 28 1B            jr   z, .is_extra

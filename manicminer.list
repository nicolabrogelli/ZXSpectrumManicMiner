 163+ 7DFA 32 2F EE         ld   (room_has_v_guardians), a
 164+ 7DFD 18 06            jr   .has_v_guardians
 165+ 7DFF
 166+ 7DFF              .no_v_guardians:
 167+ 7DFF AF               xor  a
 168+ 7E00 32 2F EE         ld   (room_has_v_guardians), a

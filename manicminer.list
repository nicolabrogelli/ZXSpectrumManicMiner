 144+ 8456 ~                jr   nz, .d1
 145+ 8456 ~
 146+ 8456 ~                ; Speaker OFF
 147+ 8456 ~                ld   a, (room_border_color)
 148+ 8456 ~                and  $ef
 149+ 8456 ~                out  ($fe), a
 150+ 8456 ~                ld   c, d
 151+ 8456 ~            .d2:
 152+ 8456 ~                push af
 153+ 8456 ~                pop  af
 154+ 8456 ~                dec  c
 155+ 8456 ~                jr   nz, .d2
 156+ 8456 ~
 157+ 8456 ~                djnz .note_loop
 158+ 8456 ~
 159+ 8456 ~            .done:
 160+ 8456 ~                pop  hl
 161+ 8456 ~                pop  de
 162+ 8456 ~                pop  bc
 163+ 8456 ~                pop  af
 164+ 8456 ~                ret

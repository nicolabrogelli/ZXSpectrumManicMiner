 870+ 777F              ; -------------------------------------------------------------------
 871+ 777F              IsCellOnRamp:
 872+ 777F C5               push bc
 873+ 7780 E5               push hl
 874+ 7781
 875+ 7781 3A 3F E5         ld   a, (ramp_len)
 876+ 7784 B7               or   a
 877+ 7785 28 6B            jr   z, .no
 878+ 7787
 879+ 7787                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 880+ 7787 3A 3E E5         ld   a, (ramp_dir)
 881+ 778A B7               or   a
 882+ 778B 28 1A            jr   z, .range_left
 883+ 778D              .range_right:
 884+ 778D 3A 41 E5         ld   a, (ramp_col)
 885+ 7790 47               ld   b, a              ; B = ramp_col
 886+ 7791 3A 3F E5         ld   a, (ramp_len)
 887+ 7794 80               add  a, b              ; A = ramp_col + ramp_len
 888+ 7795 4F               ld   c, a              ; C = limit_right (exclusive)
 889+ 7796
 890+ 7796 7B               ld   a, e              ; A = Col
 891+ 7797 B8               cp   b
 892+ 7798 38 34            jr   c, .check_platform_case ; Col < ramp_col
 893+ 779A B9               cp   c
 894+ 779B 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 895+ 779D
 896+ 779D                  ; Calcola B = Col - ramp_col
 897+ 779D 7B               ld   a, e
 898+ 779E 90               sub  b
 899+ 779F 47               ld   b, a              ; B = offset (0..ramp_len-1)
 900+ 77A0
 901+ 77A0                  ; SlopeRow = ramp_row - B
 902+ 77A0 3A 40 E5         ld   a, (ramp_row)
 903+ 77A3 90               sub  b
 904+ 77A4 47               ld   b, a              ; B = SlopeRow
 905+ 77A5 18 1F            jr   .check_row_match
 906+ 77A7
 907+ 77A7              .range_left:
 908+ 77A7                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 909+ 77A7 21 3F E5         ld   hl, ramp_len
 910+ 77AA 3A 41 E5         ld   a, (ramp_col)
 911+ 77AD 96               sub  (hl)
 912+ 77AE 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 913+ 77AF 47               ld   b, a              ; B = limit_left
 914+ 77B0
 915+ 77B0 3A 41 E5         ld   a, (ramp_col)
 916+ 77B3 3C               inc  a
 917+ 77B4 4F               ld   c, a              ; C = limit_right (exclusive)
 918+ 77B5
 919+ 77B5 7B               ld   a, e              ; A = Col
 920+ 77B6 B8               cp   b
 921+ 77B7 38 15            jr   c, .check_platform_case
 922+ 77B9 B9               cp   c
 923+ 77BA 30 12            jr   nc, .check_platform_case
 924+ 77BC
 925+ 77BC                  ; Calcola B = ramp_col - Col
 926+ 77BC 3A 41 E5         ld   a, (ramp_col)

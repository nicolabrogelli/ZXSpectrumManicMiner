# file opened: physics_config.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; physics_config.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Configurazioni globali per la fisica del salto e del movimento in Manic Miner.
   5+ 5DAD              ; Tutti i parametri di default della fisica possono essere personalizzati qui.
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DDEFAULT_JUMP_STRENGTH=5 -DDEFAULT_GRAVITY_PRESET=1).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Forza del Salto di Default (Altezza iniziale) ---
  11+ 5DAD              ; Definisce l'impulso verticale iniziale per il salto quando la stanza non specifica un valore personalizzato.
  12+ 5DAD              ; Valori tipici:
  13+ 5DAD              ;   6 = Salto standard (Manic Miner originale)
  14+ 5DAD              ;   5 = Salto medio/corto
  15+ 5DAD              ;   4 = Salto corto
  16+ 5DAD                  IFNDEF DEFAULT_JUMP_STRENGTH
  17+ 5DAD              DEFAULT_JUMP_STRENGTH EQU 6
  18+ 5DAD                  ENDIF
  19+ 5DAD
  20+ 5DAD              ; Alias per compatibilità con il codice esistente
  21+ 5DAD              JUMP_STRENGTH: EQU DEFAULT_JUMP_STRENGTH
  22+ 5DAD
  23+ 5DAD              ; --- Preset Gravità di Default ---
  24+ 5DAD              ; Definisce il comportamento della gravità per le stanze che non hanno un valore personalizzato.
  25+ 5DAD              ; Presets:
  26+ 5DAD              ;   0 = Gravità 0.5 (leggera)
  27+ 5DAD              ;   1 = Gravità 0.75 (standard MM)
  28+ 5DAD              ;   2 = Gravità 1.0 (pesante)
  29+ 5DAD              ;   3 = Gravità 0.25 (molto leggera)
  30+ 5DAD              ;   4 = Gravità 0.0 (nessuna gravità)
  31+ 5DAD                  IFNDEF DEFAULT_GRAVITY_PRESET
  32+ 5DAD              DEFAULT_GRAVITY_PRESET EQU 1
  33+ 5DAD                  ENDIF
  34+ 5DAD
  35+ 5DAD              ; --- Lunghezza / Ampiezza Parabola Salto Orizzontale (Air Speed Preset) ---
  36+ 5DAD              ; Definisce lo spostamento orizzontale in pixel per frame durante il salto direzionale.
  37+ 5DAD              ; Consente di accorciare o allungare la parabola orizzontale mantenendo l'altezza massima invariata.
  38+ 5DAD              ; Presets:
  39+ 5DAD              ;   0 = Parabola stretta       (1.0 px/frame costante  -> gittata ~16 pixel / 2 blocchi)
  40+ 5DAD              ;   1 = Parabola corta         (1.5 px/frame alternato -> gittata ~24 pixel / 3 blocchi)
  41+ 5DAD              ;   2 = Parabola media         (2.0 px/frame costante  -> gittata ~32 pixel / 4 blocchi)
  42+ 5DAD              ;   3 = Parabola standard MM   (2.5 px/frame alternato -> gittata ~40 pixel / 5 blocchi)
  43+ 5DAD              ;   4 = Parabola estesa        (3.0 px/frame costante  -> gittata ~48 pixel / 6 blocchi)
  44+ 5DAD                  IFNDEF DEFAULT_AIR_SPEED_PRESET
  45+ 5DAD              DEFAULT_AIR_SPEED_PRESET EQU 3
  46+ 5DAD                  ENDIF
  47+ 5DAD
  48+ 5DAD              JUMP_AIR_SPEED_PRESET: EQU DEFAULT_AIR_SPEED_PRESET
  49+ 5DAD
  50+ 5DAD              ; --- Velocità Massima di Caduta ---
  51+ 5DAD              ; Limite massimo per la velocità di caduta verso il basso (in pixel/frame)
  52+ 5DAD                  IFNDEF MAX_FALL_SPEED
  53+ 5DAD              MAX_FALL_SPEED EQU 12
  54+ 5DAD                  ENDIF
  55+ 5DAD
  56+ 5DAD              ; --- Gravità Base ---
  57+ 5DAD                  IFNDEF GRAVITY
  58+ 5DAD              GRAVITY EQU 1
  59+ 5DAD                  ENDIF
  60+ 5DAD
  61+ 5DAD              ; --- Tolleranza Hitbox Collisioni Guardiani (Inset Margins) ---
  62+ 5DAD              ; Definisce il margine di rientro in pixel per escludere i bordi trasparenti degli sprite.
  63+ 5DAD              ;   0 = Hitbox rigida originale 8x16 vs 16x16
  64+ 5DAD              ;   1 = Tolleranza leggera (1px per lato)
  65+ 5DAD              ;   2 = Tolleranza consigliata (2px per lato, evita morte su bordi vuoti)
  66+ 5DAD                  IFNDEF COLLISION_INSET_X
  67+ 5DAD              COLLISION_INSET_X EQU 2
  68+ 5DAD                  ENDIF
  69+ 5DAD
  70+ 5DAD                  IFNDEF COLLISION_INSET_Y
  71+ 5DAD              COLLISION_INSET_Y EQU 2
  72+ 5DAD                  ENDIF
  73+ 5DAD
  74+ 5DAD              COLLISION_OFFSET_X:    EQU (7 - (2 * COLLISION_INSET_X))
  75+ 5DAD              COLLISION_THRESHOLD_X: EQU (23 - (4 * COLLISION_INSET_X))
  76+ 5DAD
  77+ 5DAD              COLLISION_OFFSET_Y:    EQU (15 - (2 * COLLISION_INSET_Y))
  78+ 5DAD              COLLISION_THRESHOLD_Y: EQU (31 - (4 * COLLISION_INSET_Y))
  79+ 5DAD
  80+ 5DAD              ; --- Tempo di Sicurezza (Invulnerabilità) al Respawn dopo la Morte --
  81+ 5DAD              ; Numero di frame (50Hz) di invulnerabilità ai guardiani dopo il respawn di Willy.
  82+ 5DAD              ;   0  = Disabilitato (nessuna sicurezza)
  83+ 5DAD              ;  50  = 1 secondo di invulnerabilità (default consigliato)
  84+ 5DAD              ;  75  = 1.5 secondi
  85+ 5DAD              ; 100  = 2 secondi
  86+ 5DAD                  IFNDEF RESPAWN_SAFETY_TIME
  87+ 5DAD              RESPAWN_SAFETY_TIME EQU 0
  88+ 5DAD                  ENDIF
  89+ 5DAD
  90+ 5DAD              ; --- Coyote Time (Tempo Coyote per Salto da Bordo) ---
  91+ 5DAD              ; Numero di frame nei quali Willy può ancora saltare dopo essere scivolato oltre il bordo di una piattaforma.
  92+ 5DAD                  IFNDEF COYOTE_TIME_FRAMES
  93+ 5DAD              COYOTE_TIME_FRAMES EQU 4
  94+ 5DAD                  ENDIF
  95+ 5DAD
  96+ 5DAD              ; --- Buffer Pre-Salto (Jump Buffer) ---
  97+ 5DAD              ; Numero di frame nei quali l'input del salto (tasto Z) viene conservato
  98+ 5DAD              ; se premuto poco prima di toccare terra (evita il tasto "sordo").
  99+ 5DAD                  IFNDEF JUMP_BUFFER_FRAMES
 100+ 5DAD              JUMP_BUFFER_FRAMES EQU 5
 101+ 5DAD                  ENDIF
 102+ 5DAD
 103+ 5DAD              ; --- Pausa all'Apice del Salto Verticale (Vertical Jump Apex Pause) ---
 104+ 5DAD              ; Numero di frame (50Hz, 1 frame = 20ms) nei quali Willy rimane sospeso
 105+ 5DAD              ; all'apice del salto verticale prima che inizi la fase di discesa.
 106+ 5DAD              ;   0 = Nessuna pausa (discesa immediata standard)
 107+ 5DAD              ;   2 = Pausa di 2 frame (40 ms)
 108+ 5DAD              ;   3 = Pausa di 3 frame (60 ms - valore frazionario consigliato)
 109+ 5DAD              ;   5 = Pausa di 5 frame (100 ms)
 110+ 5DAD                  IFNDEF VERTICAL_JUMP_APEX_PAUSE
 111+ 5DAD              VERTICAL_JUMP_APEX_PAUSE EQU 6
 112+ 5DAD                  ENDIF
 113+ 5DAD
 114+ 5DAD
 115+ 5DAD

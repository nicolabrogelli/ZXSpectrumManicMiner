 151+ 7D6F              .done_h_guardians:
 152+ 7D6F                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 153+ 7D6F 2A 53 E5         ld   hl, (room_ptr)
 154+ 7D72 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 155+ 7D75 19               add  hl, de
 156+ 7D76
 157+ 7D76 7E               ld   a, (hl)
 158+ 7D77 FE FF            cp   $FF
 159+ 7D79 28 0A            jr   z, .no_v_guardians
 160+ 7D7B B7               or   a
 161+ 7D7C 28 07            jr   z, .no_v_guardians

 222+ 5EA0
 223+ 5EA0 78               ld   a, b                  ; A = 1..8
 224+ 5EA1 3D               dec  a                     ; A = 0..7 (scanline per item da 8 byte)
 225+ 5EA2 5F               ld   e, a
 226+ 5EA3 16 00            ld   d, 0
 227+ 5EA5 2A 62 EF         ld   hl, (room_ptr)

 891+ 777D 47               ld   b, a              ; B = limit_left
 892+ 777E
 893+ 777E 3A D8 E4         ld   a, (ramp_col)
 894+ 7781 3C               inc  a
 895+ 7782 4F               ld   c, a              ; C = limit_right (exclusive)
 896+ 7783
 897+ 7783 7B               ld   a, e              ; A = Col
 898+ 7784 B8               cp   b
 899+ 7785 38 15            jr   c, .check_platform_case
 900+ 7787 B9               cp   c
 901+ 7788 30 12            jr   nc, .check_platform_case

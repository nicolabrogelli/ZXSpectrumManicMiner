 529  828C              ; -------------------------------------------------------------------
 530  828C              ; TriggerVictory
 531  828C              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 532  828C              ; - Pulisce gli elementi di gioco della stanza.
 533  828C              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 534  828C              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 535  828C              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 536  828C              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 537  828C              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 538  828C              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 539  828C              ; -------------------------------------------------------------------
 540  828C              TriggerVictory:
 541  828C                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 542  828C CD 63 65         call Gfx_DrawVictoryScreen
 543  828F
 544  828F                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 545  828F              .wait_keys_release:
 546  828F 76               halt
 547  8290                  ; Controlla tasto Y (Porta $DF, bit 4)
 548  8290 01 FE DF         ld   bc, $dffe
 549  8293 ED 78            in   a, (c)
 550  8295 CB 67            bit  4, a
 551  8297 28 F6            jr   z, .wait_keys_release
 552  8299
 553  8299                  ; Controlla tasto N (Porta $7F, bit 3)
 554  8299 01 FE 7F         ld   bc, $7ffe
 555  829C ED 78            in   a, (c)
 556  829E CB 5F            bit  3, a
 557  82A0 28 ED            jr   z, .wait_keys_release
 558  82A2
 559  82A2                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 560  82A2 01 FE BF         ld   bc, $bffe
 561  82A5 ED 78            in   a, (c)
 562  82A7 CB 47            bit  0, a
 563  82A9 28 E4            jr   z, .wait_keys_release
 564  82AB
 565  82AB                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 566  82AB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 567  82AD              .wait_choice_loop:

 652+ 87C7
 653+ 87C7                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 87C7 3A FF F0         ld   a, (player_score + 2)
 655+ 87CA CE 00            adc  a, 0
 656+ 87CC 27               daa
 657+ 87CD 32 FF F0         ld   (player_score + 2), a

 161+ 7A93              ; -------------------------------------------------------------------
 162+ 7A93              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7A93              ; -------------------------------------------------------------------
 164+ 7A93              CheckEnemyWillyOverlap:
 165+ 7A93 3A 6B 92         ld   a, (player_drawn_pos+1)
 166+ 7A96 FE FF            cp   $FF
 167+ 7A98 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7A99
 169+ 7A99                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7A99 3A 6A 92         ld   a, (player_drawn_pos)
 171+ 7A9C E6 F8            and  $F8
 172+ 7A9E 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7A9F 79               ld   a, c
 174+ 7AA0 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7AA2 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7AA3 C6 10            add  a, 16
 177+ 7AA5 FE 19            cp   25
 178+ 7AA7 D0               ret  nc                 ; Fuori portata X
 179+ 7AA8
 180+ 7AA8                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7AA8 3A 6B 92         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7AAB 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7AAC C6 0F            add  a, 15
 184+ 7AAE FE 1F            cp   31
 185+ 7AB0 D0               ret  nc                 ; Fuori portata Y

 460+ 856F              .y_check:
 461+ 856F                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 856F 7C               ld   a, h                      ; H = Item Row
 463+ 8570 87               add  a, a                      ; *2

 356+ 7E6F              ; -------------------------------------------------------------------
 357+ 7E6F              ; Enemy_DrawSingleSlot
 358+ 7E6F              ;
 359+ 7E6F              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 360+ 7E6F              ; La grafica (8 frame da 32 byte) è letta direttamente da
 361+ 7E6F              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 362+ 7E6F              ; -------------------------------------------------------------------
 363+ 7E6F              Enemy_DrawSingleSlot:
 364+ 7E6F C5               push bc
 365+ 7E70 D5               push de
 366+ 7E71 E5               push hl
 367+ 7E72 DD E5            push ix
 368+ 7E74
 369+ 7E74                  ; 1. Salva subito le coordinate X e Y dal record IX
 370+ 7E74 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 371+ 7E77 DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 372+ 7E7A
 373+ 7E7A                  ; Controlla se è guardiano verticale
 374+ 7E7A DD 7E 00         ld   a, (ix+0)
 375+ 7E7D E6 40            and  $40                       ; Vertical?
 376+ 7E7F 20 15            jr   nz, .v_frame
 377+ 7E81
 378+ 7E81                  ; Guardiano Orizzontale:
 379+ 7E81 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 380+ 7E84 E6 03            and  3
 381+ 7E86 5F               ld   e, a                      ; E = Anim subframe
 382+ 7E87
 383+ 7E87 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 384+ 7E8A FE 01            cp   1                         ; Sinistra?
 385+ 7E8C 28 03            jr   z, .left_frames
 386+ 7E8E
 387+ 7E8E                  ; Movimento a Destra: Frame 0..3
 388+ 7E8E 7B               ld   a, e
 389+ 7E8F 18 0A            jr   .got_frame_idx
 390+ 7E91
 391+ 7E91              .left_frames:
 392+ 7E91                  ; Movimento a Sinistra: Frame 4..7
 393+ 7E91 3E 04            ld   a, 4
 394+ 7E93 83               add  a, e
 395+ 7E94 18 05            jr   .got_frame_idx
 396+ 7E96
 397+ 7E96              .v_frame:
 398+ 7E96                  ; Guardiano Verticale: usa il frame salvato in (ix+1) (4..7)
 399+ 7E96 DD 7E 01         ld   a, (ix+1)
 400+ 7E99 E6 07            and  7
 401+ 7E9B
 402+ 7E9B              .got_frame_idx:
 403+ 7E9B                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 404+ 7E9B 6F               ld   l, a
 405+ 7E9C 26 00            ld   h, 0
 406+ 7E9E 29               add  hl, hl                    ; *2
 407+ 7E9F 29               add  hl, hl                    ; *4
 408+ 7EA0 29               add  hl, hl                    ; *8
 409+ 7EA1 29               add  hl, hl                    ; *16
 410+ 7EA2 29               add  hl, hl                    ; *32
 411+ 7EA3
 412+ 7EA3 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 413+ 7EA6 19               add  hl, de
 414+ 7EA7 ED 5B 50 BE      ld   de, (room_ptr)
 415+ 7EAB 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 416+ 7EAC
 417+ 7EAC DD 7E 0A         ld   a, (ix+10)                ; A = Color Attributo
 418+ 7EAF F5               push af                        ; Salva colore nello stack
 419+ 7EB0
 420+ 7EB0 E5               push hl
 421+ 7EB1 DD E1            pop  ix                        ; IX = frame bitmap pointer
 422+ 7EB3
 423+ 7EB3                  ; 2. Disegna sprite 16x16 alle coordinate (C=X, B=Y)
 424+ 7EB3 CD 6B 5F         call Gfx_DrawPixelSprite16x16
 425+ 7EB6
 426+ 7EB6                  ; 3. Imposta gli attributi colore alle coordinate (C=X, B=Y)
 427+ 7EB6 F1               pop  af                        ; A = Color Attributo
 428+ 7EB7 CD 12 6D         call Gfx_SetEnemyColorAttributes
 429+ 7EBA
 430+ 7EBA DD E1            pop  ix
 431+ 7EBC E1               pop  hl
 432+ 7EBD D1               pop  de
 433+ 7EBE C1               pop  bc
 434+ 7EBF C9               ret

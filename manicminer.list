 347+ 7E1F C1               pop  bc                        ; Recupera HL originale
 348+ 7E20 D1               pop  de                        ; Recupera DE originale (E = colore)
 349+ 7E21 7B               ld   a, e
 350+ 7E22 77               ld   (hl), a                   ; Scrive l'attributo colore
 351+ 7E23
 352+ 7E23 C5               push bc
 353+ 7E24 E1               pop  hl
 354+ 7E25 C1               pop  bc
 355+ 7E26 C9               ret

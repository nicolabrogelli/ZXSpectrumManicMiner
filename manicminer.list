  12+ 801C              ; DetermineCurrentRoomID
  13+ 801C              ;
  14+ 801C              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 801C              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 801C              ;
  17+ 801C              ; Output:
  18+ 801C              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 801C              ;   (current_room) = A
  20+ 801C              ; -------------------------------------------------------------------
  21+ 801C              DetermineCurrentRoomID:
  22+ 801C E5               push hl
  23+ 801D D5               push de
  24+ 801E C5               push bc
  25+ 801F
  26+ 801F 21 04 73         ld   hl, RoomsListTable
  27+ 8022 ED 5B 82 9D      ld   de, (room_ptr)
  28+ 8026 06 03            ld   b, NUM_ROOMS
  29+ 8028 0E 00            ld   c, 0
  30+ 802A
  31+ 802A              .loop:
  32+ 802A 7E               ld   a, (hl)
  33+ 802B BB               cp   e
  34+ 802C 20 06            jr   nz, .no_match
  35+ 802E 23               inc  hl
  36+ 802F 7E               ld   a, (hl)
  37+ 8030 BA               cp   d
  38+ 8031 28 08            jr   z, .found
  39+ 8033 2B               dec  hl
  40+ 8034
  41+ 8034              .no_match:
  42+ 8034 23               inc  hl
  43+ 8035 23               inc  hl
  44+ 8036 0C               inc  c
  45+ 8037 10 F1            djnz .loop
  46+ 8039
  47+ 8039 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 803B
  49+ 803B              .found:
  50+ 803B 79               ld   a, c
  51+ 803C 32 28 9D         ld   (current_room), a
  52+ 803F
  53+ 803F C1               pop  bc
  54+ 8040 D1               pop  de
  55+ 8041 E1               pop  hl
  56+ 8042 C9               ret

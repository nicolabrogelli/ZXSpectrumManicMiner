 123+ 8095 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 8096 23               inc  hl                        ; +2 (Attr Address High)
 125+ 8097 23               inc  hl                        ; +3 (Anim mask)
 126+ 8098 23               inc  hl                        ; +4 (Collected flag)
 127+ 8099 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 809B 23               inc  hl                        ; Avanza al prossimo item
 129+ 809C 18 F2            jr   .item_loop

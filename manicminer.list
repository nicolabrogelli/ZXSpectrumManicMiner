 336+ 85E2                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 337+ 85E2 26 00            ld   h, 0
 338+ 85E4 68               ld   l, b
 339+ 85E5 29               add  hl, hl
 340+ 85E6 29               add  hl, hl
 341+ 85E7 29               add  hl, hl
 342+ 85E8 29               add  hl, hl
 343+ 85E9 29               add  hl, hl                    ; Row * 32
 344+ 85EA 79               ld   a, c

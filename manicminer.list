 525  8656              ; -------------------------------------------------------------------
 526  8656              ; TriggerVictory
 527  8656              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  8656              ; - Pulisce gli elementi di gioco della stanza.
 529  8656              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  8656              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  8656              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  8656              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  8656              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  8656              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  8656              ; -------------------------------------------------------------------
 536  8656              TriggerVictory:
 537  8656                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  8656 CD F3 66         call Gfx_DrawVictoryScreen
 539  8659
 540  8659                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  8659              .wait_keys_release:
 542  8659 76               halt
 543  865A                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  865A 01 FE DF         ld   bc, $dffe
 545  865D ED 78            in   a, (c)
 546  865F CB 67            bit  4, a
 547  8661 28 F6            jr   z, .wait_keys_release
 548  8663
 549  8663                  ; Controlla tasto N (Porta $7F, bit 3)
 550  8663 01 FE 7F         ld   bc, $7ffe
 551  8666 ED 78            in   a, (c)
 552  8668 CB 5F            bit  3, a
 553  866A 28 ED            jr   z, .wait_keys_release
 554  866C
 555  866C                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  866C 01 FE BF         ld   bc, $bffe
 557  866F ED 78            in   a, (c)
 558  8671 CB 47            bit  0, a
 559  8673 28 E4            jr   z, .wait_keys_release
 560  8675
 561  8675                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  8675 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  8677              .wait_choice_loop:
 564  8677 76               halt
 565  8678
 566  8678                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  8678 0C               inc  c
 568  8679 79               ld   a, c
 569  867A CB 3F            srl  a
 570  867C CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  867E E6 07            and  7
 572  8680 5F               ld   e, a
 573  8681 16 00            ld   d, 0
 574  8683 21 0D 66         ld   hl, victory_color_table
 575  8686 19               add  hl, de
 576  8687 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  8688 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  868B 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  868D              .color_cycle_loop:
 580  868D 77               ld   (hl), a
 581  868E 23               inc  hl
 582  868F 10 FC            djnz .color_cycle_loop
 583  8691
 584  8691                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  8691 01 FE DF         ld   bc, $dffe
 586  8694 ED 78            in   a, (c)
 587  8696 CB 67            bit  4, a
 588  8698 28 2A            jr   z, .play_again_chosen
 589  869A
 590  869A                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  869A 01 FE 7F         ld   bc, $7ffe
 592  869D ED 78            in   a, (c)
 593  869F CB 5F            bit  3, a
 594  86A1 28 0B            jr   z, .quit_chosen
 595  86A3

 541+ 7F63              .v_rev_down:
 542+ 7F63 DD 7E 04         ld   a, (ix+4)                 ; Min Limit Y
 543+ 7F66 DD 77 03         ld   (ix+3), a
 544+ 7F69 3E 02            ld   a, 2                      ; Cambia direzione a Down
 545+ 7F6B DD 77 06         ld   (ix+6), a
 546+ 7F6E C3 90 7F         jp   .next

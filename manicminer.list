 975+ 77EF              ; -------------------------------------------------------------------
 976+ 77EF              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 977+ 77EF              ; Input: C = X, B = Y
 978+ 77EF              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 979+ 77EF              ; -------------------------------------------------------------------
 980+ 77EF              CheckWallCell:
 981+ 77EF E5               push hl
 982+ 77F0 D5               push de
 983+ 77F1 C5               push bc
 984+ 77F2
 985+ 77F2                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 986+ 77F2 78               ld   a, b
 987+ 77F3 FE 80            cp   128
 988+ 77F5 30 1F            jr   nc, .not_wall
 989+ 77F7
 990+ 77F7                  ; 2. Calcola riga di layout: r = Y / 8
 991+ 77F7 CB 3F            srl  a
 992+ 77F9 CB 3F            srl  a
 993+ 77FB CB 3F            srl  a                 ; A = r (0..15)
 994+ 77FD
 995+ 77FD                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 996+ 77FD 5F               ld   e, a              ; E = r (Row)
 997+ 77FE 79               ld   a, c
 998+ 77FF CB 3F            srl  a
 999+ 7801 CB 3F            srl  a
1000+ 7803 CB 3F            srl  a                 ; A = c (0..31)
1001+ 7805 4F               ld   c, a              ; C = c (Col)
1002+ 7806
1003+ 7806                  ; Se la cella è sulla rampa, non considerarla un muro!
1004+ 7806 53               ld   d, e              ; D = Row
1005+ 7807 59               ld   e, c              ; E = Col
1006+ 7808 CD 74 77         call IsCellOnRamp
1007+ 780B 38 09            jr   c, .not_wall
1008+ 780D
1009+ 780D 7A               ld   a, d              ; A = Row
1010+ 780E 4B               ld   c, e              ; C = Col
1011+ 780F CD AB 78         call GetCellFromUnpacked ; A = cell type
1012+ 7812
1013+ 7812                  ; Controlla se è Wall (3)
1014+ 7812 FE 03            cp   3
1015+ 7814 28 05            jr   z, .is_wall
1016+ 7816
1017+ 7816              .not_wall:
1018+ 7816 C1               pop  bc
1019+ 7817 D1               pop  de
1020+ 7818 E1               pop  hl

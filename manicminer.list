 822  8702              ; CheckWillyConveyorCollision
 823  8702              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 824  8702              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 825  8702              ; -------------------------------------------------------------------
 826  8702              CheckWillyConveyorCollision:
 827  8702 C5               push bc
 828  8703 D5               push de
 829  8704 E5               push hl
 830  8705
 831  8705                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 832  8705 CD 63 77         call CheckWillyOnConveyor
 833  8708 38 49            jr   c, .collision_detected
 834  870A
 835  870A                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 836  870A 3A 2A 9D         ld   a, (conveyor_len)
 837  870D B7               or   a
 838  870E 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 839  8710
 840  8710                  ; B = WillyY, C = WillyX
 841  8710 ED 4B 02 9A      ld   bc, (PlayerPos)
 842  8714
 843  8714                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 844  8714 3A 2B 9D         ld   a, (conveyor_row)
 845  8717 87               add  a, a                  ; *2
 846  8718 87               add  a, a                  ; *4
 847  8719 87               add  a, a                  ; *8
 848  871A 5F               ld   e, a                  ; E = ConveyorTop
 849  871B C6 07            add  a, 7
 850  871D 57               ld   d, a                  ; D = ConveyorBottom
 851  871E
 852  871E                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 853  871E 78               ld   a, b                  ; WillyTop
 854  871F BA               cp   d
 855  8720 28 04            jr   z, .y_overlap
 856  8722 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 857  8724 18 32            jr   .no_conv_collision
 858  8726
 859  8726              .y_overlap:
 860  8726 C6 0F            add  a, 15                 ; WillyBottom
 861  8728 BB               cp   e
 862  8729 28 04            jr   z, .x_check
 863  872B 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 864  872D 18 29            jr   .no_conv_collision
 865  872F
 866  872F              .x_check:
 867  872F                  ; ConveyorLeft = conveyor_col * 8
 868  872F 3A 2C 9D         ld   a, (conveyor_col)
 869  8732 87               add  a, a                  ; *2
 870  8733 87               add  a, a                  ; *4
 871  8734 87               add  a, a                  ; *8
 872  8735 5F               ld   e, a                  ; E = ConveyorLeft
 873  8736
 874  8736                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 875  8736 21 2A 9D         ld   hl, conveyor_len
 876  8739 3A 2C 9D         ld   a, (conveyor_col)
 877  873C 86               add  a, (hl)
 878  873D 87               add  a, a                  ; *2
 879  873E 87               add  a, a                  ; *4
 880  873F 87               add  a, a                  ; *8
 881  8740 3D               dec  a                     ; ConveyorRight
 882  8741 57               ld   d, a                  ; D = ConveyorRight
 883  8742
 884  8742                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 885  8742 79               ld   a, c                  ; WillyLeft
 886  8743 BA               cp   d
 887  8744 28 04            jr   z, .x_overlap
 888  8746 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 889  8748 18 0E            jr   .no_conv_collision
 890  874A
 891  874A              .x_overlap:
 892  874A C6 0F            add  a, 15                 ; WillyRight
 893  874C BB               cp   e
 894  874D 28 04            jr   z, .collision_detected
 895  874F 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 896  8751 18 05            jr   .no_conv_collision

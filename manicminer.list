1241+ 7A63              ; -------------------------------------------------------------------
1242+ 7A63              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1243+ 7A63              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1244+ 7A63              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1245+ 7A63              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1246+ 7A63              ; -------------------------------------------------------------------
1247+ 7A63              UnpackRoomLayout:
1248+ 7A63 E5               push hl
1249+ 7A64 D5               push de
1250+ 7A65 C5               push bc
1251+ 7A66 DD E5            push ix
1252+ 7A68
1253+ 7A68 DD 2A F5 EF      ld   ix, (room_ptr)
1254+ 7A6C 11 20 02         ld   de, OFFSET_TILES
1255+ 7A6F DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1256+ 7A71
1257+ 7A71 2A F5 EF         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1258+ 7A74 11 9A ED         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1259+ 7A77 01 00 02         ld   bc, 512               ; 512 celle
1260+ 7A7A
1261+ 7A7A              .byte_loop:
1262+ 7A7A 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1263+ 7A7B 23               inc  hl
1264+ 7A7C
1265+ 7A7C                  ; Confronta con le 8 definizioni di tile:
1266+ 7A7C DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1267+ 7A7F 28 23            jr   z, .is_bg
1268+ 7A81 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1269+ 7A84 28 29            jr   z, .is_wall
1270+ 7A86 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1271+ 7A89 28 1C            jr   z, .is_floor
1272+ 7A8B DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1273+ 7A8E 28 1B            jr   z, .is_crumbling
1274+ 7A90 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1275+ 7A93 28 1E            jr   z, .is_conveyor
1276+ 7A95 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1277+ 7A98 28 1D            jr   z, .is_nasty1
1278+ 7A9A DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1279+ 7A9D 28 1C            jr   z, .is_nasty2
1280+ 7A9F DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1281+ 7AA2 28 1B            jr   z, .is_extra
1282+ 7AA4
1283+ 7AA4              .is_bg:
1284+ 7AA4                  ; Default: Tile 0 (Background)
1285+ 7AA4 AF               xor  a
1286+ 7AA5 18 1A            jr   .store_cell
1287+ 7AA7
1288+ 7AA7              .is_floor:
1289+ 7AA7 3E 01            ld   a, 1
1290+ 7AA9 18 16            jr   .store_cell
1291+ 7AAB              .is_crumbling:
1292+ 7AAB 3E 02            ld   a, 2
1293+ 7AAD 18 12            jr   .store_cell
1294+ 7AAF              .is_wall:
1295+ 7AAF 3E 03            ld   a, 3
1296+ 7AB1 18 0E            jr   .store_cell
1297+ 7AB3              .is_conveyor:
1298+ 7AB3 3E 04            ld   a, 4
1299+ 7AB5 18 0A            jr   .store_cell
1300+ 7AB7              .is_nasty1:
1301+ 7AB7 3E 05            ld   a, 5
1302+ 7AB9 18 06            jr   .store_cell
1303+ 7ABB              .is_nasty2:
1304+ 7ABB 3E 06            ld   a, 6
1305+ 7ABD 18 02            jr   .store_cell
1306+ 7ABF              .is_extra:
1307+ 7ABF 3E 07            ld   a, 7
1308+ 7AC1
1309+ 7AC1              .store_cell:
1310+ 7AC1 12               ld   (de), a
1311+ 7AC2 13               inc  de
1312+ 7AC3 0B               dec  bc
1313+ 7AC4 78               ld   a, b
1314+ 7AC5 B1               or   c
1315+ 7AC6 20 B2            jr   nz, .byte_loop
1316+ 7AC8
1317+ 7AC8 DD E1            pop  ix
1318+ 7ACA C1               pop  bc
1319+ 7ACB D1               pop  de
1320+ 7ACC E1               pop  hl
1321+ 7ACD C9               ret
1322+ 7ACE
1323+ 7ACE              ; -------------------------------------------------------------------
1324+ 7ACE              ; Legge il tipo di cella dal buffer decompresso in RAM
1325+ 7ACE              ; Input: A = Row (0..15), C = Col (0..31)
1326+ 7ACE              ; Output: A = tipo di cella (0..3)
1327+ 7ACE              ; Preserva tutti gli altri registri.
1328+ 7ACE              ; -------------------------------------------------------------------
1329+ 7ACE              GetCellFromUnpacked:
1330+ 7ACE E5               push hl
1331+ 7ACF D5               push de
1332+ 7AD0
1333+ 7AD0 6F               ld   l, a
1334+ 7AD1 26 00            ld   h, 0
1335+ 7AD3 29               add  hl, hl
1336+ 7AD4 29               add  hl, hl
1337+ 7AD5 29               add  hl, hl
1338+ 7AD6 29               add  hl, hl
1339+ 7AD7 29               add  hl, hl            ; HL = Row * 32
1340+ 7AD8 59               ld   e, c
1341+ 7AD9 16 00            ld   d, 0
1342+ 7ADB 19               add  hl, de            ; HL = Row * 32 + Col
1343+ 7ADC 11 9A ED         ld   de, unpacked_layout

1163+ 789A              ; -------------------------------------------------------------------
1164+ 789A              ; Phys_CheckRampOnRoomChange
1165+ 789A              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 789A              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 789A              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 789A              ; -------------------------------------------------------------------
1169+ 789A              Phys_CheckRampOnRoomChange:
1170+ 789A E5               push hl
1171+ 789B D5               push de
1172+ 789C C5               push bc
1173+ 789D
1174+ 789D                  ; Offsets per RampData: DE + 218
1175+ 789D 21 DA 00         ld   hl, 218
1176+ 78A0 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 78A1
1178+ 78A1 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 78A2 32 FE E4         ld   (ramp_dir), a

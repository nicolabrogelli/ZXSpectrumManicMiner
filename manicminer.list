 288  85AB              ; ShowTitleScreen
 289  85AB              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  85AB              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  85AB              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  85AB              ; -------------------------------------------------------------------
 293  85AB              ShowTitleScreen:
 294  85AB                  ; 1. Disegna la schermata iniziale
 295  85AB CD 76 64         call Gfx_DrawTitleScreen
 296  85AE
 297  85AE                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  85AE              .wait_title_enter_release:
 299  85AE 76               halt
 300  85AF 3E BF            ld   a, $bf
 301  85B1 DB FE            in   a, ($fe)
 302  85B3 1F               rra
 303  85B4 30 F8            jr   nc, .wait_title_enter_release
 304  85B6
 305  85B6                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  85B6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  85B8              .title_loop:
 308  85B8 76               halt
 309  85B9
 310  85B9                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  85B9 0C               inc  c
 312  85BA 79               ld   a, c
 313  85BB CB 3F            srl  a
 314  85BD CB 3F            srl  a
 315  85BF CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85C1 E6 07            and  7
 317  85C3 5F               ld   e, a
 318  85C4 16 00            ld   d, 0
 319  85C6 21 6E 64         ld   hl, title_color_table
 320  85C9 19               add  hl, de
 321  85CA 7E               ld   a, (hl)               ; A = nuovo colore
 322  85CB 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85CE 06 20            ld   b, 32
 324  85D0              .color_title_loop:
 325  85D0 77               ld   (hl), a
 326  85D1 23               inc  hl
 327  85D2 10 FC            djnz .color_title_loop
 328  85D4
 329  85D4                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85D4 3E BF            ld   a, $bf
 331  85D6 DB FE            in   a, ($fe)
 332  85D8 1F               rra
 333  85D9 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  85DB
 335  85DB                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  85DB              .wait_title_enter_release_after:
 337  85DB 76               halt
 338  85DC 3E BF            ld   a, $bf
 339  85DE DB FE            in   a, ($fe)

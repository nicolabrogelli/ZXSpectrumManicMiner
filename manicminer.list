 274+ 7E3B DD 36 01 00      ld   (ix+1), 0                 ; Frame iniziale = 0
 275+ 7E3F DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 276+ 7E43 DD 36 03 00      ld   (ix+3), 0                 ; Y = 0 (Ledge in alto)
 277+ 7E47 DD 36 04 00      ld   (ix+4), 0                 ; Min Y = 0
 278+ 7E4B DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88

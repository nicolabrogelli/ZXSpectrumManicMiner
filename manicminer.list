 161+ 7A29              ; -------------------------------------------------------------------
 162+ 7A29              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7A29              ; -------------------------------------------------------------------
 164+ 7A29              CheckEnemyWillyOverlap:
 165+ 7A29 3A AD 91         ld   a, (player_drawn_pos+1)
 166+ 7A2C FE FF            cp   $FF
 167+ 7A2E C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7A2F
 169+ 7A2F                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7A2F 3A AC 91         ld   a, (player_drawn_pos)
 171+ 7A32 E6 F8            and  $F8
 172+ 7A34 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7A35 79               ld   a, c
 174+ 7A36 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7A38 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7A39 C6 10            add  a, 16
 177+ 7A3B FE 19            cp   25
 178+ 7A3D D0               ret  nc                 ; Fuori portata X
 179+ 7A3E
 180+ 7A3E                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7A3E 3A AD 91         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7A41 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7A42 C6 0F            add  a, 15
 184+ 7A44 FE 1F            cp   31
 185+ 7A46 D0               ret  nc                 ; Fuori portata Y
 186+ 7A47
 187+ 7A47                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7A47 3E 01            ld   a, 1
 189+ 7A49 32 B2 91         ld   (willy_needs_redraw), a
 190+ 7A4C C9               ret

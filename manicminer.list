 257+ 7E97                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 258+ 7E97 78               ld   a, b
 259+ 7E98 E6 18            and  $18
 260+ 7E9A C6 40            add  a, $40

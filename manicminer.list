 386+ 7BA9              ; Enemy_Update
 387+ 7BA9              ;
 388+ 7BA9              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7BA9              ; -------------------------------------------------------------------
 390+ 7BA9              Enemy_Update:
 391+ 7BA9                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7BA9 3A E7 91         ld   a, (enemy_update_rate)
 393+ 7BAC FE 01            cp   1
 394+ 7BAE 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7BB0
 396+ 7BB0 21 E8 91         ld   hl, enemy_update_timer
 397+ 7BB3 34               inc  (hl)
 398+ 7BB4 7E               ld   a, (hl)
 399+ 7BB5 21 E7 91         ld   hl, enemy_update_rate
 400+ 7BB8 BE               cp   (hl)
 401+ 7BB9 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7BBA AF               xor  a
 403+ 7BBB 32 E8 91         ld   (enemy_update_timer), a

 315+ 7B63              ; -------------------------------------------------------------------
 316+ 7B63              ; Enemy_DrawSingleSlot
 317+ 7B63              ;
 318+ 7B63              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7B63              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7B63              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7B63              ; -------------------------------------------------------------------
 322+ 7B63              Enemy_DrawSingleSlot:
 323+ 7B63 C5               push bc
 324+ 7B64 D5               push de
 325+ 7B65 E5               push hl
 326+ 7B66 DD E5            push ix
 327+ 7B68
 328+ 7B68                  ; 1. Determina il frame di animazione (0..7)
 329+ 7B68                  ; Nei dati di Manic Miner:
 330+ 7B68                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7B68                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7B68 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7B6B E6 03            and  3
 334+ 7B6D 47               ld   b, a                      ; B = Anim subframe
 335+ 7B6E
 336+ 7B6E DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7B71 FE 01            cp   1                         ; Sinistra?
 338+ 7B73 28 03            jr   z, .left_frames
 339+ 7B75
 340+ 7B75                  ; Movimento a Destra: Frame 0..3
 341+ 7B75 78               ld   a, b
 342+ 7B76 18 03            jr   .got_frame_idx
 343+ 7B78
 344+ 7B78              .left_frames:
 345+ 7B78                  ; Movimento a Sinistra: Frame 4..7
 346+ 7B78 3E 04            ld   a, 4
 347+ 7B7A 80               add  a, b
 348+ 7B7B
 349+ 7B7B              .got_frame_idx:
 350+ 7B7B                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7B7B 6F               ld   l, a
 352+ 7B7C 26 00            ld   h, 0
 353+ 7B7E 29               add  hl, hl                    ; *2
 354+ 7B7F 29               add  hl, hl                    ; *4
 355+ 7B80 29               add  hl, hl                    ; *8
 356+ 7B81 29               add  hl, hl                    ; *16
 357+ 7B82 29               add  hl, hl                    ; *32
 358+ 7B83
 359+ 7B83 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7B86 19               add  hl, de
 361+ 7B87 ED 5B 2D 96      ld   de, (room_ptr)
 362+ 7B8B 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7B8C E5               push hl
 364+ 7B8D DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7B8F
 366+ 7B8F                  ; 2. Coordinate e colore
 367+ 7B8F FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7B91 FD E5            push iy
 369+ 7B93
 370+ 7B93 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7B96 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7B99 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7B9C
 374+ 7B9C                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7B9C CD 38 5F         call Gfx_DrawPixelSprite16x16
 376+ 7B9F FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7BA2 CD 38 6A         call Gfx_SetEnemyColorAttributes
 378+ 7BA5
 379+ 7BA5 DD E1            pop  ix
 380+ 7BA7 E1               pop  hl
 381+ 7BA8 D1               pop  de
 382+ 7BA9 C1               pop  bc
 383+ 7BAA C9               ret

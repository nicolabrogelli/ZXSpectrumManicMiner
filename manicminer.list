 408+ 81D9              ; CheckWillyItemCollision
 409+ 81D9              ;
 410+ 81D9              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81D9              ; Input:
 412+ 81D9              ;   A = Item Col (0..31)
 413+ 81D9              ;   H = Item Row (0..15)
 414+ 81D9              ; Output:
 415+ 81D9              ;   Carry Set = Collisione
 416+ 81D9              ;   Carry Clear = Nessuna collisione
 417+ 81D9              ; -------------------------------------------------------------------
 418+ 81D9              CheckWillyItemCollision:
 419+ 81D9 C5               push bc
 420+ 81DA D5               push de
 421+ 81DB E5               push hl
 422+ 81DC
 423+ 81DC                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 81DC 6F               ld   l, a
 425+ 81DD 87               add  a, a                      ; *2
 426+ 81DE 87               add  a, a                      ; *4
 427+ 81DF 87               add  a, a                      ; *8
 428+ 81E0 5F               ld   e, a                      ; E = ItemLeft
 429+ 81E1 C6 07            add  a, 7
 430+ 81E3 57               ld   d, a                      ; D = ItemRight
 431+ 81E4
 432+ 81E4 ED 4B 4E 9E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81E8
 434+ 81E8                  ; WillyLeft <= ItemRight
 435+ 81E8 79               ld   a, c                      ; A = WillyX
 436+ 81E9 BA               cp   d                         ; D = ItemRight
 437+ 81EA 28 04            jr   z, .x_ok
 438+ 81EC 38 02            jr   c, .x_ok
 439+ 81EE 18 31            jr   .no_collision
 440+ 81F0
 441+ 81F0              .x_ok:
 442+ 81F0                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81F0 BB               cp   e                         ; E = ItemLeft
 444+ 81F1 28 0B            jr   z, .y_check
 445+ 81F3 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81F5
 447+ 81F5                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81F5 C6 0F            add  a, 15
 449+ 81F7 BB               cp   e
 450+ 81F8 28 04            jr   z, .y_check
 451+ 81FA 30 02            jr   nc, .y_check
 452+ 81FC 18 23            jr   .no_collision
 453+ 81FE
 454+ 81FE              .y_check:
 455+ 81FE                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81FE 7C               ld   a, h                      ; H = Item Row
 457+ 81FF 87               add  a, a                      ; *2
 458+ 8200 87               add  a, a                      ; *4
 459+ 8201 87               add  a, a                      ; *8

 293+ 8585              ; DrawItemGraphic
 294+ 8585              ;
 295+ 8585              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 8585              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 8585              ;
 298+ 8585              ; Input:
 299+ 8585              ;   B = Riga attributi (0..23)
 300+ 8585              ;   C = Colonna attributi (0..31)
 301+ 8585              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 8585              ;   E = Attributo colore
 303+ 8585              ; -------------------------------------------------------------------
 304+ 8585              DrawItemGraphic:

 330+ 6FB4              ; LoadPositionPlayeinRoom
 331+ 6FB4              ;
 332+ 6FB4              ; Inizializza la posizione del player (Willy) quando entra
 333+ 6FB4              ; in una nuova stanza.
 334+ 6FB4              ;
 335+ 6FB4              ; La posizione viene letta direttamente dai dati della stanza
 336+ 6FB4              ; (layout/metadata) a partire da room_ptr.
 337+ 6FB4              ;
 338+ 6FB4              ; Output:
 339+ 6FB4              ;   PlayerPos     = posizione iniziale (Y, X)
 340+ 6FB4              ;   PlayerPosOld  = copia della posizione iniziale
 341+ 6FB4              ;
 342+ 6FB4              ; Struttura dati stanza:
 343+ 6FB4              ;   OFFSET_POS_WILLY:
 344+ 6FB4              ;       +0 = X
 345+ 6FB4              ;       +1 = Y
 346+ 6FB4              ; -------------------------------------------------------------------
 347+ 6FB4              LoadPositionPlayeinRoom:
 348+ 6FB4                  ; ---------------------------------------------------------------
 349+ 6FB4                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 350+ 6FB4                  ; ---------------------------------------------------------------
 351+ 6FB4 2A 9E E5         ld   hl, (room_ptr)
 352+ 6FB7 11 68 02         ld   de, OFFSET_POS_WILLY
 353+ 6FBA 19               add  hl, de
 354+ 6FBB
 355+ 6FBB                  ; Byte 0: Y * 2
 356+ 6FBB 7E               ld   a, (hl)
 357+ 6FBC CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 358+ 6FBE 57               ld   d, a                      ; D = PlayerY
 359+ 6FBF
 360+ 6FBF                  ; Byte 1: Anim frame
 361+ 6FBF 23               inc  hl
 362+ 6FC0 7E               ld   a, (hl)
 363+ 6FC1 E6 03            and  3                         ; Garanzia valore valido (0..3)
 364+ 6FC3 FE 03            cp   3
 365+ 6FC5 38 01            jr   c, .valid_anim
 366+ 6FC7 AF               xor  a
 367+ 6FC8              .valid_anim:
 368+ 6FC8 32 23 E2         ld   (body_state), a
 369+ 6FCB 32 26 E6         ld   (player_old_body), a
 370+ 6FCE
 371+ 6FCE                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 372+ 6FCE 23               inc  hl                        ; Byte 2 (Direction)
 373+ 6FCF 7E               ld   a, (hl)
 374+ 6FD0 E6 01            and  1
 375+ 6FD2 28 04            jr   z, .facing_right
 376+ 6FD4 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 377+ 6FD6 18 02            jr   .set_dir
 378+ 6FD8              .facing_right:
 379+ 6FD8 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 380+ 6FDA              .set_dir:
 381+ 6FDA 32 24 E2         ld   (direction), a
 382+ 6FDD 32 25 E6         ld   (player_old_dir), a
 383+ 6FE0
 384+ 6FE0                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 385+ 6FE0 23               inc  hl                        ; Byte 3 (Airborne)
 386+ 6FE1 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 387+ 6FE2 4E               ld   c, (hl)
 388+ 6FE3 23               inc  hl                        ; Byte 5 (AttrAddr High)
 389+ 6FE4 7E               ld   a, (hl)
 390+ 6FE5
 391+ 6FE5                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 392+ 6FE5 67               ld   h, a
 393+ 6FE6 69               ld   l, c
 394+ 6FE7 01 00 A4         ld   bc, -23552
 395+ 6FEA 09               add  hl, bc
 396+ 6FEB
 397+ 6FEB 7D               ld   a, l
 398+ 6FEC E6 1F            and  31
 399+ 6FEE 87               add  a, a                      ; *2
 400+ 6FEF 87               add  a, a                      ; *4
 401+ 6FF0 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 402+ 6FF1 4F               ld   c, a                      ; C = PlayerX
 403+ 6FF2 42               ld   b, d                      ; B = PlayerY
 404+ 6FF3
 405+ 6FF3                  ; Salva coordinate (C = X, B = Y)
 406+ 6FF3 ED 43 1D E2      ld   (PlayerPos), bc
 407+ 6FF7 ED 43 1F E2      ld   (PlayerPosOld), bc
 408+ 6FFB
 409+ 6FFB                  ; Reset completi di stato player e rendering
 410+ 6FFB AF               xor  a
 411+ 6FFC 32 28 E2         ld   (sprite_shift), a
 412+ 6FFF 32 26 E2         ld   (collision_active), a
 413+ 7002 32 2A E6         ld   (willy_needs_redraw), a
 414+ 7005 32 33 E2         ld   (current_input_dir), a
 415+ 7008 32 48 E5         ld   (conveyor_caught), a
 416+ 700B 3E FF            ld   a, $FF
 417+ 700D 32 23 E6         ld   (player_drawn_pos), a
 418+ 7010 32 24 E6         ld   (player_drawn_pos+1), a
 419+ 7013 C9               ret

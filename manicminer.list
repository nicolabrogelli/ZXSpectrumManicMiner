 558+ 6003 23               inc  hl
 559+ 6004 7B               ld   a, e
 560+ 6005 C6 10            add  a, 16
 561+ 6007 CD 76 5E         call Gfx_GetBackgroundByte
 562+ 600A 77               ld   (hl), a
 563+ 600B 2B               dec  hl
 564+ 600C 2B               dec  hl
 565+ 600D
 566+ 600D CD 30 5E         call Gfx_IncScreenLine
 567+ 6010 14               inc  d
 568+ 6011 0D               dec  c
 569+ 6012 20 E2            jr   nz, .erase_loop_3
 570+ 6014
 571+ 6014 E1               pop  hl
 572+ 6015 D1               pop  de
 573+ 6016 C1               pop  bc
 574+ 6017 C9               ret

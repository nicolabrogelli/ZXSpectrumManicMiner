1576+ 65FC              ; -------------------------------------------------------------------
1577+ 65FC              ; Gfx_DrawSprite16x16_Overwrite
1578+ 65FC              ; Disegna uno sprite 16x16 in modalita sovrascrittura (overwrite)
1579+ 65FC              ; a una coordinata allineata al byte (2 byte per scanline).
1580+ 65FC              ; Input:
1581+ 65FC              ;   DE = Puntatore ai dati dello sprite (32 byte)
1582+ 65FC              ;   HL = Indirizzo video iniziale scanline 0
1583+ 65FC              ; -------------------------------------------------------------------
1584+ 65FC              Gfx_DrawSprite16x16_Overwrite:
1585+ 65FC C5               push bc
1586+ 65FD D5               push de
1587+ 65FE E5               push hl
1588+ 65FF 06 10            ld   b, 16                 ; 16 scanline
1589+ 6601              .scanline_loop:
1590+ 6601 1A               ld   a, (de)
1591+ 6602 77               ld   (hl), a
1592+ 6603 13               inc  de
1593+ 6604 23               inc  hl
1594+ 6605 1A               ld   a, (de)
1595+ 6606 77               ld   (hl), a
1596+ 6607 13               inc  de
1597+ 6608 2B               dec  hl
1598+ 6609 CD 30 5E         call Gfx_IncScreenLine
1599+ 660C 10 F3            djnz .scanline_loop
1600+ 660E E1               pop  hl
1601+ 660F D1               pop  de
1602+ 6610 C1               pop  bc
1603+ 6611 C9               ret
1604+ 6612
1605+ 6612              ; -------------------------------------------------------------------
1606+ 6612              ; Gfx_DrawGameOverScreen
1607+ 6612              ; Esegue la sequenza originale di Game Over di Manic Miner:
1608+ 6612              ; 1. Pulisce i primi due terzi dello schermo (righe 0..15, $4000..$4FFF, 4096B)
1609+ 6612              ;    e imposta gli attributi iniziali a Bright 1, Paper 0 (Nero), Ink 7 (Bianco) ($5800..$59FF, 512B).
1610+ 6612              ;    Il terzo inferiore dello schermo (righe 16..23) rimane visibile come nell'originale.
1611+ 6612              ; 2. Disegna Willy immobile sul piedistallo a riga 12, colonna 15 (indirizzo $488F, X=120, Y=96).
1612+ 6612              ; 3. Disegna il Piedistallo (Plinth) sotto Willy a riga 14, colonna 15 (indirizzo $48CF, X=120, Y=112).
1613+ 6612              ; 4. Ciclo di discesa del Piede (Boot):
1614+ 6612              ;    - Distance varia da 0 a $C4 (196) con passo 4 (Y = 0, 2, 4, ... 98).
1615+ 6612              ;    - Disegna il Piede (PiedeSprite) a (X=120, Y=Distance/2) sovrascrivendo senza cancellare la parte superiore,
1616+ 6612              ;      creando il celebre effetto della gamba che si allunga verso il basso e schiaccia Willy!
1617+ 6612              ;    - Effetto sonoro beeper a frequenza crescente (pitch delay = 255 - distance, 64 impulsi).
1618+ 6612              ;    - Lampeggio degli attributi dei primi due terzi (Paper cicla tra Nero, Blu, Rosso, Magenta con Bright 1 e Ink 7).
1619+ 6612              ; 5. Stampa la scritta "Game" a riga 6, colonna 10 e "Over" a riga 6, colonna 18 (ai lati della gamba).
1620+ 6612              ; 6. Animazione ciclica arcobaleno (glistening) delle lettere di "Game" e "Over" per ~1.5 secondi.
1621+ 6612              ; -------------------------------------------------------------------
1622+ 6612              Gfx_DrawGameOverScreen:
1623+ 6612 F5               push af
1624+ 6613 C5               push bc
1625+ 6614 D5               push de
1626+ 6615 E5               push hl
1627+ 6616 DD E5            push ix
1628+ 6618
1629+ 6618 F3               di                         ; Disabilita interrupt durante l'effetto sonoro beeper
1630+ 6619
1631+ 6619                  ; 1. Bordo a nero
1632+ 6619 AF               xor  a
1633+ 661A D3 FE            out  ($fe), a
1634+ 661C
1635+ 661C                  ; 2. Pulisce i primi due terzi dello schermo display file ($4000..$4FFF, 4096 byte)
1636+ 661C 21 00 40         ld   hl, SCREEN_MEMORY
1637+ 661F 11 01 40         ld   de, SCREEN_MEMORY + 1
1638+ 6622 01 FF 0F         ld   bc, $0fff
1639+ 6625 36 00            ld   (hl), 0
1640+ 6627 ED B0            ldir
1641+ 6629
1642+ 6629                  ; 3. Imposta gli attributi dei primi due terzi a Bright 1, Ink 7, Paper 0 ($47) ($5800..$59FF, 512 byte)
1643+ 6629 21 00 58         ld   hl, COLOR_DATA
1644+ 662C 11 01 58         ld   de, COLOR_DATA + 1
1645+ 662F 01 FF 01         ld   bc, $01ff
1646+ 6632 36 47            ld   (hl), $47
1647+ 6634 ED B0            ldir
1648+ 6636
1649+ 6636                  ; 4. Disegna Willy a riga 12, colonna 15 (indirizzo $488F, Y=96, X=120)
1650+ 6636 21 8F 48         ld   hl, $488f
1651+ 6639 11 99 6E         ld   de, WillyGameOverSprite
1652+ 663C CD FC 65         call Gfx_DrawSprite16x16_Overwrite
1653+ 663F
1654+ 663F                  ; 5. Disegna il Piedistallo a riga 14, colonna 15 (indirizzo $48CF, Y=112, X=120)
1655+ 663F 21 CF 48         ld   hl, $48cf
1656+ 6642 11 79 6E         ld   de, PlinthSprite
1657+ 6645 CD FC 65         call Gfx_DrawSprite16x16_Overwrite
1658+ 6648
1659+ 6648                  ; 6. Animazione di discesa del Piede con audio e lampeggio attributi
1660+ 6648 AF               xor  a
1661+ 6649 32 FD F0         ld   (game_over_distance), a
1662+ 664C
1663+ 664C              .boot_descent_loop:
1664+ 664C                  ; 6a. Calcola indirizzo schermo per (X=120, Y = distance / 2)
1665+ 664C 3A FD F0         ld   a, (game_over_distance)
1666+ 664F CB 3F            srl  a                     ; A = Y (0..98)
1667+ 6651 67               ld   h, a                  ; H = Y
1668+ 6652 2E 78            ld   l, 120                ; L = X = 120
1669+ 6654 CD 10 5E         call Gfx_GetScreenAddr     ; HL = indirizzo schermo
1670+ 6657
1671+ 6657                  ; 6b. Disegna PiedeSprite in modalita overwrite (lascia indietro la striscia dei pantaloni)
1672+ 6657 11 59 6E         ld   de, PiedeSprite
1673+ 665A CD FC 65         call Gfx_DrawSprite16x16_Overwrite
1674+ 665D
1675+ 665D                  ; 6c. Effetto sonoro beeper a frequenza crescente
1676+ 665D 3A FD F0         ld   a, (game_over_distance)
1677+ 6660 2F               cpl                        ; A = 255 - distance (determina il pitch)
1678+ 6661 5F               ld   e, a                  ; E = pitch delay
1679+ 6662 AF               xor  a
1680+ 6663 01 40 00         ld   bc, $0040             ; C = 64 impulsi (durata della nota)
1681+ 6666              .sound_pulse_loop:
1682+ 6666 D3 FE            out  ($fe), a
1683+ 6668 EE 18            xor  $18                   ; Toggle speaker ($10) e mic/border ($08)
1684+ 666A 43               ld   b, e
1685+ 666B              .pitch_delay_loop:
1686+ 666B 10 FE            djnz .pitch_delay_loop
1687+ 666D 0D               dec  c
1688+ 666E 20 F6            jr   nz, .sound_pulse_loop
1689+ 6670
1690+ 6670                  ; 6d. Ciclo colori attributi sui primi due terzi ($5800..$59FF, 512 byte)
1691+ 6670 21 00 58         ld   hl, COLOR_DATA
1692+ 6673 11 01 58         ld   de, COLOR_DATA + 1
1693+ 6676 01 FF 01         ld   bc, $01ff
1694+ 6679 3A FD F0         ld   a, (game_over_distance)
1695+ 667C E6 0C            and  $0c                   ; bit 2 e 3
1696+ 667E 07               rlca                       ; sposta nei bit 3 e 4 (Paper 0..3: Nero, Blu, Rosso, Magenta)
1697+ 667F F6 47            or   $47                   ; Bright 1, Ink 7 (Bianco)
1698+ 6681 77               ld   (hl), a
1699+ 6682 ED B0            ldir
1700+ 6684
1701+ 6684                  ; 6e. Avanza distance di 4 (scende di 2 pixel)
1702+ 6684 3A FD F0         ld   a, (game_over_distance)
1703+ 6687 C6 04            add  a, 4
1704+ 6689 32 FD F0         ld   (game_over_distance), a
1705+ 668C FE C4            cp   $c4                   ; Si ferma a $C4 (196 -> Y=98, quando tocca il piedistallo)
1706+ 668E 20 BC            jr   nz, .boot_descent_loop
1707+ 6690
1708+ 6690                  ; 7. Stampa "Game" e "Over" ai lati della gamba a riga 6
1709+ 6690 21 B8 65         ld   hl, game_over_game_str
1710+ 6693 06 04            ld   b, 4
1711+ 6695 16 06            ld   d, 6
1712+ 6697 1E 0A            ld   e, 10
1713+ 6699 CD 41 62         call Gfx_PrintDirectText
1714+ 669C
1715+ 669C 21 BC 65         ld   hl, game_over_over_str
1716+ 669F 06 04            ld   b, 4

 414+ 847B              ; CheckWillyItemCollision
 415+ 847B              ;
 416+ 847B              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 847B              ; Input:
 418+ 847B              ;   A = Item Col (0..31)
 419+ 847B              ;   H = Item Row (0..15)
 420+ 847B              ; Output:
 421+ 847B              ;   Carry Set = Collisione
 422+ 847B              ;   Carry Clear = Nessuna collisione
 423+ 847B              ; -------------------------------------------------------------------
 424+ 847B              CheckWillyItemCollision:
 425+ 847B C5               push bc
 426+ 847C D5               push de
 427+ 847D E5               push hl
 428+ 847E
 429+ 847E                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

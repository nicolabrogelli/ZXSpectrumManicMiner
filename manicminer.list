 105+ 7D8B              ; -------------------------------------------------------------------
 106+ 7D8B              ; Items_DrawRoom
 107+ 7D8B              ;
 108+ 7D8B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 109+ 7D8B              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 110+ 7D8B              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 111+ 7D8B              ;
 112+ 7D8B              ; Record item nella stanza (5 byte):
 113+ 7D8B              ;   +0 Color / Attributo
 114+ 7D8B              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 115+ 7D8B              ;   +2 Attr Address High
 116+ 7D8B              ;   +3 Anim Mask (96)

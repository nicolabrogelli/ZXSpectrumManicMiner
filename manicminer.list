 540  86BF                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  86BF              .wait_keys_release:
 542  86BF 76               halt
 543  86C0                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  86C0 01 FE DF         ld   bc, $dffe
 545  86C3 ED 78            in   a, (c)
 546  86C5 CB 67            bit  4, a
 547  86C7 28 F6            jr   z, .wait_keys_release
 548  86C9
 549  86C9                  ; Controlla tasto N (Porta $7F, bit 3)

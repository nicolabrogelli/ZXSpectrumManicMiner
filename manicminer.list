 197+ 8216 20 FD            jr   nz, .d1
 198+ 8218
 199+ 8218 3A E3 94         ld   a, (room_border_color)
 200+ 821B E6 EF            and  $ef              ; speaker OFF
 201+ 821D D3 FE            out  ($fe), a
 202+ 821F
 203+ 821F 0E 3C            ld   c, 60
 204+ 8221              .d2:
 205+ 8221 0D               dec  c
 206+ 8222 20 FD            jr   nz, .d2
 207+ 8224

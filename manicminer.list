 457+ 7025 01 00 A4         ld   bc, -23552
 458+ 7028 09               add  hl, bc
 459+ 7029 7D               ld   a, l
 460+ 702A E6 1F            and  31
 461+ 702C 87               add  a, a
 462+ 702D 87               add  a, a
 463+ 702E 87               add  a, a                      ; Col * 8 = Pixel X
 464+ 702F 4F               ld   c, a                      ; C = PlayerX
 465+ 7030 F1               pop  af                        ; A = PlayerY
 466+ 7031 47               ld   b, a                      ; B = PlayerY
 467+ 7032
 468+ 7032 E1               pop  hl                        ; Ripristina puntatore RoomsListTable
 469+ 7033 D1               pop  de                        ; DE = room_entry_positions + (i * 2)
 470+ 7034 79               ld   a, c

  14+ 7C1A              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7C1A              ; Offset 2: Current X
  16+ 7C1A              ; Offset 3: Current Y
  17+ 7C1A              ; Offset 4: Min Limit
  18+ 7C1A              ; Offset 5: Max Limit
  19+ 7C1A              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7C1A              ; Offset 7: Anim State (0..3)
  21+ 7C1A              ; Offset 8: Old X
  22+ 7C1A              ; Offset 9: Old Y
  23+ 7C1A              ; Offset 10: Color (Attributo Spectrum)
  24+ 7C1A              ; -------------------------------------------------------------------

 534  85E8              ; -------------------------------------------------------------------
 535  85E8              ; TriggerVictory
 536  85E8              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 537  85E8              ; - Pulisce gli elementi di gioco della stanza.
 538  85E8              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 539  85E8              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 540  85E8              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 541  85E8              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 542  85E8              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 543  85E8              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 544  85E8              ; -------------------------------------------------------------------
 545  85E8              TriggerVictory:
 546  85E8                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 547  85E8 CD F7 66         call Gfx_DrawVictoryScreen
 548  85EB
 549  85EB                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 550  85EB              .wait_keys_release:
 551  85EB 76               halt
 552  85EC                  ; Controlla tasto Y (Porta $DF, bit 4)
 553  85EC 01 FE DF         ld   bc, $dffe
 554  85EF ED 78            in   a, (c)
 555  85F1 CB 67            bit  4, a
 556  85F3 28 F6            jr   z, .wait_keys_release
 557  85F5
 558  85F5                  ; Controlla tasto N (Porta $7F, bit 3)
 559  85F5 01 FE 7F         ld   bc, $7ffe
 560  85F8 ED 78            in   a, (c)
 561  85FA CB 5F            bit  3, a
 562  85FC 28 ED            jr   z, .wait_keys_release
 563  85FE
 564  85FE                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 565  85FE 01 FE BF         ld   bc, $bffe
 566  8601 ED 78            in   a, (c)
 567  8603 CB 47            bit  0, a
 568  8605 28 E4            jr   z, .wait_keys_release
 569  8607
 570  8607                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 571  8607 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 572  8609              .wait_choice_loop:
 573  8609 76               halt
 574  860A
 575  860A                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 576  860A 0C               inc  c
 577  860B 79               ld   a, c
 578  860C CB 3F            srl  a
 579  860E CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 580  8610 E6 07            and  7
 581  8612 5F               ld   e, a
 582  8613 16 00            ld   d, 0
 583  8615 21 D6 65         ld   hl, victory_color_table
 584  8618 19               add  hl, de
 585  8619 7E               ld   a, (hl)               ; A = nuovo colore attributo
 586  861A 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 587  861D 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 588  861F              .color_cycle_loop:
 589  861F 77               ld   (hl), a

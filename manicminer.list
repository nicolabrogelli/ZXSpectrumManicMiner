 430+ 7F66 C2 B0 7F         jp   nz, .vertical
 431+ 7F69
 432+ 7F69              .horizontal:
 433+ 7F69 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7F6C FE 01            cp   1
 435+ 7F6E 20 20            jr   nz, .horiz_right
 436+ 7F70
 437+ 7F70              .horiz_left:

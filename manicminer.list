 195+ 7E5A                  ; Aggiorna items_grid: offset = Row * 32 + Col
 196+ 7E5A D5               push de
 197+ 7E5B 26 00            ld   h, 0
 198+ 7E5D 68               ld   l, b                      ; HL = Row
 199+ 7E5E 29               add  hl, hl
 200+ 7E5F 29               add  hl, hl
 201+ 7E60 29               add  hl, hl
 202+ 7E61 29               add  hl, hl
 203+ 7E62 29               add  hl, hl                    ; Row * 32
 204+ 7E63 59               ld   e, c
 205+ 7E64 16 00            ld   d, 0
 206+ 7E66 19               add  hl, de                    ; Row * 32 + Col
 207+ 7E67 11 71 8D         ld   de, items_grid

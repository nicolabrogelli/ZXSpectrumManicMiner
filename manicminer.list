2205+ 6936 0F               rrca
2206+ 6937 0F               rrca
2207+ 6938 0F               rrca
2208+ 6939 E6 0F            and  $0f
2209+ 693B C6 30            add  a, '0'
2210+ 693D 77               ld   (hl), a
2211+ 693E 23               inc  hl
2212+ 693F
2213+ 693F                  ; Cifra 3 (centinaia)
2214+ 693F DD 7E 01         ld   a, (ix+1)
2215+ 6942 E6 0F            and  $0f
2216+ 6944 C6 30            add  a, '0'
2217+ 6946 77               ld   (hl), a
2218+ 6947 23               inc  hl
2219+ 6948
2220+ 6948                  ; Cifra 4 (decine)

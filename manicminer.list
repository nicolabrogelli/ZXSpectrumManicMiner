 265+ 7D3F 87               add  a, a                      ; *2
 266+ 7D40 87               add  a, a                      ; *4
 267+ 7D41 87               add  a, a                      ; *8
 268+ 7D42 87               add  a, a                      ; *16
 269+ 7D43 87               add  a, a                      ; *32
 270+ 7D44 81               add  a, c                      ; + Col
 271+ 7D45 5F               ld   e, a                      ; Byte basso indirizzo video
 272+ 7D46
 273+ 7D46 C5               push bc
 274+ 7D47 06 08            ld   b, 8                      ; 8 scanline
 275+ 7D49              .line_loop:
 276+ 7D49 7E               ld   a, (hl)
 277+ 7D4A 12               ld   (de), a
 278+ 7D4B 14               inc  d
 279+ 7D4C 23               inc  hl
 280+ 7D4D 05               dec  b
 281+ 7D4E 20 F9            jr   nz, .line_loop
 282+ 7D50 C1               pop  bc
 283+ 7D51
 284+ 7D51                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 285+ 7D51 26 00            ld   h, 0

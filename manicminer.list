 163+ 7D3B 32 F8 E5         ld   (room_has_v_guardians), a
 164+ 7D3E 18 06            jr   .has_v_guardians
 165+ 7D40
 166+ 7D40              .no_v_guardians:
 167+ 7D40 AF               xor  a

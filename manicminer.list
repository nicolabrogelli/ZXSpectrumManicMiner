 541+ 82AF 29             add hl, hl
 541+ 82B0 29             add hl, hl
 541+ 82B1 29             add hl, hl
 542+ 82B2 59               ld   e, c
 543+ 82B3 16 00            ld   d, 0
 544+ 82B5 19               add  hl, de

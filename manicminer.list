 530  8368              ; TriggerVictory
 531  8368              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 532  8368              ; - Pulisce gli elementi di gioco della stanza.
 533  8368              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 534  8368              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 535  8368              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 536  8368              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 537  8368              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 538  8368              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 539  8368              ; -------------------------------------------------------------------
 540  8368              TriggerVictory:
 541  8368                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 542  8368 CD BB 65         call Gfx_DrawVictoryScreen
 543  836B
 544  836B                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 545  836B              .wait_keys_release:
 546  836B 76               halt
 547  836C                  ; Controlla tasto Y (Porta $DF, bit 4)
 548  836C 01 FE DF         ld   bc, $dffe
 549  836F ED 78            in   a, (c)
 550  8371 CB 67            bit  4, a
 551  8373 28 F6            jr   z, .wait_keys_release
 552  8375
 553  8375                  ; Controlla tasto N (Porta $7F, bit 3)
 554  8375 01 FE 7F         ld   bc, $7ffe
 555  8378 ED 78            in   a, (c)
 556  837A CB 5F            bit  3, a
 557  837C 28 ED            jr   z, .wait_keys_release
 558  837E
 559  837E                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 560  837E 01 FE BF         ld   bc, $bffe
 561  8381 ED 78            in   a, (c)
 562  8383 CB 47            bit  0, a
 563  8385 28 E4            jr   z, .wait_keys_release
 564  8387
 565  8387                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 566  8387 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 567  8389              .wait_choice_loop:
 568  8389 76               halt
 569  838A
 570  838A                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 571  838A 0C               inc  c
 572  838B 79               ld   a, c
 573  838C CB 3F            srl  a
 574  838E CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 575  8390 E6 07            and  7
 576  8392 5F               ld   e, a
 577  8393 16 00            ld   d, 0
 578  8395 21 9A 64         ld   hl, victory_color_table
 579  8398 19               add  hl, de
 580  8399 7E               ld   a, (hl)               ; A = nuovo colore attributo
 581  839A 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 582  839D 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 583  839F              .color_cycle_loop:
 584  839F 77               ld   (hl), a
 585  83A0 23               inc  hl
 586  83A1 10 FC            djnz .color_cycle_loop
 587  83A3
 588  83A3                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 589  83A3 01 FE DF         ld   bc, $dffe
 590  83A6 ED 78            in   a, (c)
 591  83A8 CB 67            bit  4, a
 592  83AA 28 2A            jr   z, .play_again_chosen
 593  83AC
 594  83AC                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 595  83AC 01 FE 7F         ld   bc, $7ffe
 596  83AF ED 78            in   a, (c)
 597  83B1 CB 5F            bit  3, a
 598  83B3 28 0B            jr   z, .quit_chosen
 599  83B5
 600  83B5                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 601  83B5 01 FE BF         ld   bc, $bffe
 602  83B8 ED 78            in   a, (c)
 603  83BA CB 47            bit  0, a
 604  83BC 28 02            jr   z, .quit_chosen
 605  83BE
 606  83BE 18 C9            jr   .wait_choice_loop
 607  83C0
 608  83C0              .quit_chosen:
 609  83C0                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 610  83C0              .wait_quit_release:
 611  83C0 76               halt
 612  83C1 01 FE 7F         ld   bc, $7ffe
 613  83C4 ED 78            in   a, (c)
 614  83C6 CB 5F            bit  3, a
 615  83C8 28 F6            jr   z, .wait_quit_release
 616  83CA 01 FE BF         ld   bc, $bffe
 617  83CD ED 78            in   a, (c)
 618  83CF CB 47            bit  0, a
 619  83D1 28 ED            jr   z, .wait_quit_release
 620  83D3
 621  83D3                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 622  83D3 C3 26 82         jp   ShowTitleScreen
 623  83D6
 624  83D6              .play_again_chosen:
 625  83D6                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 626  83D6              .wait_play_again_release:
 627  83D6 76               halt
 628  83D7 01 FE DF         ld   bc, $dffe
 629  83DA ED 78            in   a, (c)
 630  83DC CB 67            bit  4, a
 631  83DE 28 F6            jr   z, .wait_play_again_release
 632  83E0
 633  83E0                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 634  83E0 CD E4 84         call ResetFullGameState
 635  83E3 C3 00 81         jp   LoadRoomAndRestart
 636  83E6
 637  83E6              ; -------------------------------------------------------------------
 638  83E6              ; CheckPortalTransition
 639  83E6              ; Verifica le condizioni per accedere alla stanza successiva:
 640  83E6              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 641  83E6              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 642  83E6              ;
 643  83E6              ; Output:
 644  83E6              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 645  83E6              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 646  83E6              ; -------------------------------------------------------------------
 647  83E6              CheckPortalTransition:
 648  83E6 C5               push bc
 649  83E7 D5               push de
 650  83E8 E5               push hl
 651  83E9
 652  83E9                  ; 1. Tutti gli item della stanza sono stati raccolti?
 653  83E9 CD 77 84         call CheckAllItemsCollected
 654  83EC 30 4D            jr   nc, .no_transition
 655  83EE
 656  83EE                  ; 2. Willy collide con il portale (16x16 pixel)?
 657  83EE                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 658  83EE                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 659  83EE 2A 09 97         ld   hl, (room_ptr)
 660  83F1 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 661  83F4 19               add  hl, de
 662  83F5 4E               ld   c, (hl)
 663  83F6 23               inc  hl
 664  83F7 46               ld   b, (hl)                   ; BC = AttrAddr
 665  83F8
 666  83F8                  ; Offset = BC - 23552
 667  83F8 60               ld   h, b
 668  83F9 69               ld   l, c
 669  83FA 01 00 A4         ld   bc, -23552
 670  83FD 09               add  hl, bc
 671  83FE
 672  83FE                  ; PortalX = (Offset & 31) * 8
 673  83FE 7D               ld   a, l
 674  83FF E6 1F            and  31
 675  8401 87               add  a, a
 675  8402 87             add a, a
 675  8403 87             add a, a
 676  8404 5F               ld   e, a                      ; E = PortalX (0..248)
 677  8405
 678  8405                  ; PortalY = (Offset / 32) * 8
 679  8405 CB 3C            srl  h
 679  8407 CB 1D          rr l
 680  8409 CB 3C            srl  h
 680  840B CB 1D          rr l
 681  840D CB 3C            srl  h
 681  840F CB 1D          rr l
 682  8411 CB 3C            srl  h
 682  8413 CB 1D          rr l
 683  8415 CB 3C            srl  h
 683  8417 CB 1D          rr l
 684  8419 7D               ld   a, l
 685  841A 87               add  a, a
 685  841B 87             add a, a
 685  841C 87             add a, a
 686  841D 57               ld   d, a                      ; D = PortalY (0..120)
 687  841E
 688  841E                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 689  841E ED 4B 89 93      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 690  8422
 691  8422                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 692  8422 7B               ld   a, e
 693  8423 91               sub  c
 694  8424 30 02            jr   nc, .x_diff_pos
 695  8426 ED 44            neg
 696  8428              .x_diff_pos:
 697  8428 FE 0C            cp   12
 698  842A 30 0F            jr   nc, .no_transition
 699  842C
 700  842C                  ; Controllo verticale: |WillyY - PortalY| < 14
 701  842C 7A               ld   a, d
 702  842D 90               sub  b
 703  842E 30 02            jr   nc, .y_diff_pos
 704  8430 ED 44            neg
 705  8432              .y_diff_pos:
 706  8432 FE 0E            cp   14
 707  8434 30 05            jr   nc, .no_transition
 708  8436
 709  8436                  ; Transizione al portale attiva!
 710  8436 E1               pop  hl
 711  8437 D1               pop  de
 712  8438 C1               pop  bc
 713  8439 37               scf
 714  843A C9               ret
 715  843B
 716  843B              .no_transition:
 717  843B E1               pop  hl
 718  843C D1               pop  de
 719  843D C1               pop  bc
 720  843E B7               or   a
 721  843F C9               ret
 722  8440
 723  8440              ; Alias per retrocompatibilità
 724  8440              CheckVictoryCondition: EQU CheckPortalTransition
 725  8440
 726  8440              ; -------------------------------------------------------------------
 727  8440              ; TriggerPortalTransition
 728  8440              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 729  8440              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 730  8440              ; - Avanza all'indice della stanza successiva.
 731  8440              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 732  8440              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 733  8440              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 734  8440              ; -------------------------------------------------------------------
 735  8440              TriggerPortalTransition:
 736  8440                  ; 1. Determina l'ID della stanza corrente
 737  8440 CD AC 7D         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 738  8443
 739  8443                  ; 2. Calcola l'indice della stanza successiva
 740  8443 3A AF 96         ld   a, (current_room)
 741  8446 3C               inc  a
 742  8447 FE 02            cp   NUM_ROOMS
 743  8449 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 744  844B
 745  844B                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 746  844B 21 BB 70         ld   hl, RoomsListTable
 747  844E 5F               ld   e, a
 748  844F 16 00            ld   d, 0
 749  8451 19               add  hl, de
 750  8452 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 751  8453 5E               ld   e, (hl)
 752  8454 23               inc  hl
 753  8455 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 754  8456 ED 53 09 97      ld   (room_ptr), de
 755  845A
 756  845A                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 757  845A AF               xor  a
 758  845B 32 0F 97         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 759  845E 32 97 93         ld   (velocity_y), a
 760  8461 32 9E 99         ld   (game_objective_completed), a
 761  8464 3E 01            ld   a, 1
 762  8466 32 98 93         ld   (on_ground), a
 763  8469
 764  8469                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 765  8469 21 8D 5C         ld   hl, ATTR_P
 766  846C 36 07            ld   (hl), $07
 767  846E CD AF 0D         call CLS
 768  8471
 769  8471 C3 00 81         jp   LoadRoomAndRestart
 770  8474
 771  8474              .all_rooms_completed:
 772  8474                  ; Tutte le stanze sono state completate con successo!
 773  8474                  IF ENABLE_VICTORY_SCREEN != 0
 774  8474 C3 68 83         jp   TriggerVictory
 775  8477                  ELSE
 776  8477 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 777  8477 ~                ld   de, (RoomsListTable)
 778  8477 ~                ld   (room_ptr), de
 779  8477 ~                xor  a
 780  8477 ~                ld   (transition_active), a
 781  8477 ~                ld   (velocity_y), a
 782  8477 ~                ld   (game_objective_completed), a
 783  8477 ~                ld   a, 1
 784  8477 ~                ld   (on_ground), a
 785  8477 ~                ld   hl, ATTR_P
 786  8477 ~                ld   (hl), $07
 787  8477 ~                call CLS
 788  8477 ~                jp   LoadRoomAndRestart
 789  8477                  ENDIF
 790  8477
 791  8477              ; -------------------------------------------------------------------
 792  8477              ; CheckAllItemsCollected
 793  8477              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 794  8477              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 795  8477              ; -------------------------------------------------------------------
 796  8477              CheckAllItemsCollected:
 797  8477 3A 9E 99         ld   a, (game_objective_completed)
 798  847A B7               or   a
 799  847B 20 08            jr   nz, .all_collected
 800  847D 3A 08 97         ld   a, (num_room_items)
 801  8480 B7               or   a
 802  8481 28 02            jr   z, .all_collected
 803  8483 B7               or   a
 804  8484 C9               ret
 805  8485              .all_collected:
 806  8485 37               scf
 807  8486 C9               ret
 808  8487
 809  8487              ; -------------------------------------------------------------------
 810  8487              ; CheckInMasterBedroom (alias per retrocompatibilità)
 811  8487              ; -------------------------------------------------------------------
 812  8487              CheckInMasterBedroom:
 813  8487 37               scf
 814  8488 C9               ret
 815  8489
 816  8489              ; -------------------------------------------------------------------
 817  8489              ; CheckWillyConveyorCollision
 818  8489              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 819  8489              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 820  8489              ; -------------------------------------------------------------------
 821  8489              CheckWillyConveyorCollision:
 822  8489 C5               push bc
 823  848A D5               push de
 824  848B E5               push hl
 825  848C
 826  848C                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 827  848C CD 18 75         call CheckWillyOnConveyor
 828  848F 38 49            jr   c, .collision_detected
 829  8491
 830  8491                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 831  8491 3A B1 96         ld   a, (conveyor_len)
 832  8494 B7               or   a
 833  8495 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 834  8497
 835  8497                  ; B = WillyY, C = WillyX
 836  8497 ED 4B 89 93      ld   bc, (PlayerPos)
 837  849B
 838  849B                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 839  849B 3A B2 96         ld   a, (conveyor_row)
 840  849E 87               add  a, a                  ; *2
 841  849F 87               add  a, a                  ; *4
 842  84A0 87               add  a, a                  ; *8
 843  84A1 5F               ld   e, a                  ; E = ConveyorTop
 844  84A2 C6 07            add  a, 7
 845  84A4 57               ld   d, a                  ; D = ConveyorBottom
 846  84A5
 847  84A5                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 848  84A5 78               ld   a, b                  ; WillyTop
 849  84A6 BA               cp   d
 850  84A7 28 04            jr   z, .y_overlap
 851  84A9 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 852  84AB 18 32            jr   .no_conv_collision
 853  84AD
 854  84AD              .y_overlap:
 855  84AD C6 0F            add  a, 15                 ; WillyBottom
 856  84AF BB               cp   e
 857  84B0 28 04            jr   z, .x_check
 858  84B2 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 859  84B4 18 29            jr   .no_conv_collision
 860  84B6
 861  84B6              .x_check:
 862  84B6                  ; ConveyorLeft = conveyor_col * 8
 863  84B6 3A B3 96         ld   a, (conveyor_col)
 864  84B9 87               add  a, a                  ; *2
 865  84BA 87               add  a, a                  ; *4
 866  84BB 87               add  a, a                  ; *8
 867  84BC 5F               ld   e, a                  ; E = ConveyorLeft
 868  84BD
 869  84BD                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 870  84BD 21 B1 96         ld   hl, conveyor_len
 871  84C0 3A B3 96         ld   a, (conveyor_col)
 872  84C3 86               add  a, (hl)
 873  84C4 87               add  a, a                  ; *2
 874  84C5 87               add  a, a                  ; *4
 875  84C6 87               add  a, a                  ; *8
 876  84C7 3D               dec  a                     ; ConveyorRight
 877  84C8 57               ld   d, a                  ; D = ConveyorRight
 878  84C9
 879  84C9                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 880  84C9 79               ld   a, c                  ; WillyLeft
 881  84CA BA               cp   d
 882  84CB 28 04            jr   z, .x_overlap
 883  84CD 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 884  84CF 18 0E            jr   .no_conv_collision
 885  84D1
 886  84D1              .x_overlap:
 887  84D1 C6 0F            add  a, 15                 ; WillyRight
 888  84D3 BB               cp   e
 889  84D4 28 04            jr   z, .collision_detected
 890  84D6 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 891  84D8 18 05            jr   .no_conv_collision
 892  84DA
 893  84DA              .collision_detected:
 894  84DA E1               pop  hl
 895  84DB D1               pop  de
 896  84DC C1               pop  bc
 897  84DD 37               scf
 898  84DE C9               ret
 899  84DF
 900  84DF              .no_conv_collision:
 901  84DF E1               pop  hl
 902  84E0 D1               pop  de
 903  84E1 C1               pop  bc
 904  84E2 B7               or   a
 905  84E3 C9               ret
 906  84E4
 907  84E4              ; -------------------------------------------------------------------
 908  84E4              ; ResetFullGameState
 909  84E4              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 910  84E4              ; per l'avvio di una nuova partita dopo il Game Over.
 911  84E4              ; -------------------------------------------------------------------
 912  84E4              ResetFullGameState:
 913  84E4                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 914  84E4 AF               xor  a
 915  84E5 D3 FE            out  ($fe), a              ; Bordo a nero
 916  84E7 21 8D 5C         ld   hl, ATTR_P
 917  84EA 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 918  84EB CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 919  84EE 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 920  84F0 3E 07            ld   a, $07
 921  84F2 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 922  84F5
 923  84F5                  ; Ripristina il numero di vite iniziali
 924  84F5 3E 07            ld   a, INITIAL_LIVES
 925  84F7 32 96 93         ld   (willy_lives), a
 926  84FA
 927  84FA                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 928  84FA AF               xor  a
 929  84FB 32 93 93         ld   (items_collected), a
 930  84FE 32 8F 93         ld   (body_state), a
 931  8501 32 A2 93         ld   (w_warp_state), a
 932  8504 32 A5 93         ld   (w_key_prev), a
 933  8507 32 A6 93         ld   (enter_key_prev), a
 934  850A 32 97 93         ld   (velocity_y), a
 935  850D 32 99 93         ld   (jump_pressed), a
 936  8510 32 9B 93         ld   (coyote_timer), a
 937  8513 32 9E 93         ld   (jump_frame), a
 938  8516 32 9D 93         ld   (jump_dir), a
 939  8519 32 0F 97         ld   (transition_active), a
 940  851C 32 93 97         ld   (willy_safety_timer), a
 941  851F 3E FF            ld   a, $ff
 942  8521 32 A7 93         ld   (digit_key_prev), a
 943  8524 3E 01            ld   a, 1
 944  8526 32 A0 93         ld   (q_prev), a
 945  8529 32 A1 93         ld   (a_prev), a
 946  852C 32 98 93         ld   (on_ground), a
 947  852F
 948  852F                  ; Azzeramento punteggio partita corrente (Score = 000000)
 949  852F                  ; Nota: High score viene mantenuto intatto tra le partite
 950  852F AF               xor  a
 951  8530 32 98 99         ld   (player_score + 0), a
 952  8533 32 99 99         ld   (player_score + 1), a
 953  8536 32 9A 99         ld   (player_score + 2), a
 954  8539
 955  8539                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 956  8539 CD D3 7D         call ResetItemsTable
 957  853C
 958  853C                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 959  853C CD 94 6D         call InitRoomEntryPositions
 960  853F
 961  853F                  ; Aggiorna la riga di stato con High score e Score azzerato
 962  853F CD BB 67         call Gfx_UpdateScoreDisplay
 963  8542
 964  8542                  ; Ripristina la stanza iniziale (Central Cavern)
 965  8542 21 49 85         ld   hl, CentralCavernLayout
 966  8545 22 09 97         ld   (room_ptr), hl
 967  8548
 968  8548 C9               ret
 969  8549
 970  8549
 971  8549
 972  8549                  include "resources.asm"

 142+ 850D              ; Items_DrawRoom
 143+ 850D              ;
 144+ 850D              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 850D              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 850D              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 850D              ;
 148+ 850D              ; Record item nella stanza (5 byte):
 149+ 850D              ;   +0 Color / Attributo
 150+ 850D              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 850D              ;   +2 Attr Address High
 152+ 850D              ;   +3 Anim Mask (96)
 153+ 850D              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 850D              ; Fine lista: $FF

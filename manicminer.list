  74+ 8068 23               inc  hl
  75+ 8069 56               ld   d, (hl)
  76+ 806A 23               inc  hl
  77+ 806B E5               push hl
  78+ 806C
  79+ 806C                  ; DE = room_ptr
  80+ 806C 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 806F 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 8070
  83+ 8070              .item_loop:
  84+ 8070 7E               ld   a, (hl)

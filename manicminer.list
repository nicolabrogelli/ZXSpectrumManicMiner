 645  865B                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 646  865B CD 5F 87         call ResetFullGameState
 647  865E C3 5D 83         jp   LoadRoomAndRestart
 648  8661
 649  8661              ; -------------------------------------------------------------------
 650  8661              ; CheckPortalTransition
 651  8661              ; Verifica le condizioni per accedere alla stanza successiva:
 652  8661              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 653  8661              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 654  8661              ;
 655  8661              ; Output:
 656  8661              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 657  8661              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 658  8661              ; -------------------------------------------------------------------
 659  8661              CheckPortalTransition:
 660  8661 C5               push bc
 661  8662 D5               push de
 662  8663 E5               push hl
 663  8664
 664  8664                  ; 1. Tutti gli item della stanza sono stati raccolti?
 665  8664 CD F2 86         call CheckAllItemsCollected
 666  8667 30 4D            jr   nc, .no_transition
 667  8669
 668  8669                  ; 2. Willy collide con il portale (16x16 pixel)?
 669  8669                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 670  8669                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 671  8669 2A 85 A1         ld   hl, (room_ptr)
 672  866C 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 673  866F 19               add  hl, de
 674  8670 4E               ld   c, (hl)
 675  8671 23               inc  hl
 676  8672 46               ld   b, (hl)                   ; BC = AttrAddr
 677  8673
 678  8673                  ; Offset = BC - 23552
 679  8673 60               ld   h, b
 680  8674 69               ld   l, c
 681  8675 01 00 A4         ld   bc, -23552
 682  8678 09               add  hl, bc
 683  8679
 684  8679                  ; PortalX = (Offset & 31) * 8
 685  8679 7D               ld   a, l
 686  867A E6 1F            and  31
 687  867C 87               add  a, a
 687  867D 87             add a, a
 687  867E 87             add a, a
 688  867F 5F               ld   e, a                      ; E = PortalX (0..248)
 689  8680
 690  8680                  ; PortalY = (Offset / 32) * 8
 691  8680 CB 3C            srl  h
 691  8682 CB 1D          rr l
 692  8684 CB 3C            srl  h
 692  8686 CB 1D          rr l
 693  8688 CB 3C            srl  h
 693  868A CB 1D          rr l
 694  868C CB 3C            srl  h
 694  868E CB 1D          rr l
 695  8690 CB 3C            srl  h
 695  8692 CB 1D          rr l
 696  8694 7D               ld   a, l
 697  8695 87               add  a, a
 697  8696 87             add a, a
 697  8697 87             add a, a
 698  8698 57               ld   d, a                      ; D = PortalY (0..120)
 699  8699
 700  8699                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 701  8699 ED 4B 04 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 702  869D
 703  869D                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 704  869D 7B               ld   a, e
 705  869E 91               sub  c
 706  869F 30 02            jr   nc, .x_diff_pos
 707  86A1 ED 44            neg
 708  86A3              .x_diff_pos:
 709  86A3 FE 0C            cp   12
 710  86A5 30 0F            jr   nc, .no_transition
 711  86A7
 712  86A7                  ; Controllo verticale: |WillyY - PortalY| < 14
 713  86A7 7A               ld   a, d
 714  86A8 90               sub  b
 715  86A9 30 02            jr   nc, .y_diff_pos
 716  86AB ED 44            neg
 717  86AD              .y_diff_pos:
 718  86AD FE 0E            cp   14
 719  86AF 30 05            jr   nc, .no_transition
 720  86B1
 721  86B1                  ; Transizione al portale attiva!
 722  86B1 E1               pop  hl
 723  86B2 D1               pop  de
 724  86B3 C1               pop  bc
 725  86B4 37               scf
 726  86B5 C9               ret
 727  86B6
 728  86B6              .no_transition:
 729  86B6 E1               pop  hl
 730  86B7 D1               pop  de
 731  86B8 C1               pop  bc
 732  86B9 B7               or   a
 733  86BA C9               ret
 734  86BB
 735  86BB              ; Alias per retrocompatibilità
 736  86BB              CheckVictoryCondition: EQU CheckPortalTransition
 737  86BB
 738  86BB              ; -------------------------------------------------------------------
 739  86BB              ; TriggerPortalTransition
 740  86BB              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 741  86BB              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 742  86BB              ; - Avanza all'indice della stanza successiva.
 743  86BB              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 744  86BB              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 745  86BB              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 746  86BB              ; -------------------------------------------------------------------
 747  86BB              TriggerPortalTransition:
 748  86BB                  ; 1. Determina l'ID della stanza corrente
 749  86BB CD 09 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 750  86BE
 751  86BE                  ; 2. Calcola l'indice della stanza successiva
 752  86BE 3A 2A A1         ld   a, (current_room)
 753  86C1 3C               inc  a
 754  86C2 FE 04            cp   NUM_ROOMS
 755  86C4 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 756  86C6
 757  86C6                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 758  86C6 21 4E 73         ld   hl, RoomsListTable
 759  86C9 5F               ld   e, a
 760  86CA 16 00            ld   d, 0
 761  86CC 19               add  hl, de
 762  86CD 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 763  86CE 5E               ld   e, (hl)
 764  86CF 23               inc  hl
 765  86D0 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 766  86D1 ED 53 85 A1      ld   (room_ptr), de
 767  86D5
 768  86D5                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 769  86D5 AF               xor  a
 770  86D6 32 8B A1         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 771  86D9 32 12 9E         ld   (velocity_y), a
 772  86DC 32 1A A4         ld   (game_objective_completed), a
 773  86DF 3E 01            ld   a, 1
 774  86E1 32 13 9E         ld   (on_ground), a
 775  86E4
 776  86E4                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 777  86E4 21 8D 5C         ld   hl, ATTR_P
 778  86E7 36 07            ld   (hl), $07
 779  86E9 CD AF 0D         call CLS

1411+ 7AB5 5F               ld   e, a              ; E = X_left
1412+ 7AB6 79               ld   a, c              ; A = PlayerX
1413+ 7AB7 BB               cp   e
1414+ 7AB8 30 0C            jr   nc, .check_prox_right_bound
1415+ 7ABA
1416+ 7ABA                  ; PlayerX < X_left

 577  88BC 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  88BF 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  88C1              .color_cycle_loop:
 580  88C1 77               ld   (hl), a

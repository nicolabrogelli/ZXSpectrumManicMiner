 906+ 82B8 CA DB 83         jp   z, .next_enemy
 907+ 82BB
 908+ 82BB                  ; ---------------------------------------------------------------
 909+ 82BB                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 910+ 82BB                  ; ---------------------------------------------------------------
 911+ 82BB                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 912+ 82BB 3A 85 EA         ld   a, (PlayerPos)            ; WillyX
 913+ 82BE DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 914+ 82C1 FE 10            cp   16

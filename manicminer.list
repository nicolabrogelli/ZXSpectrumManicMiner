 314+ 858E
 315+ 858E 78               ld   a, b
 316+ 858F E6 07            and  7
 317+ 8591 87               add  a, a                      ; *2
 318+ 8592 87               add  a, a                      ; *4
 319+ 8593 87               add  a, a                      ; *8
 320+ 8594 87               add  a, a                      ; *16
 321+ 8595 87               add  a, a                      ; *32
 322+ 8596 81               add  a, c                      ; + Col
 323+ 8597 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 8598
 325+ 8598 C5               push bc
 326+ 8599 06 08            ld   b, 8                      ; 8 scanline
 327+ 859B              .line_loop:
 328+ 859B 7E               ld   a, (hl)
 329+ 859C 12               ld   (de), a
 330+ 859D 14               inc  d
 331+ 859E 23               inc  hl
 332+ 859F 05               dec  b
 333+ 85A0 20 F9            jr   nz, .line_loop
 334+ 85A2 C1               pop  bc
 335+ 85A3
 336+ 85A3                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 337+ 85A3 26 00            ld   h, 0
 338+ 85A5 68               ld   l, b
 339+ 85A6 29               add  hl, hl
 340+ 85A7 29               add  hl, hl
 341+ 85A8 29               add  hl, hl
 342+ 85A9 29               add  hl, hl
 343+ 85AA 29               add  hl, hl                    ; Row * 32
 344+ 85AB 79               ld   a, c

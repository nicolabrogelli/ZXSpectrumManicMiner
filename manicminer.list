 995+ 7894              ; -------------------------------------------------------------------
 996+ 7894              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 997+ 7894              ; Input: C = X, B = Y
 998+ 7894              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 999+ 7894              ; -------------------------------------------------------------------
1000+ 7894              CheckWallCell:
1001+ 7894 E5               push hl
1002+ 7895 D5               push de
1003+ 7896 C5               push bc
1004+ 7897
1005+ 7897                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1006+ 7897 78               ld   a, b
1007+ 7898 FE 80            cp   128
1008+ 789A 30 1F            jr   nc, .not_wall
1009+ 789C
1010+ 789C                  ; 2. Calcola riga di layout: r = Y / 8
1011+ 789C CB 3F            srl  a
1012+ 789E CB 3F            srl  a
1013+ 78A0 CB 3F            srl  a                 ; A = r (0..15)
1014+ 78A2
1015+ 78A2                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1016+ 78A2 5F               ld   e, a              ; E = r (Row)
1017+ 78A3 79               ld   a, c
1018+ 78A4 CB 3F            srl  a
1019+ 78A6 CB 3F            srl  a
1020+ 78A8 CB 3F            srl  a                 ; A = c (0..31)
1021+ 78AA 4F               ld   c, a              ; C = c (Col)
1022+ 78AB
1023+ 78AB                  ; Se la cella è sulla rampa, non considerarla un muro!
1024+ 78AB 53               ld   d, e              ; D = Row
1025+ 78AC 59               ld   e, c              ; E = Col
1026+ 78AD CD 19 78         call IsCellOnRamp
1027+ 78B0 38 09            jr   c, .not_wall
1028+ 78B2
1029+ 78B2 7A               ld   a, d              ; A = Row
1030+ 78B3 4B               ld   c, e              ; C = Col
1031+ 78B4 CD 50 79         call GetCellFromUnpacked ; A = cell type
1032+ 78B7
1033+ 78B7                  ; Controlla se è Wall (3)
1034+ 78B7 FE 03            cp   3
1035+ 78B9 28 05            jr   z, .is_wall
1036+ 78BB
1037+ 78BB              .not_wall:
1038+ 78BB C1               pop  bc
1039+ 78BC D1               pop  de
1040+ 78BD E1               pop  hl
1041+ 78BE B7               or   a                 ; Clear carry
1042+ 78BF C9               ret

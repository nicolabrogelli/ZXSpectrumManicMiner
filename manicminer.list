 330+ 81DD                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 331+ 81DD 26 00            ld   h, 0
 332+ 81DF 68               ld   l, b
 333+ 81E0 29               add  hl, hl
 334+ 81E1 29               add  hl, hl
 335+ 81E2 29               add  hl, hl
 336+ 81E3 29               add  hl, hl
 337+ 81E4 29               add  hl, hl                    ; Row * 32
 338+ 81E5 79               ld   a, c

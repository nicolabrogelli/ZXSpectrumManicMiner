1232+ 7A52              ; -------------------------------------------------------------------
1233+ 7A52              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1234+ 7A52              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1235+ 7A52              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1236+ 7A52              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1237+ 7A52              ; -------------------------------------------------------------------
1238+ 7A52              UnpackRoomLayout:
1239+ 7A52 E5               push hl
1240+ 7A53 D5               push de
1241+ 7A54 C5               push bc
1242+ 7A55 DD E5            push ix
1243+ 7A57
1244+ 7A57 DD 2A 25 EF      ld   ix, (room_ptr)
1245+ 7A5B 11 20 02         ld   de, OFFSET_TILES
1246+ 7A5E DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1247+ 7A60
1248+ 7A60 2A 25 EF         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1249+ 7A63 11 CA EC         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1250+ 7A66 01 00 02         ld   bc, 512               ; 512 celle
1251+ 7A69
1252+ 7A69              .byte_loop:
1253+ 7A69 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1254+ 7A6A 23               inc  hl
1255+ 7A6B
1256+ 7A6B                  ; Confronta con le 8 definizioni di tile:
1257+ 7A6B DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1258+ 7A6E 28 23            jr   z, .is_bg
1259+ 7A70 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1260+ 7A73 28 29            jr   z, .is_wall
1261+ 7A75 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1262+ 7A78 28 1C            jr   z, .is_floor
1263+ 7A7A DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1264+ 7A7D 28 1B            jr   z, .is_crumbling
1265+ 7A7F DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1266+ 7A82 28 1E            jr   z, .is_conveyor
1267+ 7A84 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1268+ 7A87 28 1D            jr   z, .is_nasty1
1269+ 7A89 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1270+ 7A8C 28 1C            jr   z, .is_nasty2
1271+ 7A8E DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1272+ 7A91 28 1B            jr   z, .is_extra

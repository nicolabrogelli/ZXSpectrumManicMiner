   8+ 82DB              ; Audio_UpdateJumpSound
   9+ 82DB              ;
  10+ 82DB              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 82DB              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 82DB              ; -------------------------------------------------------------------
  13+ 82DB              Audio_UpdateJumpSound:
  14+ 82DB F5               push af
  15+ 82DC C5               push bc
  16+ 82DD D5               push de
  17+ 82DE E5               push hl
  18+ 82DF
  19+ 82DF                  ; Controlla se il suono è attivo (note < 18)
  20+ 82DF 3A 19 9C         ld   a, (Audio_jump_sound_note)
  21+ 82E2 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 82E4 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 82E6
  24+ 82E6                  ; Carica la nota corrente da suonare
  25+ 82E6 5F               ld   e, a
  26+ 82E7 16 00            ld   d, 0
  27+ 82E9 21 15 83         ld   hl, Audio_JumpSoundDelays
  28+ 82EC 19               add  hl, de
  29+ 82ED 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 82EE 57               ld   d, a                      ; D = delay della nota
  31+ 82EF
  32+ 82EF                  ; Suona la nota: 15 cicli
  33+ 82EF 06 0F            ld   b, 15
  34+ 82F1              .note_loop:
  35+ 82F1                  ; Speaker ON
  36+ 82F1 3A 0C 96         ld   a, (room_border_color)
  37+ 82F4 F6 10            or   $10
  38+ 82F6 D3 FE            out  ($fe), a
  39+ 82F8 4A               ld   c, d
  40+ 82F9              .d1:
  41+ 82F9 0D               dec  c
  42+ 82FA 20 FD            jr   nz, .d1
  43+ 82FC
  44+ 82FC                  ; Speaker OFF
  45+ 82FC 3A 0C 96         ld   a, (room_border_color)
  46+ 82FF E6 EF            and  $ef
  47+ 8301 D3 FE            out  ($fe), a
  48+ 8303 4A               ld   c, d
  49+ 8304              .d2:
  50+ 8304 0D               dec  c
  51+ 8305 20 FD            jr   nz, .d2
  52+ 8307
  53+ 8307 10 E8            djnz .note_loop
  54+ 8309
  55+ 8309                  ; Passa alla nota successiva
  56+ 8309 3A 19 9C         ld   a, (Audio_jump_sound_note)
  57+ 830C 3C               inc  a
  58+ 830D 32 19 9C         ld   (Audio_jump_sound_note), a

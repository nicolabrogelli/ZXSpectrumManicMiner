 408+ 8017              ; CheckWillyItemCollision
 409+ 8017              ;
 410+ 8017              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 8017              ; Input:
 412+ 8017              ;   A = Item Col (0..31)
 413+ 8017              ;   H = Item Row (0..15)
 414+ 8017              ; Output:
 415+ 8017              ;   Carry Set = Collisione
 416+ 8017              ;   Carry Clear = Nessuna collisione
 417+ 8017              ; -------------------------------------------------------------------
 418+ 8017              CheckWillyItemCollision:
 419+ 8017 C5               push bc
 420+ 8018 D5               push de
 421+ 8019 E5               push hl
 422+ 801A
 423+ 801A                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 801A 6F               ld   l, a
 425+ 801B 87               add  a, a                      ; *2
 426+ 801C 87               add  a, a                      ; *4
 427+ 801D 87               add  a, a                      ; *8
 428+ 801E 5F               ld   e, a                      ; E = ItemLeft
 429+ 801F C6 07            add  a, 7
 430+ 8021 57               ld   d, a                      ; D = ItemRight
 431+ 8022
 432+ 8022 ED 4B 6B 94      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 8026
 434+ 8026                  ; WillyLeft <= ItemRight
 435+ 8026 79               ld   a, c                      ; A = WillyX
 436+ 8027 BA               cp   d                         ; D = ItemRight
 437+ 8028 28 04            jr   z, .x_ok
 438+ 802A 38 02            jr   c, .x_ok
 439+ 802C 18 31            jr   .no_collision
 440+ 802E
 441+ 802E              .x_ok:
 442+ 802E                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 802E BB               cp   e                         ; E = ItemLeft
 444+ 802F 28 0B            jr   z, .y_check
 445+ 8031 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 8033
 447+ 8033                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 8033 C6 0F            add  a, 15
 449+ 8035 BB               cp   e
 450+ 8036 28 04            jr   z, .y_check
 451+ 8038 30 02            jr   nc, .y_check
 452+ 803A 18 23            jr   .no_collision
 453+ 803C
 454+ 803C              .y_check:
 455+ 803C                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 803C 7C               ld   a, h                      ; H = Item Row
 457+ 803D 87               add  a, a                      ; *2
 458+ 803E 87               add  a, a                      ; *4
 459+ 803F 87               add  a, a                      ; *8
 460+ 8040 5F               ld   e, a                      ; E = ItemTop
 461+ 8041 C6 07            add  a, 7
 462+ 8043 57               ld   d, a                      ; D = ItemBottom
 463+ 8044
 464+ 8044                  ; WillyTop <= ItemBottom
 465+ 8044 78               ld   a, b                      ; A = WillyY
 466+ 8045 BA               cp   d                         ; D = ItemBottom
 467+ 8046 28 04            jr   z, .y_ok
 468+ 8048 38 02            jr   c, .y_ok
 469+ 804A 18 13            jr   .no_collision
 470+ 804C
 471+ 804C              .y_ok:
 472+ 804C                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 804C BB               cp   e                         ; E = ItemTop
 474+ 804D 28 0B            jr   z, .collision
 475+ 804F 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 8051
 477+ 8051                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 8051 C6 0F            add  a, 15
 479+ 8053 BB               cp   e
 480+ 8054 28 04            jr   z, .collision
 481+ 8056 30 02            jr   nc, .collision
 482+ 8058 18 05            jr   .no_collision
 483+ 805A

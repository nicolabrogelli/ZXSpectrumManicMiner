  65+ 7CA6 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CA7 FE FF            cp   $FF
  67+ 7CA9 28 7F            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CAB B7               or   a
  69+ 7CAC 28 74            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7CAE
  71+ 7CAE                  ; Slot attivo
  72+ 7CAE DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CB2 CB 7F            bit  7, a
  74+ 7CB4 28 04            jr   z, .h_speed_normal
  75+ 7CB6 DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)
  76+ 7CBA              .h_speed_normal:
  77+ 7CBA E6 7F            and  $7F                       ; Rimuove bit 7 (velocità) per isolare l'attributo colore ed evitare il FLASH hardware
  78+ 7CBC DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7CBF
  80+ 7CBF 23               inc  hl
  81+ 7CC0 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7CC1 23               inc  hl
  83+ 7CC2 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7CC3
  85+ 7CC3                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7CC3 E5               push hl
  87+ 7CC4 C5               push bc

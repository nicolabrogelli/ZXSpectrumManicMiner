  72+ 8456 ~            ; Audio_UpdateMusic
  73+ 8456 ~            ;
  74+ 8456 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8456 ~            ; Viene chiamata a ogni frame.
  76+ 8456 ~            ; -------------------------------------------------------------------
  77+ 8456 ~            Audio_UpdateMusic:
  78+ 8456 ~                push af
  79+ 8456 ~                push bc
  80+ 8456 ~                push de
  81+ 8456 ~                push hl
  82+ 8456 ~
  83+ 8456 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8456 ~                ld   a, (Audio_jump_sound_note)
  85+ 8456 ~                cp   18
  86+ 8456 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8456 ~
  88+ 8456 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8456 ~                ld   a, (Audio_music_frame_counter)
  90+ 8456 ~                dec  a
  91+ 8456 ~                ld   (Audio_music_frame_counter), a
  92+ 8456 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8456 ~
  94+ 8456 ~                ; Altrimenti carica la nota successiva
  95+ 8456 ~                ld   a, (Audio_music_note_idx)
  96+ 8456 ~                inc  a
  97+ 8456 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8456 ~                jr   c, .no_wrap
  99+ 8456 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8456 ~            .no_wrap:
 101+ 8456 ~                ld   (Audio_music_note_idx), a
 102+ 8456 ~
 103+ 8456 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8456 ~                ld   e, a
 105+ 8456 ~                ld   d, 0
 106+ 8456 ~                ld   hl, Audio_MusicSheet
 107+ 8456 ~                add  hl, de
 108+ 8456 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8456 ~
 110+ 8456 ~                ; Leggi durata (secondo byte)
 111+ 8456 ~                inc  hl
 112+ 8456 ~                ld   a, (hl)
 113+ 8456 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8456 ~                jr   nz, .dur_ok
 115+ 8456 ~                ld   a, 1
 116+ 8456 ~            .dur_ok:
 117+ 8456 ~                ld   (Audio_music_frame_counter), a

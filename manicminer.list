 465  82F5
 466  82F5                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 467  82F5 2A AA 93         ld   hl, (counter)
 468  82F8 22 AD 93         ld   (last_frame_counter), hl
 469  82FB

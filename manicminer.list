  29+ 7E2E              ; Enemy_LoadRoom
  30+ 7E2E              ;
  31+ 7E2E              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7E2E              ; Chiamato quando si entra in una stanza.
  33+ 7E2E              ; -------------------------------------------------------------------
  34+ 7E2E              Enemy_LoadRoom:
  35+ 7E2E E5               push hl
  36+ 7E2F D5               push de
  37+ 7E30 C5               push bc
  38+ 7E31 DD E5            push ix
  39+ 7E33
  40+ 7E33                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7E33 21 D6 7D         ld   hl, ActiveEnemies
  42+ 7E36 11 D7 7D         ld   de, ActiveEnemies + 1
  43+ 7E39 36 00            ld   (hl), 0
  44+ 7E3B 01 57 00         ld   bc, 87
  45+ 7E3E ED B0            ldir
  46+ 7E40
  47+ 7E40                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7E40 DD 21 D6 7D      ld   ix, ActiveEnemies
  49+ 7E44 06 08            ld   b, 8
  50+ 7E46 11 0B 00         ld   de, 11
  51+ 7E49              .init_old_pos:
  52+ 7E49 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7E4D DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7E51 DD 19            add  ix, de
  55+ 7E53 10 F4            djnz .init_old_pos
  56+ 7E55
  57+ 7E55                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7E55 DD 21 D6 7D      ld   ix, ActiveEnemies
  59+ 7E59 2A AD EE         ld   hl, (room_ptr)

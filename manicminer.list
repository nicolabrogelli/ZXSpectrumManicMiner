 328  8AB7 77               ld   (hl), a
 329  8AB8 23               inc  hl
 330  8AB9 10 FC            djnz .color_title_loop
 331  8ABB
 332  8ABB                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)

 526  86B8              ; TriggerVictory
 527  86B8              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  86B8              ; - Pulisce gli elementi di gioco della stanza.
 529  86B8              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  86B8              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  86B8              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  86B8              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  86B8              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  86B8              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  86B8              ; -------------------------------------------------------------------
 536  86B8              TriggerVictory:
 537  86B8                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  86B8 CD F3 66         call Gfx_DrawVictoryScreen
 539  86BB
 540  86BB                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  86BB              .wait_keys_release:
 542  86BB 76               halt
 543  86BC                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  86BC 01 FE DF         ld   bc, $dffe
 545  86BF ED 78            in   a, (c)
 546  86C1 CB 67            bit  4, a
 547  86C3 28 F6            jr   z, .wait_keys_release
 548  86C5
 549  86C5                  ; Controlla tasto N (Porta $7F, bit 3)
 550  86C5 01 FE 7F         ld   bc, $7ffe
 551  86C8 ED 78            in   a, (c)
 552  86CA CB 5F            bit  3, a
 553  86CC 28 ED            jr   z, .wait_keys_release
 554  86CE
 555  86CE                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  86CE 01 FE BF         ld   bc, $bffe
 557  86D1 ED 78            in   a, (c)
 558  86D3 CB 47            bit  0, a
 559  86D5 28 E4            jr   z, .wait_keys_release
 560  86D7
 561  86D7                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  86D7 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  86D9              .wait_choice_loop:
 564  86D9 76               halt
 565  86DA
 566  86DA                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  86DA 0C               inc  c
 568  86DB 79               ld   a, c
 569  86DC CB 3F            srl  a
 570  86DE CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  86E0 E6 07            and  7
 572  86E2 5F               ld   e, a
 573  86E3 16 00            ld   d, 0
 574  86E5 21 0D 66         ld   hl, victory_color_table
 575  86E8 19               add  hl, de
 576  86E9 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  86EA 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  86ED 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  86EF              .color_cycle_loop:
 580  86EF 77               ld   (hl), a
 581  86F0 23               inc  hl
 582  86F1 10 FC            djnz .color_cycle_loop
 583  86F3
 584  86F3                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  86F3 01 FE DF         ld   bc, $dffe
 586  86F6 ED 78            in   a, (c)
 587  86F8 CB 67            bit  4, a
 588  86FA 28 2A            jr   z, .play_again_chosen
 589  86FC
 590  86FC                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  86FC 01 FE 7F         ld   bc, $7ffe
 592  86FF ED 78            in   a, (c)
 593  8701 CB 5F            bit  3, a
 594  8703 28 0B            jr   z, .quit_chosen
 595  8705
 596  8705                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  8705 01 FE BF         ld   bc, $bffe
 598  8708 ED 78            in   a, (c)
 599  870A CB 47            bit  0, a
 600  870C 28 02            jr   z, .quit_chosen
 601  870E
 602  870E 18 C9            jr   .wait_choice_loop
 603  8710
 604  8710              .quit_chosen:
 605  8710                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  8710              .wait_quit_release:
 607  8710 76               halt
 608  8711 01 FE 7F         ld   bc, $7ffe
 609  8714 ED 78            in   a, (c)
 610  8716 CB 5F            bit  3, a
 611  8718 28 F6            jr   z, .wait_quit_release
 612  871A 01 FE BF         ld   bc, $bffe
 613  871D ED 78            in   a, (c)
 614  871F CB 47            bit  0, a
 615  8721 28 ED            jr   z, .wait_quit_release
 616  8723
 617  8723                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  8723 C3 8C 85         jp   ShowTitleScreen
 619  8726
 620  8726              .play_again_chosen:
 621  8726                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  8726              .wait_play_again_release:
 623  8726 76               halt
 624  8727 01 FE DF         ld   bc, $dffe
 625  872A ED 78            in   a, (c)
 626  872C CB 67            bit  4, a
 627  872E 28 F6            jr   z, .wait_play_again_release
 628  8730
 629  8730                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  8730 CD 31 88         call ResetFullGameState
 631  8733 C3 53 84         jp   LoadRoomAndRestart
 632  8736
 633  8736              ; -------------------------------------------------------------------
 634  8736              ; CheckPortalTransition
 635  8736              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8736              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8736              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8736              ;
 639  8736              ; Output:
 640  8736              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8736              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8736              ; -------------------------------------------------------------------
 643  8736              CheckPortalTransition:
 644  8736 C5               push bc
 645  8737 D5               push de
 646  8738 E5               push hl
 647  8739
 648  8739                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  8739 CD C4 87         call CheckAllItemsCollected
 650  873C 30 4D            jr   nc, .no_transition
 651  873E
 652  873E                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  873E                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  873E                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  873E 2A 4C B6         ld   hl, (room_ptr)
 656  8741 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8744 19               add  hl, de
 658  8745 4E               ld   c, (hl)
 659  8746 23               inc  hl
 660  8747 46               ld   b, (hl)                   ; BC = AttrAddr
 661  8748
 662  8748                  ; Offset = BC - 23552
 663  8748 60               ld   h, b
 664  8749 69               ld   l, c
 665  874A 01 00 A4         ld   bc, -23552
 666  874D 09               add  hl, bc
 667  874E
 668  874E                  ; PortalX = (Offset & 31) * 8
 669  874E 7D               ld   a, l
 670  874F E6 1F            and  31
 671  8751 87               add  a, a
 671  8752 87             add a, a
 671  8753 87             add a, a
 672  8754 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8755
 674  8755                  ; PortalY = (Offset / 32) * 8
 675  8755 CB 3C            srl  h
 675  8757 CB 1D          rr l
 676  8759 CB 3C            srl  h
 676  875B CB 1D          rr l
 677  875D CB 3C            srl  h
 677  875F CB 1D          rr l
 678  8761 CB 3C            srl  h
 678  8763 CB 1D          rr l
 679  8765 CB 3C            srl  h
 679  8767 CB 1D          rr l
 680  8769 7D               ld   a, l
 681  876A 87               add  a, a
 681  876B 87             add a, a
 681  876C 87             add a, a
 682  876D 57               ld   d, a                      ; D = PortalY (0..120)
 683  876E
 684  876E                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  876E ED 4B CB B2      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  8772
 687  8772                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  8772 7B               ld   a, e
 689  8773 91               sub  c
 690  8774 30 02            jr   nc, .x_diff_pos
 691  8776 ED 44            neg
 692  8778              .x_diff_pos:
 693  8778 FE 0C            cp   12
 694  877A 30 0F            jr   nc, .no_transition
 695  877C
 696  877C                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  877C 7A               ld   a, d
 698  877D 90               sub  b
 699  877E 30 02            jr   nc, .y_diff_pos
 700  8780 ED 44            neg
 701  8782              .y_diff_pos:
 702  8782 FE 0E            cp   14
 703  8784 30 05            jr   nc, .no_transition
 704  8786
 705  8786                  ; Transizione al portale attiva!
 706  8786 E1               pop  hl
 707  8787 D1               pop  de
 708  8788 C1               pop  bc
 709  8789 37               scf
 710  878A C9               ret
 711  878B
 712  878B              .no_transition:
 713  878B E1               pop  hl
 714  878C D1               pop  de
 715  878D C1               pop  bc
 716  878E B7               or   a
 717  878F C9               ret
 718  8790
 719  8790              ; Alias per retrocompatibilità
 720  8790              CheckVictoryCondition: EQU CheckPortalTransition
 721  8790
 722  8790              ; -------------------------------------------------------------------
 723  8790              ; TriggerPortalTransition
 724  8790              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  8790              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  8790              ; - Avanza all'indice della stanza successiva.
 727  8790              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  8790              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  8790              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  8790              ; -------------------------------------------------------------------
 731  8790              TriggerPortalTransition:
 732  8790                  ; 1. Determina l'ID della stanza corrente
 733  8790 CD 02 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  8793
 735  8793                  ; 2. Calcola l'indice della stanza successiva
 736  8793 3A F1 B5         ld   a, (current_room)
 737  8796 3C               inc  a
 738  8797 FE 09            cp   NUM_ROOMS
 739  8799 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  879B
 741  879B                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  879B 21 0A 73         ld   hl, RoomsListTable
 743  879E 5F               ld   e, a
 744  879F 16 00            ld   d, 0
 745  87A1 19               add  hl, de
 746  87A2 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87A3 5E               ld   e, (hl)
 748  87A4 23               inc  hl
 749  87A5 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87A6 ED 53 4C B6      ld   (room_ptr), de
 751  87AA
 752  87AA                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87AA AF               xor  a
 754  87AB 32 52 B6         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87AE 32 D9 B2         ld   (velocity_y), a
 756  87B1 32 E1 B8         ld   (game_objective_completed), a
 757  87B4 3E 01            ld   a, 1
 758  87B6 32 DA B2         ld   (on_ground), a
 759  87B9
 760  87B9                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  87B9 3E 07            ld   a, $07
 762  87BB CD 99 62         call Gfx_ClearScreenDirect
 763  87BE
 764  87BE C3 53 84         jp   LoadRoomAndRestart
 765  87C1
 766  87C1              .all_rooms_completed:
 767  87C1                  ; Tutte le stanze sono state completate con successo!
 768  87C1                  IF ENABLE_VICTORY_SCREEN != 0
 769  87C1 C3 B8 86         jp   TriggerVictory
 770  87C4                  ELSE
 771  87C4 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  87C4 ~                ld   de, (RoomsListTable)
 773  87C4 ~                ld   (room_ptr), de
 774  87C4 ~                xor  a
 775  87C4 ~                ld   (transition_active), a
 776  87C4 ~                ld   (velocity_y), a
 777  87C4 ~                ld   (game_objective_completed), a
 778  87C4 ~                ld   a, 1
 779  87C4 ~                ld   (on_ground), a
 780  87C4 ~                ld   a, $07
 781  87C4 ~                call Gfx_ClearScreenDirect
 782  87C4 ~                jp   LoadRoomAndRestart
 783  87C4                  ENDIF
 784  87C4
 785  87C4              ; -------------------------------------------------------------------
 786  87C4              ; CheckAllItemsCollected
 787  87C4              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  87C4              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  87C4              ; -------------------------------------------------------------------
 790  87C4              CheckAllItemsCollected:
 791  87C4 3A E1 B8         ld   a, (game_objective_completed)
 792  87C7 B7               or   a
 793  87C8 20 08            jr   nz, .all_collected
 794  87CA 3A 4B B6         ld   a, (num_room_items)
 795  87CD B7               or   a
 796  87CE 28 02            jr   z, .all_collected
 797  87D0 B7               or   a
 798  87D1 C9               ret
 799  87D2              .all_collected:
 800  87D2 37               scf
 801  87D3 C9               ret
 802  87D4
 803  87D4              ; -------------------------------------------------------------------
 804  87D4              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  87D4              ; -------------------------------------------------------------------
 806  87D4              CheckInMasterBedroom:
 807  87D4 37               scf
 808  87D5 C9               ret
 809  87D6
 810  87D6              ; -------------------------------------------------------------------
 811  87D6              ; CheckWillyConveyorCollision
 812  87D6              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  87D6              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  87D6              ; -------------------------------------------------------------------
 815  87D6              CheckWillyConveyorCollision:
 816  87D6 C5               push bc
 817  87D7 D5               push de
 818  87D8 E5               push hl
 819  87D9
 820  87D9                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  87D9 CD B5 76         call CheckWillyOnConveyor
 822  87DC 38 49            jr   c, .collision_detected
 823  87DE
 824  87DE                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  87DE 3A F3 B5         ld   a, (conveyor_len)
 826  87E1 B7               or   a
 827  87E2 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  87E4
 829  87E4                  ; B = WillyY, C = WillyX
 830  87E4 ED 4B CB B2      ld   bc, (PlayerPos)
 831  87E8
 832  87E8                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  87E8 3A F4 B5         ld   a, (conveyor_row)
 834  87EB 87               add  a, a                  ; *2
 835  87EC 87               add  a, a                  ; *4
 836  87ED 87               add  a, a                  ; *8
 837  87EE 5F               ld   e, a                  ; E = ConveyorTop
 838  87EF C6 07            add  a, 7
 839  87F1 57               ld   d, a                  ; D = ConveyorBottom
 840  87F2
 841  87F2                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  87F2 78               ld   a, b                  ; WillyTop
 843  87F3 BA               cp   d
 844  87F4 28 04            jr   z, .y_overlap
 845  87F6 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  87F8 18 32            jr   .no_conv_collision
 847  87FA
 848  87FA              .y_overlap:
 849  87FA C6 0F            add  a, 15                 ; WillyBottom
 850  87FC BB               cp   e
 851  87FD 28 04            jr   z, .x_check
 852  87FF 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  8801 18 29            jr   .no_conv_collision
 854  8803
 855  8803              .x_check:
 856  8803                  ; ConveyorLeft = conveyor_col * 8
 857  8803 3A F5 B5         ld   a, (conveyor_col)
 858  8806 87               add  a, a                  ; *2
 859  8807 87               add  a, a                  ; *4
 860  8808 87               add  a, a                  ; *8
 861  8809 5F               ld   e, a                  ; E = ConveyorLeft
 862  880A
 863  880A                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  880A 21 F3 B5         ld   hl, conveyor_len
 865  880D 3A F5 B5         ld   a, (conveyor_col)
 866  8810 86               add  a, (hl)
 867  8811 87               add  a, a                  ; *2
 868  8812 87               add  a, a                  ; *4
 869  8813 87               add  a, a                  ; *8
 870  8814 3D               dec  a                     ; ConveyorRight
 871  8815 57               ld   d, a                  ; D = ConveyorRight
 872  8816
 873  8816                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  8816 79               ld   a, c                  ; WillyLeft
 875  8817 BA               cp   d
 876  8818 28 04            jr   z, .x_overlap
 877  881A 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  881C 18 0E            jr   .no_conv_collision
 879  881E
 880  881E              .x_overlap:
 881  881E C6 0F            add  a, 15                 ; WillyRight
 882  8820 BB               cp   e
 883  8821 28 04            jr   z, .collision_detected
 884  8823 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  8825 18 05            jr   .no_conv_collision
 886  8827
 887  8827              .collision_detected:
 888  8827 E1               pop  hl
 889  8828 D1               pop  de
 890  8829 C1               pop  bc
 891  882A 37               scf
 892  882B C9               ret
 893  882C
 894  882C              .no_conv_collision:
 895  882C E1               pop  hl
 896  882D D1               pop  de
 897  882E C1               pop  bc
 898  882F B7               or   a
 899  8830 C9               ret

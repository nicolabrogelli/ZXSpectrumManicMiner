  85+ EFC4 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  86+ EFC5 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  87+ EFC6
  88+ EFC6              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ EFC6 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ EFC9 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ EFCC 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ EFCD 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ EFCE 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ EFCF 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ EFD0 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ EFD1 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ EFD2 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  98+ EFD3
  99+ EFD3 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 100+ EFD4 00           Audio_jump_sound_timer:   db 0
 101+ EFD5                  IF ENABLE_MUSIC != 0
 102+ EFD5 ~            Audio_music_note_idx:      db 0
 103+ EFD5 ~            Audio_music_frame_counter: db 1
 104+ EFD5                  ENDIF
 105+ EFD5
 106+ EFD5              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 107+ EFD5 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 108+ EFD6 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 109+ EFD7 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 110+ EFD8
 111+ EFD8              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 112+ EFD8 00 00        willy_head_ptr:         dw 0
 113+ EFDA 00 00        willy_body_ptr:         dw 0
 114+ EFDC 00 00        guard_sprite_ptr:       dw 0
 115+ EFDE 00           collision_delta_x:      db 0
 116+ EFDF 00           collision_delta_y:      db 0
 117+ EFE0 00           row_enemy_cur:          db 0
 118+ EFE1 00           row_willy_cur:          db 0
 119+ EFE2 00           overlap_num_lines:      db 0
 120+ EFE3

 323  8870 77               ld   (hl), a
 324  8871 23               inc  hl
 325  8872 10 FC            djnz .color_title_loop
 326  8874
 327  8874                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 328  8874 3E BF            ld   a, $bf
 329  8876 DB FE            in   a, ($fe)
 330  8878 1F               rra
 331  8879 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 332  887B

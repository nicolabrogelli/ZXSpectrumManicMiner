1237+ 78C9              .is_crumbling:
1238+ 78C9 3E 02            ld   a, 2
1239+ 78CB 18 12            jr   .store_cell
1240+ 78CD              .is_wall:
1241+ 78CD 3E 03            ld   a, 3
1242+ 78CF 18 0E            jr   .store_cell
1243+ 78D1              .is_conveyor:
1244+ 78D1 3E 04            ld   a, 4
1245+ 78D3 18 0A            jr   .store_cell
1246+ 78D5              .is_nasty1:
1247+ 78D5 3E 05            ld   a, 5
1248+ 78D7 18 06            jr   .store_cell
1249+ 78D9              .is_nasty2:
1250+ 78D9 3E 06            ld   a, 6
1251+ 78DB 18 02            jr   .store_cell
1252+ 78DD              .is_extra:
1253+ 78DD 3E 07            ld   a, 7
1254+ 78DF
1255+ 78DF              .store_cell:
1256+ 78DF 12               ld   (de), a
1257+ 78E0 13               inc  de
1258+ 78E1 0B               dec  bc
1259+ 78E2 78               ld   a, b
1260+ 78E3 B1               or   c
1261+ 78E4 20 B2            jr   nz, .byte_loop
1262+ 78E6
1263+ 78E6 DD E1            pop  ix
1264+ 78E8 C1               pop  bc
1265+ 78E9 D1               pop  de

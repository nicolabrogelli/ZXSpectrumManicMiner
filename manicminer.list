 485+ 7EFD FE 01            cp   1
 486+ 7EFF 20 20            jr   nz, .horiz_right
 487+ 7F01
 488+ 7F01              .horiz_left:
 489+ 7F01 DD 7E 02         ld   a, (ix+2)                 ; Current X
 490+ 7F04 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 491+ 7F06 DD BE 04         cp   (ix+4)                    ; Min Limit
 492+ 7F09 28 08            jr   z, .h_rev_right
 493+ 7F0B 38 06            jr   c, .h_rev_right

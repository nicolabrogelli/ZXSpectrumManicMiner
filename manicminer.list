   6+ 6D68              ; -------------------------------------------------------------------
   7+ 6D68              ; Input_CheckCtrl
   8+ 6D68              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 6D68              ;
  10+ 6D68              ; Output:
  11+ 6D68              ;   D = bitmask tasti attivi:
  12+ 6D68              ;       bit 0 → sinistra (O)
  13+ 6D68              ;       bit 1 → destra   (P)
  14+ 6D68              ;       bit 2 → salto    (Z)
  15+ 6D68              ;
  16+ 6D68              ; Effetti collaterali in RAM:
  17+ 6D68              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 6D68              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 6D68              ;   (jump_prev)     → debounce tasto salto
  20+ 6D68              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 6D68              ;   (flags)         → bit 0 impostato se movimento rilevato

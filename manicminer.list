 781  828F B7               or   a
 782  8290 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 783  8292
 784  8292                  ; B = WillyY, C = WillyX
 785  8292 ED 4B F9 8D      ld   bc, (PlayerPos)
 786  8296
 787  8296                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 788  8296 3A 22 91         ld   a, (conveyor_row)
 789  8299 87               add  a, a                  ; *2
 790  829A 87               add  a, a                  ; *4
 791  829B 87               add  a, a                  ; *8
 792  829C 5F               ld   e, a                  ; E = ConveyorTop
 793  829D C6 07            add  a, 7
 794  829F 57               ld   d, a                  ; D = ConveyorBottom
 795  82A0
 796  82A0                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 797  82A0 78               ld   a, b                  ; WillyTop
 798  82A1 BA               cp   d
 799  82A2 28 04            jr   z, .y_overlap
 800  82A4 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 801  82A6 18 32            jr   .no_conv_collision
 802  82A8
 803  82A8              .y_overlap:
 804  82A8 C6 0F            add  a, 15                 ; WillyBottom
 805  82AA BB               cp   e
 806  82AB 28 04            jr   z, .x_check
 807  82AD 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 808  82AF 18 29            jr   .no_conv_collision

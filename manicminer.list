 570+ 601C              ; -------------------------------------------------------------------
 571+ 601C              ; Aggiorna il player a schermo cancellandolo e ridisegnandolo solo se mosso o animato
 572+ 601C              ; -------------------------------------------------------------------
 573+ 601C              Gfx_UpdatePlayer:
 574+ 601C C5               push bc
 575+ 601D D5               push de
 576+ 601E E5               push hl
 577+ 601F
 578+ 601F                  ; Durante il tempo di sicurezza, forza il ridisegno ad ogni frame per permettere il lampeggio
 579+ 601F 3A 03 92         ld   a, (willy_safety_timer)
 580+ 6022 B7               or   a
 581+ 6023 20 2A            jr   nz, .player_moved
 582+ 6025
 583+ 6025                  ; 1. Controlla se la posizione o l'animazione sono cambiate
 584+ 6025 ED 4B F9 8D      ld   bc, (PlayerPos)            ; C = PlayerX, B = PlayerY
 585+ 6029 ED 5B FE 91      ld   de, (player_drawn_pos)     ; E = Drawn X, D = Drawn Y
 586+ 602D 78               ld   a, b
 587+ 602E BA               cp   d
 588+ 602F 20 1E            jr   nz, .player_moved
 589+ 6031 79               ld   a, c
 590+ 6032 BB               cp   e
 591+ 6033 20 1A            jr   nz, .player_moved
 592+ 6035
 593+ 6035 3A 00 8E         ld   a, (direction)
 594+ 6038 21 00 92         ld   hl, player_old_dir
 595+ 603B BE               cp   (hl)
 596+ 603C 20 11            jr   nz, .player_moved
 597+ 603E
 598+ 603E 3A FF 8D         ld   a, (body_state)
 599+ 6041 21 01 92         ld   hl, player_old_body
 600+ 6044 BE               cp   (hl)
 601+ 6045 20 08            jr   nz, .player_moved
 602+ 6047
 603+ 6047                  ; Willy non si è mosso. Ma se un nemico lo ha sovrascritto, ridisegnalo senza prima cancellarlo!
 604+ 6047 3A 04 92         ld   a, (willy_needs_redraw)
 605+ 604A B7               or   a
 606+ 604B 20 22            jr   nz, .redraw_overlay_only
 607+ 604D 18 48            jr   .player_no_change
 608+ 604F
 609+ 604F              .player_moved:
 610+ 604F                  ; 2. Cancella lo sprite dalla posizione precedentemente disegnata solo se Willy si è mosso
 611+ 604F 3A FF 91         ld   a, (player_drawn_pos+1)
 612+ 6052 FE FF            cp   $FF
 613+ 6054 28 19            jr   z, .redraw_overlay_only
 614+ 6056
 615+ 6056 ED 4B FE 91      ld   bc, (player_drawn_pos)
 616+ 605A CD D8 5E         call Gfx_ErasePixelSprite8x8    ; Cancella testa
 617+ 605D ED 4B FE 91      ld   bc, (player_drawn_pos)
 618+ 6061 78               ld   a, b
 619+ 6062 C6 08            add  a, 8
 620+ 6064 47               ld   b, a
 621+ 6065 CD D8 5E         call Gfx_ErasePixelSprite8x8    ; Cancella corpo
 622+ 6068 ED 4B FE 91      ld   bc, (player_drawn_pos)
 623+ 606C CD 10 6B         call Gfx_RestoreEnemyColorAttributes ; Ripristina sfondo
 624+ 606F
 625+ 606F              .redraw_overlay_only:
 626+ 606F                  ; Durante il timer di sicurezza, fa lampeggiare lo sprite
 627+ 606F 3A 03 92         ld   a, (willy_safety_timer)
 628+ 6072 B7               or   a
 629+ 6073 28 07            jr   z, .do_print
 630+ 6075
 631+ 6075 3A 1A 8E         ld   a, (counter)
 632+ 6078 E6 04            and  4
 633+ 607A 28 03            jr   z, .skip_print_blink       ; Nelle fasi "off" del lampeggio, non ridisegnare
 634+ 607C
 635+ 607C              .do_print:
 636+ 607C                  ; 3. Disegna il player nella nuova posizione
 637+ 607C CD BA 5F         call Gfx_PrintPlayer
 638+ 607F
 639+ 607F              .skip_print_blink:
 640+ 607F                  ; 4. Registra lo stato disegnato a schermo
 641+ 607F ED 4B F9 8D      ld   bc, (PlayerPos)
 642+ 6083 ED 43 FE 91      ld   (player_drawn_pos), bc
 643+ 6087 3A 00 8E         ld   a, (direction)
 644+ 608A 32 00 92         ld   (player_old_dir), a
 645+ 608D 3A FF 8D         ld   a, (body_state)
 646+ 6090 32 01 92         ld   (player_old_body), a
 647+ 6093
 648+ 6093 AF               xor  a
 649+ 6094 32 04 92         ld   (willy_needs_redraw), a

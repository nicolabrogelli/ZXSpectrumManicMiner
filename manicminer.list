1145+ 62A7 11 01 40         ld   de, $4001
1146+ 62AA 01 FF 17         ld   bc, 6143
1147+ 62AD ED B0            ldir
1148+ 62AF
1149+ 62AF                  ; 2. Imposta tutti gli attributi a B ($5800..$5AFF)
1150+ 62AF 21 00 58         ld   hl, $5800
1151+ 62B2 70               ld   (hl), b
1152+ 62B3 11 01 58         ld   de, $5801
1153+ 62B6 01 FF 02         ld   bc, 767
1154+ 62B9 ED B0            ldir
1155+ 62BB
1156+ 62BB E1               pop  hl
1157+ 62BC D1               pop  de
1158+ 62BD C1               pop  bc
1159+ 62BE F1               pop  af
1160+ 62BF C9               ret

 746+ 87CC              ; -------------------------------------------------------------------
 747+ 87CC              ; Items_Animate
 748+ 87CC              ;
 749+ 87CC              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 87CC              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 87CC              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 87CC              ; originale $8F63.
 753+ 87CC              ; -------------------------------------------------------------------
 754+ 87CC              Items_Animate:
 755+ 87CC E5               push hl
 756+ 87CD D5               push de
 757+ 87CE C5               push bc
 758+ 87CF FD E5            push iy
 759+ 87D1
 760+ 87D1 3A 05 EE         ld   a, (num_room_items)
 761+ 87D4 B7               or   a
 762+ 87D5 28 40            jr   z, .anim_done
 763+ 87D7
 764+ 87D7 FD 21 B5 ED      ld   iy, current_room_items
 765+ 87DB
 766+ 87DB              .anim_loop:
 767+ 87DB FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 87DE FE FF            cp   $FF
 769+ 87E0 28 35            jr   z, .anim_done
 770+ 87E2 B7               or   a
 771+ 87E3 28 2B            jr   z, .next_anim_item
 772+ 87E5
 773+ 87E5                  ; Routine originale $8F63 di Manic Miner:
 774+ 87E5                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 87E5 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 87E7 F6 03            or   $03                       ; Base Ink = 3
 777+ 87E9 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 87EA FD 7E 02         ld   a, (iy+2)
 779+ 87ED E6 03            and  $03                       ; Isola offset rotazione
 780+ 87EF 80               add  a, b                      ; A = Nuovo attributo
 781+ 87F0 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 87F3 47               ld   b, a                      ; B = Nuovo attributo
 783+ 87F4
 784+ 87F4                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 87F4 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 87F7 16 00            ld   d, 0
 787+ 87F9 26 00            ld   h, 0
 788+ 87FB FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 87FE 29               add  hl, hl
 790+ 87FF 29               add  hl, hl
 791+ 8800 29               add  hl, hl
 792+ 8801 29               add  hl, hl
 793+ 8802 29               add  hl, hl                    ; Row * 32
 794+ 8803 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 8804
 796+ 8804                  ; Aggiorna items_grid
 797+ 8804 E5               push hl
 798+ 8805 11 85 E8         ld   de, items_grid
 799+ 8808 19               add  hl, de
 800+ 8809 70               ld   (hl), b
 801+ 880A E1               pop  hl
 802+ 880B
 803+ 880B                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 880B 11 00 58         ld   de, $5800
 805+ 880E 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 880F 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 8810
 808+ 8810              .next_anim_item:
 809+ 8810 01 05 00         ld   bc, 5
 810+ 8813 FD 09            add  iy, bc
 811+ 8815 18 C4            jr   .anim_loop
 812+ 8817
 813+ 8817              .anim_done:
 814+ 8817 FD E1            pop  iy
 815+ 8819 C1               pop  bc
 816+ 881A D1               pop  de
 817+ 881B E1               pop  hl
 818+ 881C C9               ret

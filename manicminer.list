 106+ 7D1F              ; Items_ResetCurrentRoomItems
 107+ 7D1F              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
 108+ 7D1F              ; per tutti gli item della stanza corrente puntata da (room_ptr).
 109+ 7D1F              ; -------------------------------------------------------------------
 110+ 7D1F              Items_ResetCurrentRoomItems:
 111+ 7D1F E5               push hl
 112+ 7D20 D5               push de
 113+ 7D21 F5               push af
 114+ 7D22
 115+ 7D22 2A 2D 96         ld   hl, (room_ptr)

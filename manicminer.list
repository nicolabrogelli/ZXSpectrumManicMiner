 399  88FA 79               ld   a, c
 400  88FB CB 3F            srl  a
 401  88FD CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 402  88FF E6 07            and  7
 403  8901 5F               ld   e, a
 404  8902 16 00            ld   d, 0
 405  8904 21 D1 65         ld   hl, game_over_color_table
 406  8907 19               add  hl, de
 407  8908 7E               ld   a, (hl)               ; A = nuovo colore attributo
 408  8909 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 409  890C 06 09            ld   b, 9

 440+ 7F75 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7F78 28 08            jr   z, .h_rev_right
 442+ 7F7A 38 06            jr   c, .h_rev_right
 443+ 7F7C DD 77 02         ld   (ix+2), a

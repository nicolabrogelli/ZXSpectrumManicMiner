 288  858C              ; ShowTitleScreen
 289  858C              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  858C              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  858C              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  858C              ; -------------------------------------------------------------------
 293  858C              ShowTitleScreen:
 294  858C                  ; 1. Disegna la schermata iniziale
 295  858C CD 76 64         call Gfx_DrawTitleScreen
 296  858F
 297  858F                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  858F              .wait_title_enter_release:
 299  858F 76               halt
 300  8590 3E BF            ld   a, $bf
 301  8592 DB FE            in   a, ($fe)
 302  8594 1F               rra
 303  8595 30 F8            jr   nc, .wait_title_enter_release
 304  8597
 305  8597                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  8597 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  8599              .title_loop:
 308  8599 76               halt
 309  859A
 310  859A                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  859A 0C               inc  c
 312  859B 79               ld   a, c
 313  859C CB 3F            srl  a
 314  859E CB 3F            srl  a
 315  85A0 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85A2 E6 07            and  7
 317  85A4 5F               ld   e, a
 318  85A5 16 00            ld   d, 0
 319  85A7 21 6E 64         ld   hl, title_color_table
 320  85AA 19               add  hl, de
 321  85AB 7E               ld   a, (hl)               ; A = nuovo colore
 322  85AC 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85AF 06 20            ld   b, 32
 324  85B1              .color_title_loop:
 325  85B1 77               ld   (hl), a
 326  85B2 23               inc  hl
 327  85B3 10 FC            djnz .color_title_loop
 328  85B5
 329  85B5                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85B5 3E BF            ld   a, $bf
 331  85B7 DB FE            in   a, ($fe)
 332  85B9 1F               rra
 333  85BA 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  85BC
 335  85BC                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  85BC              .wait_title_enter_release_after:
 337  85BC 76               halt
 338  85BD 3E BF            ld   a, $bf
 339  85BF DB FE            in   a, ($fe)
 340  85C1 1F               rra
 341  85C2 30 F8            jr   nc, .wait_title_enter_release_after
 342  85C4
 343  85C4                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  85C4 AF               xor  a
 345  85C5 D3 FE            out  ($fe), a              ; Bordo a nero
 346  85C7 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  85CA
 348  85CA                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 349  85CA CD 31 88         call ResetFullGameState

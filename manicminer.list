 453+ 82E5                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 82E5 C6 0F            add  a, 15
 455+ 82E7 BB               cp   e
 456+ 82E8 28 04            jr   z, .y_check
 457+ 82EA 30 02            jr   nc, .y_check
 458+ 82EC 18 23            jr   .no_collision

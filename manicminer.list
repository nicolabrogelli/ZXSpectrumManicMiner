  86+ 8073 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 8075 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 8076 23               inc  hl                        ; +2 (Attr Address High)
  89+ 8077 23               inc  hl                        ; +3 (Anim mask)
  90+ 8078 23               inc  hl                        ; +4 (Collected flag)
  91+ 8079 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 807B 23               inc  hl                        ; Avanza al prossimo item
  93+ 807C 18 F2            jr   .item_loop
  94+ 807E
  95+ 807E              .next_room:
  96+ 807E E1               pop  hl
  97+ 807F C1               pop  bc
  98+ 8080 10 E4            djnz .room_loop
  99+ 8082
 100+ 8082 C1               pop  bc
 101+ 8083 D1               pop  de
 102+ 8084 E1               pop  hl
 103+ 8085 C9               ret

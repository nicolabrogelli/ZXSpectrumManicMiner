1152+ 644C D3 FE            out  ($fe), a              ; Bordo a nero
1153+ 644E 21 8D 5C         ld   hl, ATTR_P
1154+ 6451 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1155+ 6452 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1156+ 6455 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1157+ 6457 3E 07            ld   a, $07
1158+ 6459 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1159+ 645C
1160+ 645C                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1161+ 645C                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1162+ 645C 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1163+ 645F DD 21 B9 87      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1164+ 6463 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1165+ 6466
1166+ 6466                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1167+ 6466 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1168+ 6469 DD 21 C1 87      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1169+ 646D CD 3F 5E         call Gfx_DrawPixelSprite8x8

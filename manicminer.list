 238+ 7E01              ; -------------------------------------------------------------------
 239+ 7E01              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 240+ 7E01              ; -------------------------------------------------------------------
 241+ 7E01              CheckEnemyWillyOverlap:
 242+ 7E01 3A E1 E3         ld   a, (player_drawn_pos+1)
 243+ 7E04 FE FF            cp   $FF
 244+ 7E06 C8               ret  z                  ; Se Willy non è disegnato, esci
 245+ 7E07
 246+ 7E07                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 247+ 7E07 3A E0 E3         ld   a, (player_drawn_pos)
 248+ 7E0A E6 F8            and  $F8
 249+ 7E0C 5F               ld   e, a               ; E = WillyX & $F8
 250+ 7E0D 79               ld   a, c
 251+ 7E0E E6 F8            and  $F8                ; A = EnemyX & $F8
 252+ 7E10 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 253+ 7E11 C6 10            add  a, 16
 254+ 7E13 FE 19            cp   25
 255+ 7E15 D0               ret  nc                 ; Fuori portata X
 256+ 7E16
 257+ 7E16                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 258+ 7E16 3A E1 E3         ld   a, (player_drawn_pos+1) ; A = WillyY
 259+ 7E19 90               sub  b                  ; A = WillyY - EnemyY
 260+ 7E1A C6 0F            add  a, 15
 261+ 7E1C FE 1F            cp   31
 262+ 7E1E D0               ret  nc                 ; Fuori portata Y
 263+ 7E1F
 264+ 7E1F                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 265+ 7E1F 3E 01            ld   a, 1
 266+ 7E21 32 E7 E3         ld   (willy_needs_redraw), a
 267+ 7E24 C9               ret

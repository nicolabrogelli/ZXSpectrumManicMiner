   8+ 7FBD              ; Audio_UpdateJumpSound
   9+ 7FBD              ;
  10+ 7FBD              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7FBD              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7FBD              ; -------------------------------------------------------------------
  13+ 7FBD              Audio_UpdateJumpSound:
  14+ 7FBD F5               push af
  15+ 7FBE C5               push bc
  16+ 7FBF D5               push de
  17+ 7FC0 E5               push hl
  18+ 7FC1
  19+ 7FC1                  ; Controlla se il suono è attivo (note < 18)
  20+ 7FC1 3A AA 94         ld   a, (Audio_jump_sound_note)
  21+ 7FC4 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7FC6 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7FC8
  24+ 7FC8                  ; Carica la nota corrente da suonare
  25+ 7FC8 5F               ld   e, a
  26+ 7FC9 16 00            ld   d, 0
  27+ 7FCB 21 F7 7F         ld   hl, Audio_JumpSoundDelays
  28+ 7FCE 19               add  hl, de
  29+ 7FCF 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7FD0 57               ld   d, a                      ; D = delay della nota
  31+ 7FD1
  32+ 7FD1                  ; Suona la nota: 15 cicli
  33+ 7FD1 06 0F            ld   b, 15
  34+ 7FD3              .note_loop:
  35+ 7FD3                  ; Speaker ON
  36+ 7FD3 3A A0 8E         ld   a, (room_border_color)
  37+ 7FD6 F6 10            or   $10
  38+ 7FD8 D3 FE            out  ($fe), a
  39+ 7FDA 4A               ld   c, d
  40+ 7FDB              .d1:
  41+ 7FDB 0D               dec  c
  42+ 7FDC 20 FD            jr   nz, .d1
  43+ 7FDE
  44+ 7FDE                  ; Speaker OFF
  45+ 7FDE 3A A0 8E         ld   a, (room_border_color)
  46+ 7FE1 E6 EF            and  $ef
  47+ 7FE3 D3 FE            out  ($fe), a
  48+ 7FE5 4A               ld   c, d
  49+ 7FE6              .d2:
  50+ 7FE6 0D               dec  c
  51+ 7FE7 20 FD            jr   nz, .d2
  52+ 7FE9
  53+ 7FE9 10 E8            djnz .note_loop
  54+ 7FEB
  55+ 7FEB                  ; Passa alla nota successiva
  56+ 7FEB 3A AA 94         ld   a, (Audio_jump_sound_note)
  57+ 7FEE 3C               inc  a
  58+ 7FEF 32 AA 94         ld   (Audio_jump_sound_note), a
  59+ 7FF2
  60+ 7FF2              .done:
  61+ 7FF2 E1               pop  hl
  62+ 7FF3 D1               pop  de
  63+ 7FF4 C1               pop  bc
  64+ 7FF5 F1               pop  af
  65+ 7FF6 C9               ret
  66+ 7FF7
  67+ 7FF7              Audio_JumpSoundDelays:
  68+ 7FF7 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7FFB 19 13 0C 06
  68+ 7FFF 0C 13 19 20

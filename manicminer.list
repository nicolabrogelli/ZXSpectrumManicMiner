 728+ 86BF                  ; Byte 0:
 729+ 86BF 3A 30 E8         ld   a, (player_score + 0)
 730+ 86C2 47               ld   b, a
 731+ 86C3 3A 33 E8         ld   a, (high_score + 0)
 732+ 86C6 B8               cp   b
 733+ 86C7 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

 354  86DF              ; -------------------------------------------------------------------
 355  86DF              ; TriggerGameOver
 356  86DF              ; Scatena la schermata di Game Over per la stanza corrente.
 357  86DF              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 358  86DF              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 359  86DF              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 360  86DF              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 361  86DF              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 362  86DF              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 363  86DF              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 364  86DF              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 365  86DF              ; -------------------------------------------------------------------
 366  86DF              TriggerGameOver:
 367  86DF                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 368  86DF CD 15 66         call Gfx_DrawGameOverScreen
 369  86E2
 370  86E2                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 371  86E2              .wait_keys_release:
 372  86E2 76               halt
 373  86E3                  ; Controlla tasto Y (Porta $DF, bit 4)
 374  86E3 01 FE DF         ld   bc, $dffe
 375  86E6 ED 78            in   a, (c)
 376  86E8 CB 67            bit  4, a
 377  86EA 28 F6            jr   z, .wait_keys_release
 378  86EC
 379  86EC                  ; Controlla tasto N (Porta $7F, bit 3)
 380  86EC 01 FE 7F         ld   bc, $7ffe
 381  86EF ED 78            in   a, (c)
 382  86F1 CB 5F            bit  3, a
 383  86F3 28 ED            jr   z, .wait_keys_release
 384  86F5
 385  86F5                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  86F5 01 FE BF         ld   bc, $bffe
 387  86F8 ED 78            in   a, (c)
 388  86FA CB 47            bit  0, a
 389  86FC 28 E4            jr   z, .wait_keys_release
 390  86FE
 391  86FE                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 392  86FE 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 393  8700              .wait_choice_loop:
 394  8700 76               halt
 395  8701
 396  8701                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 397  8701 0C               inc  c
 398  8702 79               ld   a, c
 399  8703 CB 3F            srl  a
 400  8705 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 401  8707 E6 07            and  7
 402  8709 5F               ld   e, a
 403  870A 16 00            ld   d, 0
 404  870C 21 D1 65         ld   hl, game_over_color_table
 405  870F 19               add  hl, de
 406  8710 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  8711 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  8714 06 09            ld   b, 9
 409  8716              .color_cycle_loop:
 410  8716 77               ld   (hl), a
 411  8717 23               inc  hl
 412  8718 10 FC            djnz .color_cycle_loop
 413  871A
 414  871A                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  871A 01 FE DF         ld   bc, $dffe
 416  871D ED 78            in   a, (c)
 417  871F CB 67            bit  4, a
 418  8721 28 2A            jr   z, .continue_chosen
 419  8723
 420  8723                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  8723 01 FE 7F         ld   bc, $7ffe
 422  8726 ED 78            in   a, (c)
 423  8728 CB 5F            bit  3, a
 424  872A 28 0B            jr   z, .quit_chosen
 425  872C
 426  872C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  872C 01 FE BF         ld   bc, $bffe
 428  872F ED 78            in   a, (c)
 429  8731 CB 47            bit  0, a
 430  8733 28 02            jr   z, .quit_chosen
 431  8735
 432  8735 18 C9            jr   .wait_choice_loop
 433  8737
 434  8737              .quit_chosen:
 435  8737                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 436  8737              .wait_quit_release:
 437  8737 76               halt
 438  8738 01 FE 7F         ld   bc, $7ffe
 439  873B ED 78            in   a, (c)
 440  873D CB 5F            bit  3, a
 441  873F 28 F6            jr   z, .wait_quit_release
 442  8741 01 FE BF         ld   bc, $bffe
 443  8744 ED 78            in   a, (c)
 444  8746 CB 47            bit  0, a
 445  8748 28 ED            jr   z, .wait_quit_release

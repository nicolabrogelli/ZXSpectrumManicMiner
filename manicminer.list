  72+ 838E ~            ; Audio_UpdateMusic
  73+ 838E ~            ;
  74+ 838E ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 838E ~            ; Viene chiamata a ogni frame.
  76+ 838E ~            ; -------------------------------------------------------------------
  77+ 838E ~            Audio_UpdateMusic:
  78+ 838E ~                push af
  79+ 838E ~                push bc
  80+ 838E ~                push de
  81+ 838E ~                push hl
  82+ 838E ~
  83+ 838E ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 838E ~                ld   a, (Audio_jump_sound_note)
  85+ 838E ~                cp   18
  86+ 838E ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 838E ~
  88+ 838E ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 838E ~                ld   a, (Audio_music_frame_counter)
  90+ 838E ~                dec  a
  91+ 838E ~                ld   (Audio_music_frame_counter), a
  92+ 838E ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 838E ~
  94+ 838E ~                ; Altrimenti carica la nota successiva
  95+ 838E ~                ld   a, (Audio_music_note_idx)
  96+ 838E ~                inc  a
  97+ 838E ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 838E ~                jr   c, .no_wrap
  99+ 838E ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 838E ~            .no_wrap:
 101+ 838E ~                ld   (Audio_music_note_idx), a
 102+ 838E ~
 103+ 838E ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 838E ~                ld   e, a
 105+ 838E ~                ld   d, 0
 106+ 838E ~                ld   hl, Audio_MusicSheet
 107+ 838E ~                add  hl, de
 108+ 838E ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 838E ~
 110+ 838E ~                ; Leggi durata (secondo byte)
 111+ 838E ~                inc  hl
 112+ 838E ~                ld   a, (hl)
 113+ 838E ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 838E ~                jr   nz, .dur_ok
 115+ 838E ~                ld   a, 1
 116+ 838E ~            .dur_ok:
 117+ 838E ~                ld   (Audio_music_frame_counter), a
 118+ 838E ~
 119+ 838E ~            .play_current_note:
 120+ 838E ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 838E ~                ld   a, (Audio_music_note_idx)
 122+ 838E ~                ld   e, a
 123+ 838E ~                ld   d, 0
 124+ 838E ~                ld   hl, Audio_MusicSheet
 125+ 838E ~                add  hl, de
 126+ 838E ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 838E ~                ld   a, (hl)                  ; A = delay
 128+ 838E ~                or   a
 129+ 838E ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 838E ~
 131+ 838E ~                ; Suona la nota: 2 cicli
 132+ 838E ~                ld   d, a                     ; D = delay
 133+ 838E ~                ld   b, 2                     ; 2 cicli per frame
 134+ 838E ~            .note_loop:
 135+ 838E ~                ; Speaker ON
 136+ 838E ~                ld   a, (room_border_color)
 137+ 838E ~                or   $10
 138+ 838E ~                out  ($fe), a
 139+ 838E ~                ld   c, d
 140+ 838E ~            .d1:
 141+ 838E ~                push af
 142+ 838E ~                pop  af
 143+ 838E ~                dec  c
 144+ 838E ~                jr   nz, .d1
 145+ 838E ~
 146+ 838E ~                ; Speaker OFF
 147+ 838E ~                ld   a, (room_border_color)
 148+ 838E ~                and  $ef
 149+ 838E ~                out  ($fe), a
 150+ 838E ~                ld   c, d
 151+ 838E ~            .d2:
 152+ 838E ~                push af
 153+ 838E ~                pop  af
 154+ 838E ~                dec  c
 155+ 838E ~                jr   nz, .d2
 156+ 838E ~
 157+ 838E ~                djnz .note_loop
 158+ 838E ~
 159+ 838E ~            .done:
 160+ 838E ~                pop  hl
 161+ 838E ~                pop  de
 162+ 838E ~                pop  bc
 163+ 838E ~                pop  af
 164+ 838E ~                ret
 165+ 838E ~
 166+ 838E ~            Audio_MusicSheet:
 167+ 838E ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 838E ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 838E ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 838E ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 838E ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 838E ~                db 90, 10, 107, 20, 68, 65
 173+ 838E                  ELSE
 174+ 838E              Audio_UpdateMusic:
 175+ 838E C9               ret
 176+ 838F                  ENDIF

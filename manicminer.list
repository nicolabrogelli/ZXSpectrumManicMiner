 414+ 8609              ; CheckWillyItemCollision
 415+ 8609              ;
 416+ 8609              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 8609              ; Input:
 418+ 8609              ;   A = Item Col (0..31)
 419+ 8609              ;   H = Item Row (0..15)
 420+ 8609              ; Output:
 421+ 8609              ;   Carry Set = Collisione
 422+ 8609              ;   Carry Clear = Nessuna collisione
 423+ 8609              ; -------------------------------------------------------------------
 424+ 8609              CheckWillyItemCollision:
 425+ 8609 C5               push bc

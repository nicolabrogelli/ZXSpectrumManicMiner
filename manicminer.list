 161+ 7E15              ; -------------------------------------------------------------------
 162+ 7E15              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7E15              ; -------------------------------------------------------------------
 164+ 7E15              CheckEnemyWillyOverlap:
 165+ 7E15 3A 55 A2         ld   a, (player_drawn_pos+1)
 166+ 7E18 FE FF            cp   $FF
 167+ 7E1A C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7E1B
 169+ 7E1B                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7E1B 3A 54 A2         ld   a, (player_drawn_pos)
 171+ 7E1E E6 F8            and  $F8
 172+ 7E20 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7E21 79               ld   a, c
 174+ 7E22 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7E24 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7E25 C6 10            add  a, 16
 177+ 7E27 FE 19            cp   25
 178+ 7E29 D0               ret  nc                 ; Fuori portata X
 179+ 7E2A
 180+ 7E2A                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7E2A 3A 55 A2         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7E2D 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7E2E C6 0F            add  a, 15
 184+ 7E30 FE 1F            cp   31
 185+ 7E32 D0               ret  nc                 ; Fuori portata Y

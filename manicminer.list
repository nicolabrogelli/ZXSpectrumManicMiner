   8+ 7E63              ; Audio_UpdateJumpSound
   9+ 7E63              ;
  10+ 7E63              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7E63              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7E63              ; -------------------------------------------------------------------
  13+ 7E63              Audio_UpdateJumpSound:
  14+ 7E63 F5               push af
  15+ 7E64 C5               push bc
  16+ 7E65 D5               push de
  17+ 7E66 E5               push hl
  18+ 7E67
  19+ 7E67                  ; Controlla se il suono è attivo (note < 18)
  20+ 7E67 3A FF 91         ld   a, (Audio_jump_sound_note)
  21+ 7E6A FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7E6C 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7E6E
  24+ 7E6E                  ; Carica la nota corrente da suonare
  25+ 7E6E 5F               ld   e, a
  26+ 7E6F 16 00            ld   d, 0
  27+ 7E71 21 9D 7E         ld   hl, Audio_JumpSoundDelays
  28+ 7E74 19               add  hl, de
  29+ 7E75 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7E76 57               ld   d, a                      ; D = delay della nota
  31+ 7E77
  32+ 7E77                  ; Suona la nota: 15 cicli
  33+ 7E77 06 0F            ld   b, 15
  34+ 7E79              .note_loop:
  35+ 7E79                  ; Speaker ON
  36+ 7E79 3A F8 8D         ld   a, (room_border_color)
  37+ 7E7C F6 10            or   $10
  38+ 7E7E D3 FE            out  ($fe), a
  39+ 7E80 4A               ld   c, d
  40+ 7E81              .d1:
  41+ 7E81 0D               dec  c
  42+ 7E82 20 FD            jr   nz, .d1
  43+ 7E84
  44+ 7E84                  ; Speaker OFF
  45+ 7E84 3A F8 8D         ld   a, (room_border_color)
  46+ 7E87 E6 EF            and  $ef
  47+ 7E89 D3 FE            out  ($fe), a
  48+ 7E8B 4A               ld   c, d
  49+ 7E8C              .d2:
  50+ 7E8C 0D               dec  c
  51+ 7E8D 20 FD            jr   nz, .d2
  52+ 7E8F
  53+ 7E8F 10 E8            djnz .note_loop
  54+ 7E91
  55+ 7E91                  ; Passa alla nota successiva
  56+ 7E91 3A FF 91         ld   a, (Audio_jump_sound_note)
  57+ 7E94 3C               inc  a
  58+ 7E95 32 FF 91         ld   (Audio_jump_sound_note), a
  59+ 7E98
  60+ 7E98              .done:
  61+ 7E98 E1               pop  hl
  62+ 7E99 D1               pop  de
  63+ 7E9A C1               pop  bc
  64+ 7E9B F1               pop  af
  65+ 7E9C C9               ret

  72+ 86EA ~            ; Audio_UpdateMusic
  73+ 86EA ~            ;
  74+ 86EA ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 86EA ~            ; Viene chiamata a ogni frame.
  76+ 86EA ~            ; -------------------------------------------------------------------
  77+ 86EA ~            Audio_UpdateMusic:
  78+ 86EA ~                push af
  79+ 86EA ~                push bc
  80+ 86EA ~                push de
  81+ 86EA ~                push hl
  82+ 86EA ~
  83+ 86EA ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 86EA ~                ld   a, (Audio_jump_sound_note)
  85+ 86EA ~                cp   18
  86+ 86EA ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 86EA ~
  88+ 86EA ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 86EA ~                ld   a, (Audio_music_frame_counter)
  90+ 86EA ~                dec  a
  91+ 86EA ~                ld   (Audio_music_frame_counter), a
  92+ 86EA ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 86EA ~
  94+ 86EA ~                ; Altrimenti carica la nota successiva
  95+ 86EA ~                ld   a, (Audio_music_note_idx)
  96+ 86EA ~                inc  a
  97+ 86EA ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 86EA ~                jr   c, .no_wrap
  99+ 86EA ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 86EA ~            .no_wrap:
 101+ 86EA ~                ld   (Audio_music_note_idx), a
 102+ 86EA ~
 103+ 86EA ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 86EA ~                ld   e, a
 105+ 86EA ~                ld   d, 0
 106+ 86EA ~                ld   hl, Audio_MusicSheet
 107+ 86EA ~                add  hl, de
 108+ 86EA ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 86EA ~
 110+ 86EA ~                ; Leggi durata (secondo byte)
 111+ 86EA ~                inc  hl
 112+ 86EA ~                ld   a, (hl)
 113+ 86EA ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 86EA ~                jr   nz, .dur_ok
 115+ 86EA ~                ld   a, 1
 116+ 86EA ~            .dur_ok:
 117+ 86EA ~                ld   (Audio_music_frame_counter), a
 118+ 86EA ~
 119+ 86EA ~            .play_current_note:
 120+ 86EA ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 86EA ~                ld   a, (Audio_music_note_idx)
 122+ 86EA ~                ld   e, a
 123+ 86EA ~                ld   d, 0
 124+ 86EA ~                ld   hl, Audio_MusicSheet
 125+ 86EA ~                add  hl, de
 126+ 86EA ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 86EA ~                ld   a, (hl)                  ; A = delay
 128+ 86EA ~                or   a
 129+ 86EA ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 86EA ~
 131+ 86EA ~                ; Suona la nota: 2 cicli
 132+ 86EA ~                ld   d, a                     ; D = delay
 133+ 86EA ~                ld   b, 2                     ; 2 cicli per frame
 134+ 86EA ~            .note_loop:
 135+ 86EA ~                ; Speaker ON
 136+ 86EA ~                ld   a, (room_border_color)
 137+ 86EA ~                or   $10
 138+ 86EA ~                out  ($fe), a
 139+ 86EA ~                ld   c, d
 140+ 86EA ~            .d1:
 141+ 86EA ~                push af
 142+ 86EA ~                pop  af
 143+ 86EA ~                dec  c
 144+ 86EA ~                jr   nz, .d1
 145+ 86EA ~
 146+ 86EA ~                ; Speaker OFF
 147+ 86EA ~                ld   a, (room_border_color)
 148+ 86EA ~                and  $ef
 149+ 86EA ~                out  ($fe), a
 150+ 86EA ~                ld   c, d
 151+ 86EA ~            .d2:
 152+ 86EA ~                push af
 153+ 86EA ~                pop  af
 154+ 86EA ~                dec  c
 155+ 86EA ~                jr   nz, .d2
 156+ 86EA ~
 157+ 86EA ~                djnz .note_loop
 158+ 86EA ~
 159+ 86EA ~            .done:
 160+ 86EA ~                pop  hl
 161+ 86EA ~                pop  de
 162+ 86EA ~                pop  bc
 163+ 86EA ~                pop  af
 164+ 86EA ~                ret

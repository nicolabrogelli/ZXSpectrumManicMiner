 292+ 86A3              ; -------------------------------------------------------------------
 293+ 86A3              ; DrawItemGraphic
 294+ 86A3              ;
 295+ 86A3              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 86A3              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 86A3              ;
 298+ 86A3              ; Input:
 299+ 86A3              ;   B = Riga attributi (0..23)
 300+ 86A3              ;   C = Colonna attributi (0..31)
 301+ 86A3              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 86A3              ;   E = Attributo colore
 303+ 86A3              ; -------------------------------------------------------------------
 304+ 86A3              DrawItemGraphic:
 305+ 86A3 C5               push bc
 306+ 86A4 D5               push de
 307+ 86A5 E5               push hl
 308+ 86A6
 309+ 86A6                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 310+ 86A6 78               ld   a, b
 311+ 86A7 E6 18            and  $18
 312+ 86A9 C6 40            add  a, $40
 313+ 86AB 57               ld   d, a                      ; Byte alto indirizzo video
 314+ 86AC
 315+ 86AC 78               ld   a, b
 316+ 86AD E6 07            and  7
 317+ 86AF 87               add  a, a                      ; *2
 318+ 86B0 87               add  a, a                      ; *4
 319+ 86B1 87               add  a, a                      ; *8
 320+ 86B2 87               add  a, a                      ; *16
 321+ 86B3 87               add  a, a                      ; *32
 322+ 86B4 81               add  a, c                      ; + Col
 323+ 86B5 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 86B6
 325+ 86B6 C5               push bc
 326+ 86B7 06 08            ld   b, 8                      ; 8 scanline
 327+ 86B9              .line_loop:
 328+ 86B9 7E               ld   a, (hl)
 329+ 86BA 12               ld   (de), a
 330+ 86BB 14               inc  d
 331+ 86BC 23               inc  hl
 332+ 86BD 05               dec  b
 333+ 86BE 20 F9            jr   nz, .line_loop
 334+ 86C0 C1               pop  bc
 335+ 86C1
 336+ 86C1                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 337+ 86C1 26 00            ld   h, 0
 338+ 86C3 68               ld   l, b
 339+ 86C4 29               add  hl, hl
 340+ 86C5 29               add  hl, hl
 341+ 86C6 29               add  hl, hl
 342+ 86C7 29               add  hl, hl
 343+ 86C8 29               add  hl, hl                    ; Row * 32
 344+ 86C9 79               ld   a, c
 345+ 86CA 85               add  a, l
 346+ 86CB 6F               ld   l, a
 347+ 86CC 30 01            jr   nc, .no_carry
 348+ 86CE 24               inc  h
 349+ 86CF              .no_carry:
 350+ 86CF 11 00 58         ld   de, COLOR_DATA
 351+ 86D2 19               add  hl, de
 352+ 86D3
 353+ 86D3 C1               pop  bc                        ; Recupera HL originale
 354+ 86D4 D1               pop  de                        ; Recupera DE originale (E = colore)
 355+ 86D5 7B               ld   a, e
 356+ 86D6 77               ld   (hl), a                   ; Scrive l'attributo colore
 357+ 86D7
 358+ 86D7 C5               push bc
 359+ 86D8 E1               pop  hl
 360+ 86D9 C1               pop  bc
 361+ 86DA C9               ret

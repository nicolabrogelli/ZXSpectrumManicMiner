 316+ 7EAF              ; Enemy_DrawSingleSlot
 317+ 7EAF              ;
 318+ 7EAF              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7EAF              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7EAF              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7EAF              ; -------------------------------------------------------------------
 322+ 7EAF              Enemy_DrawSingleSlot:
 323+ 7EAF C5               push bc
 324+ 7EB0 D5               push de
 325+ 7EB1 E5               push hl
 326+ 7EB2 DD E5            push ix
 327+ 7EB4
 328+ 7EB4                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EB4                  ; Nei dati di Manic Miner:
 330+ 7EB4                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EB4                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EB4 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EB7 E6 03            and  3
 334+ 7EB9 47               ld   b, a                      ; B = Anim subframe
 335+ 7EBA
 336+ 7EBA DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EBD FE 01            cp   1                         ; Sinistra?
 338+ 7EBF 28 03            jr   z, .left_frames
 339+ 7EC1
 340+ 7EC1                  ; Movimento a Destra: Frame 0..3
 341+ 7EC1 78               ld   a, b
 342+ 7EC2 18 03            jr   .got_frame_idx

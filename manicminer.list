 361+ 7E94              ; -------------------------------------------------------------------
 362+ 7E94              ; CheckWillyItemCollision
 363+ 7E94              ;
 364+ 7E94              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 365+ 7E94              ; Input:
 366+ 7E94              ;   A = Item Col (0..31)
 367+ 7E94              ;   H = Item Row (0..15)
 368+ 7E94              ; Output:
 369+ 7E94              ;   Carry Set = Collisione
 370+ 7E94              ;   Carry Clear = Nessuna collisione
 371+ 7E94              ; -------------------------------------------------------------------
 372+ 7E94              CheckWillyItemCollision:
 373+ 7E94 C5               push bc
 374+ 7E95 D5               push de
 375+ 7E96 E5               push hl
 376+ 7E97
 377+ 7E97                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 378+ 7E97 6F               ld   l, a
 379+ 7E98 87               add  a, a                      ; *2
 380+ 7E99 87               add  a, a                      ; *4
 381+ 7E9A 87               add  a, a                      ; *8
 382+ 7E9B 5F               ld   e, a                      ; E = ItemLeft
 383+ 7E9C C6 07            add  a, 7
 384+ 7E9E 57               ld   d, a                      ; D = ItemRight
 385+ 7E9F
 386+ 7E9F ED 4B 94 8E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 387+ 7EA3
 388+ 7EA3                  ; WillyLeft <= ItemRight
 389+ 7EA3 79               ld   a, c
 390+ 7EA4 BA               cp   d
 391+ 7EA5 28 04            jr   z, .x_ok
 392+ 7EA7 38 02            jr   c, .x_ok
 393+ 7EA9 18 29            jr   .no_collision
 394+ 7EAB
 395+ 7EAB              .x_ok:
 396+ 7EAB                  ; WillyRight >= ItemLeft (WillyRight = WillyX + 7 o 15)
 397+ 7EAB C6 07            add  a, 7
 398+ 7EAD BB               cp   e
 399+ 7EAE 28 04            jr   z, .y_check
 400+ 7EB0 30 02            jr   nc, .y_check
 401+ 7EB2 18 20            jr   .no_collision
 402+ 7EB4
 403+ 7EB4              .y_check:
 404+ 7EB4 E1               pop  hl
 405+ 7EB5 E5               push hl
 406+ 7EB6
 407+ 7EB6                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 408+ 7EB6 7C               ld   a, h
 409+ 7EB7 87               add  a, a                      ; *2
 410+ 7EB8 87               add  a, a                      ; *4
 411+ 7EB9 87               add  a, a                      ; *8
 412+ 7EBA 5F               ld   e, a                      ; ItemTop
 413+ 7EBB C6 07            add  a, 7
 414+ 7EBD 57               ld   d, a                      ; ItemBottom
 415+ 7EBE
 416+ 7EBE                  ; WillyTop <= ItemBottom
 417+ 7EBE 78               ld   a, b
 418+ 7EBF BA               cp   d
 419+ 7EC0 28 04            jr   z, .y_ok
 420+ 7EC2 38 02            jr   c, .y_ok
 421+ 7EC4 18 0E            jr   .no_collision
 422+ 7EC6
 423+ 7EC6              .y_ok:
 424+ 7EC6                  ; WillyBottom >= ItemTop (WillyBottom = WillyY + 15)
 425+ 7EC6 C6 0F            add  a, 15
 426+ 7EC8 BB               cp   e
 427+ 7EC9 28 04            jr   z, .collision
 428+ 7ECB 30 02            jr   nc, .collision
 429+ 7ECD 18 05            jr   .no_collision
 430+ 7ECF
 431+ 7ECF              .collision:
 432+ 7ECF E1               pop  hl
 433+ 7ED0 D1               pop  de
 434+ 7ED1 C1               pop  bc
 435+ 7ED2 37               scf
 436+ 7ED3 C9               ret
 437+ 7ED4
 438+ 7ED4              .no_collision:
 439+ 7ED4 E1               pop  hl
 440+ 7ED5 D1               pop  de
 441+ 7ED6 C1               pop  bc
 442+ 7ED7 B7               or   a
 443+ 7ED8 C9               ret

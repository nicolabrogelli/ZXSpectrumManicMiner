 848+ 774B              ; -------------------------------------------------------------------
 849+ 774B              IsCellOnRamp:
 850+ 774B C5               push bc
 851+ 774C E5               push hl
 852+ 774D
 853+ 774D 3A 3F E2         ld   a, (ramp_len)
 854+ 7750 B7               or   a
 855+ 7751 28 6B            jr   z, .no
 856+ 7753
 857+ 7753                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 858+ 7753 3A 3E E2         ld   a, (ramp_dir)
 859+ 7756 B7               or   a
 860+ 7757 28 1A            jr   z, .range_left
 861+ 7759              .range_right:
 862+ 7759 3A 41 E2         ld   a, (ramp_col)
 863+ 775C 47               ld   b, a              ; B = ramp_col
 864+ 775D 3A 3F E2         ld   a, (ramp_len)
 865+ 7760 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7761 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7762
 868+ 7762 7B               ld   a, e              ; A = Col
 869+ 7763 B8               cp   b
 870+ 7764 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7766 B9               cp   c
 872+ 7767 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 7769

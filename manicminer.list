 138+ 7D5B              .done_h_guardians:
 139+ 7D5B                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7D5B 2A 6B E2         ld   hl, (room_ptr)
 141+ 7D5E 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7D61 19               add  hl, de
 143+ 7D62
 144+ 7D62 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 145+ 7D64              .load_v_loop:
 146+ 7D64 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 147+ 7D65 FE FF            cp   $FF
 148+ 7D67 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 149+ 7D69 B7               or   a
 150+ 7D6A 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 151+ 7D6C
 152+ 7D6C                  ; Slot attivo per guardiano verticale
 153+ 7D6C DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 154+ 7D70 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 155+ 7D73
 156+ 7D73 23               inc  hl
 157+ 7D74 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 158+ 7D75 E6 03            and  3
 159+ 7D77 C6 04            add  a, 4                      ; Frame 4..7 in OFFSET_GUARDIAN_GRAPHICS
 160+ 7D79 DD 77 01         ld   (ix+1), a                 ; Frame index (4..7)
 161+ 7D7C
 162+ 7D7C 23               inc  hl
 163+ 7D7D 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 164+ 7D7E DD 77 03         ld   (ix+3), a                 ; Current Y
 165+ 7D81
 166+ 7D81 23               inc  hl
 167+ 7D82 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 168+ 7D83 E6 1F            and  31
 169+ 7D85 87               add  a, a
 169+ 7D86 87             add a, a
 169+ 7D87 87             add a, a ; * 8 -> X pixel
 170+ 7D88 DD 77 02         ld   (ix+2), a                 ; Current X
 171+ 7D8B
 172+ 7D8B 23               inc  hl
 173+ 7D8C 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 174+ 7D8D E6 03            and  3
 175+ 7D8F 20 02            jr   nz, .v_step_ok
 176+ 7D91 3E 01            ld   a, 1
 177+ 7D93              .v_step_ok:
 178+ 7D93 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 179+ 7D96 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 180+ 7D98 DD 77 06         ld   (ix+6), a
 181+ 7D9B
 182+ 7D9B 23               inc  hl
 183+ 7D9C 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 184+ 7D9D DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 185+ 7DA0
 186+ 7DA0 23               inc  hl
 187+ 7DA1 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 188+ 7DA2 DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 189+ 7DA5
 190+ 7DA5 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 191+ 7DA6 11 0B 00         ld   de, 11
 192+ 7DA9 DD 19            add  ix, de
 193+ 7DAB 10 B7            djnz .load_v_loop

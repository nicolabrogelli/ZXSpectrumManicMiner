  14+ 7E4B              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7E4B              ; Offset 2: Current X
  16+ 7E4B              ; Offset 3: Current Y
  17+ 7E4B              ; Offset 4: Min Limit
  18+ 7E4B              ; Offset 5: Max Limit
  19+ 7E4B              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7E4B              ; Offset 7: Anim State (0..3)
  21+ 7E4B              ; Offset 8: Old X
  22+ 7E4B              ; Offset 9: Old Y
  23+ 7E4B              ; Offset 10: Color (Attributo Spectrum)
  24+ 7E4B              ; -------------------------------------------------------------------

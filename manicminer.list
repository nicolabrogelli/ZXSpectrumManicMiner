   6+ 6B26              ; MovePlayer
   7+ 6B26              ;
   8+ 6B26              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6B26              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6B26              ; con i muri.
  11+ 6B26              ;
  12+ 6B26              ; Input:
  13+ 6B26              ;   D = stato dei controlli (bitfield)
  14+ 6B26              ;
  15+ 6B26              ; Strutture utilizzate:
  16+ 6B26              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6B26              ;   player_speed    -> velocità orizzontale
  18+ 6B26              ;   flags           -> flag di stato input
  19+ 6B26              ;
  20+ 6B26              ; Bit controlli:
  21+ 6B26              ;   bit 0 = sinistra
  22+ 6B26              ;   bit 1 = destra
  23+ 6B26              ;
  24+ 6B26              ; Nota:
  25+ 6B26              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6B26              ;   ignorato per tutta la durata del salto.
  27+ 6B26              ;
  28+ 6B26              ; Output:
  29+ 6B26              ;   aggiorna PlayerPos e body_state
  30+ 6B26              ; -------------------------------------------------------------------
  31+ 6B26              MovePlayer:
  32+ 6B26
  33+ 6B26                  ; ---------------------------------------------------------------
  34+ 6B26                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6B26                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6B26                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6B26                  ; ---------------------------------------------------------------
  38+ 6B26 3A B6 8D         ld   a, (on_ground)
  39+ 6B29 B7               or   a
  40+ 6B2A 20 1A            jr   nz, .on_ground_check
  41+ 6B2C
  42+ 6B2C 3A BB 8D         ld   a, (jump_dir)
  43+ 6B2F B7               or   a
  44+ 6B30 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6B31
  46+ 6B31                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6B31 DD 21 AF 8D      ld   ix, flags
  48+ 6B35 DD CB 00 86      res  $00, (ix)
  49+ 6B39
  50+ 6B39 ED 4B A7 8D      ld   bc, (PlayerPos)
  51+ 6B3D FE 01            cp   1
  52+ 6B3F 28 1D            jr   z, movePlayer_left
  53+ 6B41 FE 02            cp   2
  54+ 6B43 28 6A            jr   z, movePlayer_right
  55+ 6B45 C9               ret
  56+ 6B46
  57+ 6B46              .on_ground_check:
  58+ 6B46                  ; ---------------------------------------------------------------
  59+ 6B46                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6B46                  ; ---------------------------------------------------------------
  61+ 6B46 DD 21 AF 8D      ld   ix, flags
  62+ 6B4A DD CB 00 46      bit  $00, (ix)
  63+ 6B4E C8               ret  z
  64+ 6B4F
  65+ 6B4F DD CB 00 86      res  $00, (ix)
  66+ 6B53
  67+ 6B53 ED 4B A7 8D      ld   bc, (PlayerPos)
  68+ 6B57
  69+ 6B57              .ground_input:
  70+ 6B57                  ; ---------------------------------------------------------------
  71+ 6B57                  ; Input: destra?
  72+ 6B57                  ; ---------------------------------------------------------------
  73+ 6B57 CB 4A            bit  $01, d
  74+ 6B59 20 54            jr   nz, movePlayer_right
  75+ 6B5B
  76+ 6B5B                  ; ---------------------------------------------------------------
  77+ 6B5B                  ; Input: sinistra?
  78+ 6B5B                  ; ---------------------------------------------------------------
  79+ 6B5B CB 42            bit  $00, d

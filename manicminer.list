1188+ 755A              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1189+ 755A              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1190+ 755A              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1191+ 755A              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1192+ 755A              ; -------------------------------------------------------------------
1193+ 755A              UnpackRoomLayout:
1194+ 755A E5               push hl
1195+ 755B D5               push de
1196+ 755C C5               push bc
1197+ 755D DD E5            push ix
1198+ 755F
1199+ 755F DD 2A 2D 96      ld   ix, (room_ptr)

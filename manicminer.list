 901  8831              ; -------------------------------------------------------------------
 902  8831              ; ResetFullGameState
 903  8831              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 904  8831              ; per l'avvio di una nuova partita dopo il Game Over.
 905  8831              ; -------------------------------------------------------------------
 906  8831              ResetFullGameState:
 907  8831                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 908  8831 AF               xor  a
 909  8832 D3 FE            out  ($fe), a              ; Bordo a nero
 910  8834 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 911  8837
 912  8837                  ; Ripristina il numero di vite iniziali
 913  8837 3E 07            ld   a, INITIAL_LIVES
 914  8839 32 D8 B2         ld   (willy_lives), a
 915  883C
 916  883C                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 917  883C AF               xor  a
 918  883D 32 D5 B2         ld   (items_collected), a
 919  8840 32 D1 B2         ld   (body_state), a
 920  8843 32 E4 B2         ld   (w_warp_state), a
 921  8846 32 E7 B2         ld   (w_key_prev), a
 922  8849 32 E8 B2         ld   (enter_key_prev), a
 923  884C 32 D9 B2         ld   (velocity_y), a
 924  884F 32 DB B2         ld   (jump_pressed), a
 925  8852 32 DD B2         ld   (coyote_timer), a
 926  8855 32 E0 B2         ld   (jump_frame), a
 927  8858 32 DF B2         ld   (jump_dir), a
 928  885B 32 52 B6         ld   (transition_active), a
 929  885E 32 D6 B6         ld   (willy_safety_timer), a
 930  8861 3E FF            ld   a, $ff
 931  8863 32 E9 B2         ld   (digit_key_prev), a
 932  8866 3E 01            ld   a, 1
 933  8868 32 E2 B2         ld   (q_prev), a
 934  886B 32 E3 B2         ld   (a_prev), a
 935  886E 32 DA B2         ld   (on_ground), a
 936  8871
 937  8871                  ; Azzeramento punteggio partita corrente (Score = 000000)
 938  8871                  ; Nota: High score viene mantenuto intatto tra le partite
 939  8871 AF               xor  a
 940  8872 32 DB B8         ld   (player_score + 0), a
 941  8875 32 DC B8         ld   (player_score + 1), a
 942  8878 32 DD B8         ld   (player_score + 2), a
 943  887B
 944  887B                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 945  887B CD 29 81         call ResetItemsTable
 946  887E
 947  887E                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 948  887E CD 05 70         call InitRoomEntryPositions
 949  8881
 950  8881                  ; Aggiorna la riga di stato con High score e Score azzerato
 951  8881 CD AE 68         call Gfx_UpdateScoreDisplay
 952  8884
 953  8884                  ; Ripristina la stanza iniziale (Central Cavern)
 954  8884 21 8B 88         ld   hl, CentralCavernLayout
 955  8887 22 4C B6         ld   (room_ptr), hl
 956  888A
 957  888A C9               ret

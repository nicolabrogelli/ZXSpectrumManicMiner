 267+ 7EA2 87               add  a, a                      ; *8
 268+ 7EA3 87               add  a, a                      ; *16
 269+ 7EA4 87               add  a, a                      ; *32
 270+ 7EA5 81               add  a, c                      ; + Col
 271+ 7EA6 5F               ld   e, a                      ; Byte basso indirizzo video
 272+ 7EA7
 273+ 7EA7 C5               push bc
 274+ 7EA8 06 08            ld   b, 8                      ; 8 scanline
 275+ 7EAA              .line_loop:
 276+ 7EAA 7E               ld   a, (hl)
 277+ 7EAB 12               ld   (de), a
 278+ 7EAC 14               inc  d
 279+ 7EAD 23               inc  hl
 280+ 7EAE 05               dec  b
 281+ 7EAF 20 F9            jr   nz, .line_loop
 282+ 7EB1 C1               pop  bc
 283+ 7EB2
 284+ 7EB2                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 285+ 7EB2 26 00            ld   h, 0

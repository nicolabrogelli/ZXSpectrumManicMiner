 639  8BC6              ; -------------------------------------------------------------------
 640  8BC6              ; Air_DepleteCountdown
 641  8BC6              ; Animazione originale di completamento livello (Manic Miner):
 642  8BC6              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 643  8BC6              ; - Ad ogni pixel decrementato:
 644  8BC6              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 645  8BC6              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 646  8BC6              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 647  8BC6              ; -------------------------------------------------------------------
 648  8BC6              Air_DepleteCountdown:
 649  8BC6 F5               push af
 650  8BC7 C5               push bc
 651  8BC8 D5               push de
 652  8BC9 E5               push hl
 653  8BCA
 654  8BCA              .countdown_loop:
 655  8BCA 3A 26 F1         ld   a, (air_pixels)
 656  8BCD B7               or   a
 657  8BCE 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 658  8BD0
 659  8BD0 3D               dec  a
 660  8BD1 32 26 F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 661  8BD4
 662  8BD4                  ; Aggiorna la barra grafica dell'aria
 663  8BD4 CD 2D 6A         call Gfx_UpdateAirBar
 664  8BD7
 665  8BD7                  ; Aggiungi 1 punto allo score
 666  8BD7 CD C7 87         call Score_Add1Point
 667  8BDA
 668  8BDA                  ; Genera l'effetto sonoro originale di Manic Miner:
 669  8BDA                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 670  8BDA 3A 26 F1         ld   a, (air_pixels)
 671  8BDD 2F               cpl
 672  8BDE E6 3F            and  63
 673  8BE0 07               rlca
 674  8BE1 3C               inc  a
 675  8BE2 57               ld   d, a                      ; D = ritardo semionda audio
 676  8BE3
 677  8BE3 0E 03            ld   c, 3                      ; Durata impulso
 678  8BE5              .audio_loop:
 679  8BE5 AF               xor  a
 680  8BE6 D3 FE            out  ($fe), a
 681  8BE8 42               ld   b, d
 682  8BE9 10 FE        .w1: djnz .w1
 683  8BEB
 684  8BEB 3E 18            ld   a, $18
 685  8BED D3 FE            out  ($fe), a
 686  8BEF 42               ld   b, d
 687  8BF0 10 FE        .w2: djnz .w2
 688  8BF2
 689  8BF2 0D               dec  c
 690  8BF3 20 F0            jr   nz, .audio_loop
 691  8BF5
 692  8BF5 18 D3            jr   .countdown_loop
 693  8BF7
 694  8BF7              .done_countdown:
 695  8BF7 E1               pop  hl
 696  8BF8 D1               pop  de
 697  8BF9 C1               pop  bc
 698  8BFA F1               pop  af
 699  8BFB C9               ret
 700  8BFC

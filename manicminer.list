 293+ 6C1A 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6C1D 19               add  hl, de
 295+ 6C1E
 296+ 6C1E                  ; Byte 0: Y * 2
 297+ 6C1E 7E               ld   a, (hl)
 298+ 6C1F CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6C21 57               ld   d, a                      ; D = PlayerY
 300+ 6C22
 301+ 6C22                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6C22 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6C23 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6C24 7E               ld   a, (hl)
 305+ 6C25 E6 01            and  1
 306+ 6C27 28 04            jr   z, .facing_right
 307+ 6C29 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6C2B 18 02            jr   .set_dir
 309+ 6C2D              .facing_right:
 310+ 6C2D 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6C2F              .set_dir:
 312+ 6C2F 32 AE 8D         ld   (direction), a
 313+ 6C32
 314+ 6C32                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6C32 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6C33 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6C34 4E               ld   c, (hl)
 318+ 6C35 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6C36 7E               ld   a, (hl)
 320+ 6C37
 321+ 6C37                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6C37 67               ld   h, a
 323+ 6C38 69               ld   l, c

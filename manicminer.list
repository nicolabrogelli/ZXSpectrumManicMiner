 349  84D9                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 350  84D9 AF               xor  a
 351  84DA D3 FE            out  ($fe), a              ; Bordo a nero
 352  84DC 21 8D 5C         ld   hl, ATTR_P
 353  84DF 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 354  84E0 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 355  84E3 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 356  84E5 3E 07            ld   a, $07
 357  84E7 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 358  84EA
 359  84EA                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 360  84EA CD 5F 87         call ResetFullGameState
 361  84ED
 362  84ED                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 363  84ED C3 5D 83         jp   LoadRoomAndRestart
 364  84F0
 365  84F0              ; -------------------------------------------------------------------
 366  84F0              ; TriggerGameOver
 367  84F0              ; Scatena la schermata di Game Over per la stanza corrente.
 368  84F0              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 369  84F0              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 370  84F0              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 371  84F0              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 372  84F0              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 373  84F0              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 374  84F0              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 375  84F0              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 376  84F0              ; -------------------------------------------------------------------
 377  84F0              TriggerGameOver:
 378  84F0                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 379  84F0 CD DE 65         call Gfx_DrawGameOverScreen

 307+ 7E2F FE FF            cp   $FF
 308+ 7E31 28 16            jr   z, .do_draw_slot
 309+ 7E33
 310+ 7E33                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 311+ 7E33 DD 7E 08         ld   a, (ix+8)         ; Old X
 312+ 7E36 DD BE 02         cp   (ix+2)            ; Current X
 313+ 7E39 20 0E            jr   nz, .do_draw_slot
 314+ 7E3B DD 7E 09         ld   a, (ix+9)         ; Old Y
 315+ 7E3E DD BE 03         cp   (ix+3)            ; Current Y
 316+ 7E41 20 06            jr   nz, .do_draw_slot
 317+ 7E43
 318+ 7E43 3A E8 CA         ld   a, (enemy_was_updated)
 319+ 7E46 B7               or   a
 320+ 7E47 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!

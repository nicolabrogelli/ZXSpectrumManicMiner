 438+ 7014
 439+ 7014                  ; Calcola indirizzo di OFFSET_POS_WILLY
 440+ 7014 21 68 02         ld   hl, OFFSET_POS_WILLY
 441+ 7017 19               add  hl, de                    ; HL = layout + OFFSET_POS_WILLY
 442+ 7018
 443+ 7018 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 444+ 7019 CB 3F            srl  a

  72+ 842E ~            ; Audio_UpdateMusic
  73+ 842E ~            ;
  74+ 842E ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 842E ~            ; Viene chiamata a ogni frame.
  76+ 842E ~            ; -------------------------------------------------------------------
  77+ 842E ~            Audio_UpdateMusic:
  78+ 842E ~                push af
  79+ 842E ~                push bc
  80+ 842E ~                push de
  81+ 842E ~                push hl
  82+ 842E ~
  83+ 842E ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 842E ~                ld   a, (Audio_jump_sound_note)
  85+ 842E ~                cp   18
  86+ 842E ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 842E ~
  88+ 842E ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 842E ~                ld   a, (Audio_music_frame_counter)
  90+ 842E ~                dec  a
  91+ 842E ~                ld   (Audio_music_frame_counter), a
  92+ 842E ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 842E ~
  94+ 842E ~                ; Altrimenti carica la nota successiva
  95+ 842E ~                ld   a, (Audio_music_note_idx)
  96+ 842E ~                inc  a
  97+ 842E ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 842E ~                jr   c, .no_wrap
  99+ 842E ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 842E ~            .no_wrap:
 101+ 842E ~                ld   (Audio_music_note_idx), a
 102+ 842E ~
 103+ 842E ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 842E ~                ld   e, a
 105+ 842E ~                ld   d, 0
 106+ 842E ~                ld   hl, Audio_MusicSheet
 107+ 842E ~                add  hl, de
 108+ 842E ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 842E ~
 110+ 842E ~                ; Leggi durata (secondo byte)
 111+ 842E ~                inc  hl
 112+ 842E ~                ld   a, (hl)
 113+ 842E ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 842E ~                jr   nz, .dur_ok
 115+ 842E ~                ld   a, 1
 116+ 842E ~            .dur_ok:
 117+ 842E ~                ld   (Audio_music_frame_counter), a
 118+ 842E ~
 119+ 842E ~            .play_current_note:
 120+ 842E ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 842E ~                ld   a, (Audio_music_note_idx)
 122+ 842E ~                ld   e, a
 123+ 842E ~                ld   d, 0
 124+ 842E ~                ld   hl, Audio_MusicSheet
 125+ 842E ~                add  hl, de
 126+ 842E ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 842E ~                ld   a, (hl)                  ; A = delay
 128+ 842E ~                or   a
 129+ 842E ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 842E ~
 131+ 842E ~                ; Suona la nota: 2 cicli
 132+ 842E ~                ld   d, a                     ; D = delay
 133+ 842E ~                ld   b, 2                     ; 2 cicli per frame
 134+ 842E ~            .note_loop:
 135+ 842E ~                ; Speaker ON
 136+ 842E ~                ld   a, (room_border_color)
 137+ 842E ~                or   $10
 138+ 842E ~                out  ($fe), a
 139+ 842E ~                ld   c, d
 140+ 842E ~            .d1:
 141+ 842E ~                push af
 142+ 842E ~                pop  af
 143+ 842E ~                dec  c
 144+ 842E ~                jr   nz, .d1
 145+ 842E ~
 146+ 842E ~                ; Speaker OFF
 147+ 842E ~                ld   a, (room_border_color)
 148+ 842E ~                and  $ef
 149+ 842E ~                out  ($fe), a
 150+ 842E ~                ld   c, d
 151+ 842E ~            .d2:
 152+ 842E ~                push af
 153+ 842E ~                pop  af
 154+ 842E ~                dec  c
 155+ 842E ~                jr   nz, .d2
 156+ 842E ~
 157+ 842E ~                djnz .note_loop
 158+ 842E ~
 159+ 842E ~            .done:
 160+ 842E ~                pop  hl
 161+ 842E ~                pop  de
 162+ 842E ~                pop  bc
 163+ 842E ~                pop  af
 164+ 842E ~                ret
 165+ 842E ~
 166+ 842E ~            Audio_MusicSheet:
 167+ 842E ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 842E ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 842E ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 842E ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 842E ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5

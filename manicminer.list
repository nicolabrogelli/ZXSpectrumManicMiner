 410  860B 77               ld   (hl), a
 411  860C 23               inc  hl
 412  860D 10 FC            djnz .color_cycle_loop
 413  860F
 414  860F                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  860F 01 FE DF         ld   bc, $dffe
 416  8612 ED 78            in   a, (c)
 417  8614 CB 67            bit  4, a
 418  8616 28 2A            jr   z, .continue_chosen
 419  8618
 420  8618                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  8618 01 FE 7F         ld   bc, $7ffe
 422  861B ED 78            in   a, (c)
 423  861D CB 5F            bit  3, a
 424  861F 28 0B            jr   z, .quit_chosen
 425  8621
 426  8621                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  8621 01 FE BF         ld   bc, $bffe
 428  8624 ED 78            in   a, (c)
 429  8626 CB 47            bit  0, a
 430  8628 28 02            jr   z, .quit_chosen
 431  862A
 432  862A 18 C9            jr   .wait_choice_loop

   8+ 5DDB              Gfx_CopyChars:
   9+ 5DDB 21 00 3D         ld   hl, $3D00             ; Indirizzo del set di caratteri originale in ROM (ASCII 32)
  10+ 5DDE 11 DF E6         ld   de, font_buffer + 256 ; Indirizzo in RAM per ASCII 32..127 (font_buffer + 32*8)
  11+ 5DE1 01 00 03         ld   bc, 768               ; Numero di byte da copiare (96 caratteri * 8 byte ciascuno)
  12+ 5DE4 ED B0            ldir                       ; Copiare i dati
  13+ 5DE6 C9               ret
  14+ 5DE7
  15+ 5DE7              ; -------------------------------------------------------------------
  16+ 5DE7              ; Ridefinisci i caratteri (incluso quello per i bordi)
  17+ 5DE7              ; -------------------------------------------------------------------
  18+ 5DE7              Gfx_DefineChars:
  19+ 5DE7 21 9F DD         ld   hl, Willy             ; Indirizzo dei dati del nuovo carattere
  20+ 5DEA 11 E7 E5         ld   de, font_buffer + 8   ; Indirizzo di ASCII 1 nel nuovo set di caratteri (font_buffer + 1*8)
  21+ 5DED 01 48 00         ld   bc, 72                ; Numero di byte da copiare (9 caratteri * 8 byte)
  22+ 5DF0 ED B0            ldir                       ; Effettua la copia dei caratteri
  23+ 5DF2 21 DF E5         ld   hl, font_buffer       ; Indirizzo del nuovo set di caratteri in RAM (font base ASCII 0)
  24+ 5DF5 22 36 5C         ld   ($5C36), hl           ; Aggiornare la variabile di sistema CHARS
  25+ 5DF8 C9               ret

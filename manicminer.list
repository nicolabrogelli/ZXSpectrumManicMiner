 193  89ED C3 F0 89         jp   .willy_dies
 194  89F0                  ELSE
 195  89F0 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 196  89F0 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 197  89F0 ~                    ELSE
 198  89F0 ~                    jp   .no_collision
 199  89F0 ~                    ENDIF
 200  89F0                  ENDIF

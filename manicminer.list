 852  8C97                  ; Azzeramento punteggio partita corrente (Score = 000000)
 853  8C97                  ; Nota: High score viene mantenuto intatto tra le partite
 854  8C97 AF               xor  a
 855  8C98 32 04 F1         ld   (player_score + 0), a

 683  821C                  ; Offset = BC - 23552
 684  821C 60               ld   h, b
 685  821D 69               ld   l, c
 686  821E 01 00 A4         ld   bc, -23552
 687  8221 09               add  hl, bc
 688  8222
 689  8222                  ; PortalX = (Offset & 31) * 8, PortalY = (Offset / 32) * 8
 690  8222 7D               ld   a, l
 691  8223 E6 1F            and  31
 692  8225 87               add  a, a
 692  8226 87             add a, a
 692  8227 87             add a, a

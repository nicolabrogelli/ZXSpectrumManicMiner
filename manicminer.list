 293+ 6FB2 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6FB5 19               add  hl, de
 295+ 6FB6
 296+ 6FB6                  ; Byte 0: Y * 2
 297+ 6FB6 7E               ld   a, (hl)
 298+ 6FB7 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6FB9 57               ld   d, a                      ; D = PlayerY
 300+ 6FBA
 301+ 6FBA                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6FBA 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6FBB 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6FBC 7E               ld   a, (hl)
 305+ 6FBD E6 01            and  1
 306+ 6FBF 28 04            jr   z, .facing_right
 307+ 6FC1 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6FC3 18 02            jr   .set_dir
 309+ 6FC5              .facing_right:
 310+ 6FC5 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6FC7              .set_dir:
 312+ 6FC7 32 10 96         ld   (direction), a
 313+ 6FCA
 314+ 6FCA                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6FCA 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6FCB 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6FCC 4E               ld   c, (hl)
 318+ 6FCD 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6FCE 7E               ld   a, (hl)
 320+ 6FCF
 321+ 6FCF                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8

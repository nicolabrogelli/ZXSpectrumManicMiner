 959+ 77B0              ; -------------------------------------------------------------------
 960+ 77B0              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 961+ 77B0              ; Input: C = X, B = Y
 962+ 77B0              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 963+ 77B0              ; -------------------------------------------------------------------
 964+ 77B0              CheckWallCell:
 965+ 77B0 E5               push hl
 966+ 77B1 D5               push de
 967+ 77B2 C5               push bc
 968+ 77B3
 969+ 77B3                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77B3 78               ld   a, b
 971+ 77B4 FE 80            cp   128
 972+ 77B6 30 1F            jr   nc, .not_wall
 973+ 77B8
 974+ 77B8                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77B8 CB 3F            srl  a
 976+ 77BA CB 3F            srl  a
 977+ 77BC CB 3F            srl  a                 ; A = r (0..15)
 978+ 77BE
 979+ 77BE                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77BE 5F               ld   e, a              ; E = r (Row)
 981+ 77BF 79               ld   a, c
 982+ 77C0 CB 3F            srl  a
 983+ 77C2 CB 3F            srl  a
 984+ 77C4 CB 3F            srl  a                 ; A = c (0..31)
 985+ 77C6 4F               ld   c, a              ; C = c (Col)
 986+ 77C7
 987+ 77C7                  ; Se la cella è sulla rampa, non considerarla un muro!
 988+ 77C7 53               ld   d, e              ; D = Row
 989+ 77C8 59               ld   e, c              ; E = Col
 990+ 77C9 CD 35 77         call IsCellOnRamp
 991+ 77CC 38 09            jr   c, .not_wall
 992+ 77CE
 993+ 77CE 7A               ld   a, d              ; A = Row
 994+ 77CF 4B               ld   c, e              ; C = Col
 995+ 77D0 CD 6C 78         call GetCellFromUnpacked ; A = cell type
 996+ 77D3
 997+ 77D3                  ; Controlla se è Wall (3)
 998+ 77D3 FE 03            cp   3
 999+ 77D5 28 05            jr   z, .is_wall
1000+ 77D7
1001+ 77D7              .not_wall:
1002+ 77D7 C1               pop  bc
1003+ 77D8 D1               pop  de
1004+ 77D9 E1               pop  hl
1005+ 77DA B7               or   a                 ; Clear carry
1006+ 77DB C9               ret
1007+ 77DC
1008+ 77DC              .is_wall:
1009+ 77DC C1               pop  bc
1010+ 77DD D1               pop  de
1011+ 77DE E1               pop  hl
1012+ 77DF 37               scf                    ; Set carry
1013+ 77E0 C9               ret

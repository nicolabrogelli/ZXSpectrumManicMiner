 461+ 7D10 D6 02            sub  2
 462+ 7D12 DD BE 04         cp   (ix+4)
 463+ 7D15 28 08            jr   z, .v_rev_down
 464+ 7D17 38 06            jr   c, .v_rev_down
 465+ 7D19 DD 77 03         ld   (ix+3), a
 466+ 7D1C C3 4A 7D         jp   .next
 467+ 7D1F

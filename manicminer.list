1092+ 78A2              ; -------------------------------------------------------------------
1093+ 78A2              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1094+ 78A2              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1095+ 78A2              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1096+ 78A2              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1097+ 78A2              ; -------------------------------------------------------------------
1098+ 78A2              UnpackRoomLayout:
1099+ 78A2 E5               push hl
1100+ 78A3 D5               push de
1101+ 78A4 C5               push bc
1102+ 78A5 DD E5            push ix
1103+ 78A7
1104+ 78A7 DD 2A C1 AE      ld   ix, (room_ptr)
1105+ 78AB 11 20 02         ld   de, OFFSET_TILES
1106+ 78AE DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1107+ 78B0
1108+ 78B0 2A C1 AE         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1109+ 78B3 11 66 AC         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1110+ 78B6 01 00 02         ld   bc, 512               ; 512 celle
1111+ 78B9
1112+ 78B9              .byte_loop:
1113+ 78B9 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1114+ 78BA 23               inc  hl
1115+ 78BB
1116+ 78BB                  ; Confronta con le 8 definizioni di tile:
1117+ 78BB DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1118+ 78BE 28 23            jr   z, .is_bg
1119+ 78C0 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1120+ 78C3 28 29            jr   z, .is_wall
1121+ 78C5 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1122+ 78C8 28 1C            jr   z, .is_floor
1123+ 78CA DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1124+ 78CD 28 1B            jr   z, .is_crumbling
1125+ 78CF DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1126+ 78D2 28 1E            jr   z, .is_conveyor
1127+ 78D4 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1128+ 78D7 28 1D            jr   z, .is_nasty1
1129+ 78D9 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1130+ 78DC 28 1C            jr   z, .is_nasty2
1131+ 78DE DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1132+ 78E1 28 1B            jr   z, .is_extra
1133+ 78E3
1134+ 78E3              .is_bg:
1135+ 78E3                  ; Default: Tile 0 (Background)
1136+ 78E3 AF               xor  a
1137+ 78E4 18 1A            jr   .store_cell
1138+ 78E6
1139+ 78E6              .is_floor:
1140+ 78E6 3E 01            ld   a, 1
1141+ 78E8 18 16            jr   .store_cell
1142+ 78EA              .is_crumbling:
1143+ 78EA 3E 02            ld   a, 2
1144+ 78EC 18 12            jr   .store_cell
1145+ 78EE              .is_wall:
1146+ 78EE 3E 03            ld   a, 3

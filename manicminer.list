   6+ 8876
   7+ 8876              ; -------------------------------------------------------------------
   8+ 8876              ; Audio_UpdateJumpSound
   9+ 8876              ;
  10+ 8876              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8876              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8876              ; -------------------------------------------------------------------
  13+ 8876              Audio_UpdateJumpSound:
  14+ 8876 F5               push af
  15+ 8877 C5               push bc
  16+ 8878 D5               push de
  17+ 8879 E5               push hl
  18+ 887A
  19+ 887A                  ; Controlla se il suono è attivo (note < 18)
  20+ 887A 3A FE F0         ld   a, (Audio_jump_sound_note)
  21+ 887D FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 887F 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8881
  24+ 8881                  ; Carica la nota corrente da suonare
  25+ 8881 5F               ld   e, a
  26+ 8882 16 00            ld   d, 0
  27+ 8884 21 B0 88         ld   hl, Audio_JumpSoundDelays
  28+ 8887 19               add  hl, de
  29+ 8888 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8889 57               ld   d, a                      ; D = delay della nota
  31+ 888A
  32+ 888A                  ; Suona la nota: 15 cicli
  33+ 888A 06 0F            ld   b, 15
  34+ 888C              .note_loop:
  35+ 888C                  ; Speaker ON
  36+ 888C 3A EA EA         ld   a, (room_border_color)
  37+ 888F F6 10            or   $10
  38+ 8891 D3 FE            out  ($fe), a
  39+ 8893 4A               ld   c, d
  40+ 8894              .d1:
  41+ 8894 0D               dec  c
  42+ 8895 20 FD            jr   nz, .d1
  43+ 8897
  44+ 8897                  ; Speaker OFF
  45+ 8897 3A EA EA         ld   a, (room_border_color)
  46+ 889A E6 EF            and  $ef
  47+ 889C D3 FE            out  ($fe), a
  48+ 889E 4A               ld   c, d
  49+ 889F              .d2:
  50+ 889F 0D               dec  c
  51+ 88A0 20 FD            jr   nz, .d2
  52+ 88A2
  53+ 88A2 10 E8            djnz .note_loop
  54+ 88A4
  55+ 88A4                  ; Passa alla nota successiva
  56+ 88A4 3A FE F0         ld   a, (Audio_jump_sound_note)
  57+ 88A7 3C               inc  a
  58+ 88A8 32 FE F0         ld   (Audio_jump_sound_note), a
  59+ 88AB
  60+ 88AB              .done:
  61+ 88AB E1               pop  hl
  62+ 88AC D1               pop  de
  63+ 88AD C1               pop  bc
  64+ 88AE F1               pop  af
  65+ 88AF C9               ret
  66+ 88B0
  67+ 88B0              Audio_JumpSoundDelays:
  68+ 88B0 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 88B4 19 13 0C 06
  68+ 88B8 0C 13 19 20
  68+ 88BC 26 2D 33 3A
  68+ 88C0 40 47

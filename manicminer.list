1142+ 62A9 ED B0            ldir
1143+ 62AB
1144+ 62AB                  ; 2. Imposta tutti gli attributi a B ($5800..$5AFF)
1145+ 62AB 21 00 58         ld   hl, $5800
1146+ 62AE 70               ld   (hl), b
1147+ 62AF 11 01 58         ld   de, $5801
1148+ 62B2 01 FF 02         ld   bc, 767
1149+ 62B5 ED B0            ldir

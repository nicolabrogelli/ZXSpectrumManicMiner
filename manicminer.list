 744  8365              ; CheckWillyConveyorCollision
 745  8365              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 746  8365              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 747  8365              ; -------------------------------------------------------------------
 748  8365              CheckWillyConveyorCollision:
 749  8365 C5               push bc
 750  8366 D5               push de
 751  8367 E5               push hl
 752  8368
 753  8368                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 754  8368 CD 3A 74         call CheckWillyOnConveyor
 755  836B 38 49            jr   c, .collision_detected
 756  836D
 757  836D                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 758  836D 3A 8D 91         ld   a, (conveyor_len)
 759  8370 B7               or   a
 760  8371 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 761  8373
 762  8373                  ; B = WillyY, C = WillyX
 763  8373 ED 4B 65 8E      ld   bc, (PlayerPos)
 764  8377
 765  8377                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 766  8377 3A 8E 91         ld   a, (conveyor_row)
 767  837A 87               add  a, a                  ; *2
 768  837B 87               add  a, a                  ; *4
 769  837C 87               add  a, a                  ; *8
 770  837D 5F               ld   e, a                  ; E = ConveyorTop
 771  837E C6 07            add  a, 7
 772  8380 57               ld   d, a                  ; D = ConveyorBottom
 773  8381
 774  8381                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 775  8381 78               ld   a, b                  ; WillyTop
 776  8382 BA               cp   d
 777  8383 28 04            jr   z, .y_overlap
 778  8385 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 779  8387 18 32            jr   .no_conv_collision
 780  8389
 781  8389              .y_overlap:
 782  8389 C6 0F            add  a, 15                 ; WillyBottom
 783  838B BB               cp   e
 784  838C 28 04            jr   z, .x_check
 785  838E 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 786  8390 18 29            jr   .no_conv_collision
 787  8392
 788  8392              .x_check:
 789  8392                  ; ConveyorLeft = conveyor_col * 8
 790  8392 3A 8F 91         ld   a, (conveyor_col)
 791  8395 87               add  a, a                  ; *2
 792  8396 87               add  a, a                  ; *4
 793  8397 87               add  a, a                  ; *8
 794  8398 5F               ld   e, a                  ; E = ConveyorLeft
 795  8399
 796  8399                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 797  8399 21 8D 91         ld   hl, conveyor_len
 798  839C 3A 8F 91         ld   a, (conveyor_col)
 799  839F 86               add  a, (hl)
 800  83A0 87               add  a, a                  ; *2
 801  83A1 87               add  a, a                  ; *4
 802  83A2 87               add  a, a                  ; *8
 803  83A3 3D               dec  a                     ; ConveyorRight
 804  83A4 57               ld   d, a                  ; D = ConveyorRight
 805  83A5
 806  83A5                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 807  83A5 79               ld   a, c                  ; WillyLeft
 808  83A6 BA               cp   d
 809  83A7 28 04            jr   z, .x_overlap
 810  83A9 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 811  83AB 18 0E            jr   .no_conv_collision
 812  83AD
 813  83AD              .x_overlap:
 814  83AD C6 0F            add  a, 15                 ; WillyRight
 815  83AF BB               cp   e

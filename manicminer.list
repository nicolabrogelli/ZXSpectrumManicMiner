1069+ 8282 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
1070+ 8284 4F               ld   c, a                      ; C = DeltaX (1..8)
1071+ 8285              .shift_left_16bit:

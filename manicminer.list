  85+ 7C89 FE FF            cp   $FF
  86+ 7C8B 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 7C8D 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 7C8E 23               inc  hl                        ; +2 (Attr Address High)
  89+ 7C8F 23               inc  hl                        ; +3 (Anim mask)
  90+ 7C90 23               inc  hl                        ; +4 (Collected flag)
  91+ 7C91 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 7C93 23               inc  hl                        ; Avanza al prossimo item
  93+ 7C94 18 F2            jr   .item_loop
  94+ 7C96

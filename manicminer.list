 518+ 7E41              ; CheckCollision
 519+ 7E41              ;
 520+ 7E41              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7E41              ; Output:
 522+ 7E41              ;   Carry Set = Collisione con guardiano
 523+ 7E41              ;   Carry Clear = Nessuna collisione
 524+ 7E41              ; -------------------------------------------------------------------
 525+ 7E41              CheckCollision:
 526+ 7E41 DD E5            push ix
 527+ 7E43 C5               push bc
 528+ 7E44 D5               push de
 529+ 7E45 E5               push hl
 530+ 7E46
 531+ 7E46                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7E46 3A 75 98         ld   a, (willy_safety_timer)
 533+ 7E49 B7               or   a
 534+ 7E4A 20 3B            jr   nz, .no_collision_found
 535+ 7E4C
 536+ 7E4C DD 21 39 7B      ld   ix, ActiveEnemies
 537+ 7E50 06 08            ld   b, 8                      ; 8 slot
 538+ 7E52
 539+ 7E52              .collision_loop:
 540+ 7E52 DD 7E 00         ld   a, (ix+0)
 541+ 7E55 E6 80            and  $80                       ; Active?
 542+ 7E57 28 26            jr   z, .next_enemy
 543+ 7E59
 544+ 7E59 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7E5A
 546+ 7E5A                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7E5A ED 4B 6B 94      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7E5E DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7E61
 550+ 7E61                  ; Calcola differenza X
 551+ 7E61 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7E62 30 02            jr   nc, .x_diff_pos
 553+ 7E64 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7E66              .x_diff_pos:
 555+ 7E66 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7E68 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7E6A
 558+ 7E6A                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7E6A DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7E6D 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7E6E 30 02            jr   nc, .y_diff_pos
 562+ 7E70 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7E72              .y_diff_pos:
 564+ 7E72 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7E74 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7E76
 567+ 7E76                  ; Collisione trovata!
 568+ 7E76 C1               pop  bc                        ; Ripristina stack
 569+ 7E77 E1               pop  hl
 570+ 7E78 D1               pop  de
 571+ 7E79 C1               pop  bc
 572+ 7E7A DD E1            pop  ix
 573+ 7E7C 37               scf
 574+ 7E7D C9               ret
 575+ 7E7E
 576+ 7E7E              .no_x_hit:
 577+ 7E7E C1               pop  bc                        ; Ripristina B (contatore ciclo)

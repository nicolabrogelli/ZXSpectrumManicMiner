   7+ 716E              ; Input_CheckCtrl
   8+ 716E              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 716E              ;
  10+ 716E              ; Output:
  11+ 716E              ;   D = bitmask tasti attivi:
  12+ 716E              ;       bit 0 → sinistra (O)
  13+ 716E              ;       bit 1 → destra   (P)
  14+ 716E              ;       bit 2 → salto    (Z)
  15+ 716E              ;
  16+ 716E              ; Effetti collaterali in RAM:
  17+ 716E              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 716E              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 716E              ;   (jump_prev)     → debounce tasto salto
  20+ 716E              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 716E              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 716E              ; -------------------------------------------------------------------

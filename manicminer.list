 142+ 817D              ; Items_DrawRoom
 143+ 817D              ;
 144+ 817D              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 817D              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da

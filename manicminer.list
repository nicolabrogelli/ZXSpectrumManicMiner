 649  86AB
 650  86AB              ; -------------------------------------------------------------------
 651  86AB              ; CheckPortalTransition
 652  86AB              ; Verifica le condizioni per accedere alla stanza successiva:
 653  86AB              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 654  86AB              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 655  86AB              ;
 656  86AB              ; Output:
 657  86AB              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 658  86AB              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 659  86AB              ; -------------------------------------------------------------------
 660  86AB              CheckPortalTransition:
 661  86AB C5               push bc
 662  86AC D5               push de
 663  86AD E5               push hl
 664  86AE
 665  86AE                  ; 1. Tutti gli item della stanza sono stati raccolti?
 666  86AE CD 3C 87         call CheckAllItemsCollected
 667  86B1 30 4D            jr   nc, .no_transition
 668  86B3
 669  86B3                  ; 2. Willy collide con il portale (16x16 pixel)?
 670  86B3                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 671  86B3                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 672  86B3 2A CF A1         ld   hl, (room_ptr)
 673  86B6 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 674  86B9 19               add  hl, de
 675  86BA 4E               ld   c, (hl)
 676  86BB 23               inc  hl
 677  86BC 46               ld   b, (hl)                   ; BC = AttrAddr
 678  86BD
 679  86BD                  ; Offset = BC - 23552
 680  86BD 60               ld   h, b
 681  86BE 69               ld   l, c
 682  86BF 01 00 A4         ld   bc, -23552
 683  86C2 09               add  hl, bc
 684  86C3
 685  86C3                  ; PortalX = (Offset & 31) * 8
 686  86C3 7D               ld   a, l
 687  86C4 E6 1F            and  31
 688  86C6 87               add  a, a
 688  86C7 87             add a, a
 688  86C8 87             add a, a
 689  86C9 5F               ld   e, a                      ; E = PortalX (0..248)
 690  86CA
 691  86CA                  ; PortalY = (Offset / 32) * 8
 692  86CA CB 3C            srl  h
 692  86CC CB 1D          rr l
 693  86CE CB 3C            srl  h
 693  86D0 CB 1D          rr l
 694  86D2 CB 3C            srl  h
 694  86D4 CB 1D          rr l
 695  86D6 CB 3C            srl  h
 695  86D8 CB 1D          rr l
 696  86DA CB 3C            srl  h
 696  86DC CB 1D          rr l
 697  86DE 7D               ld   a, l
 698  86DF 87               add  a, a
 698  86E0 87             add a, a
 698  86E1 87             add a, a
 699  86E2 57               ld   d, a                      ; D = PortalY (0..120)
 700  86E3

1011+ 7857 30 1F            jr   nc, .not_wall
1012+ 7859
1013+ 7859                  ; 2. Calcola riga di layout: r = Y / 8
1014+ 7859 CB 3F            srl  a
1015+ 785B CB 3F            srl  a
1016+ 785D CB 3F            srl  a                 ; A = r (0..15)
1017+ 785F
1018+ 785F                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1019+ 785F 5F               ld   e, a              ; E = r (Row)
1020+ 7860 79               ld   a, c
1021+ 7861 CB 3F            srl  a
1022+ 7863 CB 3F            srl  a
1023+ 7865 CB 3F            srl  a                 ; A = c (0..31)
1024+ 7867 4F               ld   c, a              ; C = c (Col)

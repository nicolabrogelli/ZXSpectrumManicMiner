  29+ 7CA3              ; Enemy_LoadRoom
  30+ 7CA3              ;
  31+ 7CA3              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7CA3              ; Chiamato quando si entra in una stanza.
  33+ 7CA3              ; -------------------------------------------------------------------
  34+ 7CA3              Enemy_LoadRoom:
  35+ 7CA3 E5               push hl
  36+ 7CA4 D5               push de
  37+ 7CA5 C5               push bc
  38+ 7CA6 DD E5            push ix
  39+ 7CA8
  40+ 7CA8                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CA8 21 4B 7C         ld   hl, ActiveEnemies
  42+ 7CAB 11 4C 7C         ld   de, ActiveEnemies + 1
  43+ 7CAE 36 00            ld   (hl), 0
  44+ 7CB0 01 57 00         ld   bc, 87
  45+ 7CB3 ED B0            ldir
  46+ 7CB5
  47+ 7CB5                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CB5 DD 21 4B 7C      ld   ix, ActiveEnemies
  49+ 7CB9 06 08            ld   b, 8
  50+ 7CBB 11 0B 00         ld   de, 11
  51+ 7CBE              .init_old_pos:
  52+ 7CBE DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7CC2 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CC6 DD 19            add  ix, de
  55+ 7CC8 10 F4            djnz .init_old_pos
  56+ 7CCA
  57+ 7CCA                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CCA DD 21 4B 7C      ld   ix, ActiveEnemies
  59+ 7CCE 2A 50 BE         ld   hl, (room_ptr)
  60+ 7CD1 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7CD4 19               add  hl, de
  62+ 7CD5
  63+ 7CD5 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CD7              .load_h_loop:
  65+ 7CD7 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CD8 FE FF            cp   $FF
  67+ 7CDA 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CDC B7               or   a
  69+ 7CDD 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7CDF
  71+ 7CDF                  ; Slot attivo
  72+ 7CDF DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CE3 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7CE6
  75+ 7CE6 23               inc  hl
  76+ 7CE7 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7CE8 23               inc  hl
  78+ 7CE9 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7CEA
  80+ 7CEA                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7CEA E5               push hl
  82+ 7CEB C5               push bc
  83+ 7CEC 67               ld   h, a
  84+ 7CED 69               ld   l, c
  85+ 7CEE 01 00 A4         ld   bc, -23552
  86+ 7CF1 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7CF2
  88+ 7CF2                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7CF2 7D               ld   a, l
  90+ 7CF3 E6 1F            and  31
  91+ 7CF5 87               add  a, a
  91+ 7CF6 87             add a, a
  91+ 7CF7 87             add a, a
  92+ 7CF8 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7CFB
  94+ 7CFB                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7CFB CB 3C            srl  h
  95+ 7CFD CB 1D          rr l
  96+ 7CFF CB 3C            srl  h
  96+ 7D01 CB 1D          rr l
  97+ 7D03 CB 3C            srl  h
  97+ 7D05 CB 1D          rr l
  98+ 7D07 CB 3C            srl  h
  98+ 7D09 CB 1D          rr l
  99+ 7D0B CB 3C            srl  h
  99+ 7D0D CB 1D          rr l
 100+ 7D0F 7D               ld   a, l
 101+ 7D10 87               add  a, a
 101+ 7D11 87             add a, a
 101+ 7D12 87             add a, a
 102+ 7D13 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D16 C1               pop  bc
 104+ 7D17 E1               pop  hl
 105+ 7D18
 106+ 7D18 23               inc  hl
 107+ 7D19 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D1A DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D1E
 110+ 7D1E 23               inc  hl
 111+ 7D1F 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D20 E6 01            and  1
 113+ 7D22 28 04            jr   z, .h_dir_right
 114+ 7D24 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7D26 18 02            jr   .set_h_dir
 116+ 7D28              .h_dir_right:
 117+ 7D28 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7D2A              .set_h_dir:
 119+ 7D2A DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7D2D
 121+ 7D2D 23               inc  hl
 122+ 7D2E 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7D2F E6 1F            and  31
 124+ 7D31 87               add  a, a
 124+ 7D32 87             add a, a
 124+ 7D33 87             add a, a
 125+ 7D34 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7D37
 127+ 7D37 23               inc  hl
 128+ 7D38 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7D39 E6 1F            and  31
 130+ 7D3B 87               add  a, a
 130+ 7D3C 87             add a, a
 130+ 7D3D 87             add a, a
 131+ 7D3E DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7D41
 133+ 7D41 23               inc  hl                        ; Prossimo guardiano
 134+ 7D42 11 0B 00         ld   de, 11
 135+ 7D45 DD 19            add  ix, de
 136+ 7D47 10 8E            djnz .load_h_loop
 137+ 7D49
 138+ 7D49              .done_h_guardians:
 139+ 7D49                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7D49 2A 50 BE         ld   hl, (room_ptr)
 141+ 7D4C 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7D4F 19               add  hl, de
 143+ 7D50
 144+ 7D50 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 145+ 7D52              .load_v_loop:
 146+ 7D52 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 147+ 7D53 FE FF            cp   $FF
 148+ 7D55 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 149+ 7D57 B7               or   a
 150+ 7D58 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 151+ 7D5A
 152+ 7D5A                  ; Slot attivo per guardiano verticale
 153+ 7D5A DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 154+ 7D5E DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 155+ 7D61
 156+ 7D61 23               inc  hl
 157+ 7D62 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 158+ 7D63 E6 03            and  3
 159+ 7D65 C6 04            add  a, 4                      ; Frame 4..7 in OFFSET_GUARDIAN_GRAPHICS
 160+ 7D67 DD 77 01         ld   (ix+1), a                 ; Frame index (4..7)
 161+ 7D6A
 162+ 7D6A 23               inc  hl
 163+ 7D6B 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 164+ 7D6C DD 77 03         ld   (ix+3), a                 ; Current Y
 165+ 7D6F
 166+ 7D6F 23               inc  hl
 167+ 7D70 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 168+ 7D71 E6 1F            and  31
 169+ 7D73 87               add  a, a
 169+ 7D74 87             add a, a
 169+ 7D75 87             add a, a ; * 8 -> X pixel
 170+ 7D76 DD 77 02         ld   (ix+2), a                 ; Current X
 171+ 7D79
 172+ 7D79 23               inc  hl
 173+ 7D7A 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 174+ 7D7B E6 03            and  3
 175+ 7D7D 20 02            jr   nz, .v_step_ok
 176+ 7D7F 3E 01            ld   a, 1
 177+ 7D81              .v_step_ok:
 178+ 7D81 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 179+ 7D84 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 180+ 7D86 DD 77 06         ld   (ix+6), a
 181+ 7D89
 182+ 7D89 23               inc  hl
 183+ 7D8A 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 184+ 7D8B DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 185+ 7D8E
 186+ 7D8E 23               inc  hl
 187+ 7D8F 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 188+ 7D90 DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 189+ 7D93
 190+ 7D93 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 191+ 7D94 11 0B 00         ld   de, 11
 192+ 7D97 DD 19            add  ix, de
 193+ 7D99 10 B7            djnz .load_v_loop

 176+ 812E E5               push hl
 177+ 812F DD E1            pop  ix                        ; IX = bitmap item
 178+ 8131
 179+ 8131                  ; 4. HL = Inizio lista item nella stanza
 180+ 8131 2A EA AD         ld   hl, (room_ptr)
 181+ 8134 11 75 02         ld   de, OFFSET_ITEMS
 182+ 8137 19               add  hl, de
 183+ 8138
 184+ 8138              .loop:
 185+ 8138 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 8139 FE FF            cp   $FF
 187+ 813B 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 813D
 189+ 813D 5F               ld   e, a                      ; E = Color
 190+ 813E 23               inc  hl
 191+ 813F 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 8140 23               inc  hl
 193+ 8141 46               ld   b, (hl)                   ; B = AttrAddr High

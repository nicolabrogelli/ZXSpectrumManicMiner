 209+ 7DC0              .done_v_guardians:
 210+ 7DC0                  ; 4. Controlla se la stanza corrente è Eugene's Lair (Caverna 04)
 211+ 7DC0 2A 5B E3         ld   hl, (room_ptr)
 212+ 7DC3 11 9A 99         ld   de, EugeneLairLayout
 213+ 7DC6 B7               or   a
 214+ 7DC7 ED 52            sbc  hl, de
 215+ 7DC9 20 30            jr   nz, .not_eugene
 216+ 7DCB
 217+ 7DCB                  ; Inizializza Eugene nello Slot 4 (offset 44) di ActiveEnemies
 218+ 7DCB DD 21 89 7C      ld   ix, ActiveEnemies + 44
 219+ 7DCF DD 36 00 E0      ld   (ix+0), $E0               ; Active = 1, Vertical = 1, Eugene = 1
 220+ 7DD3 DD 36 01 00      ld   (ix+1), 0                 ; Frame = 0
 221+ 7DD7 DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 222+ 7DDB DD 36 03 58      ld   (ix+3), 88                ; Initial Y = 88
 223+ 7DDF DD 36 04 00      ld   (ix+4), 0                 ; Min Limit Y = 0
 224+ 7DE3 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88
 225+ 7DE7 DD 36 06 01      ld   (ix+6), 1                 ; Direction = 1 (Up)
 226+ 7DEB DD 36 07 01      ld   (ix+7), 1                 ; Speed = 1
 227+ 7DEF DD 36 08 FF      ld   (ix+8), $FF               ; Old X = $FF
 228+ 7DF3 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y = $FF
 229+ 7DF7 DD 36 0A 17      ld   (ix+10), 23               ; Paper 2 (Red), Ink 7 (White) -> 23
 230+ 7DFB
 231+ 7DFB              .not_eugene:
 232+ 7DFB DD E1            pop  ix
 233+ 7DFD C1               pop  bc
 234+ 7DFE D1               pop  de
 235+ 7DFF E1               pop  hl
 236+ 7E00 C9               ret

   8+ 84D2              ; Audio_UpdateJumpSound
   9+ 84D2              ;
  10+ 84D2              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 84D2              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 84D2              ; -------------------------------------------------------------------
  13+ 84D2              Audio_UpdateJumpSound:
  14+ 84D2 F5               push af
  15+ 84D3 C5               push bc
  16+ 84D4 D5               push de
  17+ 84D5 E5               push hl
  18+ 84D6
  19+ 84D6                  ; Controlla se il suono è attivo (note < 18)
  20+ 84D6 3A F7 E5         ld   a, (Audio_jump_sound_note)
  21+ 84D9 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 84DB 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 84DD
  24+ 84DD                  ; Carica la nota corrente da suonare
  25+ 84DD 5F               ld   e, a
  26+ 84DE 16 00            ld   d, 0
  27+ 84E0 21 0C 85         ld   hl, Audio_JumpSoundDelays
  28+ 84E3 19               add  hl, de
  29+ 84E4 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 84E5 57               ld   d, a                      ; D = delay della nota
  31+ 84E6
  32+ 84E6                  ; Suona la nota: 15 cicli
  33+ 84E6 06 0F            ld   b, 15
  34+ 84E8              .note_loop:
  35+ 84E8                  ; Speaker ON
  36+ 84E8 3A E6 DF         ld   a, (room_border_color)
  37+ 84EB F6 10            or   $10
  38+ 84ED D3 FE            out  ($fe), a
  39+ 84EF 4A               ld   c, d
  40+ 84F0              .d1:
  41+ 84F0 0D               dec  c
  42+ 84F1 20 FD            jr   nz, .d1
  43+ 84F3
  44+ 84F3                  ; Speaker OFF
  45+ 84F3 3A E6 DF         ld   a, (room_border_color)
  46+ 84F6 E6 EF            and  $ef
  47+ 84F8 D3 FE            out  ($fe), a
  48+ 84FA 4A               ld   c, d
  49+ 84FB              .d2:
  50+ 84FB 0D               dec  c
  51+ 84FC 20 FD            jr   nz, .d2
  52+ 84FE
  53+ 84FE 10 E8            djnz .note_loop
  54+ 8500
  55+ 8500                  ; Passa alla nota successiva
  56+ 8500 3A F7 E5         ld   a, (Audio_jump_sound_note)
  57+ 8503 3C               inc  a
  58+ 8504 32 F7 E5         ld   (Audio_jump_sound_note), a

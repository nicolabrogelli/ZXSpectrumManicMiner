1842+ 7C9A 32 4C EB         ld   (room_gravity_preset), a
1843+ 7C9D 3E 03            ld   a, DEFAULT_AIR_SPEED_PRESET
1844+ 7C9F 32 B2 EE         ld   (player_air_speed), a
1845+ 7CA2 F1               pop  af
1846+ 7CA3 C9               ret

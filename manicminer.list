 241+ 7D3D              ; DrawItemGraphic
 242+ 7D3D              ;
 243+ 7D3D              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 244+ 7D3D              ; utilizzando una bitmap di 8 byte e un attributo colore.
 245+ 7D3D              ;
 246+ 7D3D              ; Input:
 247+ 7D3D              ;   B = Riga attributi (0..23)
 248+ 7D3D              ;   C = Colonna attributi (0..31)
 249+ 7D3D              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 250+ 7D3D              ;   E = Attributo colore
 251+ 7D3D              ; -------------------------------------------------------------------
 252+ 7D3D              DrawItemGraphic:
 253+ 7D3D C5               push bc
 254+ 7D3E D5               push de
 255+ 7D3F E5               push hl
 256+ 7D40
 257+ 7D40                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 258+ 7D40 78               ld   a, b
 259+ 7D41 E6 18            and  $18
 260+ 7D43 C6 40            add  a, $40
 261+ 7D45 57               ld   d, a                      ; Byte alto indirizzo video
 262+ 7D46
 263+ 7D46 78               ld   a, b
 264+ 7D47 E6 07            and  7
 265+ 7D49 87               add  a, a                      ; *2
 266+ 7D4A 87               add  a, a                      ; *4
 267+ 7D4B 87               add  a, a                      ; *8
 268+ 7D4C 87               add  a, a                      ; *16
 269+ 7D4D 87               add  a, a                      ; *32
 270+ 7D4E 81               add  a, c                      ; + Col
 271+ 7D4F 5F               ld   e, a                      ; Byte basso indirizzo video
 272+ 7D50
 273+ 7D50 C5               push bc
 274+ 7D51 06 08            ld   b, 8                      ; 8 scanline
 275+ 7D53              .line_loop:
 276+ 7D53 7E               ld   a, (hl)
 277+ 7D54 12               ld   (de), a
 278+ 7D55 14               inc  d
 279+ 7D56 23               inc  hl
 280+ 7D57 05               dec  b
 281+ 7D58 20 F9            jr   nz, .line_loop
 282+ 7D5A C1               pop  bc
 283+ 7D5B
 284+ 7D5B                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 285+ 7D5B 26 00            ld   h, 0
 286+ 7D5D 68               ld   l, b
 287+ 7D5E 29               add  hl, hl
 288+ 7D5F 29               add  hl, hl
 289+ 7D60 29               add  hl, hl
 290+ 7D61 29               add  hl, hl
 291+ 7D62 29               add  hl, hl                    ; Row * 32
 292+ 7D63 79               ld   a, c
 293+ 7D64 85               add  a, l
 294+ 7D65 6F               ld   l, a
 295+ 7D66 30 01            jr   nc, .no_carry
 296+ 7D68 24               inc  h

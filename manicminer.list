 200+ 8995 E6 EF            and  $ef              ; speaker OFF
 201+ 8997 D3 FE            out  ($fe), a
 202+ 8999
 203+ 8999 0E 3C            ld   c, 60
 204+ 899B              .d2:
 205+ 899B 0D               dec  c
 206+ 899C 20 FD            jr   nz, .d2
 207+ 899E
 208+ 899E 10 E6            djnz .sound_loop
 209+ 89A0
 210+ 89A0 D1               pop  de
 211+ 89A1 C1               pop  bc
 212+ 89A2 C9               ret

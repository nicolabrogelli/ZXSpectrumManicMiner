 241  8583 AF               xor  a
 242  8584 32 4E AB         ld   (velocity_y), a
 243  8587 32 50 AB         ld   (jump_pressed), a
 244  858A 32 52 AB         ld   (coyote_timer), a
 245  858D 32 55 AB         ld   (jump_frame), a
 246  8590 32 54 AB         ld   (jump_dir), a
 247  8593 32 46 AB         ld   (body_state), a
 248  8596 32 49 AF         ld   (player_old_body), a
 249  8599 32 48 AF         ld   (player_old_dir), a
 250  859C 32 4B AB         ld   (sprite_shift), a
 251  859F 32 49 AB         ld   (collision_active), a
 252  85A2 32 4C AF         ld   (willy_needs_redraw), a
 253  85A5 32 56 AB         ld   (current_input_dir), a
 254  85A8 32 6B AE         ld   (conveyor_caught), a
 255  85AB 32 C7 AE         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 256  85AE 3E 01            ld   a, 1
 257  85B0 32 4F AB         ld   (on_ground), a
 258  85B3
 259  85B3 3E 00            ld   a, RESPAWN_SAFETY_TIME
 260  85B5 32 4B AF         ld   (willy_safety_timer), a
 261  85B8
 262  85B8                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 263  85B8 C3 99 84         jp   LoadRoomAndRestart

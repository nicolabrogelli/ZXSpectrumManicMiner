2272+ 69B8 23               inc  hl
2273+ 69B9 46               ld   b, (hl)               ; BC = AttrAddr dai dati della stanza (base 23552)
2274+ 69BA
2275+ 69BA 60               ld   h, b
2276+ 69BB 69               ld   l, c

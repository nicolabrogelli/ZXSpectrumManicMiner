  25+ 716E AF               xor  a
  26+ 716F 32 89 EC         ld   (current_input_dir), a
  27+ 7172
  28+ 7172                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 7172                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 7172                  ;
  31+ 7172                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 7172                  ; Se bit 0 = 0, Q è premuto.
  33+ 7172
  34+ 7172 01 FE FB         ld   bc, $fbfe
  35+ 7175 ED 78            in   a, (c)
  36+ 7177 CB 47            bit  0, a
  37+ 7179 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 717B
  39+ 717B                  ; Q è premuto: debounce tramite (q_prev).
  40+ 717B                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 717B 3A 8A EC         ld   a, (q_prev)
  42+ 717E B7               or   a
  43+ 717F 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 7181
  45+ 7181                  ; ── Primo frame di pressione di Q ──
  46+ 7181 3E 01            ld   a, 1
  47+ 7183 32 8A EC         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 7186
  49+ 7186                  ; NOTA sullo stack:
  50+ 7186                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 7186                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 7186                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 7186                  ; poi JP salta direttamente.
  54+ 7186 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 7187 C3 20 72         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)

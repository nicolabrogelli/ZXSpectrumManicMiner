 193+ 80C5
 194+ 80C5 0E 3C            ld   c, 60
 195+ 80C7              .d1:
 196+ 80C7 0D               dec  c
 197+ 80C8 20 FD            jr   nz, .d1
 198+ 80CA
 199+ 80CA 3A 95 93         ld   a, (room_border_color)
 200+ 80CD E6 EF            and  $ef              ; speaker OFF
 201+ 80CF D3 FE            out  ($fe), a
 202+ 80D1
 203+ 80D1 0E 3C            ld   c, 60
 204+ 80D3              .d2:
 205+ 80D3 0D               dec  c
 206+ 80D4 20 FD            jr   nz, .d2
 207+ 80D6
 208+ 80D6 10 E6            djnz .sound_loop
 209+ 80D8
 210+ 80D8 D1               pop  de
 211+ 80D9 C1               pop  bc
 212+ 80DA C9               ret

 208+ 7DFD              .erase_loop:
 209+ 7DFD DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E00 E6 80            and  $80               ; Active?
 211+ 7E02 28 3A            jr   z, .next_erase
 212+ 7E04
 213+ 7E04                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E04 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E07 FE FF            cp   $FF
 216+ 7E09 28 33            jr   z, .next_erase
 217+ 7E0B
 218+ 7E0B                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E0B DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E0E DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E11 20 0E            jr   nz, .do_erase_slot
 222+ 7E13 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E16 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E19 20 06            jr   nz, .do_erase_slot
 225+ 7E1B
 226+ 7E1B 3A 0E A2         ld   a, (enemy_was_updated)
 227+ 7E1E B7               or   a
 228+ 7E1F 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E21
 230+ 7E21              .do_erase_slot:
 231+ 7E21 C5               push bc                ; Salva contatore ciclo
 232+ 7E22
 233+ 7E22                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E22 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E25 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E28 CD CE 7D         call CheckEnemyWillyOverlap
 237+ 7E2B
 238+ 7E2B                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E2B DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E2E DD 46 09         ld   b, (ix+9)         ; B = Old Y

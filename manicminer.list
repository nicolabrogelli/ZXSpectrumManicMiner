 462+ 80AF 57               ld   d, a                      ; D = ItemBottom
 463+ 80B0
 464+ 80B0                  ; WillyTop <= ItemBottom
 465+ 80B0 78               ld   a, b                      ; A = WillyY
 466+ 80B1 BA               cp   d                         ; D = ItemBottom
 467+ 80B2 28 04            jr   z, .y_ok
 468+ 80B4 38 02            jr   c, .y_ok
 469+ 80B6 18 13            jr   .no_collision
 470+ 80B8
 471+ 80B8              .y_ok:
 472+ 80B8                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 80B8 BB               cp   e                         ; E = ItemTop
 474+ 80B9 28 0B            jr   z, .collision
 475+ 80BB 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 80BD
 477+ 80BD                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 80BD C6 0F            add  a, 15
 479+ 80BF BB               cp   e
 480+ 80C0 28 04            jr   z, .collision
 481+ 80C2 30 02            jr   nc, .collision
 482+ 80C4 18 05            jr   .no_collision

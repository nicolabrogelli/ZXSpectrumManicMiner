 746+ 8838              ; -------------------------------------------------------------------
 747+ 8838              ; Items_Animate
 748+ 8838              ;
 749+ 8838              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 8838              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 8838              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 8838              ; originale $8F63.
 753+ 8838              ; -------------------------------------------------------------------
 754+ 8838              Items_Animate:
 755+ 8838 E5               push hl
 756+ 8839 D5               push de
 757+ 883A C5               push bc
 758+ 883B FD E5            push iy
 759+ 883D
 760+ 883D 3A 71 EE         ld   a, (num_room_items)
 761+ 8840 B7               or   a
 762+ 8841 28 40            jr   z, .anim_done
 763+ 8843
 764+ 8843 FD 21 21 EE      ld   iy, current_room_items
 765+ 8847
 766+ 8847              .anim_loop:
 767+ 8847 FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 884A FE FF            cp   $FF
 769+ 884C 28 35            jr   z, .anim_done
 770+ 884E B7               or   a
 771+ 884F 28 2B            jr   z, .next_anim_item
 772+ 8851
 773+ 8851                  ; Routine originale $8F63 di Manic Miner:
 774+ 8851                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 8851 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 8853 F6 03            or   $03                       ; Base Ink = 3
 777+ 8855 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 8856 FD 7E 02         ld   a, (iy+2)
 779+ 8859 E6 03            and  $03                       ; Isola offset rotazione
 780+ 885B 80               add  a, b                      ; A = Nuovo attributo
 781+ 885C FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 885F 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8860
 784+ 8860                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8860 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 8863 16 00            ld   d, 0
 787+ 8865 26 00            ld   h, 0
 788+ 8867 FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 886A 29               add  hl, hl
 790+ 886B 29               add  hl, hl
 791+ 886C 29               add  hl, hl
 792+ 886D 29               add  hl, hl
 793+ 886E 29               add  hl, hl                    ; Row * 32
 794+ 886F 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 8870
 796+ 8870                  ; Aggiorna items_grid
 797+ 8870 E5               push hl
 798+ 8871 11 F1 E8         ld   de, items_grid
 799+ 8874 19               add  hl, de
 800+ 8875 70               ld   (hl), b
 801+ 8876 E1               pop  hl
 802+ 8877
 803+ 8877                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 8877 11 00 58         ld   de, $5800
 805+ 887A 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 887B 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 887C
 808+ 887C              .next_anim_item:
 809+ 887C 01 05 00         ld   bc, 5
 810+ 887F FD 09            add  iy, bc
 811+ 8881 18 C4            jr   .anim_loop
 812+ 8883
 813+ 8883              .anim_done:
 814+ 8883 FD E1            pop  iy
 815+ 8885 C1               pop  bc
 816+ 8886 D1               pop  de
 817+ 8887 E1               pop  hl
 818+ 8888 C9               ret

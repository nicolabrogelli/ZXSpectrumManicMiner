 414+ 86C3              ; CheckWillyItemCollision
 415+ 86C3              ;
 416+ 86C3              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 86C3              ; Input:
 418+ 86C3              ;   A = Item Col (0..31)
 419+ 86C3              ;   H = Item Row (0..15)
 420+ 86C3              ; Output:
 421+ 86C3              ;   Carry Set = Collisione
 422+ 86C3              ;   Carry Clear = Nessuna collisione
 423+ 86C3              ; -------------------------------------------------------------------
 424+ 86C3              CheckWillyItemCollision:
 425+ 86C3 C5               push bc
 426+ 86C4 D5               push de
 427+ 86C5 E5               push hl
 428+ 86C6
 429+ 86C6                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 86C6 6F               ld   l, a
 431+ 86C7 87               add  a, a                      ; *2
 432+ 86C8 87               add  a, a                      ; *4
 433+ 86C9 87               add  a, a                      ; *8
 434+ 86CA 5F               ld   e, a                      ; E = ItemLeft
 435+ 86CB C6 07            add  a, 7
 436+ 86CD 57               ld   d, a                      ; D = ItemRight
 437+ 86CE
 438+ 86CE ED 4B DE EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 86D2
 440+ 86D2                  ; WillyLeft <= ItemRight
 441+ 86D2 79               ld   a, c                      ; A = WillyX
 442+ 86D3 BA               cp   d                         ; D = ItemRight
 443+ 86D4 28 04            jr   z, .x_ok
 444+ 86D6 38 02            jr   c, .x_ok
 445+ 86D8 18 31            jr   .no_collision
 446+ 86DA
 447+ 86DA              .x_ok:
 448+ 86DA                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 86DA BB               cp   e                         ; E = ItemLeft
 450+ 86DB 28 0B            jr   z, .y_check
 451+ 86DD 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 86DF
 453+ 86DF                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 86DF C6 07            add  a, 7
 455+ 86E1 BB               cp   e
 456+ 86E2 28 04            jr   z, .y_check
 457+ 86E4 30 02            jr   nc, .y_check
 458+ 86E6 18 23            jr   .no_collision
 459+ 86E8
 460+ 86E8              .y_check:
 461+ 86E8                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 86E8 7C               ld   a, h                      ; H = Item Row
 463+ 86E9 87               add  a, a                      ; *2
 464+ 86EA 87               add  a, a                      ; *4
 465+ 86EB 87               add  a, a                      ; *8
 466+ 86EC 5F               ld   e, a                      ; E = ItemTop
 467+ 86ED C6 07            add  a, 7
 468+ 86EF 57               ld   d, a                      ; D = ItemBottom
 469+ 86F0
 470+ 86F0                  ; WillyTop <= ItemBottom
 471+ 86F0 78               ld   a, b                      ; A = WillyY
 472+ 86F1 BA               cp   d                         ; D = ItemBottom
 473+ 86F2 28 04            jr   z, .y_ok
 474+ 86F4 38 02            jr   c, .y_ok
 475+ 86F6 18 13            jr   .no_collision
 476+ 86F8
 477+ 86F8              .y_ok:
 478+ 86F8                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 86F8 BB               cp   e                         ; E = ItemTop
 480+ 86F9 28 0B            jr   z, .collision
 481+ 86FB 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 86FD
 483+ 86FD                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 86FD C6 0F            add  a, 15
 485+ 86FF BB               cp   e
 486+ 8700 28 04            jr   z, .collision
 487+ 8702 30 02            jr   nc, .collision
 488+ 8704 18 05            jr   .no_collision

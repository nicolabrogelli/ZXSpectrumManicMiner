 642+ 8384 3A EF CC         ld   a, (player_score + 1)
 643+ 8387 C6 01            add  a, $01
 644+ 8389 27               daa
 645+ 838A 32 EF CC         ld   (player_score + 1), a
 646+ 838D
 647+ 838D                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 648+ 838D 3A F0 CC         ld   a, (player_score + 2)

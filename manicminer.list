2019+ 7CBD              ; Phys_UpdateAir
2020+ 7CBD              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2021+ 7CBD              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2022+ 7CBD              ; Output:
2023+ 7CBD              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2024+ 7CBD              ;   Carry Clear = Aria ancora disponibile
2025+ 7CBD              ; -------------------------------------------------------------------
2026+ 7CBD              Phys_UpdateAir:
2027+ 7CBD                  ; Incrementa il timer dei frame
2028+ 7CBD 3A 51 A4         ld   a, (air_timer)
2029+ 7CC0 3C               inc  a
2030+ 7CC1 32 51 A4         ld   (air_timer), a
2031+ 7CC4 21 52 A4         ld   hl, air_deplete_rate
2032+ 7CC7 BE               cp   (hl)
2033+ 7CC8 38 14            jr   c, .no_deplete
2034+ 7CCA
2035+ 7CCA                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2036+ 7CCA AF               xor  a
2037+ 7CCB 32 51 A4         ld   (air_timer), a
2038+ 7CCE
2039+ 7CCE 3A 50 A4         ld   a, (air_pixels)
2040+ 7CD1 B7               or   a
2041+ 7CD2 28 0C            jr   z, .air_finished
2042+ 7CD4
2043+ 7CD4 3D               dec  a
2044+ 7CD5 32 50 A4         ld   (air_pixels), a
2045+ 7CD8 CD 6C 6A         call Gfx_UpdateAirBar
2046+ 7CDB
2047+ 7CDB B7               or   a
2048+ 7CDC 28 02            jr   z, .air_finished
2049+ 7CDE
2050+ 7CDE              .no_deplete:
2051+ 7CDE B7               or   a                     ; Carry Clear = Ok
2052+ 7CDF C9               ret
2053+ 7CE0
2054+ 7CE0              .air_finished:
2055+ 7CE0 37               scf                        ; Carry Set = Morte per esaurimento aria
2056+ 7CE1 C9               ret

 464+ 82B8                  ; WillyTop <= ItemBottom
 465+ 82B8 78               ld   a, b                      ; A = WillyY
 466+ 82B9 BA               cp   d                         ; D = ItemBottom
 467+ 82BA 28 04            jr   z, .y_ok
 468+ 82BC 38 02            jr   c, .y_ok
 469+ 82BE 18 13            jr   .no_collision
 470+ 82C0
 471+ 82C0              .y_ok:
 472+ 82C0                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 82C0 BB               cp   e                         ; E = ItemTop
 474+ 82C1 28 0B            jr   z, .collision
 475+ 82C3 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 82C5
 477+ 82C5                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 82C5 C6 0F            add  a, 15

 149+ 6F08              .conv_is_right:
 150+ 6F08                  ; ── CONVEYOR VA A DESTRA (conveyor_dir == 1) ──
 151+ 6F08                  ; Tasto opposto = SINISTRA (bit 0 di D)
 152+ 6F08 CB 42            bit  $00, d                 ; Premuto SINISTRA (opposto)?
 153+ 6F0A 20 0D            jr   nz, .check_oppose_left
 154+ 6F0C
 155+ 6F0C                  ; Non sta premendo Sinistra: Willy viene catturato dal nastro a Destra
 156+ 6F0C 3E 01            ld   a, 1
 157+ 6F0E 32 32 E5         ld   (conveyor_caught), a
 158+ 6F11
 159+ 6F11                  ; Muovi a Destra (trascinamento del nastro)
 160+ 6F11 3E 02            ld   a, 2
 161+ 6F13 32 0E E2         ld   (direction), a
 162+ 6F16 C3 65 6F         jp   movePlayer_right
 163+ 6F19
 164+ 6F19              .check_oppose_left:
 165+ 6F19                  ; Sta premendo Sinistra contro il nastro a Destra.
 166+ 6F19                  ; Se era già stato catturato (tasto rilasciato prima sul nastro), ignora l'input!
 167+ 6F19 3A 32 E5         ld   a, (conveyor_caught)
 168+ 6F1C B7               or   a
 169+ 6F1D 20 08            jr   nz, .left_ignored_drag_right
 170+ 6F1F
 171+ 6F1F                  ; Non era ancora catturato: continua a muoversi a Sinistra!
 172+ 6F1F 3E 01            ld   a, 1

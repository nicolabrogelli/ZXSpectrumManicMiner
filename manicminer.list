 461+ 8203 C6 07            add  a, 7
 462+ 8205 57               ld   d, a                      ; D = ItemBottom
 463+ 8206
 464+ 8206                  ; WillyTop <= ItemBottom
 465+ 8206 78               ld   a, b                      ; A = WillyY
 466+ 8207 BA               cp   d                         ; D = ItemBottom
 467+ 8208 28 04            jr   z, .y_ok
 468+ 820A 38 02            jr   c, .y_ok
 469+ 820C 18 13            jr   .no_collision
 470+ 820E
 471+ 820E              .y_ok:
 472+ 820E                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 820E BB               cp   e                         ; E = ItemTop
 474+ 820F 28 0B            jr   z, .collision
 475+ 8211 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 8213
 477+ 8213                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 8213 C6 0F            add  a, 15
 479+ 8215 BB               cp   e
 480+ 8216 28 04            jr   z, .collision
 481+ 8218 30 02            jr   nc, .collision
 482+ 821A 18 05            jr   .no_collision

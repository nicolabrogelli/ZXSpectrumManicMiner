  82+ 7E34 23               inc  hl
  83+ 7E35 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7E36
  85+ 7E36                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7E36 E5               push hl
  87+ 7E37 C5               push bc
  88+ 7E38 67               ld   h, a
  89+ 7E39 69               ld   l, c
  90+ 7E3A 01 00 A4         ld   bc, -23552

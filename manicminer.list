   2+ 8023              ; items.asm
   3+ 8023              ;
   4+ 8023              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 8023              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 8023              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 8023              ;===========================================================================
   8+ 8023
   9+ 8023              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 8023
  11+ 8023              ; -------------------------------------------------------------------
  12+ 8023              ; DetermineCurrentRoomID
  13+ 8023              ;
  14+ 8023              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 8023              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 8023              ;
  17+ 8023              ; Output:
  18+ 8023              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 8023              ;   (current_room) = A
  20+ 8023              ; -------------------------------------------------------------------
  21+ 8023              DetermineCurrentRoomID:
  22+ 8023 E5               push hl
  23+ 8024 D5               push de
  24+ 8025 C5               push bc
  25+ 8026
  26+ 8026 21 0D 73         ld   hl, RoomsListTable
  27+ 8029 ED 5B 89 99      ld   de, (room_ptr)
  28+ 802D 06 02            ld   b, NUM_ROOMS
  29+ 802F 0E 00            ld   c, 0
  30+ 8031
  31+ 8031              .loop:
  32+ 8031 7E               ld   a, (hl)
  33+ 8032 BB               cp   e
  34+ 8033 20 06            jr   nz, .no_match
  35+ 8035 23               inc  hl
  36+ 8036 7E               ld   a, (hl)
  37+ 8037 BA               cp   d
  38+ 8038 28 08            jr   z, .found
  39+ 803A 2B               dec  hl
  40+ 803B
  41+ 803B              .no_match:
  42+ 803B 23               inc  hl
  43+ 803C 23               inc  hl
  44+ 803D 0C               inc  c
  45+ 803E 10 F1            djnz .loop
  46+ 8040
  47+ 8040 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 8042
  49+ 8042              .found:
  50+ 8042 79               ld   a, c
  51+ 8043 32 2F 99         ld   (current_room), a
  52+ 8046
  53+ 8046 C1               pop  bc
  54+ 8047 D1               pop  de
  55+ 8048 E1               pop  hl
  56+ 8049 C9               ret

 293+ 866C              ; DrawItemGraphic
 294+ 866C              ;
 295+ 866C              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 866C              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 866C              ;
 298+ 866C              ; Input:
 299+ 866C              ;   B = Riga attributi (0..23)

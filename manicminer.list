 660+ 82AF              ; Score_CheckAndUpdateHighScore
 661+ 82AF              ; Se player_score > high_score, copia player_score in high_score.
 662+ 82AF              ; -------------------------------------------------------------------
 663+ 82AF              Score_CheckAndUpdateHighScore:
 664+ 82AF                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 82AF                  ; Byte 2:
 666+ 82AF 3A 1A 9C         ld   a, (player_score + 2)
 667+ 82B2 47               ld   b, a
 668+ 82B3 3A 1D 9C         ld   a, (high_score + 2)
 669+ 82B6 B8               cp   b
 670+ 82B7 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 82B9 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 82BB
 673+ 82BB                  ; Byte 1:
 674+ 82BB 3A 19 9C         ld   a, (player_score + 1)
 675+ 82BE 47               ld   b, a
 676+ 82BF 3A 1C 9C         ld   a, (high_score + 1)
 677+ 82C2 B8               cp   b
 678+ 82C3 38 0C            jr   c, .new_high_score
 679+ 82C5 20 1C            jr   nz, .done_check
 680+ 82C7
 681+ 82C7                  ; Byte 0:
 682+ 82C7 3A 18 9C         ld   a, (player_score + 0)
 683+ 82CA 47               ld   b, a
 684+ 82CB 3A 1B 9C         ld   a, (high_score + 0)
 685+ 82CE B8               cp   b
 686+ 82CF 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 82D1

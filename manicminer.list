 271+ 6FAF              ; LoadPositionPlayeinRoom
 272+ 6FAF              ;
 273+ 6FAF              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6FAF              ; in una nuova stanza.
 275+ 6FAF              ;
 276+ 6FAF              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6FAF              ; (layout/metadata) a partire da room_ptr.
 278+ 6FAF              ;
 279+ 6FAF              ; Output:
 280+ 6FAF              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6FAF              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6FAF              ;
 283+ 6FAF              ; Struttura dati stanza:
 284+ 6FAF              ;   OFFSET_POS_WILLY:
 285+ 6FAF              ;       +0 = X
 286+ 6FAF              ;       +1 = Y
 287+ 6FAF              ; -------------------------------------------------------------------
 288+ 6FAF              LoadPositionPlayeinRoom:
 289+ 6FAF                  ; ---------------------------------------------------------------
 290+ 6FAF                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6FAF                  ; ---------------------------------------------------------------

1015+ 823F                  ; Willy lower or equal (DeltaY >= 0):
1016+ 823F                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
1017+ 823F 32 33 E8         ld   (row_enemy_cur), a

 161+ 7DE8              ; -------------------------------------------------------------------
 162+ 7DE8              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DE8              ; -------------------------------------------------------------------
 164+ 7DE8              CheckEnemyWillyOverlap:
 165+ 7DE8 3A 0F 9A         ld   a, (player_drawn_pos+1)
 166+ 7DEB FE FF            cp   $FF
 167+ 7DED C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7DEE
 169+ 7DEE                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7DEE 3A 0E 9A         ld   a, (player_drawn_pos)
 171+ 7DF1 E6 F8            and  $F8
 172+ 7DF3 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7DF4 79               ld   a, c
 174+ 7DF5 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7DF7 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7DF8 C6 10            add  a, 16
 177+ 7DFA FE 19            cp   25
 178+ 7DFC D0               ret  nc                 ; Fuori portata X
 179+ 7DFD
 180+ 7DFD                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7DFD 3A 0F 9A         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7E00 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7E01 C6 0F            add  a, 15
 184+ 7E03 FE 1F            cp   31
 185+ 7E05 D0               ret  nc                 ; Fuori portata Y
 186+ 7E06
 187+ 7E06                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7E06 3E 01            ld   a, 1
 189+ 7E08 32 14 9A         ld   (willy_needs_redraw), a
 190+ 7E0B C9               ret

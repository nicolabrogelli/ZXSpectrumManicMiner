   7+ 704D              ; Input_CheckCtrl
   8+ 704D              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 704D              ;
  10+ 704D              ; Output:
  11+ 704D              ;   D = bitmask tasti attivi:
  12+ 704D              ;       bit 0 → sinistra (O)
  13+ 704D              ;       bit 1 → destra   (P)
  14+ 704D              ;       bit 2 → salto    (Z)

 509+ 7F66 3A 1D E6         ld   a, (room_has_v_guardians)
 510+ 7F69 B7               or   a
 511+ 7F6A 20 0A            jr   nz, .h_use_second_half    ; Se ci sono guardiani verticali, i guardiani orizzontali usano la SECONDA METÀ (frame 4..7)!
 512+ 7F6C
 513+ 7F6C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7F6F FE 01            cp   1                         ; Sinistra?
 515+ 7F71 28 03            jr   z, .left_frames
 516+ 7F73
 517+ 7F73                  ; Movimento a Destra: Frame 0..3 (prima metà)
 518+ 7F73 7B               ld   a, e
 519+ 7F74 18 23            jr   .got_frame_idx

 121+ 7E0E 23               inc  hl
 122+ 7E0F 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7E10 E6 1F            and  31
 124+ 7E12 87               add  a, a
 124+ 7E13 87             add a, a
 124+ 7E14 87             add a, a
 125+ 7E15 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7E18
 127+ 7E18 23               inc  hl
 128+ 7E19 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7E1A E6 1F            and  31
 130+ 7E1C 87               add  a, a
 130+ 7E1D 87             add a, a
 130+ 7E1E 87             add a, a
 131+ 7E1F DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7E22
 133+ 7E22 23               inc  hl                        ; Prossimo guardiano
 134+ 7E23 11 0B 00         ld   de, 11
 135+ 7E26 DD 19            add  ix, de
 136+ 7E28 10 8E            djnz .load_h_loop

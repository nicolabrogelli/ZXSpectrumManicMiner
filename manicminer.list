 138+ 808E              ; Items_DrawRoom
 139+ 808E              ;
 140+ 808E              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 808E              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 808E              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 808E              ;
 144+ 808E              ; Record item nella stanza (5 byte):
 145+ 808E              ;   +0 Color / Attributo
 146+ 808E              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 808E              ;   +2 Attr Address High
 148+ 808E              ;   +3 Anim Mask (96)
 149+ 808E              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 808E              ; Fine lista: $FF
 151+ 808E              ; -------------------------------------------------------------------
 152+ 808E              Items_DrawRoom:
 153+ 808E E5               push hl
 154+ 808F D5               push de
 155+ 8090 C5               push bc
 156+ 8091 DD E5            push ix
 157+ 8093 FD E5            push iy
 158+ 8095
 159+ 8095                  ; 1. Azzera items_grid (512 byte)
 160+ 8095 21 09 94         ld   hl, items_grid
 161+ 8098 11 0A 94         ld   de, items_grid + 1
 162+ 809B 36 00            ld   (hl), 0
 163+ 809D 01 FF 01         ld   bc, 511
 164+ 80A0 ED B0            ldir
 165+ 80A2
 166+ 80A2                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 80A2 AF               xor  a
 168+ 80A3 32 88 99         ld   (num_room_items), a
 169+ 80A6
 170+ 80A6 FD 21 38 99      ld   iy, current_room_items
 171+ 80AA
 172+ 80AA                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80AA 2A 89 99         ld   hl, (room_ptr)
 174+ 80AD 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80B0 19               add  hl, de
 176+ 80B1 E5               push hl
 177+ 80B2 DD E1            pop  ix                        ; IX = bitmap item
 178+ 80B4
 179+ 80B4                  ; 4. HL = Inizio lista item nella stanza
 180+ 80B4 2A 89 99         ld   hl, (room_ptr)
 181+ 80B7 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80BA 19               add  hl, de
 183+ 80BB
 184+ 80BB              .loop:
 185+ 80BB 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80BC FE FF            cp   $FF
 187+ 80BE 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80C0
 189+ 80C0 5F               ld   e, a                      ; E = Color
 190+ 80C1 23               inc  hl
 191+ 80C2 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80C3 23               inc  hl
 193+ 80C4 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80C5 23               inc  hl                        ; Salta Anim Byte
 195+ 80C6 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80C7
 197+ 80C7 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80C8 FE FF            cp   $FF
 199+ 80CA 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 80CC
 201+ 80CC                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 80CC E5               push hl
 203+ 80CD 60               ld   h, b
 204+ 80CE 69               ld   l, c
 205+ 80CF 01 00 A4         ld   bc, -23552
 206+ 80D2 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80D3
 208+ 80D3                  ; Col = Offset & 31
 209+ 80D3 7D               ld   a, l
 210+ 80D4 E6 1F            and  31
 211+ 80D6 4F               ld   c, a                      ; C = Col (0..31)
 212+ 80D7
 213+ 80D7                  ; Row = Offset / 32
 214+ 80D7 CB 3C            srl  h
 214+ 80D9 CB 1D          rr l
 215+ 80DB CB 3C            srl  h
 215+ 80DD CB 1D          rr l
 216+ 80DF CB 3C            srl  h

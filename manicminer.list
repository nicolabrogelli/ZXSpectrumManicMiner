  72+ 882D ~            ; Audio_UpdateMusic
  73+ 882D ~            ;
  74+ 882D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 882D ~            ; Viene chiamata a ogni frame.
  76+ 882D ~            ; -------------------------------------------------------------------
  77+ 882D ~            Audio_UpdateMusic:
  78+ 882D ~                push af
  79+ 882D ~                push bc
  80+ 882D ~                push de
  81+ 882D ~                push hl
  82+ 882D ~
  83+ 882D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 882D ~                ld   a, (Audio_jump_sound_note)
  85+ 882D ~                cp   18
  86+ 882D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 882D ~
  88+ 882D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 882D ~                ld   a, (Audio_music_frame_counter)
  90+ 882D ~                dec  a
  91+ 882D ~                ld   (Audio_music_frame_counter), a
  92+ 882D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 882D ~
  94+ 882D ~                ; Altrimenti carica la nota successiva
  95+ 882D ~                ld   a, (Audio_music_note_idx)
  96+ 882D ~                inc  a
  97+ 882D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 882D ~                jr   c, .no_wrap
  99+ 882D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 882D ~            .no_wrap:
 101+ 882D ~                ld   (Audio_music_note_idx), a
 102+ 882D ~
 103+ 882D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 882D ~                ld   e, a
 105+ 882D ~                ld   d, 0
 106+ 882D ~                ld   hl, Audio_MusicSheet
 107+ 882D ~                add  hl, de
 108+ 882D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 882D ~
 110+ 882D ~                ; Leggi durata (secondo byte)
 111+ 882D ~                inc  hl
 112+ 882D ~                ld   a, (hl)
 113+ 882D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 882D ~                jr   nz, .dur_ok
 115+ 882D ~                ld   a, 1
 116+ 882D ~            .dur_ok:
 117+ 882D ~                ld   (Audio_music_frame_counter), a
 118+ 882D ~
 119+ 882D ~            .play_current_note:
 120+ 882D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 882D ~                ld   a, (Audio_music_note_idx)
 122+ 882D ~                ld   e, a
 123+ 882D ~                ld   d, 0
 124+ 882D ~                ld   hl, Audio_MusicSheet
 125+ 882D ~                add  hl, de
 126+ 882D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 882D ~                ld   a, (hl)                  ; A = delay
 128+ 882D ~                or   a
 129+ 882D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 882D ~
 131+ 882D ~                ; Suona la nota: 2 cicli
 132+ 882D ~                ld   d, a                     ; D = delay
 133+ 882D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 882D ~            .note_loop:
 135+ 882D ~                ; Speaker ON
 136+ 882D ~                ld   a, (room_border_color)
 137+ 882D ~                or   $10
 138+ 882D ~                out  ($fe), a
 139+ 882D ~                ld   c, d
 140+ 882D ~            .d1:
 141+ 882D ~                push af
 142+ 882D ~                pop  af
 143+ 882D ~                dec  c
 144+ 882D ~                jr   nz, .d1
 145+ 882D ~
 146+ 882D ~                ; Speaker OFF
 147+ 882D ~                ld   a, (room_border_color)
 148+ 882D ~                and  $ef
 149+ 882D ~                out  ($fe), a
 150+ 882D ~                ld   c, d
 151+ 882D ~            .d2:
 152+ 882D ~                push af
 153+ 882D ~                pop  af
 154+ 882D ~                dec  c
 155+ 882D ~                jr   nz, .d2
 156+ 882D ~
 157+ 882D ~                djnz .note_loop
 158+ 882D ~
 159+ 882D ~            .done:
 160+ 882D ~                pop  hl
 161+ 882D ~                pop  de
 162+ 882D ~                pop  bc
 163+ 882D ~                pop  af
 164+ 882D ~                ret
 165+ 882D ~
 166+ 882D ~            Audio_MusicSheet:
 167+ 882D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 882D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 882D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 882D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 882D ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 882D ~                db 90, 10, 107, 20, 68, 65

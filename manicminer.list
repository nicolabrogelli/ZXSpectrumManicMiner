 625+ 8017              ; Score_AddItemPoints
 626+ 8017              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 8017              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 8017              ; -------------------------------------------------------------------
 629+ 8017              Score_AddItemPoints:
 630+ 8017 F5               push af
 631+ 8018 C5               push bc
 632+ 8019 D5               push de
 633+ 801A E5               push hl
 634+ 801B
 635+ 801B                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 801B 3A 99 99         ld   a, (player_score + 1)
 637+ 801E C6 01            add  a, $01
 638+ 8020 27               daa
 639+ 8021 32 99 99         ld   (player_score + 1), a
 640+ 8024
 641+ 8024                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8024 3A 9A 99         ld   a, (player_score + 2)
 643+ 8027 CE 00            adc  a, 0
 644+ 8029 27               daa
 645+ 802A 32 9A 99         ld   (player_score + 2), a
 646+ 802D
 647+ 802D                  ; Controlla se player_score ha superato high_score
 648+ 802D CD 38 80         call Score_CheckAndUpdateHighScore
 649+ 8030
 650+ 8030                  ; Aggiorna visualizzazione a schermo
 651+ 8030 CD BB 67         call Gfx_UpdateScoreDisplay
 652+ 8033
 653+ 8033 E1               pop  hl
 654+ 8034 D1               pop  de
 655+ 8035 C1               pop  bc
 656+ 8036 F1               pop  af
 657+ 8037 C9               ret
 658+ 8038
 659+ 8038              ; -------------------------------------------------------------------
 660+ 8038              ; Score_CheckAndUpdateHighScore
 661+ 8038              ; Se player_score > high_score, copia player_score in high_score.
 662+ 8038              ; -------------------------------------------------------------------
 663+ 8038              Score_CheckAndUpdateHighScore:
 664+ 8038                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 8038                  ; Byte 2:
 666+ 8038 3A 9A 99         ld   a, (player_score + 2)
 667+ 803B 47               ld   b, a
 668+ 803C 3A 9D 99         ld   a, (high_score + 2)
 669+ 803F B8               cp   b
 670+ 8040 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 8042 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 8044
 673+ 8044                  ; Byte 1:
 674+ 8044 3A 99 99         ld   a, (player_score + 1)
 675+ 8047 47               ld   b, a
 676+ 8048 3A 9C 99         ld   a, (high_score + 1)
 677+ 804B B8               cp   b
 678+ 804C 38 0C            jr   c, .new_high_score
 679+ 804E 20 1C            jr   nz, .done_check
 680+ 8050
 681+ 8050                  ; Byte 0:
 682+ 8050 3A 98 99         ld   a, (player_score + 0)
 683+ 8053 47               ld   b, a
 684+ 8054 3A 9B 99         ld   a, (high_score + 0)
 685+ 8057 B8               cp   b
 686+ 8058 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 805A
 688+ 805A              .new_high_score:
 689+ 805A 3A 98 99         ld   a, (player_score + 0)
 690+ 805D 32 9B 99         ld   (high_score + 0), a
 691+ 8060 3A 99 99         ld   a, (player_score + 1)
 692+ 8063 32 9C 99         ld   (high_score + 1), a
 693+ 8066 3A 9A 99         ld   a, (player_score + 2)
 694+ 8069 32 9D 99         ld   (high_score + 2), a
 695+ 806C
 696+ 806C              .done_check:
 697+ 806C C9               ret

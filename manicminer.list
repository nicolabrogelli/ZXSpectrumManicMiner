 127+ 8728 ~                ld   a, (hl)                  ; A = delay
 128+ 8728 ~                or   a
 129+ 8728 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8728 ~
 131+ 8728 ~                ; Suona la nota: 2 cicli
 132+ 8728 ~                ld   d, a                     ; D = delay
 133+ 8728 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8728 ~            .note_loop:
 135+ 8728 ~                ; Speaker ON
 136+ 8728 ~                ld   a, (room_border_color)
 137+ 8728 ~                or   $10
 138+ 8728 ~                out  ($fe), a
 139+ 8728 ~                ld   c, d
 140+ 8728 ~            .d1:
 141+ 8728 ~                push af
 142+ 8728 ~                pop  af
 143+ 8728 ~                dec  c
 144+ 8728 ~                jr   nz, .d1
 145+ 8728 ~
 146+ 8728 ~                ; Speaker OFF
 147+ 8728 ~                ld   a, (room_border_color)
 148+ 8728 ~                and  $ef
 149+ 8728 ~                out  ($fe), a
 150+ 8728 ~                ld   c, d
 151+ 8728 ~            .d2:
 152+ 8728 ~                push af
 153+ 8728 ~                pop  af
 154+ 8728 ~                dec  c
 155+ 8728 ~                jr   nz, .d2
 156+ 8728 ~
 157+ 8728 ~                djnz .note_loop
 158+ 8728 ~
 159+ 8728 ~            .done:
 160+ 8728 ~                pop  hl
 161+ 8728 ~                pop  de
 162+ 8728 ~                pop  bc
 163+ 8728 ~                pop  af
 164+ 8728 ~                ret

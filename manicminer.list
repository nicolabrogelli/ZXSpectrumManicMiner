1806+ 7B84              ; Phys_CheckCrumblingTrigger
1807+ 7B84              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1808+ 7B84              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1809+ 7B84              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1810+ 7B84              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1811+ 7B84              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1812+ 7B84              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1813+ 7B84              ; -------------------------------------------------------------------
1814+ 7B84              Phys_CheckCrumblingTrigger:
1815+ 7B84 C5               push bc
1816+ 7B85 D5               push de
1817+ 7B86 E5               push hl
1818+ 7B87
1819+ 7B87 ED 4B 12 E2      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1820+ 7B8B
1821+ 7B8B                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1822+ 7B8B 78               ld   a, b
1823+ 7B8C C6 10            add  a, 16
1824+ 7B8E FE 80            cp   128
1825+ 7B90 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1826+ 7B92
1827+ 7B92 CB 3F            srl  a
1827+ 7B94 CB 3F          srl  a
1827+ 7B96 CB 3F          srl  a   ; A = Row (0..15)
1828+ 7B98 47               ld   b, a                  ; B = Row
1829+ 7B99
1830+ 7B99                  ; Piede sinistro: Col1 = PlayerX / 8
1831+ 7B99 79               ld   a, c
1832+ 7B9A CB 3F            srl  a
1832+ 7B9C CB 3F          srl  a
1832+ 7B9E CB 3F          srl  a   ; A = Col1 (0..31)
1833+ 7BA0 4F               ld   c, a                  ; C = Col1
1834+ 7BA1
1835+ 7BA1                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1836+ 7BA1 78               ld   a, b
1837+ 7BA2 CD B6 78         call GetCellFromUnpacked
1838+ 7BA5 FE 02            cp   2
1839+ 7BA7 20 03            jr   nz, .check_col2
1840+ 7BA9
1841+ 7BA9                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1842+ 7BA9 CD DF 7B         call .advance_crumble_cell
1843+ 7BAC
1844+ 7BAC              .check_col2:
1845+ 7BAC                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1846+ 7BAC ED 4B 12 E2      ld   bc, (PlayerPos)
1847+ 7BB0 78               ld   a, b
1848+ 7BB1 C6 10            add  a, 16
1849+ 7BB3 CB 3F            srl  a
1849+ 7BB5 CB 3F          srl  a
1849+ 7BB7 CB 3F          srl  a
1850+ 7BB9 47               ld   b, a                  ; B = Row
1851+ 7BBA
1852+ 7BBA 79               ld   a, c
1853+ 7BBB C6 07            add  a, 7
1854+ 7BBD CB 3F            srl  a
1854+ 7BBF CB 3F          srl  a
1854+ 7BC1 CB 3F          srl  a   ; A = Col2 (0..31)
1855+ 7BC3 4F               ld   c, a                  ; C = Col2
1856+ 7BC4
1857+ 7BC4                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1858+ 7BC4 3A 12 E2         ld   a, (PlayerPos)        ; A = PlayerX
1859+ 7BC7 CB 3F            srl  a
1859+ 7BC9 CB 3F          srl  a
1859+ 7BCB CB 3F          srl  a   ; A = Col1
1860+ 7BCD B9               cp   c
1861+ 7BCE 28 0B            jr   z, .done_trigger
1862+ 7BD0
1863+ 7BD0 78               ld   a, b
1864+ 7BD1 CD B6 78         call GetCellFromUnpacked
1865+ 7BD4 FE 02            cp   2
1866+ 7BD6 20 03            jr   nz, .done_trigger
1867+ 7BD8
1868+ 7BD8                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1869+ 7BD8 CD DF 7B         call .advance_crumble_cell
1870+ 7BDB
1871+ 7BDB              .done_trigger:
1872+ 7BDB E1               pop  hl
1873+ 7BDC D1               pop  de
1874+ 7BDD C1               pop  bc
1875+ 7BDE C9               ret
1876+ 7BDF
1877+ 7BDF              .advance_crumble_cell:
1878+ 7BDF                  ; Input: B = Row, C = Col
1879+ 7BDF C5               push bc
1880+ 7BE0 D5               push de
1881+ 7BE1 E5               push hl
1882+ 7BE2
1883+ 7BE2                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1884+ 7BE2 68               ld   l, b
1885+ 7BE3 26 00            ld   h, 0
1886+ 7BE5 29               add  hl, hl
1886+ 7BE6 29             add hl, hl
1886+ 7BE7 29             add hl, hl
1886+ 7BE8 29             add hl, hl
1886+ 7BE9 29             add hl, hl
1887+ 7BEA 59               ld   e, c
1888+ 7BEB 16 00            ld   d, 0
1889+ 7BED 19               add  hl, de
1890+ 7BEE 11 23 E6         ld   de, crumbling_grid
1891+ 7BF1 19               add  hl, de
1892+ 7BF2
1893+ 7BF2                  ; 2. Avanza di 1 stadio
1894+ 7BF2 7E               ld   a, (hl)               ; A = Stage (0..8)
1895+ 7BF3 FE 08            cp   8
1896+ 7BF5 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
1897+ 7BF7
1898+ 7BF7 3C               inc  a                     ; Avanza di 1 scanline (1..8)
1899+ 7BF8 77               ld   (hl), a
1900+ 7BF9 5F               ld   e, a                  ; E = nuovo Stage (1..8)
1901+ 7BFA
1902+ 7BFA                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
1903+ 7BFA E5               push hl
1904+ 7BFB CD 24 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
1905+ 7BFE E1               pop  hl
1906+ 7BFF
1907+ 7BFF                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
1908+ 7BFF 7E               ld   a, (hl)
1909+ 7C00 FE 08            cp   8
1910+ 7C02 38 12            jr   c, .done_advance
1911+ 7C04
1912+ 7C04                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
1913+ 7C04 68               ld   l, b                  ; L = Row
1914+ 7C05 26 00            ld   h, 0
1915+ 7C07 29               add  hl, hl
1915+ 7C08 29             add hl, hl
1915+ 7C09 29             add hl, hl
1915+ 7C0A 29             add hl, hl
1915+ 7C0B 29             add hl, hl
1916+ 7C0C 59               ld   e, c
1917+ 7C0D 16 00            ld   d, 0
1918+ 7C0F 19               add  hl, de
1919+ 7C10 11 38 E3         ld   de, unpacked_layout
1920+ 7C13 19               add  hl, de
1921+ 7C14 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
1922+ 7C16
1923+ 7C16              .done_advance:
1924+ 7C16 E1               pop  hl
1925+ 7C17 D1               pop  de
1926+ 7C18 C1               pop  bc
1927+ 7C19 C9               ret

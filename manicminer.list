  78+ 7D7B DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7D7E
  80+ 7D7E 23               inc  hl
  81+ 7D7F 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7D80 23               inc  hl
  83+ 7D81 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7D82
  85+ 7D82                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7D82 E5               push hl
  87+ 7D83 C5               push bc

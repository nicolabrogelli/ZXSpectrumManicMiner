 734  8394              ; CheckWillyConveyorCollision
 735  8394              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 736  8394              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 737  8394              ; -------------------------------------------------------------------
 738  8394              CheckWillyConveyorCollision:
 739  8394 C5               push bc
 740  8395 D5               push de
 741  8396 E5               push hl
 742  8397
 743  8397                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 744  8397 CD BD 74         call CheckWillyOnConveyor
 745  839A 38 49            jr   c, .collision_detected
 746  839C
 747  839C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 748  839C 3A BC 91         ld   a, (conveyor_len)
 749  839F B7               or   a
 750  83A0 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 751  83A2
 752  83A2                  ; B = WillyY, C = WillyX
 753  83A2 ED 4B 94 8E      ld   bc, (PlayerPos)
 754  83A6
 755  83A6                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 756  83A6 3A BD 91         ld   a, (conveyor_row)
 757  83A9 87               add  a, a                  ; *2
 758  83AA 87               add  a, a                  ; *4
 759  83AB 87               add  a, a                  ; *8
 760  83AC 5F               ld   e, a                  ; E = ConveyorTop
 761  83AD C6 07            add  a, 7
 762  83AF 57               ld   d, a                  ; D = ConveyorBottom
 763  83B0
 764  83B0                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 765  83B0 78               ld   a, b                  ; WillyTop
 766  83B1 BA               cp   d
 767  83B2 28 04            jr   z, .y_overlap
 768  83B4 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 769  83B6 18 32            jr   .no_conv_collision
 770  83B8
 771  83B8              .y_overlap:
 772  83B8 C6 0F            add  a, 15                 ; WillyBottom
 773  83BA BB               cp   e
 774  83BB 28 04            jr   z, .x_check
 775  83BD 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 776  83BF 18 29            jr   .no_conv_collision
 777  83C1
 778  83C1              .x_check:
 779  83C1                  ; ConveyorLeft = conveyor_col * 8
 780  83C1 3A BE 91         ld   a, (conveyor_col)
 781  83C4 87               add  a, a                  ; *2
 782  83C5 87               add  a, a                  ; *4
 783  83C6 87               add  a, a                  ; *8
 784  83C7 5F               ld   e, a                  ; E = ConveyorLeft
 785  83C8
 786  83C8                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 787  83C8 21 BC 91         ld   hl, conveyor_len
 788  83CB 3A BE 91         ld   a, (conveyor_col)
 789  83CE 86               add  a, (hl)
 790  83CF 87               add  a, a                  ; *2
 791  83D0 87               add  a, a                  ; *4
 792  83D1 87               add  a, a                  ; *8
 793  83D2 3D               dec  a                     ; ConveyorRight
 794  83D3 57               ld   d, a                  ; D = ConveyorRight
 795  83D4
 796  83D4                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 797  83D4 79               ld   a, c                  ; WillyLeft
 798  83D5 BA               cp   d
 799  83D6 28 04            jr   z, .x_overlap
 800  83D8 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 801  83DA 18 0E            jr   .no_conv_collision
 802  83DC
 803  83DC              .x_overlap:
 804  83DC C6 0F            add  a, 15                 ; WillyRight
 805  83DE BB               cp   e
 806  83DF 28 04            jr   z, .collision_detected
 807  83E1 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 808  83E3 18 05            jr   .no_conv_collision
 809  83E5

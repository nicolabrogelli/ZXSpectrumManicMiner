  59+ 80A8              ; ResetItemsTable
  60+ 80A8              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 80A8              ; per tutte le stanze registrate in RoomsListTable.
  62+ 80A8              ; -------------------------------------------------------------------
  63+ 80A8              ResetItemsTable:
  64+ 80A8 E5               push hl
  65+ 80A9 D5               push de
  66+ 80AA C5               push bc
  67+ 80AB
  68+ 80AB 21 6B 73         ld   hl, RoomsListTable
  69+ 80AE 06 02            ld   b, NUM_ROOMS
  70+ 80B0
  71+ 80B0              .room_loop:
  72+ 80B0 C5               push bc
  73+ 80B1 5E               ld   e, (hl)
  74+ 80B2 23               inc  hl
  75+ 80B3 56               ld   d, (hl)
  76+ 80B4 23               inc  hl
  77+ 80B5 E5               push hl
  78+ 80B6
  79+ 80B6                  ; DE = room_ptr
  80+ 80B6 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 80B9 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 80BA
  83+ 80BA              .item_loop:
  84+ 80BA 7E               ld   a, (hl)
  85+ 80BB FE FF            cp   $FF
  86+ 80BD 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 80BF 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 80C0 23               inc  hl                        ; +2 (Attr Address High)
  89+ 80C1 23               inc  hl                        ; +3 (Anim mask)
  90+ 80C2 23               inc  hl                        ; +4 (Collected flag)
  91+ 80C3 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 80C5 23               inc  hl                        ; Avanza al prossimo item
  93+ 80C6 18 F2            jr   .item_loop
  94+ 80C8
  95+ 80C8              .next_room:
  96+ 80C8 E1               pop  hl
  97+ 80C9 C1               pop  bc
  98+ 80CA 10 E4            djnz .room_loop
  99+ 80CC
 100+ 80CC C1               pop  bc
 101+ 80CD D1               pop  de
 102+ 80CE E1               pop  hl
 103+ 80CF C9               ret

 386+ 7C2C              ; Enemy_Update
 387+ 7C2C              ;
 388+ 7C2C              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7C2C              ; -------------------------------------------------------------------
 390+ 7C2C              Enemy_Update:
 391+ 7C2C E5               push hl
 392+ 7C2D D5               push de
 393+ 7C2E C5               push bc
 394+ 7C2F DD E5            push ix
 395+ 7C31
 396+ 7C31 3E 01            ld   a, 1
 397+ 7C33 32 9D 92         ld   (enemy_was_updated), a
 398+ 7C36
 399+ 7C36 DD 21 FC 79      ld   ix, ActiveEnemies
 400+ 7C3A 06 08            ld   b, 8                      ; 8 slot
 401+ 7C3C              .loop:
 402+ 7C3C DD 7E 00         ld   a, (ix+0)                 ; Flags
 403+ 7C3F E6 80            and  $80                       ; Active?
 404+ 7C41 CA E0 7C         jp   z, .next
 405+ 7C44
 406+ 7C44                  ; 1. Aggiorna Anim State (0..3)
 407+ 7C44 DD 7E 07         ld   a, (ix+7)
 408+ 7C47 3C               inc  a
 409+ 7C48 E6 03            and  3
 410+ 7C4A DD 77 07         ld   (ix+7), a
 411+ 7C4D
 412+ 7C4D                  ; 2. Determina se orizzontale o verticale
 413+ 7C4D DD 7E 00         ld   a, (ix+0)
 414+ 7C50 E6 40            and  $40                       ; Vertical?
 415+ 7C52 C2 9C 7C         jp   nz, .vertical
 416+ 7C55
 417+ 7C55              .horizontal:
 418+ 7C55 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 419+ 7C58 FE 01            cp   1
 420+ 7C5A 20 20            jr   nz, .horiz_right
 421+ 7C5C
 422+ 7C5C              .horiz_left:
 423+ 7C5C DD 7E 02         ld   a, (ix+2)                 ; Current X
 424+ 7C5F D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 425+ 7C61 DD BE 04         cp   (ix+4)                    ; Min Limit
 426+ 7C64 28 08            jr   z, .h_rev_right
 427+ 7C66 38 06            jr   c, .h_rev_right
 428+ 7C68 DD 77 02         ld   (ix+2), a
 429+ 7C6B C3 E0 7C         jp   .next
 430+ 7C6E
 431+ 7C6E              .h_rev_right:
 432+ 7C6E DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 433+ 7C71 DD 77 02         ld   (ix+2), a
 434+ 7C74 3E 02            ld   a, 2
 435+ 7C76 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 436+ 7C79 C3 E0 7C         jp   .next
 437+ 7C7C
 438+ 7C7C              .horiz_right:
 439+ 7C7C DD 7E 02         ld   a, (ix+2)                 ; Current X
 440+ 7C7F C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 441+ 7C81 DD BE 05         cp   (ix+5)                    ; Max Limit
 442+ 7C84 28 08            jr   z, .h_rev_left
 443+ 7C86 30 06            jr   nc, .h_rev_left
 444+ 7C88 DD 77 02         ld   (ix+2), a
 445+ 7C8B C3 E0 7C         jp   .next
 446+ 7C8E
 447+ 7C8E              .h_rev_left:
 448+ 7C8E DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 449+ 7C91 DD 77 02         ld   (ix+2), a
 450+ 7C94 3E 01            ld   a, 1
 451+ 7C96 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 452+ 7C99 C3 E0 7C         jp   .next
 453+ 7C9C
 454+ 7C9C              .vertical:
 455+ 7C9C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 456+ 7C9F FE 01            cp   1
 457+ 7CA1 20 20            jr   nz, .vert_down
 458+ 7CA3
 459+ 7CA3              .vert_up:
 460+ 7CA3 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 461+ 7CA6 D6 02            sub  2
 462+ 7CA8 DD BE 04         cp   (ix+4)
 463+ 7CAB 28 08            jr   z, .v_rev_down
 464+ 7CAD 38 06            jr   c, .v_rev_down
 465+ 7CAF DD 77 03         ld   (ix+3), a
 466+ 7CB2 C3 E0 7C         jp   .next
 467+ 7CB5
 468+ 7CB5              .v_rev_down:
 469+ 7CB5 DD 7E 04         ld   a, (ix+4)
 470+ 7CB8 DD 77 03         ld   (ix+3), a
 471+ 7CBB 3E 02            ld   a, 2
 472+ 7CBD DD 77 06         ld   (ix+6), a
 473+ 7CC0 C3 E0 7C         jp   .next
 474+ 7CC3
 475+ 7CC3              .vert_down:
 476+ 7CC3 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 477+ 7CC6 C6 02            add  a, 2
 478+ 7CC8 DD BE 05         cp   (ix+5)
 479+ 7CCB 28 08            jr   z, .v_rev_up
 480+ 7CCD 30 06            jr   nc, .v_rev_up
 481+ 7CCF DD 77 03         ld   (ix+3), a
 482+ 7CD2 C3 E0 7C         jp   .next
 483+ 7CD5
 484+ 7CD5              .v_rev_up:
 485+ 7CD5 DD 7E 05         ld   a, (ix+5)
 486+ 7CD8 DD 77 03         ld   (ix+3), a
 487+ 7CDB 3E 01            ld   a, 1
 488+ 7CDD DD 77 06         ld   (ix+6), a
 489+ 7CE0
 490+ 7CE0              .next:
 491+ 7CE0 11 0B 00         ld   de, 11
 492+ 7CE3 DD 19            add  ix, de
 493+ 7CE5 05               dec  b
 494+ 7CE6 C2 3C 7C         jp   nz, .loop
 495+ 7CE9
 496+ 7CE9 DD E1            pop  ix
 497+ 7CEB C1               pop  bc
 498+ 7CEC D1               pop  de
 499+ 7CED E1               pop  hl
 500+ 7CEE C9               ret

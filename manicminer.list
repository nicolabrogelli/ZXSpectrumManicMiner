 512+ 8006
 513+ 8006 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 8009 FE 01            cp   1                         ; Sinistra?
 515+ 800B 28 03            jr   z, .left_frames
 516+ 800D
 517+ 800D                  ; Movimento a Destra: Frame 0..3 (prima metà)

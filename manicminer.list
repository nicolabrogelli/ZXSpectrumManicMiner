 162+ 7B80              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7B80              ; -------------------------------------------------------------------
 164+ 7B80              CheckEnemyWillyOverlap:
 165+ 7B80 3A 77 93         ld   a, (player_drawn_pos+1)
 166+ 7B83 FE FF            cp   $FF
 167+ 7B85 C8               ret  z                  ; Se Willy non è disegnato, esci

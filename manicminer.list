 254+ 7E74                  ; ---------------------------------------------------------------
 255+ 7E74                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7E74                  ; ---------------------------------------------------------------
 257+ 7E74 DD 21 E2 7C      ld   ix, ActiveEnemies
 258+ 7E78 06 08            ld   b, 8              ; 8 slot
 259+ 7E7A              .draw_loop:
 260+ 7E7A DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7E7D E6 80            and  $80               ; Active?
 262+ 7E7F 28 37            jr   z, .next_draw
 263+ 7E81
 264+ 7E81                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E81 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E84 FE FF            cp   $FF
 267+ 7E86 28 16            jr   z, .do_draw_slot
 268+ 7E88
 269+ 7E88                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E88 DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E8B DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E8E 20 0E            jr   nz, .do_draw_slot
 273+ 7E90 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E93 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E96 20 06            jr   nz, .do_draw_slot
 276+ 7E98
 277+ 7E98 3A 3C A2         ld   a, (enemy_was_updated)
 278+ 7E9B B7               or   a
 279+ 7E9C 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7E9E
 281+ 7E9E              .do_draw_slot:
 282+ 7E9E C5               push bc                ; Salva contatore ciclo
 283+ 7E9F
 284+ 7E9F                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7E9F CD CA 7E         call Enemy_DrawSingleSlot
 286+ 7EA2
 287+ 7EA2                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 288+ 7EA2 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 289+ 7EA5 DD 46 03         ld   b, (ix+3)         ; B = Current Y

 414+ 82AA              ; CheckWillyItemCollision
 415+ 82AA              ;
 416+ 82AA              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 82AA              ; Input:
 418+ 82AA              ;   A = Item Col (0..31)
 419+ 82AA              ;   H = Item Row (0..15)
 420+ 82AA              ; Output:
 421+ 82AA              ;   Carry Set = Collisione
 422+ 82AA              ;   Carry Clear = Nessuna collisione
 423+ 82AA              ; -------------------------------------------------------------------
 424+ 82AA              CheckWillyItemCollision:
 425+ 82AA C5               push bc
 426+ 82AB D5               push de
 427+ 82AC E5               push hl
 428+ 82AD
 429+ 82AD                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 82AD 6F               ld   l, a
 431+ 82AE 87               add  a, a                      ; *2
 432+ 82AF 87               add  a, a                      ; *4
 433+ 82B0 87               add  a, a                      ; *8
 434+ 82B1 5F               ld   e, a                      ; E = ItemLeft
 435+ 82B2 C6 07            add  a, 7
 436+ 82B4 57               ld   d, a                      ; D = ItemRight
 437+ 82B5
 438+ 82B5 ED 4B EA DE      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 82B9
 440+ 82B9                  ; WillyLeft <= ItemRight
 441+ 82B9 79               ld   a, c                      ; A = WillyX
 442+ 82BA BA               cp   d                         ; D = ItemRight
 443+ 82BB 28 04            jr   z, .x_ok
 444+ 82BD 38 02            jr   c, .x_ok
 445+ 82BF 18 31            jr   .no_collision
 446+ 82C1
 447+ 82C1              .x_ok:
 448+ 82C1                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 82C1 BB               cp   e                         ; E = ItemLeft
 450+ 82C2 28 0B            jr   z, .y_check
 451+ 82C4 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 82C6
 453+ 82C6                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 82C6 C6 0F            add  a, 15
 455+ 82C8 BB               cp   e
 456+ 82C9 28 04            jr   z, .y_check
 457+ 82CB 30 02            jr   nc, .y_check
 458+ 82CD 18 23            jr   .no_collision
 459+ 82CF
 460+ 82CF              .y_check:
 461+ 82CF                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 82CF 7C               ld   a, h                      ; H = Item Row
 463+ 82D0 87               add  a, a                      ; *2
 464+ 82D1 87               add  a, a                      ; *4
 465+ 82D2 87               add  a, a                      ; *8
 466+ 82D3 5F               ld   e, a                      ; E = ItemTop
 467+ 82D4 C6 07            add  a, 7
 468+ 82D6 57               ld   d, a                      ; D = ItemBottom
 469+ 82D7
 470+ 82D7                  ; WillyTop <= ItemBottom
 471+ 82D7 78               ld   a, b                      ; A = WillyY
 472+ 82D8 BA               cp   d                         ; D = ItemBottom
 473+ 82D9 28 04            jr   z, .y_ok
 474+ 82DB 38 02            jr   c, .y_ok
 475+ 82DD 18 13            jr   .no_collision
 476+ 82DF
 477+ 82DF              .y_ok:
 478+ 82DF                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 82DF BB               cp   e                         ; E = ItemTop
 480+ 82E0 28 0B            jr   z, .collision
 481+ 82E2 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 82E4
 483+ 82E4                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 82E4 C6 0F            add  a, 15
 485+ 82E6 BB               cp   e
 486+ 82E7 28 04            jr   z, .collision
 487+ 82E9 30 02            jr   nc, .collision
 488+ 82EB 18 05            jr   .no_collision

 331  84C6 77               ld   (hl), a
 332  84C7 23               inc  hl
 333  84C8 10 FC            djnz .color_title_loop
 334  84CA
 335  84CA                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 336  84CA 3E BF            ld   a, $bf
 337  84CC DB FE            in   a, ($fe)
 338  84CE 1F               rra
 339  84CF 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop

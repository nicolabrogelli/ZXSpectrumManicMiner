  72+ 8452 ~            ; Audio_UpdateMusic
  73+ 8452 ~            ;
  74+ 8452 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8452 ~            ; Viene chiamata a ogni frame.
  76+ 8452 ~            ; -------------------------------------------------------------------
  77+ 8452 ~            Audio_UpdateMusic:
  78+ 8452 ~                push af
  79+ 8452 ~                push bc
  80+ 8452 ~                push de
  81+ 8452 ~                push hl
  82+ 8452 ~
  83+ 8452 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8452 ~                ld   a, (Audio_jump_sound_note)
  85+ 8452 ~                cp   18
  86+ 8452 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8452 ~
  88+ 8452 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8452 ~                ld   a, (Audio_music_frame_counter)
  90+ 8452 ~                dec  a
  91+ 8452 ~                ld   (Audio_music_frame_counter), a
  92+ 8452 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8452 ~
  94+ 8452 ~                ; Altrimenti carica la nota successiva
  95+ 8452 ~                ld   a, (Audio_music_note_idx)
  96+ 8452 ~                inc  a
  97+ 8452 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8452 ~                jr   c, .no_wrap
  99+ 8452 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8452 ~            .no_wrap:
 101+ 8452 ~                ld   (Audio_music_note_idx), a
 102+ 8452 ~
 103+ 8452 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8452 ~                ld   e, a
 105+ 8452 ~                ld   d, 0
 106+ 8452 ~                ld   hl, Audio_MusicSheet
 107+ 8452 ~                add  hl, de
 108+ 8452 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8452 ~
 110+ 8452 ~                ; Leggi durata (secondo byte)
 111+ 8452 ~                inc  hl
 112+ 8452 ~                ld   a, (hl)
 113+ 8452 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8452 ~                jr   nz, .dur_ok
 115+ 8452 ~                ld   a, 1
 116+ 8452 ~            .dur_ok:
 117+ 8452 ~                ld   (Audio_music_frame_counter), a
 118+ 8452 ~
 119+ 8452 ~            .play_current_note:
 120+ 8452 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8452 ~                ld   a, (Audio_music_note_idx)
 122+ 8452 ~                ld   e, a
 123+ 8452 ~                ld   d, 0
 124+ 8452 ~                ld   hl, Audio_MusicSheet
 125+ 8452 ~                add  hl, de
 126+ 8452 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8452 ~                ld   a, (hl)                  ; A = delay
 128+ 8452 ~                or   a
 129+ 8452 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8452 ~
 131+ 8452 ~                ; Suona la nota: 2 cicli
 132+ 8452 ~                ld   d, a                     ; D = delay
 133+ 8452 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8452 ~            .note_loop:
 135+ 8452 ~                ; Speaker ON
 136+ 8452 ~                ld   a, (room_border_color)
 137+ 8452 ~                or   $10
 138+ 8452 ~                out  ($fe), a
 139+ 8452 ~                ld   c, d
 140+ 8452 ~            .d1:
 141+ 8452 ~                push af
 142+ 8452 ~                pop  af
 143+ 8452 ~                dec  c
 144+ 8452 ~                jr   nz, .d1
 145+ 8452 ~
 146+ 8452 ~                ; Speaker OFF
 147+ 8452 ~                ld   a, (room_border_color)
 148+ 8452 ~                and  $ef
 149+ 8452 ~                out  ($fe), a
 150+ 8452 ~                ld   c, d
 151+ 8452 ~            .d2:
 152+ 8452 ~                push af
 153+ 8452 ~                pop  af
 154+ 8452 ~                dec  c
 155+ 8452 ~                jr   nz, .d2
 156+ 8452 ~
 157+ 8452 ~                djnz .note_loop
 158+ 8452 ~
 159+ 8452 ~            .done:
 160+ 8452 ~                pop  hl
 161+ 8452 ~                pop  de
 162+ 8452 ~                pop  bc
 163+ 8452 ~                pop  af
 164+ 8452 ~                ret
 165+ 8452 ~
 166+ 8452 ~            Audio_MusicSheet:
 167+ 8452 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8452 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8452 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8452 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8452 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5

   2+ 7DA6              ; items.asm
   3+ 7DA6              ;
   4+ 7DA6              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 7DA6              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 7DA6              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 7DA6              ;===========================================================================
   8+ 7DA6
   9+ 7DA6              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 7DA6
  11+ 7DA6              ; -------------------------------------------------------------------
  12+ 7DA6              ; DetermineCurrentRoomID
  13+ 7DA6              ;
  14+ 7DA6              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7DA6              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7DA6              ;
  17+ 7DA6              ; Output:
  18+ 7DA6              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7DA6              ;   (current_room) = A
  20+ 7DA6              ; -------------------------------------------------------------------
  21+ 7DA6              DetermineCurrentRoomID:
  22+ 7DA6 E5               push hl
  23+ 7DA7 D5               push de
  24+ 7DA8 C5               push bc
  25+ 7DA9
  26+ 7DA9 21 CC 70         ld   hl, RoomsListTable
  27+ 7DAC ED 5B F1 92      ld   de, (room_ptr)
  28+ 7DB0 06 01            ld   b, NUM_ROOMS
  29+ 7DB2 0E 00            ld   c, 0
  30+ 7DB4
  31+ 7DB4              .loop:
  32+ 7DB4 7E               ld   a, (hl)
  33+ 7DB5 BB               cp   e
  34+ 7DB6 20 06            jr   nz, .no_match
  35+ 7DB8 23               inc  hl
  36+ 7DB9 7E               ld   a, (hl)
  37+ 7DBA BA               cp   d
  38+ 7DBB 28 08            jr   z, .found
  39+ 7DBD 2B               dec  hl
  40+ 7DBE
  41+ 7DBE              .no_match:
  42+ 7DBE 23               inc  hl
  43+ 7DBF 23               inc  hl
  44+ 7DC0 0C               inc  c
  45+ 7DC1 10 F1            djnz .loop
  46+ 7DC3
  47+ 7DC3 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7DC5
  49+ 7DC5              .found:
  50+ 7DC5 79               ld   a, c
  51+ 7DC6 32 97 92         ld   (current_room), a
  52+ 7DC9
  53+ 7DC9 C1               pop  bc
  54+ 7DCA D1               pop  de
  55+ 7DCB E1               pop  hl
  56+ 7DCC C9               ret
  57+ 7DCD
  58+ 7DCD              ; -------------------------------------------------------------------
  59+ 7DCD              ; ResetItemsTable
  60+ 7DCD              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7DCD              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7DCD              ; -------------------------------------------------------------------
  63+ 7DCD              ResetItemsTable:
  64+ 7DCD E5               push hl
  65+ 7DCE D5               push de
  66+ 7DCF C5               push bc
  67+ 7DD0
  68+ 7DD0 21 CC 70         ld   hl, RoomsListTable

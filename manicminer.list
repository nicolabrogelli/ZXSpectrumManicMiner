  70+ 7D53
  71+ 7D53                  ; Slot attivo
  72+ 7D53 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D57 CB 7F            bit  7, a
  74+ 7D59 28 04            jr   z, .h_speed_normal
  75+ 7D5B DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)
  76+ 7D5F              .h_speed_normal:

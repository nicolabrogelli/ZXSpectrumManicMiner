 625+ 8285              ; Score_AddItemPoints
 626+ 8285              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 8285              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 8285              ; -------------------------------------------------------------------
 629+ 8285              Score_AddItemPoints:
 630+ 8285 F5               push af
 631+ 8286 C5               push bc
 632+ 8287 D5               push de
 633+ 8288 E5               push hl
 634+ 8289
 635+ 8289                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8289 3A 10 9C         ld   a, (player_score + 1)
 637+ 828C C6 01            add  a, $01
 638+ 828E 27               daa
 639+ 828F 32 10 9C         ld   (player_score + 1), a
 640+ 8292
 641+ 8292                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8292 3A 11 9C         ld   a, (player_score + 2)
 643+ 8295 CE 00            adc  a, 0
 644+ 8297 27               daa
 645+ 8298 32 11 9C         ld   (player_score + 2), a
 646+ 829B
 647+ 829B                  ; Controlla se player_score ha superato high_score
 648+ 829B CD A6 82         call Score_CheckAndUpdateHighScore
 649+ 829E
 650+ 829E                  ; Aggiorna visualizzazione a schermo
 651+ 829E CD DC 68         call Gfx_UpdateScoreDisplay
 652+ 82A1
 653+ 82A1 E1               pop  hl
 654+ 82A2 D1               pop  de
 655+ 82A3 C1               pop  bc
 656+ 82A4 F1               pop  af

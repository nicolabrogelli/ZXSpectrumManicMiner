 425+ 81A9 87               add  a, a                      ; *2
 426+ 81AA 87               add  a, a                      ; *4
 427+ 81AB 87               add  a, a                      ; *8
 428+ 81AC 5F               ld   e, a                      ; E = ItemLeft
 429+ 81AD C6 07            add  a, 7
 430+ 81AF 57               ld   d, a                      ; D = ItemRight
 431+ 81B0
 432+ 81B0 ED 4B 02 9A      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81B4
 434+ 81B4                  ; WillyLeft <= ItemRight
 435+ 81B4 79               ld   a, c                      ; A = WillyX
 436+ 81B5 BA               cp   d                         ; D = ItemRight
 437+ 81B6 28 04            jr   z, .x_ok
 438+ 81B8 38 02            jr   c, .x_ok
 439+ 81BA 18 31            jr   .no_collision
 440+ 81BC
 441+ 81BC              .x_ok:
 442+ 81BC                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81BC BB               cp   e                         ; E = ItemLeft
 444+ 81BD 28 0B            jr   z, .y_check
 445+ 81BF 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81C1
 447+ 81C1                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81C1 C6 0F            add  a, 15
 449+ 81C3 BB               cp   e
 450+ 81C4 28 04            jr   z, .y_check
 451+ 81C6 30 02            jr   nc, .y_check
 452+ 81C8 18 23            jr   .no_collision
 453+ 81CA
 454+ 81CA              .y_check:
 455+ 81CA                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81CA 7C               ld   a, h                      ; H = Item Row
 457+ 81CB 87               add  a, a                      ; *2
 458+ 81CC 87               add  a, a                      ; *4
 459+ 81CD 87               add  a, a                      ; *8

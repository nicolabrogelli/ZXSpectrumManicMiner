1081+ 7856              ; -------------------------------------------------------------------
1082+ 7856              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1083+ 7856              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1084+ 7856              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1085+ 7856              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1086+ 7856              ; -------------------------------------------------------------------
1087+ 7856              UnpackRoomLayout:
1088+ 7856 E5               push hl
1089+ 7857 D5               push de
1090+ 7858 C5               push bc
1091+ 7859 DD E5            push ix
1092+ 785B
1093+ 785B DD 2A 9E E5      ld   ix, (room_ptr)
1094+ 785F 11 20 02         ld   de, OFFSET_TILES
1095+ 7862 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1096+ 7864
1097+ 7864 2A 9E E5         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1098+ 7867 11 43 E3         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1099+ 786A 01 00 02         ld   bc, 512               ; 512 celle
1100+ 786D
1101+ 786D              .byte_loop:
1102+ 786D 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1103+ 786E 23               inc  hl
1104+ 786F
1105+ 786F                  ; Confronta con le 8 definizioni di tile:
1106+ 786F DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1107+ 7872 28 23            jr   z, .is_bg
1108+ 7874 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1109+ 7877 28 29            jr   z, .is_wall
1110+ 7879 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1111+ 787C 28 1C            jr   z, .is_floor
1112+ 787E DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1113+ 7881 28 1B            jr   z, .is_crumbling
1114+ 7883 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1115+ 7886 28 1E            jr   z, .is_conveyor
1116+ 7888 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1117+ 788B 28 1D            jr   z, .is_nasty1
1118+ 788D DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1119+ 7890 28 1C            jr   z, .is_nasty2
1120+ 7892 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1121+ 7895 28 1B            jr   z, .is_extra
1122+ 7897
1123+ 7897              .is_bg:
1124+ 7897                  ; Default: Tile 0 (Background)
1125+ 7897 AF               xor  a
1126+ 7898 18 1A            jr   .store_cell
1127+ 789A
1128+ 789A              .is_floor:
1129+ 789A 3E 01            ld   a, 1
1130+ 789C 18 16            jr   .store_cell
1131+ 789E              .is_crumbling:
1132+ 789E 3E 02            ld   a, 2
1133+ 78A0 18 12            jr   .store_cell
1134+ 78A2              .is_wall:
1135+ 78A2 3E 03            ld   a, 3
1136+ 78A4 18 0E            jr   .store_cell
1137+ 78A6              .is_conveyor:
1138+ 78A6 3E 04            ld   a, 4
1139+ 78A8 18 0A            jr   .store_cell
1140+ 78AA              .is_nasty1:
1141+ 78AA 3E 05            ld   a, 5
1142+ 78AC 18 06            jr   .store_cell
1143+ 78AE              .is_nasty2:
1144+ 78AE 3E 06            ld   a, 6
1145+ 78B0 18 02            jr   .store_cell
1146+ 78B2              .is_extra:
1147+ 78B2 3E 07            ld   a, 7
1148+ 78B4
1149+ 78B4              .store_cell:
1150+ 78B4 12               ld   (de), a
1151+ 78B5 13               inc  de
1152+ 78B6 0B               dec  bc
1153+ 78B7 78               ld   a, b
1154+ 78B8 B1               or   c
1155+ 78B9 20 B2            jr   nz, .byte_loop
1156+ 78BB
1157+ 78BB DD E1            pop  ix
1158+ 78BD C1               pop  bc
1159+ 78BE D1               pop  de
1160+ 78BF E1               pop  hl
1161+ 78C0 C9               ret

 926  835A              ; -------------------------------------------------------------------
 927  835A              ; Time_UpdateClock
 928  835A              ; Gestisce lo scorrimento del tempo durante il gioco.
 929  835A              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 930  835A              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 931  835A              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 932  835A              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 933  835A              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 934  835A              ; sia completato, scatena immediatamente il Game Over.
 935  835A              ; -------------------------------------------------------------------
 936  835A              Time_UpdateClock:
 937  835A                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 938  835A 2A 1A 8E         ld   hl, (counter)
 939  835D ED 5B 09 92      ld   de, (time_last_counter)
 940  8361 B7               or   a
 941  8362 ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 942  8364
 943  8364                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 944  8364 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 945  8367 B7               or   a
 946  8368 ED 52            sbc  hl, de
 947  836A D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 948  836B
 949  836B                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 950  836B 2A 09 92         ld   hl, (time_last_counter)
 951  836E 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 952  8371 19               add  hl, de
 953  8372 22 09 92         ld   (time_last_counter), hl
 954  8375
 955  8375                  ; Incrementa di 1 minuto il tempo di gioco
 956  8375 3A 07 92         ld   a, (time_minutes)
 957  8378 3C               inc  a
 958  8379 FE 3C            cp   60
 959  837B 38 21            jr   c, .minutes_ok
 960  837D
 961  837D                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 962  837D AF               xor  a
 963  837E 32 07 92         ld   (time_minutes), a
 964  8381 3A 06 92         ld   a, (time_hours)
 965  8384 3C               inc  a
 966  8385 FE 0C            cp   12
 967  8387 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 968  8389 FE 0D            cp   13
 969  838B 38 0E            jr   c, .hours_ok
 970  838D 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 971  838F 18 0A            jr   .hours_ok
 972  8391
 973  8391              .toggle_period:
 974  8391 F5               push af                     ; Salva A (valore 12)
 975  8392 3A 08 92         ld   a, (time_period)
 976  8395 EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 977  8397 32 08 92         ld   (time_period), a
 978  839A F1               pop  af                     ; Ripristina A = 12
 979  839B
 980  839B              .hours_ok:
 981  839B 32 06 92         ld   (time_hours), a
 982  839E
 983  839E              .minutes_ok:
 984  839E 32 07 92         ld   (time_minutes), a
 985  83A1
 986  83A1                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
 987  83A1 CD B4 67         call Gfx_UpdateTimeDisplay
 988  83A4
 989  83A4                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
 990  83A4 3A 0B 92         ld   a, (game_objective_completed)
 991  83A7 B7               or   a
 992  83A8 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
 993  83A9
 994  83A9                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
 995  83A9 3A 08 92         ld   a, (time_period)
 996  83AC B7               or   a
 997  83AD C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
 998  83AE
 999  83AE 3A 06 92         ld   a, (time_hours)
1000  83B1 FE 0C            cp   12
1001  83B3 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1002  83B5 C9               ret
1003  83B6
1004  83B6              .time_limit_reached:
1005  83B6                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1006  83B6                  ; Scatena immediatamente il Game Over temporale!
1007  83B6 C3 70 80         jp   TriggerGameOver

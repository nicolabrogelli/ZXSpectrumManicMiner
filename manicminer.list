  83+ E6AC 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  84+ E6AD 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  85+ E6AE
  86+ E6AE              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  87+ E6AE 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  88+ E6B1 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  89+ E6B4 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  90+ E6B5 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  91+ E6B6 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  92+ E6B7 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  93+ E6B8 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  94+ E6B9 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  95+ E6BA
  96+ E6BA 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  97+ E6BB 00           Audio_jump_sound_timer:   db 0
  98+ E6BC                  IF ENABLE_MUSIC != 0
  99+ E6BC ~            Audio_music_note_idx:      db 0
 100+ E6BC ~            Audio_music_frame_counter: db 1
 101+ E6BC                  ENDIF
 102+ E6BC
 103+ E6BC              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 104+ E6BC E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 105+ E6BD 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 106+ E6BE 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 107+ E6BF
 108+ E6BF              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 109+ E6BF 00 00        willy_head_ptr:         dw 0
 110+ E6C1 00 00        willy_body_ptr:         dw 0
 111+ E6C3 00 00        guard_sprite_ptr:       dw 0
 112+ E6C5 00           collision_delta_x:      db 0
 113+ E6C6 00           collision_delta_y:      db 0
 114+ E6C7 00           row_enemy_cur:          db 0
 115+ E6C8 00           row_willy_cur:          db 0
 116+ E6C9 00           overlap_num_lines:      db 0
 117+ E6CA

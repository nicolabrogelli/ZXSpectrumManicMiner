2065+ 7E1C FE 02            cp   2
2066+ 7E1E 20 03            jr   nz, .done_trigger
2067+ 7E20
2068+ 7E20                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
2069+ 7E20 CD 27 7E         call .advance_crumble_cell

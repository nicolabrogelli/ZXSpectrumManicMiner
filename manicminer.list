 535+ 869E                  ; --- ITEM RACCOLTO ---
 536+ 869E                  ; 1. Imposta il flag collected nei dati stanza
 537+ 869E FD 6E 03         ld   l, (iy+3)
 538+ 86A1 FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 539+ 86A4 36 00            ld   (hl), 0                   ; 0 = raccolto
 540+ 86A6
 541+ 86A6                  ; 2. Rimuovi dalla griglia items_grid
 542+ 86A6 FD 4E 00         ld   c, (iy+0)
 543+ 86A9 FD 46 01         ld   b, (iy+1)
 544+ 86AC C5               push bc
 545+ 86AD 26 00            ld   h, 0
 546+ 86AF 68               ld   l, b
 547+ 86B0 29               add  hl, hl
 547+ 86B1 29             add hl, hl
 547+ 86B2 29             add hl, hl
 547+ 86B3 29             add hl, hl
 547+ 86B4 29             add hl, hl
 548+ 86B5 59               ld   e, c
 549+ 86B6 16 00            ld   d, 0
 550+ 86B8 19               add  hl, de
 551+ 86B9 11 47 E8         ld   de, items_grid
 552+ 86BC 19               add  hl, de
 553+ 86BD 36 00            ld   (hl), 0

1827+ 7B8E CB 3F            srl  a
1827+ 7B90 CB 3F          srl  a
1827+ 7B92 CB 3F          srl  a
1828+ 7B94 47               ld   b, a                  ; B = Row
1829+ 7B95
1830+ 7B95 79               ld   a, c
1831+ 7B96 C6 07            add  a, 7
1832+ 7B98 CB 3F            srl  a
1832+ 7B9A CB 3F          srl  a
1832+ 7B9C CB 3F          srl  a   ; A = Col2 (0..31)
1833+ 7B9E 4F               ld   c, a                  ; C = Col2
1834+ 7B9F
1835+ 7B9F                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1836+ 7B9F 3A 8A E1         ld   a, (PlayerPos)        ; A = PlayerX
1837+ 7BA2 CB 3F            srl  a
1837+ 7BA4 CB 3F          srl  a
1837+ 7BA6 CB 3F          srl  a   ; A = Col1
1838+ 7BA8 B9               cp   c
1839+ 7BA9 28 0B            jr   z, .done_trigger
1840+ 7BAB
1841+ 7BAB 78               ld   a, b
1842+ 7BAC CD 91 78         call GetCellFromUnpacked
1843+ 7BAF FE 02            cp   2
1844+ 7BB1 20 03            jr   nz, .done_trigger
1845+ 7BB3
1846+ 7BB3                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1847+ 7BB3 CD BA 7B         call .advance_crumble_cell
1848+ 7BB6
1849+ 7BB6              .done_trigger:
1850+ 7BB6 E1               pop  hl
1851+ 7BB7 D1               pop  de
1852+ 7BB8 C1               pop  bc
1853+ 7BB9 C9               ret
1854+ 7BBA
1855+ 7BBA              .advance_crumble_cell:
1856+ 7BBA                  ; Input: B = Row, C = Col
1857+ 7BBA C5               push bc
1858+ 7BBB D5               push de
1859+ 7BBC E5               push hl
1860+ 7BBD
1861+ 7BBD                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1862+ 7BBD 68               ld   l, b
1863+ 7BBE 26 00            ld   h, 0
1864+ 7BC0 29               add  hl, hl
1864+ 7BC1 29             add hl, hl
1864+ 7BC2 29             add hl, hl
1864+ 7BC3 29             add hl, hl
1864+ 7BC4 29             add hl, hl
1865+ 7BC5 59               ld   e, c
1866+ 7BC6 16 00            ld   d, 0
1867+ 7BC8 19               add  hl, de
1868+ 7BC9 11 9B E5         ld   de, crumbling_grid
1869+ 7BCC 19               add  hl, de
1870+ 7BCD
1871+ 7BCD                  ; 2. Avanza di 1 stadio
1872+ 7BCD 7E               ld   a, (hl)               ; A = Stage (0..8)
1873+ 7BCE FE 08            cp   8
1874+ 7BD0 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
1875+ 7BD2
1876+ 7BD2 3C               inc  a                     ; Avanza di 1 scanline (1..8)
1877+ 7BD3 77               ld   (hl), a
1878+ 7BD4 5F               ld   e, a                  ; E = nuovo Stage (1..8)
1879+ 7BD5
1880+ 7BD5                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
1881+ 7BD5 E5               push hl
1882+ 7BD6 CD 24 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
1883+ 7BD9 E1               pop  hl
1884+ 7BDA

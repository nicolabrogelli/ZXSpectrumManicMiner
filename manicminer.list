 901  8844              ; -------------------------------------------------------------------
 902  8844              ; ResetFullGameState
 903  8844              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 904  8844              ; per l'avvio di una nuova partita dopo il Game Over.
 905  8844              ; -------------------------------------------------------------------
 906  8844              ResetFullGameState:
 907  8844                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 908  8844 AF               xor  a
 909  8845 D3 FE            out  ($fe), a              ; Bordo a nero
 910  8847 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 911  884A
 912  884A                  ; Ripristina il numero di vite iniziali
 913  884A 3E 07            ld   a, INITIAL_LIVES
 914  884C 32 EB C6         ld   (willy_lives), a
 915  884F
 916  884F                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 917  884F AF               xor  a
 918  8850 32 E8 C6         ld   (items_collected), a
 919  8853 32 E4 C6         ld   (body_state), a
 920  8856 32 F7 C6         ld   (w_warp_state), a
 921  8859 32 FA C6         ld   (w_key_prev), a
 922  885C 32 FB C6         ld   (enter_key_prev), a
 923  885F 32 EC C6         ld   (velocity_y), a
 924  8862 32 EE C6         ld   (jump_pressed), a
 925  8865 32 F0 C6         ld   (coyote_timer), a
 926  8868 32 F3 C6         ld   (jump_frame), a
 927  886B 32 F2 C6         ld   (jump_dir), a
 928  886E 32 65 CA         ld   (transition_active), a
 929  8871 32 E9 CA         ld   (willy_safety_timer), a
 930  8874 3E FF            ld   a, $ff
 931  8876 32 FC C6         ld   (digit_key_prev), a
 932  8879 3E 01            ld   a, 1
 933  887B 32 F5 C6         ld   (q_prev), a
 934  887E 32 F6 C6         ld   (a_prev), a
 935  8881 32 ED C6         ld   (on_ground), a
 936  8884
 937  8884                  ; Azzeramento punteggio partita corrente (Score = 000000)
 938  8884                  ; Nota: High score viene mantenuto intatto tra le partite
 939  8884 AF               xor  a
 940  8885 32 EE CC         ld   (player_score + 0), a
 941  8888 32 EF CC         ld   (player_score + 1), a
 942  888B 32 F0 CC         ld   (player_score + 2), a
 943  888E
 944  888E                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 945  888E CD 33 81         call ResetItemsTable
 946  8891
 947  8891                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 948  8891 CD 05 70         call InitRoomEntryPositions
 949  8894
 950  8894                  ; Aggiorna la riga di stato con High score e Score azzerato
 951  8894 CD AE 68         call Gfx_UpdateScoreDisplay
 952  8897
 953  8897                  ; Ripristina la stanza iniziale (Central Cavern)
 954  8897 21 9E 88         ld   hl, CentralCavernLayout
 955  889A 22 5F CA         ld   (room_ptr), hl
 956  889D
 957  889D C9               ret

 576+ 7FB5              ; -------------------------------------------------------------------
 577+ 7FB5              ; CheckCollision
 578+ 7FB5              ;
 579+ 7FB5              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 580+ 7FB5              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 581+ 7FB5              ; Output:
 582+ 7FB5              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 583+ 7FB5              ;   Carry Clear = Nessuna collisione
 584+ 7FB5              ; -------------------------------------------------------------------
 585+ 7FB5              CheckCollision:
 586+ 7FB5 DD E5            push ix
 587+ 7FB7 C5               push bc
 588+ 7FB8 D5               push de
 589+ 7FB9 E5               push hl
 590+ 7FBA
 591+ 7FBA                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 592+ 7FBA 3A F5 E2         ld   a, (willy_safety_timer)
 593+ 7FBD B7               or   a
 594+ 7FBE C2 08 81         jp   nz, .no_collision_found
 595+ 7FC1
 596+ 7FC1                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 597+ 7FC1 3A F1 DE         ld   a, (direction)
 598+ 7FC4 FE 01            cp   1                         ; Sinistra?
 599+ 7FC6 20 1A            jr   nz, .willy_right
 600+ 7FC8
 601+ 7FC8                  ; Willy a Sinistra:
 602+ 7FC8 21 CA D8         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 603+ 7FCB 22 0B E5         ld   (willy_head_ptr), hl
 604+ 7FCE 3A F0 DE         ld   a, (body_state)           ; 0, 1, 2
 605+ 7FD1 C6 05            add  a, 5                      ; tile 5, 6, 7
 606+ 7FD3 87               add  a, a
 606+ 7FD4 87             add a, a
 606+ 7FD5 87             add a, a ; * 8
 607+ 7FD6 5F               ld   e, a
 608+ 7FD7 16 00            ld   d, 0
 609+ 7FD9 21 AA D8         ld   hl, Willy
 610+ 7FDC 19               add  hl, de
 611+ 7FDD 22 0D E5         ld   (willy_body_ptr), hl      ; Corpo sinistro
 612+ 7FE0 18 18            jr   .willy_ptrs_ready
 613+ 7FE2
 614+ 7FE2              .willy_right:
 615+ 7FE2                  ; Willy a Destra:
 616+ 7FE2 21 AA D8         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 617+ 7FE5 22 0B E5         ld   (willy_head_ptr), hl
 618+ 7FE8 3A F0 DE         ld   a, (body_state)           ; 0, 1, 2
 619+ 7FEB C6 01            add  a, 1                      ; tile 1, 2, 3
 620+ 7FED 87               add  a, a
 620+ 7FEE 87             add a, a
 620+ 7FEF 87             add a, a ; * 8
 621+ 7FF0 5F               ld   e, a
 622+ 7FF1 16 00            ld   d, 0
 623+ 7FF3 21 AA D8         ld   hl, Willy
 624+ 7FF6 19               add  hl, de
 625+ 7FF7 22 0D E5         ld   (willy_body_ptr), hl      ; Corpo destro
 626+ 7FFA
 627+ 7FFA              .willy_ptrs_ready:
 628+ 7FFA DD 21 5D 7C      ld   ix, ActiveEnemies
 629+ 7FFE 06 08            ld   b, 8                      ; 8 slot
 630+ 8000
 631+ 8000              .enemy_loop:
 632+ 8000 DD 7E 00         ld   a, (ix+0)
 633+ 8003 E6 80            and  $80                       ; Active?
 634+ 8005 CA FF 80         jp   z, .next_enemy
 635+ 8008
 636+ 8008                  ; ---------------------------------------------------------------
 637+ 8008                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 638+ 8008                  ; ---------------------------------------------------------------
 639+ 8008                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 640+ 8008 3A EA DE         ld   a, (PlayerPos)            ; WillyX
 641+ 800B DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 642+ 800E FE 10            cp   16
 643+ 8010 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 644+ 8012 FE F9            cp   249                       ; 249..255 = -7..-1
 645+ 8014 DA FF 80         jp   c, .next_enemy            ; 16..248 -> fuori range
 646+ 8017              .x_in_range:
 647+ 8017 32 11 E5         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 648+ 801A
 649+ 801A                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 650+ 801A 3A EB DE         ld   a, (PlayerPos+1)          ; WillyY
 651+ 801D DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 652+ 8020 FE 10            cp   16
 653+ 8022 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 654+ 8024 FE F1            cp   241                       ; 241..255 = -15..-1
 655+ 8026 DA FF 80         jp   c, .next_enemy            ; 16..240 -> fuori range
 656+ 8029              .y_in_range:
 657+ 8029 32 12 E5         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 658+ 802C
 659+ 802C                  ; ---------------------------------------------------------------
 660+ 802C                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 661+ 802C                  ; ---------------------------------------------------------------
 662+ 802C C5               push bc                        ; Salva contatore nemici (B)
 663+ 802D
 664+ 802D                  ; Controlla se è guardiano verticale
 665+ 802D DD 7E 00         ld   a, (ix+0)
 666+ 8030 E6 40            and  $40                       ; Vertical?
 667+ 8032 20 15            jr   nz, .col_guard_vert
 668+ 8034
 669+ 8034 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 670+ 8037 E6 03            and  3
 671+ 8039 4F               ld   c, a
 672+ 803A
 673+ 803A DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 674+ 803D FE 01            cp   1
 675+ 803F 28 03            jr   z, .guard_left_frame
 676+ 8041                  ; Frame Destra: Frame = Subframe (0..3)
 677+ 8041 79               ld   a, c
 678+ 8042 18 0A            jr   .calc_guard_ptr
 679+ 8044              .guard_left_frame:
 680+ 8044                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 681+ 8044 3E 04            ld   a, 4
 682+ 8046 81               add  a, c
 683+ 8047 18 05            jr   .calc_guard_ptr
 684+ 8049
 685+ 8049              .col_guard_vert:
 686+ 8049                  ; Guardiano verticale: usa il frame salvato in (ix+1) (4..7)
 687+ 8049 DD 7E 01         ld   a, (ix+1)
 688+ 804C E6 07            and  7
 689+ 804E
 690+ 804E              .calc_guard_ptr:
 691+ 804E                  ; Offset = Frame * 32
 692+ 804E 6F               ld   l, a
 693+ 804F 26 00            ld   h, 0
 694+ 8051 29               add  hl, hl                    ; *2
 695+ 8052 29               add  hl, hl                    ; *4
 696+ 8053 29               add  hl, hl                    ; *8
 697+ 8054 29               add  hl, hl                    ; *16
 698+ 8055 29               add  hl, hl                    ; *32
 699+ 8056 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 700+ 8059 19               add  hl, de
 701+ 805A ED 5B 6B E2      ld   de, (room_ptr)
 702+ 805E 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 703+ 805F 22 0F E5         ld   (guard_sprite_ptr), hl
 704+ 8062
 705+ 8062                  ; ---------------------------------------------------------------
 706+ 8062                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 707+ 8062                  ; ---------------------------------------------------------------
 708+ 8062 3A 12 E5         ld   a, (collision_delta_y)
 709+ 8065 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 710+ 8067 20 12            jr   nz, .willy_higher
 711+ 8069
 712+ 8069                  ; Willy lower or equal (DeltaY >= 0):
 713+ 8069                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 714+ 8069 32 13 E5         ld   (row_enemy_cur), a
 715+ 806C AF               xor  a
 716+ 806D 32 14 E5         ld   (row_willy_cur), a
 717+ 8070 3E 10            ld   a, 16
 718+ 8072 21 12 E5         ld   hl, collision_delta_y
 719+ 8075 96               sub  (hl)
 720+ 8076 32 15 E5         ld   (overlap_num_lines), a
 721+ 8079 18 12            jr   .check_lines_loop
 722+ 807B
 723+ 807B              .willy_higher:
 724+ 807B                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 725+ 807B ED 44            neg                            ; A = -DeltaY (1..15)
 726+ 807D 32 14 E5         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 727+ 8080 AF               xor  a
 728+ 8081 32 13 E5         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 729+ 8084 3E 10            ld   a, 16
 730+ 8086 21 14 E5         ld   hl, row_willy_cur
 731+ 8089 96               sub  (hl)
 732+ 808A 32 15 E5         ld   (overlap_num_lines), a
 733+ 808D
 734+ 808D              .check_lines_loop:
 735+ 808D                  ; ---------------------------------------------------------------
 736+ 808D                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 737+ 808D                  ; ---------------------------------------------------------------
 738+ 808D 3A 15 E5         ld   a, (overlap_num_lines)
 739+ 8090 47               ld   b, a                      ; B = numero di scanlines da controllare
 740+ 8091
 741+ 8091              .scanline_loop:
 742+ 8091 C5               push bc                        ; Salva contatore scanlines
 743+ 8092
 744+ 8092                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 745+ 8092 3A 13 E5         ld   a, (row_enemy_cur)
 746+ 8095 87               add  a, a                      ; row * 2
 747+ 8096 5F               ld   e, a
 748+ 8097 16 00            ld   d, 0
 749+ 8099 2A 0F E5         ld   hl, (guard_sprite_ptr)
 750+ 809C 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 751+ 809D 56               ld   d, (hl)                   ; D = Enemy Byte 0
 752+ 809E 23               inc  hl
 753+ 809F 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 754+ 80A0
 755+ 80A0                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 756+ 80A0 3A 11 E5         ld   a, (collision_delta_x)
 757+ 80A3 CB 7F            bit  7, a
 758+ 80A5 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 759+ 80A7
 760+ 80A7                  ; DeltaX >= 0:
 761+ 80A7 FE 09            cp   9
 762+ 80A9 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 763+ 80AB
 764+ 80AB                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 765+ 80AB B7               or   a
 766+ 80AC 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 767+ 80AE 4F               ld   c, a                      ; C = DeltaX (1..8)
 768+ 80AF              .shift_left_16bit:
 769+ 80AF CB 23            sla  e
 770+ 80B1 CB 12            rl   d
 771+ 80B3 0D               dec  c
 772+ 80B4 20 F9            jr   nz, .shift_left_16bit
 773+ 80B6              .slice_ready_in_d:
 774+ 80B6 7A               ld   a, d                      ; A = fetta guardiano allineata
 775+ 80B7 18 14            jr   .test_willy_line
 776+ 80B9
 777+ 80B9              .shift_dx_gt_8:
 778+ 80B9                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 779+ 80B9 D6 08            sub  8
 780+ 80BB 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 781+ 80BC              .shift_left_e_only:
 782+ 80BC CB 23            sla  e
 783+ 80BE 0D               dec  c
 784+ 80BF 20 FB            jr   nz, .shift_left_e_only
 785+ 80C1 7B               ld   a, e                      ; A = fetta guardiano allineata
 786+ 80C2 18 09            jr   .test_willy_line
 787+ 80C4
 788+ 80C4              .shift_neg_dx:
 789+ 80C4                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 790+ 80C4 ED 44            neg
 791+ 80C6 4F               ld   c, a                      ; C = -DeltaX (1..7)
 792+ 80C7              .shift_right_d_only:
 793+ 80C7 CB 3A            srl  d
 794+ 80C9 0D               dec  c
 795+ 80CA 20 FB            jr   nz, .shift_right_d_only
 796+ 80CC 7A               ld   a, d                      ; A = fetta guardiano allineata
 797+ 80CD
 798+ 80CD              .test_willy_line:
 799+ 80CD                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 800+ 80CD B7               or   a
 801+ 80CE 28 21            jr   z, .next_scanline
 802+ 80D0
 803+ 80D0                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 804+ 80D0 4F               ld   c, a                      ; C = fetta guardiano
 805+ 80D1 3A 14 E5         ld   a, (row_willy_cur)
 806+ 80D4 FE 08            cp   8
 807+ 80D6 38 0D            jr   c, .read_willy_head
 808+ 80D8
 809+ 80D8                  ; Riga corpo (8..15)
 810+ 80D8 D6 08            sub  8
 811+ 80DA 6F               ld   l, a
 812+ 80DB 26 00            ld   h, 0
 813+ 80DD ED 5B 0D E5      ld   de, (willy_body_ptr)
 814+ 80E1 19               add  hl, de
 815+ 80E2 7E               ld   a, (hl)                   ; A = byte corpo Willy
 816+ 80E3 18 09            jr   .do_pixel_and
 817+ 80E5
 818+ 80E5              .read_willy_head:
 819+ 80E5                  ; Riga testa (0..7)
 820+ 80E5 6F               ld   l, a
 821+ 80E6 26 00            ld   h, 0
 822+ 80E8 ED 5B 0B E5      ld   de, (willy_head_ptr)
 823+ 80EC 19               add  hl, de
 824+ 80ED 7E               ld   a, (hl)                   ; A = byte testa Willy
 825+ 80EE
 826+ 80EE              .do_pixel_and:
 827+ 80EE                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 828+ 80EE A1               and  c
 829+ 80EF 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 830+ 80F1
 831+ 80F1              .next_scanline:
 832+ 80F1                  ; Avanza alla prossima riga
 833+ 80F1 21 13 E5         ld   hl, row_enemy_cur
 834+ 80F4 34               inc  (hl)
 835+ 80F5 21 14 E5         ld   hl, row_willy_cur
 836+ 80F8 34               inc  (hl)
 837+ 80F9
 838+ 80F9 C1               pop  bc                        ; Ripristina B (contatore scanlines)
 839+ 80FA 05               dec  b
 840+ 80FB C2 91 80         jp   nz, .scanline_loop
 841+ 80FE
 842+ 80FE                  ; Nessun pixel sovrapposto per questo guardiano
 843+ 80FE C1               pop  bc                        ; Ripristina B (contatore nemici)
 844+ 80FF

 512+ 7FEC
 513+ 7FEC DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7FEF FE 01            cp   1                         ; Sinistra?
 515+ 7FF1 28 03            jr   z, .left_frames
 516+ 7FF3
 517+ 7FF3                  ; Movimento a Destra: Frame 0..3 (prima metà)

2240+ 6948 E6 0F            and  $0f
2241+ 694A C6 30            add  a, '0'
2242+ 694C 77               ld   (hl), a
2243+ 694D 23               inc  hl
2244+ 694E
2245+ 694E                  ; Cifra 4 (decine)

   8+ 806D              ; Audio_UpdateJumpSound
   9+ 806D              ;
  10+ 806D              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 806D              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 806D              ; -------------------------------------------------------------------
  13+ 806D              Audio_UpdateJumpSound:
  14+ 806D F5               push af
  15+ 806E C5               push bc
  16+ 806F D5               push de
  17+ 8070 E5               push hl
  18+ 8071
  19+ 8071                  ; Controlla se il suono è attivo (note < 18)
  20+ 8071 3A A2 99         ld   a, (Audio_jump_sound_note)
  21+ 8074 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8076 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8078
  24+ 8078                  ; Carica la nota corrente da suonare
  25+ 8078 5F               ld   e, a
  26+ 8079 16 00            ld   d, 0
  27+ 807B 21 A7 80         ld   hl, Audio_JumpSoundDelays
  28+ 807E 19               add  hl, de
  29+ 807F 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8080 57               ld   d, a                      ; D = delay della nota
  31+ 8081
  32+ 8081                  ; Suona la nota: 15 cicli
  33+ 8081 06 0F            ld   b, 15
  34+ 8083              .note_loop:
  35+ 8083                  ; Speaker ON
  36+ 8083 3A 95 93         ld   a, (room_border_color)
  37+ 8086 F6 10            or   $10
  38+ 8088 D3 FE            out  ($fe), a
  39+ 808A 4A               ld   c, d
  40+ 808B              .d1:
  41+ 808B 0D               dec  c
  42+ 808C 20 FD            jr   nz, .d1
  43+ 808E
  44+ 808E                  ; Speaker OFF
  45+ 808E 3A 95 93         ld   a, (room_border_color)
  46+ 8091 E6 EF            and  $ef
  47+ 8093 D3 FE            out  ($fe), a
  48+ 8095 4A               ld   c, d
  49+ 8096              .d2:
  50+ 8096 0D               dec  c
  51+ 8097 20 FD            jr   nz, .d2
  52+ 8099
  53+ 8099 10 E8            djnz .note_loop
  54+ 809B
  55+ 809B                  ; Passa alla nota successiva
  56+ 809B 3A A2 99         ld   a, (Audio_jump_sound_note)
  57+ 809E 3C               inc  a
  58+ 809F 32 A2 99         ld   (Audio_jump_sound_note), a
  59+ 80A2
  60+ 80A2              .done:
  61+ 80A2 E1               pop  hl
  62+ 80A3 D1               pop  de
  63+ 80A4 C1               pop  bc
  64+ 80A5 F1               pop  af
  65+ 80A6 C9               ret

 722  8794              ; -------------------------------------------------------------------
 723  8794              ; TriggerPortalTransition
 724  8794              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  8794              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  8794              ; - Avanza all'indice della stanza successiva.
 727  8794              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  8794              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  8794              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  8794              ; -------------------------------------------------------------------
 731  8794              TriggerPortalTransition:
 732  8794                  ; 1. Determina l'ID della stanza corrente
 733  8794 CD 06 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  8797
 735  8797                  ; 2. Calcola l'indice della stanza successiva
 736  8797 3A F5 BD         ld   a, (current_room)
 737  879A 3C               inc  a
 738  879B FE 0B            cp   NUM_ROOMS
 739  879D 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  879F
 741  879F                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  879F 21 0A 73         ld   hl, RoomsListTable
 743  87A2 5F               ld   e, a
 744  87A3 16 00            ld   d, 0
 745  87A5 19               add  hl, de
 746  87A6 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87A7 5E               ld   e, (hl)
 748  87A8 23               inc  hl
 749  87A9 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87AA ED 53 50 BE      ld   (room_ptr), de
 751  87AE
 752  87AE                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87AE AF               xor  a
 754  87AF 32 56 BE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87B2 32 DD BA         ld   (velocity_y), a
 756  87B5 32 E5 C0         ld   (game_objective_completed), a
 757  87B8 3E 01            ld   a, 1
 758  87BA 32 DE BA         ld   (on_ground), a
 759  87BD
 760  87BD                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  87BD 3E 07            ld   a, $07
 762  87BF CD 99 62         call Gfx_ClearScreenDirect
 763  87C2
 764  87C2 C3 57 84         jp   LoadRoomAndRestart
 765  87C5
 766  87C5              .all_rooms_completed:
 767  87C5                  ; Tutte le stanze sono state completate con successo!
 768  87C5                  IF ENABLE_VICTORY_SCREEN != 0
 769  87C5 C3 BC 86         jp   TriggerVictory
 770  87C8                  ELSE
 771  87C8 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  87C8 ~                ld   de, (RoomsListTable)
 773  87C8 ~                ld   (room_ptr), de
 774  87C8 ~                xor  a
 775  87C8 ~                ld   (transition_active), a
 776  87C8 ~                ld   (velocity_y), a
 777  87C8 ~                ld   (game_objective_completed), a
 778  87C8 ~                ld   a, 1
 779  87C8 ~                ld   (on_ground), a
 780  87C8 ~                ld   a, $07
 781  87C8 ~                call Gfx_ClearScreenDirect
 782  87C8 ~                jp   LoadRoomAndRestart
 783  87C8                  ENDIF

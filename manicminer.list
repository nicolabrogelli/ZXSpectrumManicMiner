 624+ 8165              ; -------------------------------------------------------------------
 625+ 8165              ; Score_AddItemPoints
 626+ 8165              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 8165              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 8165              ; -------------------------------------------------------------------
 629+ 8165              Score_AddItemPoints:
 630+ 8165 F5               push af
 631+ 8166 C5               push bc
 632+ 8167 D5               push de
 633+ 8168 E5               push hl
 634+ 8169
 635+ 8169                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8169 3A E7 9A         ld   a, (player_score + 1)
 637+ 816C C6 01            add  a, $01
 638+ 816E 27               daa
 639+ 816F 32 E7 9A         ld   (player_score + 1), a
 640+ 8172
 641+ 8172                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8172 3A E8 9A         ld   a, (player_score + 2)
 643+ 8175 CE 00            adc  a, 0
 644+ 8177 27               daa
 645+ 8178 32 E8 9A         ld   (player_score + 2), a
 646+ 817B
 647+ 817B                  ; Controlla se player_score ha superato high_score
 648+ 817B CD 86 81         call Score_CheckAndUpdateHighScore
 649+ 817E
 650+ 817E                  ; Aggiorna visualizzazione a schermo
 651+ 817E CD DC 68         call Gfx_UpdateScoreDisplay
 652+ 8181
 653+ 8181 E1               pop  hl
 654+ 8182 D1               pop  de
 655+ 8183 C1               pop  bc
 656+ 8184 F1               pop  af
 657+ 8185 C9               ret
 658+ 8186
 659+ 8186              ; -------------------------------------------------------------------
 660+ 8186              ; Score_CheckAndUpdateHighScore
 661+ 8186              ; Se player_score > high_score, copia player_score in high_score.
 662+ 8186              ; -------------------------------------------------------------------
 663+ 8186              Score_CheckAndUpdateHighScore:
 664+ 8186                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 8186                  ; Byte 2:
 666+ 8186 3A E8 9A         ld   a, (player_score + 2)
 667+ 8189 47               ld   b, a
 668+ 818A 3A EB 9A         ld   a, (high_score + 2)
 669+ 818D B8               cp   b
 670+ 818E 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 8190 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 8192
 673+ 8192                  ; Byte 1:
 674+ 8192 3A E7 9A         ld   a, (player_score + 1)
 675+ 8195 47               ld   b, a
 676+ 8196 3A EA 9A         ld   a, (high_score + 1)
 677+ 8199 B8               cp   b
 678+ 819A 38 0C            jr   c, .new_high_score
 679+ 819C 20 1C            jr   nz, .done_check
 680+ 819E
 681+ 819E                  ; Byte 0:
 682+ 819E 3A E6 9A         ld   a, (player_score + 0)
 683+ 81A1 47               ld   b, a
 684+ 81A2 3A E9 9A         ld   a, (high_score + 0)
 685+ 81A5 B8               cp   b
 686+ 81A6 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 81A8
 688+ 81A8              .new_high_score:
 689+ 81A8 3A E6 9A         ld   a, (player_score + 0)
 690+ 81AB 32 E9 9A         ld   (high_score + 0), a
 691+ 81AE 3A E7 9A         ld   a, (player_score + 1)
 692+ 81B1 32 EA 9A         ld   (high_score + 1), a
 693+ 81B4 3A E8 9A         ld   a, (player_score + 2)
 694+ 81B7 32 EB 9A         ld   (high_score + 2), a
 695+ 81BA
 696+ 81BA              .done_check:
 697+ 81BA C9               ret

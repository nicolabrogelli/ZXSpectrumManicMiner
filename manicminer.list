1235+ 64C8                  ; 7. Animazione: Discesa fluida di PiedeSprite dall'alto (Y=0) fino a Y=96 (alla parte alta della Botte)
1236+ 64C8 06 00            ld   b, 0                  ; B = Y iniziale (0)
1237+ 64CA              .foot_descent_loop:
1238+ 64CA C5               push bc                    ; Salva B = Y corrente
1239+ 64CB
1240+ 64CB                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1241+ 64CB 78               ld   a, b
1242+ 64CC B7               or   a
1243+ 64CD 28 1F            jr   z, .skip_clear_prev
1244+ 64CF D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1245+ 64D1 47               ld   b, a
1246+ 64D2 0E 78            ld   c, 120                ; X = 120
1247+ 64D4 CD 12 61         call Gfx_Clear16x16_Black
1248+ 64D7
1249+ 64D7                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1250+ 64D7 78               ld   a, b
1251+ 64D8 CB 3F            srl  a
1252+ 64DA CB 3F            srl  a
1253+ 64DC CB 3F            srl  a                     ; A = Row da azzerare
1254+ 64DE 6F               ld   l, a
1255+ 64DF 26 00            ld   h, 0
1256+ 64E1 29               add  hl, hl                ; * 2
1257+ 64E2 29               add  hl, hl                ; * 4
1258+ 64E3 29               add  hl, hl                ; * 8
1259+ 64E4 29               add  hl, hl                ; * 16
1260+ 64E5 29               add  hl, hl                ; * 32
1261+ 64E6 11 0F 58         ld   de, $580f             ; $5800 + 15
1262+ 64E9 19               add  hl, de
1263+ 64EA AF               xor  a
1264+ 64EB 77               ld   (hl), a               ; Col 15 = 0
1265+ 64EC 23               inc  hl
1266+ 64ED 77               ld   (hl), a               ; Col 16 = 0
1267+ 64EE
1268+ 64EE              .skip_clear_prev:
1269+ 64EE C1               pop  bc                    ; Ripristina B = Y corrente
1270+ 64EF C5               push bc
1271+ 64F0
1272+ 64F0                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1273+ 64F0 78               ld   a, b
1274+ 64F1 FE 60            cp   96
1275+ 64F3 20 09            jr   nz, .draw_foot
1276+ 64F5 C5               push bc
1277+ 64F6 0E 78            ld   c, 120
1278+ 64F8 06 60            ld   b, 96
1279+ 64FA CD 12 61         call Gfx_Clear16x16_Black
1280+ 64FD C1               pop  bc
1281+ 64FE
1282+ 64FE              .draw_foot:

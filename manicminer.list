 463+ 7F8F DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7F92 DD 77 02         ld   (ix+2), a
 465+ 7F95 3E 01            ld   a, 1
 466+ 7F97 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7F9A C3 E1 7F         jp   .next

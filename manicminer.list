 271+ 6EAB              ; LoadPositionPlayeinRoom
 272+ 6EAB              ;
 273+ 6EAB              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6EAB              ; in una nuova stanza.
 275+ 6EAB              ;
 276+ 6EAB              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6EAB              ; (layout/metadata) a partire da room_ptr.
 278+ 6EAB              ;
 279+ 6EAB              ; Output:
 280+ 6EAB              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6EAB              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6EAB              ;
 283+ 6EAB              ; Struttura dati stanza:
 284+ 6EAB              ;   OFFSET_POS_WILLY:
 285+ 6EAB              ;       +0 = X
 286+ 6EAB              ;       +1 = Y
 287+ 6EAB              ; -------------------------------------------------------------------
 288+ 6EAB              LoadPositionPlayeinRoom:
 289+ 6EAB                  ; ---------------------------------------------------------------
 290+ 6EAB                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6EAB                  ; ---------------------------------------------------------------
 292+ 6EAB 2A 57 98         ld   hl, (room_ptr)
 293+ 6EAE 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6EB1 19               add  hl, de
 295+ 6EB2
 296+ 6EB2                  ; Byte 0: Y * 2
 297+ 6EB2 7E               ld   a, (hl)
 298+ 6EB3 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6EB5 57               ld   d, a                      ; D = PlayerY
 300+ 6EB6
 301+ 6EB6                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6EB6 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6EB7 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6EB8 7E               ld   a, (hl)
 305+ 6EB9 E6 01            and  1
 306+ 6EBB 28 04            jr   z, .facing_right
 307+ 6EBD 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6EBF 18 02            jr   .set_dir
 309+ 6EC1              .facing_right:
 310+ 6EC1 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6EC3              .set_dir:
 312+ 6EC3 32 DE 94         ld   (direction), a
 313+ 6EC6
 314+ 6EC6                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6EC6 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6EC7 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6EC8 4E               ld   c, (hl)
 318+ 6EC9 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6ECA 7E               ld   a, (hl)
 320+ 6ECB
 321+ 6ECB                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6ECB 67               ld   h, a
 323+ 6ECC 69               ld   l, c
 324+ 6ECD 01 00 A4         ld   bc, -23552
 325+ 6ED0 09               add  hl, bc
 326+ 6ED1
 327+ 6ED1 7D               ld   a, l
 328+ 6ED2 E6 1F            and  31
 329+ 6ED4 87               add  a, a                      ; *2
 330+ 6ED5 87               add  a, a                      ; *4

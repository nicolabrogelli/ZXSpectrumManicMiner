1353+ 7A61                  ; Offsets per RampData: DE + 218
1354+ 7A61 21 DA 00         ld   hl, 218
1355+ 7A64 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1356+ 7A65
1357+ 7A65 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1358+ 7A66 32 58 EE         ld   (ramp_dir), a
1359+ 7A69 23               inc  hl
1360+ 7A6A 5E               ld   e, (hl)
1361+ 7A6B 23               inc  hl

 128  898F                  ; 3. Aggiorna animazione lampeggio del portale (se attivo)
 129  898F CD 01 6C         call Gfx_AnimatePortal
 130  8992
 131  8992                  ; 5b. Aggiorna consumo aria (morte se esaurita)
 132  8992 CD 67 7D         call Phys_UpdateAir
 133  8995 DA CE 89         jp   c, .willy_dies
 134  8998
 135  8998                  ; 6. Aggiornamento audio
 136  8998                  IF ENABLE_EFFECTS != 0
 137  8998 ~                call Audio_UpdateJumpSound    ; Aggiorna l'effetto sonoro del salto
 138  8998                  ENDIF
 139  8998
 140  8998                  IF ENABLE_MUSIC != 0
 141  8998 ~                call Audio_UpdateMusic        ; Aggiorna la musica
 142  8998                  ENDIF
 143  8998
 144  8998                  ; Se l'animazione delle vite è abilitata, aggiorna la visualizzazione delle icone camminanti
 145  8998                  IF ENABLE_ANIMATE_LIVES != 0
 146  8998 ~                call Gfx_PrintWillyLives
 147  8998                  ENDIF
 148  8998
 149  8998
 150  8998                  ; 7. Salva le posizioni correnti del player per il prossimo frame
 151  8998 ED 4B DE EA      ld   bc, (PlayerPos)
 152  899C ED 43 E0 EA      ld   (PlayerPosOld), bc
 153  89A0
 154  89A0                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 155  89A0 CD D6 70         call Input_CheckCtrl
 156  89A3 CD F9 6E         call MovePlayer
 157  89A6 CD 3B 74         call Phys_ApplyGravity
 158  89A9                  IF ENABLE_FALL_DEATH != 0
 159  89A9 DA CE 89         jp   c, .willy_dies
 160  89AC                  ENDIF
 161  89AC CD 05 81         call Enemy_Update
 162  89AF CD 10 87         call Items_CheckCollision
 163  89B2 CD 25 88         call Items_Animate
 164  89B5 CD 4D 84         call Kong_CheckSwitches
 165  89B8
 166  89B8                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 167  89B8 CD 10 8B         call CheckPortalTransition
 168  89BB DA 6A 8B         jp   c, TriggerPortalTransition
 169  89BE
 170  89BE                  ; Controlla collisione con Nasties (morte di Willy)
 171  89BE                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 172  89BE CD 87 7C         call Phys_CheckNastyCollision
 173  89C1 38 0B            jr   c, .willy_dies
 174  89C3                  ENDIF
 175  89C3
 176  89C3                  ; Controlla collisione con guardiani
 177  89C3 CD C9 82         call CheckCollision
 178  89C6 38 03            jr   c, .guardian_collision_found
 179  89C8
 180  89C8                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 181  89C8                  IF ENABLE_RAMP_DEBUG_BARS != 0
 182  89C8 ~                ld   a, (willy_on_ramp)
 183  89C8 ~                or   a
 184  89C8 ~                jp   nz, .draw_raster_bars
 185  89C8                  ENDIF
 186  89C8
 187  89C8 C3 3D 8A         jp   .no_collision
 188  89CB
 189  89CB              .guardian_collision_found:
 190  89CB                  ; C'è collisione con un guardiano!
 191  89CB                  ; Controlla se la morte per collisione con i guardiani è abilitata
 192  89CB                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 193  89CB C3 CE 89         jp   .willy_dies
 194  89CE                  ELSE
 195  89CE ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 196  89CE ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 197  89CE ~                    ELSE
 198  89CE ~                    jp   .no_collision
 199  89CE ~                    ENDIF
 200  89CE                  ENDIF
 201  89CE
 202  89CE              .willy_dies:
 203  89CE                  ; 1. Decrementa le vite
 204  89CE 21 EB EA         ld   hl, willy_lives
 205  89D1 7E               ld   a, (hl)
 206  89D2 B7               or   a
 207  89D3 28 05            jr   z, .check_game_over
 208  89D5 35               dec  (hl)
 209  89D6 28 02            jr   z, .check_game_over
 210  89D8 18 03            jr   .normal_respawn
 211  89DA
 212  89DA              .check_game_over:
 213  89DA                  IF ENABLE_GAME_OVER_RESTART != 0
 214  89DA C3 89 8A         jp   TriggerGameOver
 215  89DD                  ELSE
 216  89DD ~                ld   a, 1
 217  89DD ~                ld   (willy_lives), a
 218  89DD ~                jr   .normal_respawn
 219  89DD                  ENDIF
 220  89DD
 221  89DD              .normal_respawn:
 222  89DD                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 223  89DD CD 83 85         call Items_ResetCurrentRoomItems
 224  89E0
 225  89E0                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)

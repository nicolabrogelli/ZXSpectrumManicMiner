 281  8374              ; -------------------------------------------------------------------
 282  8374              ; ShowTitleScreen
 283  8374              ; Visualizza la schermata iniziale del gioco (Title Screen).
 284  8374              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 285  8374              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 286  8374              ; -------------------------------------------------------------------
 287  8374              ShowTitleScreen:
 288  8374                  ; 1. Disegna la schermata iniziale
 289  8374 CD E2 63         call Gfx_DrawTitleScreen
 290  8377
 291  8377                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 292  8377              .wait_title_enter_release:
 293  8377 76               halt
 294  8378 3E BF            ld   a, $bf
 295  837A DB FE            in   a, ($fe)
 296  837C 1F               rra
 297  837D 30 F8            jr   nc, .wait_title_enter_release
 298  837F
 299  837F                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 300  837F 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 301  8381              .title_loop:
 302  8381 76               halt
 303  8382
 304  8382                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 305  8382 0C               inc  c
 306  8383 79               ld   a, c
 307  8384 CB 3F            srl  a
 308  8386 CB 3F            srl  a
 309  8388 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 310  838A E6 07            and  7
 311  838C 5F               ld   e, a
 312  838D 16 00            ld   d, 0
 313  838F 21 DA 63         ld   hl, title_color_table
 314  8392 19               add  hl, de
 315  8393 7E               ld   a, (hl)               ; A = nuovo colore
 316  8394 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 317  8397 06 20            ld   b, 32
 318  8399              .color_title_loop:
 319  8399 77               ld   (hl), a
 320  839A 23               inc  hl
 321  839B 10 FC            djnz .color_title_loop
 322  839D
 323  839D                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 324  839D 3E BF            ld   a, $bf
 325  839F DB FE            in   a, ($fe)
 326  83A1 1F               rra
 327  83A2 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 328  83A4
 329  83A4                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 330  83A4              .wait_title_enter_release_after:
 331  83A4 76               halt
 332  83A5 3E BF            ld   a, $bf
 333  83A7 DB FE            in   a, ($fe)
 334  83A9 1F               rra
 335  83AA 30 F8            jr   nc, .wait_title_enter_release_after
 336  83AC
 337  83AC                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 338  83AC AF               xor  a
 339  83AD D3 FE            out  ($fe), a              ; Bordo a nero
 340  83AF 21 8D 5C         ld   hl, ATTR_P
 341  83B2 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 342  83B3 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 343  83B6 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 344  83B8 3E 07            ld   a, $07
 345  83BA 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07

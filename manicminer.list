 178+ 7F1D              ; -------------------------------------------------------------------
 179+ 7F1D              ; Audio_PlayCollectSound
 180+ 7F1D              ;
 181+ 7F1D              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7F1D              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7F1D              ; -------------------------------------------------------------------
 184+ 7F1D              Audio_PlayCollectSound:
 185+ 7F1D C5               push bc
 186+ 7F1E D5               push de
 187+ 7F1F
 188+ 7F1F 06 78            ld   b, 120
 189+ 7F21              .sound_loop:
 190+ 7F21 3A B3 8D         ld   a, (room_border_color)
 191+ 7F24 F6 10            or   $10               ; speaker ON
 192+ 7F26 D3 FE            out  ($fe), a
 193+ 7F28
 194+ 7F28 0E 3C            ld   c, 60
 195+ 7F2A              .d1:
 196+ 7F2A 0D               dec  c
 197+ 7F2B 20 FD            jr   nz, .d1

 138+ 7E2A              .done_h_guardians:
 139+ 7E2A                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7E2A 2A E7 99         ld   hl, (room_ptr)
 141+ 7E2D 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7E30 19               add  hl, de
 143+ 7E31 7E               ld   a, (hl)
 144+ 7E32 FE FF            cp   $FF
 145+ 7E34 28 0A            jr   z, .done_v_guardians
 146+ 7E36 B7               or   a
 147+ 7E37 28 07            jr   z, .done_v_guardians
 148+ 7E39
 149+ 7E39                  ; Slot attivo per guardiano verticale
 150+ 7E39 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7E3D DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7E40                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7E40
 154+ 7E40              .done_v_guardians:
 155+ 7E40 DD E1            pop  ix
 156+ 7E42 C1               pop  bc
 157+ 7E43 D1               pop  de
 158+ 7E44 E1               pop  hl
 159+ 7E45 C9               ret

 412  8647 10 FC            djnz .color_cycle_loop
 413  8649
 414  8649                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  8649 01 FE DF         ld   bc, $dffe
 416  864C ED 78            in   a, (c)
 417  864E CB 67            bit  4, a
 418  8650 28 2A            jr   z, .continue_chosen
 419  8652
 420  8652                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  8652 01 FE 7F         ld   bc, $7ffe
 422  8655 ED 78            in   a, (c)
 423  8657 CB 5F            bit  3, a
 424  8659 28 0B            jr   z, .quit_chosen
 425  865B
 426  865B                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  865B 01 FE BF         ld   bc, $bffe
 428  865E ED 78            in   a, (c)
 429  8660 CB 47            bit  0, a
 430  8662 28 02            jr   z, .quit_chosen
 431  8664
 432  8664 18 C9            jr   .wait_choice_loop
 433  8666
 434  8666              .quit_chosen:
 435  8666                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti

 467+ 8694 C6 07            add  a, 7
 468+ 8696 57               ld   d, a                      ; D = ItemBottom
 469+ 8697
 470+ 8697                  ; WillyTop <= ItemBottom
 471+ 8697 78               ld   a, b                      ; A = WillyY
 472+ 8698 BA               cp   d                         ; D = ItemBottom
 473+ 8699 28 04            jr   z, .y_ok
 474+ 869B 38 02            jr   c, .y_ok
 475+ 869D 18 13            jr   .no_collision
 476+ 869F
 477+ 869F              .y_ok:
 478+ 869F                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 869F BB               cp   e                         ; E = ItemTop
 480+ 86A0 28 0B            jr   z, .collision
 481+ 86A2 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 86A4
 483+ 86A4                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 86A4 C6 0F            add  a, 15

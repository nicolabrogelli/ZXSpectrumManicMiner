 679+ 8045                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 680+ 8045                  ; ---------------------------------------------------------------
 681+ 8045 C5               push bc                        ; Salva contatore nemici (B)
 682+ 8046
 683+ 8046                  ; Controlla se è guardiano verticale
 684+ 8046 DD 7E 00         ld   a, (ix+0)
 685+ 8049 E6 40            and  $40                       ; Vertical?
 686+ 804B 20 1B            jr   nz, .col_guard_vert
 687+ 804D
 688+ 804D DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 689+ 8050 E6 03            and  3
 690+ 8052 4F               ld   c, a
 691+ 8053
 692+ 8053 3A 14 E3         ld   a, (room_has_v_guardians)
 693+ 8056 B7               or   a
 694+ 8057 20 0A            jr   nz, .col_h_second_half    ; Se ci sono guardiani verticali, orizzontali usano la seconda metà (frame 4..7)
 695+ 8059
 696+ 8059 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 697+ 805C FE 01            cp   1
 698+ 805E 28 03            jr   z, .guard_left_frame
 699+ 8060                  ; Frame Destra: Frame = Subframe (0..3, prima metà)
 700+ 8060 79               ld   a, c
 701+ 8061 18 0A            jr   .calc_guard_ptr
 702+ 8063              .col_h_second_half:
 703+ 8063              .guard_left_frame:

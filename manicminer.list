 201  855B              .willy_dies:
 202  855B                  ; 1. Decrementa le vite
 203  855B 21 4D AB         ld   hl, willy_lives
 204  855E 7E               ld   a, (hl)
 205  855F B7               or   a
 206  8560 28 05            jr   z, .check_game_over
 207  8562 35               dec  (hl)
 208  8563 28 02            jr   z, .check_game_over
 209  8565 18 03            jr   .normal_respawn
 210  8567
 211  8567              .check_game_over:
 212  8567                  IF ENABLE_GAME_OVER_RESTART != 0
 213  8567 C3 2C 86         jp   TriggerGameOver
 214  856A                  ELSE
 215  856A ~                ld   a, 1
 216  856A ~                ld   (willy_lives), a
 217  856A ~                jr   .normal_respawn
 218  856A                  ENDIF
 219  856A
 220  856A              .normal_respawn:
 221  856A                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 222  856A CD 94 81         call Items_ResetCurrentRoomItems
 223  856D
 224  856D                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 225  856D AF               xor  a
 226  856E D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 227  8570 21 8D 5C         ld   hl, ATTR_P
 228  8573 77               ld   (hl), a               ; Paper = Nero, Ink = Nero ($00)
 229  8574 CD AF 0D         call CLS                   ; Pulisce il display RAM e imposta gli attributi a nero
 230  8577 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 231  8579 3E 07            ld   a, $07
 232  857B 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 233  857E
 234  857E                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 235  857E 06 19            ld   b, 25
 236  8580              .death_pause:
 237  8580 76               halt
 238  8581 10 FD            djnz .death_pause
 239  8583

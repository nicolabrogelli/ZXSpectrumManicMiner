 477+ 7D30 C6 02            add  a, 2
 478+ 7D32 DD BE 05         cp   (ix+5)
 479+ 7D35 28 08            jr   z, .v_rev_up
 480+ 7D37 30 06            jr   nc, .v_rev_up
 481+ 7D39 DD 77 03         ld   (ix+3), a
 482+ 7D3C C3 4A 7D         jp   .next
 483+ 7D3F
 484+ 7D3F              .v_rev_up:
 485+ 7D3F DD 7E 05         ld   a, (ix+5)
 486+ 7D42 DD 77 03         ld   (ix+3), a
 487+ 7D45 3E 01            ld   a, 1
 488+ 7D47 DD 77 06         ld   (ix+6), a
 489+ 7D4A
 490+ 7D4A              .next:
 491+ 7D4A 11 0B 00         ld   de, 11
 492+ 7D4D DD 19            add  ix, de
 493+ 7D4F 05               dec  b
 494+ 7D50 C2 A6 7C         jp   nz, .loop
 495+ 7D53
 496+ 7D53 DD E1            pop  ix
 497+ 7D55 C1               pop  bc
 498+ 7D56 D1               pop  de
 499+ 7D57 E1               pop  hl
 500+ 7D58 C9               ret

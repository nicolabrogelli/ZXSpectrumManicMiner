 541  871F              ; -------------------------------------------------------------------
 542  871F              ; TriggerVictory
 543  871F              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 544  871F              ; - Pulisce gli elementi di gioco della stanza.
 545  871F              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 546  871F              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 547  871F              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 548  871F              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 549  871F              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 550  871F              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 551  871F              ; -------------------------------------------------------------------
 552  871F              TriggerVictory:
 553  871F                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 554  871F CD F7 66         call Gfx_DrawVictoryScreen
 555  8722
 556  8722                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 557  8722              .wait_keys_release:
 558  8722 76               halt
 559  8723                  ; Controlla tasto Y (Porta $DF, bit 4)
 560  8723 01 FE DF         ld   bc, $dffe
 561  8726 ED 78            in   a, (c)
 562  8728 CB 67            bit  4, a
 563  872A 28 F6            jr   z, .wait_keys_release
 564  872C
 565  872C                  ; Controlla tasto N (Porta $7F, bit 3)
 566  872C 01 FE 7F         ld   bc, $7ffe
 567  872F ED 78            in   a, (c)
 568  8731 CB 5F            bit  3, a
 569  8733 28 ED            jr   z, .wait_keys_release
 570  8735
 571  8735                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 572  8735 01 FE BF         ld   bc, $bffe
 573  8738 ED 78            in   a, (c)
 574  873A CB 47            bit  0, a
 575  873C 28 E4            jr   z, .wait_keys_release
 576  873E
 577  873E                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 578  873E 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 579  8740              .wait_choice_loop:
 580  8740 76               halt
 581  8741
 582  8741                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 583  8741 0C               inc  c
 584  8742 79               ld   a, c
 585  8743 CB 3F            srl  a
 586  8745 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 587  8747 E6 07            and  7
 588  8749 5F               ld   e, a
 589  874A 16 00            ld   d, 0
 590  874C 21 D6 65         ld   hl, victory_color_table
 591  874F 19               add  hl, de
 592  8750 7E               ld   a, (hl)               ; A = nuovo colore attributo
 593  8751 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 594  8754 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 595  8756              .color_cycle_loop:
 596  8756 77               ld   (hl), a
 597  8757 23               inc  hl
 598  8758 10 FC            djnz .color_cycle_loop
 599  875A
 600  875A                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 601  875A 01 FE DF         ld   bc, $dffe
 602  875D ED 78            in   a, (c)
 603  875F CB 67            bit  4, a
 604  8761 28 2A            jr   z, .play_again_chosen
 605  8763
 606  8763                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 607  8763 01 FE 7F         ld   bc, $7ffe
 608  8766 ED 78            in   a, (c)
 609  8768 CB 5F            bit  3, a
 610  876A 28 0B            jr   z, .quit_chosen
 611  876C
 612  876C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 613  876C 01 FE BF         ld   bc, $bffe
 614  876F ED 78            in   a, (c)
 615  8771 CB 47            bit  0, a
 616  8773 28 02            jr   z, .quit_chosen
 617  8775
 618  8775 18 C9            jr   .wait_choice_loop
 619  8777
 620  8777              .quit_chosen:
 621  8777                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 622  8777              .wait_quit_release:
 623  8777 76               halt
 624  8778 01 FE 7F         ld   bc, $7ffe
 625  877B ED 78            in   a, (c)
 626  877D CB 5F            bit  3, a
 627  877F 28 F6            jr   z, .wait_quit_release
 628  8781 01 FE BF         ld   bc, $bffe
 629  8784 ED 78            in   a, (c)
 630  8786 CB 47            bit  0, a
 631  8788 28 ED            jr   z, .wait_quit_release
 632  878A
 633  878A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 634  878A C3 DD 85         jp   ShowTitleScreen
 635  878D
 636  878D              .play_again_chosen:
 637  878D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 638  878D              .wait_play_again_release:
 639  878D 76               halt
 640  878E 01 FE DF         ld   bc, $dffe
 641  8791 ED 78            in   a, (c)
 642  8793 CB 67            bit  4, a
 643  8795 28 F6            jr   z, .wait_play_again_release
 644  8797
 645  8797                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 646  8797 CD 9B 88         call ResetFullGameState
 647  879A C3 99 84         jp   LoadRoomAndRestart
 648  879D
 649  879D              ; -------------------------------------------------------------------
 650  879D              ; CheckPortalTransition
 651  879D              ; Verifica le condizioni per accedere alla stanza successiva:
 652  879D              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 653  879D              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 654  879D              ;
 655  879D              ; Output:
 656  879D              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 657  879D              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 658  879D              ; -------------------------------------------------------------------
 659  879D              CheckPortalTransition:
 660  879D C5               push bc
 661  879E D5               push de
 662  879F E5               push hl
 663  87A0
 664  87A0                  ; 1. Tutti gli item della stanza sono stati raccolti?
 665  87A0 CD 2E 88         call CheckAllItemsCollected
 666  87A3 30 4D            jr   nc, .no_transition
 667  87A5
 668  87A5                  ; 2. Willy collide con il portale (16x16 pixel)?
 669  87A5                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 670  87A5                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 671  87A5 2A C1 AE         ld   hl, (room_ptr)
 672  87A8 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 673  87AB 19               add  hl, de
 674  87AC 4E               ld   c, (hl)
 675  87AD 23               inc  hl
 676  87AE 46               ld   b, (hl)                   ; BC = AttrAddr
 677  87AF
 678  87AF                  ; Offset = BC - 23552
 679  87AF 60               ld   h, b
 680  87B0 69               ld   l, c
 681  87B1 01 00 A4         ld   bc, -23552
 682  87B4 09               add  hl, bc
 683  87B5
 684  87B5                  ; PortalX = (Offset & 31) * 8
 685  87B5 7D               ld   a, l
 686  87B6 E6 1F            and  31
 687  87B8 87               add  a, a
 687  87B9 87             add a, a
 687  87BA 87             add a, a
 688  87BB 5F               ld   e, a                      ; E = PortalX (0..248)
 689  87BC
 690  87BC                  ; PortalY = (Offset / 32) * 8
 691  87BC CB 3C            srl  h
 691  87BE CB 1D          rr l
 692  87C0 CB 3C            srl  h
 692  87C2 CB 1D          rr l
 693  87C4 CB 3C            srl  h
 693  87C6 CB 1D          rr l
 694  87C8 CB 3C            srl  h
 694  87CA CB 1D          rr l
 695  87CC CB 3C            srl  h
 695  87CE CB 1D          rr l
 696  87D0 7D               ld   a, l
 697  87D1 87               add  a, a
 697  87D2 87             add a, a
 697  87D3 87             add a, a
 698  87D4 57               ld   d, a                      ; D = PortalY (0..120)
 699  87D5
 700  87D5                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 701  87D5 ED 4B 40 AB      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 702  87D9
 703  87D9                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 704  87D9 7B               ld   a, e
 705  87DA 91               sub  c
 706  87DB 30 02            jr   nc, .x_diff_pos
 707  87DD ED 44            neg
 708  87DF              .x_diff_pos:
 709  87DF FE 0C            cp   12
 710  87E1 30 0F            jr   nc, .no_transition
 711  87E3
 712  87E3                  ; Controllo verticale: |WillyY - PortalY| < 14
 713  87E3 7A               ld   a, d
 714  87E4 90               sub  b
 715  87E5 30 02            jr   nc, .y_diff_pos
 716  87E7 ED 44            neg
 717  87E9              .y_diff_pos:
 718  87E9 FE 0E            cp   14
 719  87EB 30 05            jr   nc, .no_transition
 720  87ED
 721  87ED                  ; Transizione al portale attiva!
 722  87ED E1               pop  hl
 723  87EE D1               pop  de
 724  87EF C1               pop  bc
 725  87F0 37               scf
 726  87F1 C9               ret
 727  87F2
 728  87F2              .no_transition:
 729  87F2 E1               pop  hl
 730  87F3 D1               pop  de
 731  87F4 C1               pop  bc
 732  87F5 B7               or   a
 733  87F6 C9               ret
 734  87F7
 735  87F7              ; Alias per retrocompatibilità
 736  87F7              CheckVictoryCondition: EQU CheckPortalTransition
 737  87F7
 738  87F7              ; -------------------------------------------------------------------
 739  87F7              ; TriggerPortalTransition
 740  87F7              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 741  87F7              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 742  87F7              ; - Avanza all'indice della stanza successiva.
 743  87F7              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 744  87F7              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 745  87F7              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 746  87F7              ; -------------------------------------------------------------------
 747  87F7              TriggerPortalTransition:
 748  87F7                  ; 1. Determina l'ID della stanza corrente
 749  87F7 CD 45 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 750  87FA
 751  87FA                  ; 2. Calcola l'indice della stanza successiva
 752  87FA 3A 66 AE         ld   a, (current_room)
 753  87FD 3C               inc  a
 754  87FE FE 07            cp   NUM_ROOMS
 755  8800 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 756  8802
 757  8802                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 758  8802 21 7C 73         ld   hl, RoomsListTable
 759  8805 5F               ld   e, a
 760  8806 16 00            ld   d, 0
 761  8808 19               add  hl, de
 762  8809 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 763  880A 5E               ld   e, (hl)
 764  880B 23               inc  hl
 765  880C 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 766  880D ED 53 C1 AE      ld   (room_ptr), de
 767  8811
 768  8811                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 769  8811 AF               xor  a
 770  8812 32 C7 AE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 771  8815 32 4E AB         ld   (velocity_y), a
 772  8818 32 56 B1         ld   (game_objective_completed), a
 773  881B 3E 01            ld   a, 1
 774  881D 32 4F AB         ld   (on_ground), a
 775  8820
 776  8820                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 777  8820 21 8D 5C         ld   hl, ATTR_P
 778  8823 36 07            ld   (hl), $07
 779  8825 CD AF 0D         call CLS
 780  8828
 781  8828 C3 99 84         jp   LoadRoomAndRestart
 782  882B
 783  882B              .all_rooms_completed:
 784  882B                  ; Tutte le stanze sono state completate con successo!
 785  882B                  IF ENABLE_VICTORY_SCREEN != 0
 786  882B C3 1F 87         jp   TriggerVictory
 787  882E                  ELSE
 788  882E ~                ; Ricomincia dalla prima stanza (Stanza 00)
 789  882E ~                ld   de, (RoomsListTable)
 790  882E ~                ld   (room_ptr), de
 791  882E ~                xor  a
 792  882E ~                ld   (transition_active), a
 793  882E ~                ld   (velocity_y), a
 794  882E ~                ld   (game_objective_completed), a
 795  882E ~                ld   a, 1
 796  882E ~                ld   (on_ground), a
 797  882E ~                ld   hl, ATTR_P
 798  882E ~                ld   (hl), $07
 799  882E ~                call CLS
 800  882E ~                jp   LoadRoomAndRestart
 801  882E                  ENDIF
 802  882E
 803  882E              ; -------------------------------------------------------------------
 804  882E              ; CheckAllItemsCollected
 805  882E              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 806  882E              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 807  882E              ; -------------------------------------------------------------------
 808  882E              CheckAllItemsCollected:
 809  882E 3A 56 B1         ld   a, (game_objective_completed)
 810  8831 B7               or   a
 811  8832 20 08            jr   nz, .all_collected
 812  8834 3A C0 AE         ld   a, (num_room_items)
 813  8837 B7               or   a
 814  8838 28 02            jr   z, .all_collected
 815  883A B7               or   a
 816  883B C9               ret
 817  883C              .all_collected:
 818  883C 37               scf
 819  883D C9               ret
 820  883E
 821  883E              ; -------------------------------------------------------------------
 822  883E              ; CheckInMasterBedroom (alias per retrocompatibilità)
 823  883E              ; -------------------------------------------------------------------
 824  883E              CheckInMasterBedroom:
 825  883E 37               scf
 826  883F C9               ret
 827  8840
 828  8840              ; -------------------------------------------------------------------
 829  8840              ; CheckWillyConveyorCollision
 830  8840              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 831  8840              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 832  8840              ; -------------------------------------------------------------------
 833  8840              CheckWillyConveyorCollision:
 834  8840 C5               push bc
 835  8841 D5               push de
 836  8842 E5               push hl
 837  8843
 838  8843                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 839  8843 CD 56 77         call CheckWillyOnConveyor
 840  8846 38 49            jr   c, .collision_detected
 841  8848
 842  8848                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 843  8848 3A 68 AE         ld   a, (conveyor_len)
 844  884B B7               or   a
 845  884C 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 846  884E
 847  884E                  ; B = WillyY, C = WillyX
 848  884E ED 4B 40 AB      ld   bc, (PlayerPos)
 849  8852
 850  8852                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 851  8852 3A 69 AE         ld   a, (conveyor_row)
 852  8855 87               add  a, a                  ; *2
 853  8856 87               add  a, a                  ; *4
 854  8857 87               add  a, a                  ; *8
 855  8858 5F               ld   e, a                  ; E = ConveyorTop
 856  8859 C6 07            add  a, 7
 857  885B 57               ld   d, a                  ; D = ConveyorBottom
 858  885C
 859  885C                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 860  885C 78               ld   a, b                  ; WillyTop
 861  885D BA               cp   d
 862  885E 28 04            jr   z, .y_overlap
 863  8860 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 864  8862 18 32            jr   .no_conv_collision
 865  8864
 866  8864              .y_overlap:
 867  8864 C6 0F            add  a, 15                 ; WillyBottom
 868  8866 BB               cp   e
 869  8867 28 04            jr   z, .x_check
 870  8869 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 871  886B 18 29            jr   .no_conv_collision
 872  886D
 873  886D              .x_check:
 874  886D                  ; ConveyorLeft = conveyor_col * 8
 875  886D 3A 6A AE         ld   a, (conveyor_col)
 876  8870 87               add  a, a                  ; *2
 877  8871 87               add  a, a                  ; *4
 878  8872 87               add  a, a                  ; *8
 879  8873 5F               ld   e, a                  ; E = ConveyorLeft
 880  8874
 881  8874                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 882  8874 21 68 AE         ld   hl, conveyor_len
 883  8877 3A 6A AE         ld   a, (conveyor_col)
 884  887A 86               add  a, (hl)
 885  887B 87               add  a, a                  ; *2
 886  887C 87               add  a, a                  ; *4
 887  887D 87               add  a, a                  ; *8
 888  887E 3D               dec  a                     ; ConveyorRight
 889  887F 57               ld   d, a                  ; D = ConveyorRight
 890  8880
 891  8880                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 892  8880 79               ld   a, c                  ; WillyLeft
 893  8881 BA               cp   d
 894  8882 28 04            jr   z, .x_overlap
 895  8884 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 896  8886 18 0E            jr   .no_conv_collision
 897  8888
 898  8888              .x_overlap:
 899  8888 C6 0F            add  a, 15                 ; WillyRight
 900  888A BB               cp   e
 901  888B 28 04            jr   z, .collision_detected
 902  888D 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 903  888F 18 05            jr   .no_conv_collision
 904  8891
 905  8891              .collision_detected:
 906  8891 E1               pop  hl
 907  8892 D1               pop  de
 908  8893 C1               pop  bc
 909  8894 37               scf
 910  8895 C9               ret
 911  8896
 912  8896              .no_conv_collision:
 913  8896 E1               pop  hl
 914  8897 D1               pop  de
 915  8898 C1               pop  bc
 916  8899 B7               or   a
 917  889A C9               ret
 918  889B
 919  889B              ; -------------------------------------------------------------------
 920  889B              ; ResetFullGameState
 921  889B              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 922  889B              ; per l'avvio di una nuova partita dopo il Game Over.
 923  889B              ; -------------------------------------------------------------------
 924  889B              ResetFullGameState:
 925  889B                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 926  889B AF               xor  a
 927  889C D3 FE            out  ($fe), a              ; Bordo a nero
 928  889E 21 8D 5C         ld   hl, ATTR_P
 929  88A1 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 930  88A2 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 931  88A5 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 932  88A7 3E 07            ld   a, $07
 933  88A9 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 934  88AC
 935  88AC                  ; Ripristina il numero di vite iniziali
 936  88AC 3E 07            ld   a, INITIAL_LIVES
 937  88AE 32 4D AB         ld   (willy_lives), a
 938  88B1
 939  88B1                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 940  88B1 AF               xor  a
 941  88B2 32 4A AB         ld   (items_collected), a
 942  88B5 32 46 AB         ld   (body_state), a
 943  88B8 32 59 AB         ld   (w_warp_state), a
 944  88BB 32 5C AB         ld   (w_key_prev), a
 945  88BE 32 5D AB         ld   (enter_key_prev), a
 946  88C1 32 4E AB         ld   (velocity_y), a
 947  88C4 32 50 AB         ld   (jump_pressed), a
 948  88C7 32 52 AB         ld   (coyote_timer), a
 949  88CA 32 55 AB         ld   (jump_frame), a
 950  88CD 32 54 AB         ld   (jump_dir), a
 951  88D0 32 C7 AE         ld   (transition_active), a
 952  88D3 32 4B AF         ld   (willy_safety_timer), a
 953  88D6 3E FF            ld   a, $ff
 954  88D8 32 5E AB         ld   (digit_key_prev), a
 955  88DB 3E 01            ld   a, 1
 956  88DD 32 57 AB         ld   (q_prev), a
 957  88E0 32 58 AB         ld   (a_prev), a
 958  88E3 32 4F AB         ld   (on_ground), a
 959  88E6
 960  88E6                  ; Azzeramento punteggio partita corrente (Score = 000000)
 961  88E6                  ; Nota: High score viene mantenuto intatto tra le partite
 962  88E6 AF               xor  a
 963  88E7 32 50 B1         ld   (player_score + 0), a
 964  88EA 32 51 B1         ld   (player_score + 1), a
 965  88ED 32 52 B1         ld   (player_score + 2), a
 966  88F0
 967  88F0                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 968  88F0 CD 6C 81         call ResetItemsTable
 969  88F3
 970  88F3                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 971  88F3 CD 6E 70         call InitRoomEntryPositions
 972  88F6
 973  88F6                  ; Aggiorna la riga di stato con High score e Score azzerato
 974  88F6 CD F7 68         call Gfx_UpdateScoreDisplay
 975  88F9
 976  88F9                  ; Ripristina la stanza iniziale (Central Cavern)
 977  88F9 21 00 89         ld   hl, CentralCavernLayout
 978  88FC 22 C1 AE         ld   (room_ptr), hl
 979  88FF
 980  88FF C9               ret
 981  8900
 982  8900
 983  8900
 984  8900                  include "resources.asm"

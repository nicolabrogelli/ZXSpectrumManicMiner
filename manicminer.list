 518+ 7C81              ; CheckCollision
 519+ 7C81              ;
 520+ 7C81              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7C81              ; Output:
 522+ 7C81              ;   Carry Set = Collisione con guardiano
 523+ 7C81              ;   Carry Clear = Nessuna collisione
 524+ 7C81              ; -------------------------------------------------------------------
 525+ 7C81              CheckCollision:
 526+ 7C81 DD E5            push ix
 527+ 7C83 C5               push bc
 528+ 7C84 D5               push de
 529+ 7C85 E5               push hl
 530+ 7C86
 531+ 7C86                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7C86 3A 6F 92         ld   a, (willy_safety_timer)
 533+ 7C89 B7               or   a
 534+ 7C8A 20 3B            jr   nz, .no_collision_found
 535+ 7C8C
 536+ 7C8C DD 21 79 79      ld   ix, ActiveEnemies
 537+ 7C90 06 08            ld   b, 8                      ; 8 slot
 538+ 7C92
 539+ 7C92              .collision_loop:
 540+ 7C92 DD 7E 00         ld   a, (ix+0)
 541+ 7C95 E6 80            and  $80                       ; Active?
 542+ 7C97 28 26            jr   z, .next_enemy
 543+ 7C99
 544+ 7C99 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7C9A
 546+ 7C9A                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7C9A ED 4B 65 8E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7C9E DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7CA1
 550+ 7CA1                  ; Calcola differenza X
 551+ 7CA1 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7CA2 30 02            jr   nc, .x_diff_pos
 553+ 7CA4 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7CA6              .x_diff_pos:
 555+ 7CA6 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7CA8 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7CAA
 558+ 7CAA                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7CAA DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7CAD 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7CAE 30 02            jr   nc, .y_diff_pos
 562+ 7CB0 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7CB2              .y_diff_pos:
 564+ 7CB2 FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7CB4 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7CB6
 567+ 7CB6                  ; Collisione trovata!
 568+ 7CB6 C1               pop  bc                        ; Ripristina stack
 569+ 7CB7 E1               pop  hl
 570+ 7CB8 D1               pop  de
 571+ 7CB9 C1               pop  bc
 572+ 7CBA DD E1            pop  ix
 573+ 7CBC 37               scf
 574+ 7CBD C9               ret
 575+ 7CBE
 576+ 7CBE              .no_x_hit:
 577+ 7CBE C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 7CBF
 579+ 7CBF              .next_enemy:
 580+ 7CBF 11 0B 00         ld   de, 11
 581+ 7CC2 DD 19            add  ix, de
 582+ 7CC4 05               dec  b
 583+ 7CC5 20 CB            jr   nz, .collision_loop
 584+ 7CC7
 585+ 7CC7              .no_collision_found:
 586+ 7CC7 E1               pop  hl
 587+ 7CC8 D1               pop  de
 588+ 7CC9 C1               pop  bc
 589+ 7CCA DD E1            pop  ix
 590+ 7CCC B7               or   a
 591+ 7CCD C9               ret

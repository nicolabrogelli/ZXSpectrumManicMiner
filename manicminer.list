 979+ 7838 3A 60 A1         ld   a, (ramp_row)
 980+ 783B 21 5F A1         ld   hl, ramp_len
 981+ 783E 96               sub  (hl)
 982+ 783F 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 983+ 7840 BA               cp   d                 ; Compare with Row
 984+ 7841 28 04            jr   z, .yes

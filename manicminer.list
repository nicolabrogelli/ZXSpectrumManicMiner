 119+ 79EE DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 79F1
 121+ 79F1 23               inc  hl
 122+ 79F2 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 79F3 E6 1F            and  31
 124+ 79F5 87               add  a, a
 124+ 79F6 87             add a, a
 124+ 79F7 87             add a, a
 125+ 79F8 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 79FB
 127+ 79FB 23               inc  hl
 128+ 79FC 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 79FD E6 1F            and  31
 130+ 79FF 87               add  a, a
 130+ 7A00 87             add a, a
 130+ 7A01 87             add a, a
 131+ 7A02 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7A05
 133+ 7A05 23               inc  hl                        ; Prossimo guardiano
 134+ 7A06 11 0B 00         ld   de, 11
 135+ 7A09 DD 19            add  ix, de
 136+ 7A0B 10 8E            djnz .load_h_loop
 137+ 7A0D
 138+ 7A0D              .done_h_guardians:
 139+ 7A0D                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7A0D 2A 27 91         ld   hl, (room_ptr)
 141+ 7A10 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7A13 19               add  hl, de
 143+ 7A14 7E               ld   a, (hl)
 144+ 7A15 FE FF            cp   $FF
 145+ 7A17 28 0A            jr   z, .done_v_guardians
 146+ 7A19 B7               or   a
 147+ 7A1A 28 07            jr   z, .done_v_guardians
 148+ 7A1C
 149+ 7A1C                  ; Slot attivo per guardiano verticale
 150+ 7A1C DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1

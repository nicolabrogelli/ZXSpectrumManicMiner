 251  84DA
 252  84DA 3E 00            ld   a, RESPAWN_SAFETY_TIME
 253  84DC 32 71 9A         ld   (willy_safety_timer), a
 254  84DF
 255  84DF                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 256  84DF C3 D5 83         jp   LoadRoomAndRestart
 257  84E2
 258  84E2              .draw_raster_bars:
 259  84E2                  ; Collisione attiva: disegna le raster bar nel bordo
 260  84E2 3A 88 96         ld   a, (counter)
 261  84E5 E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 262  84E7 06 1E            ld   b, 30             ; Numero di righe della barra raster
 263  84E9              .raster_loop:
 264  84E9 D3 FE            out  ($fe), a
 265  84EB 3C               inc  a
 266  84EC E6 07            and  7
 267  84EE 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 268  84F0              .delay:
 269  84F0 0D               dec  c
 270  84F1 20 FD            jr   nz, .delay
 271  84F3 10 F4            djnz .raster_loop
 272  84F5
 273  84F5                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 274  84F5 3A 73 96         ld   a, (room_border_color)
 275  84F8 D3 FE            out  ($fe), a
 276  84FA 18 05            jr   .no_collision_change

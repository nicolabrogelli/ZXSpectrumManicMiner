  29+ 7C9B              ; Enemy_LoadRoom
  30+ 7C9B              ;
  31+ 7C9B              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7C9B              ; Chiamato quando si entra in una stanza.
  33+ 7C9B              ; -------------------------------------------------------------------
  34+ 7C9B              Enemy_LoadRoom:
  35+ 7C9B E5               push hl
  36+ 7C9C D5               push de
  37+ 7C9D C5               push bc
  38+ 7C9E DD E5            push ix
  39+ 7CA0
  40+ 7CA0                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CA0 21 43 7C         ld   hl, ActiveEnemies
  42+ 7CA3 11 44 7C         ld   de, ActiveEnemies + 1
  43+ 7CA6 36 00            ld   (hl), 0
  44+ 7CA8 01 57 00         ld   bc, 87
  45+ 7CAB ED B0            ldir
  46+ 7CAD
  47+ 7CAD                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CAD DD 21 43 7C      ld   ix, ActiveEnemies
  49+ 7CB1 06 08            ld   b, 8
  50+ 7CB3 11 0B 00         ld   de, 11
  51+ 7CB6              .init_old_pos:
  52+ 7CB6 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7CBA DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CBE DD 19            add  ix, de
  55+ 7CC0 10 F4            djnz .init_old_pos
  56+ 7CC2
  57+ 7CC2                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CC2 DD 21 43 7C      ld   ix, ActiveEnemies
  59+ 7CC6 2A EA AD         ld   hl, (room_ptr)
  60+ 7CC9 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7CCC 19               add  hl, de
  62+ 7CCD
  63+ 7CCD 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CCF              .load_h_loop:
  65+ 7CCF 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CD0 FE FF            cp   $FF
  67+ 7CD2 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CD4 B7               or   a
  69+ 7CD5 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7CD7
  71+ 7CD7                  ; Slot attivo
  72+ 7CD7 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CDB DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7CDE
  75+ 7CDE 23               inc  hl
  76+ 7CDF 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7CE0 23               inc  hl
  78+ 7CE1 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7CE2
  80+ 7CE2                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7CE2 E5               push hl
  82+ 7CE3 C5               push bc
  83+ 7CE4 67               ld   h, a
  84+ 7CE5 69               ld   l, c
  85+ 7CE6 01 00 A4         ld   bc, -23552
  86+ 7CE9 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7CEA
  88+ 7CEA                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7CEA 7D               ld   a, l
  90+ 7CEB E6 1F            and  31
  91+ 7CED 87               add  a, a
  91+ 7CEE 87             add a, a
  91+ 7CEF 87             add a, a
  92+ 7CF0 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7CF3
  94+ 7CF3                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7CF3 CB 3C            srl  h
  95+ 7CF5 CB 1D          rr l
  96+ 7CF7 CB 3C            srl  h
  96+ 7CF9 CB 1D          rr l
  97+ 7CFB CB 3C            srl  h
  97+ 7CFD CB 1D          rr l
  98+ 7CFF CB 3C            srl  h
  98+ 7D01 CB 1D          rr l
  99+ 7D03 CB 3C            srl  h
  99+ 7D05 CB 1D          rr l
 100+ 7D07 7D               ld   a, l
 101+ 7D08 87               add  a, a
 101+ 7D09 87             add a, a
 101+ 7D0A 87             add a, a
 102+ 7D0B DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D0E C1               pop  bc
 104+ 7D0F E1               pop  hl
 105+ 7D10
 106+ 7D10 23               inc  hl
 107+ 7D11 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D12 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D16
 110+ 7D16 23               inc  hl
 111+ 7D17 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D18 E6 01            and  1
 113+ 7D1A 28 04            jr   z, .h_dir_right
 114+ 7D1C 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7D1E 18 02            jr   .set_h_dir
 116+ 7D20              .h_dir_right:
 117+ 7D20 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7D22              .set_h_dir:
 119+ 7D22 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7D25
 121+ 7D25 23               inc  hl
 122+ 7D26 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7D27 E6 1F            and  31
 124+ 7D29 87               add  a, a
 124+ 7D2A 87             add a, a
 124+ 7D2B 87             add a, a
 125+ 7D2C DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7D2F
 127+ 7D2F 23               inc  hl
 128+ 7D30 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7D31 E6 1F            and  31
 130+ 7D33 87               add  a, a
 130+ 7D34 87             add a, a
 130+ 7D35 87             add a, a
 131+ 7D36 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7D39
 133+ 7D39 23               inc  hl                        ; Prossimo guardiano
 134+ 7D3A 11 0B 00         ld   de, 11
 135+ 7D3D DD 19            add  ix, de
 136+ 7D3F 10 8E            djnz .load_h_loop
 137+ 7D41
 138+ 7D41              .done_h_guardians:
 139+ 7D41                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7D41 2A EA AD         ld   hl, (room_ptr)
 141+ 7D44 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7D47 19               add  hl, de
 143+ 7D48 7E               ld   a, (hl)
 144+ 7D49 FE FF            cp   $FF
 145+ 7D4B 28 0A            jr   z, .done_v_guardians
 146+ 7D4D B7               or   a
 147+ 7D4E 28 07            jr   z, .done_v_guardians
 148+ 7D50
 149+ 7D50                  ; Slot attivo per guardiano verticale
 150+ 7D50 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7D54 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7D57                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7D57
 154+ 7D57              .done_v_guardians:
 155+ 7D57 DD E1            pop  ix
 156+ 7D59 C1               pop  bc
 157+ 7D5A D1               pop  de
 158+ 7D5B E1               pop  hl
 159+ 7D5C C9               ret
 160+ 7D5D
 161+ 7D5D              ; -------------------------------------------------------------------
 162+ 7D5D              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7D5D              ; -------------------------------------------------------------------
 164+ 7D5D              CheckEnemyWillyOverlap:
 165+ 7D5D 3A 70 AE         ld   a, (player_drawn_pos+1)
 166+ 7D60 FE FF            cp   $FF
 167+ 7D62 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7D63
 169+ 7D63                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7D63 3A 6F AE         ld   a, (player_drawn_pos)
 171+ 7D66 E6 F8            and  $F8
 172+ 7D68 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7D69 79               ld   a, c
 174+ 7D6A E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7D6C 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7D6D C6 10            add  a, 16
 177+ 7D6F FE 19            cp   25
 178+ 7D71 D0               ret  nc                 ; Fuori portata X
 179+ 7D72
 180+ 7D72                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7D72 3A 70 AE         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7D75 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7D76 C6 0F            add  a, 15
 184+ 7D78 FE 1F            cp   31
 185+ 7D7A D0               ret  nc                 ; Fuori portata Y
 186+ 7D7B
 187+ 7D7B                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7D7B 3E 01            ld   a, 1
 189+ 7D7D 32 75 AE         ld   (willy_needs_redraw), a
 190+ 7D80 C9               ret

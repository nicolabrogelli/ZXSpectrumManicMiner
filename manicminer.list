1343+ 7AD3              ; Phys_CheckRampOnRoomChange
1344+ 7AD3              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1345+ 7AD3              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1346+ 7AD3              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1347+ 7AD3              ; -------------------------------------------------------------------
1348+ 7AD3              Phys_CheckRampOnRoomChange:
1349+ 7AD3 E5               push hl
1350+ 7AD4 D5               push de
1351+ 7AD5 C5               push bc
1352+ 7AD6
1353+ 7AD6                  ; Offsets per RampData: DE + 218
1354+ 7AD6 21 DA 00         ld   hl, 218
1355+ 7AD9 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1356+ 7ADA
1357+ 7ADA 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1358+ 7ADB 32 D0 EE         ld   (ramp_dir), a
1359+ 7ADE 23               inc  hl
1360+ 7ADF 5E               ld   e, (hl)
1361+ 7AE0 23               inc  hl
1362+ 7AE1 56               ld   d, (hl)           ; DE = Location
1363+ 7AE2 23               inc  hl
1364+ 7AE3 7E               ld   a, (hl)           ; A = Length
1365+ 7AE4 32 D1 EE         ld   (ramp_len), a
1366+ 7AE7
1367+ 7AE7                  ; Controlla se DE (Location) è 0 o Length è 0
1368+ 7AE7 7A               ld   a, d
1369+ 7AE8 B3               or   e
1370+ 7AE9 CA F0 7B         jp   z, .no_ramp_change
1371+ 7AEC 3A D1 EE         ld   a, (ramp_len)

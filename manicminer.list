 486  8326 3E FF            ld   a, $ff
 487  8328 32 A7 93         ld   (digit_key_prev), a
 488  832B 32 8F 97         ld   (player_drawn_pos+1), a
 489  832E 32 90 97         ld   (player_old_dir), a
 490  8331 32 91 97         ld   (player_old_body), a
 491  8334 3E 01            ld   a, 1
 492  8336 32 A0 93         ld   (q_prev), a

 894+ 777F 3C               inc  a
 895+ 7780 4F               ld   c, a              ; C = limit_right (exclusive)
 896+ 7781
 897+ 7781 7B               ld   a, e              ; A = Col
 898+ 7782 B8               cp   b
 899+ 7783 38 15            jr   c, .check_platform_case
 900+ 7785 B9               cp   c
 901+ 7786 30 12            jr   nc, .check_platform_case

 355+ 700E              ; LoadPositionPlayeinRoom
 356+ 700E              ;
 357+ 700E              ; Inizializza la posizione del player (Willy) quando entra
 358+ 700E              ; in una nuova stanza.
 359+ 700E              ;
 360+ 700E              ; La posizione viene letta direttamente dai dati della stanza
 361+ 700E              ; (layout/metadata) a partire da room_ptr.
 362+ 700E              ;
 363+ 700E              ; Output:
 364+ 700E              ;   PlayerPos     = posizione iniziale (Y, X)
 365+ 700E              ;   PlayerPosOld  = copia della posizione iniziale
 366+ 700E              ;
 367+ 700E              ; Struttura dati stanza:
 368+ 700E              ;   OFFSET_POS_WILLY:
 369+ 700E              ;       +0 = X
 370+ 700E              ;       +1 = Y
 371+ 700E              ; -------------------------------------------------------------------
 372+ 700E              LoadPositionPlayeinRoom:
 373+ 700E                  ; ---------------------------------------------------------------
 374+ 700E                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 375+ 700E                  ; ---------------------------------------------------------------
 376+ 700E 2A B3 A1         ld   hl, (room_ptr)
 377+ 7011 11 68 02         ld   de, OFFSET_POS_WILLY
 378+ 7014 19               add  hl, de
 379+ 7015
 380+ 7015                  ; Byte 0: Y * 2
 381+ 7015 7E               ld   a, (hl)
 382+ 7016 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 383+ 7018 57               ld   d, a                      ; D = PlayerY
 384+ 7019
 385+ 7019                  ; Byte 1: Anim frame
 386+ 7019 23               inc  hl
 387+ 701A 7E               ld   a, (hl)
 388+ 701B E6 03            and  3                         ; Garanzia valore valido (0..3)
 389+ 701D FE 03            cp   3
 390+ 701F 38 01            jr   c, .valid_anim
 391+ 7021 AF               xor  a
 392+ 7022              .valid_anim:
 393+ 7022 32 38 9E         ld   (body_state), a
 394+ 7025 32 3B A2         ld   (player_old_body), a
 395+ 7028
 396+ 7028                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 397+ 7028 23               inc  hl                        ; Byte 2 (Direction)
 398+ 7029 7E               ld   a, (hl)
 399+ 702A E6 01            and  1
 400+ 702C 28 04            jr   z, .facing_right
 401+ 702E 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 402+ 7030 18 02            jr   .set_dir
 403+ 7032              .facing_right:
 404+ 7032 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 405+ 7034              .set_dir:
 406+ 7034 32 39 9E         ld   (direction), a
 407+ 7037 32 3A A2         ld   (player_old_dir), a
 408+ 703A
 409+ 703A                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 410+ 703A 23               inc  hl                        ; Byte 3 (Airborne)
 411+ 703B 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 412+ 703C 4E               ld   c, (hl)
 413+ 703D 23               inc  hl                        ; Byte 5 (AttrAddr High)
 414+ 703E 7E               ld   a, (hl)
 415+ 703F
 416+ 703F                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 417+ 703F 67               ld   h, a
 418+ 7040 69               ld   l, c
 419+ 7041 01 00 A4         ld   bc, -23552
 420+ 7044 09               add  hl, bc
 421+ 7045
 422+ 7045 7D               ld   a, l
 423+ 7046 E6 1F            and  31
 424+ 7048 87               add  a, a                      ; *2
 425+ 7049 87               add  a, a                      ; *4
 426+ 704A 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 427+ 704B 4F               ld   c, a                      ; C = PlayerX
 428+ 704C 42               ld   b, d                      ; B = PlayerY
 429+ 704D
 430+ 704D                  ; Salva coordinate (C = X, B = Y)
 431+ 704D ED 43 32 9E      ld   (PlayerPos), bc
 432+ 7051 ED 43 34 9E      ld   (PlayerPosOld), bc
 433+ 7055
 434+ 7055                  ; Reset completi di stato player e rendering
 435+ 7055 AF               xor  a
 436+ 7056 32 3D 9E         ld   (sprite_shift), a
 437+ 7059 32 3B 9E         ld   (collision_active), a
 438+ 705C 32 3E A2         ld   (willy_needs_redraw), a
 439+ 705F 32 48 9E         ld   (current_input_dir), a
 440+ 7062 32 5D A1         ld   (conveyor_caught), a
 441+ 7065 3E FF            ld   a, $FF

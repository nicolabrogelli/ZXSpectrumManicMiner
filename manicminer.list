   7+ 8682              ; -------------------------------------------------------------------
   8+ 8682              ; Audio_UpdateJumpSound
   9+ 8682              ;
  10+ 8682              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8682              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8682              ; -------------------------------------------------------------------
  13+ 8682              Audio_UpdateJumpSound:
  14+ 8682 F5               push af
  15+ 8683 C5               push bc
  16+ 8684 D5               push de
  17+ 8685 E5               push hl
  18+ 8686
  19+ 8686                  ; Controlla se il suono è attivo (note < 18)
  20+ 8686 3A A9 E7         ld   a, (Audio_jump_sound_note)
  21+ 8689 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 868B 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 868D
  24+ 868D                  ; Carica la nota corrente da suonare
  25+ 868D 5F               ld   e, a
  26+ 868E 16 00            ld   d, 0
  27+ 8690 21 BC 86         ld   hl, Audio_JumpSoundDelays
  28+ 8693 19               add  hl, de
  29+ 8694 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8695 57               ld   d, a                      ; D = delay della nota
  31+ 8696
  32+ 8696                  ; Suona la nota: 15 cicli
  33+ 8696 06 0F            ld   b, 15
  34+ 8698              .note_loop:
  35+ 8698                  ; Speaker ON
  36+ 8698 3A 96 E1         ld   a, (room_border_color)
  37+ 869B F6 10            or   $10
  38+ 869D D3 FE            out  ($fe), a
  39+ 869F 4A               ld   c, d
  40+ 86A0              .d1:
  41+ 86A0 0D               dec  c
  42+ 86A1 20 FD            jr   nz, .d1
  43+ 86A3
  44+ 86A3                  ; Speaker OFF
  45+ 86A3 3A 96 E1         ld   a, (room_border_color)
  46+ 86A6 E6 EF            and  $ef
  47+ 86A8 D3 FE            out  ($fe), a
  48+ 86AA 4A               ld   c, d
  49+ 86AB              .d2:
  50+ 86AB 0D               dec  c
  51+ 86AC 20 FD            jr   nz, .d2
  52+ 86AE
  53+ 86AE 10 E8            djnz .note_loop
  54+ 86B0
  55+ 86B0                  ; Passa alla nota successiva
  56+ 86B0 3A A9 E7         ld   a, (Audio_jump_sound_note)
  57+ 86B3 3C               inc  a
  58+ 86B4 32 A9 E7         ld   (Audio_jump_sound_note), a
  59+ 86B7
  60+ 86B7              .done:
  61+ 86B7 E1               pop  hl
  62+ 86B8 D1               pop  de
  63+ 86B9 C1               pop  bc
  64+ 86BA F1               pop  af
  65+ 86BB C9               ret

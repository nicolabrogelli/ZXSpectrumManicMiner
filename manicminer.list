 180+ 85D8 E5               push hl
 181+ 85D9 DD E1            pop  ix                        ; IX = bitmap item
 182+ 85DB
 183+ 85DB                  ; 4. HL = Inizio lista item nella stanza
 184+ 85DB 2A 72 EE         ld   hl, (room_ptr)
 185+ 85DE 11 75 02         ld   de, OFFSET_ITEMS
 186+ 85E1 19               add  hl, de
 187+ 85E2
 188+ 85E2              .loop:
 189+ 85E2 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 85E3 FE FF            cp   $FF
 191+ 85E5 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 85E7 B7               or   a
 193+ 85E8 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 85EA
 195+ 85EA 5F               ld   e, a                      ; E = Color
 196+ 85EB 23               inc  hl
 197+ 85EC 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 85ED 23               inc  hl

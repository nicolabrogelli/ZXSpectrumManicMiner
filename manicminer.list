 216  8984 ~                ld   a, 1
 217  8984 ~                ld   (willy_lives), a
 218  8984 ~                jr   .normal_respawn
 219  8984                  ENDIF
 220  8984
 221  8984              .normal_respawn:
 222  8984                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 223  8984 CD 2A 85         call Items_ResetCurrentRoomItems
 224  8987
 225  8987                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 226  8987 AF               xor  a
 227  8988 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 228  898A CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce il display RAM e imposta gli attributi a nero
 229  898D
 230  898D                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 231  898D 06 19            ld   b, 25
 232  898F              .death_pause:
 233  898F 76               halt
 234  8990 10 FD            djnz .death_pause
 235  8992
 236  8992                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 237  8992 AF               xor  a
 238  8993 32 93 EA         ld   (velocity_y), a
 239  8996 32 95 EA         ld   (jump_pressed), a
 240  8999 32 97 EA         ld   (coyote_timer), a
 241  899C 32 9A EA         ld   (jump_frame), a
 242  899F 32 99 EA         ld   (jump_dir), a
 243  89A2 32 8B EA         ld   (body_state), a
 244  89A5 32 8E EE         ld   (player_old_body), a
 245  89A8 32 8D EE         ld   (player_old_dir), a
 246  89AB 32 90 EA         ld   (sprite_shift), a
 247  89AE 32 8E EA         ld   (collision_active), a
 248  89B1 32 92 EE         ld   (willy_needs_redraw), a
 249  89B4 32 9B EA         ld   (current_input_dir), a
 250  89B7 32 B0 ED         ld   (conveyor_caught), a
 251  89BA 32 0C EE         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 252  89BD 3E 01            ld   a, 1
 253  89BF 32 94 EA         ld   (on_ground), a
 254  89C2
 255  89C2 3E 00            ld   a, RESPAWN_SAFETY_TIME
 256  89C4 32 91 EE         ld   (willy_safety_timer), a
 257  89C7
 258  89C7                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 259  89C7 C3 AD 88         jp   LoadRoomAndRestart
 260  89CA
 261  89CA              .draw_raster_bars:
 262  89CA                  ; Collisione attiva: disegna le raster bar nel bordo
 263  89CA 3A A6 EA         ld   a, (counter)
 264  89CD E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 265  89CF 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  89D1              .raster_loop:
 267  89D1 D3 FE            out  ($fe), a
 268  89D3 3C               inc  a
 269  89D4 E6 07            and  7
 270  89D6 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  89D8              .delay:
 272  89D8 0D               dec  c
 273  89D9 20 FD            jr   nz, .delay
 274  89DB 10 F4            djnz .raster_loop
 275  89DD
 276  89DD                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  89DD 3A 91 EA         ld   a, (room_border_color)
 278  89E0 D3 FE            out  ($fe), a
 279  89E2 18 05            jr   .no_collision_change
 280  89E4
 281  89E4              .no_collision:
 282  89E4                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 283  89E4 3A 91 EA         ld   a, (room_border_color)
 284  89E7 D3 FE            out  ($fe), a
 285  89E9
 286  89E9              .no_collision_change:
 287  89E9 C3 10 89         jp   Main_loop
 288  89EC
 289  89EC              ; -------------------------------------------------------------------
 290  89EC              ; ShowTitleScreen
 291  89EC              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  89EC              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  89EC              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  89EC              ; -------------------------------------------------------------------
 295  89EC              ShowTitleScreen:
 296  89EC                  ; 1. Disegna la schermata iniziale
 297  89EC CD 7A 64         call Gfx_DrawTitleScreen
 298  89EF
 299  89EF                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  89EF              .wait_title_enter_release:
 301  89EF 76               halt
 302  89F0 3E BF            ld   a, $bf
 303  89F2 DB FE            in   a, ($fe)
 304  89F4 1F               rra
 305  89F5 30 F8            jr   nc, .wait_title_enter_release
 306  89F7
 307  89F7                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  89F7 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  89F9              .title_loop:
 310  89F9 76               halt
 311  89FA
 312  89FA                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  89FA 0C               inc  c
 314  89FB 79               ld   a, c
 315  89FC CB 3F            srl  a
 316  89FE CB 3F            srl  a
 317  8A00 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  8A02 E6 07            and  7
 319  8A04 5F               ld   e, a
 320  8A05 16 00            ld   d, 0
 321  8A07 21 72 64         ld   hl, title_color_table
 322  8A0A 19               add  hl, de
 323  8A0B 7E               ld   a, (hl)               ; A = nuovo colore
 324  8A0C 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  8A0F 06 20            ld   b, 32
 326  8A11              .color_title_loop:
 327  8A11 77               ld   (hl), a
 328  8A12 23               inc  hl
 329  8A13 10 FC            djnz .color_title_loop
 330  8A15
 331  8A15                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  8A15 3E BF            ld   a, $bf
 333  8A17 DB FE            in   a, ($fe)
 334  8A19 1F               rra
 335  8A1A 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  8A1C
 337  8A1C                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  8A1C              .wait_title_enter_release_after:
 339  8A1C 76               halt
 340  8A1D 3E BF            ld   a, $bf
 341  8A1F DB FE            in   a, ($fe)
 342  8A21 1F               rra
 343  8A22 30 F8            jr   nc, .wait_title_enter_release_after
 344  8A24
 345  8A24                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  8A24 AF               xor  a
 347  8A25 D3 FE            out  ($fe), a              ; Bordo a nero
 348  8A27 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  8A2A
 350  8A2A                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  8A2A CD EB 8B         call ResetFullGameState
 352  8A2D
 353  8A2D                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  8A2D C3 AD 88         jp   LoadRoomAndRestart
 355  8A30
 356  8A30              ; -------------------------------------------------------------------
 357  8A30              ; TriggerGameOver
 358  8A30              ; Scatena la sequenza originale di Game Over:
 359  8A30              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  8A30              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  8A30              ;   con suono beeper originale e lampeggio dello schermo.
 362  8A30              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  8A30              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  8A30              ; -------------------------------------------------------------------
 365  8A30              TriggerGameOver:
 366  8A30                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  8A30 CD 97 87         call Score_CheckAndUpdateHighScore
 368  8A33
 369  8A33                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  8A33 CD 12 66         call Gfx_DrawGameOverScreen
 371  8A36
 372  8A36                  ; 3. Ritorna al Title Screen originale
 373  8A36 C3 EC 89         jp   ShowTitleScreen
 374  8A39
 375  8A39              ; -------------------------------------------------------------------
 376  8A39              ; TriggerVictory
 377  8A39              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  8A39              ; - Pulisce gli elementi di gioco della stanza.
 379  8A39              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  8A39              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  8A39              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  8A39              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  8A39              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  8A39              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  8A39              ; -------------------------------------------------------------------
 386  8A39              TriggerVictory:
 387  8A39                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  8A39 CD FD 66         call Gfx_DrawVictoryScreen
 389  8A3C
 390  8A3C                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8A3C              .wait_keys_release:
 392  8A3C 76               halt
 393  8A3D                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8A3D 01 FE DF         ld   bc, $dffe
 395  8A40 ED 78            in   a, (c)
 396  8A42 CB 67            bit  4, a
 397  8A44 28 F6            jr   z, .wait_keys_release
 398  8A46
 399  8A46                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8A46 01 FE 7F         ld   bc, $7ffe
 401  8A49 ED 78            in   a, (c)
 402  8A4B CB 5F            bit  3, a
 403  8A4D 28 ED            jr   z, .wait_keys_release
 404  8A4F
 405  8A4F                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8A4F 01 FE BF         ld   bc, $bffe
 407  8A52 ED 78            in   a, (c)
 408  8A54 CB 47            bit  0, a
 409  8A56 28 E4            jr   z, .wait_keys_release
 410  8A58
 411  8A58                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8A58 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8A5A              .wait_choice_loop:
 414  8A5A 76               halt
 415  8A5B
 416  8A5B                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8A5B 0C               inc  c
 418  8A5C 79               ld   a, c
 419  8A5D CB 3F            srl  a
 420  8A5F CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8A61 E6 07            and  7
 422  8A63 5F               ld   e, a
 423  8A64 16 00            ld   d, 0
 424  8A66 21 F4 65         ld   hl, victory_color_table
 425  8A69 19               add  hl, de
 426  8A6A 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8A6B 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8A6E 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8A70              .color_cycle_loop:
 430  8A70 77               ld   (hl), a
 431  8A71 23               inc  hl
 432  8A72 10 FC            djnz .color_cycle_loop
 433  8A74
 434  8A74                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8A74 01 FE DF         ld   bc, $dffe
 436  8A77 ED 78            in   a, (c)
 437  8A79 CB 67            bit  4, a
 438  8A7B 28 2A            jr   z, .play_again_chosen
 439  8A7D
 440  8A7D                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8A7D 01 FE 7F         ld   bc, $7ffe
 442  8A80 ED 78            in   a, (c)
 443  8A82 CB 5F            bit  3, a
 444  8A84 28 0B            jr   z, .quit_chosen
 445  8A86
 446  8A86                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8A86 01 FE BF         ld   bc, $bffe
 448  8A89 ED 78            in   a, (c)
 449  8A8B CB 47            bit  0, a
 450  8A8D 28 02            jr   z, .quit_chosen
 451  8A8F
 452  8A8F 18 C9            jr   .wait_choice_loop
 453  8A91
 454  8A91              .quit_chosen:
 455  8A91                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8A91              .wait_quit_release:
 457  8A91 76               halt
 458  8A92 01 FE 7F         ld   bc, $7ffe
 459  8A95 ED 78            in   a, (c)
 460  8A97 CB 5F            bit  3, a
 461  8A99 28 F6            jr   z, .wait_quit_release
 462  8A9B 01 FE BF         ld   bc, $bffe
 463  8A9E ED 78            in   a, (c)
 464  8AA0 CB 47            bit  0, a
 465  8AA2 28 ED            jr   z, .wait_quit_release
 466  8AA4
 467  8AA4                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8AA4 C3 EC 89         jp   ShowTitleScreen
 469  8AA7
 470  8AA7              .play_again_chosen:
 471  8AA7                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8AA7              .wait_play_again_release:
 473  8AA7 76               halt
 474  8AA8 01 FE DF         ld   bc, $dffe
 475  8AAB ED 78            in   a, (c)
 476  8AAD CB 67            bit  4, a
 477  8AAF 28 F6            jr   z, .wait_play_again_release
 478  8AB1
 479  8AB1                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8AB1 CD EB 8B         call ResetFullGameState
 481  8AB4 C3 AD 88         jp   LoadRoomAndRestart
 482  8AB7
 483  8AB7              ; -------------------------------------------------------------------
 484  8AB7              ; CheckPortalTransition
 485  8AB7              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8AB7              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8AB7              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8AB7              ;
 489  8AB7              ; Output:
 490  8AB7              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8AB7              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8AB7              ; -------------------------------------------------------------------
 493  8AB7              CheckPortalTransition:
 494  8AB7 C5               push bc
 495  8AB8 D5               push de
 496  8AB9 E5               push hl
 497  8ABA
 498  8ABA                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8ABA CD 7E 8B         call CheckAllItemsCollected
 500  8ABD 30 4D            jr   nc, .no_transition
 501  8ABF
 502  8ABF                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8ABF                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8ABF                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8ABF 2A 06 EE         ld   hl, (room_ptr)
 506  8AC2 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8AC5 19               add  hl, de
 508  8AC6 4E               ld   c, (hl)
 509  8AC7 23               inc  hl
 510  8AC8 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8AC9
 512  8AC9                  ; Offset = BC - 23552
 513  8AC9 60               ld   h, b
 514  8ACA 69               ld   l, c
 515  8ACB 01 00 A4         ld   bc, -23552
 516  8ACE 09               add  hl, bc
 517  8ACF
 518  8ACF                  ; PortalX = (Offset & 31) * 8
 519  8ACF 7D               ld   a, l
 520  8AD0 E6 1F            and  31
 521  8AD2 87               add  a, a
 521  8AD3 87             add a, a
 521  8AD4 87             add a, a
 522  8AD5 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8AD6
 524  8AD6                  ; PortalY = (Offset / 32) * 8
 525  8AD6 CB 3C            srl  h
 525  8AD8 CB 1D          rr l
 526  8ADA CB 3C            srl  h
 526  8ADC CB 1D          rr l
 527  8ADE CB 3C            srl  h
 527  8AE0 CB 1D          rr l
 528  8AE2 CB 3C            srl  h
 528  8AE4 CB 1D          rr l
 529  8AE6 CB 3C            srl  h
 529  8AE8 CB 1D          rr l
 530  8AEA 7D               ld   a, l
 531  8AEB 87               add  a, a
 531  8AEC 87             add a, a
 531  8AED 87             add a, a
 532  8AEE 57               ld   d, a                      ; D = PortalY (0..120)
 533  8AEF
 534  8AEF                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8AEF ED 4B 85 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8AF3
 537  8AF3                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8AF3 7B               ld   a, e
 539  8AF4 91               sub  c
 540  8AF5 30 02            jr   nc, .x_diff_pos
 541  8AF7 ED 44            neg
 542  8AF9              .x_diff_pos:
 543  8AF9 FE 0C            cp   12
 544  8AFB 30 0F            jr   nc, .no_transition
 545  8AFD
 546  8AFD                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8AFD 7A               ld   a, d
 548  8AFE 90               sub  b
 549  8AFF 30 02            jr   nc, .y_diff_pos
 550  8B01 ED 44            neg
 551  8B03              .y_diff_pos:
 552  8B03 FE 0E            cp   14
 553  8B05 30 05            jr   nc, .no_transition
 554  8B07
 555  8B07                  ; Transizione al portale attiva!
 556  8B07 E1               pop  hl
 557  8B08 D1               pop  de
 558  8B09 C1               pop  bc
 559  8B0A 37               scf
 560  8B0B C9               ret
 561  8B0C
 562  8B0C              .no_transition:
 563  8B0C E1               pop  hl
 564  8B0D D1               pop  de
 565  8B0E C1               pop  bc
 566  8B0F B7               or   a
 567  8B10 C9               ret
 568  8B11
 569  8B11              ; Alias per retrocompatibilità
 570  8B11              CheckVictoryCondition: EQU CheckPortalTransition
 571  8B11
 572  8B11              ; -------------------------------------------------------------------
 573  8B11              ; TriggerPortalTransition
 574  8B11              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8B11              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8B11              ; - Avanza all'indice della stanza successiva.
 577  8B11              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8B11              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8B11              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8B11              ; -------------------------------------------------------------------
 581  8B11              TriggerPortalTransition:
 582  8B11                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8B11 CD 48 8B         call Air_DepleteCountdown
 584  8B14
 585  8B14                  ; 1. Determina l'ID della stanza corrente
 586  8B14 CD D8 84         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8B17
 588  8B17                  ; 2. Calcola l'indice della stanza successiva
 589  8B17 3A AB ED         ld   a, (current_room)
 590  8B1A 3C               inc  a
 591  8B1B FE 14            cp   NUM_ROOMS
 592  8B1D 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8B1F
 594  8B1F                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8B1F 21 A2 73         ld   hl, RoomsListTable
 596  8B22 5F               ld   e, a
 597  8B23 16 00            ld   d, 0
 598  8B25 19               add  hl, de
 599  8B26 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8B27 5E               ld   e, (hl)
 601  8B28 23               inc  hl
 602  8B29 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8B2A ED 53 06 EE      ld   (room_ptr), de
 604  8B2E
 605  8B2E                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8B2E AF               xor  a
 607  8B2F 32 0C EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8B32 32 93 EA         ld   (velocity_y), a
 609  8B35 32 9E F0         ld   (game_objective_completed), a
 610  8B38 3E 01            ld   a, 1
 611  8B3A 32 94 EA         ld   (on_ground), a
 612  8B3D
 613  8B3D                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8B3D 3E 07            ld   a, $07
 615  8B3F CD 9D 62         call Gfx_ClearScreenDirect
 616  8B42
 617  8B42 C3 AD 88         jp   LoadRoomAndRestart
 618  8B45
 619  8B45              .all_rooms_completed:
 620  8B45                  ; Tutte le stanze sono state completate con successo!
 621  8B45                  IF ENABLE_VICTORY_SCREEN != 0
 622  8B45 C3 39 8A         jp   TriggerVictory
 623  8B48                  ELSE
 624  8B48 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 625  8B48 ~                ld   de, (RoomsListTable)
 626  8B48 ~                ld   (room_ptr), de
 627  8B48 ~                xor  a
 628  8B48 ~                ld   (transition_active), a
 629  8B48 ~                ld   (velocity_y), a
 630  8B48 ~                ld   (game_objective_completed), a
 631  8B48 ~                ld   a, 1
 632  8B48 ~                ld   (on_ground), a
 633  8B48 ~                ld   a, $07
 634  8B48 ~                call Gfx_ClearScreenDirect
 635  8B48 ~                jp   LoadRoomAndRestart
 636  8B48                  ENDIF
 637  8B48
 638  8B48              ; -------------------------------------------------------------------
 639  8B48              ; Air_DepleteCountdown
 640  8B48              ; Animazione originale di completamento livello (Manic Miner):
 641  8B48              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 642  8B48              ; - Ad ogni pixel decrementato:
 643  8B48              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 644  8B48              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 645  8B48              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 646  8B48              ; -------------------------------------------------------------------
 647  8B48              Air_DepleteCountdown:
 648  8B48 F5               push af
 649  8B49 C5               push bc
 650  8B4A D5               push de
 651  8B4B E5               push hl
 652  8B4C
 653  8B4C              .countdown_loop:
 654  8B4C 3A A7 F0         ld   a, (air_pixels)
 655  8B4F B7               or   a
 656  8B50 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 657  8B52
 658  8B52 3D               dec  a
 659  8B53 32 A7 F0         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 660  8B56
 661  8B56                  ; Aggiorna la barra grafica dell'aria
 662  8B56 CD 2D 6A         call Gfx_UpdateAirBar
 663  8B59
 664  8B59                  ; Aggiungi 1 punto allo score
 665  8B59 CD 4C 87         call Score_Add1Point
 666  8B5C
 667  8B5C                  ; Genera l'effetto sonoro originale di Manic Miner:
 668  8B5C                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 669  8B5C 3A A7 F0         ld   a, (air_pixels)
 670  8B5F 2F               cpl
 671  8B60 E6 3F            and  63
 672  8B62 07               rlca
 673  8B63 3C               inc  a
 674  8B64 57               ld   d, a                      ; D = ritardo semionda audio
 675  8B65
 676  8B65 0E 03            ld   c, 3                      ; Durata impulso
 677  8B67              .audio_loop:
 678  8B67 AF               xor  a
 679  8B68 D3 FE            out  ($fe), a
 680  8B6A 42               ld   b, d
 681  8B6B 10 FE        .w1: djnz .w1
 682  8B6D
 683  8B6D 3E 18            ld   a, $18
 684  8B6F D3 FE            out  ($fe), a
 685  8B71 42               ld   b, d
 686  8B72 10 FE        .w2: djnz .w2
 687  8B74
 688  8B74 0D               dec  c
 689  8B75 20 F0            jr   nz, .audio_loop
 690  8B77
 691  8B77 18 D3            jr   .countdown_loop
 692  8B79
 693  8B79              .done_countdown:
 694  8B79 E1               pop  hl
 695  8B7A D1               pop  de
 696  8B7B C1               pop  bc
 697  8B7C F1               pop  af
 698  8B7D C9               ret

 671+ 87DB              ; -------------------------------------------------------------------
 672+ 87DB              ; Score_AddItemPoints
 673+ 87DB              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 674+ 87DB              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 675+ 87DB              ; -------------------------------------------------------------------
 676+ 87DB              Score_AddItemPoints:
 677+ 87DB F5               push af
 678+ 87DC C5               push bc
 679+ 87DD D5               push de
 680+ 87DE E5               push hl
 681+ 87DF
 682+ 87DF                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 683+ 87DF 3A FE F0         ld   a, (player_score + 1)
 684+ 87E2 C6 01            add  a, $01
 685+ 87E4 27               daa
 686+ 87E5 32 FE F0         ld   (player_score + 1), a
 687+ 87E8
 688+ 87E8                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 87E8 3A FF F0         ld   a, (player_score + 2)
 690+ 87EB CE 00            adc  a, 0
 691+ 87ED 27               daa
 692+ 87EE 32 FF F0         ld   (player_score + 2), a
 693+ 87F1
 694+ 87F1                  ; Controlla se player_score ha superato high_score
 695+ 87F1 CD FC 87         call Score_CheckAndUpdateHighScore
 696+ 87F4
 697+ 87F4                  ; Aggiorna visualizzazione a schermo
 698+ 87F4 CD B8 68         call Gfx_UpdateScoreDisplay
 699+ 87F7
 700+ 87F7 E1               pop  hl
 701+ 87F8 D1               pop  de
 702+ 87F9 C1               pop  bc
 703+ 87FA F1               pop  af
 704+ 87FB C9               ret
 705+ 87FC
 706+ 87FC              ; -------------------------------------------------------------------
 707+ 87FC              ; Score_CheckAndUpdateHighScore
 708+ 87FC              ; Se player_score > high_score, copia player_score in high_score.
 709+ 87FC              ; -------------------------------------------------------------------
 710+ 87FC              Score_CheckAndUpdateHighScore:
 711+ 87FC                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 87FC                  ; Byte 2:
 713+ 87FC 3A FF F0         ld   a, (player_score + 2)
 714+ 87FF 47               ld   b, a
 715+ 8800 3A 02 F1         ld   a, (high_score + 2)
 716+ 8803 B8               cp   b
 717+ 8804 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 8806 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 8808
 720+ 8808                  ; Byte 1:
 721+ 8808 3A FE F0         ld   a, (player_score + 1)
 722+ 880B 47               ld   b, a
 723+ 880C 3A 01 F1         ld   a, (high_score + 1)
 724+ 880F B8               cp   b
 725+ 8810 38 0C            jr   c, .new_high_score
 726+ 8812 20 1C            jr   nz, .done_check
 727+ 8814
 728+ 8814                  ; Byte 0:
 729+ 8814 3A FD F0         ld   a, (player_score + 0)
 730+ 8817 47               ld   b, a
 731+ 8818 3A 00 F1         ld   a, (high_score + 0)
 732+ 881B B8               cp   b
 733+ 881C 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 881E
 735+ 881E              .new_high_score:
 736+ 881E 3A FD F0         ld   a, (player_score + 0)
 737+ 8821 32 00 F1         ld   (high_score + 0), a
 738+ 8824 3A FE F0         ld   a, (player_score + 1)
 739+ 8827 32 01 F1         ld   (high_score + 1), a
 740+ 882A 3A FF F0         ld   a, (player_score + 2)
 741+ 882D 32 02 F1         ld   (high_score + 2), a
 742+ 8830
 743+ 8830              .done_check:
 744+ 8830 C9               ret
 745+ 8831
 746+ 8831              ; -------------------------------------------------------------------
 747+ 8831              ; Items_Animate
 748+ 8831              ;
 749+ 8831              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 8831              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 8831              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 8831              ; originale $8F63.
 753+ 8831              ; -------------------------------------------------------------------
 754+ 8831              Items_Animate:
 755+ 8831 E5               push hl
 756+ 8832 D5               push de
 757+ 8833 C5               push bc
 758+ 8834 FD E5            push iy
 759+ 8836
 760+ 8836 3A 6A EE         ld   a, (num_room_items)
 761+ 8839 B7               or   a
 762+ 883A 28 40            jr   z, .anim_done
 763+ 883C
 764+ 883C FD 21 1A EE      ld   iy, current_room_items
 765+ 8840
 766+ 8840              .anim_loop:
 767+ 8840 FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 8843 FE FF            cp   $FF
 769+ 8845 28 35            jr   z, .anim_done
 770+ 8847 B7               or   a
 771+ 8848 28 2B            jr   z, .next_anim_item
 772+ 884A
 773+ 884A                  ; Routine originale $8F63 di Manic Miner:
 774+ 884A                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 884A E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 884C F6 03            or   $03                       ; Base Ink = 3
 777+ 884E 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 884F FD 7E 02         ld   a, (iy+2)
 779+ 8852 E6 03            and  $03                       ; Isola offset rotazione
 780+ 8854 80               add  a, b                      ; A = Nuovo attributo
 781+ 8855 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 8858 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8859
 784+ 8859                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8859 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 885C 16 00            ld   d, 0
 787+ 885E 26 00            ld   h, 0
 788+ 8860 FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 8863 29               add  hl, hl
 790+ 8864 29               add  hl, hl
 791+ 8865 29               add  hl, hl
 792+ 8866 29               add  hl, hl
 793+ 8867 29               add  hl, hl                    ; Row * 32
 794+ 8868 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 8869
 796+ 8869                  ; Aggiorna items_grid
 797+ 8869 E5               push hl
 798+ 886A 11 EA E8         ld   de, items_grid
 799+ 886D 19               add  hl, de
 800+ 886E 70               ld   (hl), b
 801+ 886F E1               pop  hl
 802+ 8870
 803+ 8870                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 8870 11 00 58         ld   de, $5800
 805+ 8873 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 8874 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 8875
 808+ 8875              .next_anim_item:
 809+ 8875 01 05 00         ld   bc, 5
 810+ 8878 FD 09            add  iy, bc
 811+ 887A 18 C4            jr   .anim_loop
 812+ 887C
 813+ 887C              .anim_done:
 814+ 887C FD E1            pop  iy
 815+ 887E C1               pop  bc
 816+ 887F D1               pop  de
 817+ 8880 E1               pop  hl
 818+ 8881 C9               ret

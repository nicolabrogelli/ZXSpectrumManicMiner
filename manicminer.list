  62+ 7CE9
  63+ 7CE9 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CEB              .load_h_loop:
  65+ 7CEB 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CEC FE FF            cp   $FF
  67+ 7CEE 28 7F            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CF0 B7               or   a
  69+ 7CF1 28 74            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7CF3
  71+ 7CF3                  ; Slot attivo
  72+ 7CF3 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CF7 CB 7F            bit  7, a
  74+ 7CF9 28 04            jr   z, .h_speed_normal
  75+ 7CFB DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)
  76+ 7CFF              .h_speed_normal:
  77+ 7CFF E6 7F            and  $7F                       ; Rimuove bit 7 (velocità) per isolare l'attributo colore ed evitare il FLASH hardware
  78+ 7D01 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7D04
  80+ 7D04 23               inc  hl
  81+ 7D05 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7D06 23               inc  hl
  83+ 7D07 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7D08
  85+ 7D08                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7D08 E5               push hl
  87+ 7D09 C5               push bc

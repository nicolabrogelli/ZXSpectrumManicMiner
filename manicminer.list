 315+ 7E2B              ; -------------------------------------------------------------------
 316+ 7E2B              ; Enemy_DrawSingleSlot
 317+ 7E2B              ;
 318+ 7E2B              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7E2B              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7E2B              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7E2B              ; -------------------------------------------------------------------
 322+ 7E2B              Enemy_DrawSingleSlot:
 323+ 7E2B C5               push bc
 324+ 7E2C D5               push de
 325+ 7E2D E5               push hl
 326+ 7E2E DD E5            push ix
 327+ 7E30
 328+ 7E30                  ; 1. Determina il frame di animazione (0..7)
 329+ 7E30                  ; Nei dati di Manic Miner:
 330+ 7E30                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7E30                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7E30 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7E33 E6 03            and  3
 334+ 7E35 47               ld   b, a                      ; B = Anim subframe
 335+ 7E36
 336+ 7E36 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7E39 FE 01            cp   1                         ; Sinistra?
 338+ 7E3B 28 03            jr   z, .left_frames
 339+ 7E3D
 340+ 7E3D                  ; Movimento a Destra: Frame 0..3
 341+ 7E3D 78               ld   a, b
 342+ 7E3E 18 03            jr   .got_frame_idx
 343+ 7E40
 344+ 7E40              .left_frames:
 345+ 7E40                  ; Movimento a Sinistra: Frame 4..7
 346+ 7E40 3E 04            ld   a, 4
 347+ 7E42 80               add  a, b
 348+ 7E43
 349+ 7E43              .got_frame_idx:
 350+ 7E43                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7E43 6F               ld   l, a
 352+ 7E44 26 00            ld   h, 0
 353+ 7E46 29               add  hl, hl                    ; *2
 354+ 7E47 29               add  hl, hl                    ; *4
 355+ 7E48 29               add  hl, hl                    ; *8
 356+ 7E49 29               add  hl, hl                    ; *16
 357+ 7E4A 29               add  hl, hl                    ; *32
 358+ 7E4B
 359+ 7E4B 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7E4E 19               add  hl, de
 361+ 7E4F ED 5B EA AD      ld   de, (room_ptr)
 362+ 7E53 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7E54 E5               push hl
 364+ 7E55 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7E57
 366+ 7E57                  ; 2. Coordinate e colore
 367+ 7E57 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7E59 FD E5            push iy
 369+ 7E5B
 370+ 7E5B FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7E5E FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7E61 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7E64
 374+ 7E64                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7E64 CD 6B 5F         call Gfx_DrawPixelSprite16x16
 376+ 7E67 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7E6A CD 12 6D         call Gfx_SetEnemyColorAttributes
 378+ 7E6D
 379+ 7E6D DD E1            pop  ix
 380+ 7E6F E1               pop  hl
 381+ 7E70 D1               pop  de
 382+ 7E71 C1               pop  bc
 383+ 7E72 C9               ret
 384+ 7E73
 385+ 7E73              ; -------------------------------------------------------------------
 386+ 7E73              ; Enemy_Update
 387+ 7E73              ;
 388+ 7E73              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7E73              ; -------------------------------------------------------------------
 390+ 7E73              Enemy_Update:
 391+ 7E73                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7E73 3A EC AD         ld   a, (enemy_update_rate)
 393+ 7E76 FE 01            cp   1
 394+ 7E78 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7E7A
 396+ 7E7A 21 ED AD         ld   hl, enemy_update_timer
 397+ 7E7D 34               inc  (hl)
 398+ 7E7E 7E               ld   a, (hl)
 399+ 7E7F 21 EC AD         ld   hl, enemy_update_rate
 400+ 7E82 BE               cp   (hl)
 401+ 7E83 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7E84 AF               xor  a
 403+ 7E85 32 ED AD         ld   (enemy_update_timer), a
 404+ 7E88
 405+ 7E88              .do_update:
 406+ 7E88 E5               push hl
 407+ 7E89 D5               push de
 408+ 7E8A C5               push bc
 409+ 7E8B DD E5            push ix
 410+ 7E8D
 411+ 7E8D 3E 01            ld   a, 1
 412+ 7E8F 32 73 AE         ld   (enemy_was_updated), a
 413+ 7E92
 414+ 7E92 DD 21 43 7C      ld   ix, ActiveEnemies
 415+ 7E96 06 08            ld   b, 8                      ; 8 slot
 416+ 7E98              .loop:
 417+ 7E98 DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7E9B E6 80            and  $80                       ; Active?
 419+ 7E9D CA 3C 7F         jp   z, .next
 420+ 7EA0
 421+ 7EA0                  ; 1. Aggiorna Anim State (0..3)
 422+ 7EA0 DD 7E 07         ld   a, (ix+7)
 423+ 7EA3 3C               inc  a
 424+ 7EA4 E6 03            and  3
 425+ 7EA6 DD 77 07         ld   (ix+7), a
 426+ 7EA9
 427+ 7EA9                  ; 2. Determina se orizzontale o verticale
 428+ 7EA9 DD 7E 00         ld   a, (ix+0)
 429+ 7EAC E6 40            and  $40                       ; Vertical?
 430+ 7EAE C2 F8 7E         jp   nz, .vertical
 431+ 7EB1
 432+ 7EB1              .horizontal:
 433+ 7EB1 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7EB4 FE 01            cp   1
 435+ 7EB6 20 20            jr   nz, .horiz_right
 436+ 7EB8
 437+ 7EB8              .horiz_left:
 438+ 7EB8 DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7EBB D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7EBD DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7EC0 28 08            jr   z, .h_rev_right
 442+ 7EC2 38 06            jr   c, .h_rev_right
 443+ 7EC4 DD 77 02         ld   (ix+2), a
 444+ 7EC7 C3 3C 7F         jp   .next
 445+ 7ECA
 446+ 7ECA              .h_rev_right:
 447+ 7ECA DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7ECD DD 77 02         ld   (ix+2), a
 449+ 7ED0 3E 02            ld   a, 2

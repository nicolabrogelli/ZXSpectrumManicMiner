 161+ 7E46              ; -------------------------------------------------------------------
 162+ 7E46              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7E46              ; -------------------------------------------------------------------
 164+ 7E46              CheckEnemyWillyOverlap:
 165+ 7E46 3A 6D 9A         ld   a, (player_drawn_pos+1)
 166+ 7E49 FE FF            cp   $FF
 167+ 7E4B C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7E4C
 169+ 7E4C                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7E4C 3A 6C 9A         ld   a, (player_drawn_pos)
 171+ 7E4F E6 F8            and  $F8
 172+ 7E51 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7E52 79               ld   a, c
 174+ 7E53 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7E55 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7E56 C6 10            add  a, 16
 177+ 7E58 FE 19            cp   25
 178+ 7E5A D0               ret  nc                 ; Fuori portata X
 179+ 7E5B
 180+ 7E5B                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7E5B 3A 6D 9A         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7E5E 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7E5F C6 0F            add  a, 15
 184+ 7E61 FE 1F            cp   31
 185+ 7E63 D0               ret  nc                 ; Fuori portata Y
 186+ 7E64
 187+ 7E64                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7E64 3E 01            ld   a, 1
 189+ 7E66 32 72 9A         ld   (willy_needs_redraw), a
 190+ 7E69 C9               ret

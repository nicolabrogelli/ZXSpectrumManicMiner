2004+ 7D1F 78               ld   a, b
2005+ 7D20 C6 10            add  a, 16
2006+ 7D22 CB 3F            srl  a
2006+ 7D24 CB 3F          srl  a
2006+ 7D26 CB 3F          srl  a
2007+ 7D28 47               ld   b, a                  ; B = Row
2008+ 7D29
2009+ 7D29 79               ld   a, c
2010+ 7D2A C6 07            add  a, 7
2011+ 7D2C CB 3F            srl  a
2011+ 7D2E CB 3F          srl  a
2011+ 7D30 CB 3F          srl  a   ; A = Col2 (0..31)
2012+ 7D32 4F               ld   c, a                  ; C = Col2
2013+ 7D33
2014+ 7D33                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2015+ 7D33 3A 03 EB         ld   a, (PlayerPos)        ; A = PlayerX
2016+ 7D36 CB 3F            srl  a
2016+ 7D38 CB 3F          srl  a
2016+ 7D3A CB 3F          srl  a   ; A = Col1
2017+ 7D3C B9               cp   c
2018+ 7D3D 28 0B            jr   z, .done_trigger
2019+ 7D3F
2020+ 7D3F 78               ld   a, b
2021+ 7D40 CD 25 7A         call GetCellFromUnpacked
2022+ 7D43 FE 02            cp   2

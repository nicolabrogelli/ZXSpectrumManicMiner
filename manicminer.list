 385+ 7B3F              ; -------------------------------------------------------------------
 386+ 7B3F              ; Enemy_Update
 387+ 7B3F              ;
 388+ 7B3F              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7B3F              ; -------------------------------------------------------------------
 390+ 7B3F              Enemy_Update:
 391+ 7B3F E5               push hl
 392+ 7B40 D5               push de
 393+ 7B41 C5               push bc
 394+ 7B42 DD E5            push ix
 395+ 7B44
 396+ 7B44 3E 01            ld   a, 1
 397+ 7B46 32 B0 91         ld   (enemy_was_updated), a
 398+ 7B49
 399+ 7B49 DD 21 0F 79      ld   ix, ActiveEnemies
 400+ 7B4D 06 08            ld   b, 8                      ; 8 slot
 401+ 7B4F              .loop:
 402+ 7B4F DD 7E 00         ld   a, (ix+0)                 ; Flags
 403+ 7B52 E6 80            and  $80                       ; Active?
 404+ 7B54 CA F3 7B         jp   z, .next
 405+ 7B57
 406+ 7B57                  ; 1. Aggiorna Anim State (0..3)
 407+ 7B57 DD 7E 07         ld   a, (ix+7)
 408+ 7B5A 3C               inc  a
 409+ 7B5B E6 03            and  3
 410+ 7B5D DD 77 07         ld   (ix+7), a
 411+ 7B60
 412+ 7B60                  ; 2. Determina se orizzontale o verticale
 413+ 7B60 DD 7E 00         ld   a, (ix+0)
 414+ 7B63 E6 40            and  $40                       ; Vertical?
 415+ 7B65 C2 AF 7B         jp   nz, .vertical
 416+ 7B68
 417+ 7B68              .horizontal:
 418+ 7B68 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 419+ 7B6B FE 01            cp   1
 420+ 7B6D 20 20            jr   nz, .horiz_right
 421+ 7B6F
 422+ 7B6F              .horiz_left:
 423+ 7B6F DD 7E 02         ld   a, (ix+2)                 ; Current X
 424+ 7B72 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 425+ 7B74 DD BE 04         cp   (ix+4)                    ; Min Limit
 426+ 7B77 28 08            jr   z, .h_rev_right
 427+ 7B79 38 06            jr   c, .h_rev_right
 428+ 7B7B DD 77 02         ld   (ix+2), a
 429+ 7B7E C3 F3 7B         jp   .next
 430+ 7B81
 431+ 7B81              .h_rev_right:
 432+ 7B81 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 433+ 7B84 DD 77 02         ld   (ix+2), a
 434+ 7B87 3E 02            ld   a, 2
 435+ 7B89 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 436+ 7B8C C3 F3 7B         jp   .next
 437+ 7B8F
 438+ 7B8F              .horiz_right:
 439+ 7B8F DD 7E 02         ld   a, (ix+2)                 ; Current X
 440+ 7B92 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 441+ 7B94 DD BE 05         cp   (ix+5)                    ; Max Limit
 442+ 7B97 28 08            jr   z, .h_rev_left
 443+ 7B99 30 06            jr   nc, .h_rev_left
 444+ 7B9B DD 77 02         ld   (ix+2), a
 445+ 7B9E C3 F3 7B         jp   .next

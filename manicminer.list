1006+ 82DD              .guard_ptr_ready:
1007+ 82DD
1008+ 82DD                  ; ---------------------------------------------------------------
1009+ 82DD                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
1010+ 82DD                  ; ---------------------------------------------------------------
1011+ 82DD 3A 50 F0         ld   a, (collision_delta_y)
1012+ 82E0 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
1013+ 82E2 20 12            jr   nz, .willy_higher
1014+ 82E4
1015+ 82E4                  ; Willy lower or equal (DeltaY >= 0):
1016+ 82E4                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
1017+ 82E4 32 51 F0         ld   (row_enemy_cur), a
1018+ 82E7 AF               xor  a
1019+ 82E8 32 52 F0         ld   (row_willy_cur), a
1020+ 82EB 3E 10            ld   a, 16
1021+ 82ED 21 50 F0         ld   hl, collision_delta_y
1022+ 82F0 96               sub  (hl)
1023+ 82F1 32 53 F0         ld   (overlap_num_lines), a
1024+ 82F4 18 12            jr   .check_lines_loop
1025+ 82F6
1026+ 82F6              .willy_higher:
1027+ 82F6                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
1028+ 82F6 ED 44            neg                            ; A = -DeltaY (1..15)
1029+ 82F8 32 52 F0         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
1030+ 82FB AF               xor  a
1031+ 82FC 32 51 F0         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
1032+ 82FF 3E 10            ld   a, 16
1033+ 8301 21 52 F0         ld   hl, row_willy_cur
1034+ 8304 96               sub  (hl)
1035+ 8305 32 53 F0         ld   (overlap_num_lines), a

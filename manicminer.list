 722  8962              ; -------------------------------------------------------------------
 723  8962              ; TriggerPortalTransition
 724  8962              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  8962              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  8962              ; - Avanza all'indice della stanza successiva.
 727  8962              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  8962              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  8962              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  8962              ; -------------------------------------------------------------------
 731  8962              TriggerPortalTransition:
 732  8962                  ; 1. Determina l'ID della stanza corrente
 733  8962 CD CB 82         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  8965
 735  8965                  ; 2. Calcola l'indice della stanza successiva
 736  8965 3A C3 E3         ld   a, (current_room)
 737  8968 3C               inc  a
 738  8969 FE 14            cp   NUM_ROOMS
 739  896B 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  896D
 741  896D                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  896D 21 0A 73         ld   hl, RoomsListTable
 743  8970 5F               ld   e, a
 744  8971 16 00            ld   d, 0
 745  8973 19               add  hl, de
 746  8974 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  8975 5E               ld   e, (hl)
 748  8976 23               inc  hl
 749  8977 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  8978 ED 53 1E E4      ld   (room_ptr), de
 751  897C
 752  897C                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  897C AF               xor  a
 754  897D 32 24 E4         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  8980 32 AB E0         ld   (velocity_y), a
 756  8983 32 B4 E6         ld   (game_objective_completed), a
 757  8986 3E 01            ld   a, 1
 758  8988 32 AC E0         ld   (on_ground), a
 759  898B
 760  898B                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  898B 3E 07            ld   a, $07
 762  898D CD 99 62         call Gfx_ClearScreenDirect
 763  8990
 764  8990 C3 25 86         jp   LoadRoomAndRestart
 765  8993
 766  8993              .all_rooms_completed:
 767  8993                  ; Tutte le stanze sono state completate con successo!
 768  8993                  IF ENABLE_VICTORY_SCREEN != 0
 769  8993 C3 8A 88         jp   TriggerVictory
 770  8996                  ELSE
 771  8996 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  8996 ~                ld   de, (RoomsListTable)
 773  8996 ~                ld   (room_ptr), de
 774  8996 ~                xor  a
 775  8996 ~                ld   (transition_active), a
 776  8996 ~                ld   (velocity_y), a
 777  8996 ~                ld   (game_objective_completed), a
 778  8996 ~                ld   a, 1
 779  8996 ~                ld   (on_ground), a
 780  8996 ~                ld   a, $07
 781  8996 ~                call Gfx_ClearScreenDirect
 782  8996 ~                jp   LoadRoomAndRestart
 783  8996                  ENDIF

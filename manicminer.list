 414+ 862E              ; CheckWillyItemCollision
 415+ 862E              ;
 416+ 862E              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 862E              ; Input:
 418+ 862E              ;   A = Item Col (0..31)
 419+ 862E              ;   H = Item Row (0..15)
 420+ 862E              ; Output:
 421+ 862E              ;   Carry Set = Collisione
 422+ 862E              ;   Carry Clear = Nessuna collisione
 423+ 862E              ; -------------------------------------------------------------------
 424+ 862E              CheckWillyItemCollision:
 425+ 862E C5               push bc
 426+ 862F D5               push de
 427+ 8630 E5               push hl
 428+ 8631
 429+ 8631                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8631 6F               ld   l, a
 431+ 8632 87               add  a, a                      ; *2
 432+ 8633 87               add  a, a                      ; *4
 433+ 8634 87               add  a, a                      ; *8
 434+ 8635 5F               ld   e, a                      ; E = ItemLeft
 435+ 8636 C6 07            add  a, 7
 436+ 8638 57               ld   d, a                      ; D = ItemRight
 437+ 8639
 438+ 8639 ED 4B 49 EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 863D
 440+ 863D                  ; WillyLeft <= ItemRight
 441+ 863D 79               ld   a, c                      ; A = WillyX
 442+ 863E BA               cp   d                         ; D = ItemRight
 443+ 863F 28 04            jr   z, .x_ok
 444+ 8641 38 02            jr   c, .x_ok
 445+ 8643 18 31            jr   .no_collision
 446+ 8645
 447+ 8645              .x_ok:
 448+ 8645                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8645 BB               cp   e                         ; E = ItemLeft
 450+ 8646 28 0B            jr   z, .y_check
 451+ 8648 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 864A
 453+ 864A                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 864A C6 0F            add  a, 15
 455+ 864C BB               cp   e
 456+ 864D 28 04            jr   z, .y_check
 457+ 864F 30 02            jr   nc, .y_check
 458+ 8651 18 23            jr   .no_collision
 459+ 8653
 460+ 8653              .y_check:
 461+ 8653                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 8653 7C               ld   a, h                      ; H = Item Row
 463+ 8654 87               add  a, a                      ; *2
 464+ 8655 87               add  a, a                      ; *4
 465+ 8656 87               add  a, a                      ; *8
 466+ 8657 5F               ld   e, a                      ; E = ItemTop
 467+ 8658 C6 07            add  a, 7
 468+ 865A 57               ld   d, a                      ; D = ItemBottom
 469+ 865B
 470+ 865B                  ; WillyTop <= ItemBottom
 471+ 865B 78               ld   a, b                      ; A = WillyY
 472+ 865C BA               cp   d                         ; D = ItemBottom
 473+ 865D 28 04            jr   z, .y_ok
 474+ 865F 38 02            jr   c, .y_ok
 475+ 8661 18 13            jr   .no_collision
 476+ 8663
 477+ 8663              .y_ok:
 478+ 8663                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 8663 BB               cp   e                         ; E = ItemTop
 480+ 8664 28 0B            jr   z, .collision
 481+ 8666 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8668
 483+ 8668                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8668 C6 0F            add  a, 15
 485+ 866A BB               cp   e
 486+ 866B 28 04            jr   z, .collision
 487+ 866D 30 02            jr   nc, .collision
 488+ 866F 18 05            jr   .no_collision

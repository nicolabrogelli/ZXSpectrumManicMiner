2113+ 7CA9              ; -------------------------------------------------------------------
2114+ 7CA9              ; Phys_UpdateAir
2115+ 7CA9              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2116+ 7CA9              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2117+ 7CA9              ; Output:
2118+ 7CA9              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2119+ 7CA9              ;   Carry Clear = Aria ancora disponibile
2120+ 7CA9              ; -------------------------------------------------------------------
2121+ 7CA9              Phys_UpdateAir:
2122+ 7CA9                  ; Incrementa il timer dei frame
2123+ 7CA9 3A 27 9C         ld   a, (air_timer)
2124+ 7CAC 3C               inc  a
2125+ 7CAD 32 27 9C         ld   (air_timer), a
2126+ 7CB0 21 28 9C         ld   hl, air_deplete_rate
2127+ 7CB3 BE               cp   (hl)
2128+ 7CB4 38 14            jr   c, .no_deplete
2129+ 7CB6
2130+ 7CB6                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2131+ 7CB6 AF               xor  a
2132+ 7CB7 32 27 9C         ld   (air_timer), a
2133+ 7CBA
2134+ 7CBA 3A 26 9C         ld   a, (air_pixels)
2135+ 7CBD B7               or   a
2136+ 7CBE 28 0C            jr   z, .air_finished
2137+ 7CC0
2138+ 7CC0 3D               dec  a
2139+ 7CC1 32 26 9C         ld   (air_pixels), a
2140+ 7CC4 CD 6C 6A         call Gfx_UpdateAirBar
2141+ 7CC7
2142+ 7CC7 B7               or   a
2143+ 7CC8 28 02            jr   z, .air_finished
2144+ 7CCA
2145+ 7CCA              .no_deplete:
2146+ 7CCA B7               or   a                     ; Carry Clear = Ok
2147+ 7CCB C9               ret
2148+ 7CCC
2149+ 7CCC              .air_finished:
2150+ 7CCC 37               scf                        ; Carry Set = Morte per esaurimento aria
2151+ 7CCD C9               ret

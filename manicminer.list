 829  83EF              ResetFullGameState:
 830  83EF                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 831  83EF AF               xor  a
 832  83F0 D3 FE            out  ($fe), a              ; Bordo a nero
 833  83F2 21 8D 5C         ld   hl, ATTR_P

 216+ 7DC6              ; -------------------------------------------------------------------
 217+ 7DC6              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 218+ 7DC6              ; -------------------------------------------------------------------
 219+ 7DC6              CheckEnemyWillyOverlap:
 220+ 7DC6 3A 19 E3         ld   a, (player_drawn_pos+1)
 221+ 7DC9 FE FF            cp   $FF
 222+ 7DCB C8               ret  z                  ; Se Willy non è disegnato, esci
 223+ 7DCC
 224+ 7DCC                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 225+ 7DCC 3A 18 E3         ld   a, (player_drawn_pos)
 226+ 7DCF E6 F8            and  $F8
 227+ 7DD1 5F               ld   e, a               ; E = WillyX & $F8
 228+ 7DD2 79               ld   a, c
 229+ 7DD3 E6 F8            and  $F8                ; A = EnemyX & $F8
 230+ 7DD5 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 231+ 7DD6 C6 10            add  a, 16
 232+ 7DD8 FE 19            cp   25
 233+ 7DDA D0               ret  nc                 ; Fuori portata X
 234+ 7DDB
 235+ 7DDB                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 236+ 7DDB 3A 19 E3         ld   a, (player_drawn_pos+1) ; A = WillyY
 237+ 7DDE 90               sub  b                  ; A = WillyY - EnemyY
 238+ 7DDF C6 0F            add  a, 15
 239+ 7DE1 FE 1F            cp   31
 240+ 7DE3 D0               ret  nc                 ; Fuori portata Y

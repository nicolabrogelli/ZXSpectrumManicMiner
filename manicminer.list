 451+ 7F7A C3 E1 7F         jp   .next
 452+ 7F7D
 453+ 7F7D              .horiz_right:
 454+ 7F7D DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7F80 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7F82 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7F85 28 08            jr   z, .h_rev_left
 458+ 7F87 30 06            jr   nc, .h_rev_left
 459+ 7F89 DD 77 02         ld   (ix+2), a
 460+ 7F8C C3 E1 7F         jp   .next

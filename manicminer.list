 452  8559 C3 9F 84         jp   ShowTitleScreen
 453  855C
 454  855C              .continue_chosen:
 455  855C                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 456  855C              .wait_continue_release:
 457  855C 76               halt
 458  855D 01 FE DF         ld   bc, $dffe
 459  8560 ED 78            in   a, (c)
 460  8562 CB 67            bit  4, a
 461  8564 28 F6            jr   z, .wait_continue_release
 462  8566
 463  8566                  ; 5b. Ripristina lo stato per continuare la partita:
 464  8566                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 465  8566 CD 6B 80         call Items_ResetCurrentRoomItems
 466  8569
 467  8569                  ; - Ripristina le vite di Willy al valore iniziale
 468  8569 3E 07            ld   a, INITIAL_LIVES
 469  856B 32 0F 9A         ld   (willy_lives), a
 470  856E
 471  856E                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 472  856E 2A 23 9A         ld   hl, (counter)
 473  8571 22 26 9A         ld   (last_frame_counter), hl
 474  8574
 475  8574                  ; - Reimposta la fisica e le variabili di stato di Willy
 476  8574 AF               xor  a
 477  8575 32 10 9A         ld   (velocity_y), a
 478  8578 32 12 9A         ld   (jump_pressed), a
 479  857B 32 14 9A         ld   (coyote_timer), a
 480  857E 32 17 9A         ld   (jump_frame), a
 481  8581 32 16 9A         ld   (jump_dir), a
 482  8584 32 08 9A         ld   (body_state), a
 483  8587 32 1B 9A         ld   (w_warp_state), a
 484  858A 32 1E 9A         ld   (w_key_prev), a
 485  858D 32 1F 9A         ld   (enter_key_prev), a
 486  8590 32 0B 9A         ld   (collision_active), a
 487  8593 32 0A 9A         ld   (flags), a
 488  8596 32 03 9E         ld   (ramp_entry_guard), a
 489  8599 32 0E 9E         ld   (willy_on_ramp), a
 490  859C 32 0D 9E         ld   (willy_needs_redraw), a
 491  859F 3E FF            ld   a, $ff
 492  85A1 32 20 9A         ld   (digit_key_prev), a
 493  85A4 32 08 9E         ld   (player_drawn_pos+1), a
 494  85A7 32 09 9E         ld   (player_old_dir), a
 495  85AA 32 0A 9E         ld   (player_old_body), a
 496  85AD 3E 01            ld   a, 1
 497  85AF 32 19 9A         ld   (q_prev), a
 498  85B2 32 1A 9A         ld   (a_prev), a
 499  85B5 32 11 9A         ld   (on_ground), a
 500  85B8 32 0B 9E         ld   (enemy_was_updated), a
 501  85BB
 502  85BB                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 503  85BB 3E 00            ld   a, RESPAWN_SAFETY_TIME
 504  85BD 32 0C 9E         ld   (willy_safety_timer), a
 505  85C0
 506  85C0                  ; - Ripristina lo stato audio
 507  85C0 3E 12            ld   a, 18
 508  85C2 32 1B A0         ld   (Audio_jump_sound_note), a
 509  85C5 AF               xor  a
 510  85C6 32 1C A0         ld   (Audio_jump_sound_timer), a
 511  85C9                  IF ENABLE_MUSIC != 0
 512  85C9 ~                ld   (Audio_music_note_idx), a
 513  85C9 ~                ld   a, 1
 514  85C9 ~                ld   (Audio_music_frame_counter), a
 515  85C9                  ENDIF
 516  85C9
 517  85C9                  ; - Riposiziona Willy nel punto di default definito nella stanza
 518  85C9 AF               xor  a
 519  85CA 32 88 9D         ld   (transition_active), a
 520  85CD
 521  85CD                  ; - Cancella lo schermo a nero prima del caricamento
 522  85CD AF               xor  a
 523  85CE D3 FE            out  ($fe), a
 524  85D0 21 8D 5C         ld   hl, ATTR_P
 525  85D3 77               ld   (hl), a
 526  85D4 CD AF 0D         call CLS
 527  85D7 36 07            ld   (hl), $07
 528  85D9 3E 07            ld   a, $07
 529  85DB 32 8F 5C         ld   (ATTR_T), a
 530  85DE
 531  85DE                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 532  85DE C3 70 83         jp   LoadRoomAndRestart
 533  85E1
 534  85E1              ; -------------------------------------------------------------------
 535  85E1              ; TriggerVictory
 536  85E1              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 537  85E1              ; - Pulisce gli elementi di gioco della stanza.
 538  85E1              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 539  85E1              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 540  85E1              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 541  85E1              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 542  85E1              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 543  85E1              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 544  85E1              ; -------------------------------------------------------------------
 545  85E1              TriggerVictory:
 546  85E1                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 547  85E1 CD DC 66         call Gfx_DrawVictoryScreen
 548  85E4
 549  85E4                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 550  85E4              .wait_keys_release:
 551  85E4 76               halt
 552  85E5                  ; Controlla tasto Y (Porta $DF, bit 4)
 553  85E5 01 FE DF         ld   bc, $dffe
 554  85E8 ED 78            in   a, (c)
 555  85EA CB 67            bit  4, a
 556  85EC 28 F6            jr   z, .wait_keys_release
 557  85EE
 558  85EE                  ; Controlla tasto N (Porta $7F, bit 3)
 559  85EE 01 FE 7F         ld   bc, $7ffe
 560  85F1 ED 78            in   a, (c)
 561  85F3 CB 5F            bit  3, a
 562  85F5 28 ED            jr   z, .wait_keys_release
 563  85F7
 564  85F7                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 565  85F7 01 FE BF         ld   bc, $bffe
 566  85FA ED 78            in   a, (c)
 567  85FC CB 47            bit  0, a
 568  85FE 28 E4            jr   z, .wait_keys_release
 569  8600
 570  8600                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 571  8600 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 572  8602              .wait_choice_loop:
 573  8602 76               halt
 574  8603
 575  8603                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 576  8603 0C               inc  c
 577  8604 79               ld   a, c
 578  8605 CB 3F            srl  a
 579  8607 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 580  8609 E6 07            and  7
 581  860B 5F               ld   e, a
 582  860C 16 00            ld   d, 0
 583  860E 21 BB 65         ld   hl, victory_color_table
 584  8611 19               add  hl, de
 585  8612 7E               ld   a, (hl)               ; A = nuovo colore attributo
 586  8613 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 587  8616 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 588  8618              .color_cycle_loop:
 589  8618 77               ld   (hl), a
 590  8619 23               inc  hl
 591  861A 10 FC            djnz .color_cycle_loop
 592  861C
 593  861C                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 594  861C 01 FE DF         ld   bc, $dffe
 595  861F ED 78            in   a, (c)
 596  8621 CB 67            bit  4, a
 597  8623 28 2A            jr   z, .play_again_chosen
 598  8625
 599  8625                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 600  8625 01 FE 7F         ld   bc, $7ffe
 601  8628 ED 78            in   a, (c)
 602  862A CB 5F            bit  3, a
 603  862C 28 0B            jr   z, .quit_chosen
 604  862E
 605  862E                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 606  862E 01 FE BF         ld   bc, $bffe
 607  8631 ED 78            in   a, (c)
 608  8633 CB 47            bit  0, a
 609  8635 28 02            jr   z, .quit_chosen
 610  8637
 611  8637 18 C9            jr   .wait_choice_loop
 612  8639
 613  8639              .quit_chosen:
 614  8639                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 615  8639              .wait_quit_release:
 616  8639 76               halt
 617  863A 01 FE 7F         ld   bc, $7ffe
 618  863D ED 78            in   a, (c)
 619  863F CB 5F            bit  3, a
 620  8641 28 F6            jr   z, .wait_quit_release
 621  8643 01 FE BF         ld   bc, $bffe
 622  8646 ED 78            in   a, (c)
 623  8648 CB 47            bit  0, a
 624  864A 28 ED            jr   z, .wait_quit_release
 625  864C
 626  864C                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 627  864C C3 9F 84         jp   ShowTitleScreen
 628  864F
 629  864F              .play_again_chosen:
 630  864F                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 631  864F              .wait_play_again_release:
 632  864F 76               halt
 633  8650 01 FE DF         ld   bc, $dffe
 634  8653 ED 78            in   a, (c)
 635  8655 CB 67            bit  4, a
 636  8657 28 F6            jr   z, .wait_play_again_release
 637  8659
 638  8659                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 639  8659 CD 5D 87         call ResetFullGameState
 640  865C C3 70 83         jp   LoadRoomAndRestart
 641  865F
 642  865F              ; -------------------------------------------------------------------
 643  865F              ; CheckPortalTransition
 644  865F              ; Verifica le condizioni per accedere alla stanza successiva:
 645  865F              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 646  865F              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 647  865F              ;
 648  865F              ; Output:
 649  865F              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 650  865F              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 651  865F              ; -------------------------------------------------------------------
 652  865F              CheckPortalTransition:
 653  865F C5               push bc
 654  8660 D5               push de
 655  8661 E5               push hl
 656  8662
 657  8662                  ; 1. Tutti gli item della stanza sono stati raccolti?
 658  8662 CD F0 86         call CheckAllItemsCollected
 659  8665 30 4D            jr   nc, .no_transition
 660  8667
 661  8667                  ; 2. Willy collide con il portale (16x16 pixel)?
 662  8667                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 663  8667                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 664  8667 2A 82 9D         ld   hl, (room_ptr)
 665  866A 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 666  866D 19               add  hl, de
 667  866E 4E               ld   c, (hl)
 668  866F 23               inc  hl
 669  8670 46               ld   b, (hl)                   ; BC = AttrAddr
 670  8671
 671  8671                  ; Offset = BC - 23552
 672  8671 60               ld   h, b
 673  8672 69               ld   l, c
 674  8673 01 00 A4         ld   bc, -23552
 675  8676 09               add  hl, bc
 676  8677
 677  8677                  ; PortalX = (Offset & 31) * 8
 678  8677 7D               ld   a, l
 679  8678 E6 1F            and  31
 680  867A 87               add  a, a
 680  867B 87             add a, a
 680  867C 87             add a, a
 681  867D 5F               ld   e, a                      ; E = PortalX (0..248)
 682  867E
 683  867E                  ; PortalY = (Offset / 32) * 8
 684  867E CB 3C            srl  h
 684  8680 CB 1D          rr l
 685  8682 CB 3C            srl  h
 685  8684 CB 1D          rr l
 686  8686 CB 3C            srl  h
 686  8688 CB 1D          rr l
 687  868A CB 3C            srl  h
 687  868C CB 1D          rr l
 688  868E CB 3C            srl  h
 688  8690 CB 1D          rr l
 689  8692 7D               ld   a, l
 690  8693 87               add  a, a
 690  8694 87             add a, a
 690  8695 87             add a, a
 691  8696 57               ld   d, a                      ; D = PortalY (0..120)
 692  8697
 693  8697                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 694  8697 ED 4B 02 9A      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 695  869B
 696  869B                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 697  869B 7B               ld   a, e
 698  869C 91               sub  c
 699  869D 30 02            jr   nc, .x_diff_pos
 700  869F ED 44            neg
 701  86A1              .x_diff_pos:
 702  86A1 FE 0C            cp   12
 703  86A3 30 0F            jr   nc, .no_transition
 704  86A5
 705  86A5                  ; Controllo verticale: |WillyY - PortalY| < 14
 706  86A5 7A               ld   a, d
 707  86A6 90               sub  b
 708  86A7 30 02            jr   nc, .y_diff_pos
 709  86A9 ED 44            neg
 710  86AB              .y_diff_pos:
 711  86AB FE 0E            cp   14
 712  86AD 30 05            jr   nc, .no_transition
 713  86AF
 714  86AF                  ; Transizione al portale attiva!
 715  86AF E1               pop  hl
 716  86B0 D1               pop  de
 717  86B1 C1               pop  bc
 718  86B2 37               scf
 719  86B3 C9               ret
 720  86B4
 721  86B4              .no_transition:
 722  86B4 E1               pop  hl
 723  86B5 D1               pop  de
 724  86B6 C1               pop  bc
 725  86B7 B7               or   a
 726  86B8 C9               ret
 727  86B9
 728  86B9              ; Alias per retrocompatibilità
 729  86B9              CheckVictoryCondition: EQU CheckPortalTransition
 730  86B9
 731  86B9              ; -------------------------------------------------------------------
 732  86B9              ; TriggerPortalTransition
 733  86B9              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 734  86B9              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 735  86B9              ; - Avanza all'indice della stanza successiva.
 736  86B9              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 737  86B9              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 738  86B9              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 739  86B9              ; -------------------------------------------------------------------
 740  86B9              TriggerPortalTransition:
 741  86B9                  ; 1. Determina l'ID della stanza corrente
 742  86B9 CD 1C 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 743  86BC
 744  86BC                  ; 2. Calcola l'indice della stanza successiva
 745  86BC 3A 28 9D         ld   a, (current_room)
 746  86BF 3C               inc  a
 747  86C0 FE 03            cp   NUM_ROOMS
 748  86C2 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 749  86C4
 750  86C4                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 751  86C4 21 04 73         ld   hl, RoomsListTable
 752  86C7 5F               ld   e, a
 753  86C8 16 00            ld   d, 0
 754  86CA 19               add  hl, de
 755  86CB 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 756  86CC 5E               ld   e, (hl)
 757  86CD 23               inc  hl
 758  86CE 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 759  86CF ED 53 82 9D      ld   (room_ptr), de
 760  86D3
 761  86D3                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 762  86D3 AF               xor  a
 763  86D4 32 88 9D         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 764  86D7 32 10 9A         ld   (velocity_y), a
 765  86DA 32 17 A0         ld   (game_objective_completed), a
 766  86DD 3E 01            ld   a, 1
 767  86DF 32 11 9A         ld   (on_ground), a
 768  86E2
 769  86E2                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 770  86E2 21 8D 5C         ld   hl, ATTR_P
 771  86E5 36 07            ld   (hl), $07

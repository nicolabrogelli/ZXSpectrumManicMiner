 414+ 854A              ; CheckWillyItemCollision
 415+ 854A              ;
 416+ 854A              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 854A              ; Input:
 418+ 854A              ;   A = Item Col (0..31)
 419+ 854A              ;   H = Item Row (0..15)
 420+ 854A              ; Output:
 421+ 854A              ;   Carry Set = Collisione
 422+ 854A              ;   Carry Clear = Nessuna collisione
 423+ 854A              ; -------------------------------------------------------------------
 424+ 854A              CheckWillyItemCollision:
 425+ 854A C5               push bc
 426+ 854B D5               push de
 427+ 854C E5               push hl
 428+ 854D
 429+ 854D                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 854D 6F               ld   l, a
 431+ 854E 87               add  a, a                      ; *2
 432+ 854F 87               add  a, a                      ; *4
 433+ 8550 87               add  a, a                      ; *8
 434+ 8551 5F               ld   e, a                      ; E = ItemLeft
 435+ 8552 C6 07            add  a, 7
 436+ 8554 57               ld   d, a                      ; D = ItemRight
 437+ 8555
 438+ 8555 ED 4B 8A E1      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 8559
 440+ 8559                  ; WillyLeft <= ItemRight
 441+ 8559 79               ld   a, c                      ; A = WillyX
 442+ 855A BA               cp   d                         ; D = ItemRight
 443+ 855B 28 04            jr   z, .x_ok
 444+ 855D 38 02            jr   c, .x_ok
 445+ 855F 18 31            jr   .no_collision
 446+ 8561
 447+ 8561              .x_ok:
 448+ 8561                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8561 BB               cp   e                         ; E = ItemLeft
 450+ 8562 28 0B            jr   z, .y_check
 451+ 8564 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8566
 453+ 8566                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft

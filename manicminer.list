 473  82FF 32 99 93         ld   (jump_pressed), a
 474  8302 32 9B 93         ld   (coyote_timer), a
 475  8305 32 9E 93         ld   (jump_frame), a
 476  8308 32 9D 93         ld   (jump_dir), a
 477  830B 32 8F 93         ld   (body_state), a

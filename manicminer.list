 848+ 773F              ; -------------------------------------------------------------------
 849+ 773F              IsCellOnRamp:
 850+ 773F C5               push bc
 851+ 7740 E5               push hl
 852+ 7741
 853+ 7741 3A 0B CA         ld   a, (ramp_len)
 854+ 7744 B7               or   a
 855+ 7745 28 6B            jr   z, .no
 856+ 7747
 857+ 7747                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 858+ 7747 3A 0A CA         ld   a, (ramp_dir)
 859+ 774A B7               or   a
 860+ 774B 28 1A            jr   z, .range_left
 861+ 774D              .range_right:
 862+ 774D 3A 0D CA         ld   a, (ramp_col)
 863+ 7750 47               ld   b, a              ; B = ramp_col
 864+ 7751 3A 0B CA         ld   a, (ramp_len)
 865+ 7754 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 7755 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7756
 868+ 7756 7B               ld   a, e              ; A = Col
 869+ 7757 B8               cp   b
 870+ 7758 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 775A B9               cp   c
 872+ 775B 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 775D
 874+ 775D                  ; Calcola B = Col - ramp_col
 875+ 775D 7B               ld   a, e
 876+ 775E 90               sub  b
 877+ 775F 47               ld   b, a              ; B = offset (0..ramp_len-1)
 878+ 7760
 879+ 7760                  ; SlopeRow = ramp_row - B
 880+ 7760 3A 0C CA         ld   a, (ramp_row)
 881+ 7763 90               sub  b
 882+ 7764 47               ld   b, a              ; B = SlopeRow
 883+ 7765 18 1F            jr   .check_row_match

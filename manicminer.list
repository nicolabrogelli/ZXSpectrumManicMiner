 257  8505 C3 F1 83         jp   LoadRoomAndRestart
 258  8508
 259  8508              .draw_raster_bars:
 260  8508                  ; Collisione attiva: disegna le raster bar nel bordo
 261  8508 3A 8A AA         ld   a, (counter)
 262  850B E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 263  850D 06 1E            ld   b, 30             ; Numero di righe della barra raster
 264  850F              .raster_loop:
 265  850F D3 FE            out  ($fe), a
 266  8511 3C               inc  a
 267  8512 E6 07            and  7
 268  8514 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 269  8516              .delay:
 270  8516 0D               dec  c
 271  8517 20 FD            jr   nz, .delay
 272  8519 10 F4            djnz .raster_loop
 273  851B
 274  851B                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 275  851B 3A 75 AA         ld   a, (room_border_color)
 276  851E D3 FE            out  ($fe), a
 277  8520 18 05            jr   .no_collision_change

   8+ 86D1              ; Audio_UpdateJumpSound
   9+ 86D1              ;
  10+ 86D1              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 86D1              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 86D1              ; -------------------------------------------------------------------
  13+ 86D1              Audio_UpdateJumpSound:
  14+ 86D1 F5               push af
  15+ 86D2 C5               push bc
  16+ 86D3 D5               push de
  17+ 86D4 E5               push hl
  18+ 86D5
  19+ 86D5                  ; Controlla se il suono è attivo (note < 18)
  20+ 86D5 3A 31 E8         ld   a, (Audio_jump_sound_note)
  21+ 86D8 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86DA 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86DC
  24+ 86DC                  ; Carica la nota corrente da suonare
  25+ 86DC 5F               ld   e, a
  26+ 86DD 16 00            ld   d, 0
  27+ 86DF 21 0B 87         ld   hl, Audio_JumpSoundDelays
  28+ 86E2 19               add  hl, de
  29+ 86E3 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86E4 57               ld   d, a                      ; D = delay della nota
  31+ 86E5
  32+ 86E5                  ; Suona la nota: 15 cicli
  33+ 86E5 06 0F            ld   b, 15
  34+ 86E7              .note_loop:
  35+ 86E7                  ; Speaker ON
  36+ 86E7 3A 1E E2         ld   a, (room_border_color)
  37+ 86EA F6 10            or   $10
  38+ 86EC D3 FE            out  ($fe), a
  39+ 86EE 4A               ld   c, d
  40+ 86EF              .d1:
  41+ 86EF 0D               dec  c
  42+ 86F0 20 FD            jr   nz, .d1
  43+ 86F2
  44+ 86F2                  ; Speaker OFF
  45+ 86F2 3A 1E E2         ld   a, (room_border_color)
  46+ 86F5 E6 EF            and  $ef
  47+ 86F7 D3 FE            out  ($fe), a
  48+ 86F9 4A               ld   c, d
  49+ 86FA              .d2:
  50+ 86FA 0D               dec  c
  51+ 86FB 20 FD            jr   nz, .d2
  52+ 86FD
  53+ 86FD 10 E8            djnz .note_loop
  54+ 86FF
  55+ 86FF                  ; Passa alla nota successiva
  56+ 86FF 3A 31 E8         ld   a, (Audio_jump_sound_note)
  57+ 8702 3C               inc  a
  58+ 8703 32 31 E8         ld   (Audio_jump_sound_note), a
  59+ 8706
  60+ 8706              .done:
  61+ 8706 E1               pop  hl
  62+ 8707 D1               pop  de
  63+ 8708 C1               pop  bc
  64+ 8709 F1               pop  af
  65+ 870A C9               ret

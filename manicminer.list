 987+ 787A              ; -------------------------------------------------------------------
 988+ 787A              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 989+ 787A              ; Input: C = X, B = Y
 990+ 787A              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 991+ 787A              ; -------------------------------------------------------------------
 992+ 787A              CheckWallCell:
 993+ 787A E5               push hl
 994+ 787B D5               push de
 995+ 787C C5               push bc
 996+ 787D
 997+ 787D                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 998+ 787D 78               ld   a, b
 999+ 787E FE 80            cp   128
1000+ 7880 30 1F            jr   nc, .not_wall
1001+ 7882
1002+ 7882                  ; 2. Calcola riga di layout: r = Y / 8
1003+ 7882 CB 3F            srl  a
1004+ 7884 CB 3F            srl  a
1005+ 7886 CB 3F            srl  a                 ; A = r (0..15)
1006+ 7888
1007+ 7888                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1008+ 7888 5F               ld   e, a              ; E = r (Row)
1009+ 7889 79               ld   a, c
1010+ 788A CB 3F            srl  a
1011+ 788C CB 3F            srl  a
1012+ 788E CB 3F            srl  a                 ; A = c (0..31)
1013+ 7890 4F               ld   c, a              ; C = c (Col)
1014+ 7891
1015+ 7891                  ; Se la cella è sulla rampa, non considerarla un muro!
1016+ 7891 53               ld   d, e              ; D = Row
1017+ 7892 59               ld   e, c              ; E = Col
1018+ 7893 CD FF 77         call IsCellOnRamp
1019+ 7896 38 09            jr   c, .not_wall
1020+ 7898
1021+ 7898 7A               ld   a, d              ; A = Row
1022+ 7899 4B               ld   c, e              ; C = Col
1023+ 789A CD 36 79         call GetCellFromUnpacked ; A = cell type
1024+ 789D
1025+ 789D                  ; Controlla se è Wall (3)
1026+ 789D FE 03            cp   3
1027+ 789F 28 05            jr   z, .is_wall
1028+ 78A1
1029+ 78A1              .not_wall:
1030+ 78A1 C1               pop  bc
1031+ 78A2 D1               pop  de
1032+ 78A3 E1               pop  hl
1033+ 78A4 B7               or   a                 ; Clear carry
1034+ 78A5 C9               ret
1035+ 78A6
1036+ 78A6              .is_wall:
1037+ 78A6 C1               pop  bc
1038+ 78A7 D1               pop  de
1039+ 78A8 E1               pop  hl
1040+ 78A9 37               scf                    ; Set carry
1041+ 78AA C9               ret

 372  85D3 76               halt
 373  85D4                  ; Controlla tasto Y (Porta $DF, bit 4)
 374  85D4 01 FE DF         ld   bc, $dffe
 375  85D7 ED 78            in   a, (c)
 376  85D9 CB 67            bit  4, a
 377  85DB 28 F6            jr   z, .wait_keys_release
 378  85DD
 379  85DD                  ; Controlla tasto N (Porta $7F, bit 3)

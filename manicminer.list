 671+ 8398 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 839A
 673+ 839A                  ; Byte 1:
 674+ 839A 3A DC B8         ld   a, (player_score + 1)
 675+ 839D 47               ld   b, a
 676+ 839E 3A DF B8         ld   a, (high_score + 1)
 677+ 83A1 B8               cp   b
 678+ 83A2 38 0C            jr   c, .new_high_score
 679+ 83A4 20 1C            jr   nz, .done_check
 680+ 83A6
 681+ 83A6                  ; Byte 0:
 682+ 83A6 3A DB B8         ld   a, (player_score + 0)
 683+ 83A9 47               ld   b, a
 684+ 83AA 3A DE B8         ld   a, (high_score + 0)
 685+ 83AD B8               cp   b
 686+ 83AE 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 83B0
 688+ 83B0              .new_high_score:
 689+ 83B0 3A DB B8         ld   a, (player_score + 0)
 690+ 83B3 32 DE B8         ld   (high_score + 0), a
 691+ 83B6 3A DC B8         ld   a, (player_score + 1)
 692+ 83B9 32 DF B8         ld   (high_score + 1), a
 693+ 83BC 3A DD B8         ld   a, (player_score + 2)
 694+ 83BF 32 E0 B8         ld   (high_score + 2), a

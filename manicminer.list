 520  81BC              ; -------------------------------------------------------------------
 521  81BC              ; TriggerVictory
 522  81BC              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 523  81BC              ; - Pulisce gli elementi di gioco della stanza.
 524  81BC              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 525  81BC              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 526  81BC              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 527  81BC              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 528  81BC              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 529  81BC              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 530  81BC              ; -------------------------------------------------------------------
 531  81BC              TriggerVictory:
 532  81BC                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 533  81BC CD 63 65         call Gfx_DrawVictoryScreen
 534  81BF
 535  81BF                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 536  81BF              .wait_keys_release:
 537  81BF 76               halt
 538  81C0                  ; Controlla tasto Y (Porta $DF, bit 4)
 539  81C0 01 FE DF         ld   bc, $dffe
 540  81C3 ED 78            in   a, (c)
 541  81C5 CB 67            bit  4, a
 542  81C7 28 F6            jr   z, .wait_keys_release
 543  81C9
 544  81C9                  ; Controlla tasto N (Porta $7F, bit 3)
 545  81C9 01 FE 7F         ld   bc, $7ffe
 546  81CC ED 78            in   a, (c)
 547  81CE CB 5F            bit  3, a
 548  81D0 28 ED            jr   z, .wait_keys_release
 549  81D2
 550  81D2                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 551  81D2 01 FE BF         ld   bc, $bffe
 552  81D5 ED 78            in   a, (c)
 553  81D7 CB 47            bit  0, a
 554  81D9 28 E4            jr   z, .wait_keys_release
 555  81DB
 556  81DB                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 557  81DB 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 558  81DD              .wait_choice_loop:
 559  81DD 76               halt
 560  81DE
 561  81DE                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 562  81DE 0C               inc  c
 563  81DF 79               ld   a, c
 564  81E0 CB 3F            srl  a
 565  81E2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 566  81E4 E6 07            and  7
 567  81E6 5F               ld   e, a
 568  81E7 16 00            ld   d, 0
 569  81E9 21 42 64         ld   hl, victory_color_table
 570  81EC 19               add  hl, de
 571  81ED 7E               ld   a, (hl)               ; A = nuovo colore attributo
 572  81EE 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 573  81F1 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 574  81F3              .color_cycle_loop:
 575  81F3 77               ld   (hl), a
 576  81F4 23               inc  hl
 577  81F5 10 FC            djnz .color_cycle_loop
 578  81F7
 579  81F7                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 580  81F7 01 FE DF         ld   bc, $dffe
 581  81FA ED 78            in   a, (c)
 582  81FC CB 67            bit  4, a
 583  81FE 28 2A            jr   z, .play_again_chosen
 584  8200
 585  8200                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 586  8200 01 FE 7F         ld   bc, $7ffe
 587  8203 ED 78            in   a, (c)
 588  8205 CB 5F            bit  3, a
 589  8207 28 0B            jr   z, .quit_chosen
 590  8209
 591  8209                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 592  8209 01 FE BF         ld   bc, $bffe
 593  820C ED 78            in   a, (c)
 594  820E CB 47            bit  0, a
 595  8210 28 02            jr   z, .quit_chosen
 596  8212
 597  8212 18 C9            jr   .wait_choice_loop
 598  8214
 599  8214              .quit_chosen:
 600  8214                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 601  8214              .wait_quit_release:
 602  8214 76               halt
 603  8215 01 FE 7F         ld   bc, $7ffe
 604  8218 ED 78            in   a, (c)
 605  821A CB 5F            bit  3, a
 606  821C 28 F6            jr   z, .wait_quit_release
 607  821E 01 FE BF         ld   bc, $bffe
 608  8221 ED 78            in   a, (c)
 609  8223 CB 47            bit  0, a
 610  8225 28 ED            jr   z, .wait_quit_release
 611  8227
 612  8227                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 613  8227 C3 7D 80         jp   ShowTitleScreen
 614  822A
 615  822A              .play_again_chosen:
 616  822A                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 617  822A              .wait_play_again_release:
 618  822A 76               halt
 619  822B 01 FE DF         ld   bc, $dffe
 620  822E ED 78            in   a, (c)
 621  8230 CB 67            bit  4, a
 622  8232 28 F6            jr   z, .wait_play_again_release
 623  8234
 624  8234                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 625  8234 CD 02 83         call ResetFullGameState
 626  8237 C3 63 7F         jp   LoadRoomAndRestart
 627  823A
 628  823A              ; -------------------------------------------------------------------
 629  823A              ; CheckVictoryCondition
 630  823A              ; Verifica le condizioni di completamento della caverna:
 631  823A              ; 1. Tutti gli oggetti della caverna raccolti;
 632  823A              ; 2. Willy collide con il portale attivo.
 633  823A              ; -------------------------------------------------------------------
 634  823A              CheckVictoryCondition:
 635  823A C5               push bc
 636  823B D5               push de
 637  823C E5               push hl
 638  823D
 639  823D                  ; 1. Tutti gli item raccolti?
 640  823D CD 94 82         call CheckAllItemsCollected
 641  8240 30 4D            jr   nc, .no_victory
 642  8242
 643  8242                  ; 2. Willy collide con il portale (16x16)?
 644  8242 2A 27 91         ld   hl, (room_ptr)
 645  8245 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 646  8248 19               add  hl, de
 647  8249 4E               ld   c, (hl)
 648  824A 23               inc  hl
 649  824B 46               ld   b, (hl)                   ; BC = AttrAddr
 650  824C
 651  824C                  ; Offset = BC - 23552
 652  824C 60               ld   h, b
 653  824D 69               ld   l, c
 654  824E 01 00 A4         ld   bc, -23552
 655  8251 09               add  hl, bc
 656  8252
 657  8252                  ; PortalX = (Offset & 31) * 8, PortalY = (Offset / 32) * 8
 658  8252 7D               ld   a, l
 659  8253 E6 1F            and  31
 660  8255 87               add  a, a
 660  8256 87             add a, a
 660  8257 87             add a, a
 661  8258 5F               ld   e, a                      ; E = PortalX
 662  8259
 663  8259 CB 3C            srl  h
 663  825B CB 1D          rr l
 664  825D CB 3C            srl  h
 664  825F CB 1D          rr l
 665  8261 CB 3C            srl  h
 665  8263 CB 1D          rr l
 666  8265 CB 3C            srl  h
 666  8267 CB 1D          rr l
 667  8269 CB 3C            srl  h
 667  826B CB 1D          rr l
 668  826D 7D               ld   a, l
 669  826E 87               add  a, a
 669  826F 87             add a, a
 669  8270 87             add a, a
 670  8271 57               ld   d, a                      ; D = PortalY
 671  8272
 672  8272                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 673  8272 ED 4B A7 8D      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 674  8276
 675  8276                  ; |WillyX - PortalX| < 12
 676  8276 7B               ld   a, e
 677  8277 91               sub  c
 678  8278 30 02            jr   nc, .x_diff_pos
 679  827A ED 44            neg
 680  827C              .x_diff_pos:
 681  827C FE 0C            cp   12
 682  827E 30 0F            jr   nc, .no_victory
 683  8280
 684  8280                  ; |WillyY - PortalY| < 14
 685  8280 7A               ld   a, d
 686  8281 90               sub  b
 687  8282 30 02            jr   nc, .y_diff_pos
 688  8284 ED 44            neg
 689  8286              .y_diff_pos:
 690  8286 FE 0E            cp   14
 691  8288 30 05            jr   nc, .no_victory
 692  828A
 693  828A                  ; Vittoria / Portale raggiunto!
 694  828A E1               pop  hl
 695  828B D1               pop  de
 696  828C C1               pop  bc
 697  828D 37               scf
 698  828E C9               ret
 699  828F
 700  828F              .no_victory:
 701  828F E1               pop  hl
 702  8290 D1               pop  de
 703  8291 C1               pop  bc
 704  8292 B7               or   a
 705  8293 C9               ret

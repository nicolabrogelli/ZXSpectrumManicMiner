 271+ 700D              ; LoadPositionPlayeinRoom
 272+ 700D              ;
 273+ 700D              ; Inizializza la posizione del player (Willy) quando entra
 274+ 700D              ; in una nuova stanza.
 275+ 700D              ;
 276+ 700D              ; La posizione viene letta direttamente dai dati della stanza
 277+ 700D              ; (layout/metadata) a partire da room_ptr.
 278+ 700D              ;
 279+ 700D              ; Output:
 280+ 700D              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 700D              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 700D              ;
 283+ 700D              ; Struttura dati stanza:
 284+ 700D              ;   OFFSET_POS_WILLY:
 285+ 700D              ;       +0 = X
 286+ 700D              ;       +1 = Y
 287+ 700D              ; -------------------------------------------------------------------
 288+ 700D              LoadPositionPlayeinRoom:
 289+ 700D                  ; ---------------------------------------------------------------
 290+ 700D                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 700D                  ; ---------------------------------------------------------------
 292+ 700D 2A E7 99         ld   hl, (room_ptr)
 293+ 7010 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 7013 19               add  hl, de
 295+ 7014
 296+ 7014                  ; Byte 0: Y * 2
 297+ 7014 7E               ld   a, (hl)
 298+ 7015 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 7017 57               ld   d, a                      ; D = PlayerY
 300+ 7018
 301+ 7018                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 7018 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 7019 23               inc  hl                        ; Byte 2 (Direction)
 304+ 701A 7E               ld   a, (hl)
 305+ 701B E6 01            and  1
 306+ 701D 28 04            jr   z, .facing_right
 307+ 701F 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 7021 18 02            jr   .set_dir
 309+ 7023              .facing_right:
 310+ 7023 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 7025              .set_dir:
 312+ 7025 32 6E 96         ld   (direction), a
 313+ 7028
 314+ 7028                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 7028 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 7029 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 702A 4E               ld   c, (hl)
 318+ 702B 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 702C 7E               ld   a, (hl)
 320+ 702D
 321+ 702D                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 702D 67               ld   h, a
 323+ 702E 69               ld   l, c
 324+ 702F 01 00 A4         ld   bc, -23552
 325+ 7032 09               add  hl, bc
 326+ 7033
 327+ 7033 7D               ld   a, l
 328+ 7034 E6 1F            and  31
 329+ 7036 87               add  a, a                      ; *2
 330+ 7037 87               add  a, a                      ; *4
 331+ 7038 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 7039 4F               ld   c, a                      ; C = PlayerX
 333+ 703A 42               ld   b, d                      ; B = PlayerY
 334+ 703B
 335+ 703B                  ; Salva coordinate (C = X, B = Y)
 336+ 703B ED 43 67 96      ld   (PlayerPos), bc
 337+ 703F ED 43 69 96      ld   (PlayerPosOld), bc
 338+ 7043 C9               ret

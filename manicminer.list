 212+ 7E26 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 213+ 7E29
 214+ 7E29 23               inc  hl
 215+ 7E2A 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 216+ 7E2B DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 217+ 7E2E

 252+ 7DDB 28 3A            jr   z, .next_erase
 253+ 7DDD
 254+ 7DDD                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 255+ 7DDD DD 7E 08         ld   a, (ix+8)         ; Old X
 256+ 7DE0 FE FF            cp   $FF
 257+ 7DE2 28 33            jr   z, .next_erase
 258+ 7DE4
 259+ 7DE4                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 260+ 7DE4 DD 7E 08         ld   a, (ix+8)         ; Old X
 261+ 7DE7 DD BE 02         cp   (ix+2)            ; Current X
 262+ 7DEA 20 0E            jr   nz, .do_erase_slot
 263+ 7DEC DD 7E 09         ld   a, (ix+9)         ; Old Y
 264+ 7DEF DD BE 03         cp   (ix+3)            ; Current Y
 265+ 7DF2 20 06            jr   nz, .do_erase_slot
 266+ 7DF4
 267+ 7DF4 3A E8 CA         ld   a, (enemy_was_updated)
 268+ 7DF7 B7               or   a
 269+ 7DF8 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 270+ 7DFA
 271+ 7DFA              .do_erase_slot:
 272+ 7DFA C5               push bc                ; Salva contatore ciclo
 273+ 7DFB
 274+ 7DFB                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 275+ 7DFB DD 4E 08         ld   c, (ix+8)         ; C = Old X
 276+ 7DFE DD 46 09         ld   b, (ix+9)         ; B = Old Y
 277+ 7E01 CD A7 7D         call CheckEnemyWillyOverlap
 278+ 7E04
 279+ 7E04                  ; Cancella il nemico nella VECCHIA posizione
 280+ 7E04 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 281+ 7E07 DD 46 09         ld   b, (ix+9)         ; B = Old Y

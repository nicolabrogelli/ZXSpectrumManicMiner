  40+ 7CBC                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CBC 21 5F 7C         ld   hl, ActiveEnemies
  42+ 7CBF 11 60 7C         ld   de, ActiveEnemies + 1
  43+ 7CC2 36 00            ld   (hl), 0
  44+ 7CC4 01 57 00         ld   bc, 87
  45+ 7CC7 ED B0            ldir
  46+ 7CC9
  47+ 7CC9                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CC9 DD 21 5F 7C      ld   ix, ActiveEnemies
  49+ 7CCD 06 08            ld   b, 8
  50+ 7CCF 11 0B 00         ld   de, 11

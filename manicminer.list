 310+ 7EDC 79               ld   a, c
 311+ 7EDD E6 F8            and  $F8                ; A = EnemyX & $F8
 312+ 7EDF 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 313+ 7EE0 C6 10            add  a, 16
 314+ 7EE2 FE 19            cp   25
 315+ 7EE4 D0               ret  nc                 ; Fuori portata X

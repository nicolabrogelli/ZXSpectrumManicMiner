 696  822D CB 3C            srl  h
 696  822F CB 1D          rr l
 697  8231 CB 3C            srl  h
 697  8233 CB 1D          rr l
 698  8235 CB 3C            srl  h
 698  8237 CB 1D          rr l
 699  8239 CB 3C            srl  h
 699  823B CB 1D          rr l
 700  823D 7D               ld   a, l

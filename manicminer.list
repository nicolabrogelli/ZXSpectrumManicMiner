1086+ 6259                  ; 2. Calcola indirizzo VRAM scanline 0 per (Row D, Col E)
1087+ 6259                  ; HighByte = $40 + (D & $18)
1088+ 6259 7A               ld   a, d
1089+ 625A E6 18            and  $18
1090+ 625C C6 40            add  a, $40
1091+ 625E 67               ld   h, a
1092+ 625F
1093+ 625F                  ; LowByte = ((D & 7) * 32) + E
1094+ 625F 7A               ld   a, d
1095+ 6260 E6 07            and  7
1096+ 6262 87               add  a, a                  ; *2
1097+ 6263 87               add  a, a                  ; *4
1098+ 6264 87               add  a, a                  ; *8
1099+ 6265 87               add  a, a                  ; *16
1100+ 6266 87               add  a, a                  ; *32
1101+ 6267 83               add  a, e                  ; + Col E
1102+ 6268 6F               ld   l, a                  ; HL = VRAM address scanline 0

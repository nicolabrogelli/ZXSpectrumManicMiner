  85+ 805D FE FF            cp   $FF
  86+ 805F 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 8061 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 8062 23               inc  hl                        ; +2 (Attr Address High)
  89+ 8063 23               inc  hl                        ; +3 (Anim mask)
  90+ 8064 23               inc  hl                        ; +4 (Collected flag)
  91+ 8065 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 8067 23               inc  hl                        ; Avanza al prossimo item
  93+ 8068 18 F2            jr   .item_loop
  94+ 806A
  95+ 806A              .next_room:
  96+ 806A E1               pop  hl
  97+ 806B C1               pop  bc
  98+ 806C 10 E4            djnz .room_loop
  99+ 806E
 100+ 806E C1               pop  bc
 101+ 806F D1               pop  de
 102+ 8070 E1               pop  hl
 103+ 8071 C9               ret

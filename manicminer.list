 805  873C              ; CheckAllItemsCollected
 806  873C              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 807  873C              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 808  873C              ; -------------------------------------------------------------------
 809  873C              CheckAllItemsCollected:
 810  873C 3A 64 A4         ld   a, (game_objective_completed)
 811  873F B7               or   a
 812  8740 20 08            jr   nz, .all_collected
 813  8742 3A CE A1         ld   a, (num_room_items)
 814  8745 B7               or   a
 815  8746 28 02            jr   z, .all_collected
 816  8748 B7               or   a
 817  8749 C9               ret
 818  874A              .all_collected:
 819  874A 37               scf
 820  874B C9               ret
 821  874C

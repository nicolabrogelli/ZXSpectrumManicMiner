  88+ 7D04                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D04 7D               ld   a, l
  90+ 7D05 E6 1F            and  31
  91+ 7D07 87               add  a, a
  91+ 7D08 87             add a, a
  91+ 7D09 87             add a, a
  92+ 7D0A DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D0D
  94+ 7D0D                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D0D CB 3C            srl  h
  95+ 7D0F CB 1D          rr l
  96+ 7D11 CB 3C            srl  h
  96+ 7D13 CB 1D          rr l
  97+ 7D15 CB 3C            srl  h
  97+ 7D17 CB 1D          rr l
  98+ 7D19 CB 3C            srl  h
  98+ 7D1B CB 1D          rr l
  99+ 7D1D CB 3C            srl  h
  99+ 7D1F CB 1D          rr l

1262+ 64ED CD 2B 61         call Gfx_Clear16x16_Black
1263+ 64F0
1264+ 64F0                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1265+ 64F0 78               ld   a, b
1266+ 64F1 CB 3F            srl  a
1267+ 64F3 CB 3F            srl  a
1268+ 64F5 CB 3F            srl  a                     ; A = Row da azzerare
1269+ 64F7 6F               ld   l, a
1270+ 64F8 26 00            ld   h, 0
1271+ 64FA 29               add  hl, hl                ; * 2
1272+ 64FB 29               add  hl, hl                ; * 4
1273+ 64FC 29               add  hl, hl                ; * 8
1274+ 64FD 29               add  hl, hl                ; * 16
1275+ 64FE 29               add  hl, hl                ; * 32
1276+ 64FF 11 0F 58         ld   de, $580f             ; $5800 + 15
1277+ 6502 19               add  hl, de
1278+ 6503 AF               xor  a
1279+ 6504 77               ld   (hl), a               ; Col 15 = 0
1280+ 6505 23               inc  hl
1281+ 6506 77               ld   (hl), a               ; Col 16 = 0
1282+ 6507
1283+ 6507              .skip_clear_prev:
1284+ 6507 C1               pop  bc                    ; Ripristina B = Y corrente
1285+ 6508 C5               push bc
1286+ 6509
1287+ 6509                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1288+ 6509 78               ld   a, b
1289+ 650A FE 60            cp   96
1290+ 650C 20 09            jr   nz, .draw_foot
1291+ 650E C5               push bc
1292+ 650F 0E 78            ld   c, 120
1293+ 6511 06 60            ld   b, 96

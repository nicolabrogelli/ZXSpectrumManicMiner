 371+ 7E94              ; Enemy_DrawSingleSlot
 372+ 7E94              ;
 373+ 7E94              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 374+ 7E94              ; La grafica (8 frame da 32 byte) è letta direttamente da
 375+ 7E94              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 376+ 7E94              ; -------------------------------------------------------------------
 377+ 7E94              Enemy_DrawSingleSlot:

  61+ 7DB5 19               add  hl, de
  62+ 7DB6
  63+ 7DB6 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7DB8              .load_h_loop:
  65+ 7DB8 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7DB9 FE FF            cp   $FF

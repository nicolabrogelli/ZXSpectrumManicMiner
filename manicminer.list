1725+ 66CE 21 AB 58         ld   hl, $58ab             ; Riga 5, Colonna 11 ($5800 + 5*32 + 11 = $58AB)
1726+ 66D1 06 09            ld   b, 9
1727+ 66D3 3E 42            ld   a, RED | $40

 358  8B70              ; TriggerGameOver
 359  8B70              ; Scatena la sequenza originale di Game Over:
 360  8B70              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 361  8B70              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 362  8B70              ;   con suono beeper originale e lampeggio dello schermo.
 363  8B70              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 364  8B70              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 365  8B70              ; -------------------------------------------------------------------
 366  8B70              TriggerGameOver:
 367  8B70                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 368  8B70 CD D4 88         call Score_CheckAndUpdateHighScore
 369  8B73
 370  8B73                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 371  8B73 CD 29 66         call Gfx_DrawGameOverScreen
 372  8B76
 373  8B76                  ; 3. Ritorna al Title Screen originale
 374  8B76 C3 2C 8B         jp   ShowTitleScreen
 375  8B79
 376  8B79              ; -------------------------------------------------------------------
 377  8B79              ; TriggerVictory
 378  8B79              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 379  8B79              ; - Pulisce gli elementi di gioco della stanza.
 380  8B79              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 381  8B79              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 382  8B79              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 383  8B79              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 384  8B79              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 385  8B79              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 386  8B79              ; -------------------------------------------------------------------
 387  8B79              TriggerVictory:
 388  8B79                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 389  8B79 CD D4 88         call Score_CheckAndUpdateHighScore
 390  8B7C
 391  8B7C                  ; 2. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 392  8B7C CD 14 67         call Gfx_DrawVictoryScreen
 393  8B7F
 394  8B7F                  ; 3. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 395  8B7F              .wait_keys_release:
 396  8B7F 76               halt
 397  8B80                  ; Controlla tasto Y (Porta $DF, bit 4)
 398  8B80 01 FE DF         ld   bc, $dffe
 399  8B83 ED 78            in   a, (c)
 400  8B85 CB 67            bit  4, a
 401  8B87 28 F6            jr   z, .wait_keys_release
 402  8B89
 403  8B89                  ; Controlla tasto N (Porta $7F, bit 3)
 404  8B89 01 FE 7F         ld   bc, $7ffe
 405  8B8C ED 78            in   a, (c)
 406  8B8E CB 5F            bit  3, a
 407  8B90 28 ED            jr   z, .wait_keys_release
 408  8B92
 409  8B92                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 410  8B92 01 FE BF         ld   bc, $bffe
 411  8B95 ED 78            in   a, (c)
 412  8B97 CB 47            bit  0, a
 413  8B99 28 E4            jr   z, .wait_keys_release
 414  8B9B
 415  8B9B                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 416  8B9B 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 417  8B9D              .wait_choice_loop:
 418  8B9D 76               halt
 419  8B9E
 420  8B9E                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 421  8B9E 0C               inc  c
 422  8B9F 79               ld   a, c
 423  8BA0 CB 3F            srl  a
 424  8BA2 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 425  8BA4 E6 07            and  7
 426  8BA6 5F               ld   e, a
 427  8BA7 16 00            ld   d, 0
 428  8BA9 21 0B 66         ld   hl, victory_color_table
 429  8BAC 19               add  hl, de
 430  8BAD 7E               ld   a, (hl)               ; A = nuovo colore attributo
 431  8BAE 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 432  8BB1 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 433  8BB3              .color_cycle_loop:
 434  8BB3 77               ld   (hl), a
 435  8BB4 23               inc  hl
 436  8BB5 10 FC            djnz .color_cycle_loop
 437  8BB7
 438  8BB7                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 439  8BB7 01 FE DF         ld   bc, $dffe
 440  8BBA ED 78            in   a, (c)
 441  8BBC CB 67            bit  4, a
 442  8BBE 28 2A            jr   z, .play_again_chosen
 443  8BC0
 444  8BC0                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 445  8BC0 01 FE 7F         ld   bc, $7ffe
 446  8BC3 ED 78            in   a, (c)
 447  8BC5 CB 5F            bit  3, a
 448  8BC7 28 0B            jr   z, .quit_chosen
 449  8BC9
 450  8BC9                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 451  8BC9 01 FE BF         ld   bc, $bffe
 452  8BCC ED 78            in   a, (c)
 453  8BCE CB 47            bit  0, a
 454  8BD0 28 02            jr   z, .quit_chosen
 455  8BD2
 456  8BD2 18 C9            jr   .wait_choice_loop
 457  8BD4
 458  8BD4              .quit_chosen:
 459  8BD4                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 460  8BD4              .wait_quit_release:
 461  8BD4 76               halt
 462  8BD5 01 FE 7F         ld   bc, $7ffe
 463  8BD8 ED 78            in   a, (c)
 464  8BDA CB 5F            bit  3, a
 465  8BDC 28 F6            jr   z, .wait_quit_release
 466  8BDE 01 FE BF         ld   bc, $bffe
 467  8BE1 ED 78            in   a, (c)
 468  8BE3 CB 47            bit  0, a
 469  8BE5 28 ED            jr   z, .wait_quit_release
 470  8BE7
 471  8BE7                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 472  8BE7 C3 2C 8B         jp   ShowTitleScreen
 473  8BEA
 474  8BEA              .play_again_chosen:
 475  8BEA                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 476  8BEA              .wait_play_again_release:
 477  8BEA 76               halt
 478  8BEB 01 FE DF         ld   bc, $dffe
 479  8BEE ED 78            in   a, (c)
 480  8BF0 CB 67            bit  4, a
 481  8BF2 28 F6            jr   z, .wait_play_again_release
 482  8BF4
 483  8BF4                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 484  8BF4 CD 2E 8D         call ResetFullGameState
 485  8BF7 C3 EA 89         jp   LoadRoomAndRestart
 486  8BFA
 487  8BFA              ; -------------------------------------------------------------------
 488  8BFA              ; CheckPortalTransition
 489  8BFA              ; Verifica le condizioni per accedere alla stanza successiva:
 490  8BFA              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 491  8BFA              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 492  8BFA              ;
 493  8BFA              ; Output:
 494  8BFA              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 495  8BFA              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 496  8BFA              ; -------------------------------------------------------------------
 497  8BFA              CheckPortalTransition:
 498  8BFA C5               push bc
 499  8BFB D5               push de
 500  8BFC E5               push hl
 501  8BFD
 502  8BFD                  ; 1. Tutti gli item della stanza sono stati raccolti?
 503  8BFD CD C1 8C         call CheckAllItemsCollected
 504  8C00 30 4D            jr   nc, .no_transition
 505  8C02
 506  8C02                  ; 2. Willy collide con il portale (16x16 pixel)?
 507  8C02                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 508  8C02                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 509  8C02 2A 4B EF         ld   hl, (room_ptr)
 510  8C05 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 511  8C08 19               add  hl, de
 512  8C09 4E               ld   c, (hl)
 513  8C0A 23               inc  hl
 514  8C0B 46               ld   b, (hl)                   ; BC = AttrAddr
 515  8C0C
 516  8C0C                  ; Offset = BC - 23552
 517  8C0C 60               ld   h, b
 518  8C0D 69               ld   l, c
 519  8C0E 01 00 A4         ld   bc, -23552
 520  8C11 09               add  hl, bc
 521  8C12
 522  8C12                  ; PortalX = (Offset & 31) * 8
 523  8C12 7D               ld   a, l
 524  8C13 E6 1F            and  31
 525  8C15 87               add  a, a
 525  8C16 87             add a, a
 525  8C17 87             add a, a
 526  8C18 5F               ld   e, a                      ; E = PortalX (0..248)
 527  8C19
 528  8C19                  ; PortalY = (Offset / 32) * 8
 529  8C19 CB 3C            srl  h
 529  8C1B CB 1D          rr l
 530  8C1D CB 3C            srl  h
 530  8C1F CB 1D          rr l
 531  8C21 CB 3C            srl  h
 531  8C23 CB 1D          rr l
 532  8C25 CB 3C            srl  h
 532  8C27 CB 1D          rr l
 533  8C29 CB 3C            srl  h
 533  8C2B CB 1D          rr l
 534  8C2D 7D               ld   a, l
 535  8C2E 87               add  a, a
 535  8C2F 87             add a, a
 535  8C30 87             add a, a
 536  8C31 57               ld   d, a                      ; D = PortalY (0..120)
 537  8C32
 538  8C32                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 539  8C32 ED 4B C8 EB      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 540  8C36
 541  8C36                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 542  8C36 7B               ld   a, e
 543  8C37 91               sub  c
 544  8C38 30 02            jr   nc, .x_diff_pos
 545  8C3A ED 44            neg
 546  8C3C              .x_diff_pos:
 547  8C3C FE 0C            cp   12
 548  8C3E 30 0F            jr   nc, .no_transition
 549  8C40
 550  8C40                  ; Controllo verticale: |WillyY - PortalY| < 14
 551  8C40 7A               ld   a, d
 552  8C41 90               sub  b
 553  8C42 30 02            jr   nc, .y_diff_pos
 554  8C44 ED 44            neg
 555  8C46              .y_diff_pos:
 556  8C46 FE 0E            cp   14
 557  8C48 30 05            jr   nc, .no_transition
 558  8C4A
 559  8C4A                  ; Transizione al portale attiva!
 560  8C4A E1               pop  hl
 561  8C4B D1               pop  de
 562  8C4C C1               pop  bc
 563  8C4D 37               scf
 564  8C4E C9               ret
 565  8C4F
 566  8C4F              .no_transition:
 567  8C4F E1               pop  hl
 568  8C50 D1               pop  de
 569  8C51 C1               pop  bc
 570  8C52 B7               or   a
 571  8C53 C9               ret
 572  8C54
 573  8C54              ; Alias per retrocompatibilità
 574  8C54              CheckVictoryCondition: EQU CheckPortalTransition
 575  8C54
 576  8C54              ; -------------------------------------------------------------------
 577  8C54              ; TriggerPortalTransition
 578  8C54              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 579  8C54              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 580  8C54              ; - Avanza all'indice della stanza successiva.
 581  8C54              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 582  8C54              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 583  8C54              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 584  8C54              ; -------------------------------------------------------------------
 585  8C54              TriggerPortalTransition:
 586  8C54                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 587  8C54 CD 8B 8C         call Air_DepleteCountdown
 588  8C57
 589  8C57                  ; 1. Determina l'ID della stanza corrente
 590  8C57 CD 15 86         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 591  8C5A
 592  8C5A                  ; 2. Calcola l'indice della stanza successiva
 593  8C5A 3A F0 EE         ld   a, (current_room)
 594  8C5D 3C               inc  a
 595  8C5E FE 14            cp   NUM_ROOMS
 596  8C60 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 597  8C62
 598  8C62                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 599  8C62 21 3D 74         ld   hl, RoomsListTable
 600  8C65 5F               ld   e, a
 601  8C66 16 00            ld   d, 0
 602  8C68 19               add  hl, de
 603  8C69 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 604  8C6A 5E               ld   e, (hl)
 605  8C6B 23               inc  hl
 606  8C6C 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 607  8C6D ED 53 4B EF      ld   (room_ptr), de
 608  8C71
 609  8C71                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 610  8C71 AF               xor  a
 611  8C72 32 51 EF         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 612  8C75 32 D6 EB         ld   (velocity_y), a
 613  8C78 32 E3 F1         ld   (game_objective_completed), a
 614  8C7B 3E 01            ld   a, 1
 615  8C7D 32 D7 EB         ld   (on_ground), a
 616  8C80
 617  8C80                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 618  8C80 3E 07            ld   a, $07
 619  8C82 CD 9D 62         call Gfx_ClearScreenDirect
 620  8C85
 621  8C85 C3 EA 89         jp   LoadRoomAndRestart
 622  8C88
 623  8C88              .all_rooms_completed:
 624  8C88                  ; Tutte le stanze sono state completate con successo!
 625  8C88                  IF ENABLE_VICTORY_SCREEN != 0
 626  8C88 C3 79 8B         jp   TriggerVictory
 627  8C8B                  ELSE
 628  8C8B ~                ; Ricomincia dalla prima stanza (Stanza 00)
 629  8C8B ~                ld   de, (RoomsListTable)
 630  8C8B ~                ld   (room_ptr), de
 631  8C8B ~                xor  a
 632  8C8B ~                ld   (transition_active), a
 633  8C8B ~                ld   (velocity_y), a
 634  8C8B ~                ld   (game_objective_completed), a
 635  8C8B ~                ld   a, 1
 636  8C8B ~                ld   (on_ground), a
 637  8C8B ~                ld   a, $07
 638  8C8B ~                call Gfx_ClearScreenDirect
 639  8C8B ~                jp   LoadRoomAndRestart
 640  8C8B                  ENDIF
 641  8C8B
 642  8C8B              ; -------------------------------------------------------------------
 643  8C8B              ; Air_DepleteCountdown
 644  8C8B              ; Animazione originale di completamento livello (Manic Miner):
 645  8C8B              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 646  8C8B              ; - Ad ogni pixel decrementato:
 647  8C8B              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 648  8C8B              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 649  8C8B              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 650  8C8B              ; -------------------------------------------------------------------
 651  8C8B              Air_DepleteCountdown:
 652  8C8B F5               push af
 653  8C8C C5               push bc
 654  8C8D D5               push de
 655  8C8E E5               push hl
 656  8C8F
 657  8C8F              .countdown_loop:
 658  8C8F 3A EC F1         ld   a, (air_pixels)
 659  8C92 B7               or   a
 660  8C93 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 661  8C95
 662  8C95 3D               dec  a
 663  8C96 32 EC F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 664  8C99
 665  8C99                  ; Aggiorna la barra grafica dell'aria
 666  8C99 CD 42 6A         call Gfx_UpdateAirBar
 667  8C9C
 668  8C9C                  ; Aggiungi 1 punto allo score
 669  8C9C CD 89 88         call Score_Add1Point
 670  8C9F
 671  8C9F                  ; Genera l'effetto sonoro originale di Manic Miner:
 672  8C9F                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 673  8C9F 3A EC F1         ld   a, (air_pixels)
 674  8CA2 2F               cpl
 675  8CA3 E6 3F            and  63
 676  8CA5 07               rlca
 677  8CA6 3C               inc  a
 678  8CA7 57               ld   d, a                      ; D = ritardo semionda audio
 679  8CA8
 680  8CA8 0E 03            ld   c, 3                      ; Durata impulso
 681  8CAA              .audio_loop:
 682  8CAA AF               xor  a
 683  8CAB D3 FE            out  ($fe), a
 684  8CAD 42               ld   b, d
 685  8CAE 10 FE        .w1: djnz .w1
 686  8CB0
 687  8CB0 3E 18            ld   a, $18
 688  8CB2 D3 FE            out  ($fe), a
 689  8CB4 42               ld   b, d
 690  8CB5 10 FE        .w2: djnz .w2
 691  8CB7
 692  8CB7 0D               dec  c
 693  8CB8 20 F0            jr   nz, .audio_loop
 694  8CBA
 695  8CBA 18 D3            jr   .countdown_loop
 696  8CBC
 697  8CBC              .done_countdown:
 698  8CBC E1               pop  hl
 699  8CBD D1               pop  de
 700  8CBE C1               pop  bc
 701  8CBF F1               pop  af
 702  8CC0 C9               ret
 703  8CC1
 704  8CC1              ; -------------------------------------------------------------------
 705  8CC1              ; CheckAllItemsCollected
 706  8CC1              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 707  8CC1              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 708  8CC1              ; -------------------------------------------------------------------
 709  8CC1              CheckAllItemsCollected:
 710  8CC1 3A E3 F1         ld   a, (game_objective_completed)
 711  8CC4 B7               or   a
 712  8CC5 20 08            jr   nz, .all_collected
 713  8CC7 3A 4A EF         ld   a, (num_room_items)
 714  8CCA B7               or   a
 715  8CCB 28 02            jr   z, .all_collected
 716  8CCD B7               or   a
 717  8CCE C9               ret
 718  8CCF              .all_collected:
 719  8CCF 37               scf
 720  8CD0 C9               ret
 721  8CD1
 722  8CD1              ; -------------------------------------------------------------------
 723  8CD1              ; CheckInMasterBedroom (alias per retrocompatibilità)
 724  8CD1              ; -------------------------------------------------------------------
 725  8CD1              CheckInMasterBedroom:
 726  8CD1 37               scf
 727  8CD2 C9               ret
 728  8CD3
 729  8CD3              ; -------------------------------------------------------------------
 730  8CD3              ; CheckWillyConveyorCollision
 731  8CD3              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 732  8CD3              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 733  8CD3              ; -------------------------------------------------------------------
 734  8CD3              CheckWillyConveyorCollision:
 735  8CD3 C5               push bc
 736  8CD4 D5               push de
 737  8CD5 E5               push hl
 738  8CD6
 739  8CD6                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 740  8CD6 CD 1D 79         call CheckWillyOnConveyor
 741  8CD9 38 49            jr   c, .collision_detected
 742  8CDB
 743  8CDB                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 744  8CDB 3A F2 EE         ld   a, (conveyor_len)
 745  8CDE B7               or   a
 746  8CDF 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 747  8CE1
 748  8CE1                  ; B = WillyY, C = WillyX
 749  8CE1 ED 4B C8 EB      ld   bc, (PlayerPos)
 750  8CE5
 751  8CE5                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 752  8CE5 3A F3 EE         ld   a, (conveyor_row)
 753  8CE8 87               add  a, a                  ; *2
 754  8CE9 87               add  a, a                  ; *4
 755  8CEA 87               add  a, a                  ; *8
 756  8CEB 5F               ld   e, a                  ; E = ConveyorTop
 757  8CEC C6 07            add  a, 7
 758  8CEE 57               ld   d, a                  ; D = ConveyorBottom
 759  8CEF
 760  8CEF                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 761  8CEF 78               ld   a, b                  ; WillyTop
 762  8CF0 BA               cp   d
 763  8CF1 28 04            jr   z, .y_overlap
 764  8CF3 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 765  8CF5 18 32            jr   .no_conv_collision
 766  8CF7
 767  8CF7              .y_overlap:
 768  8CF7 C6 0F            add  a, 15                 ; WillyBottom
 769  8CF9 BB               cp   e
 770  8CFA 28 04            jr   z, .x_check
 771  8CFC 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 772  8CFE 18 29            jr   .no_conv_collision
 773  8D00
 774  8D00              .x_check:
 775  8D00                  ; ConveyorLeft = conveyor_col * 8
 776  8D00 3A F4 EE         ld   a, (conveyor_col)
 777  8D03 87               add  a, a                  ; *2
 778  8D04 87               add  a, a                  ; *4
 779  8D05 87               add  a, a                  ; *8
 780  8D06 5F               ld   e, a                  ; E = ConveyorLeft
 781  8D07
 782  8D07                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 783  8D07 21 F2 EE         ld   hl, conveyor_len
 784  8D0A 3A F4 EE         ld   a, (conveyor_col)
 785  8D0D 86               add  a, (hl)
 786  8D0E 87               add  a, a                  ; *2
 787  8D0F 87               add  a, a                  ; *4
 788  8D10 87               add  a, a                  ; *8
 789  8D11 3D               dec  a                     ; ConveyorRight
 790  8D12 57               ld   d, a                  ; D = ConveyorRight
 791  8D13
 792  8D13                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 793  8D13 79               ld   a, c                  ; WillyLeft
 794  8D14 BA               cp   d
 795  8D15 28 04            jr   z, .x_overlap
 796  8D17 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 797  8D19 18 0E            jr   .no_conv_collision
 798  8D1B
 799  8D1B              .x_overlap:

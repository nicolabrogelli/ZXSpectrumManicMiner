 525  86CB              ; -------------------------------------------------------------------
 526  86CB              ; TriggerVictory
 527  86CB              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  86CB              ; - Pulisce gli elementi di gioco della stanza.
 529  86CB              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  86CB              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  86CB              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  86CB              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  86CB              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  86CB              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  86CB              ; -------------------------------------------------------------------
 536  86CB              TriggerVictory:
 537  86CB                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  86CB CD F3 66         call Gfx_DrawVictoryScreen
 539  86CE
 540  86CE                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  86CE              .wait_keys_release:
 542  86CE 76               halt
 543  86CF                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  86CF 01 FE DF         ld   bc, $dffe
 545  86D2 ED 78            in   a, (c)
 546  86D4 CB 67            bit  4, a
 547  86D6 28 F6            jr   z, .wait_keys_release
 548  86D8
 549  86D8                  ; Controlla tasto N (Porta $7F, bit 3)
 550  86D8 01 FE 7F         ld   bc, $7ffe
 551  86DB ED 78            in   a, (c)
 552  86DD CB 5F            bit  3, a
 553  86DF 28 ED            jr   z, .wait_keys_release
 554  86E1
 555  86E1                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  86E1 01 FE BF         ld   bc, $bffe
 557  86E4 ED 78            in   a, (c)
 558  86E6 CB 47            bit  0, a
 559  86E8 28 E4            jr   z, .wait_keys_release
 560  86EA
 561  86EA                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  86EA 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  86EC              .wait_choice_loop:
 564  86EC 76               halt
 565  86ED
 566  86ED                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  86ED 0C               inc  c
 568  86EE 79               ld   a, c
 569  86EF CB 3F            srl  a
 570  86F1 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  86F3 E6 07            and  7
 572  86F5 5F               ld   e, a
 573  86F6 16 00            ld   d, 0
 574  86F8 21 0D 66         ld   hl, victory_color_table
 575  86FB 19               add  hl, de
 576  86FC 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  86FD 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  8700 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  8702              .color_cycle_loop:
 580  8702 77               ld   (hl), a
 581  8703 23               inc  hl
 582  8704 10 FC            djnz .color_cycle_loop
 583  8706
 584  8706                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  8706 01 FE DF         ld   bc, $dffe
 586  8709 ED 78            in   a, (c)
 587  870B CB 67            bit  4, a
 588  870D 28 2A            jr   z, .play_again_chosen
 589  870F
 590  870F                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  870F 01 FE 7F         ld   bc, $7ffe
 592  8712 ED 78            in   a, (c)
 593  8714 CB 5F            bit  3, a
 594  8716 28 0B            jr   z, .quit_chosen
 595  8718
 596  8718                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  8718 01 FE BF         ld   bc, $bffe
 598  871B ED 78            in   a, (c)
 599  871D CB 47            bit  0, a
 600  871F 28 02            jr   z, .quit_chosen
 601  8721
 602  8721 18 C9            jr   .wait_choice_loop
 603  8723
 604  8723              .quit_chosen:
 605  8723                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  8723              .wait_quit_release:
 607  8723 76               halt
 608  8724 01 FE 7F         ld   bc, $7ffe
 609  8727 ED 78            in   a, (c)
 610  8729 CB 5F            bit  3, a
 611  872B 28 F6            jr   z, .wait_quit_release
 612  872D 01 FE BF         ld   bc, $bffe
 613  8730 ED 78            in   a, (c)
 614  8732 CB 47            bit  0, a
 615  8734 28 ED            jr   z, .wait_quit_release
 616  8736
 617  8736                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  8736 C3 9F 85         jp   ShowTitleScreen
 619  8739
 620  8739              .play_again_chosen:
 621  8739                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  8739              .wait_play_again_release:
 623  8739 76               halt
 624  873A 01 FE DF         ld   bc, $dffe
 625  873D ED 78            in   a, (c)
 626  873F CB 67            bit  4, a
 627  8741 28 F6            jr   z, .wait_play_again_release
 628  8743
 629  8743                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  8743 CD 44 88         call ResetFullGameState
 631  8746 C3 66 84         jp   LoadRoomAndRestart
 632  8749
 633  8749              ; -------------------------------------------------------------------
 634  8749              ; CheckPortalTransition
 635  8749              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8749              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8749              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8749              ;
 639  8749              ; Output:
 640  8749              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8749              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8749              ; -------------------------------------------------------------------
 643  8749              CheckPortalTransition:
 644  8749 C5               push bc
 645  874A D5               push de
 646  874B E5               push hl
 647  874C
 648  874C                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  874C CD D7 87         call CheckAllItemsCollected
 650  874F 30 4D            jr   nc, .no_transition
 651  8751
 652  8751                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  8751                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  8751                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  8751 2A 5F CA         ld   hl, (room_ptr)
 656  8754 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8757 19               add  hl, de
 658  8758 4E               ld   c, (hl)
 659  8759 23               inc  hl
 660  875A 46               ld   b, (hl)                   ; BC = AttrAddr
 661  875B
 662  875B                  ; Offset = BC - 23552
 663  875B 60               ld   h, b
 664  875C 69               ld   l, c
 665  875D 01 00 A4         ld   bc, -23552
 666  8760 09               add  hl, bc
 667  8761
 668  8761                  ; PortalX = (Offset & 31) * 8
 669  8761 7D               ld   a, l
 670  8762 E6 1F            and  31
 671  8764 87               add  a, a
 671  8765 87             add a, a
 671  8766 87             add a, a
 672  8767 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8768
 674  8768                  ; PortalY = (Offset / 32) * 8
 675  8768 CB 3C            srl  h
 675  876A CB 1D          rr l
 676  876C CB 3C            srl  h
 676  876E CB 1D          rr l
 677  8770 CB 3C            srl  h
 677  8772 CB 1D          rr l
 678  8774 CB 3C            srl  h
 678  8776 CB 1D          rr l
 679  8778 CB 3C            srl  h
 679  877A CB 1D          rr l
 680  877C 7D               ld   a, l
 681  877D 87               add  a, a
 681  877E 87             add a, a
 681  877F 87             add a, a
 682  8780 57               ld   d, a                      ; D = PortalY (0..120)
 683  8781
 684  8781                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  8781 ED 4B DE C6      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  8785
 687  8785                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  8785 7B               ld   a, e
 689  8786 91               sub  c
 690  8787 30 02            jr   nc, .x_diff_pos
 691  8789 ED 44            neg
 692  878B              .x_diff_pos:
 693  878B FE 0C            cp   12
 694  878D 30 0F            jr   nc, .no_transition
 695  878F
 696  878F                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  878F 7A               ld   a, d
 698  8790 90               sub  b
 699  8791 30 02            jr   nc, .y_diff_pos
 700  8793 ED 44            neg
 701  8795              .y_diff_pos:
 702  8795 FE 0E            cp   14
 703  8797 30 05            jr   nc, .no_transition
 704  8799
 705  8799                  ; Transizione al portale attiva!
 706  8799 E1               pop  hl
 707  879A D1               pop  de
 708  879B C1               pop  bc
 709  879C 37               scf
 710  879D C9               ret
 711  879E
 712  879E              .no_transition:
 713  879E E1               pop  hl
 714  879F D1               pop  de
 715  87A0 C1               pop  bc
 716  87A1 B7               or   a
 717  87A2 C9               ret
 718  87A3
 719  87A3              ; Alias per retrocompatibilità
 720  87A3              CheckVictoryCondition: EQU CheckPortalTransition
 721  87A3
 722  87A3              ; -------------------------------------------------------------------
 723  87A3              ; TriggerPortalTransition
 724  87A3              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  87A3              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  87A3              ; - Avanza all'indice della stanza successiva.
 727  87A3              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  87A3              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  87A3              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  87A3              ; -------------------------------------------------------------------
 731  87A3              TriggerPortalTransition:
 732  87A3                  ; 1. Determina l'ID della stanza corrente
 733  87A3 CD 0C 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  87A6
 735  87A6                  ; 2. Calcola l'indice della stanza successiva
 736  87A6 3A 04 CA         ld   a, (current_room)
 737  87A9 3C               inc  a
 738  87AA FE 0E            cp   NUM_ROOMS
 739  87AC 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  87AE
 741  87AE                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  87AE 21 0A 73         ld   hl, RoomsListTable
 743  87B1 5F               ld   e, a
 744  87B2 16 00            ld   d, 0
 745  87B4 19               add  hl, de
 746  87B5 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87B6 5E               ld   e, (hl)
 748  87B7 23               inc  hl
 749  87B8 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87B9 ED 53 5F CA      ld   (room_ptr), de
 751  87BD
 752  87BD                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87BD AF               xor  a
 754  87BE 32 65 CA         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87C1 32 EC C6         ld   (velocity_y), a
 756  87C4 32 F4 CC         ld   (game_objective_completed), a
 757  87C7 3E 01            ld   a, 1
 758  87C9 32 ED C6         ld   (on_ground), a
 759  87CC
 760  87CC                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  87CC 3E 07            ld   a, $07
 762  87CE CD 99 62         call Gfx_ClearScreenDirect
 763  87D1
 764  87D1 C3 66 84         jp   LoadRoomAndRestart
 765  87D4
 766  87D4              .all_rooms_completed:
 767  87D4                  ; Tutte le stanze sono state completate con successo!
 768  87D4                  IF ENABLE_VICTORY_SCREEN != 0
 769  87D4 C3 CB 86         jp   TriggerVictory
 770  87D7                  ELSE
 771  87D7 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  87D7 ~                ld   de, (RoomsListTable)
 773  87D7 ~                ld   (room_ptr), de
 774  87D7 ~                xor  a
 775  87D7 ~                ld   (transition_active), a
 776  87D7 ~                ld   (velocity_y), a
 777  87D7 ~                ld   (game_objective_completed), a
 778  87D7 ~                ld   a, 1
 779  87D7 ~                ld   (on_ground), a
 780  87D7 ~                ld   a, $07
 781  87D7 ~                call Gfx_ClearScreenDirect
 782  87D7 ~                jp   LoadRoomAndRestart
 783  87D7                  ENDIF
 784  87D7
 785  87D7              ; -------------------------------------------------------------------
 786  87D7              ; CheckAllItemsCollected
 787  87D7              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  87D7              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  87D7              ; -------------------------------------------------------------------
 790  87D7              CheckAllItemsCollected:
 791  87D7 3A F4 CC         ld   a, (game_objective_completed)
 792  87DA B7               or   a
 793  87DB 20 08            jr   nz, .all_collected
 794  87DD 3A 5E CA         ld   a, (num_room_items)
 795  87E0 B7               or   a
 796  87E1 28 02            jr   z, .all_collected
 797  87E3 B7               or   a
 798  87E4 C9               ret
 799  87E5              .all_collected:
 800  87E5 37               scf
 801  87E6 C9               ret
 802  87E7
 803  87E7              ; -------------------------------------------------------------------
 804  87E7              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  87E7              ; -------------------------------------------------------------------
 806  87E7              CheckInMasterBedroom:
 807  87E7 37               scf
 808  87E8 C9               ret
 809  87E9
 810  87E9              ; -------------------------------------------------------------------
 811  87E9              ; CheckWillyConveyorCollision
 812  87E9              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  87E9              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  87E9              ; -------------------------------------------------------------------
 815  87E9              CheckWillyConveyorCollision:
 816  87E9 C5               push bc
 817  87EA D5               push de
 818  87EB E5               push hl
 819  87EC
 820  87EC                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  87EC CD BF 76         call CheckWillyOnConveyor
 822  87EF 38 49            jr   c, .collision_detected
 823  87F1
 824  87F1                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  87F1 3A 06 CA         ld   a, (conveyor_len)
 826  87F4 B7               or   a
 827  87F5 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  87F7
 829  87F7                  ; B = WillyY, C = WillyX
 830  87F7 ED 4B DE C6      ld   bc, (PlayerPos)
 831  87FB
 832  87FB                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  87FB 3A 07 CA         ld   a, (conveyor_row)
 834  87FE 87               add  a, a                  ; *2
 835  87FF 87               add  a, a                  ; *4
 836  8800 87               add  a, a                  ; *8
 837  8801 5F               ld   e, a                  ; E = ConveyorTop
 838  8802 C6 07            add  a, 7
 839  8804 57               ld   d, a                  ; D = ConveyorBottom
 840  8805
 841  8805                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  8805 78               ld   a, b                  ; WillyTop
 843  8806 BA               cp   d
 844  8807 28 04            jr   z, .y_overlap
 845  8809 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  880B 18 32            jr   .no_conv_collision
 847  880D
 848  880D              .y_overlap:
 849  880D C6 0F            add  a, 15                 ; WillyBottom
 850  880F BB               cp   e
 851  8810 28 04            jr   z, .x_check
 852  8812 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  8814 18 29            jr   .no_conv_collision
 854  8816
 855  8816              .x_check:
 856  8816                  ; ConveyorLeft = conveyor_col * 8
 857  8816 3A 08 CA         ld   a, (conveyor_col)
 858  8819 87               add  a, a                  ; *2
 859  881A 87               add  a, a                  ; *4
 860  881B 87               add  a, a                  ; *8
 861  881C 5F               ld   e, a                  ; E = ConveyorLeft
 862  881D
 863  881D                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  881D 21 06 CA         ld   hl, conveyor_len
 865  8820 3A 08 CA         ld   a, (conveyor_col)
 866  8823 86               add  a, (hl)
 867  8824 87               add  a, a                  ; *2
 868  8825 87               add  a, a                  ; *4
 869  8826 87               add  a, a                  ; *8
 870  8827 3D               dec  a                     ; ConveyorRight
 871  8828 57               ld   d, a                  ; D = ConveyorRight
 872  8829
 873  8829                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  8829 79               ld   a, c                  ; WillyLeft
 875  882A BA               cp   d
 876  882B 28 04            jr   z, .x_overlap
 877  882D 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  882F 18 0E            jr   .no_conv_collision
 879  8831
 880  8831              .x_overlap:
 881  8831 C6 0F            add  a, 15                 ; WillyRight
 882  8833 BB               cp   e
 883  8834 28 04            jr   z, .collision_detected
 884  8836 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  8838 18 05            jr   .no_conv_collision
 886  883A
 887  883A              .collision_detected:
 888  883A E1               pop  hl
 889  883B D1               pop  de
 890  883C C1               pop  bc
 891  883D 37               scf
 892  883E C9               ret
 893  883F
 894  883F              .no_conv_collision:
 895  883F E1               pop  hl
 896  8840 D1               pop  de
 897  8841 C1               pop  bc
 898  8842 B7               or   a
 899  8843 C9               ret

1216+ 75F2 28 1B            jr   z, .is_crumbling
1217+ 75F4 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1218+ 75F7 28 1E            jr   z, .is_conveyor
1219+ 75F9 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1220+ 75FC 28 1D            jr   z, .is_nasty1
1221+ 75FE DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1222+ 7601 28 1C            jr   z, .is_nasty2
1223+ 7603 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?

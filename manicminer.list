1148+ 644D              ; -------------------------------------------------------------------
1149+ 644D              ; Gfx_DrawGameOverScreen
1150+ 644D              ; Esegue la sequenza animata di Game Over:
1151+ 644D              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1152+ 644D              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1153+ 644D              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1154+ 644D              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1155+ 644D              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1156+ 644D              ; -------------------------------------------------------------------
1157+ 644D              Gfx_DrawGameOverScreen:
1158+ 644D F5               push af
1159+ 644E C5               push bc
1160+ 644F D5               push de
1161+ 6450 E5               push hl
1162+ 6451 DD E5            push ix
1163+ 6453
1164+ 6453                  ; 1. Bordo hardware e schermo a nero
1165+ 6453 AF               xor  a
1166+ 6454 D3 FE            out  ($fe), a              ; Bordo a nero
1167+ 6456 21 8D 5C         ld   hl, ATTR_P
1168+ 6459 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1169+ 645A CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1170+ 645D 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1171+ 645F 3E 07            ld   a, $07
1172+ 6461 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1173+ 6464
1174+ 6464                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1175+ 6464                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1176+ 6464 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1177+ 6467 DD 21 54 88      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1178+ 646B CD 3F 5E         call Gfx_DrawPixelSprite8x8
1179+ 646E
1180+ 646E                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1181+ 646E 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1182+ 6471 DD 21 5C 88      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1183+ 6475 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1184+ 6478

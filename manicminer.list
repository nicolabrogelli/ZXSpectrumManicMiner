 138+ 7DE0              .done_h_guardians:
 139+ 7DE0                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DE0 2A B3 A1         ld   hl, (room_ptr)
 141+ 7DE3 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DE6 19               add  hl, de
 143+ 7DE7 7E               ld   a, (hl)
 144+ 7DE8 FE FF            cp   $FF
 145+ 7DEA 28 0A            jr   z, .done_v_guardians
 146+ 7DEC B7               or   a
 147+ 7DED 28 07            jr   z, .done_v_guardians
 148+ 7DEF
 149+ 7DEF                  ; Slot attivo per guardiano verticale
 150+ 7DEF DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DF3 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DF6                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DF6
 154+ 7DF6              .done_v_guardians:
 155+ 7DF6 DD E1            pop  ix
 156+ 7DF8 C1               pop  bc
 157+ 7DF9 D1               pop  de
 158+ 7DFA E1               pop  hl
 159+ 7DFB C9               ret

 359  84EC              ; TriggerGameOver
 360  84EC              ; Scatena la schermata di Game Over per la stanza corrente.
 361  84EC              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 362  84EC              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 363  84EC              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 364  84EC              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 365  84EC              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 366  84EC              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 367  84EC              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 368  84EC              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 369  84EC              ; -------------------------------------------------------------------
 370  84EC              TriggerGameOver:
 371  84EC                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 372  84EC CD C3 65         call Gfx_DrawGameOverScreen
 373  84EF
 374  84EF                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 375  84EF              .wait_keys_release:
 376  84EF 76               halt
 377  84F0                  ; Controlla tasto Y (Porta $DF, bit 4)
 378  84F0 01 FE DF         ld   bc, $dffe
 379  84F3 ED 78            in   a, (c)
 380  84F5 CB 67            bit  4, a
 381  84F7 28 F6            jr   z, .wait_keys_release
 382  84F9
 383  84F9                  ; Controlla tasto N (Porta $7F, bit 3)
 384  84F9 01 FE 7F         ld   bc, $7ffe
 385  84FC ED 78            in   a, (c)
 386  84FE CB 5F            bit  3, a
 387  8500 28 ED            jr   z, .wait_keys_release
 388  8502
 389  8502                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 390  8502 01 FE BF         ld   bc, $bffe
 391  8505 ED 78            in   a, (c)
 392  8507 CB 47            bit  0, a
 393  8509 28 E4            jr   z, .wait_keys_release
 394  850B
 395  850B                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 396  850B 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 397  850D              .wait_choice_loop:
 398  850D 76               halt
 399  850E
 400  850E                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 401  850E 0C               inc  c
 402  850F 79               ld   a, c
 403  8510 CB 3F            srl  a
 404  8512 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 405  8514 E6 07            and  7
 406  8516 5F               ld   e, a
 407  8517 16 00            ld   d, 0
 408  8519 21 7F 65         ld   hl, game_over_color_table
 409  851C 19               add  hl, de
 410  851D 7E               ld   a, (hl)               ; A = nuovo colore attributo
 411  851E 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 412  8521 06 09            ld   b, 9
 413  8523              .color_cycle_loop:
 414  8523 77               ld   (hl), a
 415  8524 23               inc  hl
 416  8525 10 FC            djnz .color_cycle_loop
 417  8527
 418  8527                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 419  8527 01 FE DF         ld   bc, $dffe
 420  852A ED 78            in   a, (c)
 421  852C CB 67            bit  4, a
 422  852E 28 2A            jr   z, .continue_chosen
 423  8530
 424  8530                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 425  8530 01 FE 7F         ld   bc, $7ffe
 426  8533 ED 78            in   a, (c)
 427  8535 CB 5F            bit  3, a
 428  8537 28 0B            jr   z, .quit_chosen
 429  8539
 430  8539                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 431  8539 01 FE BF         ld   bc, $bffe
 432  853C ED 78            in   a, (c)
 433  853E CB 47            bit  0, a
 434  8540 28 02            jr   z, .quit_chosen
 435  8542
 436  8542 18 C9            jr   .wait_choice_loop
 437  8544
 438  8544              .quit_chosen:
 439  8544                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 440  8544              .wait_quit_release:
 441  8544 76               halt
 442  8545 01 FE 7F         ld   bc, $7ffe
 443  8548 ED 78            in   a, (c)
 444  854A CB 5F            bit  3, a
 445  854C 28 F6            jr   z, .wait_quit_release
 446  854E 01 FE BF         ld   bc, $bffe
 447  8551 ED 78            in   a, (c)
 448  8553 CB 47            bit  0, a
 449  8555 28 ED            jr   z, .wait_quit_release
 450  8557
 451  8557                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 452  8557 C3 9D 84         jp   ShowTitleScreen
 453  855A
 454  855A              .continue_chosen:
 455  855A                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 456  855A              .wait_continue_release:
 457  855A 76               halt
 458  855B 01 FE DF         ld   bc, $dffe
 459  855E ED 78            in   a, (c)
 460  8560 CB 67            bit  4, a
 461  8562 28 F6            jr   z, .wait_continue_release
 462  8564
 463  8564                  ; 5b. Ripristina lo stato per continuare la partita:
 464  8564                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 465  8564 CD 69 80         call Items_ResetCurrentRoomItems
 466  8567
 467  8567                  ; - Ripristina le vite di Willy al valore iniziale
 468  8567 3E 07            ld   a, INITIAL_LIVES
 469  8569 32 0D 96         ld   (willy_lives), a
 470  856C
 471  856C                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 472  856C 2A 21 96         ld   hl, (counter)
 473  856F 22 24 96         ld   (last_frame_counter), hl
 474  8572
 475  8572                  ; - Reimposta la fisica e le variabili di stato di Willy
 476  8572 AF               xor  a
 477  8573 32 0E 96         ld   (velocity_y), a
 478  8576 32 10 96         ld   (jump_pressed), a
 479  8579 32 12 96         ld   (coyote_timer), a
 480  857C 32 15 96         ld   (jump_frame), a
 481  857F 32 14 96         ld   (jump_dir), a
 482  8582 32 06 96         ld   (body_state), a
 483  8585 32 19 96         ld   (w_warp_state), a
 484  8588 32 1C 96         ld   (w_key_prev), a
 485  858B 32 1D 96         ld   (enter_key_prev), a
 486  858E 32 09 96         ld   (collision_active), a
 487  8591 32 08 96         ld   (flags), a
 488  8594 32 01 9A         ld   (ramp_entry_guard), a
 489  8597 32 0C 9A         ld   (willy_on_ramp), a
 490  859A 32 0B 9A         ld   (willy_needs_redraw), a
 491  859D 3E FF            ld   a, $ff
 492  859F 32 1E 96         ld   (digit_key_prev), a
 493  85A2 32 06 9A         ld   (player_drawn_pos+1), a
 494  85A5 32 07 9A         ld   (player_old_dir), a
 495  85A8 32 08 9A         ld   (player_old_body), a
 496  85AB 3E 01            ld   a, 1
 497  85AD 32 17 96         ld   (q_prev), a
 498  85B0 32 18 96         ld   (a_prev), a
 499  85B3 32 0F 96         ld   (on_ground), a
 500  85B6 32 09 9A         ld   (enemy_was_updated), a
 501  85B9
 502  85B9                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 503  85B9 3E 00            ld   a, RESPAWN_SAFETY_TIME
 504  85BB 32 0A 9A         ld   (willy_safety_timer), a
 505  85BE
 506  85BE                  ; - Ripristina lo stato audio
 507  85BE 3E 12            ld   a, 18
 508  85C0 32 19 9C         ld   (Audio_jump_sound_note), a
 509  85C3 AF               xor  a
 510  85C4 32 1A 9C         ld   (Audio_jump_sound_timer), a
 511  85C7                  IF ENABLE_MUSIC != 0
 512  85C7 ~                ld   (Audio_music_note_idx), a
 513  85C7 ~                ld   a, 1
 514  85C7 ~                ld   (Audio_music_frame_counter), a
 515  85C7                  ENDIF
 516  85C7
 517  85C7                  ; - Riposiziona Willy nel punto di default definito nella stanza
 518  85C7 AF               xor  a
 519  85C8 32 86 99         ld   (transition_active), a
 520  85CB
 521  85CB                  ; - Cancella lo schermo a nero prima del caricamento
 522  85CB AF               xor  a
 523  85CC D3 FE            out  ($fe), a
 524  85CE 21 8D 5C         ld   hl, ATTR_P
 525  85D1 77               ld   (hl), a
 526  85D2 CD AF 0D         call CLS
 527  85D5 36 07            ld   (hl), $07
 528  85D7 3E 07            ld   a, $07
 529  85D9 32 8F 5C         ld   (ATTR_T), a
 530  85DC
 531  85DC                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 532  85DC C3 6E 83         jp   LoadRoomAndRestart
 533  85DF
 534  85DF              ; -------------------------------------------------------------------
 535  85DF              ; TriggerVictory
 536  85DF              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 537  85DF              ; - Pulisce gli elementi di gioco della stanza.
 538  85DF              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 539  85DF              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 540  85DF              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 541  85DF              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 542  85DF              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 543  85DF              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 544  85DF              ; -------------------------------------------------------------------
 545  85DF              TriggerVictory:
 546  85DF                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 547  85DF CD DC 66         call Gfx_DrawVictoryScreen
 548  85E2
 549  85E2                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 550  85E2              .wait_keys_release:
 551  85E2 76               halt
 552  85E3                  ; Controlla tasto Y (Porta $DF, bit 4)
 553  85E3 01 FE DF         ld   bc, $dffe
 554  85E6 ED 78            in   a, (c)
 555  85E8 CB 67            bit  4, a
 556  85EA 28 F6            jr   z, .wait_keys_release
 557  85EC
 558  85EC                  ; Controlla tasto N (Porta $7F, bit 3)
 559  85EC 01 FE 7F         ld   bc, $7ffe
 560  85EF ED 78            in   a, (c)
 561  85F1 CB 5F            bit  3, a
 562  85F3 28 ED            jr   z, .wait_keys_release
 563  85F5
 564  85F5                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 565  85F5 01 FE BF         ld   bc, $bffe
 566  85F8 ED 78            in   a, (c)
 567  85FA CB 47            bit  0, a
 568  85FC 28 E4            jr   z, .wait_keys_release
 569  85FE
 570  85FE                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 571  85FE 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 572  8600              .wait_choice_loop:
 573  8600 76               halt
 574  8601
 575  8601                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 576  8601 0C               inc  c
 577  8602 79               ld   a, c
 578  8603 CB 3F            srl  a
 579  8605 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 580  8607 E6 07            and  7
 581  8609 5F               ld   e, a
 582  860A 16 00            ld   d, 0
 583  860C 21 BB 65         ld   hl, victory_color_table
 584  860F 19               add  hl, de
 585  8610 7E               ld   a, (hl)               ; A = nuovo colore attributo
 586  8611 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 587  8614 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 588  8616              .color_cycle_loop:
 589  8616 77               ld   (hl), a
 590  8617 23               inc  hl
 591  8618 10 FC            djnz .color_cycle_loop
 592  861A
 593  861A                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 594  861A 01 FE DF         ld   bc, $dffe
 595  861D ED 78            in   a, (c)
 596  861F CB 67            bit  4, a
 597  8621 28 2A            jr   z, .play_again_chosen
 598  8623
 599  8623                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 600  8623 01 FE 7F         ld   bc, $7ffe
 601  8626 ED 78            in   a, (c)
 602  8628 CB 5F            bit  3, a
 603  862A 28 0B            jr   z, .quit_chosen
 604  862C
 605  862C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 606  862C 01 FE BF         ld   bc, $bffe
 607  862F ED 78            in   a, (c)
 608  8631 CB 47            bit  0, a
 609  8633 28 02            jr   z, .quit_chosen
 610  8635
 611  8635 18 C9            jr   .wait_choice_loop
 612  8637
 613  8637              .quit_chosen:
 614  8637                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 615  8637              .wait_quit_release:
 616  8637 76               halt
 617  8638 01 FE 7F         ld   bc, $7ffe
 618  863B ED 78            in   a, (c)
 619  863D CB 5F            bit  3, a
 620  863F 28 F6            jr   z, .wait_quit_release
 621  8641 01 FE BF         ld   bc, $bffe
 622  8644 ED 78            in   a, (c)
 623  8646 CB 47            bit  0, a
 624  8648 28 ED            jr   z, .wait_quit_release
 625  864A
 626  864A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 627  864A C3 9D 84         jp   ShowTitleScreen
 628  864D
 629  864D              .play_again_chosen:
 630  864D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 631  864D              .wait_play_again_release:
 632  864D 76               halt
 633  864E 01 FE DF         ld   bc, $dffe
 634  8651 ED 78            in   a, (c)
 635  8653 CB 67            bit  4, a
 636  8655 28 F6            jr   z, .wait_play_again_release
 637  8657
 638  8657                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 639  8657 CD 5B 87         call ResetFullGameState
 640  865A C3 6E 83         jp   LoadRoomAndRestart
 641  865D
 642  865D              ; -------------------------------------------------------------------
 643  865D              ; CheckPortalTransition
 644  865D              ; Verifica le condizioni per accedere alla stanza successiva:
 645  865D              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 646  865D              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 647  865D              ;
 648  865D              ; Output:
 649  865D              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 650  865D              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 651  865D              ; -------------------------------------------------------------------
 652  865D              CheckPortalTransition:
 653  865D C5               push bc
 654  865E D5               push de
 655  865F E5               push hl
 656  8660
 657  8660                  ; 1. Tutti gli item della stanza sono stati raccolti?
 658  8660 CD EE 86         call CheckAllItemsCollected
 659  8663 30 4D            jr   nc, .no_transition
 660  8665
 661  8665                  ; 2. Willy collide con il portale (16x16 pixel)?
 662  8665                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 663  8665                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 664  8665 2A 80 99         ld   hl, (room_ptr)
 665  8668 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 666  866B 19               add  hl, de
 667  866C 4E               ld   c, (hl)
 668  866D 23               inc  hl
 669  866E 46               ld   b, (hl)                   ; BC = AttrAddr
 670  866F
 671  866F                  ; Offset = BC - 23552
 672  866F 60               ld   h, b
 673  8670 69               ld   l, c
 674  8671 01 00 A4         ld   bc, -23552
 675  8674 09               add  hl, bc
 676  8675
 677  8675                  ; PortalX = (Offset & 31) * 8
 678  8675 7D               ld   a, l
 679  8676 E6 1F            and  31
 680  8678 87               add  a, a
 680  8679 87             add a, a
 680  867A 87             add a, a
 681  867B 5F               ld   e, a                      ; E = PortalX (0..248)
 682  867C
 683  867C                  ; PortalY = (Offset / 32) * 8
 684  867C CB 3C            srl  h
 684  867E CB 1D          rr l
 685  8680 CB 3C            srl  h
 685  8682 CB 1D          rr l
 686  8684 CB 3C            srl  h
 686  8686 CB 1D          rr l
 687  8688 CB 3C            srl  h
 687  868A CB 1D          rr l
 688  868C CB 3C            srl  h
 688  868E CB 1D          rr l
 689  8690 7D               ld   a, l
 690  8691 87               add  a, a
 690  8692 87             add a, a
 690  8693 87             add a, a
 691  8694 57               ld   d, a                      ; D = PortalY (0..120)
 692  8695
 693  8695                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 694  8695 ED 4B 00 96      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 695  8699
 696  8699                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 697  8699 7B               ld   a, e
 698  869A 91               sub  c
 699  869B 30 02            jr   nc, .x_diff_pos
 700  869D ED 44            neg
 701  869F              .x_diff_pos:
 702  869F FE 0C            cp   12
 703  86A1 30 0F            jr   nc, .no_transition
 704  86A3
 705  86A3                  ; Controllo verticale: |WillyY - PortalY| < 14
 706  86A3 7A               ld   a, d
 707  86A4 90               sub  b
 708  86A5 30 02            jr   nc, .y_diff_pos
 709  86A7 ED 44            neg
 710  86A9              .y_diff_pos:
 711  86A9 FE 0E            cp   14
 712  86AB 30 05            jr   nc, .no_transition
 713  86AD
 714  86AD                  ; Transizione al portale attiva!
 715  86AD E1               pop  hl
 716  86AE D1               pop  de
 717  86AF C1               pop  bc
 718  86B0 37               scf
 719  86B1 C9               ret
 720  86B2
 721  86B2              .no_transition:
 722  86B2 E1               pop  hl
 723  86B3 D1               pop  de
 724  86B4 C1               pop  bc
 725  86B5 B7               or   a
 726  86B6 C9               ret
 727  86B7
 728  86B7              ; Alias per retrocompatibilità
 729  86B7              CheckVictoryCondition: EQU CheckPortalTransition
 730  86B7
 731  86B7              ; -------------------------------------------------------------------
 732  86B7              ; TriggerPortalTransition
 733  86B7              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 734  86B7              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 735  86B7              ; - Avanza all'indice della stanza successiva.
 736  86B7              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 737  86B7              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 738  86B7              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 739  86B7              ; -------------------------------------------------------------------
 740  86B7              TriggerPortalTransition:
 741  86B7                  ; 1. Determina l'ID della stanza corrente
 742  86B7 CD 1A 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 743  86BA
 744  86BA                  ; 2. Calcola l'indice della stanza successiva
 745  86BA 3A 26 99         ld   a, (current_room)
 746  86BD 3C               inc  a
 747  86BE FE 02            cp   NUM_ROOMS
 748  86C0 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 749  86C2
 750  86C2                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 751  86C2 21 04 73         ld   hl, RoomsListTable
 752  86C5 5F               ld   e, a
 753  86C6 16 00            ld   d, 0
 754  86C8 19               add  hl, de
 755  86C9 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 756  86CA 5E               ld   e, (hl)
 757  86CB 23               inc  hl
 758  86CC 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 759  86CD ED 53 80 99      ld   (room_ptr), de
 760  86D1
 761  86D1                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 762  86D1 AF               xor  a
 763  86D2 32 86 99         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 764  86D5 32 0E 96         ld   (velocity_y), a
 765  86D8 32 15 9C         ld   (game_objective_completed), a
 766  86DB 3E 01            ld   a, 1
 767  86DD 32 0F 96         ld   (on_ground), a
 768  86E0
 769  86E0                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 770  86E0 21 8D 5C         ld   hl, ATTR_P
 771  86E3 36 07            ld   (hl), $07
 772  86E5 CD AF 0D         call CLS
 773  86E8
 774  86E8 C3 6E 83         jp   LoadRoomAndRestart
 775  86EB
 776  86EB              .all_rooms_completed:
 777  86EB                  ; Tutte le stanze sono state completate con successo!
 778  86EB                  IF ENABLE_VICTORY_SCREEN != 0
 779  86EB C3 DF 85         jp   TriggerVictory
 780  86EE                  ELSE
 781  86EE ~                ; Ricomincia dalla prima stanza (Stanza 00)
 782  86EE ~                ld   de, (RoomsListTable)
 783  86EE ~                ld   (room_ptr), de
 784  86EE ~                xor  a
 785  86EE ~                ld   (transition_active), a
 786  86EE ~                ld   (velocity_y), a
 787  86EE ~                ld   (game_objective_completed), a
 788  86EE ~                ld   a, 1
 789  86EE ~                ld   (on_ground), a
 790  86EE ~                ld   hl, ATTR_P
 791  86EE ~                ld   (hl), $07
 792  86EE ~                call CLS
 793  86EE ~                jp   LoadRoomAndRestart
 794  86EE                  ENDIF
 795  86EE
 796  86EE              ; -------------------------------------------------------------------
 797  86EE              ; CheckAllItemsCollected
 798  86EE              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 799  86EE              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti

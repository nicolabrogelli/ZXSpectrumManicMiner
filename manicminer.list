 105+ 7CE8 7D               ld   a, l
 106+ 7CE9 87               add  a, a
 106+ 7CEA 87             add a, a
 106+ 7CEB 87             add a, a
 107+ 7CEC DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 108+ 7CEF C1               pop  bc
 109+ 7CF0 E1               pop  hl
 110+ 7CF1
 111+ 7CF1 23               inc  hl
 112+ 7CF2 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 113+ 7CF3 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 114+ 7CF7
 115+ 7CF7 23               inc  hl
 116+ 7CF8 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 117+ 7CF9 E6 01            and  1
 118+ 7CFB 28 04            jr   z, .h_dir_right
 119+ 7CFD 3E 01            ld   a, 1                      ; 1 = Sinistra
 120+ 7CFF 18 02            jr   .set_h_dir
 121+ 7D01              .h_dir_right:
 122+ 7D01 3E 02            ld   a, 2                      ; 2 = Destra
 123+ 7D03              .set_h_dir:
 124+ 7D03 DD 77 06         ld   (ix+6), a                 ; Direction
 125+ 7D06
 126+ 7D06 23               inc  hl
 127+ 7D07 7E               ld   a, (hl)                   ; Byte 5: Min limit
 128+ 7D08 E6 1F            and  31
 129+ 7D0A 87               add  a, a
 129+ 7D0B 87             add a, a
 129+ 7D0C 87             add a, a
 130+ 7D0D DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 131+ 7D10
 132+ 7D10 23               inc  hl
 133+ 7D11 7E               ld   a, (hl)                   ; Byte 6: Max limit
 134+ 7D12 E6 1F            and  31
 135+ 7D14 87               add  a, a
 135+ 7D15 87             add a, a
 135+ 7D16 87             add a, a
 136+ 7D17 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 137+ 7D1A
 138+ 7D1A 23               inc  hl                        ; Prossimo guardiano
 139+ 7D1B 11 0B 00         ld   de, 11
 140+ 7D1E DD 19            add  ix, de
 141+ 7D20 18 04            jr   .next_h_loop
 142+ 7D22
 143+ 7D22              .skip_h_guardian:
 144+ 7D22 11 07 00         ld   de, 7
 145+ 7D25 19               add  hl, de                    ; Salta 7 byte dei dati stanza
 146+ 7D26
 147+ 7D26              .next_h_loop:

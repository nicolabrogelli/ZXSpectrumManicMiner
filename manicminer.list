 694+ 8582              .new_high_score:
 695+ 8582 3A AE E6         ld   a, (player_score + 0)
 696+ 8585 32 B1 E6         ld   (high_score + 0), a
 697+ 8588 3A AF E6         ld   a, (player_score + 1)
 698+ 858B 32 B2 E6         ld   (high_score + 1), a
 699+ 858E 3A B0 E6         ld   a, (player_score + 2)
 700+ 8591 32 B3 E6         ld   (high_score + 2), a
 701+ 8594
 702+ 8594              .done_check:
 703+ 8594 C9               ret

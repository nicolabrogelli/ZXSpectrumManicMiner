 208+ 7A58              .erase_loop:
 209+ 7A58 DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7A5B E6 80            and  $80               ; Active?
 211+ 7A5D 28 3A            jr   z, .next_erase
 212+ 7A5F
 213+ 7A5F                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7A5F DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7A62 FE FF            cp   $FF
 216+ 7A64 28 33            jr   z, .next_erase
 217+ 7A66
 218+ 7A66                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7A66 DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7A69 DD BE 02         cp   (ix+2)            ; Current X

  71+ 8316 ~            ; -------------------------------------------------------------------
  72+ 8316 ~            ; Audio_UpdateMusic
  73+ 8316 ~            ;
  74+ 8316 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8316 ~            ; Viene chiamata a ogni frame.
  76+ 8316 ~            ; -------------------------------------------------------------------
  77+ 8316 ~            Audio_UpdateMusic:
  78+ 8316 ~                push af
  79+ 8316 ~                push bc
  80+ 8316 ~                push de
  81+ 8316 ~                push hl
  82+ 8316 ~
  83+ 8316 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8316 ~                ld   a, (Audio_jump_sound_note)
  85+ 8316 ~                cp   18
  86+ 8316 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8316 ~
  88+ 8316 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8316 ~                ld   a, (Audio_music_frame_counter)
  90+ 8316 ~                dec  a
  91+ 8316 ~                ld   (Audio_music_frame_counter), a
  92+ 8316 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8316 ~
  94+ 8316 ~                ; Altrimenti carica la nota successiva
  95+ 8316 ~                ld   a, (Audio_music_note_idx)
  96+ 8316 ~                inc  a
  97+ 8316 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8316 ~                jr   c, .no_wrap
  99+ 8316 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8316 ~            .no_wrap:
 101+ 8316 ~                ld   (Audio_music_note_idx), a
 102+ 8316 ~
 103+ 8316 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8316 ~                ld   e, a
 105+ 8316 ~                ld   d, 0
 106+ 8316 ~                ld   hl, Audio_MusicSheet
 107+ 8316 ~                add  hl, de
 108+ 8316 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8316 ~
 110+ 8316 ~                ; Leggi durata (secondo byte)
 111+ 8316 ~                inc  hl
 112+ 8316 ~                ld   a, (hl)
 113+ 8316 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8316 ~                jr   nz, .dur_ok
 115+ 8316 ~                ld   a, 1
 116+ 8316 ~            .dur_ok:
 117+ 8316 ~                ld   (Audio_music_frame_counter), a
 118+ 8316 ~
 119+ 8316 ~            .play_current_note:
 120+ 8316 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8316 ~                ld   a, (Audio_music_note_idx)
 122+ 8316 ~                ld   e, a
 123+ 8316 ~                ld   d, 0
 124+ 8316 ~                ld   hl, Audio_MusicSheet
 125+ 8316 ~                add  hl, de
 126+ 8316 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8316 ~                ld   a, (hl)                  ; A = delay
 128+ 8316 ~                or   a
 129+ 8316 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8316 ~
 131+ 8316 ~                ; Suona la nota: 2 cicli
 132+ 8316 ~                ld   d, a                     ; D = delay
 133+ 8316 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8316 ~            .note_loop:
 135+ 8316 ~                ; Speaker ON
 136+ 8316 ~                ld   a, (room_border_color)
 137+ 8316 ~                or   $10
 138+ 8316 ~                out  ($fe), a
 139+ 8316 ~                ld   c, d
 140+ 8316 ~            .d1:
 141+ 8316 ~                push af
 142+ 8316 ~                pop  af
 143+ 8316 ~                dec  c
 144+ 8316 ~                jr   nz, .d1
 145+ 8316 ~
 146+ 8316 ~                ; Speaker OFF
 147+ 8316 ~                ld   a, (room_border_color)
 148+ 8316 ~                and  $ef
 149+ 8316 ~                out  ($fe), a
 150+ 8316 ~                ld   c, d
 151+ 8316 ~            .d2:
 152+ 8316 ~                push af
 153+ 8316 ~                pop  af
 154+ 8316 ~                dec  c
 155+ 8316 ~                jr   nz, .d2
 156+ 8316 ~
 157+ 8316 ~                djnz .note_loop
 158+ 8316 ~
 159+ 8316 ~            .done:
 160+ 8316 ~                pop  hl
 161+ 8316 ~                pop  de
 162+ 8316 ~                pop  bc
 163+ 8316 ~                pop  af
 164+ 8316 ~                ret
 165+ 8316 ~
 166+ 8316 ~            Audio_MusicSheet:
 167+ 8316 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8316 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8316 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8316 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8316 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8316 ~                db 90, 10, 107, 20, 68, 65
 173+ 8316                  ELSE
 174+ 8316              Audio_UpdateMusic:
 175+ 8316 C9               ret
 176+ 8317                  ENDIF

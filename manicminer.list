  78+ 7D61 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7D64
  80+ 7D64 23               inc  hl
  81+ 7D65 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7D66 23               inc  hl
  83+ 7D67 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7D68
  85+ 7D68                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7D68 E5               push hl
  87+ 7D69 C5               push bc
  88+ 7D6A 67               ld   h, a
  89+ 7D6B 69               ld   l, c
  90+ 7D6C 01 00 A4         ld   bc, -23552

 448+ 8620                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8620 BB               cp   e                         ; E = ItemLeft
 450+ 8621 28 0B            jr   z, .y_check
 451+ 8623 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8625
 453+ 8625                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 8625 C6 0F            add  a, 15
 455+ 8627 BB               cp   e
 456+ 8628 28 04            jr   z, .y_check
 457+ 862A 30 02            jr   nc, .y_check
 458+ 862C 18 23            jr   .no_collision
 459+ 862E

2084+ 7D7A              ; Phys_UpdateAir
2085+ 7D7A              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2086+ 7D7A              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2087+ 7D7A              ; Output:
2088+ 7D7A              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2089+ 7D7A              ;   Carry Clear = Aria ancora disponibile
2090+ 7D7A              ; -------------------------------------------------------------------
2091+ 7D7A              Phys_UpdateAir:
2092+ 7D7A                  ; Incrementa il timer dei frame
2093+ 7D7A 3A 0D F1         ld   a, (air_timer)
2094+ 7D7D 3C               inc  a
2095+ 7D7E 32 0D F1         ld   (air_timer), a
2096+ 7D81 21 0E F1         ld   hl, air_deplete_rate
2097+ 7D84 BE               cp   (hl)
2098+ 7D85 38 14            jr   c, .no_deplete
2099+ 7D87
2100+ 7D87                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2101+ 7D87 AF               xor  a
2102+ 7D88 32 0D F1         ld   (air_timer), a
2103+ 7D8B
2104+ 7D8B 3A 0C F1         ld   a, (air_pixels)
2105+ 7D8E B7               or   a
2106+ 7D8F 28 0C            jr   z, .air_finished
2107+ 7D91
2108+ 7D91 3D               dec  a
2109+ 7D92 32 0C F1         ld   (air_pixels), a
2110+ 7D95 CD 2D 6A         call Gfx_UpdateAirBar
2111+ 7D98
2112+ 7D98 B7               or   a
2113+ 7D99 28 02            jr   z, .air_finished
2114+ 7D9B
2115+ 7D9B              .no_deplete:
2116+ 7D9B B7               or   a                     ; Carry Clear = Ok
2117+ 7D9C C9               ret
2118+ 7D9D
2119+ 7D9D              .air_finished:
2120+ 7D9D 37               scf                        ; Carry Set = Morte per esaurimento aria
2121+ 7D9E C9               ret

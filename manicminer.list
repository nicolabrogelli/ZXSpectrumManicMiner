1053+ 77FD              ; -------------------------------------------------------------------
1054+ 77FD              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 77FD              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 77FD              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 77FD              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 77FD              ; -------------------------------------------------------------------
1059+ 77FD              UnpackRoomLayout:
1060+ 77FD E5               push hl
1061+ 77FE D5               push de
1062+ 77FF C5               push bc
1063+ 7800 DD E5            push ix
1064+ 7802
1065+ 7802 DD 2A EA AD      ld   ix, (room_ptr)
1066+ 7806 11 20 02         ld   de, OFFSET_TILES
1067+ 7809 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 780B
1069+ 780B 2A EA AD         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 780E 11 8F AB         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 7811 01 00 02         ld   bc, 512               ; 512 celle
1072+ 7814
1073+ 7814              .byte_loop:
1074+ 7814 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 7815 23               inc  hl
1076+ 7816
1077+ 7816                  ; Confronta con le 8 definizioni di tile:
1078+ 7816 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7819 28 23            jr   z, .is_bg
1080+ 781B DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 781E 28 29            jr   z, .is_wall
1082+ 7820 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 7823 28 1C            jr   z, .is_floor
1084+ 7825 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7828 28 1B            jr   z, .is_crumbling
1086+ 782A DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 782D 28 1E            jr   z, .is_conveyor
1088+ 782F DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 7832 28 1D            jr   z, .is_nasty1
1090+ 7834 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 7837 28 1C            jr   z, .is_nasty2
1092+ 7839 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 783C 28 1B            jr   z, .is_extra

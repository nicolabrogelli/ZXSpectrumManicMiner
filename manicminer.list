2007+ 68BA              ; Disegna un carattere ASCII A alla colonna C (0..31) di Riga 23 direttamente in VRAM
2008+ 68BA              ; -------------------------------------------------------------------
2009+ 68BA              Gfx_DrawCharVRAM_Row23:
2010+ 68BA F5               push af
2011+ 68BB C5               push bc
2012+ 68BC D5               push de
2013+ 68BD E5               push hl
2014+ 68BE
2015+ 68BE                  ; C = colonna (0..31), A = carattere ASCII
2016+ 68BE 47               ld   b, a              ; B = salva carattere ASCII
2017+ 68BF 79               ld   a, c
2018+ 68C0 FE 20            cp   32
2019+ 68C2 30 2E            jr   nc, .exit_draw_char ; Se C >= 32, ignora per sicurezza!
2020+ 68C4
2021+ 68C4                  ; Check dei limiti ASCII (32..127) per non accedere a RAM fuori dal font
2022+ 68C4 78               ld   a, b              ; A = carattere ASCII
2023+ 68C5 FE 20            cp   32
2024+ 68C7 38 29            jr   c, .exit_draw_char ; Se CHAR < 32 (non stampabile), ignora!
2025+ 68C9 FE 80            cp   128
2026+ 68CB 30 25            jr   nc, .exit_draw_char ; Se CHAR >= 128 (fuori dal font RAM), ignora!
2027+ 68CD
2028+ 68CD                  ; 1. Indirizzo del font in RAM (font_buffer + 256 + (ASCII - 32) * 8)
2029+ 68CD D6 20            sub  32                ; A = ASCII - 32
2030+ 68CF 6F               ld   l, a
2031+ 68D0 26 00            ld   h, 0
2032+ 68D2 29               add  hl, hl            ; *2
2033+ 68D3 29               add  hl, hl            ; *4
2034+ 68D4 29               add  hl, hl            ; *8
2035+ 68D5 11 94 89         ld   de, font_buffer + 256 ; Indirizzo base del font 8x8 in RAM (ASCII 32)
2036+ 68D8 19               add  hl, de            ; HL = indirizzo pattern font 8x8 in RAM
2037+ 68D9
2038+ 68D9                  ; 2. Imposta l'attributo colore a Riga 23, Colonna C ($5AE0 + C)
2039+ 68D9 E5               push hl                ; Salva indirizzo pattern font
2040+ 68DA 69               ld   l, c
2041+ 68DB 26 00            ld   h, 0

  86+ 805A 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 805C 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 805D 23               inc  hl                        ; +2 (Attr Address High)
  89+ 805E 23               inc  hl                        ; +3 (Anim mask)
  90+ 805F 23               inc  hl                        ; +4 (Collected flag)
  91+ 8060 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 8062 23               inc  hl                        ; Avanza al prossimo item
  93+ 8063 18 F2            jr   .item_loop
  94+ 8065
  95+ 8065              .next_room:

 105+ 7D2D 7D               ld   a, l
 106+ 7D2E 87               add  a, a
 106+ 7D2F 87             add a, a
 106+ 7D30 87             add a, a
 107+ 7D31 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 108+ 7D34 C1               pop  bc
 109+ 7D35 E1               pop  hl
 110+ 7D36
 111+ 7D36 23               inc  hl
 112+ 7D37 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 113+ 7D38 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 114+ 7D3C
 115+ 7D3C 23               inc  hl
 116+ 7D3D 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 117+ 7D3E E6 01            and  1

 142+ 8549              ; Items_DrawRoom
 143+ 8549              ;
 144+ 8549              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 8549              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 8549              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 8549              ;
 148+ 8549              ; Record item nella stanza (5 byte):
 149+ 8549              ;   +0 Color / Attributo
 150+ 8549              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 8549              ;   +2 Attr Address High
 152+ 8549              ;   +3 Anim Mask (96)
 153+ 8549              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 8549              ; Fine lista: $FF
 155+ 8549              ; -------------------------------------------------------------------
 156+ 8549              Items_DrawRoom:
 157+ 8549 E5               push hl
 158+ 854A D5               push de
 159+ 854B C5               push bc
 160+ 854C DD E5            push ix
 161+ 854E FD E5            push iy

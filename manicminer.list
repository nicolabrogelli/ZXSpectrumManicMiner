 293+ 859F              ; DrawItemGraphic
 294+ 859F              ;
 295+ 859F              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 859F              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 859F              ;
 298+ 859F              ; Input:
 299+ 859F              ;   B = Riga attributi (0..23)
 300+ 859F              ;   C = Colonna attributi (0..31)
 301+ 859F              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 859F              ;   E = Attributo colore
 303+ 859F              ; -------------------------------------------------------------------
 304+ 859F              DrawItemGraphic:
 305+ 859F C5               push bc
 306+ 85A0 D5               push de
 307+ 85A1 E5               push hl
 308+ 85A2
 309+ 85A2                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 310+ 85A2 78               ld   a, b
 311+ 85A3 E6 18            and  $18
 312+ 85A5 C6 40            add  a, $40
 313+ 85A7 57               ld   d, a                      ; Byte alto indirizzo video
 314+ 85A8
 315+ 85A8 78               ld   a, b
 316+ 85A9 E6 07            and  7
 317+ 85AB 87               add  a, a                      ; *2
 318+ 85AC 87               add  a, a                      ; *4
 319+ 85AD 87               add  a, a                      ; *8
 320+ 85AE 87               add  a, a                      ; *16
 321+ 85AF 87               add  a, a                      ; *32
 322+ 85B0 81               add  a, c                      ; + Col
 323+ 85B1 5F               ld   e, a                      ; Byte basso indirizzo video
 324+ 85B2
 325+ 85B2 C5               push bc
 326+ 85B3 06 08            ld   b, 8                      ; 8 scanline
 327+ 85B5              .line_loop:
 328+ 85B5 7E               ld   a, (hl)
 329+ 85B6 12               ld   (de), a
 330+ 85B7 14               inc  d
 331+ 85B8 23               inc  hl
 332+ 85B9 05               dec  b
 333+ 85BA 20 F9            jr   nz, .line_loop
 334+ 85BC C1               pop  bc

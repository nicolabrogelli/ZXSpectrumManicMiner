1660+ 7ACF 3E 06            ld   a, DEFAULT_JUMP_STRENGTH
1661+ 7AD1 32 F1 E1         ld   (room_jump_strength), a
1662+ 7AD4 3E 01            ld   a, DEFAULT_GRAVITY_PRESET
1663+ 7AD6 32 F2 E1         ld   (room_gravity_preset), a
1664+ 7AD9 F1               pop  af
1665+ 7ADA C9               ret

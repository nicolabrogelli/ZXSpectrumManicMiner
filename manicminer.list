  96+ 7E42 87             add a, a
  96+ 7E43 87             add a, a
  97+ 7E44 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7E47
  99+ 7E47                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7E47 CB 3C            srl  h
 100+ 7E49 CB 1D          rr l
 101+ 7E4B CB 3C            srl  h
 101+ 7E4D CB 1D          rr l

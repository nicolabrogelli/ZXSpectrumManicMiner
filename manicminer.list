 453  8B35 18 C9            jr   .wait_choice_loop
 454  8B37
 455  8B37              .quit_chosen:
 456  8B37                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 457  8B37              .wait_quit_release:
 458  8B37 76               halt
 459  8B38 01 FE 7F         ld   bc, $7ffe
 460  8B3B ED 78            in   a, (c)
 461  8B3D CB 5F            bit  3, a
 462  8B3F 28 F6            jr   z, .wait_quit_release
 463  8B41 01 FE BF         ld   bc, $bffe
 464  8B44 ED 78            in   a, (c)
 465  8B46 CB 47            bit  0, a
 466  8B48 28 ED            jr   z, .wait_quit_release
 467  8B4A
 468  8B4A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 469  8B4A C3 92 8A         jp   ShowTitleScreen
 470  8B4D
 471  8B4D              .play_again_chosen:
 472  8B4D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 473  8B4D              .wait_play_again_release:
 474  8B4D 76               halt
 475  8B4E 01 FE DF         ld   bc, $dffe
 476  8B51 ED 78            in   a, (c)
 477  8B53 CB 67            bit  4, a
 478  8B55 28 F6            jr   z, .wait_play_again_release
 479  8B57
 480  8B57                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 481  8B57 CD 91 8C         call ResetFullGameState
 482  8B5A C3 50 89         jp   LoadRoomAndRestart
 483  8B5D
 484  8B5D              ; -------------------------------------------------------------------
 485  8B5D              ; CheckPortalTransition
 486  8B5D              ; Verifica le condizioni per accedere alla stanza successiva:
 487  8B5D              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 488  8B5D              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 489  8B5D              ;
 490  8B5D              ; Output:
 491  8B5D              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 492  8B5D              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 493  8B5D              ; -------------------------------------------------------------------
 494  8B5D              CheckPortalTransition:
 495  8B5D C5               push bc
 496  8B5E D5               push de
 497  8B5F E5               push hl
 498  8B60
 499  8B60                  ; 1. Tutti gli item della stanza sono stati raccolti?
 500  8B60 CD 24 8C         call CheckAllItemsCollected
 501  8B63 30 4D            jr   nc, .no_transition
 502  8B65
 503  8B65                  ; 2. Willy collide con il portale (16x16 pixel)?
 504  8B65                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 505  8B65                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 506  8B65 2A AD EE         ld   hl, (room_ptr)
 507  8B68 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 508  8B6B 19               add  hl, de
 509  8B6C 4E               ld   c, (hl)
 510  8B6D 23               inc  hl
 511  8B6E 46               ld   b, (hl)                   ; BC = AttrAddr
 512  8B6F
 513  8B6F                  ; Offset = BC - 23552
 514  8B6F 60               ld   h, b
 515  8B70 69               ld   l, c
 516  8B71 01 00 A4         ld   bc, -23552
 517  8B74 09               add  hl, bc
 518  8B75
 519  8B75                  ; PortalX = (Offset & 31) * 8
 520  8B75 7D               ld   a, l
 521  8B76 E6 1F            and  31
 522  8B78 87               add  a, a
 522  8B79 87             add a, a
 522  8B7A 87             add a, a
 523  8B7B 5F               ld   e, a                      ; E = PortalX (0..248)
 524  8B7C
 525  8B7C                  ; PortalY = (Offset / 32) * 8
 526  8B7C CB 3C            srl  h
 526  8B7E CB 1D          rr l
 527  8B80 CB 3C            srl  h
 527  8B82 CB 1D          rr l
 528  8B84 CB 3C            srl  h
 528  8B86 CB 1D          rr l
 529  8B88 CB 3C            srl  h
 529  8B8A CB 1D          rr l
 530  8B8C CB 3C            srl  h
 530  8B8E CB 1D          rr l
 531  8B90 7D               ld   a, l
 532  8B91 87               add  a, a
 532  8B92 87             add a, a
 532  8B93 87             add a, a
 533  8B94 57               ld   d, a                      ; D = PortalY (0..120)
 534  8B95
 535  8B95                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 536  8B95 ED 4B 2B EB      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 537  8B99
 538  8B99                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 539  8B99 7B               ld   a, e
 540  8B9A 91               sub  c
 541  8B9B 30 02            jr   nc, .x_diff_pos
 542  8B9D ED 44            neg
 543  8B9F              .x_diff_pos:
 544  8B9F FE 0C            cp   12
 545  8BA1 30 0F            jr   nc, .no_transition
 546  8BA3
 547  8BA3                  ; Controllo verticale: |WillyY - PortalY| < 14
 548  8BA3 7A               ld   a, d
 549  8BA4 90               sub  b
 550  8BA5 30 02            jr   nc, .y_diff_pos
 551  8BA7 ED 44            neg
 552  8BA9              .y_diff_pos:
 553  8BA9 FE 0E            cp   14
 554  8BAB 30 05            jr   nc, .no_transition
 555  8BAD
 556  8BAD                  ; Transizione al portale attiva!
 557  8BAD E1               pop  hl
 558  8BAE D1               pop  de
 559  8BAF C1               pop  bc
 560  8BB0 37               scf
 561  8BB1 C9               ret
 562  8BB2
 563  8BB2              .no_transition:
 564  8BB2 E1               pop  hl
 565  8BB3 D1               pop  de
 566  8BB4 C1               pop  bc
 567  8BB5 B7               or   a
 568  8BB6 C9               ret
 569  8BB7
 570  8BB7              ; Alias per retrocompatibilità
 571  8BB7              CheckVictoryCondition: EQU CheckPortalTransition
 572  8BB7
 573  8BB7              ; -------------------------------------------------------------------
 574  8BB7              ; TriggerPortalTransition
 575  8BB7              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 576  8BB7              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 577  8BB7              ; - Avanza all'indice della stanza successiva.
 578  8BB7              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 579  8BB7              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 580  8BB7              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 581  8BB7              ; -------------------------------------------------------------------
 582  8BB7              TriggerPortalTransition:
 583  8BB7                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 584  8BB7 CD EE 8B         call Air_DepleteCountdown
 585  8BBA
 586  8BBA                  ; 1. Determina l'ID della stanza corrente
 587  8BBA CD 7B 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 588  8BBD
 589  8BBD                  ; 2. Calcola l'indice della stanza successiva
 590  8BBD 3A 52 EE         ld   a, (current_room)
 591  8BC0 3C               inc  a
 592  8BC1 FE 14            cp   NUM_ROOMS
 593  8BC3 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 594  8BC5
 595  8BC5                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 596  8BC5 21 C8 73         ld   hl, RoomsListTable
 597  8BC8 5F               ld   e, a
 598  8BC9 16 00            ld   d, 0
 599  8BCB 19               add  hl, de
 600  8BCC 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 601  8BCD 5E               ld   e, (hl)
 602  8BCE 23               inc  hl
 603  8BCF 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 604  8BD0 ED 53 AD EE      ld   (room_ptr), de
 605  8BD4
 606  8BD4                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 607  8BD4 AF               xor  a
 608  8BD5 32 B3 EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 609  8BD8 32 39 EB         ld   (velocity_y), a
 610  8BDB 32 45 F1         ld   (game_objective_completed), a
 611  8BDE 3E 01            ld   a, 1
 612  8BE0 32 3A EB         ld   (on_ground), a
 613  8BE3
 614  8BE3                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 615  8BE3 3E 07            ld   a, $07
 616  8BE5 CD 9D 62         call Gfx_ClearScreenDirect
 617  8BE8
 618  8BE8 C3 50 89         jp   LoadRoomAndRestart
 619  8BEB
 620  8BEB              .all_rooms_completed:
 621  8BEB                  ; Tutte le stanze sono state completate con successo!
 622  8BEB                  IF ENABLE_VICTORY_SCREEN != 0
 623  8BEB C3 DF 8A         jp   TriggerVictory
 624  8BEE                  ELSE
 625  8BEE ~                ; Ricomincia dalla prima stanza (Stanza 00)
 626  8BEE ~                ld   de, (RoomsListTable)
 627  8BEE ~                ld   (room_ptr), de
 628  8BEE ~                xor  a
 629  8BEE ~                ld   (transition_active), a
 630  8BEE ~                ld   (velocity_y), a
 631  8BEE ~                ld   (game_objective_completed), a
 632  8BEE ~                ld   a, 1
 633  8BEE ~                ld   (on_ground), a
 634  8BEE ~                ld   a, $07
 635  8BEE ~                call Gfx_ClearScreenDirect
 636  8BEE ~                jp   LoadRoomAndRestart
 637  8BEE                  ENDIF
 638  8BEE
 639  8BEE              ; -------------------------------------------------------------------
 640  8BEE              ; Air_DepleteCountdown
 641  8BEE              ; Animazione originale di completamento livello (Manic Miner):
 642  8BEE              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 643  8BEE              ; - Ad ogni pixel decrementato:
 644  8BEE              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 645  8BEE              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 646  8BEE              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 647  8BEE              ; -------------------------------------------------------------------
 648  8BEE              Air_DepleteCountdown:
 649  8BEE F5               push af
 650  8BEF C5               push bc
 651  8BF0 D5               push de
 652  8BF1 E5               push hl
 653  8BF2
 654  8BF2              .countdown_loop:
 655  8BF2 3A 4E F1         ld   a, (air_pixels)
 656  8BF5 B7               or   a
 657  8BF6 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 658  8BF8
 659  8BF8 3D               dec  a
 660  8BF9 32 4E F1         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 661  8BFC
 662  8BFC                  ; Aggiorna la barra grafica dell'aria
 663  8BFC CD 2D 6A         call Gfx_UpdateAirBar
 664  8BFF
 665  8BFF                  ; Aggiungi 1 punto allo score
 666  8BFF CD EF 87         call Score_Add1Point
 667  8C02
 668  8C02                  ; Genera l'effetto sonoro originale di Manic Miner:
 669  8C02                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 670  8C02 3A 4E F1         ld   a, (air_pixels)
 671  8C05 2F               cpl
 672  8C06 E6 3F            and  63
 673  8C08 07               rlca
 674  8C09 3C               inc  a
 675  8C0A 57               ld   d, a                      ; D = ritardo semionda audio
 676  8C0B
 677  8C0B 0E 03            ld   c, 3                      ; Durata impulso
 678  8C0D              .audio_loop:
 679  8C0D AF               xor  a
 680  8C0E D3 FE            out  ($fe), a
 681  8C10 42               ld   b, d
 682  8C11 10 FE        .w1: djnz .w1
 683  8C13
 684  8C13 3E 18            ld   a, $18
 685  8C15 D3 FE            out  ($fe), a
 686  8C17 42               ld   b, d
 687  8C18 10 FE        .w2: djnz .w2
 688  8C1A
 689  8C1A 0D               dec  c
 690  8C1B 20 F0            jr   nz, .audio_loop
 691  8C1D
 692  8C1D 18 D3            jr   .countdown_loop
 693  8C1F
 694  8C1F              .done_countdown:
 695  8C1F E1               pop  hl
 696  8C20 D1               pop  de
 697  8C21 C1               pop  bc
 698  8C22 F1               pop  af
 699  8C23 C9               ret
 700  8C24
 701  8C24              ; -------------------------------------------------------------------
 702  8C24              ; CheckAllItemsCollected
 703  8C24              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 704  8C24              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 705  8C24              ; -------------------------------------------------------------------
 706  8C24              CheckAllItemsCollected:
 707  8C24 3A 45 F1         ld   a, (game_objective_completed)
 708  8C27 B7               or   a
 709  8C28 20 08            jr   nz, .all_collected
 710  8C2A 3A AC EE         ld   a, (num_room_items)
 711  8C2D B7               or   a
 712  8C2E 28 02            jr   z, .all_collected
 713  8C30 B7               or   a
 714  8C31 C9               ret
 715  8C32              .all_collected:
 716  8C32 37               scf
 717  8C33 C9               ret
 718  8C34
 719  8C34              ; -------------------------------------------------------------------
 720  8C34              ; CheckInMasterBedroom (alias per retrocompatibilità)
 721  8C34              ; -------------------------------------------------------------------
 722  8C34              CheckInMasterBedroom:
 723  8C34 37               scf
 724  8C35 C9               ret
 725  8C36
 726  8C36              ; -------------------------------------------------------------------
 727  8C36              ; CheckWillyConveyorCollision
 728  8C36              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 729  8C36              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 730  8C36              ; -------------------------------------------------------------------
 731  8C36              CheckWillyConveyorCollision:
 732  8C36 C5               push bc
 733  8C37 D5               push de
 734  8C38 E5               push hl
 735  8C39
 736  8C39                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 737  8C39 CD 97 78         call CheckWillyOnConveyor
 738  8C3C 38 49            jr   c, .collision_detected
 739  8C3E
 740  8C3E                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 741  8C3E 3A 54 EE         ld   a, (conveyor_len)
 742  8C41 B7               or   a
 743  8C42 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 744  8C44
 745  8C44                  ; B = WillyY, C = WillyX
 746  8C44 ED 4B 2B EB      ld   bc, (PlayerPos)
 747  8C48
 748  8C48                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 749  8C48 3A 55 EE         ld   a, (conveyor_row)
 750  8C4B 87               add  a, a                  ; *2
 751  8C4C 87               add  a, a                  ; *4
 752  8C4D 87               add  a, a                  ; *8
 753  8C4E 5F               ld   e, a                  ; E = ConveyorTop
 754  8C4F C6 07            add  a, 7
 755  8C51 57               ld   d, a                  ; D = ConveyorBottom
 756  8C52
 757  8C52                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 758  8C52 78               ld   a, b                  ; WillyTop
 759  8C53 BA               cp   d
 760  8C54 28 04            jr   z, .y_overlap
 761  8C56 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 762  8C58 18 32            jr   .no_conv_collision
 763  8C5A
 764  8C5A              .y_overlap:
 765  8C5A C6 0F            add  a, 15                 ; WillyBottom
 766  8C5C BB               cp   e
 767  8C5D 28 04            jr   z, .x_check
 768  8C5F 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 769  8C61 18 29            jr   .no_conv_collision
 770  8C63
 771  8C63              .x_check:
 772  8C63                  ; ConveyorLeft = conveyor_col * 8
 773  8C63 3A 56 EE         ld   a, (conveyor_col)
 774  8C66 87               add  a, a                  ; *2
 775  8C67 87               add  a, a                  ; *4
 776  8C68 87               add  a, a                  ; *8
 777  8C69 5F               ld   e, a                  ; E = ConveyorLeft
 778  8C6A
 779  8C6A                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 780  8C6A 21 54 EE         ld   hl, conveyor_len
 781  8C6D 3A 56 EE         ld   a, (conveyor_col)
 782  8C70 86               add  a, (hl)
 783  8C71 87               add  a, a                  ; *2
 784  8C72 87               add  a, a                  ; *4
 785  8C73 87               add  a, a                  ; *8
 786  8C74 3D               dec  a                     ; ConveyorRight
 787  8C75 57               ld   d, a                  ; D = ConveyorRight
 788  8C76
 789  8C76                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 790  8C76 79               ld   a, c                  ; WillyLeft
 791  8C77 BA               cp   d
 792  8C78 28 04            jr   z, .x_overlap
 793  8C7A 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 794  8C7C 18 0E            jr   .no_conv_collision
 795  8C7E
 796  8C7E              .x_overlap:
 797  8C7E C6 0F            add  a, 15                 ; WillyRight
 798  8C80 BB               cp   e
 799  8C81 28 04            jr   z, .collision_detected
 800  8C83 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 801  8C85 18 05            jr   .no_conv_collision
 802  8C87
 803  8C87              .collision_detected:
 804  8C87 E1               pop  hl
 805  8C88 D1               pop  de
 806  8C89 C1               pop  bc
 807  8C8A 37               scf
 808  8C8B C9               ret
 809  8C8C
 810  8C8C              .no_conv_collision:
 811  8C8C E1               pop  hl
 812  8C8D D1               pop  de
 813  8C8E C1               pop  bc
 814  8C8F B7               or   a
 815  8C90 C9               ret
 816  8C91
 817  8C91              ; -------------------------------------------------------------------
 818  8C91              ; ResetFullGameState
 819  8C91              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 820  8C91              ; per l'avvio di una nuova partita dopo il Game Over.
 821  8C91              ; -------------------------------------------------------------------
 822  8C91              ResetFullGameState:
 823  8C91                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 824  8C91 AF               xor  a
 825  8C92 D3 FE            out  ($fe), a              ; Bordo a nero
 826  8C94 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 827  8C97
 828  8C97                  ; Ripristina il numero di vite iniziali
 829  8C97 3E 07            ld   a, INITIAL_LIVES
 830  8C99 32 38 EB         ld   (willy_lives), a
 831  8C9C
 832  8C9C                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 833  8C9C AF               xor  a
 834  8C9D 32 35 EB         ld   (items_collected), a
 835  8CA0 32 31 EB         ld   (body_state), a
 836  8CA3 32 45 EB         ld   (w_warp_state), a
 837  8CA6 32 48 EB         ld   (w_key_prev), a
 838  8CA9 32 49 EB         ld   (enter_key_prev), a
 839  8CAC 32 39 EB         ld   (velocity_y), a
 840  8CAF 32 3B EB         ld   (jump_pressed), a
 841  8CB2 32 3D EB         ld   (coyote_timer), a
 842  8CB5 32 40 EB         ld   (jump_frame), a
 843  8CB8 32 3F EB         ld   (jump_dir), a
 844  8CBB 32 B3 EE         ld   (transition_active), a
 845  8CBE 32 38 EF         ld   (willy_safety_timer), a
 846  8CC1 3E FF            ld   a, $ff
 847  8CC3 32 4A EB         ld   (digit_key_prev), a
 848  8CC6 3E 01            ld   a, 1
 849  8CC8 32 43 EB         ld   (q_prev), a
 850  8CCB 32 44 EB         ld   (a_prev), a
 851  8CCE 32 3A EB         ld   (on_ground), a
 852  8CD1
 853  8CD1                  ; Azzeramento punteggio partita corrente (Score = 000000)
 854  8CD1                  ; Nota: High score viene mantenuto intatto tra le partite
 855  8CD1 AF               xor  a
 856  8CD2 32 3F F1         ld   (player_score + 0), a
 857  8CD5 32 40 F1         ld   (player_score + 1), a
 858  8CD8 32 41 F1         ld   (player_score + 2), a
 859  8CDB
 860  8CDB                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 861  8CDB CD A2 85         call ResetItemsTable
 862  8CDE
 863  8CDE                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 864  8CDE CD C0 70         call InitRoomEntryPositions
 865  8CE1
 866  8CE1                  ; Aggiorna la riga di stato con High score e Score azzerato
 867  8CE1 CD B8 68         call Gfx_UpdateScoreDisplay
 868  8CE4
 869  8CE4                  ; Ripristina la stanza iniziale (Central Cavern)
 870  8CE4 21 EB 8C         ld   hl, CentralCavernLayout
 871  8CE7 22 AD EE         ld   (room_ptr), hl
 872  8CEA
 873  8CEA C9               ret
 874  8CEB
 875  8CEB
 876  8CEB

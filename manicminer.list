 142+ 7D55 19               add  hl, de
 143+ 7D56
 144+ 7D56 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 145+ 7D58              .load_v_loop:
 146+ 7D58 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 147+ 7D59 FE FF            cp   $FF
 148+ 7D5B 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 149+ 7D5D B7               or   a
 150+ 7D5E 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 151+ 7D60
 152+ 7D60                  ; Slot attivo per guardiano verticale
 153+ 7D60 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 154+ 7D64 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 155+ 7D67
 156+ 7D67 23               inc  hl

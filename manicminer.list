 263  8001 20 FD            jr   nz, .delay
 264  8003 10 F4            djnz .raster_loop
 265  8005
 266  8005                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 267  8005 3A F8 8D         ld   a, (room_border_color)
 268  8008 D3 FE            out  ($fe), a
 269  800A 18 05            jr   .no_collision_change

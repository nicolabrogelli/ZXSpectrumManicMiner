 179+ 890D              ; Audio_PlayCollectSound
 180+ 890D              ;
 181+ 890D              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 890D              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 890D              ; -------------------------------------------------------------------
 184+ 890D              Audio_PlayCollectSound:
 185+ 890D C5               push bc
 186+ 890E D5               push de
 187+ 890F
 188+ 890F 06 78            ld   b, 120
 189+ 8911              .sound_loop:
 190+ 8911 3A 37 EB         ld   a, (room_border_color)
 191+ 8914 F6 10            or   $10               ; speaker ON
 192+ 8916 D3 FE            out  ($fe), a
 193+ 8918
 194+ 8918 0E 3C            ld   c, 60
 195+ 891A              .d1:
 196+ 891A 0D               dec  c

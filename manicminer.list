  44+ 6C87 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6C88
  46+ 6C88                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6C88 DD 21 79 8F      ld   ix, flags
  48+ 6C8C DD CB 00 86      res  $00, (ix)
  49+ 6C90
  50+ 6C90 ED 4B 71 8F      ld   bc, (PlayerPos)

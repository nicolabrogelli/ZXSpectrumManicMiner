1055+ 787C              ; -------------------------------------------------------------------
1056+ 787C              ; Controlla se Willy collide orizzontalmente con un Wall alle coordinate specificate
1057+ 787C              ; Input: C = X pixel (da controllare), B = Y pixel (attuale)
1058+ 787C              ; Output: Carry flag impostato se c'è collisione, altrimenti resettato
1059+ 787C              ; -------------------------------------------------------------------
1060+ 787C              CheckWillyWallCollision:
1061+ 787C C5               push bc
1062+ 787D
1063+ 787D                  ; 1. Punto superiore: (X, Y)
1064+ 787D CD 4B 78         call CheckWallCell
1065+ 7880 38 17            jr   c, .collision
1066+ 7882
1067+ 7882                  ; 2. Punto medio: (X, Y + 7)
1068+ 7882 78               ld   a, b
1069+ 7883 C6 07            add  a, 7
1070+ 7885 47               ld   b, a
1071+ 7886 CD 4B 78         call CheckWallCell
1072+ 7889 38 0E            jr   c, .collision
1073+ 788B
1074+ 788B                  ; 3. Punto inferiore: (X, Y + 15)
1075+ 788B C1               pop  bc
1076+ 788C C5               push bc
1077+ 788D 78               ld   a, b
1078+ 788E C6 0F            add  a, 15
1079+ 7890 47               ld   b, a
1080+ 7891 CD 4B 78         call CheckWallCell
1081+ 7894 38 03            jr   c, .collision
1082+ 7896
1083+ 7896 C1               pop  bc
1084+ 7897 B7               or   a                 ; Reset carry (nessuna collisione)
1085+ 7898 C9               ret
1086+ 7899
1087+ 7899              .collision:
1088+ 7899 C1               pop  bc
1089+ 789A 37               scf                    ; Set carry (collisione avvenuta)
1090+ 789B C9               ret
1091+ 789C
1092+ 789C              ; -------------------------------------------------------------------
1093+ 789C              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1094+ 789C              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1095+ 789C              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1096+ 789C              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1097+ 789C              ; -------------------------------------------------------------------
1098+ 789C              UnpackRoomLayout:
1099+ 789C E5               push hl
1100+ 789D D5               push de
1101+ 789E C5               push bc
1102+ 789F DD E5            push ix
1103+ 78A1
1104+ 78A1 DD 2A B3 A1      ld   ix, (room_ptr)
1105+ 78A5 11 20 02         ld   de, OFFSET_TILES
1106+ 78A8 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1107+ 78AA
1108+ 78AA 2A B3 A1         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1109+ 78AD 11 58 9F         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1110+ 78B0 01 00 02         ld   bc, 512               ; 512 celle
1111+ 78B3
1112+ 78B3              .byte_loop:
1113+ 78B3 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1114+ 78B4 23               inc  hl
1115+ 78B5
1116+ 78B5                  ; Confronta con le 8 definizioni di tile:
1117+ 78B5 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1118+ 78B8 28 23            jr   z, .is_bg
1119+ 78BA DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1120+ 78BD 28 29            jr   z, .is_wall
1121+ 78BF DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1122+ 78C2 28 1C            jr   z, .is_floor
1123+ 78C4 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1124+ 78C7 28 1B            jr   z, .is_crumbling
1125+ 78C9 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1126+ 78CC 28 1E            jr   z, .is_conveyor
1127+ 78CE DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1128+ 78D1 28 1D            jr   z, .is_nasty1
1129+ 78D3 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1130+ 78D6 28 1C            jr   z, .is_nasty2
1131+ 78D8 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1132+ 78DB 28 1B            jr   z, .is_extra
1133+ 78DD
1134+ 78DD              .is_bg:
1135+ 78DD                  ; Default: Tile 0 (Background)

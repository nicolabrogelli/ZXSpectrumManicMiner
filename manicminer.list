 161+ 7E02              ; -------------------------------------------------------------------
 162+ 7E02              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7E02              ; -------------------------------------------------------------------
 164+ 7E02              CheckEnemyWillyOverlap:
 165+ 7E02 3A 47 AF         ld   a, (player_drawn_pos+1)
 166+ 7E05 FE FF            cp   $FF
 167+ 7E07 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7E08
 169+ 7E08                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7E08 3A 46 AF         ld   a, (player_drawn_pos)
 171+ 7E0B E6 F8            and  $F8
 172+ 7E0D 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7E0E 79               ld   a, c
 174+ 7E0F E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7E11 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7E12 C6 10            add  a, 16
 177+ 7E14 FE 19            cp   25
 178+ 7E16 D0               ret  nc                 ; Fuori portata X
 179+ 7E17
 180+ 7E17                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7E17 3A 47 AF         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7E1A 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7E1B C6 0F            add  a, 15
 184+ 7E1D FE 1F            cp   31
 185+ 7E1F D0               ret  nc                 ; Fuori portata Y
 186+ 7E20
 187+ 7E20                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7E20 3E 01            ld   a, 1
 189+ 7E22 32 4C AF         ld   (willy_needs_redraw), a
 190+ 7E25 C9               ret

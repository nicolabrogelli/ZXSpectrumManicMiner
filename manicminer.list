1194+ 795F DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1195+ 7962 28 23            jr   z, .is_bg
1196+ 7964 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1197+ 7967 28 29            jr   z, .is_wall
1198+ 7969 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1199+ 796C 28 1C            jr   z, .is_floor
1200+ 796E DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1201+ 7971 28 1B            jr   z, .is_crumbling
1202+ 7973 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1203+ 7976 28 1E            jr   z, .is_conveyor
1204+ 7978 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1205+ 797B 28 1D            jr   z, .is_nasty1
1206+ 797D DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1207+ 7980 28 1C            jr   z, .is_nasty2
1208+ 7982 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1209+ 7985 28 1B            jr   z, .is_extra

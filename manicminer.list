 909  8632              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 910  8632              ; per l'avvio di una nuova partita dopo il Game Over.
 911  8632              ; -------------------------------------------------------------------
 912  8632              ResetFullGameState:
 913  8632                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 914  8632 AF               xor  a
 915  8633 D3 FE            out  ($fe), a              ; Bordo a nero
 916  8635 21 8D 5C         ld   hl, ATTR_P

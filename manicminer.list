 625+ 830B              ; Score_AddItemPoints
 626+ 830B              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 830B              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 830B              ; -------------------------------------------------------------------
 629+ 830B              Score_AddItemPoints:
 630+ 830B F5               push af
 631+ 830C C5               push bc
 632+ 830D D5               push de
 633+ 830E E5               push hl
 634+ 830F
 635+ 830F                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 830F 3A 7A B0         ld   a, (player_score + 1)
 637+ 8312 C6 01            add  a, $01
 638+ 8314 27               daa
 639+ 8315 32 7A B0         ld   (player_score + 1), a
 640+ 8318
 641+ 8318                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8318 3A 7B B0         ld   a, (player_score + 2)
 643+ 831B CE 00            adc  a, 0
 644+ 831D 27               daa
 645+ 831E 32 7B B0         ld   (player_score + 2), a
 646+ 8321
 647+ 8321                  ; Controlla se player_score ha superato high_score
 648+ 8321 CD 2C 83         call Score_CheckAndUpdateHighScore
 649+ 8324
 650+ 8324                  ; Aggiorna visualizzazione a schermo
 651+ 8324 CD AE 68         call Gfx_UpdateScoreDisplay
 652+ 8327
 653+ 8327 E1               pop  hl
 654+ 8328 D1               pop  de
 655+ 8329 C1               pop  bc
 656+ 832A F1               pop  af
 657+ 832B C9               ret
 658+ 832C
 659+ 832C              ; -------------------------------------------------------------------
 660+ 832C              ; Score_CheckAndUpdateHighScore
 661+ 832C              ; Se player_score > high_score, copia player_score in high_score.
 662+ 832C              ; -------------------------------------------------------------------
 663+ 832C              Score_CheckAndUpdateHighScore:
 664+ 832C                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 832C                  ; Byte 2:
 666+ 832C 3A 7B B0         ld   a, (player_score + 2)
 667+ 832F 47               ld   b, a
 668+ 8330 3A 7E B0         ld   a, (high_score + 2)
 669+ 8333 B8               cp   b
 670+ 8334 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 8336 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 8338
 673+ 8338                  ; Byte 1:
 674+ 8338 3A 7A B0         ld   a, (player_score + 1)
 675+ 833B 47               ld   b, a
 676+ 833C 3A 7D B0         ld   a, (high_score + 1)
 677+ 833F B8               cp   b
 678+ 8340 38 0C            jr   c, .new_high_score
 679+ 8342 20 1C            jr   nz, .done_check
 680+ 8344
 681+ 8344                  ; Byte 0:
 682+ 8344 3A 79 B0         ld   a, (player_score + 0)
 683+ 8347 47               ld   b, a
 684+ 8348 3A 7C B0         ld   a, (high_score + 0)
 685+ 834B B8               cp   b
 686+ 834C 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 834E
 688+ 834E              .new_high_score:
 689+ 834E 3A 79 B0         ld   a, (player_score + 0)
 690+ 8351 32 7C B0         ld   (high_score + 0), a
 691+ 8354 3A 7A B0         ld   a, (player_score + 1)
 692+ 8357 32 7D B0         ld   (high_score + 1), a
 693+ 835A 3A 7B B0         ld   a, (player_score + 2)
 694+ 835D 32 7E B0         ld   (high_score + 2), a
 695+ 8360
 696+ 8360              .done_check:
 697+ 8360 C9               ret

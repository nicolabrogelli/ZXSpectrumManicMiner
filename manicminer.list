 641  8666
 642  8666              ; -------------------------------------------------------------------
 643  8666              ; CheckPortalTransition
 644  8666              ; Verifica le condizioni per accedere alla stanza successiva:
 645  8666              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 646  8666              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 647  8666              ;
 648  8666              ; Output:
 649  8666              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 650  8666              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 651  8666              ; -------------------------------------------------------------------
 652  8666              CheckPortalTransition:
 653  8666 C5               push bc
 654  8667 D5               push de
 655  8668 E5               push hl
 656  8669
 657  8669                  ; 1. Tutti gli item della stanza sono stati raccolti?
 658  8669 CD F7 86         call CheckAllItemsCollected
 659  866C 30 4D            jr   nc, .no_transition
 660  866E
 661  866E                  ; 2. Willy collide con il portale (16x16 pixel)?
 662  866E                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 663  866E                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 664  866E 2A 89 99         ld   hl, (room_ptr)
 665  8671 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 666  8674 19               add  hl, de
 667  8675 4E               ld   c, (hl)
 668  8676 23               inc  hl
 669  8677 46               ld   b, (hl)                   ; BC = AttrAddr
 670  8678
 671  8678                  ; Offset = BC - 23552
 672  8678 60               ld   h, b
 673  8679 69               ld   l, c
 674  867A 01 00 A4         ld   bc, -23552
 675  867D 09               add  hl, bc
 676  867E
 677  867E                  ; PortalX = (Offset & 31) * 8
 678  867E 7D               ld   a, l
 679  867F E6 1F            and  31
 680  8681 87               add  a, a
 680  8682 87             add a, a
 680  8683 87             add a, a
 681  8684 5F               ld   e, a                      ; E = PortalX (0..248)
 682  8685
 683  8685                  ; PortalY = (Offset / 32) * 8
 684  8685 CB 3C            srl  h
 684  8687 CB 1D          rr l
 685  8689 CB 3C            srl  h
 685  868B CB 1D          rr l
 686  868D CB 3C            srl  h
 686  868F CB 1D          rr l
 687  8691 CB 3C            srl  h
 687  8693 CB 1D          rr l
 688  8695 CB 3C            srl  h
 688  8697 CB 1D          rr l
 689  8699 7D               ld   a, l
 690  869A 87               add  a, a
 690  869B 87             add a, a
 690  869C 87             add a, a
 691  869D 57               ld   d, a                      ; D = PortalY (0..120)
 692  869E
 693  869E                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 694  869E ED 4B 09 96      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 695  86A2
 696  86A2                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 697  86A2 7B               ld   a, e
 698  86A3 91               sub  c
 699  86A4 30 02            jr   nc, .x_diff_pos
 700  86A6 ED 44            neg
 701  86A8              .x_diff_pos:
 702  86A8 FE 0C            cp   12
 703  86AA 30 0F            jr   nc, .no_transition
 704  86AC
 705  86AC                  ; Controllo verticale: |WillyY - PortalY| < 14
 706  86AC 7A               ld   a, d
 707  86AD 90               sub  b
 708  86AE 30 02            jr   nc, .y_diff_pos
 709  86B0 ED 44            neg
 710  86B2              .y_diff_pos:
 711  86B2 FE 0E            cp   14
 712  86B4 30 05            jr   nc, .no_transition
 713  86B6
 714  86B6                  ; Transizione al portale attiva!
 715  86B6 E1               pop  hl
 716  86B7 D1               pop  de
 717  86B8 C1               pop  bc
 718  86B9 37               scf
 719  86BA C9               ret
 720  86BB
 721  86BB              .no_transition:
 722  86BB E1               pop  hl
 723  86BC D1               pop  de
 724  86BD C1               pop  bc
 725  86BE B7               or   a
 726  86BF C9               ret
 727  86C0
 728  86C0              ; Alias per retrocompatibilità
 729  86C0              CheckVictoryCondition: EQU CheckPortalTransition
 730  86C0
 731  86C0              ; -------------------------------------------------------------------
 732  86C0              ; TriggerPortalTransition
 733  86C0              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 734  86C0              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 735  86C0              ; - Avanza all'indice della stanza successiva.
 736  86C0              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 737  86C0              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 738  86C0              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 739  86C0              ; -------------------------------------------------------------------
 740  86C0              TriggerPortalTransition:
 741  86C0                  ; 1. Determina l'ID della stanza corrente
 742  86C0 CD 23 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 743  86C3
 744  86C3                  ; 2. Calcola l'indice della stanza successiva
 745  86C3 3A 2F 99         ld   a, (current_room)
 746  86C6 3C               inc  a
 747  86C7 FE 02            cp   NUM_ROOMS
 748  86C9 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 749  86CB
 750  86CB                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]

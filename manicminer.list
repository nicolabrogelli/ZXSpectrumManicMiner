 202+ 7DA1              ; -------------------------------------------------------------------
 203+ 7DA1              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 204+ 7DA1              ; -------------------------------------------------------------------
 205+ 7DA1              CheckEnemyWillyOverlap:
 206+ 7DA1 3A D6 BE         ld   a, (player_drawn_pos+1)
 207+ 7DA4 FE FF            cp   $FF
 208+ 7DA6 C8               ret  z                  ; Se Willy non è disegnato, esci
 209+ 7DA7
 210+ 7DA7                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 211+ 7DA7 3A D5 BE         ld   a, (player_drawn_pos)
 212+ 7DAA E6 F8            and  $F8
 213+ 7DAC 5F               ld   e, a               ; E = WillyX & $F8
 214+ 7DAD 79               ld   a, c
 215+ 7DAE E6 F8            and  $F8                ; A = EnemyX & $F8
 216+ 7DB0 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 217+ 7DB1 C6 10            add  a, 16
 218+ 7DB3 FE 19            cp   25
 219+ 7DB5 D0               ret  nc                 ; Fuori portata X
 220+ 7DB6
 221+ 7DB6                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 222+ 7DB6 3A D6 BE         ld   a, (player_drawn_pos+1) ; A = WillyY
 223+ 7DB9 90               sub  b                  ; A = WillyY - EnemyY
 224+ 7DBA C6 0F            add  a, 15
 225+ 7DBC FE 1F            cp   31
 226+ 7DBE D0               ret  nc                 ; Fuori portata Y
 227+ 7DBF
 228+ 7DBF                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 229+ 7DBF 3E 01            ld   a, 1
 230+ 7DC1 32 DB BE         ld   (willy_needs_redraw), a
 231+ 7DC4 C9               ret
 232+ 7DC5
 233+ 7DC5              ; -------------------------------------------------------------------
 234+ 7DC5              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 235+ 7DC5              ; -------------------------------------------------------------------
 236+ 7DC5              Enemy_EraseRoom:
 237+ 7DC5              Enemy_DrawRoom:
 238+ 7DC5              Enemy_RenderRoom:
 239+ 7DC5 E5               push hl
 240+ 7DC6 D5               push de
 241+ 7DC7 C5               push bc
 242+ 7DC8 DD E5            push ix
 243+ 7DCA
 244+ 7DCA                  ; ---------------------------------------------------------------
 245+ 7DCA                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 246+ 7DCA                  ; ---------------------------------------------------------------
 247+ 7DCA DD 21 4B 7C      ld   ix, ActiveEnemies
 248+ 7DCE 06 08            ld   b, 8              ; 8 slot
 249+ 7DD0              .erase_loop:
 250+ 7DD0 DD 7E 00         ld   a, (ix+0)         ; Flags
 251+ 7DD3 E6 80            and  $80               ; Active?
 252+ 7DD5 28 3A            jr   z, .next_erase
 253+ 7DD7
 254+ 7DD7                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 255+ 7DD7 DD 7E 08         ld   a, (ix+8)         ; Old X
 256+ 7DDA FE FF            cp   $FF
 257+ 7DDC 28 33            jr   z, .next_erase
 258+ 7DDE
 259+ 7DDE                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 260+ 7DDE DD 7E 08         ld   a, (ix+8)         ; Old X
 261+ 7DE1 DD BE 02         cp   (ix+2)            ; Current X
 262+ 7DE4 20 0E            jr   nz, .do_erase_slot
 263+ 7DE6 DD 7E 09         ld   a, (ix+9)         ; Old Y
 264+ 7DE9 DD BE 03         cp   (ix+3)            ; Current Y
 265+ 7DEC 20 06            jr   nz, .do_erase_slot
 266+ 7DEE
 267+ 7DEE 3A D9 BE         ld   a, (enemy_was_updated)
 268+ 7DF1 B7               or   a
 269+ 7DF2 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 270+ 7DF4
 271+ 7DF4              .do_erase_slot:
 272+ 7DF4 C5               push bc                ; Salva contatore ciclo
 273+ 7DF5
 274+ 7DF5                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 275+ 7DF5 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 276+ 7DF8 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 277+ 7DFB CD A1 7D         call CheckEnemyWillyOverlap
 278+ 7DFE
 279+ 7DFE                  ; Cancella il nemico nella VECCHIA posizione
 280+ 7DFE DD 4E 08         ld   c, (ix+8)         ; C = Old X
 281+ 7E01 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 282+ 7E04 CD BD 5F         call Gfx_ErasePixelSprite16x16
 283+ 7E07 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 284+ 7E0A DD 46 09         ld   b, (ix+9)         ; B = Old Y
 285+ 7E0D CD 73 6D         call Gfx_RestoreEnemyColorAttributes
 286+ 7E10
 287+ 7E10 C1               pop  bc
 288+ 7E11
 289+ 7E11              .next_erase:
 290+ 7E11 11 0B 00         ld   de, 11
 291+ 7E14 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 292+ 7E16 05               dec  b
 293+ 7E17 20 B7            jr   nz, .erase_loop
 294+ 7E19
 295+ 7E19                  ; ---------------------------------------------------------------
 296+ 7E19                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 297+ 7E19                  ; ---------------------------------------------------------------
 298+ 7E19 DD 21 4B 7C      ld   ix, ActiveEnemies
 299+ 7E1D 06 08            ld   b, 8              ; 8 slot
 300+ 7E1F              .draw_loop:
 301+ 7E1F DD 7E 00         ld   a, (ix+0)         ; Flags
 302+ 7E22 E6 80            and  $80               ; Active?
 303+ 7E24 28 37            jr   z, .next_draw
 304+ 7E26
 305+ 7E26                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 306+ 7E26 DD 7E 08         ld   a, (ix+8)         ; Old X
 307+ 7E29 FE FF            cp   $FF
 308+ 7E2B 28 16            jr   z, .do_draw_slot
 309+ 7E2D
 310+ 7E2D                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 311+ 7E2D DD 7E 08         ld   a, (ix+8)         ; Old X
 312+ 7E30 DD BE 02         cp   (ix+2)            ; Current X
 313+ 7E33 20 0E            jr   nz, .do_draw_slot
 314+ 7E35 DD 7E 09         ld   a, (ix+9)         ; Old Y
 315+ 7E38 DD BE 03         cp   (ix+3)            ; Current Y
 316+ 7E3B 20 06            jr   nz, .do_draw_slot
 317+ 7E3D
 318+ 7E3D 3A D9 BE         ld   a, (enemy_was_updated)
 319+ 7E40 B7               or   a
 320+ 7E41 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 321+ 7E43
 322+ 7E43              .do_draw_slot:
 323+ 7E43 C5               push bc                ; Salva contatore ciclo
 324+ 7E44
 325+ 7E44                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 326+ 7E44 CD 6F 7E         call Enemy_DrawSingleSlot
 327+ 7E47
 328+ 7E47                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 329+ 7E47 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 330+ 7E4A DD 46 03         ld   b, (ix+3)         ; B = Current Y
 331+ 7E4D CD A1 7D         call CheckEnemyWillyOverlap
 332+ 7E50
 333+ 7E50                  ; Salva le coordinate effettivamente disegnate
 334+ 7E50 DD 7E 02         ld   a, (ix+2)
 335+ 7E53 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 336+ 7E56 DD 7E 03         ld   a, (ix+3)
 337+ 7E59 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 338+ 7E5C
 339+ 7E5C C1               pop  bc
 340+ 7E5D
 341+ 7E5D              .next_draw:
 342+ 7E5D 11 0B 00         ld   de, 11
 343+ 7E60 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 344+ 7E62 05               dec  b
 345+ 7E63 20 BA            jr   nz, .draw_loop
 346+ 7E65
 347+ 7E65 AF               xor  a
 348+ 7E66 32 D9 BE         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 349+ 7E69
 350+ 7E69 DD E1            pop  ix
 351+ 7E6B C1               pop  bc
 352+ 7E6C D1               pop  de
 353+ 7E6D E1               pop  hl
 354+ 7E6E C9               ret

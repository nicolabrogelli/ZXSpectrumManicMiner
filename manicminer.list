 285  884B              ; -------------------------------------------------------------------
 286  884B              ; ShowTitleScreen
 287  884B              ; Visualizza la schermata iniziale del gioco (Title Screen).
 288  884B              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 289  884B              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 290  884B              ; -------------------------------------------------------------------
 291  884B              ShowTitleScreen:
 292  884B                  ; 1. Disegna la schermata iniziale
 293  884B CD 7A 64         call Gfx_DrawTitleScreen
 294  884E
 295  884E                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 296  884E              .wait_title_enter_release:
 297  884E 76               halt
 298  884F 3E BF            ld   a, $bf
 299  8851 DB FE            in   a, ($fe)
 300  8853 1F               rra
 301  8854 30 F8            jr   nc, .wait_title_enter_release
 302  8856
 303  8856                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 304  8856 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 305  8858              .title_loop:
 306  8858 76               halt
 307  8859
 308  8859                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 309  8859 0C               inc  c
 310  885A 79               ld   a, c
 311  885B CB 3F            srl  a
 312  885D CB 3F            srl  a
 313  885F CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 314  8861 E6 07            and  7
 315  8863 5F               ld   e, a
 316  8864 16 00            ld   d, 0
 317  8866 21 72 64         ld   hl, title_color_table
 318  8869 19               add  hl, de
 319  886A 7E               ld   a, (hl)               ; A = nuovo colore
 320  886B 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  886E 06 20            ld   b, 32

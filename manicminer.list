 398  88D0 0C               inc  c
 399  88D1 79               ld   a, c
 400  88D2 CB 3F            srl  a
 401  88D4 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 402  88D6 E6 07            and  7

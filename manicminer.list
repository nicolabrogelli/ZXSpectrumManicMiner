   6+ 6DBA              ; MovePlayer
   7+ 6DBA              ;
   8+ 6DBA              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6DBA              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6DBA              ; con i muri.
  11+ 6DBA              ;
  12+ 6DBA              ; Input:
  13+ 6DBA              ;   D = stato dei controlli (bitfield)
  14+ 6DBA              ;
  15+ 6DBA              ; Strutture utilizzate:
  16+ 6DBA              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6DBA              ;   player_speed    -> velocità orizzontale
  18+ 6DBA              ;   flags           -> flag di stato input
  19+ 6DBA              ;
  20+ 6DBA              ; Bit controlli:
  21+ 6DBA              ;   bit 0 = sinistra
  22+ 6DBA              ;   bit 1 = destra
  23+ 6DBA              ;
  24+ 6DBA              ; Nota:
  25+ 6DBA              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6DBA              ;   ignorato per tutta la durata del salto.
  27+ 6DBA              ;
  28+ 6DBA              ; Output:
  29+ 6DBA              ;   aggiorna PlayerPos e body_state
  30+ 6DBA              ; -------------------------------------------------------------------
  31+ 6DBA              MovePlayer:
  32+ 6DBA
  33+ 6DBA                  ; ---------------------------------------------------------------
  34+ 6DBA                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6DBA                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6DBA                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6DBA                  ; ---------------------------------------------------------------
  38+ 6DBA 3A E6 94         ld   a, (on_ground)
  39+ 6DBD B7               or   a
  40+ 6DBE 20 1A            jr   nz, .on_ground_check
  41+ 6DC0
  42+ 6DC0 3A EB 94         ld   a, (jump_dir)

 244  8345 3E 01            ld   a, 1
 245  8347 32 E6 94         ld   (on_ground), a
 246  834A
 247  834A 3E 00            ld   a, RESPAWN_SAFETY_TIME
 248  834C 32 E1 98         ld   (willy_safety_timer), a

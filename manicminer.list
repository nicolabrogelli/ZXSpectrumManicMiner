 118+ 5DAD              ; --- Velocità globale del Game Loop (Frame Delay) ---
 119+ 5DAD              ; Numero di interrupt hardware a 50Hz (HALT) per ciascun ciclo di gioco:
 120+ 5DAD              ; 2 = Velocità normale originale (25 FPS, 50Hz / 2)
 121+ 5DAD              ; 3 = Velocità rallentata (~16.6 FPS, 50Hz / 3 - utile per test o facilitare il gioco)
 122+ 5DAD              ; 4 = Velocità molto lenta (12.5 FPS, 50Hz / 4)
 123+ 5DAD                  IFNDEF GAME_SPEED_DELAY
 124+ 5DAD              GAME_SPEED_DELAY EQU 2
 125+ 5DAD                  ENDIF
 126+ 5DAD
 127+ 5DAD              ; --- Velocità di camminata di Willy a terra (Pixel per frame) ---
 128+ 5DAD              ; Spostamento orizzontale di Willy ad ogni frame di camminata a terra:
 129+ 5DAD              ; 3 = Velocità standard originale (3 pixel per frame)
 130+ 5DAD              ; 2 = Velocità ridotta e precisa (2 pixel per frame)
 131+ 5DAD              ; 1 = Velocità minima (1 pixel per frame)
 132+ 5DAD                  IFNDEF WILLY_WALK_SPEED
 133+ 5DAD              WILLY_WALK_SPEED EQU 2
 134+ 5DAD                  ENDIF
 135+ 5DAD
 136+ 5DAD              ; --- Frequenza di aggiornamento dei Guardiani (Nemici) ---
 137+ 5DAD              ; Intervallo di frame per ogni passo di movimento e animazione dei guardiani:
 138+ 5DAD              ; 1 = Velocità normale originale (i guardiani si muovono ogni frame)
 139+ 5DAD              ; 2 = Velocità dimezzata (i guardiani si muovono ogni 2 frame)
 140+ 5DAD              ; 3 = Velocità ridotta ad 1/3 (i guardiani si muovono ogni 3 frame)
 141+ 5DAD                  IFNDEF GUARDIAN_UPDATE_RATE
 142+ 5DAD              GUARDIAN_UPDATE_RATE EQU 2
 143+ 5DAD                  ENDIF

 190+ 88E9 3A 0F EB         ld   a, (room_border_color)
 191+ 88EC F6 10            or   $10               ; speaker ON
 192+ 88EE D3 FE            out  ($fe), a
 193+ 88F0
 194+ 88F0 0E 3C            ld   c, 60
 195+ 88F2              .d1:
 196+ 88F2 0D               dec  c
 197+ 88F3 20 FD            jr   nz, .d1
 198+ 88F5
 199+ 88F5 3A 0F EB         ld   a, (room_border_color)
 200+ 88F8 E6 EF            and  $ef              ; speaker OFF
 201+ 88FA D3 FE            out  ($fe), a
 202+ 88FC
 203+ 88FC 0E 3C            ld   c, 60
 204+ 88FE              .d2:
 205+ 88FE 0D               dec  c
 206+ 88FF 20 FD            jr   nz, .d2
 207+ 8901
 208+ 8901 10 E6            djnz .sound_loop
 209+ 8903
 210+ 8903 D1               pop  de
 211+ 8904 C1               pop  bc
 212+ 8905 C9               ret

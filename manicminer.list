   7+ 8751              ; -------------------------------------------------------------------
   8+ 8751              ; Audio_UpdateJumpSound
   9+ 8751              ;
  10+ 8751              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8751              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8751              ; -------------------------------------------------------------------
  13+ 8751              Audio_UpdateJumpSound:
  14+ 8751 F5               push af
  15+ 8752 C5               push bc
  16+ 8753 D5               push de
  17+ 8754 E5               push hl
  18+ 8755
  19+ 8755                  ; Controlla se il suono è attivo (note < 18)
  20+ 8755 3A D3 EF         ld   a, (Audio_jump_sound_note)
  21+ 8758 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 875A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 875C
  24+ 875C                  ; Carica la nota corrente da suonare
  25+ 875C 5F               ld   e, a
  26+ 875D 16 00            ld   d, 0
  27+ 875F 21 8B 87         ld   hl, Audio_JumpSoundDelays
  28+ 8762 19               add  hl, de
  29+ 8763 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8764 57               ld   d, a                      ; D = delay della nota
  31+ 8765
  32+ 8765                  ; Suona la nota: 15 cicli
  33+ 8765 06 0F            ld   b, 15
  34+ 8767              .note_loop:
  35+ 8767                  ; Speaker ON
  36+ 8767 3A BF E9         ld   a, (room_border_color)
  37+ 876A F6 10            or   $10
  38+ 876C D3 FE            out  ($fe), a
  39+ 876E 4A               ld   c, d
  40+ 876F              .d1:
  41+ 876F 0D               dec  c
  42+ 8770 20 FD            jr   nz, .d1
  43+ 8772
  44+ 8772                  ; Speaker OFF
  45+ 8772 3A BF E9         ld   a, (room_border_color)
  46+ 8775 E6 EF            and  $ef
  47+ 8777 D3 FE            out  ($fe), a
  48+ 8779 4A               ld   c, d
  49+ 877A              .d2:
  50+ 877A 0D               dec  c
  51+ 877B 20 FD            jr   nz, .d2
  52+ 877D
  53+ 877D 10 E8            djnz .note_loop
  54+ 877F
  55+ 877F                  ; Passa alla nota successiva
  56+ 877F 3A D3 EF         ld   a, (Audio_jump_sound_note)
  57+ 8782 3C               inc  a
  58+ 8783 32 D3 EF         ld   (Audio_jump_sound_note), a
  59+ 8786
  60+ 8786              .done:
  61+ 8786 E1               pop  hl
  62+ 8787 D1               pop  de
  63+ 8788 C1               pop  bc
  64+ 8789 F1               pop  af
  65+ 878A C9               ret
  66+ 878B
  67+ 878B              Audio_JumpSoundDelays:
  68+ 878B 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 878F 19 13 0C 06
  68+ 8793 0C 13 19 20
  68+ 8797 26 2D 33 3A
  68+ 879B 40 47
  69+ 879D

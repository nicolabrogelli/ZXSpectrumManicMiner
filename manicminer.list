 792  85C5              ; CheckAllItemsCollected
 793  85C5              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 794  85C5              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 795  85C5              ; -------------------------------------------------------------------
 796  85C5              CheckAllItemsCollected:
 797  85C5 3A EC 9A         ld   a, (game_objective_completed)
 798  85C8 B7               or   a
 799  85C9 20 08            jr   nz, .all_collected
 800  85CB 3A 56 98         ld   a, (num_room_items)
 801  85CE B7               or   a
 802  85CF 28 02            jr   z, .all_collected
 803  85D1 B7               or   a
 804  85D2 C9               ret

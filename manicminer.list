  72+ 7EAF ~            ; Audio_UpdateMusic
  73+ 7EAF ~            ;
  74+ 7EAF ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 7EAF ~            ; Viene chiamata a ogni frame.
  76+ 7EAF ~            ; -------------------------------------------------------------------
  77+ 7EAF ~            Audio_UpdateMusic:
  78+ 7EAF ~                push af
  79+ 7EAF ~                push bc
  80+ 7EAF ~                push de
  81+ 7EAF ~                push hl
  82+ 7EAF ~
  83+ 7EAF ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 7EAF ~                ld   a, (Audio_jump_sound_note)
  85+ 7EAF ~                cp   18
  86+ 7EAF ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 7EAF ~
  88+ 7EAF ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 7EAF ~                ld   a, (Audio_music_frame_counter)
  90+ 7EAF ~                dec  a
  91+ 7EAF ~                ld   (Audio_music_frame_counter), a
  92+ 7EAF ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 7EAF ~
  94+ 7EAF ~                ; Altrimenti carica la nota successiva
  95+ 7EAF ~                ld   a, (Audio_music_note_idx)
  96+ 7EAF ~                inc  a
  97+ 7EAF ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 7EAF ~                jr   c, .no_wrap
  99+ 7EAF ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 7EAF ~            .no_wrap:
 101+ 7EAF ~                ld   (Audio_music_note_idx), a
 102+ 7EAF ~
 103+ 7EAF ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 7EAF ~                ld   e, a
 105+ 7EAF ~                ld   d, 0
 106+ 7EAF ~                ld   hl, Audio_MusicSheet
 107+ 7EAF ~                add  hl, de
 108+ 7EAF ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 7EAF ~
 110+ 7EAF ~                ; Leggi durata (secondo byte)
 111+ 7EAF ~                inc  hl
 112+ 7EAF ~                ld   a, (hl)
 113+ 7EAF ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 7EAF ~                jr   nz, .dur_ok
 115+ 7EAF ~                ld   a, 1
 116+ 7EAF ~            .dur_ok:
 117+ 7EAF ~                ld   (Audio_music_frame_counter), a
 118+ 7EAF ~
 119+ 7EAF ~            .play_current_note:
 120+ 7EAF ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 7EAF ~                ld   a, (Audio_music_note_idx)
 122+ 7EAF ~                ld   e, a
 123+ 7EAF ~                ld   d, 0
 124+ 7EAF ~                ld   hl, Audio_MusicSheet
 125+ 7EAF ~                add  hl, de
 126+ 7EAF ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 7EAF ~                ld   a, (hl)                  ; A = delay
 128+ 7EAF ~                or   a
 129+ 7EAF ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 7EAF ~
 131+ 7EAF ~                ; Suona la nota: 2 cicli
 132+ 7EAF ~                ld   d, a                     ; D = delay
 133+ 7EAF ~                ld   b, 2                     ; 2 cicli per frame
 134+ 7EAF ~            .note_loop:
 135+ 7EAF ~                ; Speaker ON
 136+ 7EAF ~                ld   a, (room_border_color)
 137+ 7EAF ~                or   $10
 138+ 7EAF ~                out  ($fe), a
 139+ 7EAF ~                ld   c, d
 140+ 7EAF ~            .d1:
 141+ 7EAF ~                push af
 142+ 7EAF ~                pop  af
 143+ 7EAF ~                dec  c
 144+ 7EAF ~                jr   nz, .d1
 145+ 7EAF ~
 146+ 7EAF ~                ; Speaker OFF
 147+ 7EAF ~                ld   a, (room_border_color)
 148+ 7EAF ~                and  $ef
 149+ 7EAF ~                out  ($fe), a
 150+ 7EAF ~                ld   c, d
 151+ 7EAF ~            .d2:
 152+ 7EAF ~                push af
 153+ 7EAF ~                pop  af
 154+ 7EAF ~                dec  c
 155+ 7EAF ~                jr   nz, .d2
 156+ 7EAF ~
 157+ 7EAF ~                djnz .note_loop
 158+ 7EAF ~
 159+ 7EAF ~            .done:
 160+ 7EAF ~                pop  hl
 161+ 7EAF ~                pop  de
 162+ 7EAF ~                pop  bc
 163+ 7EAF ~                pop  af
 164+ 7EAF ~                ret
 165+ 7EAF ~
 166+ 7EAF ~            Audio_MusicSheet:
 167+ 7EAF ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 7EAF ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 7EAF ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 7EAF ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 7EAF ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 7EAF ~                db 90, 10, 107, 20, 68, 65

 275  816A              ; -------------------------------------------------------------------
 276  816A              ; ShowTitleScreen
 277  816A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 278  816A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 279  816A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 280  816A              ; -------------------------------------------------------------------
 281  816A              ShowTitleScreen:
 282  816A                  ; 1. Disegna la schermata iniziale
 283  816A CD 6C 62         call Gfx_DrawTitleScreen
 284  816D
 285  816D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 286  816D              .wait_title_enter_release:
 287  816D 76               halt
 288  816E 3E BF            ld   a, $bf
 289  8170 DB FE            in   a, ($fe)
 290  8172 1F               rra
 291  8173 30 F8            jr   nc, .wait_title_enter_release
 292  8175
 293  8175                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 294  8175 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 295  8177              .title_loop:
 296  8177 76               halt
 297  8178
 298  8178                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 299  8178 0C               inc  c
 300  8179 79               ld   a, c
 301  817A CB 3F            srl  a
 302  817C CB 3F            srl  a
 303  817E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 304  8180 E6 07            and  7
 305  8182 5F               ld   e, a
 306  8183 16 00            ld   d, 0
 307  8185 21 64 62         ld   hl, title_color_table
 308  8188 19               add  hl, de
 309  8189 7E               ld   a, (hl)               ; A = nuovo colore
 310  818A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 311  818D 06 20            ld   b, 32
 312  818F              .color_title_loop:
 313  818F 77               ld   (hl), a
 314  8190 23               inc  hl
 315  8191 10 FC            djnz .color_title_loop
 316  8193
 317  8193                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 318  8193 3E BF            ld   a, $bf
 319  8195 DB FE            in   a, ($fe)
 320  8197 1F               rra
 321  8198 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 322  819A
 323  819A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 324  819A              .wait_title_enter_release_after:
 325  819A 76               halt
 326  819B 3E BF            ld   a, $bf
 327  819D DB FE            in   a, ($fe)
 328  819F 1F               rra
 329  81A0 30 F8            jr   nc, .wait_title_enter_release_after
 330  81A2
 331  81A2                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 332  81A2 AF               xor  a
 333  81A3 D3 FE            out  ($fe), a              ; Bordo a nero
 334  81A5 21 8D 5C         ld   hl, ATTR_P
 335  81A8 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 336  81A9 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 337  81AC 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 338  81AE 3E 07            ld   a, $07
 339  81B0 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 340  81B3
 341  81B3                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 342  81B3 CD EF 83         call ResetFullGameState
 343  81B6
 344  81B6                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 345  81B6 C3 50 80         jp   LoadRoomAndRestart

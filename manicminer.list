 873+ 821A                  ; Willy a Sinistra:
 874+ 821A 21 04 DC         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 875+ 821D 22 49 F0         ld   (willy_head_ptr), hl
 876+ 8220 3A 2A EA         ld   a, (body_state)           ; 0, 1, 2
 877+ 8223 C6 05            add  a, 5                      ; tile 5, 6, 7
 878+ 8225 87               add  a, a
 878+ 8226 87             add a, a
 878+ 8227 87             add a, a ; * 8
 879+ 8228 5F               ld   e, a

 628  8327              ; -------------------------------------------------------------------
 629  8327              ; CheckVictoryCondition
 630  8327              ; Verifica le condizioni di completamento della caverna:
 631  8327              ; 1. Tutti gli oggetti della caverna raccolti;
 632  8327              ; 2. Willy collide con il portale attivo.
 633  8327              ; -------------------------------------------------------------------
 634  8327              CheckVictoryCondition:
 635  8327 C5               push bc
 636  8328 D5               push de
 637  8329 E5               push hl
 638  832A
 639  832A                  ; 1. Tutti gli item raccolti?
 640  832A CD 81 83         call CheckAllItemsCollected
 641  832D 30 4D            jr   nc, .no_victory
 642  832F
 643  832F                  ; 2. Willy collide con il portale (16x16)?
 644  832F 2A 14 92         ld   hl, (room_ptr)
 645  8332 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 646  8335 19               add  hl, de
 647  8336 4E               ld   c, (hl)
 648  8337 23               inc  hl
 649  8338 46               ld   b, (hl)                   ; BC = AttrAddr
 650  8339
 651  8339                  ; Offset = BC - 23552
 652  8339 60               ld   h, b
 653  833A 69               ld   l, c
 654  833B 01 00 A4         ld   bc, -23552
 655  833E 09               add  hl, bc
 656  833F
 657  833F                  ; PortalX = (Offset & 31) * 8, PortalY = (Offset / 32) * 8
 658  833F 7D               ld   a, l
 659  8340 E6 1F            and  31
 660  8342 87               add  a, a
 660  8343 87             add a, a
 660  8344 87             add a, a
 661  8345 5F               ld   e, a                      ; E = PortalX
 662  8346
 663  8346 CB 3C            srl  h
 663  8348 CB 1D          rr l
 664  834A CB 3C            srl  h
 664  834C CB 1D          rr l
 665  834E CB 3C            srl  h
 665  8350 CB 1D          rr l
 666  8352 CB 3C            srl  h
 666  8354 CB 1D          rr l
 667  8356 CB 3C            srl  h
 667  8358 CB 1D          rr l
 668  835A 7D               ld   a, l
 669  835B 87               add  a, a
 669  835C 87             add a, a
 669  835D 87             add a, a
 670  835E 57               ld   d, a                      ; D = PortalY
 671  835F
 672  835F                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 673  835F ED 4B 94 8E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 674  8363
 675  8363                  ; |WillyX - PortalX| < 12
 676  8363 7B               ld   a, e
 677  8364 91               sub  c
 678  8365 30 02            jr   nc, .x_diff_pos
 679  8367 ED 44            neg
 680  8369              .x_diff_pos:
 681  8369 FE 0C            cp   12
 682  836B 30 0F            jr   nc, .no_victory
 683  836D
 684  836D                  ; |WillyY - PortalY| < 14
 685  836D 7A               ld   a, d
 686  836E 90               sub  b
 687  836F 30 02            jr   nc, .y_diff_pos
 688  8371 ED 44            neg
 689  8373              .y_diff_pos:
 690  8373 FE 0E            cp   14
 691  8375 30 05            jr   nc, .no_victory
 692  8377
 693  8377                  ; Vittoria / Portale raggiunto!
 694  8377 E1               pop  hl
 695  8378 D1               pop  de
 696  8379 C1               pop  bc
 697  837A 37               scf
 698  837B C9               ret

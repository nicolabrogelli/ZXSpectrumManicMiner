 280  814A
 281  814A              ; -------------------------------------------------------------------
 282  814A              ; ShowTitleScreen
 283  814A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 284  814A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 285  814A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 286  814A              ; -------------------------------------------------------------------
 287  814A              ShowTitleScreen:
 288  814A                  ; 1. Disegna la schermata iniziale
 289  814A CD 69 62         call Gfx_DrawTitleScreen
 290  814D
 291  814D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 292  814D              .wait_title_enter_release:
 293  814D 76               halt
 294  814E 3E BF            ld   a, $bf
 295  8150 DB FE            in   a, ($fe)
 296  8152 1F               rra
 297  8153 30 F8            jr   nc, .wait_title_enter_release
 298  8155
 299  8155                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 300  8155 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 301  8157              .title_loop:
 302  8157 76               halt
 303  8158
 304  8158                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 305  8158 0C               inc  c
 306  8159 79               ld   a, c
 307  815A CB 3F            srl  a
 308  815C CB 3F            srl  a
 309  815E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 310  8160 E6 07            and  7
 311  8162 5F               ld   e, a
 312  8163 16 00            ld   d, 0
 313  8165 21 61 62         ld   hl, title_color_table
 314  8168 19               add  hl, de
 315  8169 7E               ld   a, (hl)               ; A = nuovo colore
 316  816A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 317  816D 06 20            ld   b, 32
 318  816F              .color_title_loop:
 319  816F 77               ld   (hl), a
 320  8170 23               inc  hl
 321  8171 10 FC            djnz .color_title_loop
 322  8173
 323  8173                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 324  8173 3E BF            ld   a, $bf
 325  8175 DB FE            in   a, ($fe)
 326  8177 1F               rra
 327  8178 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 328  817A
 329  817A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 330  817A              .wait_title_enter_release_after:
 331  817A 76               halt
 332  817B 3E BF            ld   a, $bf
 333  817D DB FE            in   a, ($fe)
 334  817F 1F               rra
 335  8180 30 F8            jr   nc, .wait_title_enter_release_after
 336  8182
 337  8182                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 338  8182 AF               xor  a
 339  8183 D3 FE            out  ($fe), a              ; Bordo a nero
 340  8185 21 8D 5C         ld   hl, ATTR_P
 341  8188 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 342  8189 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 343  818C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 344  818E 3E 07            ld   a, $07
 345  8190 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 346  8193
 347  8193                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 348  8193 CD 08 84         call ResetFullGameState
 349  8196
 350  8196                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 351  8196 C3 24 80         jp   LoadRoomAndRestart
 352  8199
 353  8199              ; -------------------------------------------------------------------
 354  8199              ; TriggerGameOver
 355  8199              ; Scatena la schermata di Game Over per la stanza corrente.
 356  8199              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 357  8199              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 358  8199              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 359  8199              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 360  8199              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 361  8199              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 362  8199              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 363  8199              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 364  8199              ; -------------------------------------------------------------------
 365  8199              TriggerGameOver:
 366  8199                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 367  8199 CD 4A 64         call Gfx_DrawGameOverScreen
 368  819C
 369  819C                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 370  819C              .wait_keys_release:

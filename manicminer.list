 299+ 7E70              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 300+ 7E70              ; -------------------------------------------------------------------
 301+ 7E70              CheckEnemyWillyOverlap:
 302+ 7E70 3A D9 E5         ld   a, (player_drawn_pos+1)
 303+ 7E73 FE FF            cp   $FF
 304+ 7E75 C8               ret  z                  ; Se Willy non è disegnato, esci
 305+ 7E76
 306+ 7E76                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 307+ 7E76 3A D8 E5         ld   a, (player_drawn_pos)
 308+ 7E79 E6 F8            and  $F8
 309+ 7E7B 5F               ld   e, a               ; E = WillyX & $F8
 310+ 7E7C 79               ld   a, c
 311+ 7E7D E6 F8            and  $F8                ; A = EnemyX & $F8
 312+ 7E7F 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 313+ 7E80 C6 10            add  a, 16
 314+ 7E82 FE 19            cp   25
 315+ 7E84 D0               ret  nc                 ; Fuori portata X
 316+ 7E85
 317+ 7E85                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30

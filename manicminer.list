1167+ 78D3 38 0E            jr   c, .collision
1168+ 78D5
1169+ 78D5                  ; 3. Punto inferiore: (X, Y + 15)
1170+ 78D5 C1               pop  bc
1171+ 78D6 C5               push bc
1172+ 78D7 78               ld   a, b
1173+ 78D8 C6 0F            add  a, 15
1174+ 78DA 47               ld   b, a

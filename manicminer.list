 470+ 87AF                  ; WillyTop <= ItemBottom
 471+ 87AF 78               ld   a, b                      ; A = WillyY
 472+ 87B0 BA               cp   d                         ; D = ItemBottom
 473+ 87B1 28 04            jr   z, .y_ok
 474+ 87B3 38 02            jr   c, .y_ok
 475+ 87B5 18 13            jr   .no_collision
 476+ 87B7
 477+ 87B7              .y_ok:
 478+ 87B7                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 87B7 BB               cp   e                         ; E = ItemTop

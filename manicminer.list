 986+ 77DD
 987+ 77DD                  ; Se la cella è sulla rampa, non considerarla un muro!
 988+ 77DD 53               ld   d, e              ; D = Row
 989+ 77DE 59               ld   e, c              ; E = Col
 990+ 77DF CD 4B 77         call IsCellOnRamp
 991+ 77E2 38 09            jr   c, .not_wall
 992+ 77E4
 993+ 77E4 7A               ld   a, d              ; A = Row
 994+ 77E5 4B               ld   c, e              ; C = Col
 995+ 77E6 CD 82 78         call GetCellFromUnpacked ; A = cell type

 761+ 60F5 6C               ld   l, h
 762+ 60F6 26 00            ld   h, 0
 763+ 60F8 29               add  hl, hl
 763+ 60F9 29             add hl, hl
 763+ 60FA 29             add hl, hl
 763+ 60FB 29             add hl, hl
 763+ 60FC 29             add hl, hl
 764+ 60FD 78               ld   a, b
 765+ 60FE 85               add  a, l
 766+ 60FF 6F               ld   l, a
 767+ 6100 30 01            jr   nc, .no_c
 768+ 6102 24               inc  h
 769+ 6103              .no_c:
 770+ 6103 7C               ld   a, h

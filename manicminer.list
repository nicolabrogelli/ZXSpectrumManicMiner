 138+ 80BB              ; Items_DrawRoom
 139+ 80BB              ;
 140+ 80BB              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 80BB              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 80BB              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 80BB              ;
 144+ 80BB              ; Record item nella stanza (5 byte):
 145+ 80BB              ;   +0 Color / Attributo
 146+ 80BB              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 80BB              ;   +2 Attr Address High
 148+ 80BB              ;   +3 Anim Mask (96)
 149+ 80BB              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 80BB              ; Fine lista: $FF
 151+ 80BB              ; -------------------------------------------------------------------
 152+ 80BB              Items_DrawRoom:
 153+ 80BB E5               push hl
 154+ 80BC D5               push de
 155+ 80BD C5               push bc
 156+ 80BE DD E5            push ix
 157+ 80C0 FD E5            push iy
 158+ 80C2
 159+ 80C2                  ; 1. Azzera items_grid (512 byte)
 160+ 80C2 21 4E 9C         ld   hl, items_grid
 161+ 80C5 11 4F 9C         ld   de, items_grid + 1
 162+ 80C8 36 00            ld   (hl), 0
 163+ 80CA 01 FF 01         ld   bc, 511
 164+ 80CD ED B0            ldir
 165+ 80CF
 166+ 80CF                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 80CF AF               xor  a
 168+ 80D0 32 CE A1         ld   (num_room_items), a
 169+ 80D3
 170+ 80D3 FD 21 7E A1      ld   iy, current_room_items
 171+ 80D7
 172+ 80D7                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80D7 2A CF A1         ld   hl, (room_ptr)
 174+ 80DA 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80DD 19               add  hl, de
 176+ 80DE E5               push hl
 177+ 80DF DD E1            pop  ix                        ; IX = bitmap item

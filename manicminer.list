1164+ 788C              ; Phys_CheckRampOnRoomChange
1165+ 788C              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 788C              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 788C              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 788C              ; -------------------------------------------------------------------
1169+ 788C              Phys_CheckRampOnRoomChange:
1170+ 788C E5               push hl
1171+ 788D D5               push de
1172+ 788E C5               push bc
1173+ 788F
1174+ 788F                  ; Offsets per RampData: DE + 218
1175+ 788F 21 DA 00         ld   hl, 218
1176+ 7892 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 7893
1178+ 7893 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 7894 32 0A CA         ld   (ramp_dir), a
1180+ 7897 23               inc  hl
1181+ 7898 5E               ld   e, (hl)
1182+ 7899 23               inc  hl
1183+ 789A 56               ld   d, (hl)           ; DE = Location
1184+ 789B 23               inc  hl
1185+ 789C 7E               ld   a, (hl)           ; A = Length
1186+ 789D 32 0B CA         ld   (ramp_len), a
1187+ 78A0
1188+ 78A0                  ; Controlla se DE (Location) è 0 o Length è 0
1189+ 78A0 7A               ld   a, d
1190+ 78A1 B3               or   e
1191+ 78A2 CA A9 79         jp   z, .no_ramp_change
1192+ 78A5 3A 0B CA         ld   a, (ramp_len)
1193+ 78A8 B7               or   a
1194+ 78A9 CA A9 79         jp   z, .no_ramp_change
1195+ 78AC
1196+ 78AC                  ; Calcola Row e Col: Offset = DE - 24064
1197+ 78AC 21 00 A2         ld   hl, -24064
1198+ 78AF 19               add  hl, de            ; HL = Offset

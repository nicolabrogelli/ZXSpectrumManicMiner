 386+ 7DD5              ; Enemy_Update
 387+ 7DD5              ;
 388+ 7DD5              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7DD5              ; -------------------------------------------------------------------
 390+ 7DD5              Enemy_Update:
 391+ 7DD5                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7DD5 3A 59 98         ld   a, (enemy_update_rate)
 393+ 7DD8 FE 01            cp   1
 394+ 7DDA 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7DDC
 396+ 7DDC 21 5A 98         ld   hl, enemy_update_timer
 397+ 7DDF 34               inc  (hl)
 398+ 7DE0 7E               ld   a, (hl)
 399+ 7DE1 21 59 98         ld   hl, enemy_update_rate
 400+ 7DE4 BE               cp   (hl)
 401+ 7DE5 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7DE6 AF               xor  a
 403+ 7DE7 32 5A 98         ld   (enemy_update_timer), a
 404+ 7DEA
 405+ 7DEA              .do_update:
 406+ 7DEA E5               push hl
 407+ 7DEB D5               push de
 408+ 7DEC C5               push bc
 409+ 7DED DD E5            push ix
 410+ 7DEF
 411+ 7DEF 3E 01            ld   a, 1
 412+ 7DF1 32 E0 98         ld   (enemy_was_updated), a
 413+ 7DF4
 414+ 7DF4 DD 21 A5 7B      ld   ix, ActiveEnemies
 415+ 7DF8 06 08            ld   b, 8                      ; 8 slot
 416+ 7DFA              .loop:
 417+ 7DFA DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7DFD E6 80            and  $80                       ; Active?
 419+ 7DFF CA 9E 7E         jp   z, .next
 420+ 7E02
 421+ 7E02                  ; 1. Aggiorna Anim State (0..3)
 422+ 7E02 DD 7E 07         ld   a, (ix+7)
 423+ 7E05 3C               inc  a
 424+ 7E06 E6 03            and  3
 425+ 7E08 DD 77 07         ld   (ix+7), a
 426+ 7E0B
 427+ 7E0B                  ; 2. Determina se orizzontale o verticale
 428+ 7E0B DD 7E 00         ld   a, (ix+0)
 429+ 7E0E E6 40            and  $40                       ; Vertical?
 430+ 7E10 C2 5A 7E         jp   nz, .vertical
 431+ 7E13
 432+ 7E13              .horizontal:
 433+ 7E13 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7E16 FE 01            cp   1
 435+ 7E18 20 20            jr   nz, .horiz_right
 436+ 7E1A
 437+ 7E1A              .horiz_left:
 438+ 7E1A DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7E1D D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7E1F DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7E22 28 08            jr   z, .h_rev_right
 442+ 7E24 38 06            jr   c, .h_rev_right
 443+ 7E26 DD 77 02         ld   (ix+2), a
 444+ 7E29 C3 9E 7E         jp   .next
 445+ 7E2C
 446+ 7E2C              .h_rev_right:
 447+ 7E2C DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7E2F DD 77 02         ld   (ix+2), a
 449+ 7E32 3E 02            ld   a, 2
 450+ 7E34 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7E37 C3 9E 7E         jp   .next
 452+ 7E3A
 453+ 7E3A              .horiz_right:
 454+ 7E3A DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7E3D C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7E3F DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7E42 28 08            jr   z, .h_rev_left
 458+ 7E44 30 06            jr   nc, .h_rev_left
 459+ 7E46 DD 77 02         ld   (ix+2), a
 460+ 7E49 C3 9E 7E         jp   .next
 461+ 7E4C
 462+ 7E4C              .h_rev_left:
 463+ 7E4C DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7E4F DD 77 02         ld   (ix+2), a
 465+ 7E52 3E 01            ld   a, 1
 466+ 7E54 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7E57 C3 9E 7E         jp   .next
 468+ 7E5A
 469+ 7E5A              .vertical:
 470+ 7E5A DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7E5D FE 01            cp   1
 472+ 7E5F 20 20            jr   nz, .vert_down
 473+ 7E61
 474+ 7E61              .vert_up:
 475+ 7E61 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 476+ 7E64 D6 02            sub  2
 477+ 7E66 DD BE 04         cp   (ix+4)
 478+ 7E69 28 08            jr   z, .v_rev_down
 479+ 7E6B 38 06            jr   c, .v_rev_down
 480+ 7E6D DD 77 03         ld   (ix+3), a
 481+ 7E70 C3 9E 7E         jp   .next
 482+ 7E73
 483+ 7E73              .v_rev_down:
 484+ 7E73 DD 7E 04         ld   a, (ix+4)
 485+ 7E76 DD 77 03         ld   (ix+3), a
 486+ 7E79 3E 02            ld   a, 2
 487+ 7E7B DD 77 06         ld   (ix+6), a
 488+ 7E7E C3 9E 7E         jp   .next
 489+ 7E81
 490+ 7E81              .vert_down:
 491+ 7E81 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7E84 C6 02            add  a, 2
 493+ 7E86 DD BE 05         cp   (ix+5)
 494+ 7E89 28 08            jr   z, .v_rev_up
 495+ 7E8B 30 06            jr   nc, .v_rev_up
 496+ 7E8D DD 77 03         ld   (ix+3), a
 497+ 7E90 C3 9E 7E         jp   .next
 498+ 7E93
 499+ 7E93              .v_rev_up:
 500+ 7E93 DD 7E 05         ld   a, (ix+5)
 501+ 7E96 DD 77 03         ld   (ix+3), a
 502+ 7E99 3E 01            ld   a, 1
 503+ 7E9B DD 77 06         ld   (ix+6), a
 504+ 7E9E
 505+ 7E9E              .next:
 506+ 7E9E 11 0B 00         ld   de, 11
 507+ 7EA1 DD 19            add  ix, de
 508+ 7EA3 05               dec  b
 509+ 7EA4 C2 FA 7D         jp   nz, .loop
 510+ 7EA7
 511+ 7EA7 DD E1            pop  ix
 512+ 7EA9 C1               pop  bc
 513+ 7EAA D1               pop  de
 514+ 7EAB E1               pop  hl
 515+ 7EAC C9               ret

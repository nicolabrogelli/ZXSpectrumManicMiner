 717+ 8724 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 8726 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 8728
 720+ 8728                  ; Byte 1:
 721+ 8728 3A C7 EF         ld   a, (player_score + 1)
 722+ 872B 47               ld   b, a
 723+ 872C 3A CA EF         ld   a, (high_score + 1)
 724+ 872F B8               cp   b
 725+ 8730 38 0C            jr   c, .new_high_score
 726+ 8732 20 1C            jr   nz, .done_check
 727+ 8734
 728+ 8734                  ; Byte 0:
 729+ 8734 3A C6 EF         ld   a, (player_score + 0)
 730+ 8737 47               ld   b, a
 731+ 8738 3A C9 EF         ld   a, (high_score + 0)
 732+ 873B B8               cp   b
 733+ 873C 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 873E
 735+ 873E              .new_high_score:
 736+ 873E 3A C6 EF         ld   a, (player_score + 0)
 737+ 8741 32 C9 EF         ld   (high_score + 0), a
 738+ 8744 3A C7 EF         ld   a, (player_score + 1)
 739+ 8747 32 CA EF         ld   (high_score + 1), a

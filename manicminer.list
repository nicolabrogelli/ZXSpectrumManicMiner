 504+ 7F21              .horiz_right:
 505+ 7F21 DD 7E 02         ld   a, (ix+2)                 ; Current X
 506+ 7F24 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 507+ 7F26 DD BE 05         cp   (ix+5)                    ; Max Limit
 508+ 7F29 28 08            jr   z, .h_rev_left
 509+ 7F2B 30 06            jr   nc, .h_rev_left
 510+ 7F2D DD 77 02         ld   (ix+2), a
 511+ 7F30 C3 90 7F         jp   .next

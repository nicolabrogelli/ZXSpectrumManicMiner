 671+ 6093              ; -------------------------------------------------------------------
 672+ 6093              ; Gfx_ApplyPlayerTileLayers
 673+ 6093              ; Gestisce la colorazione e il livello di Willy rispetto alle tiles della stanza:
 674+ 6093              ; - Scansiona tutte le celle 8x8 sovrapposte dallo sprite 16x16 di Willy (PlayerPos).
 675+ 6093              ; - Se la cella è spazio vuoto (tile 0): applica il colore bianco brillante di Willy.
 676+ 6093              ; - Se la cella contiene un tile della stanza (Floor, Wall, Crumbling, Conveyor, Nasty, Portal, Item):
 677+ 6093              ;   la cella mantiene l'attributo originale del tile, così la parte di Willy sovrapposta
 678+ 6093              ;   prende il colore del tile, esattamente come nel gioco originale per ZX Spectrum!
 679+ 6093              ; Input: C = PlayerX, B = PlayerY
 680+ 6093              ; -------------------------------------------------------------------
 681+ 6093              Gfx_ApplyPlayerTileLayers:
 682+ 6093 E5               push hl
 683+ 6094 D5               push de
 684+ 6095 C5               push bc
 685+ 6096
 686+ 6096                  ; Se Y >= 128, esci
 687+ 6096 78               ld   a, b
 688+ 6097 FE 80            cp   128
 689+ 6099 D2 16 61         jp   nc, .done_layers
 690+ 609C
 691+ 609C                  ; Calcola ColStart (E) e ColEnd (C)
 692+ 609C 79               ld   a, c
 693+ 609D CB 3F            srl  a
 693+ 609F CB 3F          srl a
 693+ 60A1 CB 3F          srl a
 694+ 60A3 5F               ld   e, a                  ; E = ColStart (0..31)
 695+ 60A4
 696+ 60A4 79               ld   a, c
 697+ 60A5 C6 0F            add  a, 15
 698+ 60A7 CB 3F            srl  a
 698+ 60A9 CB 3F          srl a
 698+ 60AB CB 3F          srl a
 699+ 60AD 4F               ld   c, a                  ; C = ColEnd (0..31)
 700+ 60AE
 701+ 60AE                  ; Calcola RowStart (H) e RowEnd (L)
 702+ 60AE 78               ld   a, b
 703+ 60AF CB 3F            srl  a
 703+ 60B1 CB 3F          srl a
 703+ 60B3 CB 3F          srl a
 704+ 60B5 67               ld   h, a                  ; H = RowStart (0..15)
 705+ 60B6
 706+ 60B6 78               ld   a, b
 707+ 60B7 C6 0F            add  a, 15
 708+ 60B9 CB 3F            srl  a
 708+ 60BB CB 3F          srl a
 708+ 60BD CB 3F          srl a
 709+ 60BF 6F               ld   l, a                  ; L = RowEnd (0..15)
 710+ 60C0
 711+ 60C0              .row_loop:
 712+ 60C0 7C               ld   a, h
 713+ 60C1 BD               cp   l
 714+ 60C2 28 03            jr   z, .ok_row
 715+ 60C4 D2 16 61         jp   nc, .done_layers
 716+ 60C7              .ok_row:

 201+ 7D77                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 7D77 E5               push hl
 203+ 7D78 60               ld   h, b
 204+ 7D79 69               ld   l, c
 205+ 7D7A 01 00 A4         ld   bc, -23552
 206+ 7D7D 09               add  hl, bc                    ; HL = AttrOffset
 207+ 7D7E
 208+ 7D7E                  ; Col = Offset & 31

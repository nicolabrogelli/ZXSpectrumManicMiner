 641+ 864C                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 642+ 864C 3A BD E7         ld   a, (player_score + 1)
 643+ 864F C6 01            add  a, $01
 644+ 8651 27               daa
 645+ 8652 32 BD E7         ld   (player_score + 1), a
 646+ 8655
 647+ 8655                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 648+ 8655 3A BE E7         ld   a, (player_score + 2)

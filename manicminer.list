 187+ 7E52 7D               ld   a, l
 188+ 7E53 47               ld   b, a                      ; B = Row (0..15)
 189+ 7E54
 190+ 7E54                  ; Disegna l'item sullo schermo
 191+ 7E54 DD E5            push ix
 192+ 7E56 E1               pop  hl                        ; HL = puntatore bitmap
 193+ 7E57 CD 94 7E         call DrawItemGraphic

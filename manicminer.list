 293+ 84E0              ; DrawItemGraphic
 294+ 84E0              ;
 295+ 84E0              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 296+ 84E0              ; utilizzando una bitmap di 8 byte e un attributo colore.
 297+ 84E0              ;
 298+ 84E0              ; Input:
 299+ 84E0              ;   B = Riga attributi (0..23)
 300+ 84E0              ;   C = Colonna attributi (0..31)
 301+ 84E0              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 302+ 84E0              ;   E = Attributo colore

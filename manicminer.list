1714+ 66BF 76               halt
1715+ 66C0 10 FD            djnz .pause_after_foot
1716+ 66C2
1717+ 66C2                  ; 9. Solo DOPO la pausa, fa comparire GAME OVER al centro dello schermo a riga 5, colonna 11
1718+ 66C2 21 B8 65         ld   hl, game_over_str
1719+ 66C5 06 09            ld   b, 9
1720+ 66C7 16 05            ld   d, 5
1721+ 66C9 1E 0B            ld   e, 11
1722+ 66CB CD 41 62         call Gfx_PrintDirectText

 414+ 82D2              ; CheckWillyItemCollision
 415+ 82D2              ;
 416+ 82D2              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 82D2              ; Input:
 418+ 82D2              ;   A = Item Col (0..31)
 419+ 82D2              ;   H = Item Row (0..15)
 420+ 82D2              ; Output:
 421+ 82D2              ;   Carry Set = Collisione
 422+ 82D2              ;   Carry Clear = Nessuna collisione
 423+ 82D2              ; -------------------------------------------------------------------
 424+ 82D2              CheckWillyItemCollision:
 425+ 82D2 C5               push bc
 426+ 82D3 D5               push de
 427+ 82D4 E5               push hl

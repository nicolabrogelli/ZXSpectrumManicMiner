1217+ 77AA 28 1C            jr   z, .is_floor
1218+ 77AC DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 77AF 28 1B            jr   z, .is_crumbling
1220+ 77B1 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 77B4 28 1E            jr   z, .is_conveyor
1222+ 77B6 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 77B9 28 1D            jr   z, .is_nasty1
1224+ 77BB DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?

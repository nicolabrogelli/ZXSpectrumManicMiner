 891+ 778A 47               ld   b, a              ; B = limit_left
 892+ 778B
 893+ 778B 3A B9 E4         ld   a, (ramp_col)
 894+ 778E 3C               inc  a
 895+ 778F 4F               ld   c, a              ; C = limit_right (exclusive)
 896+ 7790
 897+ 7790 7B               ld   a, e              ; A = Col
 898+ 7791 B8               cp   b
 899+ 7792 38 15            jr   c, .check_platform_case
 900+ 7794 B9               cp   c
 901+ 7795 30 12            jr   nc, .check_platform_case

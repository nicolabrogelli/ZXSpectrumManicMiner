 284  8139              ; ShowTitleScreen
 285  8139              ; Visualizza la schermata iniziale del gioco (Title Screen).
 286  8139              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 287  8139              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 288  8139              ; -------------------------------------------------------------------
 289  8139              ShowTitleScreen:
 290  8139                  ; 1. Disegna la schermata iniziale
 291  8139 CD 69 62         call Gfx_DrawTitleScreen
 292  813C
 293  813C                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 294  813C              .wait_title_enter_release:
 295  813C 76               halt
 296  813D 3E BF            ld   a, $bf
 297  813F DB FE            in   a, ($fe)
 298  8141 1F               rra
 299  8142 30 F8            jr   nc, .wait_title_enter_release
 300  8144
 301  8144                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 302  8144 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 303  8146              .title_loop:
 304  8146 76               halt
 305  8147
 306  8147                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 307  8147 0C               inc  c
 308  8148 79               ld   a, c
 309  8149 CB 3F            srl  a
 310  814B CB 3F            srl  a
 311  814D CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 312  814F E6 07            and  7
 313  8151 5F               ld   e, a
 314  8152 16 00            ld   d, 0
 315  8154 21 61 62         ld   hl, title_color_table
 316  8157 19               add  hl, de
 317  8158 7E               ld   a, (hl)               ; A = nuovo colore
 318  8159 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 319  815C 06 20            ld   b, 32
 320  815E              .color_title_loop:
 321  815E 77               ld   (hl), a
 322  815F 23               inc  hl
 323  8160 10 FC            djnz .color_title_loop
 324  8162
 325  8162                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 326  8162 3E BF            ld   a, $bf
 327  8164 DB FE            in   a, ($fe)
 328  8166 1F               rra
 329  8167 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 330  8169
 331  8169                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 332  8169              .wait_title_enter_release_after:
 333  8169 76               halt
 334  816A 3E BF            ld   a, $bf
 335  816C DB FE            in   a, ($fe)
 336  816E 1F               rra
 337  816F 30 F8            jr   nc, .wait_title_enter_release_after
 338  8171
 339  8171                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 340  8171 AF               xor  a
 341  8172 D3 FE            out  ($fe), a              ; Bordo a nero
 342  8174 21 8D 5C         ld   hl, ATTR_P
 343  8177 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 344  8178 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 345  817B 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 346  817D 3E 07            ld   a, $07
 347  817F 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 348  8182
 349  8182                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 350  8182 CD C0 83         call ResetFullGameState
 351  8185
 352  8185                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 353  8185 C3 13 80         jp   LoadRoomAndRestart
 354  8188
 355  8188              ; -------------------------------------------------------------------
 356  8188              ; TriggerGameOver
 357  8188              ; Scatena la schermata di Game Over per la stanza corrente.
 358  8188              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 359  8188              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 360  8188              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 361  8188              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 362  8188              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 363  8188              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 364  8188              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 365  8188              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 366  8188              ; -------------------------------------------------------------------
 367  8188              TriggerGameOver:
 368  8188                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 369  8188 CD 4A 64         call Gfx_DrawGameOverScreen
 370  818B
 371  818B                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 372  818B              .wait_keys_release:
 373  818B 76               halt
 374  818C                  ; Controlla tasto Y (Porta $DF, bit 4)
 375  818C 01 FE DF         ld   bc, $dffe
 376  818F ED 78            in   a, (c)
 377  8191 CB 67            bit  4, a
 378  8193 28 F6            jr   z, .wait_keys_release
 379  8195
 380  8195                  ; Controlla tasto N (Porta $7F, bit 3)
 381  8195 01 FE 7F         ld   bc, $7ffe
 382  8198 ED 78            in   a, (c)
 383  819A CB 5F            bit  3, a
 384  819C 28 ED            jr   z, .wait_keys_release
 385  819E
 386  819E                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 387  819E 01 FE BF         ld   bc, $bffe
 388  81A1 ED 78            in   a, (c)
 389  81A3 CB 47            bit  0, a
 390  81A5 28 E4            jr   z, .wait_keys_release
 391  81A7
 392  81A7                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 393  81A7 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 394  81A9              .wait_choice_loop:
 395  81A9 76               halt
 396  81AA
 397  81AA                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 398  81AA 0C               inc  c
 399  81AB 79               ld   a, c
 400  81AC CB 3F            srl  a
 401  81AE CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 402  81B0 E6 07            and  7
 403  81B2 5F               ld   e, a
 404  81B3 16 00            ld   d, 0
 405  81B5 21 06 64         ld   hl, game_over_color_table
 406  81B8 19               add  hl, de
 407  81B9 7E               ld   a, (hl)               ; A = nuovo colore attributo
 408  81BA 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 409  81BD 06 09            ld   b, 9
 410  81BF              .color_cycle_loop:
 411  81BF 77               ld   (hl), a
 412  81C0 23               inc  hl
 413  81C1 10 FC            djnz .color_cycle_loop
 414  81C3
 415  81C3                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 416  81C3 01 FE DF         ld   bc, $dffe
 417  81C6 ED 78            in   a, (c)
 418  81C8 CB 67            bit  4, a
 419  81CA 28 2A            jr   z, .continue_chosen
 420  81CC
 421  81CC                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 422  81CC 01 FE 7F         ld   bc, $7ffe
 423  81CF ED 78            in   a, (c)
 424  81D1 CB 5F            bit  3, a
 425  81D3 28 0B            jr   z, .quit_chosen
 426  81D5
 427  81D5                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 428  81D5 01 FE BF         ld   bc, $bffe
 429  81D8 ED 78            in   a, (c)
 430  81DA CB 47            bit  0, a
 431  81DC 28 02            jr   z, .quit_chosen
 432  81DE
 433  81DE 18 C9            jr   .wait_choice_loop
 434  81E0
 435  81E0              .quit_chosen:
 436  81E0                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 437  81E0              .wait_quit_release:
 438  81E0 76               halt
 439  81E1 01 FE 7F         ld   bc, $7ffe
 440  81E4 ED 78            in   a, (c)
 441  81E6 CB 5F            bit  3, a
 442  81E8 28 F6            jr   z, .wait_quit_release
 443  81EA 01 FE BF         ld   bc, $bffe
 444  81ED ED 78            in   a, (c)
 445  81EF CB 47            bit  0, a
 446  81F1 28 ED            jr   z, .wait_quit_release
 447  81F3
 448  81F3                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 449  81F3 C3 39 81         jp   ShowTitleScreen
 450  81F6
 451  81F6              .continue_chosen:
 452  81F6                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 453  81F6              .wait_continue_release:
 454  81F6 76               halt
 455  81F7 01 FE DF         ld   bc, $dffe
 456  81FA ED 78            in   a, (c)
 457  81FC CB 67            bit  4, a
 458  81FE 28 F6            jr   z, .wait_continue_release
 459  8200
 460  8200                  ; 5b. Ripristina lo stato per continuare la partita:
 461  8200                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 462  8200 CD 1D 7D         call Items_ResetCurrentRoomItems
 463  8203
 464  8203                  ; - Ripristina le vite di Willy al valore iniziale
 465  8203 3E 07            ld   a, INITIAL_LIVES
 466  8205 32 72 8E         ld   (willy_lives), a
 467  8208
 468  8208                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 469  8208 2A 86 8E         ld   hl, (counter)
 470  820B 22 89 8E         ld   (last_frame_counter), hl
 471  820E
 472  820E                  ; - Reimposta la fisica e le variabili di stato di Willy
 473  820E AF               xor  a
 474  820F 32 73 8E         ld   (velocity_y), a
 475  8212 32 75 8E         ld   (jump_pressed), a
 476  8215 32 77 8E         ld   (coyote_timer), a
 477  8218 32 7A 8E         ld   (jump_frame), a
 478  821B 32 79 8E         ld   (jump_dir), a
 479  821E 32 6B 8E         ld   (body_state), a
 480  8221 32 7E 8E         ld   (w_warp_state), a
 481  8224 32 81 8E         ld   (w_key_prev), a
 482  8227 32 82 8E         ld   (enter_key_prev), a
 483  822A 32 6E 8E         ld   (collision_active), a
 484  822D 32 6D 8E         ld   (flags), a
 485  8230 32 66 92         ld   (ramp_entry_guard), a
 486  8233 32 71 92         ld   (willy_on_ramp), a
 487  8236 32 70 92         ld   (willy_needs_redraw), a
 488  8239 3E FF            ld   a, $ff
 489  823B 32 83 8E         ld   (digit_key_prev), a
 490  823E 32 6B 92         ld   (player_drawn_pos+1), a
 491  8241 32 6C 92         ld   (player_old_dir), a
 492  8244 32 6D 92         ld   (player_old_body), a
 493  8247 3E 01            ld   a, 1
 494  8249 32 7C 8E         ld   (q_prev), a
 495  824C 32 7D 8E         ld   (a_prev), a
 496  824F 32 74 8E         ld   (on_ground), a
 497  8252 32 6E 92         ld   (enemy_was_updated), a
 498  8255
 499  8255                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 500  8255 3E 00            ld   a, RESPAWN_SAFETY_TIME
 501  8257 32 6F 92         ld   (willy_safety_timer), a
 502  825A
 503  825A                  ; - Ripristina lo stato audio
 504  825A 3E 12            ld   a, 18
 505  825C 32 7D 94         ld   (Audio_jump_sound_note), a
 506  825F AF               xor  a
 507  8260 32 7E 94         ld   (Audio_jump_sound_timer), a
 508  8263                  IF ENABLE_MUSIC != 0
 509  8263 ~                ld   (Audio_music_note_idx), a
 510  8263 ~                ld   a, 1
 511  8263 ~                ld   (Audio_music_frame_counter), a
 512  8263                  ENDIF
 513  8263
 514  8263                  ; - Riposiziona Willy nel punto di default definito nella stanza
 515  8263 AF               xor  a
 516  8264 32 EB 91         ld   (transition_active), a
 517  8267
 518  8267                  ; - Cancella lo schermo a nero prima del caricamento
 519  8267 AF               xor  a
 520  8268 D3 FE            out  ($fe), a
 521  826A 21 8D 5C         ld   hl, ATTR_P
 522  826D 77               ld   (hl), a
 523  826E CD AF 0D         call CLS
 524  8271 36 07            ld   (hl), $07
 525  8273 3E 07            ld   a, $07
 526  8275 32 8F 5C         ld   (ATTR_T), a
 527  8278
 528  8278                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 529  8278 C3 13 80         jp   LoadRoomAndRestart
 530  827B
 531  827B              ; -------------------------------------------------------------------
 532  827B              ; TriggerVictory
 533  827B              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 534  827B              ; - Pulisce gli elementi di gioco della stanza.
 535  827B              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 536  827B              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 537  827B              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 538  827B              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 539  827B              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 540  827B              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 541  827B              ; -------------------------------------------------------------------
 542  827B              TriggerVictory:
 543  827B                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 544  827B CD 63 65         call Gfx_DrawVictoryScreen
 545  827E
 546  827E                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 547  827E              .wait_keys_release:
 548  827E 76               halt
 549  827F                  ; Controlla tasto Y (Porta $DF, bit 4)
 550  827F 01 FE DF         ld   bc, $dffe
 551  8282 ED 78            in   a, (c)
 552  8284 CB 67            bit  4, a
 553  8286 28 F6            jr   z, .wait_keys_release
 554  8288
 555  8288                  ; Controlla tasto N (Porta $7F, bit 3)
 556  8288 01 FE 7F         ld   bc, $7ffe
 557  828B ED 78            in   a, (c)
 558  828D CB 5F            bit  3, a
 559  828F 28 ED            jr   z, .wait_keys_release
 560  8291
 561  8291                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 562  8291 01 FE BF         ld   bc, $bffe
 563  8294 ED 78            in   a, (c)
 564  8296 CB 47            bit  0, a
 565  8298 28 E4            jr   z, .wait_keys_release
 566  829A
 567  829A                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 568  829A 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 569  829C              .wait_choice_loop:
 570  829C 76               halt
 571  829D
 572  829D                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 573  829D 0C               inc  c
 574  829E 79               ld   a, c
 575  829F CB 3F            srl  a
 576  82A1 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 577  82A3 E6 07            and  7
 578  82A5 5F               ld   e, a
 579  82A6 16 00            ld   d, 0
 580  82A8 21 42 64         ld   hl, victory_color_table
 581  82AB 19               add  hl, de
 582  82AC 7E               ld   a, (hl)               ; A = nuovo colore attributo
 583  82AD 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 584  82B0 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 585  82B2              .color_cycle_loop:
 586  82B2 77               ld   (hl), a
 587  82B3 23               inc  hl
 588  82B4 10 FC            djnz .color_cycle_loop
 589  82B6
 590  82B6                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 591  82B6 01 FE DF         ld   bc, $dffe
 592  82B9 ED 78            in   a, (c)
 593  82BB CB 67            bit  4, a
 594  82BD 28 2A            jr   z, .play_again_chosen
 595  82BF
 596  82BF                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 597  82BF 01 FE 7F         ld   bc, $7ffe
 598  82C2 ED 78            in   a, (c)
 599  82C4 CB 5F            bit  3, a
 600  82C6 28 0B            jr   z, .quit_chosen
 601  82C8
 602  82C8                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 603  82C8 01 FE BF         ld   bc, $bffe
 604  82CB ED 78            in   a, (c)
 605  82CD CB 47            bit  0, a
 606  82CF 28 02            jr   z, .quit_chosen
 607  82D1
 608  82D1 18 C9            jr   .wait_choice_loop
 609  82D3
 610  82D3              .quit_chosen:
 611  82D3                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 612  82D3              .wait_quit_release:
 613  82D3 76               halt
 614  82D4 01 FE 7F         ld   bc, $7ffe
 615  82D7 ED 78            in   a, (c)
 616  82D9 CB 5F            bit  3, a
 617  82DB 28 F6            jr   z, .wait_quit_release
 618  82DD 01 FE BF         ld   bc, $bffe
 619  82E0 ED 78            in   a, (c)
 620  82E2 CB 47            bit  0, a
 621  82E4 28 ED            jr   z, .wait_quit_release
 622  82E6
 623  82E6                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 624  82E6 C3 39 81         jp   ShowTitleScreen
 625  82E9
 626  82E9              .play_again_chosen:
 627  82E9                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 628  82E9              .wait_play_again_release:
 629  82E9 76               halt
 630  82EA 01 FE DF         ld   bc, $dffe
 631  82ED ED 78            in   a, (c)
 632  82EF CB 67            bit  4, a
 633  82F1 28 F6            jr   z, .wait_play_again_release
 634  82F3
 635  82F3                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 636  82F3 CD C0 83         call ResetFullGameState
 637  82F6 C3 13 80         jp   LoadRoomAndRestart
 638  82F9
 639  82F9              ; -------------------------------------------------------------------
 640  82F9              ; CheckVictoryCondition
 641  82F9              ; Verifica le condizioni di completamento della caverna:
 642  82F9              ; 1. Tutti gli oggetti della caverna raccolti;
 643  82F9              ; 2. Willy collide con il portale attivo.
 644  82F9              ; -------------------------------------------------------------------
 645  82F9              CheckVictoryCondition:
 646  82F9 C5               push bc
 647  82FA D5               push de
 648  82FB E5               push hl
 649  82FC
 650  82FC                  ; 1. Tutti gli item raccolti?
 651  82FC CD 53 83         call CheckAllItemsCollected
 652  82FF 30 4D            jr   nc, .no_victory
 653  8301
 654  8301                  ; 2. Willy collide con il portale (16x16)?
 655  8301 2A E5 91         ld   hl, (room_ptr)
 656  8304 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8307 19               add  hl, de
 658  8308 4E               ld   c, (hl)
 659  8309 23               inc  hl
 660  830A 46               ld   b, (hl)                   ; BC = AttrAddr
 661  830B
 662  830B                  ; Offset = BC - 23552
 663  830B 60               ld   h, b
 664  830C 69               ld   l, c
 665  830D 01 00 A4         ld   bc, -23552
 666  8310 09               add  hl, bc
 667  8311
 668  8311                  ; PortalX = (Offset & 31) * 8, PortalY = (Offset / 32) * 8
 669  8311 7D               ld   a, l
 670  8312 E6 1F            and  31
 671  8314 87               add  a, a
 671  8315 87             add a, a
 671  8316 87             add a, a
 672  8317 5F               ld   e, a                      ; E = PortalX
 673  8318
 674  8318 CB 3C            srl  h
 674  831A CB 1D          rr l
 675  831C CB 3C            srl  h
 675  831E CB 1D          rr l
 676  8320 CB 3C            srl  h
 676  8322 CB 1D          rr l
 677  8324 CB 3C            srl  h
 677  8326 CB 1D          rr l
 678  8328 CB 3C            srl  h
 678  832A CB 1D          rr l
 679  832C 7D               ld   a, l
 680  832D 87               add  a, a
 680  832E 87             add a, a
 680  832F 87             add a, a
 681  8330 57               ld   d, a                      ; D = PortalY
 682  8331
 683  8331                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 684  8331 ED 4B 65 8E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 685  8335
 686  8335                  ; |WillyX - PortalX| < 12
 687  8335 7B               ld   a, e
 688  8336 91               sub  c
 689  8337 30 02            jr   nc, .x_diff_pos
 690  8339 ED 44            neg
 691  833B              .x_diff_pos:
 692  833B FE 0C            cp   12
 693  833D 30 0F            jr   nc, .no_victory
 694  833F
 695  833F                  ; |WillyY - PortalY| < 14
 696  833F 7A               ld   a, d
 697  8340 90               sub  b
 698  8341 30 02            jr   nc, .y_diff_pos
 699  8343 ED 44            neg
 700  8345              .y_diff_pos:
 701  8345 FE 0E            cp   14
 702  8347 30 05            jr   nc, .no_victory
 703  8349
 704  8349                  ; Vittoria / Portale raggiunto!
 705  8349 E1               pop  hl
 706  834A D1               pop  de
 707  834B C1               pop  bc
 708  834C 37               scf
 709  834D C9               ret
 710  834E
 711  834E              .no_victory:
 712  834E E1               pop  hl
 713  834F D1               pop  de
 714  8350 C1               pop  bc
 715  8351 B7               or   a
 716  8352 C9               ret
 717  8353
 718  8353              ; -------------------------------------------------------------------
 719  8353              ; CheckAllItemsCollected
 720  8353              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 721  8353              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 722  8353              ; -------------------------------------------------------------------
 723  8353              CheckAllItemsCollected:
 724  8353 3A 7A 94         ld   a, (game_objective_completed)

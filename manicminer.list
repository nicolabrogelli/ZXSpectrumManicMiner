 616  8637 28 02            jr   z, .quit_chosen
 617  8639
 618  8639 18 C9            jr   .wait_choice_loop
 619  863B
 620  863B              .quit_chosen:
 621  863B                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 622  863B              .wait_quit_release:
 623  863B 76               halt
 624  863C 01 FE 7F         ld   bc, $7ffe
 625  863F ED 78            in   a, (c)
 626  8641 CB 5F            bit  3, a
 627  8643 28 F6            jr   z, .wait_quit_release
 628  8645 01 FE BF         ld   bc, $bffe
 629  8648 ED 78            in   a, (c)
 630  864A CB 47            bit  0, a
 631  864C 28 ED            jr   z, .wait_quit_release

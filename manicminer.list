1124+ 8361 26 00            ld   h, 0
1125+ 8363 ED 5B 49 F0      ld   de, (willy_head_ptr)
1126+ 8367 19               add  hl, de
1127+ 8368 7E               ld   a, (hl)                   ; A = byte testa Willy
1128+ 8369
1129+ 8369              .do_pixel_and:

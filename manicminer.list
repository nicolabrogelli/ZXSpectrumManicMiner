# file opened: physics_config.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; physics_config.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Configurazioni globali per la fisica del salto e del movimento in Manic Miner.
   5+ 5DAD              ; Tutti i parametri di default della fisica possono essere personalizzati qui.
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DDEFAULT_JUMP_STRENGTH=5 -DDEFAULT_GRAVITY_PRESET=1).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Forza del Salto di Default (Altezza iniziale) ---
  11+ 5DAD              ; Definisce l'impulso verticale iniziale per il salto quando la stanza non specifica un valore personalizzato.
  12+ 5DAD              ; Valori tipici:
  13+ 5DAD              ;   6 = Salto standard (Manic Miner originale)
  14+ 5DAD              ;   5 = Salto medio/corto
  15+ 5DAD              ;   4 = Salto corto
  16+ 5DAD                  IFNDEF DEFAULT_JUMP_STRENGTH
  17+ 5DAD              DEFAULT_JUMP_STRENGTH EQU 6
  18+ 5DAD                  ENDIF
  19+ 5DAD
  20+ 5DAD              ; Alias per compatibilità con il codice esistente
  21+ 5DAD              JUMP_STRENGTH: EQU DEFAULT_JUMP_STRENGTH
  22+ 5DAD
  23+ 5DAD              ; --- Preset Gravità di Default ---
  24+ 5DAD              ; Definisce il comportamento della gravità per le stanze che non hanno un valore personalizzato.
  25+ 5DAD              ; Presets:
  26+ 5DAD              ;   0 = Gravità 0.5 (leggera)
  27+ 5DAD              ;   1 = Gravità 0.75 (standard MM)
  28+ 5DAD              ;   2 = Gravità 1.0 (pesante)
  29+ 5DAD              ;   3 = Gravità 0.25 (molto leggera)
  30+ 5DAD              ;   4 = Gravità 0.0 (nessuna gravità)
  31+ 5DAD                  IFNDEF DEFAULT_GRAVITY_PRESET
  32+ 5DAD              DEFAULT_GRAVITY_PRESET EQU 1
  33+ 5DAD                  ENDIF
  34+ 5DAD
  35+ 5DAD              ; --- Velocità Massima di Caduta ---
  36+ 5DAD              ; Limite massimo per la velocità di caduta verso il basso (in pixel/frame)
  37+ 5DAD                  IFNDEF MAX_FALL_SPEED
  38+ 5DAD              MAX_FALL_SPEED EQU 12
  39+ 5DAD                  ENDIF
  40+ 5DAD
  41+ 5DAD              ; --- Gravità Base ---
  42+ 5DAD                  IFNDEF GRAVITY
  43+ 5DAD              GRAVITY EQU 1
  44+ 5DAD                  ENDIF
  45+ 5DAD
  46+ 5DAD              ; --- Tolleranza Hitbox Collisioni Guardiani (Inset Margins) ---
  47+ 5DAD              ; Definisce il margine di rientro in pixel per escludere i bordi trasparenti degli sprite.
  48+ 5DAD              ;   0 = Hitbox rigida originale 8x16 vs 16x16
  49+ 5DAD              ;   1 = Tolleranza leggera (1px per lato)
  50+ 5DAD              ;   2 = Tolleranza consigliata (2px per lato, evita morte su bordi vuoti)
  51+ 5DAD                  IFNDEF COLLISION_INSET_X
  52+ 5DAD              COLLISION_INSET_X EQU 2
  53+ 5DAD                  ENDIF
  54+ 5DAD
  55+ 5DAD                  IFNDEF COLLISION_INSET_Y
  56+ 5DAD              COLLISION_INSET_Y EQU 2
  57+ 5DAD                  ENDIF
  58+ 5DAD
  59+ 5DAD              COLLISION_OFFSET_X:    EQU (7 - (2 * COLLISION_INSET_X))
  60+ 5DAD              COLLISION_THRESHOLD_X: EQU (23 - (4 * COLLISION_INSET_X))
  61+ 5DAD
  62+ 5DAD              COLLISION_OFFSET_Y:    EQU (15 - (2 * COLLISION_INSET_Y))
  63+ 5DAD              COLLISION_THRESHOLD_Y: EQU (31 - (4 * COLLISION_INSET_Y))
  64+ 5DAD
  65+ 5DAD              ; --- Tempo di Sicurezza (Invulnerabilità) al Respawn dopo la Morte --
  66+ 5DAD              ; Numero di frame (50Hz) di invulnerabilità ai guardiani dopo il respawn di Willy.
  67+ 5DAD              ;   0  = Disabilitato (nessuna sicurezza)
  68+ 5DAD              ;  50  = 1 secondo di invulnerabilità (default consigliato)
  69+ 5DAD              ;  75  = 1.5 secondi
  70+ 5DAD              ; 100  = 2 secondi
  71+ 5DAD                  IFNDEF RESPAWN_SAFETY_TIME
  72+ 5DAD              RESPAWN_SAFETY_TIME EQU 0
  73+ 5DAD                  ENDIF
  74+ 5DAD
  75+ 5DAD              ; --- Coyote Time (Tempo Coyote per Salto da Bordo) ---
  76+ 5DAD              ; Numero di frame nei quali Willy può ancora saltare dopo essere scivolato oltre il bordo di una piattaforma.
  77+ 5DAD                  IFNDEF COYOTE_TIME_FRAMES
  78+ 5DAD              COYOTE_TIME_FRAMES EQU 4
  79+ 5DAD                  ENDIF
  80+ 5DAD
  81+ 5DAD              ; --- Buffer Pre-Salto (Jump Buffer) ---
  82+ 5DAD              ; Numero di frame nei quali l'input del salto (tasto Z) viene conservato
  83+ 5DAD              ; se premuto poco prima di toccare terra (evita il tasto "sordo").
  84+ 5DAD                  IFNDEF JUMP_BUFFER_FRAMES
  85+ 5DAD              JUMP_BUFFER_FRAMES EQU 5
  86+ 5DAD                  ENDIF
  87+ 5DAD
  88+ 5DAD
  89+ 5DAD

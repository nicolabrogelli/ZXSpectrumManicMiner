 381  88A3 28 ED            jr   z, .wait_keys_release
 382  88A5
 383  88A5                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 384  88A5 01 FE BF         ld   bc, $bffe
 385  88A8 ED 78            in   a, (c)
 386  88AA CB 47            bit  0, a
 387  88AC 28 E4            jr   z, .wait_keys_release

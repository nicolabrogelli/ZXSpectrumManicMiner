 442+ 7027
 443+ 7027 7E               ld   a, (hl)                   ; Byte 0: Y * 2
 444+ 7028 CB 3F            srl  a
 445+ 702A F5               push af                        ; Salva PlayerY sullo stack
 446+ 702B
 447+ 702B 23               inc  hl                        ; Byte 1
 448+ 702C 23               inc  hl                        ; Byte 2
 449+ 702D 23               inc  hl                        ; Byte 3
 450+ 702E 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 451+ 702F 4E               ld   c, (hl)
 452+ 7030 23               inc  hl                        ; Byte 5 (AttrAddr High)
 453+ 7031 7E               ld   a, (hl)
 454+ 7032
 455+ 7032 67               ld   h, a
 456+ 7033 69               ld   l, c
 457+ 7034 01 00 A4         ld   bc, -23552
 458+ 7037 09               add  hl, bc
 459+ 7038 7D               ld   a, l
 460+ 7039 E6 1F            and  31
 461+ 703B 87               add  a, a
 462+ 703C 87               add  a, a
 463+ 703D 87               add  a, a                      ; Col * 8 = Pixel X
 464+ 703E 4F               ld   c, a                      ; C = PlayerX
 465+ 703F F1               pop  af                        ; A = PlayerY
 466+ 7040 47               ld   b, a                      ; B = PlayerY
 467+ 7041
 468+ 7041 E1               pop  hl                        ; Ripristina puntatore RoomsListTable
 469+ 7042 D1               pop  de                        ; DE = room_entry_positions + (i * 2)
 470+ 7043 79               ld   a, c
 471+ 7044 12               ld   (de), a                   ; X
 472+ 7045 13               inc  de
 473+ 7046 78               ld   a, b
 474+ 7047 12               ld   (de), a                   ; Y
 475+ 7048 13               inc  de
 476+ 7049
 477+ 7049 C1               pop  bc
 478+ 704A 10 D0            djnz .loop
 479+ 704C C9               ret

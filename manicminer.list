 510  8649 ~                ld   (Audio_music_frame_counter), a
 511  8649                  ENDIF
 512  8649
 513  8649                  ; - Riposiziona Willy nel punto di default definito nella stanza
 514  8649 AF               xor  a
 515  864A 32 F0 AD         ld   (transition_active), a

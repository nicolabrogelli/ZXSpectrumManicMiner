 844+ 7735              ; -------------------------------------------------------------------
 845+ 7735              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 846+ 7735              ; o sulla piattaforma adiacente in cima.
 847+ 7735              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 848+ 7735              ; -------------------------------------------------------------------
 849+ 7735              IsCellOnRamp:
 850+ 7735 C5               push bc
 851+ 7736 E5               push hl
 852+ 7737
 853+ 7737 3A F8 B5         ld   a, (ramp_len)
 854+ 773A B7               or   a
 855+ 773B 28 6B            jr   z, .no
 856+ 773D
 857+ 773D                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 858+ 773D 3A F7 B5         ld   a, (ramp_dir)
 859+ 7740 B7               or   a
 860+ 7741 28 1A            jr   z, .range_left
 861+ 7743              .range_right:
 862+ 7743 3A FA B5         ld   a, (ramp_col)
 863+ 7746 47               ld   b, a              ; B = ramp_col
 864+ 7747 3A F8 B5         ld   a, (ramp_len)
 865+ 774A 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 774B 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 774C
 868+ 774C 7B               ld   a, e              ; A = Col
 869+ 774D B8               cp   b
 870+ 774E 38 34            jr   c, .check_platform_case ; Col < ramp_col
 871+ 7750 B9               cp   c
 872+ 7751 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 873+ 7753
 874+ 7753                  ; Calcola B = Col - ramp_col
 875+ 7753 7B               ld   a, e
 876+ 7754 90               sub  b
 877+ 7755 47               ld   b, a              ; B = offset (0..ramp_len-1)
 878+ 7756
 879+ 7756                  ; SlopeRow = ramp_row - B
 880+ 7756 3A F9 B5         ld   a, (ramp_row)
 881+ 7759 90               sub  b
 882+ 775A 47               ld   b, a              ; B = SlopeRow
 883+ 775B 18 1F            jr   .check_row_match
 884+ 775D
 885+ 775D              .range_left:
 886+ 775D                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 887+ 775D 21 F8 B5         ld   hl, ramp_len
 888+ 7760 3A FA B5         ld   a, (ramp_col)
 889+ 7763 96               sub  (hl)
 890+ 7764 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 891+ 7765 47               ld   b, a              ; B = limit_left
 892+ 7766
 893+ 7766 3A FA B5         ld   a, (ramp_col)
 894+ 7769 3C               inc  a
 895+ 776A 4F               ld   c, a              ; C = limit_right (exclusive)
 896+ 776B
 897+ 776B 7B               ld   a, e              ; A = Col
 898+ 776C B8               cp   b
 899+ 776D 38 15            jr   c, .check_platform_case
 900+ 776F B9               cp   c
 901+ 7770 30 12            jr   nc, .check_platform_case
 902+ 7772
 903+ 7772                  ; Calcola B = ramp_col - Col
 904+ 7772 3A FA B5         ld   a, (ramp_col)
 905+ 7775 93               sub  e
 906+ 7776 47               ld   b, a              ; B = offset
 907+ 7777
 908+ 7777                  ; SlopeRow = ramp_row - B
 909+ 7777 3A F9 B5         ld   a, (ramp_row)
 910+ 777A 90               sub  b
 911+ 777B 47               ld   b, a              ; B = SlopeRow
 912+ 777C
 913+ 777C              .check_row_match:
 914+ 777C                  ; D (Row) deve essere uguale a SlopeRow (in B) o SlopeRow + 1 (immediatamente sotto)
 915+ 777C 7A               ld   a, d              ; A = Row
 916+ 777D B8               cp   b
 917+ 777E 28 2C            jr   z, .yes           ; Row == SlopeRow
 918+ 7780 04               inc  b                 ; B = SlopeRow + 1
 919+ 7781 B8               cp   b
 920+ 7782 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 921+ 7784
 922+ 7784              .check_platform_case:
 923+ 7784                  ; 2. Controlla se è sulla piattaforma adiacente in cima
 924+ 7784 3A F7 B5         ld   a, (ramp_dir)
 925+ 7787 B7               or   a
 926+ 7788 28 09            jr   z, .plat_left
 927+ 778A              .plat_right:
 928+ 778A 3A FA B5         ld   a, (ramp_col)
 929+ 778D 21 F8 B5         ld   hl, ramp_len
 930+ 7790 86               add  a, (hl)           ; A = ramp_col + ramp_len
 931+ 7791 18 07            jr   .compare_plat
 932+ 7793              .plat_left:
 933+ 7793 3A FA B5         ld   a, (ramp_col)

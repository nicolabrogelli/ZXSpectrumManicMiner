 517+ 7F4B              ; -------------------------------------------------------------------
 518+ 7F4B              ; CheckCollision
 519+ 7F4B              ;
 520+ 7F4B              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 521+ 7F4B              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 522+ 7F4B              ; Output:
 523+ 7F4B              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 524+ 7F4B              ;   Carry Clear = Nessuna collisione
 525+ 7F4B              ; -------------------------------------------------------------------
 526+ 7F4B              CheckCollision:
 527+ 7F4B DD E5            push ix
 528+ 7F4D C5               push bc
 529+ 7F4E D5               push de
 530+ 7F4F E5               push hl
 531+ 7F50
 532+ 7F50                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 533+ 7F50 3A 74 AE         ld   a, (willy_safety_timer)
 534+ 7F53 B7               or   a
 535+ 7F54 C2 90 80         jp   nz, .no_collision_found
 536+ 7F57
 537+ 7F57                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 538+ 7F57 3A 70 AA         ld   a, (direction)
 539+ 7F5A FE 01            cp   1                         ; Sinistra?
 540+ 7F5C 20 1A            jr   nz, .willy_right
 541+ 7F5E
 542+ 7F5E                  ; Willy a Sinistra:
 543+ 7F5E 21 49 A4         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 544+ 7F61 22 8A B0         ld   (willy_head_ptr), hl
 545+ 7F64 3A 6F AA         ld   a, (body_state)           ; 0, 1, 2
 546+ 7F67 C6 05            add  a, 5                      ; tile 5, 6, 7
 547+ 7F69 87               add  a, a
 547+ 7F6A 87             add a, a
 547+ 7F6B 87             add a, a ; * 8
 548+ 7F6C 5F               ld   e, a
 549+ 7F6D 16 00            ld   d, 0
 550+ 7F6F 21 29 A4         ld   hl, Willy
 551+ 7F72 19               add  hl, de
 552+ 7F73 22 8C B0         ld   (willy_body_ptr), hl      ; Corpo sinistro
 553+ 7F76 18 18            jr   .willy_ptrs_ready
 554+ 7F78
 555+ 7F78              .willy_right:
 556+ 7F78                  ; Willy a Destra:
 557+ 7F78 21 29 A4         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 558+ 7F7B 22 8A B0         ld   (willy_head_ptr), hl
 559+ 7F7E 3A 6F AA         ld   a, (body_state)           ; 0, 1, 2
 560+ 7F81 C6 01            add  a, 1                      ; tile 1, 2, 3
 561+ 7F83 87               add  a, a
 561+ 7F84 87             add a, a
 561+ 7F85 87             add a, a ; * 8
 562+ 7F86 5F               ld   e, a
 563+ 7F87 16 00            ld   d, 0
 564+ 7F89 21 29 A4         ld   hl, Willy
 565+ 7F8C 19               add  hl, de
 566+ 7F8D 22 8C B0         ld   (willy_body_ptr), hl      ; Corpo destro
 567+ 7F90
 568+ 7F90              .willy_ptrs_ready:
 569+ 7F90 DD 21 43 7C      ld   ix, ActiveEnemies
 570+ 7F94 06 08            ld   b, 8                      ; 8 slot
 571+ 7F96
 572+ 7F96              .enemy_loop:
 573+ 7F96 DD 7E 00         ld   a, (ix+0)
 574+ 7F99 E6 80            and  $80                       ; Active?
 575+ 7F9B CA 87 80         jp   z, .next_enemy
 576+ 7F9E
 577+ 7F9E                  ; ---------------------------------------------------------------
 578+ 7F9E                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 579+ 7F9E                  ; ---------------------------------------------------------------
 580+ 7F9E                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 581+ 7F9E 3A 69 AA         ld   a, (PlayerPos)            ; WillyX
 582+ 7FA1 DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 583+ 7FA4 FE 10            cp   16
 584+ 7FA6 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 585+ 7FA8 FE F9            cp   249                       ; 249..255 = -7..-1
 586+ 7FAA DA 87 80         jp   c, .next_enemy            ; 16..248 -> fuori range
 587+ 7FAD              .x_in_range:
 588+ 7FAD 32 90 B0         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 589+ 7FB0
 590+ 7FB0                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 591+ 7FB0 3A 6A AA         ld   a, (PlayerPos+1)          ; WillyY
 592+ 7FB3 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 593+ 7FB6 FE 10            cp   16
 594+ 7FB8 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 595+ 7FBA FE F1            cp   241                       ; 241..255 = -15..-1
 596+ 7FBC DA 87 80         jp   c, .next_enemy            ; 16..240 -> fuori range
 597+ 7FBF              .y_in_range:
 598+ 7FBF 32 91 B0         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 599+ 7FC2
 600+ 7FC2                  ; ---------------------------------------------------------------
 601+ 7FC2                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 602+ 7FC2                  ; ---------------------------------------------------------------
 603+ 7FC2 C5               push bc                        ; Salva contatore nemici (B)
 604+ 7FC3
 605+ 7FC3 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 606+ 7FC6 E6 03            and  3
 607+ 7FC8 4F               ld   c, a
 608+ 7FC9
 609+ 7FC9 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 610+ 7FCC FE 01            cp   1
 611+ 7FCE 28 03            jr   z, .guard_left_frame
 612+ 7FD0                  ; Frame Destra: Frame = Subframe (0..3)
 613+ 7FD0 79               ld   a, c
 614+ 7FD1 18 03            jr   .calc_guard_ptr
 615+ 7FD3              .guard_left_frame:
 616+ 7FD3                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 617+ 7FD3 3E 04            ld   a, 4
 618+ 7FD5 81               add  a, c
 619+ 7FD6
 620+ 7FD6              .calc_guard_ptr:
 621+ 7FD6                  ; Offset = Frame * 32
 622+ 7FD6 6F               ld   l, a
 623+ 7FD7 26 00            ld   h, 0
 624+ 7FD9 29               add  hl, hl                    ; *2
 625+ 7FDA 29               add  hl, hl                    ; *4
 626+ 7FDB 29               add  hl, hl                    ; *8
 627+ 7FDC 29               add  hl, hl                    ; *16
 628+ 7FDD 29               add  hl, hl                    ; *32
 629+ 7FDE 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 630+ 7FE1 19               add  hl, de
 631+ 7FE2 ED 5B EA AD      ld   de, (room_ptr)
 632+ 7FE6 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 633+ 7FE7 22 8E B0         ld   (guard_sprite_ptr), hl
 634+ 7FEA
 635+ 7FEA                  ; ---------------------------------------------------------------
 636+ 7FEA                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 637+ 7FEA                  ; ---------------------------------------------------------------
 638+ 7FEA 3A 91 B0         ld   a, (collision_delta_y)
 639+ 7FED CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 640+ 7FEF 20 12            jr   nz, .willy_higher
 641+ 7FF1
 642+ 7FF1                  ; Willy lower or equal (DeltaY >= 0):
 643+ 7FF1                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 644+ 7FF1 32 92 B0         ld   (row_enemy_cur), a
 645+ 7FF4 AF               xor  a
 646+ 7FF5 32 93 B0         ld   (row_willy_cur), a
 647+ 7FF8 3E 10            ld   a, 16
 648+ 7FFA 21 91 B0         ld   hl, collision_delta_y
 649+ 7FFD 96               sub  (hl)
 650+ 7FFE 32 94 B0         ld   (overlap_num_lines), a
 651+ 8001 18 12            jr   .check_lines_loop
 652+ 8003
 653+ 8003              .willy_higher:
 654+ 8003                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 655+ 8003 ED 44            neg                            ; A = -DeltaY (1..15)
 656+ 8005 32 93 B0         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 657+ 8008 AF               xor  a
 658+ 8009 32 92 B0         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 659+ 800C 3E 10            ld   a, 16
 660+ 800E 21 93 B0         ld   hl, row_willy_cur
 661+ 8011 96               sub  (hl)
 662+ 8012 32 94 B0         ld   (overlap_num_lines), a
 663+ 8015
 664+ 8015              .check_lines_loop:
 665+ 8015                  ; ---------------------------------------------------------------
 666+ 8015                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 667+ 8015                  ; ---------------------------------------------------------------
 668+ 8015 3A 94 B0         ld   a, (overlap_num_lines)
 669+ 8018 47               ld   b, a                      ; B = numero di scanlines da controllare
 670+ 8019
 671+ 8019              .scanline_loop:
 672+ 8019 C5               push bc                        ; Salva contatore scanlines
 673+ 801A
 674+ 801A                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 675+ 801A 3A 92 B0         ld   a, (row_enemy_cur)
 676+ 801D 87               add  a, a                      ; row * 2
 677+ 801E 5F               ld   e, a
 678+ 801F 16 00            ld   d, 0
 679+ 8021 2A 8E B0         ld   hl, (guard_sprite_ptr)
 680+ 8024 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 681+ 8025 56               ld   d, (hl)                   ; D = Enemy Byte 0
 682+ 8026 23               inc  hl
 683+ 8027 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 684+ 8028
 685+ 8028                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 686+ 8028 3A 90 B0         ld   a, (collision_delta_x)
 687+ 802B CB 7F            bit  7, a
 688+ 802D 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 689+ 802F
 690+ 802F                  ; DeltaX >= 0:
 691+ 802F FE 09            cp   9
 692+ 8031 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 693+ 8033
 694+ 8033                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 695+ 8033 B7               or   a
 696+ 8034 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 697+ 8036 4F               ld   c, a                      ; C = DeltaX (1..8)
 698+ 8037              .shift_left_16bit:
 699+ 8037 CB 23            sla  e
 700+ 8039 CB 12            rl   d
 701+ 803B 0D               dec  c
 702+ 803C 20 F9            jr   nz, .shift_left_16bit
 703+ 803E              .slice_ready_in_d:
 704+ 803E 7A               ld   a, d                      ; A = fetta guardiano allineata
 705+ 803F 18 14            jr   .test_willy_line
 706+ 8041
 707+ 8041              .shift_dx_gt_8:
 708+ 8041                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 709+ 8041 D6 08            sub  8
 710+ 8043 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 711+ 8044              .shift_left_e_only:
 712+ 8044 CB 23            sla  e
 713+ 8046 0D               dec  c
 714+ 8047 20 FB            jr   nz, .shift_left_e_only
 715+ 8049 7B               ld   a, e                      ; A = fetta guardiano allineata
 716+ 804A 18 09            jr   .test_willy_line
 717+ 804C
 718+ 804C              .shift_neg_dx:
 719+ 804C                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 720+ 804C ED 44            neg
 721+ 804E 4F               ld   c, a                      ; C = -DeltaX (1..7)
 722+ 804F              .shift_right_d_only:
 723+ 804F CB 3A            srl  d
 724+ 8051 0D               dec  c
 725+ 8052 20 FB            jr   nz, .shift_right_d_only
 726+ 8054 7A               ld   a, d                      ; A = fetta guardiano allineata
 727+ 8055
 728+ 8055              .test_willy_line:
 729+ 8055                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 730+ 8055 B7               or   a
 731+ 8056 28 21            jr   z, .next_scanline
 732+ 8058
 733+ 8058                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 734+ 8058 4F               ld   c, a                      ; C = fetta guardiano
 735+ 8059 3A 93 B0         ld   a, (row_willy_cur)
 736+ 805C FE 08            cp   8
 737+ 805E 38 0D            jr   c, .read_willy_head
 738+ 8060
 739+ 8060                  ; Riga corpo (8..15)
 740+ 8060 D6 08            sub  8
 741+ 8062 6F               ld   l, a
 742+ 8063 26 00            ld   h, 0
 743+ 8065 ED 5B 8C B0      ld   de, (willy_body_ptr)
 744+ 8069 19               add  hl, de
 745+ 806A 7E               ld   a, (hl)                   ; A = byte corpo Willy
 746+ 806B 18 09            jr   .do_pixel_and
 747+ 806D
 748+ 806D              .read_willy_head:
 749+ 806D                  ; Riga testa (0..7)
 750+ 806D 6F               ld   l, a
 751+ 806E 26 00            ld   h, 0
 752+ 8070 ED 5B 8A B0      ld   de, (willy_head_ptr)
 753+ 8074 19               add  hl, de
 754+ 8075 7E               ld   a, (hl)                   ; A = byte testa Willy
 755+ 8076
 756+ 8076              .do_pixel_and:
 757+ 8076                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 758+ 8076 A1               and  c
 759+ 8077 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 760+ 8079
 761+ 8079              .next_scanline:
 762+ 8079                  ; Avanza alla prossima riga
 763+ 8079 21 92 B0         ld   hl, row_enemy_cur
 764+ 807C 34               inc  (hl)
 765+ 807D 21 93 B0         ld   hl, row_willy_cur
 766+ 8080 34               inc  (hl)
 767+ 8081
 768+ 8081 C1               pop  bc                        ; Ripristina B (contatore scanlines)
 769+ 8082 05               dec  b
 770+ 8083 C2 19 80         jp   nz, .scanline_loop
 771+ 8086
 772+ 8086                  ; Nessun pixel sovrapposto per questo guardiano
 773+ 8086 C1               pop  bc                        ; Ripristina B (contatore nemici)
 774+ 8087
 775+ 8087              .next_enemy:
 776+ 8087 11 0B 00         ld   de, 11
 777+ 808A DD 19            add  ix, de
 778+ 808C 05               dec  b
 779+ 808D C2 96 7F         jp   nz, .enemy_loop
 780+ 8090
 781+ 8090              .no_collision_found:
 782+ 8090 E1               pop  hl
 783+ 8091 D1               pop  de
 784+ 8092 C1               pop  bc
 785+ 8093 DD E1            pop  ix
 786+ 8095 B7               or   a                         ; Carry = 0 (Nessuna collisione)
 787+ 8096 C9               ret
 788+ 8097
 789+ 8097              .pixel_collision_detected:
 790+ 8097 C1               pop  bc                        ; Pulisci stack scanline
 791+ 8098 C1               pop  bc                        ; Pulisci stack nemici
 792+ 8099 E1               pop  hl
 793+ 809A D1               pop  de
 794+ 809B C1               pop  bc
 795+ 809C DD E1            pop  ix
 796+ 809E 37               scf                            ; Carry = 1 (COLLISIONE CONFERMATA!)
 797+ 809F C9               ret

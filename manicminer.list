  88+ F0F1              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ F0F1 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ F0F4 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ F0F7 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ F0F8 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ F0F9 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ F0FA 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F0FB 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F0FC 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ F0FD 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  98+ F0FE
  99+ F0FE 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)

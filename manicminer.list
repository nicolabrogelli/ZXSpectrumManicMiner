 857+ 6160 92               sub  d
 858+ 6161 FE 02            cp   2
 859+ 6163 38 0D            jr   c, .not_empty         ; Se DeltaRow < 2 E DeltaCol < 2 -> È nel portale!
 860+ 6165
 861+ 6165              .check_layout_tile:
 862+ 6165                  ; 4. Controlla il tipo di tile in unpacked_layout
 863+ 6165 7C               ld   a, h                  ; A = Row
 864+ 6166 48               ld   c, b                  ; C = Col
 865+ 6167 CD EF 77         call GetCellFromUnpacked   ; A = tile index (0..7)

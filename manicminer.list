 169  89E0
 170  89E0                  ; Controlla collisione con Nasties (morte di Willy)
 171  89E0                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 172  89E0 CD A9 7C         call Phys_CheckNastyCollision
 173  89E3 38 0B            jr   c, .willy_dies
 174  89E5                  ENDIF
 175  89E5
 176  89E5                  ; Controlla collisione con guardiani

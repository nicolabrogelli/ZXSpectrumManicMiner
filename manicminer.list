 271+ 6FA6              ; LoadPositionPlayeinRoom
 272+ 6FA6              ;
 273+ 6FA6              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6FA6              ; in una nuova stanza.
 275+ 6FA6              ;
 276+ 6FA6              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6FA6              ; (layout/metadata) a partire da room_ptr.
 278+ 6FA6              ;
 279+ 6FA6              ; Output:
 280+ 6FA6              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6FA6              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6FA6              ;
 283+ 6FA6              ; Struttura dati stanza:
 284+ 6FA6              ;   OFFSET_POS_WILLY:
 285+ 6FA6              ;       +0 = X
 286+ 6FA6              ;       +1 = Y
 287+ 6FA6              ; -------------------------------------------------------------------
 288+ 6FA6              LoadPositionPlayeinRoom:
 289+ 6FA6                  ; ---------------------------------------------------------------
 290+ 6FA6                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6FA6                  ; ---------------------------------------------------------------
 292+ 6FA6 2A 80 99         ld   hl, (room_ptr)
 293+ 6FA9 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6FAC 19               add  hl, de
 295+ 6FAD
 296+ 6FAD                  ; Byte 0: Y * 2
 297+ 6FAD 7E               ld   a, (hl)
 298+ 6FAE CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6FB0 57               ld   d, a                      ; D = PlayerY
 300+ 6FB1
 301+ 6FB1                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6FB1 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6FB2 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6FB3 7E               ld   a, (hl)
 305+ 6FB4 E6 01            and  1
 306+ 6FB6 28 04            jr   z, .facing_right
 307+ 6FB8 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6FBA 18 02            jr   .set_dir
 309+ 6FBC              .facing_right:
 310+ 6FBC 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6FBE              .set_dir:
 312+ 6FBE 32 07 96         ld   (direction), a
 313+ 6FC1
 314+ 6FC1                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6FC1 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6FC2 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6FC3 4E               ld   c, (hl)
 318+ 6FC4 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6FC5 7E               ld   a, (hl)
 320+ 6FC6
 321+ 6FC6                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6FC6 67               ld   h, a
 323+ 6FC7 69               ld   l, c
 324+ 6FC8 01 00 A4         ld   bc, -23552
 325+ 6FCB 09               add  hl, bc
 326+ 6FCC
 327+ 6FCC 7D               ld   a, l
 328+ 6FCD E6 1F            and  31
 329+ 6FCF 87               add  a, a                      ; *2
 330+ 6FD0 87               add  a, a                      ; *4
 331+ 6FD1 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6FD2 4F               ld   c, a                      ; C = PlayerX
 333+ 6FD3 42               ld   b, d                      ; B = PlayerY
 334+ 6FD4
 335+ 6FD4                  ; Salva coordinate (C = X, B = Y)
 336+ 6FD4 ED 43 00 96      ld   (PlayerPos), bc
 337+ 6FD8 ED 43 02 96      ld   (PlayerPosOld), bc
 338+ 6FDC C9               ret

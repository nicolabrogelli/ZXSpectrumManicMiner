 468  8959
 469  8959                  ; - Reimposta la fisica e le variabili di stato di Willy
 470  8959 AF               xor  a
 471  895A 32 15 E2         ld   (velocity_y), a
 472  895D 32 17 E2         ld   (jump_pressed), a
 473  8960 32 19 E2         ld   (coyote_timer), a
 474  8963 32 1C E2         ld   (jump_frame), a
 475  8966 32 1B E2         ld   (jump_dir), a
 476  8969 32 0D E2         ld   (body_state), a
 477  896C 32 20 E2         ld   (w_warp_state), a
 478  896F 32 23 E2         ld   (w_key_prev), a
 479  8972 32 24 E2         ld   (enter_key_prev), a
 480  8975 32 10 E2         ld   (collision_active), a
 481  8978 32 0F E2         ld   (flags), a
 482  897B 32 09 E6         ld   (ramp_entry_guard), a
 483  897E 32 15 E6         ld   (willy_on_ramp), a
 484  8981 32 14 E6         ld   (willy_needs_redraw), a
 485  8984 3E FF            ld   a, $ff
 486  8986 32 25 E2         ld   (digit_key_prev), a
 487  8989 32 0E E6         ld   (player_drawn_pos+1), a
 488  898C 32 0F E6         ld   (player_old_dir), a
 489  898F 32 10 E6         ld   (player_old_body), a
 490  8992 3E 01            ld   a, 1
 491  8994 32 1E E2         ld   (q_prev), a
 492  8997 32 1F E2         ld   (a_prev), a
 493  899A 32 16 E2         ld   (on_ground), a
 494  899D 32 11 E6         ld   (enemy_was_updated), a
 495  89A0
 496  89A0                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 497  89A0 3E 00            ld   a, RESPAWN_SAFETY_TIME
 498  89A2 32 13 E6         ld   (willy_safety_timer), a
 499  89A5
 500  89A5                  ; - Ripristina lo stato audio
 501  89A5 3E 12            ld   a, 18
 502  89A7 32 26 E8         ld   (Audio_jump_sound_note), a
 503  89AA AF               xor  a
 504  89AB 32 27 E8         ld   (Audio_jump_sound_timer), a
 505  89AE                  IF ENABLE_MUSIC != 0
 506  89AE ~                ld   (Audio_music_note_idx), a
 507  89AE ~                ld   a, 1
 508  89AE ~                ld   (Audio_music_frame_counter), a
 509  89AE                  ENDIF
 510  89AE
 511  89AE                  ; - Riposiziona Willy nel punto di default definito nella stanza
 512  89AE AF               xor  a
 513  89AF 32 8E E5         ld   (transition_active), a
 514  89B2
 515  89B2                  ; - Cancella lo schermo a nero prima del caricamento
 516  89B2 AF               xor  a
 517  89B3 D3 FE            out  ($fe), a
 518  89B5 CD 9D 62         call Gfx_ClearScreenDirect
 519  89B8
 520  89B8                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 521  89B8 C3 56 87         jp   LoadRoomAndRestart
 522  89BB
 523  89BB              ; -------------------------------------------------------------------
 524  89BB              ; TriggerVictory
 525  89BB              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 526  89BB              ; - Pulisce gli elementi di gioco della stanza.
 527  89BB              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 528  89BB              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 529  89BB              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 530  89BB              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 531  89BB              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 532  89BB              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 533  89BB              ; -------------------------------------------------------------------
 534  89BB              TriggerVictory:
 535  89BB                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 536  89BB CD F7 66         call Gfx_DrawVictoryScreen
 537  89BE
 538  89BE                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 539  89BE              .wait_keys_release:
 540  89BE 76               halt
 541  89BF                  ; Controlla tasto Y (Porta $DF, bit 4)
 542  89BF 01 FE DF         ld   bc, $dffe
 543  89C2 ED 78            in   a, (c)
 544  89C4 CB 67            bit  4, a
 545  89C6 28 F6            jr   z, .wait_keys_release
 546  89C8
 547  89C8                  ; Controlla tasto N (Porta $7F, bit 3)
 548  89C8 01 FE 7F         ld   bc, $7ffe
 549  89CB ED 78            in   a, (c)
 550  89CD CB 5F            bit  3, a
 551  89CF 28 ED            jr   z, .wait_keys_release
 552  89D1
 553  89D1                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 554  89D1 01 FE BF         ld   bc, $bffe
 555  89D4 ED 78            in   a, (c)
 556  89D6 CB 47            bit  0, a
 557  89D8 28 E4            jr   z, .wait_keys_release
 558  89DA
 559  89DA                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 560  89DA 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 561  89DC              .wait_choice_loop:
 562  89DC 76               halt
 563  89DD
 564  89DD                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 565  89DD 0C               inc  c
 566  89DE 79               ld   a, c
 567  89DF CB 3F            srl  a
 568  89E1 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 569  89E3 E6 07            and  7
 570  89E5 5F               ld   e, a
 571  89E6 16 00            ld   d, 0
 572  89E8 21 11 66         ld   hl, victory_color_table
 573  89EB 19               add  hl, de
 574  89EC 7E               ld   a, (hl)               ; A = nuovo colore attributo
 575  89ED 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 576  89F0 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 577  89F2              .color_cycle_loop:
 578  89F2 77               ld   (hl), a
 579  89F3 23               inc  hl
 580  89F4 10 FC            djnz .color_cycle_loop
 581  89F6
 582  89F6                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 583  89F6 01 FE DF         ld   bc, $dffe
 584  89F9 ED 78            in   a, (c)
 585  89FB CB 67            bit  4, a
 586  89FD 28 2A            jr   z, .play_again_chosen
 587  89FF
 588  89FF                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 589  89FF 01 FE 7F         ld   bc, $7ffe
 590  8A02 ED 78            in   a, (c)
 591  8A04 CB 5F            bit  3, a
 592  8A06 28 0B            jr   z, .quit_chosen
 593  8A08
 594  8A08                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 595  8A08 01 FE BF         ld   bc, $bffe
 596  8A0B ED 78            in   a, (c)
 597  8A0D CB 47            bit  0, a
 598  8A0F 28 02            jr   z, .quit_chosen
 599  8A11
 600  8A11 18 C9            jr   .wait_choice_loop
 601  8A13
 602  8A13              .quit_chosen:
 603  8A13                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 604  8A13              .wait_quit_release:
 605  8A13 76               halt
 606  8A14 01 FE 7F         ld   bc, $7ffe
 607  8A17 ED 78            in   a, (c)
 608  8A19 CB 5F            bit  3, a
 609  8A1B 28 F6            jr   z, .wait_quit_release
 610  8A1D 01 FE BF         ld   bc, $bffe
 611  8A20 ED 78            in   a, (c)
 612  8A22 CB 47            bit  0, a
 613  8A24 28 ED            jr   z, .wait_quit_release
 614  8A26
 615  8A26                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 616  8A26 C3 8F 88         jp   ShowTitleScreen
 617  8A29
 618  8A29              .play_again_chosen:
 619  8A29                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 620  8A29              .wait_play_again_release:
 621  8A29 76               halt
 622  8A2A 01 FE DF         ld   bc, $dffe
 623  8A2D ED 78            in   a, (c)
 624  8A2F CB 67            bit  4, a
 625  8A31 28 F6            jr   z, .wait_play_again_release
 626  8A33
 627  8A33                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 628  8A33 CD 6D 8B         call ResetFullGameState
 629  8A36 C3 56 87         jp   LoadRoomAndRestart
 630  8A39
 631  8A39              ; -------------------------------------------------------------------
 632  8A39              ; CheckPortalTransition
 633  8A39              ; Verifica le condizioni per accedere alla stanza successiva:
 634  8A39              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 635  8A39              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 636  8A39              ;
 637  8A39              ; Output:
 638  8A39              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 639  8A39              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 640  8A39              ; -------------------------------------------------------------------
 641  8A39              CheckPortalTransition:
 642  8A39 C5               push bc
 643  8A3A D5               push de
 644  8A3B E5               push hl
 645  8A3C
 646  8A3C                  ; 1. Tutti gli item della stanza sono stati raccolti?
 647  8A3C CD 00 8B         call CheckAllItemsCollected
 648  8A3F 30 4D            jr   nc, .no_transition
 649  8A41
 650  8A41                  ; 2. Willy collide con il portale (16x16 pixel)?
 651  8A41                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 652  8A41                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 653  8A41 2A 88 E5         ld   hl, (room_ptr)
 654  8A44 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 655  8A47 19               add  hl, de
 656  8A48 4E               ld   c, (hl)
 657  8A49 23               inc  hl
 658  8A4A 46               ld   b, (hl)                   ; BC = AttrAddr
 659  8A4B
 660  8A4B                  ; Offset = BC - 23552
 661  8A4B 60               ld   h, b
 662  8A4C 69               ld   l, c
 663  8A4D 01 00 A4         ld   bc, -23552
 664  8A50 09               add  hl, bc
 665  8A51
 666  8A51                  ; PortalX = (Offset & 31) * 8
 667  8A51 7D               ld   a, l
 668  8A52 E6 1F            and  31
 669  8A54 87               add  a, a
 669  8A55 87             add a, a
 669  8A56 87             add a, a
 670  8A57 5F               ld   e, a                      ; E = PortalX (0..248)
 671  8A58
 672  8A58                  ; PortalY = (Offset / 32) * 8
 673  8A58 CB 3C            srl  h
 673  8A5A CB 1D          rr l
 674  8A5C CB 3C            srl  h
 674  8A5E CB 1D          rr l
 675  8A60 CB 3C            srl  h
 675  8A62 CB 1D          rr l
 676  8A64 CB 3C            srl  h
 676  8A66 CB 1D          rr l
 677  8A68 CB 3C            srl  h
 677  8A6A CB 1D          rr l
 678  8A6C 7D               ld   a, l
 679  8A6D 87               add  a, a
 679  8A6E 87             add a, a
 679  8A6F 87             add a, a
 680  8A70 57               ld   d, a                      ; D = PortalY (0..120)
 681  8A71
 682  8A71                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 683  8A71 ED 4B 07 E2      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 684  8A75
 685  8A75                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 686  8A75 7B               ld   a, e
 687  8A76 91               sub  c
 688  8A77 30 02            jr   nc, .x_diff_pos
 689  8A79 ED 44            neg
 690  8A7B              .x_diff_pos:
 691  8A7B FE 0C            cp   12
 692  8A7D 30 0F            jr   nc, .no_transition
 693  8A7F
 694  8A7F                  ; Controllo verticale: |WillyY - PortalY| < 14
 695  8A7F 7A               ld   a, d
 696  8A80 90               sub  b
 697  8A81 30 02            jr   nc, .y_diff_pos
 698  8A83 ED 44            neg
 699  8A85              .y_diff_pos:
 700  8A85 FE 0E            cp   14
 701  8A87 30 05            jr   nc, .no_transition
 702  8A89
 703  8A89                  ; Transizione al portale attiva!
 704  8A89 E1               pop  hl
 705  8A8A D1               pop  de
 706  8A8B C1               pop  bc
 707  8A8C 37               scf
 708  8A8D C9               ret
 709  8A8E
 710  8A8E              .no_transition:
 711  8A8E E1               pop  hl
 712  8A8F D1               pop  de
 713  8A90 C1               pop  bc
 714  8A91 B7               or   a
 715  8A92 C9               ret
 716  8A93
 717  8A93              ; Alias per retrocompatibilità
 718  8A93              CheckVictoryCondition: EQU CheckPortalTransition
 719  8A93
 720  8A93              ; -------------------------------------------------------------------
 721  8A93              ; TriggerPortalTransition
 722  8A93              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 723  8A93              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 724  8A93              ; - Avanza all'indice della stanza successiva.
 725  8A93              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 726  8A93              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 727  8A93              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 728  8A93              ; -------------------------------------------------------------------
 729  8A93              TriggerPortalTransition:
 730  8A93                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 731  8A93 CD CA 8A         call Air_DepleteCountdown
 732  8A96
 733  8A96                  ; 1. Determina l'ID della stanza corrente
 734  8A96 CD D2 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8A99
 736  8A99                  ; 2. Calcola l'indice della stanza successiva
 737  8A99 3A 2D E5         ld   a, (current_room)
 738  8A9C 3C               inc  a
 739  8A9D FE 14            cp   NUM_ROOMS
 740  8A9F 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8AA1
 742  8AA1                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8AA1 21 19 73         ld   hl, RoomsListTable
 744  8AA4 5F               ld   e, a
 745  8AA5 16 00            ld   d, 0
 746  8AA7 19               add  hl, de
 747  8AA8 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8AA9 5E               ld   e, (hl)
 749  8AAA 23               inc  hl
 750  8AAB 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8AAC ED 53 88 E5      ld   (room_ptr), de
 752  8AB0
 753  8AB0                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8AB0 AF               xor  a
 755  8AB1 32 8E E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8AB4 32 15 E2         ld   (velocity_y), a
 757  8AB7 32 20 E8         ld   (game_objective_completed), a
 758  8ABA 3E 01            ld   a, 1
 759  8ABC 32 16 E2         ld   (on_ground), a
 760  8ABF
 761  8ABF                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8ABF 3E 07            ld   a, $07
 763  8AC1 CD 9D 62         call Gfx_ClearScreenDirect
 764  8AC4
 765  8AC4 C3 56 87         jp   LoadRoomAndRestart
 766  8AC7
 767  8AC7              .all_rooms_completed:
 768  8AC7                  ; Tutte le stanze sono state completate con successo!
 769  8AC7                  IF ENABLE_VICTORY_SCREEN != 0
 770  8AC7 C3 BB 89         jp   TriggerVictory
 771  8ACA                  ELSE
 772  8ACA ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8ACA ~                ld   de, (RoomsListTable)
 774  8ACA ~                ld   (room_ptr), de
 775  8ACA ~                xor  a
 776  8ACA ~                ld   (transition_active), a
 777  8ACA ~                ld   (velocity_y), a
 778  8ACA ~                ld   (game_objective_completed), a
 779  8ACA ~                ld   a, 1
 780  8ACA ~                ld   (on_ground), a
 781  8ACA ~                ld   a, $07
 782  8ACA ~                call Gfx_ClearScreenDirect
 783  8ACA ~                jp   LoadRoomAndRestart
 784  8ACA                  ENDIF
 785  8ACA
 786  8ACA              ; -------------------------------------------------------------------
 787  8ACA              ; Air_DepleteCountdown
 788  8ACA              ; Animazione originale di completamento livello (Manic Miner):
 789  8ACA              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 790  8ACA              ; - Ad ogni pixel decrementato:
 791  8ACA              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 792  8ACA              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 793  8ACA              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 794  8ACA              ; -------------------------------------------------------------------
 795  8ACA              Air_DepleteCountdown:
 796  8ACA F5               push af
 797  8ACB C5               push bc
 798  8ACC D5               push de
 799  8ACD E5               push hl
 800  8ACE
 801  8ACE              .countdown_loop:
 802  8ACE 3A 28 E8         ld   a, (air_pixels)
 803  8AD1 B7               or   a
 804  8AD2 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 805  8AD4
 806  8AD4 3D               dec  a
 807  8AD5 32 28 E8         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 808  8AD8
 809  8AD8                  ; Aggiorna la barra grafica dell'aria
 810  8AD8 CD 27 6A         call Gfx_UpdateAirBar
 811  8ADB
 812  8ADB                  ; Aggiungi 1 punto allo score
 813  8ADB CD 46 86         call Score_Add1Point
 814  8ADE
 815  8ADE                  ; Genera l'effetto sonoro originale di Manic Miner:
 816  8ADE                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 817  8ADE 3A 28 E8         ld   a, (air_pixels)
 818  8AE1 2F               cpl
 819  8AE2 E6 3F            and  63
 820  8AE4 07               rlca
 821  8AE5 3C               inc  a
 822  8AE6 57               ld   d, a                      ; D = ritardo semionda audio
 823  8AE7
 824  8AE7 0E 03            ld   c, 3                      ; Durata impulso
 825  8AE9              .audio_loop:
 826  8AE9 AF               xor  a
 827  8AEA D3 FE            out  ($fe), a
 828  8AEC 42               ld   b, d
 829  8AED 10 FE        .w1: djnz .w1
 830  8AEF
 831  8AEF 3E 18            ld   a, $18
 832  8AF1 D3 FE            out  ($fe), a
 833  8AF3 42               ld   b, d
 834  8AF4 10 FE        .w2: djnz .w2
 835  8AF6
 836  8AF6 0D               dec  c
 837  8AF7 20 F0            jr   nz, .audio_loop
 838  8AF9
 839  8AF9 18 D3            jr   .countdown_loop
 840  8AFB
 841  8AFB              .done_countdown:
 842  8AFB E1               pop  hl
 843  8AFC D1               pop  de
 844  8AFD C1               pop  bc
 845  8AFE F1               pop  af
 846  8AFF C9               ret
 847  8B00
 848  8B00              ; -------------------------------------------------------------------
 849  8B00              ; CheckAllItemsCollected
 850  8B00              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 851  8B00              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 852  8B00              ; -------------------------------------------------------------------
 853  8B00              CheckAllItemsCollected:
 854  8B00 3A 20 E8         ld   a, (game_objective_completed)
 855  8B03 B7               or   a
 856  8B04 20 08            jr   nz, .all_collected
 857  8B06 3A 87 E5         ld   a, (num_room_items)
 858  8B09 B7               or   a
 859  8B0A 28 02            jr   z, .all_collected
 860  8B0C B7               or   a
 861  8B0D C9               ret
 862  8B0E              .all_collected:
 863  8B0E 37               scf
 864  8B0F C9               ret
 865  8B10
 866  8B10              ; -------------------------------------------------------------------
 867  8B10              ; CheckInMasterBedroom (alias per retrocompatibilità)
 868  8B10              ; -------------------------------------------------------------------
 869  8B10              CheckInMasterBedroom:
 870  8B10 37               scf
 871  8B11 C9               ret
 872  8B12
 873  8B12              ; -------------------------------------------------------------------
 874  8B12              ; CheckWillyConveyorCollision
 875  8B12              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 876  8B12              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 877  8B12              ; -------------------------------------------------------------------
 878  8B12              CheckWillyConveyorCollision:
 879  8B12 C5               push bc
 880  8B13 D5               push de
 881  8B14 E5               push hl
 882  8B15
 883  8B15                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 884  8B15 CD F4 76         call CheckWillyOnConveyor
 885  8B18 38 49            jr   c, .collision_detected
 886  8B1A
 887  8B1A                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 888  8B1A 3A 2F E5         ld   a, (conveyor_len)
 889  8B1D B7               or   a
 890  8B1E 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 891  8B20
 892  8B20                  ; B = WillyY, C = WillyX
 893  8B20 ED 4B 07 E2      ld   bc, (PlayerPos)
 894  8B24
 895  8B24                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 896  8B24 3A 30 E5         ld   a, (conveyor_row)
 897  8B27 87               add  a, a                  ; *2
 898  8B28 87               add  a, a                  ; *4
 899  8B29 87               add  a, a                  ; *8
 900  8B2A 5F               ld   e, a                  ; E = ConveyorTop
 901  8B2B C6 07            add  a, 7
 902  8B2D 57               ld   d, a                  ; D = ConveyorBottom
 903  8B2E
 904  8B2E                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15

 504+ 7F55                  ; Guardiano Orizzontale:
 505+ 7F55 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 506+ 7F58 E6 03            and  3
 507+ 7F5A 5F               ld   e, a                      ; E = Anim subframe
 508+ 7F5B
 509+ 7F5B 3A 12 E6         ld   a, (room_has_v_guardians)
 510+ 7F5E B7               or   a
 511+ 7F5F 20 0A            jr   nz, .h_use_second_half    ; Se ci sono guardiani verticali, i guardiani orizzontali usano la SECONDA METÀ (frame 4..7)!
 512+ 7F61
 513+ 7F61 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 514+ 7F64 FE 01            cp   1                         ; Sinistra?
 515+ 7F66 28 03            jr   z, .left_frames
 516+ 7F68
 517+ 7F68                  ; Movimento a Destra: Frame 0..3 (prima metà)
 518+ 7F68 7B               ld   a, e
 519+ 7F69 18 23            jr   .got_frame_idx
 520+ 7F6B

2265+ 69B0 0F               rrca
2266+ 69B1 0F               rrca
2267+ 69B2 0F               rrca
2268+ 69B3 0F               rrca
2269+ 69B4 E6 0F            and  $0f
2270+ 69B6 C6 30            add  a, '0'
2271+ 69B8 77               ld   (hl), a
2272+ 69B9 23               inc  hl
2273+ 69BA
2274+ 69BA                  ; Cifra 1 (decine di migliaia)
2275+ 69BA DD 7E 02         ld   a, (ix+2)
2276+ 69BD E6 0F            and  $0f
2277+ 69BF C6 30            add  a, '0'
2278+ 69C1 77               ld   (hl), a
2279+ 69C2 23               inc  hl
2280+ 69C3
2281+ 69C3                  ; Cifra 2 (migliaia)
2282+ 69C3 DD 7E 01         ld   a, (ix+1)
2283+ 69C6 0F               rrca
2284+ 69C7 0F               rrca
2285+ 69C8 0F               rrca
2286+ 69C9 0F               rrca
2287+ 69CA E6 0F            and  $0f
2288+ 69CC C6 30            add  a, '0'
2289+ 69CE 77               ld   (hl), a
2290+ 69CF 23               inc  hl
2291+ 69D0
2292+ 69D0                  ; Cifra 3 (centinaia)
2293+ 69D0 DD 7E 01         ld   a, (ix+1)
2294+ 69D3 E6 0F            and  $0f
2295+ 69D5 C6 30            add  a, '0'
2296+ 69D7 77               ld   (hl), a
2297+ 69D8 23               inc  hl
2298+ 69D9
2299+ 69D9                  ; Cifra 4 (decine)
2300+ 69D9 DD 7E 00         ld   a, (ix+0)
2301+ 69DC 0F               rrca
2302+ 69DD 0F               rrca
2303+ 69DE 0F               rrca
2304+ 69DF 0F               rrca
2305+ 69E0 E6 0F            and  $0f
2306+ 69E2 C6 30            add  a, '0'
2307+ 69E4 77               ld   (hl), a
2308+ 69E5 23               inc  hl
2309+ 69E6
2310+ 69E6                  ; Cifra 5 (unità)
2311+ 69E6 DD 7E 00         ld   a, (ix+0)
2312+ 69E9 E6 0F            and  $0f

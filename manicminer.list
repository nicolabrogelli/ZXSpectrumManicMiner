 138+ 7D39              ; Items_DrawRoom
 139+ 7D39              ;
 140+ 7D39              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 7D39              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 7D39              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 7D39              ;
 144+ 7D39              ; Record item nella stanza (5 byte):
 145+ 7D39              ;   +0 Color / Attributo
 146+ 7D39              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 7D39              ;   +2 Attr Address High
 148+ 7D39              ;   +3 Anim Mask (96)
 149+ 7D39              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 7D39              ; Fine lista: $FF
 151+ 7D39              ; -------------------------------------------------------------------
 152+ 7D39              Items_DrawRoom:
 153+ 7D39 E5               push hl
 154+ 7D3A D5               push de
 155+ 7D3B C5               push bc
 156+ 7D3C DD E5            push ix
 157+ 7D3E FD E5            push iy
 158+ 7D40
 159+ 7D40                  ; 1. Azzera items_grid (512 byte)
 160+ 7D40 21 65 8C         ld   hl, items_grid
 161+ 7D43 11 66 8C         ld   de, items_grid + 1
 162+ 7D46 36 00            ld   (hl), 0
 163+ 7D48 01 FF 01         ld   bc, 511
 164+ 7D4B ED B0            ldir
 165+ 7D4D
 166+ 7D4D                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 7D4D AF               xor  a
 168+ 7D4E 32 E4 91         ld   (num_room_items), a
 169+ 7D51
 170+ 7D51 FD 21 94 91      ld   iy, current_room_items
 171+ 7D55
 172+ 7D55                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 7D55 2A E5 91         ld   hl, (room_ptr)
 174+ 7D58 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 7D5B 19               add  hl, de
 176+ 7D5C E5               push hl
 177+ 7D5D DD E1            pop  ix                        ; IX = bitmap item
 178+ 7D5F
 179+ 7D5F                  ; 4. HL = Inizio lista item nella stanza
 180+ 7D5F 2A E5 91         ld   hl, (room_ptr)
 181+ 7D62 11 75 02         ld   de, OFFSET_ITEMS
 182+ 7D65 19               add  hl, de
 183+ 7D66
 184+ 7D66              .loop:
 185+ 7D66 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 7D67 FE FF            cp   $FF
 187+ 7D69 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 7D6B
 189+ 7D6B 5F               ld   e, a                      ; E = Color
 190+ 7D6C 23               inc  hl
 191+ 7D6D 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 7D6E 23               inc  hl
 193+ 7D6F 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 7D70 23               inc  hl                        ; Salta Anim Byte
 195+ 7D71 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 7D72
 197+ 7D72 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 7D73 FE FF            cp   $FF

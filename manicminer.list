 315+ 7EB1              ; -------------------------------------------------------------------
 316+ 7EB1              ; Enemy_DrawSingleSlot
 317+ 7EB1              ;
 318+ 7EB1              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7EB1              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7EB1              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7EB1              ; -------------------------------------------------------------------
 322+ 7EB1              Enemy_DrawSingleSlot:
 323+ 7EB1 C5               push bc
 324+ 7EB2 D5               push de
 325+ 7EB3 E5               push hl
 326+ 7EB4 DD E5            push ix
 327+ 7EB6
 328+ 7EB6                  ; 1. Determina il frame di animazione (0..7)
 329+ 7EB6                  ; Nei dati di Manic Miner:
 330+ 7EB6                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7EB6                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7EB6 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7EB9 E6 03            and  3
 334+ 7EBB 47               ld   b, a                      ; B = Anim subframe
 335+ 7EBC
 336+ 7EBC DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7EBF FE 01            cp   1                         ; Sinistra?
 338+ 7EC1 28 03            jr   z, .left_frames
 339+ 7EC3
 340+ 7EC3                  ; Movimento a Destra: Frame 0..3
 341+ 7EC3 78               ld   a, b
 342+ 7EC4 18 03            jr   .got_frame_idx

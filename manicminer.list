 289  8A45              ; -------------------------------------------------------------------
 290  8A45              ; ShowTitleScreen
 291  8A45              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  8A45              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  8A45              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  8A45              ; -------------------------------------------------------------------
 295  8A45              ShowTitleScreen:
 296  8A45                  ; 1. Disegna la schermata iniziale
 297  8A45 CD 7A 64         call Gfx_DrawTitleScreen
 298  8A48
 299  8A48                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  8A48              .wait_title_enter_release:
 301  8A48 76               halt
 302  8A49 3E BF            ld   a, $bf
 303  8A4B DB FE            in   a, ($fe)
 304  8A4D 1F               rra
 305  8A4E 30 F8            jr   nc, .wait_title_enter_release
 306  8A50
 307  8A50                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  8A50 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  8A52              .title_loop:
 310  8A52 76               halt
 311  8A53
 312  8A53                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  8A53 0C               inc  c
 314  8A54 79               ld   a, c
 315  8A55 CB 3F            srl  a
 316  8A57 CB 3F            srl  a
 317  8A59 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  8A5B E6 07            and  7
 319  8A5D 5F               ld   e, a
 320  8A5E 16 00            ld   d, 0
 321  8A60 21 72 64         ld   hl, title_color_table
 322  8A63 19               add  hl, de
 323  8A64 7E               ld   a, (hl)               ; A = nuovo colore
 324  8A65 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  8A68 06 20            ld   b, 32
 326  8A6A              .color_title_loop:
 327  8A6A 77               ld   (hl), a
 328  8A6B 23               inc  hl
 329  8A6C 10 FC            djnz .color_title_loop
 330  8A6E
 331  8A6E                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  8A6E 3E BF            ld   a, $bf
 333  8A70 DB FE            in   a, ($fe)
 334  8A72 1F               rra
 335  8A73 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  8A75
 337  8A75                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  8A75              .wait_title_enter_release_after:
 339  8A75 76               halt
 340  8A76 3E BF            ld   a, $bf
 341  8A78 DB FE            in   a, ($fe)
 342  8A7A 1F               rra
 343  8A7B 30 F8            jr   nc, .wait_title_enter_release_after
 344  8A7D
 345  8A7D                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  8A7D AF               xor  a
 347  8A7E D3 FE            out  ($fe), a              ; Bordo a nero
 348  8A80 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  8A83
 350  8A83                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  8A83 CD 44 8C         call ResetFullGameState
 352  8A86
 353  8A86                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  8A86 C3 06 89         jp   LoadRoomAndRestart

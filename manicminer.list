 960  87D8                  ; Azzeramento punteggio partita corrente (Score = 000000)
 961  87D8                  ; Nota: High score viene mantenuto intatto tra le partite
 962  87D8 AF               xor  a
 963  87D9 32 42 A4         ld   (player_score + 0), a

 631+ 86D1              ; Score_Add1Point
 632+ 86D1              ; Aggiunge 1 punto allo Score del giocatore (usato nel countdown dell'aria a fine livello).
 633+ 86D1              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 634+ 86D1              ; -------------------------------------------------------------------
 635+ 86D1              Score_Add1Point:
 636+ 86D1 F5               push af
 637+ 86D2 C5               push bc
 638+ 86D3 D5               push de
 639+ 86D4 E5               push hl
 640+ 86D5
 641+ 86D5                  ; Aggiungi 1 punto (byte 0 in BCD rappresenta unità e decine)
 642+ 86D5 3A C6 EF         ld   a, (player_score + 0)
 643+ 86D8 C6 01            add  a, $01
 644+ 86DA 27               daa
 645+ 86DB 32 C6 EF         ld   (player_score + 0), a
 646+ 86DE
 647+ 86DE                  ; Riporto al byte 1 (centinaia / migliaia)
 648+ 86DE 3A C7 EF         ld   a, (player_score + 1)
 649+ 86E1 CE 00            adc  a, 0
 650+ 86E3 27               daa
 651+ 86E4 32 C7 EF         ld   (player_score + 1), a
 652+ 86E7
 653+ 86E7                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 86E7 3A C8 EF         ld   a, (player_score + 2)
 655+ 86EA CE 00            adc  a, 0
 656+ 86EC 27               daa
 657+ 86ED 32 C8 EF         ld   (player_score + 2), a
 658+ 86F0
 659+ 86F0                  ; Controlla se player_score ha superato high_score
 660+ 86F0 CD 1C 87         call Score_CheckAndUpdateHighScore
 661+ 86F3
 662+ 86F3                  ; Aggiorna visualizzazione a schermo

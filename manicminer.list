 707+ 8803              ; Score_CheckAndUpdateHighScore
 708+ 8803              ; Se player_score > high_score, copia player_score in high_score.
 709+ 8803              ; -------------------------------------------------------------------
 710+ 8803              Score_CheckAndUpdateHighScore:
 711+ 8803                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 8803                  ; Byte 2:
 713+ 8803 3A 06 F1         ld   a, (player_score + 2)
 714+ 8806 47               ld   b, a
 715+ 8807 3A 09 F1         ld   a, (high_score + 2)
 716+ 880A B8               cp   b
 717+ 880B 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 880D 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 880F
 720+ 880F                  ; Byte 1:
 721+ 880F 3A 05 F1         ld   a, (player_score + 1)
 722+ 8812 47               ld   b, a
 723+ 8813 3A 08 F1         ld   a, (high_score + 1)
 724+ 8816 B8               cp   b
 725+ 8817 38 0C            jr   c, .new_high_score
 726+ 8819 20 1C            jr   nz, .done_check
 727+ 881B
 728+ 881B                  ; Byte 0:
 729+ 881B 3A 04 F1         ld   a, (player_score + 0)
 730+ 881E 47               ld   b, a
 731+ 881F 3A 07 F1         ld   a, (high_score + 0)
 732+ 8822 B8               cp   b
 733+ 8823 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 8825
 735+ 8825              .new_high_score:
 736+ 8825 3A 04 F1         ld   a, (player_score + 0)
 737+ 8828 32 07 F1         ld   (high_score + 0), a
 738+ 882B 3A 05 F1         ld   a, (player_score + 1)
 739+ 882E 32 08 F1         ld   (high_score + 1), a
 740+ 8831 3A 06 F1         ld   a, (player_score + 2)
 741+ 8834 32 09 F1         ld   (high_score + 2), a
 742+ 8837
 743+ 8837              .done_check:
 744+ 8837 C9               ret

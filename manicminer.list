 660+ 82A6              ; Score_CheckAndUpdateHighScore
 661+ 82A6              ; Se player_score > high_score, copia player_score in high_score.
 662+ 82A6              ; -------------------------------------------------------------------
 663+ 82A6              Score_CheckAndUpdateHighScore:
 664+ 82A6                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 82A6                  ; Byte 2:
 666+ 82A6 3A 11 9C         ld   a, (player_score + 2)
 667+ 82A9 47               ld   b, a
 668+ 82AA 3A 14 9C         ld   a, (high_score + 2)
 669+ 82AD B8               cp   b
 670+ 82AE 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 82B0 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 82B2
 673+ 82B2                  ; Byte 1:
 674+ 82B2 3A 10 9C         ld   a, (player_score + 1)
 675+ 82B5 47               ld   b, a
 676+ 82B6 3A 13 9C         ld   a, (high_score + 1)
 677+ 82B9 B8               cp   b
 678+ 82BA 38 0C            jr   c, .new_high_score
 679+ 82BC 20 1C            jr   nz, .done_check
 680+ 82BE
 681+ 82BE                  ; Byte 0:
 682+ 82BE 3A 0F 9C         ld   a, (player_score + 0)
 683+ 82C1 47               ld   b, a
 684+ 82C2 3A 12 9C         ld   a, (high_score + 0)
 685+ 82C5 B8               cp   b
 686+ 82C6 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 82C8
 688+ 82C8              .new_high_score:
 689+ 82C8 3A 0F 9C         ld   a, (player_score + 0)
 690+ 82CB 32 12 9C         ld   (high_score + 0), a
 691+ 82CE 3A 10 9C         ld   a, (player_score + 1)
 692+ 82D1 32 13 9C         ld   (high_score + 1), a
 693+ 82D4 3A 11 9C         ld   a, (player_score + 2)
 694+ 82D7 32 14 9C         ld   (high_score + 2), a
 695+ 82DA
 696+ 82DA              .done_check:
 697+ 82DA C9               ret

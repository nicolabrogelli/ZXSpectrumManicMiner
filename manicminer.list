 701  8BAF              ; CheckAllItemsCollected
 702  8BAF              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8BAF              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8BAF              ; -------------------------------------------------------------------
 705  8BAF              CheckAllItemsCollected:
 706  8BAF 3A CF F0         ld   a, (game_objective_completed)
 707  8BB2 B7               or   a

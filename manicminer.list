 121+ 80DB FE FF            cp   $FF
 122+ 80DD 28 09            jr   z, .done                  ; $FF = fine lista item della stanza
 123+ 80DF 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 80E0 23               inc  hl                        ; +2 (Attr Address High)
 125+ 80E1 23               inc  hl                        ; +3 (Anim mask)
 126+ 80E2 23               inc  hl                        ; +4 (Collected flag)
 127+ 80E3 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 80E5 23               inc  hl                        ; Avanza al prossimo item
 129+ 80E6 18 F2            jr   .item_loop
 130+ 80E8
 131+ 80E8              .done:

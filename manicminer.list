 518+ 7FF0              ; CheckCollision
 519+ 7FF0              ;
 520+ 7FF0              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 521+ 7FF0              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 522+ 7FF0              ; Output:
 523+ 7FF0              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 524+ 7FF0              ;   Carry Clear = Nessuna collisione
 525+ 7FF0              ; -------------------------------------------------------------------
 526+ 7FF0              CheckCollision:
 527+ 7FF0 DD E5            push ix
 528+ 7FF2 C5               push bc
 529+ 7FF3 D5               push de
 530+ 7FF4 E5               push hl
 531+ 7FF5
 532+ 7FF5                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 533+ 7FF5 3A 4B AF         ld   a, (willy_safety_timer)
 534+ 7FF8 B7               or   a
 535+ 7FF9 C2 35 81         jp   nz, .no_collision_found
 536+ 7FFC
 537+ 7FFC                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 538+ 7FFC 3A 47 AB         ld   a, (direction)
 539+ 7FFF FE 01            cp   1                         ; Sinistra?
 540+ 8001 20 1A            jr   nz, .willy_right
 541+ 8003
 542+ 8003                  ; Willy a Sinistra:
 543+ 8003 21 20 A5         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 544+ 8006 22 61 B1         ld   (willy_head_ptr), hl
 545+ 8009 3A 46 AB         ld   a, (body_state)           ; 0, 1, 2
 546+ 800C C6 05            add  a, 5                      ; tile 5, 6, 7
 547+ 800E 87               add  a, a
 547+ 800F 87             add a, a
 547+ 8010 87             add a, a ; * 8
 548+ 8011 5F               ld   e, a
 549+ 8012 16 00            ld   d, 0
 550+ 8014 21 00 A5         ld   hl, Willy
 551+ 8017 19               add  hl, de
 552+ 8018 22 63 B1         ld   (willy_body_ptr), hl      ; Corpo sinistro
 553+ 801B 18 18            jr   .willy_ptrs_ready
 554+ 801D
 555+ 801D              .willy_right:
 556+ 801D                  ; Willy a Destra:
 557+ 801D 21 00 A5         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 558+ 8020 22 61 B1         ld   (willy_head_ptr), hl
 559+ 8023 3A 46 AB         ld   a, (body_state)           ; 0, 1, 2
 560+ 8026 C6 01            add  a, 1                      ; tile 1, 2, 3
 561+ 8028 87               add  a, a
 561+ 8029 87             add a, a
 561+ 802A 87             add a, a ; * 8
 562+ 802B 5F               ld   e, a
 563+ 802C 16 00            ld   d, 0
 564+ 802E 21 00 A5         ld   hl, Willy
 565+ 8031 19               add  hl, de
 566+ 8032 22 63 B1         ld   (willy_body_ptr), hl      ; Corpo destro
 567+ 8035
 568+ 8035              .willy_ptrs_ready:
 569+ 8035 DD 21 E8 7C      ld   ix, ActiveEnemies
 570+ 8039 06 08            ld   b, 8                      ; 8 slot
 571+ 803B
 572+ 803B              .enemy_loop:
 573+ 803B DD 7E 00         ld   a, (ix+0)
 574+ 803E E6 80            and  $80                       ; Active?
 575+ 8040 CA 2C 81         jp   z, .next_enemy
 576+ 8043
 577+ 8043                  ; ---------------------------------------------------------------
 578+ 8043                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 579+ 8043                  ; ---------------------------------------------------------------
 580+ 8043                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 581+ 8043 3A 40 AB         ld   a, (PlayerPos)            ; WillyX
 582+ 8046 DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 583+ 8049 FE 10            cp   16
 584+ 804B 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 585+ 804D FE F9            cp   249                       ; 249..255 = -7..-1
 586+ 804F DA 2C 81         jp   c, .next_enemy            ; 16..248 -> fuori range
 587+ 8052              .x_in_range:
 588+ 8052 32 67 B1         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 589+ 8055
 590+ 8055                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 591+ 8055 3A 41 AB         ld   a, (PlayerPos+1)          ; WillyY
 592+ 8058 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 593+ 805B FE 10            cp   16
 594+ 805D 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 595+ 805F FE F1            cp   241                       ; 241..255 = -15..-1
 596+ 8061 DA 2C 81         jp   c, .next_enemy            ; 16..240 -> fuori range
 597+ 8064              .y_in_range:
 598+ 8064 32 68 B1         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 599+ 8067
 600+ 8067                  ; ---------------------------------------------------------------
 601+ 8067                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 602+ 8067                  ; ---------------------------------------------------------------
 603+ 8067 C5               push bc                        ; Salva contatore nemici (B)
 604+ 8068
 605+ 8068 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 606+ 806B E6 03            and  3
 607+ 806D 4F               ld   c, a
 608+ 806E
 609+ 806E DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 610+ 8071 FE 01            cp   1
 611+ 8073 28 03            jr   z, .guard_left_frame
 612+ 8075                  ; Frame Destra: Frame = Subframe (0..3)
 613+ 8075 79               ld   a, c
 614+ 8076 18 03            jr   .calc_guard_ptr
 615+ 8078              .guard_left_frame:
 616+ 8078                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 617+ 8078 3E 04            ld   a, 4
 618+ 807A 81               add  a, c
 619+ 807B
 620+ 807B              .calc_guard_ptr:
 621+ 807B                  ; Offset = Frame * 32
 622+ 807B 6F               ld   l, a
 623+ 807C 26 00            ld   h, 0
 624+ 807E 29               add  hl, hl                    ; *2
 625+ 807F 29               add  hl, hl                    ; *4
 626+ 8080 29               add  hl, hl                    ; *8
 627+ 8081 29               add  hl, hl                    ; *16
 628+ 8082 29               add  hl, hl                    ; *32
 629+ 8083 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 630+ 8086 19               add  hl, de
 631+ 8087 ED 5B C1 AE      ld   de, (room_ptr)
 632+ 808B 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 633+ 808C 22 65 B1         ld   (guard_sprite_ptr), hl
 634+ 808F
 635+ 808F                  ; ---------------------------------------------------------------
 636+ 808F                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 637+ 808F                  ; ---------------------------------------------------------------
 638+ 808F 3A 68 B1         ld   a, (collision_delta_y)
 639+ 8092 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 640+ 8094 20 12            jr   nz, .willy_higher
 641+ 8096
 642+ 8096                  ; Willy lower or equal (DeltaY >= 0):
 643+ 8096                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 644+ 8096 32 69 B1         ld   (row_enemy_cur), a
 645+ 8099 AF               xor  a
 646+ 809A 32 6A B1         ld   (row_willy_cur), a
 647+ 809D 3E 10            ld   a, 16
 648+ 809F 21 68 B1         ld   hl, collision_delta_y
 649+ 80A2 96               sub  (hl)
 650+ 80A3 32 6B B1         ld   (overlap_num_lines), a
 651+ 80A6 18 12            jr   .check_lines_loop
 652+ 80A8
 653+ 80A8              .willy_higher:
 654+ 80A8                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 655+ 80A8 ED 44            neg                            ; A = -DeltaY (1..15)
 656+ 80AA 32 6A B1         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 657+ 80AD AF               xor  a
 658+ 80AE 32 69 B1         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 659+ 80B1 3E 10            ld   a, 16
 660+ 80B3 21 6A B1         ld   hl, row_willy_cur
 661+ 80B6 96               sub  (hl)
 662+ 80B7 32 6B B1         ld   (overlap_num_lines), a
 663+ 80BA
 664+ 80BA              .check_lines_loop:
 665+ 80BA                  ; ---------------------------------------------------------------
 666+ 80BA                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 667+ 80BA                  ; ---------------------------------------------------------------
 668+ 80BA 3A 6B B1         ld   a, (overlap_num_lines)
 669+ 80BD 47               ld   b, a                      ; B = numero di scanlines da controllare
 670+ 80BE
 671+ 80BE              .scanline_loop:
 672+ 80BE C5               push bc                        ; Salva contatore scanlines
 673+ 80BF
 674+ 80BF                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 675+ 80BF 3A 69 B1         ld   a, (row_enemy_cur)
 676+ 80C2 87               add  a, a                      ; row * 2
 677+ 80C3 5F               ld   e, a
 678+ 80C4 16 00            ld   d, 0
 679+ 80C6 2A 65 B1         ld   hl, (guard_sprite_ptr)
 680+ 80C9 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 681+ 80CA 56               ld   d, (hl)                   ; D = Enemy Byte 0
 682+ 80CB 23               inc  hl
 683+ 80CC 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 684+ 80CD
 685+ 80CD                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 686+ 80CD 3A 67 B1         ld   a, (collision_delta_x)
 687+ 80D0 CB 7F            bit  7, a
 688+ 80D2 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 689+ 80D4
 690+ 80D4                  ; DeltaX >= 0:
 691+ 80D4 FE 09            cp   9
 692+ 80D6 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 693+ 80D8
 694+ 80D8                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 695+ 80D8 B7               or   a
 696+ 80D9 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 697+ 80DB 4F               ld   c, a                      ; C = DeltaX (1..8)
 698+ 80DC              .shift_left_16bit:
 699+ 80DC CB 23            sla  e
 700+ 80DE CB 12            rl   d
 701+ 80E0 0D               dec  c
 702+ 80E1 20 F9            jr   nz, .shift_left_16bit
 703+ 80E3              .slice_ready_in_d:
 704+ 80E3 7A               ld   a, d                      ; A = fetta guardiano allineata
 705+ 80E4 18 14            jr   .test_willy_line
 706+ 80E6
 707+ 80E6              .shift_dx_gt_8:
 708+ 80E6                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 709+ 80E6 D6 08            sub  8
 710+ 80E8 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 711+ 80E9              .shift_left_e_only:
 712+ 80E9 CB 23            sla  e
 713+ 80EB 0D               dec  c
 714+ 80EC 20 FB            jr   nz, .shift_left_e_only
 715+ 80EE 7B               ld   a, e                      ; A = fetta guardiano allineata
 716+ 80EF 18 09            jr   .test_willy_line
 717+ 80F1
 718+ 80F1              .shift_neg_dx:
 719+ 80F1                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 720+ 80F1 ED 44            neg
 721+ 80F3 4F               ld   c, a                      ; C = -DeltaX (1..7)
 722+ 80F4              .shift_right_d_only:
 723+ 80F4 CB 3A            srl  d
 724+ 80F6 0D               dec  c
 725+ 80F7 20 FB            jr   nz, .shift_right_d_only
 726+ 80F9 7A               ld   a, d                      ; A = fetta guardiano allineata
 727+ 80FA
 728+ 80FA              .test_willy_line:
 729+ 80FA                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 730+ 80FA B7               or   a
 731+ 80FB 28 21            jr   z, .next_scanline
 732+ 80FD
 733+ 80FD                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 734+ 80FD 4F               ld   c, a                      ; C = fetta guardiano
 735+ 80FE 3A 6A B1         ld   a, (row_willy_cur)
 736+ 8101 FE 08            cp   8
 737+ 8103 38 0D            jr   c, .read_willy_head
 738+ 8105
 739+ 8105                  ; Riga corpo (8..15)
 740+ 8105 D6 08            sub  8
 741+ 8107 6F               ld   l, a
 742+ 8108 26 00            ld   h, 0
 743+ 810A ED 5B 63 B1      ld   de, (willy_body_ptr)
 744+ 810E 19               add  hl, de
 745+ 810F 7E               ld   a, (hl)                   ; A = byte corpo Willy
 746+ 8110 18 09            jr   .do_pixel_and
 747+ 8112
 748+ 8112              .read_willy_head:
 749+ 8112                  ; Riga testa (0..7)
 750+ 8112 6F               ld   l, a
 751+ 8113 26 00            ld   h, 0
 752+ 8115 ED 5B 61 B1      ld   de, (willy_head_ptr)
 753+ 8119 19               add  hl, de
 754+ 811A 7E               ld   a, (hl)                   ; A = byte testa Willy
 755+ 811B
 756+ 811B              .do_pixel_and:
 757+ 811B                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 758+ 811B A1               and  c
 759+ 811C 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 760+ 811E
 761+ 811E              .next_scanline:
 762+ 811E                  ; Avanza alla prossima riga
 763+ 811E 21 69 B1         ld   hl, row_enemy_cur
 764+ 8121 34               inc  (hl)
 765+ 8122 21 6A B1         ld   hl, row_willy_cur
 766+ 8125 34               inc  (hl)
 767+ 8126
 768+ 8126 C1               pop  bc                        ; Ripristina B (contatore scanlines)

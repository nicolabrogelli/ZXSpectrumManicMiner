 376+ 7E31
 377+ 7E31 78               ld   a, b
 378+ 7E32 CD C5 75         call GetCellFromUnpacked       ; A = tile index (0..7)
 379+ 7E35
 380+ 7E35                  ; IX = room_ptr + OFFSET_TILES + A * 9
 381+ 7E35 6F               ld   l, a
 382+ 7E36 26 00            ld   h, 0
 383+ 7E38 5F               ld   e, a
 384+ 7E39 16 00            ld   d, 0
 385+ 7E3B 29               add  hl, hl                    ; *2
 386+ 7E3C 29               add  hl, hl                    ; *4
 387+ 7E3D 29               add  hl, hl                    ; *8
 388+ 7E3E 19               add  hl, de                    ; *9
 389+ 7E3F 11 20 02         ld   de, OFFSET_TILES
 390+ 7E42 19               add  hl, de
 391+ 7E43 ED 5B 2D 96      ld   de, (room_ptr)

 265  8A28 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  8A2A              .raster_loop:
 267  8A2A D3 FE            out  ($fe), a
 268  8A2C 3C               inc  a
 269  8A2D E6 07            and  7
 270  8A2F 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  8A31              .delay:
 272  8A31 0D               dec  c
 273  8A32 20 FD            jr   nz, .delay
 274  8A34 10 F4            djnz .raster_loop
 275  8A36
 276  8A36                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  8A36 3A EA EA         ld   a, (room_border_color)
 278  8A39 D3 FE            out  ($fe), a
 279  8A3B 18 05            jr   .no_collision_change

 461+ 5F9D CD 10 5E         call Gfx_GetScreenAddr ; HL = indirizzo schermo
 462+ 5FA0
 463+ 5FA0 0E 10            ld   c, 16          ; 16 linee/scanline
 464+ 5FA2              .line_loop:
 465+ 5FA2 DD 56 00         ld   d, (ix+0)     ; D = primo byte dello sprite
 466+ 5FA5 DD 5E 01         ld   e, (ix+1)     ; E = secondo byte dello sprite
 467+ 5FA8
 468+ 5FA8                  ; Esegui lo shift a destra se necessario
 469+ 5FA8 3A 94 93         ld   a, (sprite_shift)
 470+ 5FAB B7               or   a
 471+ 5FAC 28 1C            jr   z, .no_shift
 472+ 5FAE
 473+ 5FAE C5               push bc            ; Salva il contatore delle linee (C) e lo shift (B)
 474+ 5FAF 47               ld   b, a          ; B = contatore shift
 475+ 5FB0 AF               xor  a             ; A = terzo byte (inizializzato a 0)
 476+ 5FB1
 477+ 5FB1              .shift_loop:
 478+ 5FB1 CB 3A            srl  d
 479+ 5FB3 CB 1B            rr   e
 480+ 5FB5 CB 1F            rr   a
 481+ 5FB7 10 F8            djnz .shift_loop
 482+ 5FB9
 483+ 5FB9 C1               pop  bc            ; Ripristina C (contatore linee)
 484+ 5FBA
 485+ 5FBA                  ; Scrive i 3 byte sullo schermo (OR trasparente)
 486+ 5FBA 47               ld   b, a          ; Salva il 3° byte dello sprite in B
 487+ 5FBB 7A               ld   a, d
 488+ 5FBC B6               or   (hl)
 489+ 5FBD 77               ld   (hl), a
 490+ 5FBE 23               inc  hl
 491+ 5FBF 7B               ld   a, e
 492+ 5FC0 B6               or   (hl)
 493+ 5FC1 77               ld   (hl), a
 494+ 5FC2 23               inc  hl
 495+ 5FC3 78               ld   a, b          ; Recupera il 3° byte dello sprite
 496+ 5FC4 B6               or   (hl)
 497+ 5FC5 77               ld   (hl), a
 498+ 5FC6 2B               dec  hl
 499+ 5FC7 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 500+ 5FC8 18 08            jr   .next_line
 501+ 5FCA
 502+ 5FCA              .no_shift:
 503+ 5FCA                  ; Nessuno shift: scrivi i 2 byte direttamente (OR trasparente)
 504+ 5FCA 7A               ld   a, d
 505+ 5FCB B6               or   (hl)
 506+ 5FCC 77               ld   (hl), a
 507+ 5FCD 23               inc  hl
 508+ 5FCE 7B               ld   a, e
 509+ 5FCF B6               or   (hl)
 510+ 5FD0 77               ld   (hl), a
 511+ 5FD1 2B               dec  hl            ; Ripristina HL alla colonna iniziale
 512+ 5FD2
 513+ 5FD2              .next_line:
 514+ 5FD2 CD 30 5E         call Gfx_IncScreenLine ; Vai alla prossima riga dello schermo

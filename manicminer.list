  83+ 6CA4              ; MOVIMENTO SINISTRA
  84+ 6CA4              ; ===============================================================
  85+ 6CA4              movePlayer_left:
  86+ 6CA4                  ; Impedisci lo spostamento a sinistra se Willy è sul conveyor ed il conveyor va a destra.
  87+ 6CA4 CD 18 75         call CheckWillyOnConveyor
  88+ 6CA7 30 05            jr   nc, .continue_left
  89+ 6CA9 3A B0 96         ld   a, (conveyor_dir)

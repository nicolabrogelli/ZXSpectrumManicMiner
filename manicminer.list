 271+ 6CF8              ; LoadPositionPlayeinRoom
 272+ 6CF8              ;
 273+ 6CF8              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6CF8              ; in una nuova stanza.
 275+ 6CF8              ;
 276+ 6CF8              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6CF8              ; (layout/metadata) a partire da room_ptr.
 278+ 6CF8              ;
 279+ 6CF8              ; Output:
 280+ 6CF8              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6CF8              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6CF8              ;
 283+ 6CF8              ; Struttura dati stanza:
 284+ 6CF8              ;   OFFSET_POS_WILLY:
 285+ 6CF8              ;       +0 = X
 286+ 6CF8              ;       +1 = Y
 287+ 6CF8              ; -------------------------------------------------------------------
 288+ 6CF8              LoadPositionPlayeinRoom:
 289+ 6CF8                  ; ---------------------------------------------------------------
 290+ 6CF8                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6CF8                  ; ---------------------------------------------------------------

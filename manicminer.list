  72+ 80B9 ~            ; Audio_UpdateMusic
  73+ 80B9 ~            ;
  74+ 80B9 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 80B9 ~            ; Viene chiamata a ogni frame.
  76+ 80B9 ~            ; -------------------------------------------------------------------
  77+ 80B9 ~            Audio_UpdateMusic:
  78+ 80B9 ~                push af
  79+ 80B9 ~                push bc
  80+ 80B9 ~                push de
  81+ 80B9 ~                push hl
  82+ 80B9 ~
  83+ 80B9 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 80B9 ~                ld   a, (Audio_jump_sound_note)
  85+ 80B9 ~                cp   18
  86+ 80B9 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 80B9 ~
  88+ 80B9 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 80B9 ~                ld   a, (Audio_music_frame_counter)
  90+ 80B9 ~                dec  a
  91+ 80B9 ~                ld   (Audio_music_frame_counter), a
  92+ 80B9 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 80B9 ~
  94+ 80B9 ~                ; Altrimenti carica la nota successiva
  95+ 80B9 ~                ld   a, (Audio_music_note_idx)
  96+ 80B9 ~                inc  a
  97+ 80B9 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 80B9 ~                jr   c, .no_wrap
  99+ 80B9 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 80B9 ~            .no_wrap:
 101+ 80B9 ~                ld   (Audio_music_note_idx), a
 102+ 80B9 ~
 103+ 80B9 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 80B9 ~                ld   e, a
 105+ 80B9 ~                ld   d, 0
 106+ 80B9 ~                ld   hl, Audio_MusicSheet
 107+ 80B9 ~                add  hl, de
 108+ 80B9 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 80B9 ~
 110+ 80B9 ~                ; Leggi durata (secondo byte)
 111+ 80B9 ~                inc  hl
 112+ 80B9 ~                ld   a, (hl)
 113+ 80B9 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 80B9 ~                jr   nz, .dur_ok
 115+ 80B9 ~                ld   a, 1
 116+ 80B9 ~            .dur_ok:
 117+ 80B9 ~                ld   (Audio_music_frame_counter), a
 118+ 80B9 ~
 119+ 80B9 ~            .play_current_note:
 120+ 80B9 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 80B9 ~                ld   a, (Audio_music_note_idx)
 122+ 80B9 ~                ld   e, a
 123+ 80B9 ~                ld   d, 0
 124+ 80B9 ~                ld   hl, Audio_MusicSheet
 125+ 80B9 ~                add  hl, de
 126+ 80B9 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 80B9 ~                ld   a, (hl)                  ; A = delay
 128+ 80B9 ~                or   a
 129+ 80B9 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 80B9 ~
 131+ 80B9 ~                ; Suona la nota: 2 cicli
 132+ 80B9 ~                ld   d, a                     ; D = delay
 133+ 80B9 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 80B9 ~            .note_loop:
 135+ 80B9 ~                ; Speaker ON
 136+ 80B9 ~                ld   a, (room_border_color)
 137+ 80B9 ~                or   $10
 138+ 80B9 ~                out  ($fe), a
 139+ 80B9 ~                ld   c, d
 140+ 80B9 ~            .d1:
 141+ 80B9 ~                push af
 142+ 80B9 ~                pop  af
 143+ 80B9 ~                dec  c
 144+ 80B9 ~                jr   nz, .d1
 145+ 80B9 ~
 146+ 80B9 ~                ; Speaker OFF
 147+ 80B9 ~                ld   a, (room_border_color)
 148+ 80B9 ~                and  $ef
 149+ 80B9 ~                out  ($fe), a
 150+ 80B9 ~                ld   c, d
 151+ 80B9 ~            .d2:
 152+ 80B9 ~                push af
 153+ 80B9 ~                pop  af
 154+ 80B9 ~                dec  c
 155+ 80B9 ~                jr   nz, .d2
 156+ 80B9 ~
 157+ 80B9 ~                djnz .note_loop
 158+ 80B9 ~
 159+ 80B9 ~            .done:
 160+ 80B9 ~                pop  hl
 161+ 80B9 ~                pop  de
 162+ 80B9 ~                pop  bc
 163+ 80B9 ~                pop  af
 164+ 80B9 ~                ret
 165+ 80B9 ~
 166+ 80B9 ~            Audio_MusicSheet:
 167+ 80B9 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 80B9 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 80B9 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 80B9 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 80B9 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 80B9 ~                db 90, 10, 107, 20, 68, 65

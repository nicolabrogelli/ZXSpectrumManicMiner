  93+ 7AAC
  94+ 7AAC                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7AAC CB 3C            srl  h
  95+ 7AAE CB 1D          rr l
  96+ 7AB0 CB 3C            srl  h
  96+ 7AB2 CB 1D          rr l
  97+ 7AB4 CB 3C            srl  h
  97+ 7AB6 CB 1D          rr l
  98+ 7AB8 CB 3C            srl  h
  98+ 7ABA CB 1D          rr l
  99+ 7ABC CB 3C            srl  h
  99+ 7ABE CB 1D          rr l
 100+ 7AC0 7D               ld   a, l

 436+ 7ED2              ; -------------------------------------------------------------------
 437+ 7ED2              ; Enemy_Update
 438+ 7ED2              ;
 439+ 7ED2              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 440+ 7ED2              ; -------------------------------------------------------------------
 441+ 7ED2              Enemy_Update:
 442+ 7ED2                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 443+ 7ED2 3A 6D E2         ld   a, (enemy_update_rate)
 444+ 7ED5 FE 01            cp   1
 445+ 7ED7 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 446+ 7ED9
 447+ 7ED9 21 6E E2         ld   hl, enemy_update_timer
 448+ 7EDC 34               inc  (hl)
 449+ 7EDD 7E               ld   a, (hl)
 450+ 7EDE 21 6D E2         ld   hl, enemy_update_rate
 451+ 7EE1 BE               cp   (hl)
 452+ 7EE2 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 453+ 7EE3 AF               xor  a
 454+ 7EE4 32 6E E2         ld   (enemy_update_timer), a

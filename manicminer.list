 483  8576 AF               xor  a
 484  8577 32 12 9E         ld   (velocity_y), a
 485  857A 32 14 9E         ld   (jump_pressed), a
 486  857D 32 16 9E         ld   (coyote_timer), a
 487  8580 32 19 9E         ld   (jump_frame), a
 488  8583 32 18 9E         ld   (jump_dir), a

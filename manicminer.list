 857  82DF              ; ResetFullGameState
 858  82DF              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 859  82DF              ; per l'avvio di una nuova partita dopo il Game Over.
 860  82DF              ; -------------------------------------------------------------------
 861  82DF              ResetFullGameState:
 862  82DF                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 863  82DF AF               xor  a
 864  82E0 D3 FE            out  ($fe), a              ; Bordo a nero
 865  82E2 21 8D 5C         ld   hl, ATTR_P
 866  82E5 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 867  82E6 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 868  82E9 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 869  82EB 3E 07            ld   a, $07
 870  82ED 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 871  82F0
 872  82F0                  ; Ripristina il numero di vite iniziali
 873  82F0 3E 07            ld   a, INITIAL_LIVES
 874  82F2 32 06 8E         ld   (willy_lives), a
 875  82F5
 876  82F5                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 877  82F5 AF               xor  a
 878  82F6 32 03 8E         ld   (items_collected), a
 879  82F9 32 FF 8D         ld   (body_state), a
 880  82FC 32 12 8E         ld   (w_warp_state), a
 881  82FF 32 15 8E         ld   (w_key_prev), a
 882  8302 32 16 8E         ld   (enter_key_prev), a
 883  8305 32 07 8E         ld   (velocity_y), a
 884  8308 32 09 8E         ld   (jump_pressed), a
 885  830B 32 0B 8E         ld   (coyote_timer), a
 886  830E 32 0E 8E         ld   (jump_frame), a
 887  8311 32 0D 8E         ld   (jump_dir), a
 888  8314 32 7F 91         ld   (transition_active), a
 889  8317 32 03 92         ld   (willy_safety_timer), a
 890  831A 3E FF            ld   a, $ff
 891  831C 32 17 8E         ld   (digit_key_prev), a
 892  831F 3E 01            ld   a, 1
 893  8321 32 10 8E         ld   (q_prev), a
 894  8324 32 11 8E         ld   (a_prev), a
 895  8327 32 08 8E         ld   (on_ground), a

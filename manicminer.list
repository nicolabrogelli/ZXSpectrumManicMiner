 892+ 7770
 893+ 7770 3A 0D CA         ld   a, (ramp_col)
 894+ 7773 3C               inc  a
 895+ 7774 4F               ld   c, a              ; C = limit_right (exclusive)
 896+ 7775
 897+ 7775 7B               ld   a, e              ; A = Col
 898+ 7776 B8               cp   b
 899+ 7777 38 15            jr   c, .check_platform_case
 900+ 7779 B9               cp   c
 901+ 777A 30 12            jr   nc, .check_platform_case

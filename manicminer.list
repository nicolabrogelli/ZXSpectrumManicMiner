 860+ 7774              ; -------------------------------------------------------------------
 861+ 7774              ; Verifica se la cella (Col in E, Row in D) è sulla rampa, immediatamente sotto di essa,
 862+ 7774              ; o sulla piattaforma adiacente in cima.
 863+ 7774              ; Output: Carry flag impostato se è sulla rampa, altrimenti resettato
 864+ 7774              ; -------------------------------------------------------------------
 865+ 7774              IsCellOnRamp:
 866+ 7774 C5               push bc
 867+ 7775 E5               push hl
 868+ 7776
 869+ 7776 3A 34 E5         ld   a, (ramp_len)
 870+ 7779 B7               or   a
 871+ 777A 28 6B            jr   z, .no
 872+ 777C
 873+ 777C                  ; 1. Verifica se Col (in E) è nel range orizzontale della rampa
 874+ 777C 3A 33 E5         ld   a, (ramp_dir)
 875+ 777F B7               or   a
 876+ 7780 28 1A            jr   z, .range_left
 877+ 7782              .range_right:
 878+ 7782 3A 36 E5         ld   a, (ramp_col)
 879+ 7785 47               ld   b, a              ; B = ramp_col
 880+ 7786 3A 34 E5         ld   a, (ramp_len)
 881+ 7789 80               add  a, b              ; A = ramp_col + ramp_len
 882+ 778A 4F               ld   c, a              ; C = limit_right (exclusive)
 883+ 778B
 884+ 778B 7B               ld   a, e              ; A = Col
 885+ 778C B8               cp   b
 886+ 778D 38 34            jr   c, .check_platform_case ; Col < ramp_col
 887+ 778F B9               cp   c
 888+ 7790 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 889+ 7792
 890+ 7792                  ; Calcola B = Col - ramp_col
 891+ 7792 7B               ld   a, e
 892+ 7793 90               sub  b
 893+ 7794 47               ld   b, a              ; B = offset (0..ramp_len-1)
 894+ 7795
 895+ 7795                  ; SlopeRow = ramp_row - B
 896+ 7795 3A 35 E5         ld   a, (ramp_row)
 897+ 7798 90               sub  b
 898+ 7799 47               ld   b, a              ; B = SlopeRow
 899+ 779A 18 1F            jr   .check_row_match
 900+ 779C
 901+ 779C              .range_left:
 902+ 779C                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 903+ 779C 21 34 E5         ld   hl, ramp_len
 904+ 779F 3A 36 E5         ld   a, (ramp_col)
 905+ 77A2 96               sub  (hl)
 906+ 77A3 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 907+ 77A4 47               ld   b, a              ; B = limit_left
 908+ 77A5
 909+ 77A5 3A 36 E5         ld   a, (ramp_col)
 910+ 77A8 3C               inc  a
 911+ 77A9 4F               ld   c, a              ; C = limit_right (exclusive)
 912+ 77AA
 913+ 77AA 7B               ld   a, e              ; A = Col
 914+ 77AB B8               cp   b
 915+ 77AC 38 15            jr   c, .check_platform_case
 916+ 77AE B9               cp   c
 917+ 77AF 30 12            jr   nc, .check_platform_case
 918+ 77B1
 919+ 77B1                  ; Calcola B = ramp_col - Col
 920+ 77B1 3A 36 E5         ld   a, (ramp_col)
 921+ 77B4 93               sub  e
 922+ 77B5 47               ld   b, a              ; B = offset
 923+ 77B6
 924+ 77B6                  ; SlopeRow = ramp_row - B
 925+ 77B6 3A 35 E5         ld   a, (ramp_row)
 926+ 77B9 90               sub  b
 927+ 77BA 47               ld   b, a              ; B = SlopeRow
 928+ 77BB
 929+ 77BB              .check_row_match:
 930+ 77BB                  ; D (Row) deve essere uguale a SlopeRow (in B) o SlopeRow + 1 (immediatamente sotto)
 931+ 77BB 7A               ld   a, d              ; A = Row
 932+ 77BC B8               cp   b
 933+ 77BD 28 2C            jr   z, .yes           ; Row == SlopeRow
 934+ 77BF 04               inc  b                 ; B = SlopeRow + 1
 935+ 77C0 B8               cp   b
 936+ 77C1 28 28            jr   z, .yes           ; Row == SlopeRow + 1
 937+ 77C3
 938+ 77C3              .check_platform_case:
 939+ 77C3                  ; 2. Controlla se è sulla piattaforma adiacente in cima
 940+ 77C3 3A 33 E5         ld   a, (ramp_dir)
 941+ 77C6 B7               or   a
 942+ 77C7 28 09            jr   z, .plat_left
 943+ 77C9              .plat_right:
 944+ 77C9 3A 36 E5         ld   a, (ramp_col)
 945+ 77CC 21 34 E5         ld   hl, ramp_len
 946+ 77CF 86               add  a, (hl)           ; A = ramp_col + ramp_len
 947+ 77D0 18 07            jr   .compare_plat
 948+ 77D2              .plat_left:
 949+ 77D2 3A 36 E5         ld   a, (ramp_col)
 950+ 77D5 21 34 E5         ld   hl, ramp_len
 951+ 77D8 96               sub  (hl)              ; A = ramp_col - ramp_len
 952+ 77D9              .compare_plat:
 953+ 77D9 BB               cp   e                 ; Compare with Col
 954+ 77DA 20 0B            jr   nz, .no
 955+ 77DC
 956+ 77DC 3A 35 E5         ld   a, (ramp_row)
 957+ 77DF 21 34 E5         ld   hl, ramp_len
 958+ 77E2 96               sub  (hl)
 959+ 77E3 3C               inc  a                 ; A = ramp_row - ramp_len + 1
 960+ 77E4 BA               cp   d                 ; Compare with Row
 961+ 77E5 28 04            jr   z, .yes
 962+ 77E7
 963+ 77E7              .no:
 964+ 77E7 E1               pop  hl
 965+ 77E8 C1               pop  bc
 966+ 77E9 B7               or   a
 967+ 77EA C9               ret
 968+ 77EB
 969+ 77EB              .yes:

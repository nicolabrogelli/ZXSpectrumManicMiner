 242+ 7E34 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E37 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E3A CD BC 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E3D
 246+ 7E3D C1               pop  bc
 247+ 7E3E
 248+ 7E3E              .next_erase:
 249+ 7E3E 11 0B 00         ld   de, 11
 250+ 7E41 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7E43 05               dec  b
 252+ 7E44 20 B7            jr   nz, .erase_loop

1251+ 64E1 06 00            ld   b, 0                  ; B = Y iniziale (0)
1252+ 64E3              .foot_descent_loop:
1253+ 64E3 C5               push bc                    ; Salva B = Y corrente
1254+ 64E4
1255+ 64E4                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1256+ 64E4 78               ld   a, b
1257+ 64E5 B7               or   a
1258+ 64E6 28 1F            jr   z, .skip_clear_prev
1259+ 64E8 D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1260+ 64EA 47               ld   b, a

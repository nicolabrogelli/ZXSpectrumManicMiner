   7+ 8898              ; -------------------------------------------------------------------
   8+ 8898              ; Audio_UpdateJumpSound
   9+ 8898              ;
  10+ 8898              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8898              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8898              ; -------------------------------------------------------------------
  13+ 8898              Audio_UpdateJumpSound:
  14+ 8898 F5               push af
  15+ 8899 C5               push bc
  16+ 889A D5               push de
  17+ 889B E5               push hl
  18+ 889C
  19+ 889C                  ; Controlla se il suono è attivo (note < 18)
  20+ 889C 3A 24 F1         ld   a, (Audio_jump_sound_note)
  21+ 889F FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 88A1 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 88A3
  24+ 88A3                  ; Carica la nota corrente da suonare
  25+ 88A3 5F               ld   e, a
  26+ 88A4 16 00            ld   d, 0
  27+ 88A6 21 D2 88         ld   hl, Audio_JumpSoundDelays
  28+ 88A9 19               add  hl, de
  29+ 88AA 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 88AB 57               ld   d, a                      ; D = delay della nota
  31+ 88AC
  32+ 88AC                  ; Suona la nota: 15 cicli
  33+ 88AC 06 0F            ld   b, 15
  34+ 88AE              .note_loop:
  35+ 88AE                  ; Speaker ON
  36+ 88AE 3A 0F EB         ld   a, (room_border_color)
  37+ 88B1 F6 10            or   $10
  38+ 88B3 D3 FE            out  ($fe), a
  39+ 88B5 4A               ld   c, d
  40+ 88B6              .d1:
  41+ 88B6 0D               dec  c
  42+ 88B7 20 FD            jr   nz, .d1
  43+ 88B9
  44+ 88B9                  ; Speaker OFF
  45+ 88B9 3A 0F EB         ld   a, (room_border_color)
  46+ 88BC E6 EF            and  $ef
  47+ 88BE D3 FE            out  ($fe), a
  48+ 88C0 4A               ld   c, d
  49+ 88C1              .d2:
  50+ 88C1 0D               dec  c
  51+ 88C2 20 FD            jr   nz, .d2
  52+ 88C4
  53+ 88C4 10 E8            djnz .note_loop
  54+ 88C6
  55+ 88C6                  ; Passa alla nota successiva
  56+ 88C6 3A 24 F1         ld   a, (Audio_jump_sound_note)
  57+ 88C9 3C               inc  a
  58+ 88CA 32 24 F1         ld   (Audio_jump_sound_note), a
  59+ 88CD
  60+ 88CD              .done:
  61+ 88CD E1               pop  hl
  62+ 88CE D1               pop  de
  63+ 88CF C1               pop  bc
  64+ 88D0 F1               pop  af
  65+ 88D1 C9               ret
  66+ 88D2
  67+ 88D2              Audio_JumpSoundDelays:
  68+ 88D2 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 88D6 19 13 0C 06
  68+ 88DA 0C 13 19 20
  68+ 88DE 26 2D 33 3A
  68+ 88E2 40 47

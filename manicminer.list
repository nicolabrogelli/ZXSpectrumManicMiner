 142+ 850B              ; Items_DrawRoom
 143+ 850B              ;
 144+ 850B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 850B              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 850B              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 850B              ;
 148+ 850B              ; Record item nella stanza (5 byte):
 149+ 850B              ;   +0 Color / Attributo
 150+ 850B              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 850B              ;   +2 Attr Address High
 152+ 850B              ;   +3 Anim Mask (96)
 153+ 850B              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 850B              ; Fine lista: $FF
 155+ 850B              ; -------------------------------------------------------------------
 156+ 850B              Items_DrawRoom:
 157+ 850B E5               push hl
 158+ 850C D5               push de
 159+ 850D C5               push bc
 160+ 850E DD E5            push ix
 161+ 8510 FD E5            push iy

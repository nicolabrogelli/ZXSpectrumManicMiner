 356+ 7E81              ; -------------------------------------------------------------------
 357+ 7E81              ; Enemy_DrawSingleSlot
 358+ 7E81              ;
 359+ 7E81              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 360+ 7E81              ; La grafica (8 frame da 32 byte) è letta direttamente da
 361+ 7E81              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 362+ 7E81              ; -------------------------------------------------------------------
 363+ 7E81              Enemy_DrawSingleSlot:
 364+ 7E81 C5               push bc
 365+ 7E82 D5               push de
 366+ 7E83 E5               push hl
 367+ 7E84 DD E5            push ix
 368+ 7E86
 369+ 7E86                  ; 1. Salva subito le coordinate X e Y dal record IX
 370+ 7E86 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 371+ 7E89 DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 372+ 7E8C
 373+ 7E8C                  ; Controlla se è guardiano verticale
 374+ 7E8C DD 7E 00         ld   a, (ix+0)
 375+ 7E8F E6 40            and  $40                       ; Vertical?
 376+ 7E91 20 15            jr   nz, .v_frame
 377+ 7E93
 378+ 7E93                  ; Guardiano Orizzontale:
 379+ 7E93 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 380+ 7E96 E6 03            and  3
 381+ 7E98 5F               ld   e, a                      ; E = Anim subframe
 382+ 7E99
 383+ 7E99 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 384+ 7E9C FE 01            cp   1                         ; Sinistra?
 385+ 7E9E 28 03            jr   z, .left_frames
 386+ 7EA0
 387+ 7EA0                  ; Movimento a Destra: Frame 0..3
 388+ 7EA0 7B               ld   a, e
 389+ 7EA1 18 0A            jr   .got_frame_idx
 390+ 7EA3
 391+ 7EA3              .left_frames:
 392+ 7EA3                  ; Movimento a Sinistra: Frame 4..7
 393+ 7EA3 3E 04            ld   a, 4
 394+ 7EA5 83               add  a, e
 395+ 7EA6 18 05            jr   .got_frame_idx
 396+ 7EA8
 397+ 7EA8              .v_frame:
 398+ 7EA8                  ; Guardiano Verticale: usa il frame salvato in (ix+1) (4..7)
 399+ 7EA8 DD 7E 01         ld   a, (ix+1)
 400+ 7EAB E6 07            and  7
 401+ 7EAD
 402+ 7EAD              .got_frame_idx:
 403+ 7EAD                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 404+ 7EAD 6F               ld   l, a
 405+ 7EAE 26 00            ld   h, 0
 406+ 7EB0 29               add  hl, hl                    ; *2
 407+ 7EB1 29               add  hl, hl                    ; *4
 408+ 7EB2 29               add  hl, hl                    ; *8
 409+ 7EB3 29               add  hl, hl                    ; *16
 410+ 7EB4 29               add  hl, hl                    ; *32

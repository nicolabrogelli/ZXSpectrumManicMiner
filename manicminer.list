   8+ 869E              ; Audio_UpdateJumpSound
   9+ 869E              ;
  10+ 869E              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 869E              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 869E              ; -------------------------------------------------------------------
  13+ 869E              Audio_UpdateJumpSound:
  14+ 869E F5               push af
  15+ 869F C5               push bc
  16+ 86A0 D5               push de
  17+ 86A1 E5               push hl
  18+ 86A2
  19+ 86A2                  ; Controlla se il suono è attivo (note < 18)
  20+ 86A2 3A C8 E7         ld   a, (Audio_jump_sound_note)
  21+ 86A5 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86A7 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86A9
  24+ 86A9                  ; Carica la nota corrente da suonare
  25+ 86A9 5F               ld   e, a
  26+ 86AA 16 00            ld   d, 0
  27+ 86AC 21 D8 86         ld   hl, Audio_JumpSoundDelays
  28+ 86AF 19               add  hl, de
  29+ 86B0 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86B1 57               ld   d, a                      ; D = delay della nota
  31+ 86B2
  32+ 86B2                  ; Suona la nota: 15 cicli
  33+ 86B2 06 0F            ld   b, 15
  34+ 86B4              .note_loop:
  35+ 86B4                  ; Speaker ON
  36+ 86B4 3A B5 E1         ld   a, (room_border_color)
  37+ 86B7 F6 10            or   $10
  38+ 86B9 D3 FE            out  ($fe), a
  39+ 86BB 4A               ld   c, d
  40+ 86BC              .d1:
  41+ 86BC 0D               dec  c
  42+ 86BD 20 FD            jr   nz, .d1
  43+ 86BF
  44+ 86BF                  ; Speaker OFF
  45+ 86BF 3A B5 E1         ld   a, (room_border_color)
  46+ 86C2 E6 EF            and  $ef
  47+ 86C4 D3 FE            out  ($fe), a
  48+ 86C6 4A               ld   c, d
  49+ 86C7              .d2:
  50+ 86C7 0D               dec  c
  51+ 86C8 20 FD            jr   nz, .d2
  52+ 86CA
  53+ 86CA 10 E8            djnz .note_loop
  54+ 86CC
  55+ 86CC                  ; Passa alla nota successiva
  56+ 86CC 3A C8 E7         ld   a, (Audio_jump_sound_note)
  57+ 86CF 3C               inc  a
  58+ 86D0 32 C8 E7         ld   (Audio_jump_sound_note), a

 660+ 811A              ; Score_CheckAndUpdateHighScore
 661+ 811A              ; Se player_score > high_score, copia player_score in high_score.
 662+ 811A              ; -------------------------------------------------------------------
 663+ 811A              Score_CheckAndUpdateHighScore:
 664+ 811A                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 811A                  ; Byte 2:
 666+ 811A 3A 7C 9A         ld   a, (player_score + 2)
 667+ 811D 47               ld   b, a
 668+ 811E 3A 7F 9A         ld   a, (high_score + 2)
 669+ 8121 B8               cp   b
 670+ 8122 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 8124 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 8126
 673+ 8126                  ; Byte 1:
 674+ 8126 3A 7B 9A         ld   a, (player_score + 1)
 675+ 8129 47               ld   b, a
 676+ 812A 3A 7E 9A         ld   a, (high_score + 1)
 677+ 812D B8               cp   b
 678+ 812E 38 0C            jr   c, .new_high_score
 679+ 8130 20 1C            jr   nz, .done_check
 680+ 8132
 681+ 8132                  ; Byte 0:
 682+ 8132 3A 7A 9A         ld   a, (player_score + 0)
 683+ 8135 47               ld   b, a
 684+ 8136 3A 7D 9A         ld   a, (high_score + 0)
 685+ 8139 B8               cp   b
 686+ 813A 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 813C
 688+ 813C              .new_high_score:
 689+ 813C 3A 7A 9A         ld   a, (player_score + 0)
 690+ 813F 32 7D 9A         ld   (high_score + 0), a
 691+ 8142 3A 7B 9A         ld   a, (player_score + 1)
 692+ 8145 32 7E 9A         ld   (high_score + 1), a
 693+ 8148 3A 7C 9A         ld   a, (player_score + 2)
 694+ 814B 32 7F 9A         ld   (high_score + 2), a
 695+ 814E
 696+ 814E              .done_check:
 697+ 814E C9               ret

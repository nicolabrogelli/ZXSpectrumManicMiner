 817  856B              ; CheckWillyConveyorCollision
 818  856B              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 819  856B              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 820  856B              ; -------------------------------------------------------------------
 821  856B              CheckWillyConveyorCollision:
 822  856B C5               push bc
 823  856C D5               push de
 824  856D E5               push hl
 825  856E
 826  856E                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 827  856E CD FA 75         call CheckWillyOnConveyor
 828  8571 38 49            jr   c, .collision_detected
 829  8573
 830  8573                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 831  8573 3A 93 97         ld   a, (conveyor_len)
 832  8576 B7               or   a
 833  8577 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 834  8579
 835  8579                  ; B = WillyY, C = WillyX
 836  8579 ED 4B 6B 94      ld   bc, (PlayerPos)
 837  857D
 838  857D                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 839  857D 3A 94 97         ld   a, (conveyor_row)
 840  8580 87               add  a, a                  ; *2
 841  8581 87               add  a, a                  ; *4
 842  8582 87               add  a, a                  ; *8
 843  8583 5F               ld   e, a                  ; E = ConveyorTop
 844  8584 C6 07            add  a, 7
 845  8586 57               ld   d, a                  ; D = ConveyorBottom
 846  8587
 847  8587                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 848  8587 78               ld   a, b                  ; WillyTop
 849  8588 BA               cp   d
 850  8589 28 04            jr   z, .y_overlap
 851  858B 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 852  858D 18 32            jr   .no_conv_collision
 853  858F
 854  858F              .y_overlap:
 855  858F C6 0F            add  a, 15                 ; WillyBottom
 856  8591 BB               cp   e
 857  8592 28 04            jr   z, .x_check
 858  8594 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 859  8596 18 29            jr   .no_conv_collision
 860  8598
 861  8598              .x_check:
 862  8598                  ; ConveyorLeft = conveyor_col * 8
 863  8598 3A 95 97         ld   a, (conveyor_col)
 864  859B 87               add  a, a                  ; *2
 865  859C 87               add  a, a                  ; *4
 866  859D 87               add  a, a                  ; *8
 867  859E 5F               ld   e, a                  ; E = ConveyorLeft
 868  859F
 869  859F                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 870  859F 21 93 97         ld   hl, conveyor_len
 871  85A2 3A 95 97         ld   a, (conveyor_col)
 872  85A5 86               add  a, (hl)
 873  85A6 87               add  a, a                  ; *2
 874  85A7 87               add  a, a                  ; *4
 875  85A8 87               add  a, a                  ; *8
 876  85A9 3D               dec  a                     ; ConveyorRight
 877  85AA 57               ld   d, a                  ; D = ConveyorRight
 878  85AB
 879  85AB                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 880  85AB 79               ld   a, c                  ; WillyLeft
 881  85AC BA               cp   d
 882  85AD 28 04            jr   z, .x_overlap
 883  85AF 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 884  85B1 18 0E            jr   .no_conv_collision
 885  85B3
 886  85B3              .x_overlap:
 887  85B3 C6 0F            add  a, 15                 ; WillyRight
 888  85B5 BB               cp   e
 889  85B6 28 04            jr   z, .collision_detected
 890  85B8 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 891  85BA 18 05            jr   .no_conv_collision

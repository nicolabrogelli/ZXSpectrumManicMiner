 907  832B CD 2F 6D         call InitRoomEntryPositions
 908  832E
 909  832E                  ; Ripristina l'orologio di gioco alle 07:00 AM ed azzera i tick hardware
 910  832E 3E 07            ld   a, 7
 911  8330 32 F9 91         ld   (time_hours), a
 912  8333 AF               xor  a
 913  8334 32 FA 91         ld   (time_minutes), a
 914  8337 32 FB 91         ld   (time_period), a       ; 0 = AM
 915  833A 32 FE 91         ld   (game_objective_completed), a

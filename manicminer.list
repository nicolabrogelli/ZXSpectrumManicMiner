 321  8AAB 16 00            ld   d, 0
 322  8AAD 21 72 64         ld   hl, title_color_table
 323  8AB0 19               add  hl, de
 324  8AB1 7E               ld   a, (hl)               ; A = nuovo colore
 325  8AB2 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 326  8AB5 06 20            ld   b, 32

 810  87DA              ; -------------------------------------------------------------------
 811  87DA              ; CheckWillyConveyorCollision
 812  87DA              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  87DA              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  87DA              ; -------------------------------------------------------------------
 815  87DA              CheckWillyConveyorCollision:
 816  87DA C5               push bc
 817  87DB D5               push de
 818  87DC E5               push hl
 819  87DD
 820  87DD                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  87DD CD B9 76         call CheckWillyOnConveyor
 822  87E0 38 49            jr   c, .collision_detected
 823  87E2
 824  87E2                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  87E2 3A F7 BD         ld   a, (conveyor_len)
 826  87E5 B7               or   a
 827  87E6 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  87E8
 829  87E8                  ; B = WillyY, C = WillyX
 830  87E8 ED 4B CF BA      ld   bc, (PlayerPos)
 831  87EC
 832  87EC                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  87EC 3A F8 BD         ld   a, (conveyor_row)
 834  87EF 87               add  a, a                  ; *2
 835  87F0 87               add  a, a                  ; *4
 836  87F1 87               add  a, a                  ; *8
 837  87F2 5F               ld   e, a                  ; E = ConveyorTop
 838  87F3 C6 07            add  a, 7
 839  87F5 57               ld   d, a                  ; D = ConveyorBottom
 840  87F6
 841  87F6                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  87F6 78               ld   a, b                  ; WillyTop
 843  87F7 BA               cp   d
 844  87F8 28 04            jr   z, .y_overlap
 845  87FA 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  87FC 18 32            jr   .no_conv_collision
 847  87FE
 848  87FE              .y_overlap:
 849  87FE C6 0F            add  a, 15                 ; WillyBottom
 850  8800 BB               cp   e
 851  8801 28 04            jr   z, .x_check
 852  8803 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  8805 18 29            jr   .no_conv_collision
 854  8807
 855  8807              .x_check:
 856  8807                  ; ConveyorLeft = conveyor_col * 8
 857  8807 3A F9 BD         ld   a, (conveyor_col)
 858  880A 87               add  a, a                  ; *2
 859  880B 87               add  a, a                  ; *4
 860  880C 87               add  a, a                  ; *8
 861  880D 5F               ld   e, a                  ; E = ConveyorLeft
 862  880E
 863  880E                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  880E 21 F7 BD         ld   hl, conveyor_len
 865  8811 3A F9 BD         ld   a, (conveyor_col)
 866  8814 86               add  a, (hl)
 867  8815 87               add  a, a                  ; *2
 868  8816 87               add  a, a                  ; *4
 869  8817 87               add  a, a                  ; *8
 870  8818 3D               dec  a                     ; ConveyorRight
 871  8819 57               ld   d, a                  ; D = ConveyorRight
 872  881A
 873  881A                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  881A 79               ld   a, c                  ; WillyLeft
 875  881B BA               cp   d
 876  881C 28 04            jr   z, .x_overlap
 877  881E 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  8820 18 0E            jr   .no_conv_collision
 879  8822
 880  8822              .x_overlap:
 881  8822 C6 0F            add  a, 15                 ; WillyRight
 882  8824 BB               cp   e
 883  8825 28 04            jr   z, .collision_detected
 884  8827 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  8829 18 05            jr   .no_conv_collision
 886  882B
 887  882B              .collision_detected:
 888  882B E1               pop  hl
 889  882C D1               pop  de
 890  882D C1               pop  bc
 891  882E 37               scf

 288  859F              ; ShowTitleScreen
 289  859F              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  859F              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  859F              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  859F              ; -------------------------------------------------------------------
 293  859F              ShowTitleScreen:
 294  859F                  ; 1. Disegna la schermata iniziale
 295  859F CD 76 64         call Gfx_DrawTitleScreen
 296  85A2
 297  85A2                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  85A2              .wait_title_enter_release:
 299  85A2 76               halt
 300  85A3 3E BF            ld   a, $bf
 301  85A5 DB FE            in   a, ($fe)
 302  85A7 1F               rra
 303  85A8 30 F8            jr   nc, .wait_title_enter_release
 304  85AA
 305  85AA                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  85AA 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  85AC              .title_loop:
 308  85AC 76               halt
 309  85AD
 310  85AD                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  85AD 0C               inc  c
 312  85AE 79               ld   a, c
 313  85AF CB 3F            srl  a
 314  85B1 CB 3F            srl  a
 315  85B3 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85B5 E6 07            and  7
 317  85B7 5F               ld   e, a
 318  85B8 16 00            ld   d, 0
 319  85BA 21 6E 64         ld   hl, title_color_table
 320  85BD 19               add  hl, de
 321  85BE 7E               ld   a, (hl)               ; A = nuovo colore
 322  85BF 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85C2 06 20            ld   b, 32
 324  85C4              .color_title_loop:
 325  85C4 77               ld   (hl), a
 326  85C5 23               inc  hl
 327  85C6 10 FC            djnz .color_title_loop
 328  85C8
 329  85C8                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85C8 3E BF            ld   a, $bf
 331  85CA DB FE            in   a, ($fe)
 332  85CC 1F               rra
 333  85CD 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  85CF
 335  85CF                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  85CF              .wait_title_enter_release_after:
 337  85CF 76               halt
 338  85D0 3E BF            ld   a, $bf
 339  85D2 DB FE            in   a, ($fe)
 340  85D4 1F               rra

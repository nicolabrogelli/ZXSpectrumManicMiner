1763+ 7B3D 47               ld   b, a
1764+ 7B3E CD DB 7A         call CheckNastyCell
1765+ 7B41 38 0C            jr   c, .collision
1766+ 7B43
1767+ 7B43                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1768+ 7B43 79               ld   a, c
1769+ 7B44 C6 07            add  a, 7
1770+ 7B46 4F               ld   c, a
1771+ 7B47 CD DB 7A         call CheckNastyCell
1772+ 7B4A 38 03            jr   c, .collision
1773+ 7B4C
1774+ 7B4C C1               pop  bc
1775+ 7B4D B7               or   a                 ; Clear carry
1776+ 7B4E C9               ret
1777+ 7B4F

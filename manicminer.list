1163+ 78C1              ; -------------------------------------------------------------------
1164+ 78C1              ; Legge il tipo di cella dal buffer decompresso in RAM
1165+ 78C1              ; Input: A = Row (0..15), C = Col (0..31)
1166+ 78C1              ; Output: A = tipo di cella (0..3)
1167+ 78C1              ; Preserva tutti gli altri registri.
1168+ 78C1              ; -------------------------------------------------------------------
1169+ 78C1              GetCellFromUnpacked:
1170+ 78C1 E5               push hl
1171+ 78C2 D5               push de
1172+ 78C3
1173+ 78C3 6F               ld   l, a
1174+ 78C4 26 00            ld   h, 0
1175+ 78C6 29               add  hl, hl
1176+ 78C7 29               add  hl, hl

 157+ 7E1C FD E5            push iy
 158+ 7E1E
 159+ 7E1E                  ; 1. Azzera items_grid (512 byte)
 160+ 7E1E 21 89 91         ld   hl, items_grid
 161+ 7E21 11 8A 91         ld   de, items_grid + 1
 162+ 7E24 36 00            ld   (hl), 0
 163+ 7E26 01 FF 01         ld   bc, 511
 164+ 7E29 ED B0            ldir
 165+ 7E2B
 166+ 7E2B                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 7E2B AF               xor  a
 168+ 7E2C 32 08 97         ld   (num_room_items), a
 169+ 7E2F
 170+ 7E2F FD 21 B8 96      ld   iy, current_room_items
 171+ 7E33
 172+ 7E33                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 7E33 2A 09 97         ld   hl, (room_ptr)
 174+ 7E36 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 7E39 19               add  hl, de
 176+ 7E3A E5               push hl
 177+ 7E3B DD E1            pop  ix                        ; IX = bitmap item
 178+ 7E3D
 179+ 7E3D                  ; 4. HL = Inizio lista item nella stanza
 180+ 7E3D 2A 09 97         ld   hl, (room_ptr)
 181+ 7E40 11 75 02         ld   de, OFFSET_ITEMS
 182+ 7E43 19               add  hl, de
 183+ 7E44
 184+ 7E44              .loop:
 185+ 7E44 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 7E45 FE FF            cp   $FF
 187+ 7E47 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 7E49
 189+ 7E49 5F               ld   e, a                      ; E = Color
 190+ 7E4A 23               inc  hl
 191+ 7E4B 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 7E4C 23               inc  hl
 193+ 7E4D 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 7E4E 23               inc  hl                        ; Salta Anim Byte
 195+ 7E4F 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 7E50
 197+ 7E50 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 7E51 FE FF            cp   $FF
 199+ 7E53 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 7E55
 201+ 7E55                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 7E55 E5               push hl

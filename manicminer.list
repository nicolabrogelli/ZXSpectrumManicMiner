  76+ 7C82 23               inc  hl
  77+ 7C83 E5               push hl
  78+ 7C84
  79+ 7C84                  ; DE = room_ptr
  80+ 7C84 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7C87 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7C88
  83+ 7C88              .item_loop:

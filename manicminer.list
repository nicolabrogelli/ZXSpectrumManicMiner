 822  8709              ; CheckWillyConveyorCollision
 823  8709              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 824  8709              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 825  8709              ; -------------------------------------------------------------------
 826  8709              CheckWillyConveyorCollision:
 827  8709 C5               push bc
 828  870A D5               push de
 829  870B E5               push hl
 830  870C
 831  870C                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 832  870C CD 6A 77         call CheckWillyOnConveyor
 833  870F 38 49            jr   c, .collision_detected
 834  8711
 835  8711                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 836  8711 3A 31 99         ld   a, (conveyor_len)
 837  8714 B7               or   a
 838  8715 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 839  8717
 840  8717                  ; B = WillyY, C = WillyX
 841  8717 ED 4B 09 96      ld   bc, (PlayerPos)
 842  871B
 843  871B                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 844  871B 3A 32 99         ld   a, (conveyor_row)
 845  871E 87               add  a, a                  ; *2
 846  871F 87               add  a, a                  ; *4
 847  8720 87               add  a, a                  ; *8
 848  8721 5F               ld   e, a                  ; E = ConveyorTop
 849  8722 C6 07            add  a, 7
 850  8724 57               ld   d, a                  ; D = ConveyorBottom
 851  8725
 852  8725                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 853  8725 78               ld   a, b                  ; WillyTop
 854  8726 BA               cp   d
 855  8727 28 04            jr   z, .y_overlap
 856  8729 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 857  872B 18 32            jr   .no_conv_collision
 858  872D
 859  872D              .y_overlap:
 860  872D C6 0F            add  a, 15                 ; WillyBottom
 861  872F BB               cp   e
 862  8730 28 04            jr   z, .x_check
 863  8732 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 864  8734 18 29            jr   .no_conv_collision
 865  8736
 866  8736              .x_check:
 867  8736                  ; ConveyorLeft = conveyor_col * 8
 868  8736 3A 33 99         ld   a, (conveyor_col)
 869  8739 87               add  a, a                  ; *2
 870  873A 87               add  a, a                  ; *4
 871  873B 87               add  a, a                  ; *8
 872  873C 5F               ld   e, a                  ; E = ConveyorLeft
 873  873D
 874  873D                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 875  873D 21 31 99         ld   hl, conveyor_len
 876  8740 3A 33 99         ld   a, (conveyor_col)
 877  8743 86               add  a, (hl)
 878  8744 87               add  a, a                  ; *2
 879  8745 87               add  a, a                  ; *4
 880  8746 87               add  a, a                  ; *8
 881  8747 3D               dec  a                     ; ConveyorRight
 882  8748 57               ld   d, a                  ; D = ConveyorRight
 883  8749
 884  8749                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 885  8749 79               ld   a, c                  ; WillyLeft
 886  874A BA               cp   d
 887  874B 28 04            jr   z, .x_overlap
 888  874D 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 889  874F 18 0E            jr   .no_conv_collision
 890  8751
 891  8751              .x_overlap:
 892  8751 C6 0F            add  a, 15                 ; WillyRight
 893  8753 BB               cp   e
 894  8754 28 04            jr   z, .collision_detected
 895  8756 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 896  8758 18 05            jr   .no_conv_collision

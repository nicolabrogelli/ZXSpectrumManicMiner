 288  8893              ; -------------------------------------------------------------------
 289  8893              ; ShowTitleScreen
 290  8893              ; Visualizza la schermata iniziale del gioco (Title Screen).
 291  8893              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 292  8893              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 293  8893              ; -------------------------------------------------------------------
 294  8893              ShowTitleScreen:
 295  8893                  ; 1. Disegna la schermata iniziale
 296  8893 CD 76 64         call Gfx_DrawTitleScreen
 297  8896
 298  8896                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 299  8896              .wait_title_enter_release:
 300  8896 76               halt
 301  8897 3E BF            ld   a, $bf
 302  8899 DB FE            in   a, ($fe)
 303  889B 1F               rra
 304  889C 30 F8            jr   nc, .wait_title_enter_release
 305  889E
 306  889E                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 307  889E 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 308  88A0              .title_loop:
 309  88A0 76               halt
 310  88A1
 311  88A1                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 312  88A1 0C               inc  c
 313  88A2 79               ld   a, c
 314  88A3 CB 3F            srl  a
 315  88A5 CB 3F            srl  a
 316  88A7 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 317  88A9 E6 07            and  7
 318  88AB 5F               ld   e, a
 319  88AC 16 00            ld   d, 0
 320  88AE 21 6E 64         ld   hl, title_color_table
 321  88B1 19               add  hl, de
 322  88B2 7E               ld   a, (hl)               ; A = nuovo colore
 323  88B3 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 324  88B6 06 20            ld   b, 32
 325  88B8              .color_title_loop:
 326  88B8 77               ld   (hl), a
 327  88B9 23               inc  hl
 328  88BA 10 FC            djnz .color_title_loop
 329  88BC
 330  88BC                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 331  88BC 3E BF            ld   a, $bf
 332  88BE DB FE            in   a, ($fe)
 333  88C0 1F               rra
 334  88C1 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 335  88C3
 336  88C3                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 337  88C3              .wait_title_enter_release_after:

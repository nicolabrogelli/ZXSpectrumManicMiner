  72+ 8009 ~            ; Audio_UpdateMusic
  73+ 8009 ~            ;
  74+ 8009 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8009 ~            ; Viene chiamata a ogni frame.
  76+ 8009 ~            ; -------------------------------------------------------------------
  77+ 8009 ~            Audio_UpdateMusic:
  78+ 8009 ~                push af
  79+ 8009 ~                push bc
  80+ 8009 ~                push de
  81+ 8009 ~                push hl
  82+ 8009 ~
  83+ 8009 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8009 ~                ld   a, (Audio_jump_sound_note)
  85+ 8009 ~                cp   18
  86+ 8009 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8009 ~
  88+ 8009 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8009 ~                ld   a, (Audio_music_frame_counter)
  90+ 8009 ~                dec  a
  91+ 8009 ~                ld   (Audio_music_frame_counter), a
  92+ 8009 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8009 ~
  94+ 8009 ~                ; Altrimenti carica la nota successiva
  95+ 8009 ~                ld   a, (Audio_music_note_idx)
  96+ 8009 ~                inc  a
  97+ 8009 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8009 ~                jr   c, .no_wrap
  99+ 8009 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8009 ~            .no_wrap:
 101+ 8009 ~                ld   (Audio_music_note_idx), a
 102+ 8009 ~
 103+ 8009 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8009 ~                ld   e, a
 105+ 8009 ~                ld   d, 0
 106+ 8009 ~                ld   hl, Audio_MusicSheet
 107+ 8009 ~                add  hl, de
 108+ 8009 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8009 ~
 110+ 8009 ~                ; Leggi durata (secondo byte)
 111+ 8009 ~                inc  hl
 112+ 8009 ~                ld   a, (hl)
 113+ 8009 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8009 ~                jr   nz, .dur_ok
 115+ 8009 ~                ld   a, 1
 116+ 8009 ~            .dur_ok:
 117+ 8009 ~                ld   (Audio_music_frame_counter), a
 118+ 8009 ~
 119+ 8009 ~            .play_current_note:
 120+ 8009 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8009 ~                ld   a, (Audio_music_note_idx)
 122+ 8009 ~                ld   e, a
 123+ 8009 ~                ld   d, 0
 124+ 8009 ~                ld   hl, Audio_MusicSheet
 125+ 8009 ~                add  hl, de
 126+ 8009 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8009 ~                ld   a, (hl)                  ; A = delay
 128+ 8009 ~                or   a
 129+ 8009 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8009 ~
 131+ 8009 ~                ; Suona la nota: 2 cicli
 132+ 8009 ~                ld   d, a                     ; D = delay
 133+ 8009 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8009 ~            .note_loop:
 135+ 8009 ~                ; Speaker ON
 136+ 8009 ~                ld   a, (room_border_color)
 137+ 8009 ~                or   $10
 138+ 8009 ~                out  ($fe), a
 139+ 8009 ~                ld   c, d
 140+ 8009 ~            .d1:
 141+ 8009 ~                push af
 142+ 8009 ~                pop  af
 143+ 8009 ~                dec  c
 144+ 8009 ~                jr   nz, .d1
 145+ 8009 ~
 146+ 8009 ~                ; Speaker OFF
 147+ 8009 ~                ld   a, (room_border_color)
 148+ 8009 ~                and  $ef
 149+ 8009 ~                out  ($fe), a
 150+ 8009 ~                ld   c, d
 151+ 8009 ~            .d2:
 152+ 8009 ~                push af
 153+ 8009 ~                pop  af
 154+ 8009 ~                dec  c
 155+ 8009 ~                jr   nz, .d2
 156+ 8009 ~
 157+ 8009 ~                djnz .note_loop
 158+ 8009 ~
 159+ 8009 ~            .done:
 160+ 8009 ~                pop  hl
 161+ 8009 ~                pop  de
 162+ 8009 ~                pop  bc
 163+ 8009 ~                pop  af
 164+ 8009 ~                ret
 165+ 8009 ~
 166+ 8009 ~            Audio_MusicSheet:
 167+ 8009 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8009 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8009 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8009 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8009 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8009 ~                db 90, 10, 107, 20, 68, 65
 173+ 8009                  ELSE
 174+ 8009              Audio_UpdateMusic:
 175+ 8009 C9               ret
 176+ 800A                  ENDIF

 408+ 7F35              ; CheckWillyItemCollision
 409+ 7F35              ;
 410+ 7F35              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 7F35              ; Input:
 412+ 7F35              ;   A = Item Col (0..31)
 413+ 7F35              ;   H = Item Row (0..15)
 414+ 7F35              ; Output:
 415+ 7F35              ;   Carry Set = Collisione
 416+ 7F35              ;   Carry Clear = Nessuna collisione
 417+ 7F35              ; -------------------------------------------------------------------
 418+ 7F35              CheckWillyItemCollision:
 419+ 7F35 C5               push bc
 420+ 7F36 D5               push de
 421+ 7F37 E5               push hl
 422+ 7F38
 423+ 7F38                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 7F38 6F               ld   l, a
 425+ 7F39 87               add  a, a                      ; *2
 426+ 7F3A 87               add  a, a                      ; *4
 427+ 7F3B 87               add  a, a                      ; *8
 428+ 7F3C 5F               ld   e, a                      ; E = ItemLeft
 429+ 7F3D C6 07            add  a, 7
 430+ 7F3F 57               ld   d, a                      ; D = ItemRight
 431+ 7F40
 432+ 7F40 ED 4B 89 93      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 7F44
 434+ 7F44                  ; WillyLeft <= ItemRight
 435+ 7F44 79               ld   a, c                      ; A = WillyX
 436+ 7F45 BA               cp   d                         ; D = ItemRight
 437+ 7F46 28 04            jr   z, .x_ok
 438+ 7F48 38 02            jr   c, .x_ok
 439+ 7F4A 18 31            jr   .no_collision
 440+ 7F4C
 441+ 7F4C              .x_ok:
 442+ 7F4C                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 7F4C BB               cp   e                         ; E = ItemLeft
 444+ 7F4D 28 0B            jr   z, .y_check
 445+ 7F4F 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 7F51
 447+ 7F51                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 7F51 C6 0F            add  a, 15
 449+ 7F53 BB               cp   e
 450+ 7F54 28 04            jr   z, .y_check
 451+ 7F56 30 02            jr   nc, .y_check
 452+ 7F58 18 23            jr   .no_collision
 453+ 7F5A
 454+ 7F5A              .y_check:
 455+ 7F5A                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 7F5A 7C               ld   a, h                      ; H = Item Row
 457+ 7F5B 87               add  a, a                      ; *2
 458+ 7F5C 87               add  a, a                      ; *4
 459+ 7F5D 87               add  a, a                      ; *8
 460+ 7F5E 5F               ld   e, a                      ; E = ItemTop
 461+ 7F5F C6 07            add  a, 7
 462+ 7F61 57               ld   d, a                      ; D = ItemBottom
 463+ 7F62
 464+ 7F62                  ; WillyTop <= ItemBottom
 465+ 7F62 78               ld   a, b                      ; A = WillyY
 466+ 7F63 BA               cp   d                         ; D = ItemBottom
 467+ 7F64 28 04            jr   z, .y_ok
 468+ 7F66 38 02            jr   c, .y_ok
 469+ 7F68 18 13            jr   .no_collision
 470+ 7F6A
 471+ 7F6A              .y_ok:
 472+ 7F6A                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 7F6A BB               cp   e                         ; E = ItemTop
 474+ 7F6B 28 0B            jr   z, .collision
 475+ 7F6D 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 7F6F
 477+ 7F6F                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 7F6F C6 0F            add  a, 15
 479+ 7F71 BB               cp   e

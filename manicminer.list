 169+ 7B86                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7B86 3A 76 93         ld   a, (player_drawn_pos)
 171+ 7B89 E6 F8            and  $F8
 172+ 7B8B 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7B8C 79               ld   a, c
 174+ 7B8D E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7B8F 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7B90 C6 10            add  a, 16
 177+ 7B92 FE 19            cp   25
 178+ 7B94 D0               ret  nc                 ; Fuori portata X
 179+ 7B95
 180+ 7B95                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7B95 3A 77 93         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7B98 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7B99 C6 0F            add  a, 15

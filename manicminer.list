1000+ 7438 4F               ld   c, a              ; C = limit_right (exclusive)
1001+ 7439
1002+ 7439 7B               ld   a, e              ; A = Col
1003+ 743A B8               cp   b
1004+ 743B 38 34            jr   c, .check_platform_case ; Col < ramp_col
1005+ 743D B9               cp   c
1006+ 743E 30 31            jr   nc, .check_platform_case ; Col >= limit_right

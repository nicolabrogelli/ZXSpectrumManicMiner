 103+ 89A6 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 89A6 ~                ld   e, a
 105+ 89A6 ~                ld   d, 0
 106+ 89A6 ~                ld   hl, Audio_MusicSheet
 107+ 89A6 ~                add  hl, de
 108+ 89A6 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 89A6 ~
 110+ 89A6 ~                ; Leggi durata (secondo byte)
 111+ 89A6 ~                inc  hl
 112+ 89A6 ~                ld   a, (hl)

1269+ 7559              ; -------------------------------------------------------------------
1270+ 7559              ; Legge il tipo di cella dal buffer decompresso in RAM
1271+ 7559              ; Input: A = Row (0..15), C = Col (0..31)
1272+ 7559              ; Output: A = tipo di cella (0..3)
1273+ 7559              ; Preserva tutti gli altri registri.
1274+ 7559              ; -------------------------------------------------------------------
1275+ 7559              GetCellFromUnpacked:
1276+ 7559 E5               push hl
1277+ 755A D5               push de
1278+ 755B
1279+ 755B 6F               ld   l, a
1280+ 755C 26 00            ld   h, 0
1281+ 755E 29               add  hl, hl
1282+ 755F 29               add  hl, hl
1283+ 7560 29               add  hl, hl
1284+ 7561 29               add  hl, hl
1285+ 7562 29               add  hl, hl            ; HL = Row * 32
1286+ 7563 59               ld   e, c
1287+ 7564 16 00            ld   d, 0
1288+ 7566 19               add  hl, de            ; HL = Row * 32 + Col
1289+ 7567 11 CD 8E         ld   de, unpacked_layout
1290+ 756A 19               add  hl, de

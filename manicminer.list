 507  896A ~                ld   a, 1
 508  896A ~                ld   (Audio_music_frame_counter), a
 509  896A                  ENDIF
 510  896A
 511  896A                  ; - Riposiziona Willy nel punto di default definito nella stanza
 512  896A AF               xor  a
 513  896B 32 11 E5         ld   (transition_active), a
 514  896E
 515  896E                  ; - Cancella lo schermo a nero prima del caricamento
 516  896E AF               xor  a
 517  896F D3 FE            out  ($fe), a
 518  8971 CD 9D 62         call Gfx_ClearScreenDirect
 519  8974
 520  8974                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 521  8974 C3 12 87         jp   LoadRoomAndRestart
 522  8977
 523  8977              ; -------------------------------------------------------------------
 524  8977              ; TriggerVictory
 525  8977              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 526  8977              ; - Pulisce gli elementi di gioco della stanza.
 527  8977              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 528  8977              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 529  8977              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 530  8977              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 531  8977              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 532  8977              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 533  8977              ; -------------------------------------------------------------------
 534  8977              TriggerVictory:
 535  8977                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 536  8977 CD F7 66         call Gfx_DrawVictoryScreen
 537  897A
 538  897A                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 539  897A              .wait_keys_release:
 540  897A 76               halt
 541  897B                  ; Controlla tasto Y (Porta $DF, bit 4)
 542  897B 01 FE DF         ld   bc, $dffe
 543  897E ED 78            in   a, (c)
 544  8980 CB 67            bit  4, a
 545  8982 28 F6            jr   z, .wait_keys_release
 546  8984
 547  8984                  ; Controlla tasto N (Porta $7F, bit 3)
 548  8984 01 FE 7F         ld   bc, $7ffe
 549  8987 ED 78            in   a, (c)
 550  8989 CB 5F            bit  3, a
 551  898B 28 ED            jr   z, .wait_keys_release
 552  898D
 553  898D                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 554  898D 01 FE BF         ld   bc, $bffe
 555  8990 ED 78            in   a, (c)
 556  8992 CB 47            bit  0, a
 557  8994 28 E4            jr   z, .wait_keys_release
 558  8996
 559  8996                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 560  8996 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 561  8998              .wait_choice_loop:
 562  8998 76               halt
 563  8999
 564  8999                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 565  8999 0C               inc  c
 566  899A 79               ld   a, c
 567  899B CB 3F            srl  a
 568  899D CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 569  899F E6 07            and  7
 570  89A1 5F               ld   e, a
 571  89A2 16 00            ld   d, 0
 572  89A4 21 11 66         ld   hl, victory_color_table
 573  89A7 19               add  hl, de
 574  89A8 7E               ld   a, (hl)               ; A = nuovo colore attributo
 575  89A9 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 576  89AC 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 577  89AE              .color_cycle_loop:
 578  89AE 77               ld   (hl), a
 579  89AF 23               inc  hl
 580  89B0 10 FC            djnz .color_cycle_loop
 581  89B2
 582  89B2                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 583  89B2 01 FE DF         ld   bc, $dffe
 584  89B5 ED 78            in   a, (c)
 585  89B7 CB 67            bit  4, a
 586  89B9 28 2A            jr   z, .play_again_chosen
 587  89BB
 588  89BB                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 589  89BB 01 FE 7F         ld   bc, $7ffe
 590  89BE ED 78            in   a, (c)
 591  89C0 CB 5F            bit  3, a
 592  89C2 28 0B            jr   z, .quit_chosen
 593  89C4
 594  89C4                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 595  89C4 01 FE BF         ld   bc, $bffe
 596  89C7 ED 78            in   a, (c)
 597  89C9 CB 47            bit  0, a
 598  89CB 28 02            jr   z, .quit_chosen
 599  89CD
 600  89CD 18 C9            jr   .wait_choice_loop
 601  89CF
 602  89CF              .quit_chosen:
 603  89CF                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 604  89CF              .wait_quit_release:
 605  89CF 76               halt
 606  89D0 01 FE 7F         ld   bc, $7ffe
 607  89D3 ED 78            in   a, (c)
 608  89D5 CB 5F            bit  3, a
 609  89D7 28 F6            jr   z, .wait_quit_release
 610  89D9 01 FE BF         ld   bc, $bffe
 611  89DC ED 78            in   a, (c)
 612  89DE CB 47            bit  0, a
 613  89E0 28 ED            jr   z, .wait_quit_release
 614  89E2
 615  89E2                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 616  89E2 C3 4B 88         jp   ShowTitleScreen
 617  89E5
 618  89E5              .play_again_chosen:
 619  89E5                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 620  89E5              .wait_play_again_release:
 621  89E5 76               halt
 622  89E6 01 FE DF         ld   bc, $dffe
 623  89E9 ED 78            in   a, (c)
 624  89EB CB 67            bit  4, a
 625  89ED 28 F6            jr   z, .wait_play_again_release
 626  89EF
 627  89EF                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 628  89EF CD F0 8A         call ResetFullGameState
 629  89F2 C3 12 87         jp   LoadRoomAndRestart
 630  89F5
 631  89F5              ; -------------------------------------------------------------------
 632  89F5              ; CheckPortalTransition
 633  89F5              ; Verifica le condizioni per accedere alla stanza successiva:
 634  89F5              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 635  89F5              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 636  89F5              ;
 637  89F5              ; Output:
 638  89F5              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 639  89F5              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 640  89F5              ; -------------------------------------------------------------------
 641  89F5              CheckPortalTransition:
 642  89F5 C5               push bc
 643  89F6 D5               push de
 644  89F7 E5               push hl
 645  89F8
 646  89F8                  ; 1. Tutti gli item della stanza sono stati raccolti?
 647  89F8 CD 83 8A         call CheckAllItemsCollected
 648  89FB 30 4D            jr   nc, .no_transition
 649  89FD
 650  89FD                  ; 2. Willy collide con il portale (16x16 pixel)?
 651  89FD                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 652  89FD                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 653  89FD 2A 0B E5         ld   hl, (room_ptr)
 654  8A00 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 655  8A03 19               add  hl, de
 656  8A04 4E               ld   c, (hl)
 657  8A05 23               inc  hl
 658  8A06 46               ld   b, (hl)                   ; BC = AttrAddr
 659  8A07
 660  8A07                  ; Offset = BC - 23552
 661  8A07 60               ld   h, b
 662  8A08 69               ld   l, c
 663  8A09 01 00 A4         ld   bc, -23552
 664  8A0C 09               add  hl, bc
 665  8A0D
 666  8A0D                  ; PortalX = (Offset & 31) * 8
 667  8A0D 7D               ld   a, l
 668  8A0E E6 1F            and  31
 669  8A10 87               add  a, a
 669  8A11 87             add a, a
 669  8A12 87             add a, a
 670  8A13 5F               ld   e, a                      ; E = PortalX (0..248)
 671  8A14
 672  8A14                  ; PortalY = (Offset / 32) * 8
 673  8A14 CB 3C            srl  h
 673  8A16 CB 1D          rr l
 674  8A18 CB 3C            srl  h
 674  8A1A CB 1D          rr l
 675  8A1C CB 3C            srl  h
 675  8A1E CB 1D          rr l
 676  8A20 CB 3C            srl  h
 676  8A22 CB 1D          rr l
 677  8A24 CB 3C            srl  h
 677  8A26 CB 1D          rr l
 678  8A28 7D               ld   a, l
 679  8A29 87               add  a, a
 679  8A2A 87             add a, a
 679  8A2B 87             add a, a
 680  8A2C 57               ld   d, a                      ; D = PortalY (0..120)
 681  8A2D
 682  8A2D                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 683  8A2D ED 4B 8A E1      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 684  8A31
 685  8A31                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 686  8A31 7B               ld   a, e
 687  8A32 91               sub  c
 688  8A33 30 02            jr   nc, .x_diff_pos
 689  8A35 ED 44            neg
 690  8A37              .x_diff_pos:
 691  8A37 FE 0C            cp   12
 692  8A39 30 0F            jr   nc, .no_transition
 693  8A3B
 694  8A3B                  ; Controllo verticale: |WillyY - PortalY| < 14
 695  8A3B 7A               ld   a, d
 696  8A3C 90               sub  b
 697  8A3D 30 02            jr   nc, .y_diff_pos
 698  8A3F ED 44            neg
 699  8A41              .y_diff_pos:
 700  8A41 FE 0E            cp   14
 701  8A43 30 05            jr   nc, .no_transition
 702  8A45
 703  8A45                  ; Transizione al portale attiva!
 704  8A45 E1               pop  hl
 705  8A46 D1               pop  de
 706  8A47 C1               pop  bc
 707  8A48 37               scf
 708  8A49 C9               ret
 709  8A4A
 710  8A4A              .no_transition:
 711  8A4A E1               pop  hl
 712  8A4B D1               pop  de
 713  8A4C C1               pop  bc
 714  8A4D B7               or   a
 715  8A4E C9               ret
 716  8A4F
 717  8A4F              ; Alias per retrocompatibilità
 718  8A4F              CheckVictoryCondition: EQU CheckPortalTransition
 719  8A4F
 720  8A4F              ; -------------------------------------------------------------------
 721  8A4F              ; TriggerPortalTransition
 722  8A4F              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 723  8A4F              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 724  8A4F              ; - Avanza all'indice della stanza successiva.
 725  8A4F              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 726  8A4F              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 727  8A4F              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 728  8A4F              ; -------------------------------------------------------------------
 729  8A4F              TriggerPortalTransition:
 730  8A4F                  ; 1. Determina l'ID della stanza corrente
 731  8A4F CD B8 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 732  8A52
 733  8A52                  ; 2. Calcola l'indice della stanza successiva
 734  8A52 3A B0 E4         ld   a, (current_room)
 735  8A55 3C               inc  a
 736  8A56 FE 14            cp   NUM_ROOMS
 737  8A58 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 738  8A5A
 739  8A5A                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 740  8A5A 21 19 73         ld   hl, RoomsListTable
 741  8A5D 5F               ld   e, a
 742  8A5E 16 00            ld   d, 0
 743  8A60 19               add  hl, de
 744  8A61 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 745  8A62 5E               ld   e, (hl)
 746  8A63 23               inc  hl
 747  8A64 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 748  8A65 ED 53 0B E5      ld   (room_ptr), de
 749  8A69
 750  8A69                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 751  8A69 AF               xor  a
 752  8A6A 32 11 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 753  8A6D 32 98 E1         ld   (velocity_y), a
 754  8A70 32 A3 E7         ld   (game_objective_completed), a
 755  8A73 3E 01            ld   a, 1
 756  8A75 32 99 E1         ld   (on_ground), a
 757  8A78
 758  8A78                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 759  8A78 3E 07            ld   a, $07
 760  8A7A CD 9D 62         call Gfx_ClearScreenDirect
 761  8A7D
 762  8A7D C3 12 87         jp   LoadRoomAndRestart
 763  8A80
 764  8A80              .all_rooms_completed:
 765  8A80                  ; Tutte le stanze sono state completate con successo!
 766  8A80                  IF ENABLE_VICTORY_SCREEN != 0
 767  8A80 C3 77 89         jp   TriggerVictory
 768  8A83                  ELSE
 769  8A83 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 770  8A83 ~                ld   de, (RoomsListTable)
 771  8A83 ~                ld   (room_ptr), de
 772  8A83 ~                xor  a
 773  8A83 ~                ld   (transition_active), a
 774  8A83 ~                ld   (velocity_y), a
 775  8A83 ~                ld   (game_objective_completed), a
 776  8A83 ~                ld   a, 1
 777  8A83 ~                ld   (on_ground), a
 778  8A83 ~                ld   a, $07
 779  8A83 ~                call Gfx_ClearScreenDirect
 780  8A83 ~                jp   LoadRoomAndRestart
 781  8A83                  ENDIF
 782  8A83
 783  8A83              ; -------------------------------------------------------------------
 784  8A83              ; CheckAllItemsCollected
 785  8A83              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 786  8A83              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 787  8A83              ; -------------------------------------------------------------------
 788  8A83              CheckAllItemsCollected:
 789  8A83 3A A3 E7         ld   a, (game_objective_completed)
 790  8A86 B7               or   a
 791  8A87 20 08            jr   nz, .all_collected
 792  8A89 3A 0A E5         ld   a, (num_room_items)
 793  8A8C B7               or   a
 794  8A8D 28 02            jr   z, .all_collected
 795  8A8F B7               or   a
 796  8A90 C9               ret
 797  8A91              .all_collected:
 798  8A91 37               scf
 799  8A92 C9               ret
 800  8A93
 801  8A93              ; -------------------------------------------------------------------
 802  8A93              ; CheckInMasterBedroom (alias per retrocompatibilità)
 803  8A93              ; -------------------------------------------------------------------
 804  8A93              CheckInMasterBedroom:
 805  8A93 37               scf
 806  8A94 C9               ret
 807  8A95
 808  8A95              ; -------------------------------------------------------------------
 809  8A95              ; CheckWillyConveyorCollision
 810  8A95              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 811  8A95              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 812  8A95              ; -------------------------------------------------------------------
 813  8A95              CheckWillyConveyorCollision:
 814  8A95 C5               push bc
 815  8A96 D5               push de
 816  8A97 E5               push hl
 817  8A98
 818  8A98                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 819  8A98 CD DA 76         call CheckWillyOnConveyor
 820  8A9B 38 49            jr   c, .collision_detected
 821  8A9D
 822  8A9D                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 823  8A9D 3A B2 E4         ld   a, (conveyor_len)
 824  8AA0 B7               or   a
 825  8AA1 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 826  8AA3
 827  8AA3                  ; B = WillyY, C = WillyX
 828  8AA3 ED 4B 8A E1      ld   bc, (PlayerPos)
 829  8AA7
 830  8AA7                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 831  8AA7 3A B3 E4         ld   a, (conveyor_row)
 832  8AAA 87               add  a, a                  ; *2
 833  8AAB 87               add  a, a                  ; *4
 834  8AAC 87               add  a, a                  ; *8
 835  8AAD 5F               ld   e, a                  ; E = ConveyorTop
 836  8AAE C6 07            add  a, 7
 837  8AB0 57               ld   d, a                  ; D = ConveyorBottom
 838  8AB1
 839  8AB1                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 840  8AB1 78               ld   a, b                  ; WillyTop
 841  8AB2 BA               cp   d
 842  8AB3 28 04            jr   z, .y_overlap
 843  8AB5 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 844  8AB7 18 32            jr   .no_conv_collision
 845  8AB9
 846  8AB9              .y_overlap:
 847  8AB9 C6 0F            add  a, 15                 ; WillyBottom
 848  8ABB BB               cp   e
 849  8ABC 28 04            jr   z, .x_check
 850  8ABE 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 851  8AC0 18 29            jr   .no_conv_collision
 852  8AC2
 853  8AC2              .x_check:
 854  8AC2                  ; ConveyorLeft = conveyor_col * 8
 855  8AC2 3A B4 E4         ld   a, (conveyor_col)
 856  8AC5 87               add  a, a                  ; *2
 857  8AC6 87               add  a, a                  ; *4
 858  8AC7 87               add  a, a                  ; *8
 859  8AC8 5F               ld   e, a                  ; E = ConveyorLeft
 860  8AC9
 861  8AC9                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 862  8AC9 21 B2 E4         ld   hl, conveyor_len
 863  8ACC 3A B4 E4         ld   a, (conveyor_col)
 864  8ACF 86               add  a, (hl)
 865  8AD0 87               add  a, a                  ; *2
 866  8AD1 87               add  a, a                  ; *4
 867  8AD2 87               add  a, a                  ; *8
 868  8AD3 3D               dec  a                     ; ConveyorRight
 869  8AD4 57               ld   d, a                  ; D = ConveyorRight
 870  8AD5
 871  8AD5                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 872  8AD5 79               ld   a, c                  ; WillyLeft
 873  8AD6 BA               cp   d
 874  8AD7 28 04            jr   z, .x_overlap
 875  8AD9 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 876  8ADB 18 0E            jr   .no_conv_collision
 877  8ADD
 878  8ADD              .x_overlap:
 879  8ADD C6 0F            add  a, 15                 ; WillyRight
 880  8ADF BB               cp   e
 881  8AE0 28 04            jr   z, .collision_detected
 882  8AE2 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 883  8AE4 18 05            jr   .no_conv_collision
 884  8AE6
 885  8AE6              .collision_detected:
 886  8AE6 E1               pop  hl
 887  8AE7 D1               pop  de
 888  8AE8 C1               pop  bc
 889  8AE9 37               scf
 890  8AEA C9               ret
 891  8AEB
 892  8AEB              .no_conv_collision:
 893  8AEB E1               pop  hl
 894  8AEC D1               pop  de
 895  8AED C1               pop  bc
 896  8AEE B7               or   a
 897  8AEF C9               ret
 898  8AF0
 899  8AF0              ; -------------------------------------------------------------------
 900  8AF0              ; ResetFullGameState
 901  8AF0              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 902  8AF0              ; per l'avvio di una nuova partita dopo il Game Over.
 903  8AF0              ; -------------------------------------------------------------------
 904  8AF0              ResetFullGameState:
 905  8AF0                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 906  8AF0 AF               xor  a
 907  8AF1 D3 FE            out  ($fe), a              ; Bordo a nero
 908  8AF3 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 909  8AF6
 910  8AF6                  ; Ripristina il numero di vite iniziali
 911  8AF6 3E 07            ld   a, INITIAL_LIVES
 912  8AF8 32 97 E1         ld   (willy_lives), a
 913  8AFB
 914  8AFB                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 915  8AFB AF               xor  a
 916  8AFC 32 94 E1         ld   (items_collected), a
 917  8AFF 32 90 E1         ld   (body_state), a
 918  8B02 32 A3 E1         ld   (w_warp_state), a
 919  8B05 32 A6 E1         ld   (w_key_prev), a
 920  8B08 32 A7 E1         ld   (enter_key_prev), a
 921  8B0B 32 98 E1         ld   (velocity_y), a
 922  8B0E 32 9A E1         ld   (jump_pressed), a
 923  8B11 32 9C E1         ld   (coyote_timer), a
 924  8B14 32 9F E1         ld   (jump_frame), a
 925  8B17 32 9E E1         ld   (jump_dir), a
 926  8B1A 32 11 E5         ld   (transition_active), a
 927  8B1D 32 96 E5         ld   (willy_safety_timer), a
 928  8B20 3E FF            ld   a, $ff
 929  8B22 32 A8 E1         ld   (digit_key_prev), a
 930  8B25 3E 01            ld   a, 1
 931  8B27 32 A1 E1         ld   (q_prev), a
 932  8B2A 32 A2 E1         ld   (a_prev), a
 933  8B2D 32 99 E1         ld   (on_ground), a
 934  8B30
 935  8B30                  ; Azzeramento punteggio partita corrente (Score = 000000)
 936  8B30                  ; Nota: High score viene mantenuto intatto tra le partite
 937  8B30 AF               xor  a

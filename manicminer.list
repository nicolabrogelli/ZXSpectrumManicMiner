 202  89E1              .willy_dies:
 203  89E1                  ; 1. Decrementa le vite
 204  89E1 21 FE EA         ld   hl, willy_lives
 205  89E4 7E               ld   a, (hl)
 206  89E5 B7               or   a
 207  89E6 28 05            jr   z, .check_game_over
 208  89E8 35               dec  (hl)
 209  89E9 28 02            jr   z, .check_game_over

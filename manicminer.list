  29+ 7D1D              ; Enemy_LoadRoom
  30+ 7D1D              ;
  31+ 7D1D              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7D1D              ; Chiamato quando si entra in una stanza.
  33+ 7D1D              ; -------------------------------------------------------------------
  34+ 7D1D              Enemy_LoadRoom:
  35+ 7D1D E5               push hl
  36+ 7D1E D5               push de
  37+ 7D1F C5               push bc
  38+ 7D20 DD E5            push ix
  39+ 7D22
  40+ 7D22                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D22 21 C5 7C         ld   hl, ActiveEnemies
  42+ 7D25 11 C6 7C         ld   de, ActiveEnemies + 1
  43+ 7D28 36 00            ld   (hl), 0
  44+ 7D2A 01 57 00         ld   bc, 87
  45+ 7D2D ED B0            ldir
  46+ 7D2F
  47+ 7D2F                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D2F DD 21 C5 7C      ld   ix, ActiveEnemies
  49+ 7D33 06 08            ld   b, 8
  50+ 7D35 11 0B 00         ld   de, 11
  51+ 7D38              .init_old_pos:
  52+ 7D38 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D3C DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D40 DD 19            add  ix, de
  55+ 7D42 10 F4            djnz .init_old_pos
  56+ 7D44
  57+ 7D44                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D44 DD 21 C5 7C      ld   ix, ActiveEnemies
  59+ 7D48 2A 80 99         ld   hl, (room_ptr)
  60+ 7D4B 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D4E 19               add  hl, de
  62+ 7D4F
  63+ 7D4F 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D51              .load_h_loop:
  65+ 7D51 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D52 FE FF            cp   $FF
  67+ 7D54 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D56 B7               or   a
  69+ 7D57 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D59
  71+ 7D59                  ; Slot attivo
  72+ 7D59 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D5D DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D60
  75+ 7D60 23               inc  hl
  76+ 7D61 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D62 23               inc  hl
  78+ 7D63 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D64
  80+ 7D64                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D64 E5               push hl
  82+ 7D65 C5               push bc
  83+ 7D66 67               ld   h, a
  84+ 7D67 69               ld   l, c
  85+ 7D68 01 00 A4         ld   bc, -23552
  86+ 7D6B 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D6C
  88+ 7D6C                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D6C 7D               ld   a, l
  90+ 7D6D E6 1F            and  31
  91+ 7D6F 87               add  a, a
  91+ 7D70 87             add a, a
  91+ 7D71 87             add a, a
  92+ 7D72 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D75
  94+ 7D75                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D75 CB 3C            srl  h
  95+ 7D77 CB 1D          rr l
  96+ 7D79 CB 3C            srl  h
  96+ 7D7B CB 1D          rr l
  97+ 7D7D CB 3C            srl  h
  97+ 7D7F CB 1D          rr l
  98+ 7D81 CB 3C            srl  h
  98+ 7D83 CB 1D          rr l
  99+ 7D85 CB 3C            srl  h
  99+ 7D87 CB 1D          rr l
 100+ 7D89 7D               ld   a, l
 101+ 7D8A 87               add  a, a
 101+ 7D8B 87             add a, a
 101+ 7D8C 87             add a, a
 102+ 7D8D DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D90 C1               pop  bc
 104+ 7D91 E1               pop  hl
 105+ 7D92
 106+ 7D92 23               inc  hl
 107+ 7D93 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D94 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D98
 110+ 7D98 23               inc  hl
 111+ 7D99 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D9A E6 01            and  1
 113+ 7D9C 28 04            jr   z, .h_dir_right
 114+ 7D9E 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7DA0 18 02            jr   .set_h_dir
 116+ 7DA2              .h_dir_right:
 117+ 7DA2 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7DA4              .set_h_dir:
 119+ 7DA4 DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7DA7
 121+ 7DA7 23               inc  hl
 122+ 7DA8 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DA9 E6 1F            and  31
 124+ 7DAB 87               add  a, a
 124+ 7DAC 87             add a, a
 124+ 7DAD 87             add a, a
 125+ 7DAE DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DB1
 127+ 7DB1 23               inc  hl
 128+ 7DB2 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DB3 E6 1F            and  31
 130+ 7DB5 87               add  a, a
 130+ 7DB6 87             add a, a
 130+ 7DB7 87             add a, a
 131+ 7DB8 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DBB
 133+ 7DBB 23               inc  hl                        ; Prossimo guardiano
 134+ 7DBC 11 0B 00         ld   de, 11
 135+ 7DBF DD 19            add  ix, de
 136+ 7DC1 10 8E            djnz .load_h_loop
 137+ 7DC3
 138+ 7DC3              .done_h_guardians:
 139+ 7DC3                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DC3 2A 80 99         ld   hl, (room_ptr)
 141+ 7DC6 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DC9 19               add  hl, de
 143+ 7DCA 7E               ld   a, (hl)
 144+ 7DCB FE FF            cp   $FF
 145+ 7DCD 28 0A            jr   z, .done_v_guardians
 146+ 7DCF B7               or   a
 147+ 7DD0 28 07            jr   z, .done_v_guardians
 148+ 7DD2
 149+ 7DD2                  ; Slot attivo per guardiano verticale
 150+ 7DD2 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DD6 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DD9                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DD9
 154+ 7DD9              .done_v_guardians:
 155+ 7DD9 DD E1            pop  ix
 156+ 7DDB C1               pop  bc
 157+ 7DDC D1               pop  de
 158+ 7DDD E1               pop  hl
 159+ 7DDE C9               ret
 160+ 7DDF
 161+ 7DDF              ; -------------------------------------------------------------------
 162+ 7DDF              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DDF              ; -------------------------------------------------------------------
 164+ 7DDF              CheckEnemyWillyOverlap:
 165+ 7DDF 3A 06 9A         ld   a, (player_drawn_pos+1)
 166+ 7DE2 FE FF            cp   $FF
 167+ 7DE4 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7DE5
 169+ 7DE5                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7DE5 3A 05 9A         ld   a, (player_drawn_pos)
 171+ 7DE8 E6 F8            and  $F8
 172+ 7DEA 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7DEB 79               ld   a, c
 174+ 7DEC E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7DEE 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7DEF C6 10            add  a, 16
 177+ 7DF1 FE 19            cp   25
 178+ 7DF3 D0               ret  nc                 ; Fuori portata X
 179+ 7DF4
 180+ 7DF4                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7DF4 3A 06 9A         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7DF7 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7DF8 C6 0F            add  a, 15
 184+ 7DFA FE 1F            cp   31
 185+ 7DFC D0               ret  nc                 ; Fuori portata Y
 186+ 7DFD
 187+ 7DFD                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7DFD 3E 01            ld   a, 1
 189+ 7DFF 32 0B 9A         ld   (willy_needs_redraw), a
 190+ 7E02 C9               ret
 191+ 7E03
 192+ 7E03              ; -------------------------------------------------------------------
 193+ 7E03              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7E03              ; -------------------------------------------------------------------
 195+ 7E03              Enemy_EraseRoom:
 196+ 7E03              Enemy_DrawRoom:
 197+ 7E03              Enemy_RenderRoom:
 198+ 7E03 E5               push hl
 199+ 7E04 D5               push de
 200+ 7E05 C5               push bc
 201+ 7E06 DD E5            push ix
 202+ 7E08
 203+ 7E08                  ; ---------------------------------------------------------------
 204+ 7E08                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7E08                  ; ---------------------------------------------------------------
 206+ 7E08 DD 21 C5 7C      ld   ix, ActiveEnemies
 207+ 7E0C 06 08            ld   b, 8              ; 8 slot
 208+ 7E0E              .erase_loop:
 209+ 7E0E DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E11 E6 80            and  $80               ; Active?
 211+ 7E13 28 3A            jr   z, .next_erase
 212+ 7E15
 213+ 7E15                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E15 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E18 FE FF            cp   $FF
 216+ 7E1A 28 33            jr   z, .next_erase
 217+ 7E1C
 218+ 7E1C                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E1C DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E1F DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E22 20 0E            jr   nz, .do_erase_slot
 222+ 7E24 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E27 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E2A 20 06            jr   nz, .do_erase_slot
 225+ 7E2C
 226+ 7E2C 3A 09 9A         ld   a, (enemy_was_updated)
 227+ 7E2F B7               or   a
 228+ 7E30 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E32
 230+ 7E32              .do_erase_slot:
 231+ 7E32 C5               push bc                ; Salva contatore ciclo
 232+ 7E33
 233+ 7E33                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E33 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E36 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E39 CD DF 7D         call CheckEnemyWillyOverlap
 237+ 7E3C
 238+ 7E3C                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E3C DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E3F DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7E42 CD E2 5F         call Gfx_ErasePixelSprite16x16
 242+ 7E45 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E48 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E4B CD BE 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E4E
 246+ 7E4E C1               pop  bc
 247+ 7E4F
 248+ 7E4F              .next_erase:
 249+ 7E4F 11 0B 00         ld   de, 11
 250+ 7E52 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7E54 05               dec  b
 252+ 7E55 20 B7            jr   nz, .erase_loop
 253+ 7E57
 254+ 7E57                  ; ---------------------------------------------------------------
 255+ 7E57                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7E57                  ; ---------------------------------------------------------------
 257+ 7E57 DD 21 C5 7C      ld   ix, ActiveEnemies
 258+ 7E5B 06 08            ld   b, 8              ; 8 slot
 259+ 7E5D              .draw_loop:
 260+ 7E5D DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7E60 E6 80            and  $80               ; Active?
 262+ 7E62 28 37            jr   z, .next_draw
 263+ 7E64
 264+ 7E64                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E64 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E67 FE FF            cp   $FF
 267+ 7E69 28 16            jr   z, .do_draw_slot
 268+ 7E6B
 269+ 7E6B                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E6B DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E6E DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E71 20 0E            jr   nz, .do_draw_slot
 273+ 7E73 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E76 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E79 20 06            jr   nz, .do_draw_slot
 276+ 7E7B
 277+ 7E7B 3A 09 9A         ld   a, (enemy_was_updated)
 278+ 7E7E B7               or   a
 279+ 7E7F 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7E81
 281+ 7E81              .do_draw_slot:
 282+ 7E81 C5               push bc                ; Salva contatore ciclo
 283+ 7E82
 284+ 7E82                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7E82 CD AD 7E         call Enemy_DrawSingleSlot
 286+ 7E85
 287+ 7E85                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 288+ 7E85 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 289+ 7E88 DD 46 03         ld   b, (ix+3)         ; B = Current Y
 290+ 7E8B CD DF 7D         call CheckEnemyWillyOverlap
 291+ 7E8E
 292+ 7E8E                  ; Salva le coordinate effettivamente disegnate
 293+ 7E8E DD 7E 02         ld   a, (ix+2)
 294+ 7E91 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7E94 DD 7E 03         ld   a, (ix+3)
 296+ 7E97 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7E9A
 298+ 7E9A C1               pop  bc
 299+ 7E9B
 300+ 7E9B              .next_draw:
 301+ 7E9B 11 0B 00         ld   de, 11
 302+ 7E9E DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7EA0 05               dec  b
 304+ 7EA1 20 BA            jr   nz, .draw_loop
 305+ 7EA3
 306+ 7EA3 AF               xor  a
 307+ 7EA4 32 09 9A         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 308+ 7EA7
 309+ 7EA7 DD E1            pop  ix
 310+ 7EA9 C1               pop  bc
 311+ 7EAA D1               pop  de
 312+ 7EAB E1               pop  hl
 313+ 7EAC C9               ret

2099+ 68E3 C6 30            add  a, '0'
2100+ 68E5 77               ld   (hl), a
2101+ 68E6 23               inc  hl
2102+ 68E7
2103+ 68E7                  ; Cifra 1 (decine di migliaia)
2104+ 68E7 DD 7E 02         ld   a, (ix+2)
2105+ 68EA E6 0F            and  $0f
2106+ 68EC C6 30            add  a, '0'
2107+ 68EE 77               ld   (hl), a
2108+ 68EF 23               inc  hl
2109+ 68F0
2110+ 68F0                  ; Cifra 2 (migliaia)
2111+ 68F0 DD 7E 01         ld   a, (ix+1)
2112+ 68F3 0F               rrca
2113+ 68F4 0F               rrca
2114+ 68F5 0F               rrca
2115+ 68F6 0F               rrca
2116+ 68F7 E6 0F            and  $0f
2117+ 68F9 C6 30            add  a, '0'
2118+ 68FB 77               ld   (hl), a
2119+ 68FC 23               inc  hl
2120+ 68FD
2121+ 68FD                  ; Cifra 3 (centinaia)
2122+ 68FD DD 7E 01         ld   a, (ix+1)
2123+ 6900 E6 0F            and  $0f
2124+ 6902 C6 30            add  a, '0'
2125+ 6904 77               ld   (hl), a
2126+ 6905 23               inc  hl
2127+ 6906
2128+ 6906                  ; Cifra 4 (decine)
2129+ 6906 DD 7E 00         ld   a, (ix+0)
2130+ 6909 0F               rrca
2131+ 690A 0F               rrca
2132+ 690B 0F               rrca
2133+ 690C 0F               rrca
2134+ 690D E6 0F            and  $0f
2135+ 690F C6 30            add  a, '0'
2136+ 6911 77               ld   (hl), a

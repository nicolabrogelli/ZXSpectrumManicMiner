 954+ 7852 28 09            jr   z, .plat_left
 955+ 7854              .plat_right:
 956+ 7854 3A E2 EC         ld   a, (ramp_col)
 957+ 7857 21 E0 EC         ld   hl, ramp_len
 958+ 785A 86               add  a, (hl)           ; A = ramp_col + ramp_len
 959+ 785B 18 07            jr   .compare_plat
 960+ 785D              .plat_left:
 961+ 785D 3A E2 EC         ld   a, (ramp_col)

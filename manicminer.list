 271+ 6E3F              ; LoadPositionPlayeinRoom
 272+ 6E3F              ;
 273+ 6E3F              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6E3F              ; in una nuova stanza.
 275+ 6E3F              ;
 276+ 6E3F              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6E3F              ; (layout/metadata) a partire da room_ptr.
 278+ 6E3F              ;
 279+ 6E3F              ; Output:
 280+ 6E3F              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6E3F              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6E3F              ;
 283+ 6E3F              ; Struttura dati stanza:
 284+ 6E3F              ;   OFFSET_POS_WILLY:
 285+ 6E3F              ;       +0 = X
 286+ 6E3F              ;       +1 = Y
 287+ 6E3F              ; -------------------------------------------------------------------
 288+ 6E3F              LoadPositionPlayeinRoom:
 289+ 6E3F                  ; ---------------------------------------------------------------
 290+ 6E3F                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6E3F                  ; ---------------------------------------------------------------
 292+ 6E3F 2A EB 97         ld   hl, (room_ptr)
 293+ 6E42 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6E45 19               add  hl, de
 295+ 6E46
 296+ 6E46                  ; Byte 0: Y * 2
 297+ 6E46 7E               ld   a, (hl)
 298+ 6E47 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6E49 57               ld   d, a                      ; D = PlayerY
 300+ 6E4A
 301+ 6E4A                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6E4A 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6E4B 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6E4C 7E               ld   a, (hl)
 305+ 6E4D E6 01            and  1
 306+ 6E4F 28 04            jr   z, .facing_right
 307+ 6E51 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6E53 18 02            jr   .set_dir
 309+ 6E55              .facing_right:
 310+ 6E55 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6E57              .set_dir:
 312+ 6E57 32 72 94         ld   (direction), a
 313+ 6E5A
 314+ 6E5A                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6E5A 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6E5B 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6E5C 4E               ld   c, (hl)
 318+ 6E5D 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6E5E 7E               ld   a, (hl)
 320+ 6E5F
 321+ 6E5F                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8

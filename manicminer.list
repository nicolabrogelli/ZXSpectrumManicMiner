 161+ 8115 11 6A A8         ld   de, items_grid + 1
 162+ 8118 36 00            ld   (hl), 0
 163+ 811A 01 FF 01         ld   bc, 511
 164+ 811D ED B0            ldir
 165+ 811F
 166+ 811F                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 811F AF               xor  a
 168+ 8120 32 E9 AD         ld   (num_room_items), a
 169+ 8123
 170+ 8123 FD 21 99 AD      ld   iy, current_room_items
 171+ 8127
 172+ 8127                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)

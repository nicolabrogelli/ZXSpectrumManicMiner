 142+ 85B5              ; Items_DrawRoom
 143+ 85B5              ;
 144+ 85B5              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 85B5              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 85B5              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 85B5              ;
 148+ 85B5              ; Record item nella stanza (5 byte):
 149+ 85B5              ;   +0 Color / Attributo
 150+ 85B5              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 85B5              ;   +2 Attr Address High
 152+ 85B5              ;   +3 Anim Mask (96)
 153+ 85B5              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 85B5              ; Fine lista: $FF
 155+ 85B5              ; -------------------------------------------------------------------
 156+ 85B5              Items_DrawRoom:
 157+ 85B5 E5               push hl
 158+ 85B6 D5               push de
 159+ 85B7 C5               push bc
 160+ 85B8 DD E5            push ix
 161+ 85BA FD E5            push iy
 162+ 85BC
 163+ 85BC                  ; 1. Azzera items_grid (512 byte)
 164+ 85BC 21 F1 E8         ld   hl, items_grid
 165+ 85BF 11 F2 E8         ld   de, items_grid + 1
 166+ 85C2 36 00            ld   (hl), 0
 167+ 85C4 01 FF 01         ld   bc, 511
 168+ 85C7 ED B0            ldir
 169+ 85C9
 170+ 85C9                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 85C9 AF               xor  a
 172+ 85CA 32 71 EE         ld   (num_room_items), a
 173+ 85CD
 174+ 85CD FD 21 21 EE      ld   iy, current_room_items
 175+ 85D1
 176+ 85D1                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 85D1 2A 72 EE         ld   hl, (room_ptr)
 178+ 85D4 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC

  85+ F035 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  86+ F036 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  87+ F037
  88+ F037              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ F037 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ F03A 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ F03D 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ F03E 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ F03F 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ F040 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F041 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F042 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ F043 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  98+ F044
  99+ F044 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 100+ F045 00           Audio_jump_sound_timer:   db 0
 101+ F046                  IF ENABLE_MUSIC != 0
 102+ F046 ~            Audio_music_note_idx:      db 0
 103+ F046 ~            Audio_music_frame_counter: db 1
 104+ F046                  ENDIF
 105+ F046
 106+ F046              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 107+ F046 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 108+ F047 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 109+ F048 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 110+ F049
 111+ F049              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 112+ F049 00 00        willy_head_ptr:         dw 0
 113+ F04B 00 00        willy_body_ptr:         dw 0

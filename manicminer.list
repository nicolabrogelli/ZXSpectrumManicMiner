 357  8AAE              ; -------------------------------------------------------------------
 358  8AAE              ; TriggerGameOver
 359  8AAE              ; Scatena la sequenza originale di Game Over:
 360  8AAE              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 361  8AAE              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 362  8AAE              ;   con suono beeper originale e lampeggio dello schermo.
 363  8AAE              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 364  8AAE              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 365  8AAE              ; -------------------------------------------------------------------
 366  8AAE              TriggerGameOver:
 367  8AAE                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 368  8AAE CD 12 88         call Score_CheckAndUpdateHighScore
 369  8AB1
 370  8AB1                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 371  8AB1 CD 12 66         call Gfx_DrawGameOverScreen
 372  8AB4
 373  8AB4                  ; 3. Ritorna al Title Screen originale
 374  8AB4 C3 6A 8A         jp   ShowTitleScreen
 375  8AB7
 376  8AB7              ; -------------------------------------------------------------------
 377  8AB7              ; TriggerVictory
 378  8AB7              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 379  8AB7              ; - Pulisce gli elementi di gioco della stanza.
 380  8AB7              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 381  8AB7              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 382  8AB7              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 383  8AB7              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 384  8AB7              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 385  8AB7              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 386  8AB7              ; -------------------------------------------------------------------
 387  8AB7              TriggerVictory:
 388  8AB7                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 389  8AB7 CD FD 66         call Gfx_DrawVictoryScreen
 390  8ABA
 391  8ABA                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 392  8ABA              .wait_keys_release:
 393  8ABA 76               halt
 394  8ABB                  ; Controlla tasto Y (Porta $DF, bit 4)
 395  8ABB 01 FE DF         ld   bc, $dffe
 396  8ABE ED 78            in   a, (c)
 397  8AC0 CB 67            bit  4, a
 398  8AC2 28 F6            jr   z, .wait_keys_release
 399  8AC4
 400  8AC4                  ; Controlla tasto N (Porta $7F, bit 3)
 401  8AC4 01 FE 7F         ld   bc, $7ffe
 402  8AC7 ED 78            in   a, (c)
 403  8AC9 CB 5F            bit  3, a
 404  8ACB 28 ED            jr   z, .wait_keys_release
 405  8ACD
 406  8ACD                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 407  8ACD 01 FE BF         ld   bc, $bffe
 408  8AD0 ED 78            in   a, (c)
 409  8AD2 CB 47            bit  0, a
 410  8AD4 28 E4            jr   z, .wait_keys_release
 411  8AD6
 412  8AD6                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 413  8AD6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 414  8AD8              .wait_choice_loop:
 415  8AD8 76               halt
 416  8AD9
 417  8AD9                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 418  8AD9 0C               inc  c
 419  8ADA 79               ld   a, c
 420  8ADB CB 3F            srl  a
 421  8ADD CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 422  8ADF E6 07            and  7
 423  8AE1 5F               ld   e, a
 424  8AE2 16 00            ld   d, 0
 425  8AE4 21 F4 65         ld   hl, victory_color_table
 426  8AE7 19               add  hl, de
 427  8AE8 7E               ld   a, (hl)               ; A = nuovo colore attributo
 428  8AE9 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 429  8AEC 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 430  8AEE              .color_cycle_loop:
 431  8AEE 77               ld   (hl), a
 432  8AEF 23               inc  hl
 433  8AF0 10 FC            djnz .color_cycle_loop
 434  8AF2
 435  8AF2                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 436  8AF2 01 FE DF         ld   bc, $dffe
 437  8AF5 ED 78            in   a, (c)
 438  8AF7 CB 67            bit  4, a
 439  8AF9 28 2A            jr   z, .play_again_chosen
 440  8AFB
 441  8AFB                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 442  8AFB 01 FE 7F         ld   bc, $7ffe
 443  8AFE ED 78            in   a, (c)
 444  8B00 CB 5F            bit  3, a
 445  8B02 28 0B            jr   z, .quit_chosen
 446  8B04
 447  8B04                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 448  8B04 01 FE BF         ld   bc, $bffe
 449  8B07 ED 78            in   a, (c)
 450  8B09 CB 47            bit  0, a
 451  8B0B 28 02            jr   z, .quit_chosen
 452  8B0D
 453  8B0D 18 C9            jr   .wait_choice_loop
 454  8B0F
 455  8B0F              .quit_chosen:
 456  8B0F                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 457  8B0F              .wait_quit_release:
 458  8B0F 76               halt
 459  8B10 01 FE 7F         ld   bc, $7ffe
 460  8B13 ED 78            in   a, (c)
 461  8B15 CB 5F            bit  3, a
 462  8B17 28 F6            jr   z, .wait_quit_release
 463  8B19 01 FE BF         ld   bc, $bffe
 464  8B1C ED 78            in   a, (c)
 465  8B1E CB 47            bit  0, a
 466  8B20 28 ED            jr   z, .wait_quit_release
 467  8B22
 468  8B22                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 469  8B22 C3 6A 8A         jp   ShowTitleScreen
 470  8B25
 471  8B25              .play_again_chosen:
 472  8B25                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 473  8B25              .wait_play_again_release:
 474  8B25 76               halt
 475  8B26 01 FE DF         ld   bc, $dffe
 476  8B29 ED 78            in   a, (c)
 477  8B2B CB 67            bit  4, a
 478  8B2D 28 F6            jr   z, .wait_play_again_release
 479  8B2F
 480  8B2F                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 481  8B2F CD 69 8C         call ResetFullGameState
 482  8B32 C3 28 89         jp   LoadRoomAndRestart
 483  8B35
 484  8B35              ; -------------------------------------------------------------------
 485  8B35              ; CheckPortalTransition
 486  8B35              ; Verifica le condizioni per accedere alla stanza successiva:
 487  8B35              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 488  8B35              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 489  8B35              ;
 490  8B35              ; Output:
 491  8B35              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 492  8B35              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 493  8B35              ; -------------------------------------------------------------------
 494  8B35              CheckPortalTransition:
 495  8B35 C5               push bc
 496  8B36 D5               push de
 497  8B37 E5               push hl
 498  8B38
 499  8B38                  ; 1. Tutti gli item della stanza sono stati raccolti?
 500  8B38 CD FC 8B         call CheckAllItemsCollected
 501  8B3B 30 4D            jr   nc, .no_transition
 502  8B3D
 503  8B3D                  ; 2. Willy collide con il portale (16x16 pixel)?
 504  8B3D                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 505  8B3D                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 506  8B3D 2A 85 EE         ld   hl, (room_ptr)
 507  8B40 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 508  8B43 19               add  hl, de
 509  8B44 4E               ld   c, (hl)
 510  8B45 23               inc  hl
 511  8B46 46               ld   b, (hl)                   ; BC = AttrAddr
 512  8B47
 513  8B47                  ; Offset = BC - 23552
 514  8B47 60               ld   h, b
 515  8B48 69               ld   l, c
 516  8B49 01 00 A4         ld   bc, -23552
 517  8B4C 09               add  hl, bc
 518  8B4D
 519  8B4D                  ; PortalX = (Offset & 31) * 8
 520  8B4D 7D               ld   a, l
 521  8B4E E6 1F            and  31
 522  8B50 87               add  a, a
 522  8B51 87             add a, a
 522  8B52 87             add a, a
 523  8B53 5F               ld   e, a                      ; E = PortalX (0..248)
 524  8B54
 525  8B54                  ; PortalY = (Offset / 32) * 8
 526  8B54 CB 3C            srl  h
 526  8B56 CB 1D          rr l
 527  8B58 CB 3C            srl  h
 527  8B5A CB 1D          rr l
 528  8B5C CB 3C            srl  h
 528  8B5E CB 1D          rr l
 529  8B60 CB 3C            srl  h
 529  8B62 CB 1D          rr l
 530  8B64 CB 3C            srl  h
 530  8B66 CB 1D          rr l

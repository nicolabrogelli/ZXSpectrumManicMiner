2042+ 7D3F              ; -------------------------------------------------------------------
2043+ 7D3F              ; Phys_UpdateAir
2044+ 7D3F              ; Aggiorna il consumo di aria durante ogni frame di gioco.
2045+ 7D3F              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
2046+ 7D3F              ; Output:
2047+ 7D3F              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
2048+ 7D3F              ;   Carry Clear = Aria ancora disponibile
2049+ 7D3F              ; -------------------------------------------------------------------
2050+ 7D3F              Phys_UpdateAir:
2051+ 7D3F                  ; Incrementa il timer dei frame
2052+ 7D3F 3A D9 F0         ld   a, (air_timer)
2053+ 7D42 3C               inc  a
2054+ 7D43 32 D9 F0         ld   (air_timer), a
2055+ 7D46 21 DA F0         ld   hl, air_deplete_rate
2056+ 7D49 BE               cp   (hl)
2057+ 7D4A 38 14            jr   c, .no_deplete
2058+ 7D4C
2059+ 7D4C                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
2060+ 7D4C AF               xor  a
2061+ 7D4D 32 D9 F0         ld   (air_timer), a
2062+ 7D50
2063+ 7D50 3A D8 F0         ld   a, (air_pixels)
2064+ 7D53 B7               or   a
2065+ 7D54 28 0C            jr   z, .air_finished
2066+ 7D56
2067+ 7D56 3D               dec  a
2068+ 7D57 32 D8 F0         ld   (air_pixels), a
2069+ 7D5A CD 2D 6A         call Gfx_UpdateAirBar
2070+ 7D5D
2071+ 7D5D B7               or   a
2072+ 7D5E 28 02            jr   z, .air_finished
2073+ 7D60
2074+ 7D60              .no_deplete:
2075+ 7D60 B7               or   a                     ; Carry Clear = Ok
2076+ 7D61 C9               ret
2077+ 7D62
2078+ 7D62              .air_finished:
2079+ 7D62 37               scf                        ; Carry Set = Morte per esaurimento aria
2080+ 7D63 C9               ret

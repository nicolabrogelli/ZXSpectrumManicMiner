 271+ 6D6E              ; LoadPositionPlayeinRoom
 272+ 6D6E              ;
 273+ 6D6E              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6D6E              ; in una nuova stanza.
 275+ 6D6E              ;
 276+ 6D6E              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6D6E              ; (layout/metadata) a partire da room_ptr.

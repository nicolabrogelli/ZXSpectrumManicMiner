 151  89BA ED 4B 03 EB      ld   bc, (PlayerPos)
 152  89BE ED 43 05 EB      ld   (PlayerPosOld), bc
 153  89C2
 154  89C2                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 155  89C2 CD D6 70         call Input_CheckCtrl

 525  86D7              ; -------------------------------------------------------------------
 526  86D7              ; TriggerVictory
 527  86D7              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  86D7              ; - Pulisce gli elementi di gioco della stanza.
 529  86D7              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  86D7              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  86D7              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  86D7              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  86D7              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  86D7              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  86D7              ; -------------------------------------------------------------------
 536  86D7              TriggerVictory:
 537  86D7                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  86D7 CD F3 66         call Gfx_DrawVictoryScreen
 539  86DA
 540  86DA                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  86DA              .wait_keys_release:
 542  86DA 76               halt
 543  86DB                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  86DB 01 FE DF         ld   bc, $dffe
 545  86DE ED 78            in   a, (c)
 546  86E0 CB 67            bit  4, a
 547  86E2 28 F6            jr   z, .wait_keys_release
 548  86E4
 549  86E4                  ; Controlla tasto N (Porta $7F, bit 3)
 550  86E4 01 FE 7F         ld   bc, $7ffe
 551  86E7 ED 78            in   a, (c)
 552  86E9 CB 5F            bit  3, a
 553  86EB 28 ED            jr   z, .wait_keys_release
 554  86ED
 555  86ED                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  86ED 01 FE BF         ld   bc, $bffe
 557  86F0 ED 78            in   a, (c)
 558  86F2 CB 47            bit  0, a
 559  86F4 28 E4            jr   z, .wait_keys_release
 560  86F6
 561  86F6                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  86F6 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  86F8              .wait_choice_loop:
 564  86F8 76               halt
 565  86F9
 566  86F9                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  86F9 0C               inc  c
 568  86FA 79               ld   a, c
 569  86FB CB 3F            srl  a
 570  86FD CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  86FF E6 07            and  7
 572  8701 5F               ld   e, a
 573  8702 16 00            ld   d, 0
 574  8704 21 0D 66         ld   hl, victory_color_table
 575  8707 19               add  hl, de
 576  8708 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  8709 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  870C 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  870E              .color_cycle_loop:
 580  870E 77               ld   (hl), a
 581  870F 23               inc  hl
 582  8710 10 FC            djnz .color_cycle_loop
 583  8712
 584  8712                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  8712 01 FE DF         ld   bc, $dffe
 586  8715 ED 78            in   a, (c)
 587  8717 CB 67            bit  4, a
 588  8719 28 2A            jr   z, .play_again_chosen
 589  871B
 590  871B                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  871B 01 FE 7F         ld   bc, $7ffe
 592  871E ED 78            in   a, (c)
 593  8720 CB 5F            bit  3, a
 594  8722 28 0B            jr   z, .quit_chosen
 595  8724
 596  8724                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  8724 01 FE BF         ld   bc, $bffe
 598  8727 ED 78            in   a, (c)
 599  8729 CB 47            bit  0, a
 600  872B 28 02            jr   z, .quit_chosen
 601  872D
 602  872D 18 C9            jr   .wait_choice_loop
 603  872F
 604  872F              .quit_chosen:
 605  872F                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  872F              .wait_quit_release:
 607  872F 76               halt
 608  8730 01 FE 7F         ld   bc, $7ffe
 609  8733 ED 78            in   a, (c)
 610  8735 CB 5F            bit  3, a
 611  8737 28 F6            jr   z, .wait_quit_release
 612  8739 01 FE BF         ld   bc, $bffe
 613  873C ED 78            in   a, (c)
 614  873E CB 47            bit  0, a
 615  8740 28 ED            jr   z, .wait_quit_release
 616  8742
 617  8742                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  8742 C3 AB 85         jp   ShowTitleScreen
 619  8745
 620  8745              .play_again_chosen:
 621  8745                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  8745              .wait_play_again_release:
 623  8745 76               halt
 624  8746 01 FE DF         ld   bc, $dffe
 625  8749 ED 78            in   a, (c)
 626  874B CB 67            bit  4, a
 627  874D 28 F6            jr   z, .wait_play_again_release
 628  874F
 629  874F                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  874F CD 50 88         call ResetFullGameState
 631  8752 C3 72 84         jp   LoadRoomAndRestart
 632  8755
 633  8755              ; -------------------------------------------------------------------
 634  8755              ; CheckPortalTransition
 635  8755              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8755              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8755              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8755              ;
 639  8755              ; Output:
 640  8755              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8755              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8755              ; -------------------------------------------------------------------
 643  8755              CheckPortalTransition:
 644  8755 C5               push bc
 645  8756 D5               push de
 646  8757 E5               push hl
 647  8758
 648  8758                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  8758 CD E3 87         call CheckAllItemsCollected
 650  875B 30 4D            jr   nc, .no_transition
 651  875D
 652  875D                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  875D                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  875D                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  875D 2A 6B E2         ld   hl, (room_ptr)
 656  8760 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8763 19               add  hl, de
 658  8764 4E               ld   c, (hl)
 659  8765 23               inc  hl
 660  8766 46               ld   b, (hl)                   ; BC = AttrAddr
 661  8767
 662  8767                  ; Offset = BC - 23552
 663  8767 60               ld   h, b
 664  8768 69               ld   l, c
 665  8769 01 00 A4         ld   bc, -23552
 666  876C 09               add  hl, bc
 667  876D
 668  876D                  ; PortalX = (Offset & 31) * 8
 669  876D 7D               ld   a, l
 670  876E E6 1F            and  31
 671  8770 87               add  a, a
 671  8771 87             add a, a
 671  8772 87             add a, a
 672  8773 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8774
 674  8774                  ; PortalY = (Offset / 32) * 8
 675  8774 CB 3C            srl  h
 675  8776 CB 1D          rr l
 676  8778 CB 3C            srl  h
 676  877A CB 1D          rr l
 677  877C CB 3C            srl  h
 677  877E CB 1D          rr l
 678  8780 CB 3C            srl  h
 678  8782 CB 1D          rr l
 679  8784 CB 3C            srl  h
 679  8786 CB 1D          rr l
 680  8788 7D               ld   a, l
 681  8789 87               add  a, a
 681  878A 87             add a, a
 681  878B 87             add a, a
 682  878C 57               ld   d, a                      ; D = PortalY (0..120)
 683  878D
 684  878D                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  878D ED 4B EA DE      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  8791
 687  8791                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  8791 7B               ld   a, e
 689  8792 91               sub  c
 690  8793 30 02            jr   nc, .x_diff_pos
 691  8795 ED 44            neg
 692  8797              .x_diff_pos:
 693  8797 FE 0C            cp   12
 694  8799 30 0F            jr   nc, .no_transition
 695  879B
 696  879B                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  879B 7A               ld   a, d
 698  879C 90               sub  b
 699  879D 30 02            jr   nc, .y_diff_pos
 700  879F ED 44            neg
 701  87A1              .y_diff_pos:
 702  87A1 FE 0E            cp   14
 703  87A3 30 05            jr   nc, .no_transition
 704  87A5
 705  87A5                  ; Transizione al portale attiva!
 706  87A5 E1               pop  hl
 707  87A6 D1               pop  de
 708  87A7 C1               pop  bc
 709  87A8 37               scf
 710  87A9 C9               ret
 711  87AA
 712  87AA              .no_transition:
 713  87AA E1               pop  hl
 714  87AB D1               pop  de
 715  87AC C1               pop  bc
 716  87AD B7               or   a
 717  87AE C9               ret
 718  87AF
 719  87AF              ; Alias per retrocompatibilità
 720  87AF              CheckVictoryCondition: EQU CheckPortalTransition
 721  87AF
 722  87AF              ; -------------------------------------------------------------------
 723  87AF              ; TriggerPortalTransition
 724  87AF              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  87AF              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  87AF              ; - Avanza all'indice della stanza successiva.
 727  87AF              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  87AF              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  87AF              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  87AF              ; -------------------------------------------------------------------
 731  87AF              TriggerPortalTransition:
 732  87AF                  ; 1. Determina l'ID della stanza corrente
 733  87AF CD 18 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  87B2
 735  87B2                  ; 2. Calcola l'indice della stanza successiva
 736  87B2 3A 10 E2         ld   a, (current_room)
 737  87B5 3C               inc  a
 738  87B6 FE 14            cp   NUM_ROOMS
 739  87B8 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  87BA
 741  87BA                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  87BA 21 0A 73         ld   hl, RoomsListTable
 743  87BD 5F               ld   e, a
 744  87BE 16 00            ld   d, 0
 745  87C0 19               add  hl, de
 746  87C1 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87C2 5E               ld   e, (hl)
 748  87C3 23               inc  hl
 749  87C4 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87C5 ED 53 6B E2      ld   (room_ptr), de
 751  87C9
 752  87C9                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87C9 AF               xor  a
 754  87CA 32 71 E2         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87CD 32 F8 DE         ld   (velocity_y), a
 756  87D0 32 00 E5         ld   (game_objective_completed), a
 757  87D3 3E 01            ld   a, 1
 758  87D5 32 F9 DE         ld   (on_ground), a
 759  87D8
 760  87D8                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  87D8 3E 07            ld   a, $07
 762  87DA CD 99 62         call Gfx_ClearScreenDirect
 763  87DD
 764  87DD C3 72 84         jp   LoadRoomAndRestart
 765  87E0
 766  87E0              .all_rooms_completed:
 767  87E0                  ; Tutte le stanze sono state completate con successo!
 768  87E0                  IF ENABLE_VICTORY_SCREEN != 0
 769  87E0 C3 D7 86         jp   TriggerVictory
 770  87E3                  ELSE
 771  87E3 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  87E3 ~                ld   de, (RoomsListTable)
 773  87E3 ~                ld   (room_ptr), de
 774  87E3 ~                xor  a
 775  87E3 ~                ld   (transition_active), a
 776  87E3 ~                ld   (velocity_y), a
 777  87E3 ~                ld   (game_objective_completed), a
 778  87E3 ~                ld   a, 1
 779  87E3 ~                ld   (on_ground), a
 780  87E3 ~                ld   a, $07
 781  87E3 ~                call Gfx_ClearScreenDirect
 782  87E3 ~                jp   LoadRoomAndRestart
 783  87E3                  ENDIF
 784  87E3
 785  87E3              ; -------------------------------------------------------------------
 786  87E3              ; CheckAllItemsCollected
 787  87E3              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  87E3              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  87E3              ; -------------------------------------------------------------------
 790  87E3              CheckAllItemsCollected:
 791  87E3 3A 00 E5         ld   a, (game_objective_completed)
 792  87E6 B7               or   a
 793  87E7 20 08            jr   nz, .all_collected
 794  87E9 3A 6A E2         ld   a, (num_room_items)
 795  87EC B7               or   a
 796  87ED 28 02            jr   z, .all_collected
 797  87EF B7               or   a
 798  87F0 C9               ret
 799  87F1              .all_collected:
 800  87F1 37               scf
 801  87F2 C9               ret
 802  87F3
 803  87F3              ; -------------------------------------------------------------------
 804  87F3              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  87F3              ; -------------------------------------------------------------------
 806  87F3              CheckInMasterBedroom:
 807  87F3 37               scf
 808  87F4 C9               ret
 809  87F5
 810  87F5              ; -------------------------------------------------------------------
 811  87F5              ; CheckWillyConveyorCollision
 812  87F5              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  87F5              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  87F5              ; -------------------------------------------------------------------
 815  87F5              CheckWillyConveyorCollision:
 816  87F5 C5               push bc
 817  87F6 D5               push de
 818  87F7 E5               push hl
 819  87F8
 820  87F8                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  87F8 CD CB 76         call CheckWillyOnConveyor
 822  87FB 38 49            jr   c, .collision_detected
 823  87FD
 824  87FD                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  87FD 3A 12 E2         ld   a, (conveyor_len)
 826  8800 B7               or   a
 827  8801 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  8803
 829  8803                  ; B = WillyY, C = WillyX
 830  8803 ED 4B EA DE      ld   bc, (PlayerPos)
 831  8807
 832  8807                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  8807 3A 13 E2         ld   a, (conveyor_row)
 834  880A 87               add  a, a                  ; *2
 835  880B 87               add  a, a                  ; *4
 836  880C 87               add  a, a                  ; *8
 837  880D 5F               ld   e, a                  ; E = ConveyorTop
 838  880E C6 07            add  a, 7
 839  8810 57               ld   d, a                  ; D = ConveyorBottom
 840  8811
 841  8811                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  8811 78               ld   a, b                  ; WillyTop
 843  8812 BA               cp   d
 844  8813 28 04            jr   z, .y_overlap
 845  8815 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  8817 18 32            jr   .no_conv_collision
 847  8819
 848  8819              .y_overlap:
 849  8819 C6 0F            add  a, 15                 ; WillyBottom
 850  881B BB               cp   e
 851  881C 28 04            jr   z, .x_check
 852  881E 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  8820 18 29            jr   .no_conv_collision
 854  8822
 855  8822              .x_check:
 856  8822                  ; ConveyorLeft = conveyor_col * 8
 857  8822 3A 14 E2         ld   a, (conveyor_col)
 858  8825 87               add  a, a                  ; *2
 859  8826 87               add  a, a                  ; *4
 860  8827 87               add  a, a                  ; *8
 861  8828 5F               ld   e, a                  ; E = ConveyorLeft
 862  8829
 863  8829                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  8829 21 12 E2         ld   hl, conveyor_len
 865  882C 3A 14 E2         ld   a, (conveyor_col)
 866  882F 86               add  a, (hl)
 867  8830 87               add  a, a                  ; *2
 868  8831 87               add  a, a                  ; *4
 869  8832 87               add  a, a                  ; *8
 870  8833 3D               dec  a                     ; ConveyorRight
 871  8834 57               ld   d, a                  ; D = ConveyorRight
 872  8835
 873  8835                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  8835 79               ld   a, c                  ; WillyLeft
 875  8836 BA               cp   d
 876  8837 28 04            jr   z, .x_overlap
 877  8839 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  883B 18 0E            jr   .no_conv_collision
 879  883D
 880  883D              .x_overlap:
 881  883D C6 0F            add  a, 15                 ; WillyRight
 882  883F BB               cp   e
 883  8840 28 04            jr   z, .collision_detected
 884  8842 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  8844 18 05            jr   .no_conv_collision
 886  8846
 887  8846              .collision_detected:
 888  8846 E1               pop  hl
 889  8847 D1               pop  de
 890  8848 C1               pop  bc
 891  8849 37               scf
 892  884A C9               ret
 893  884B
 894  884B              .no_conv_collision:
 895  884B E1               pop  hl
 896  884C D1               pop  de
 897  884D C1               pop  bc
 898  884E B7               or   a
 899  884F C9               ret
 900  8850
 901  8850              ; -------------------------------------------------------------------
 902  8850              ; ResetFullGameState
 903  8850              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 904  8850              ; per l'avvio di una nuova partita dopo il Game Over.
 905  8850              ; -------------------------------------------------------------------
 906  8850              ResetFullGameState:
 907  8850                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 908  8850 AF               xor  a
 909  8851 D3 FE            out  ($fe), a              ; Bordo a nero
 910  8853 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 911  8856
 912  8856                  ; Ripristina il numero di vite iniziali
 913  8856 3E 07            ld   a, INITIAL_LIVES
 914  8858 32 F7 DE         ld   (willy_lives), a
 915  885B
 916  885B                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 917  885B AF               xor  a
 918  885C 32 F4 DE         ld   (items_collected), a
 919  885F 32 F0 DE         ld   (body_state), a
 920  8862 32 03 DF         ld   (w_warp_state), a
 921  8865 32 06 DF         ld   (w_key_prev), a
 922  8868 32 07 DF         ld   (enter_key_prev), a
 923  886B 32 F8 DE         ld   (velocity_y), a
 924  886E 32 FA DE         ld   (jump_pressed), a
 925  8871 32 FC DE         ld   (coyote_timer), a
 926  8874 32 FF DE         ld   (jump_frame), a
 927  8877 32 FE DE         ld   (jump_dir), a
 928  887A 32 71 E2         ld   (transition_active), a
 929  887D 32 F5 E2         ld   (willy_safety_timer), a
 930  8880 3E FF            ld   a, $ff
 931  8882 32 08 DF         ld   (digit_key_prev), a
 932  8885 3E 01            ld   a, 1
 933  8887 32 01 DF         ld   (q_prev), a
 934  888A 32 02 DF         ld   (a_prev), a
 935  888D 32 F9 DE         ld   (on_ground), a
 936  8890
 937  8890                  ; Azzeramento punteggio partita corrente (Score = 000000)
 938  8890                  ; Nota: High score viene mantenuto intatto tra le partite
 939  8890 AF               xor  a
 940  8891 32 FA E4         ld   (player_score + 0), a
 941  8894 32 FB E4         ld   (player_score + 1), a
 942  8897 32 FC E4         ld   (player_score + 2), a
 943  889A
 944  889A                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 945  889A CD 3F 81         call ResetItemsTable
 946  889D
 947  889D                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 948  889D CD 05 70         call InitRoomEntryPositions
 949  88A0
 950  88A0                  ; Aggiorna la riga di stato con High score e Score azzerato
 951  88A0 CD AE 68         call Gfx_UpdateScoreDisplay
 952  88A3
 953  88A3                  ; Ripristina la stanza iniziale (Central Cavern)
 954  88A3 21 AA 88         ld   hl, CentralCavernLayout
 955  88A6 22 6B E2         ld   (room_ptr), hl
 956  88A9
 957  88A9 C9               ret

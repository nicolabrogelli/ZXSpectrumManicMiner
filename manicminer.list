 817  85D7              ; CheckWillyConveyorCollision
 818  85D7              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 819  85D7              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 820  85D7              ; -------------------------------------------------------------------
 821  85D7              CheckWillyConveyorCollision:
 822  85D7 C5               push bc
 823  85D8 D5               push de
 824  85D9 E5               push hl
 825  85DA
 826  85DA                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 827  85DA CD 66 76         call CheckWillyOnConveyor
 828  85DD 38 49            jr   c, .collision_detected
 829  85DF
 830  85DF                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 831  85DF 3A FF 97         ld   a, (conveyor_len)
 832  85E2 B7               or   a
 833  85E3 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 834  85E5
 835  85E5                  ; B = WillyY, C = WillyX
 836  85E5 ED 4B D7 94      ld   bc, (PlayerPos)
 837  85E9
 838  85E9                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 839  85E9 3A 00 98         ld   a, (conveyor_row)
 840  85EC 87               add  a, a                  ; *2
 841  85ED 87               add  a, a                  ; *4
 842  85EE 87               add  a, a                  ; *8
 843  85EF 5F               ld   e, a                  ; E = ConveyorTop
 844  85F0 C6 07            add  a, 7
 845  85F2 57               ld   d, a                  ; D = ConveyorBottom
 846  85F3
 847  85F3                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 848  85F3 78               ld   a, b                  ; WillyTop
 849  85F4 BA               cp   d
 850  85F5 28 04            jr   z, .y_overlap
 851  85F7 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 852  85F9 18 32            jr   .no_conv_collision
 853  85FB
 854  85FB              .y_overlap:
 855  85FB C6 0F            add  a, 15                 ; WillyBottom
 856  85FD BB               cp   e
 857  85FE 28 04            jr   z, .x_check
 858  8600 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 859  8602 18 29            jr   .no_conv_collision
 860  8604
 861  8604              .x_check:
 862  8604                  ; ConveyorLeft = conveyor_col * 8
 863  8604 3A 01 98         ld   a, (conveyor_col)
 864  8607 87               add  a, a                  ; *2
 865  8608 87               add  a, a                  ; *4
 866  8609 87               add  a, a                  ; *8
 867  860A 5F               ld   e, a                  ; E = ConveyorLeft
 868  860B
 869  860B                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 870  860B 21 FF 97         ld   hl, conveyor_len
 871  860E 3A 01 98         ld   a, (conveyor_col)
 872  8611 86               add  a, (hl)
 873  8612 87               add  a, a                  ; *2
 874  8613 87               add  a, a                  ; *4
 875  8614 87               add  a, a                  ; *8
 876  8615 3D               dec  a                     ; ConveyorRight
 877  8616 57               ld   d, a                  ; D = ConveyorRight
 878  8617
 879  8617                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 880  8617 79               ld   a, c                  ; WillyLeft
 881  8618 BA               cp   d
 882  8619 28 04            jr   z, .x_overlap
 883  861B 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 884  861D 18 0E            jr   .no_conv_collision
 885  861F
 886  861F              .x_overlap:
 887  861F C6 0F            add  a, 15                 ; WillyRight
 888  8621 BB               cp   e
 889  8622 28 04            jr   z, .collision_detected
 890  8624 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 891  8626 18 05            jr   .no_conv_collision

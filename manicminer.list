 405+ 7BBE              .do_update:
 406+ 7BBE E5               push hl
 407+ 7BBF D5               push de
 408+ 7BC0 C5               push bc
 409+ 7BC1 DD E5            push ix
 410+ 7BC3
 411+ 7BC3 3E 01            ld   a, 1
 412+ 7BC5 32 6E 92         ld   (enemy_was_updated), a
 413+ 7BC8
 414+ 7BC8 DD 21 79 79      ld   ix, ActiveEnemies
 415+ 7BCC 06 08            ld   b, 8                      ; 8 slot
 416+ 7BCE              .loop:
 417+ 7BCE DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7BD1 E6 80            and  $80                       ; Active?
 419+ 7BD3 CA 72 7C         jp   z, .next
 420+ 7BD6
 421+ 7BD6                  ; 1. Aggiorna Anim State (0..3)
 422+ 7BD6 DD 7E 07         ld   a, (ix+7)
 423+ 7BD9 3C               inc  a
 424+ 7BDA E6 03            and  3
 425+ 7BDC DD 77 07         ld   (ix+7), a
 426+ 7BDF
 427+ 7BDF                  ; 2. Determina se orizzontale o verticale
 428+ 7BDF DD 7E 00         ld   a, (ix+0)
 429+ 7BE2 E6 40            and  $40                       ; Vertical?
 430+ 7BE4 C2 2E 7C         jp   nz, .vertical
 431+ 7BE7
 432+ 7BE7              .horizontal:
 433+ 7BE7 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 434+ 7BEA FE 01            cp   1
 435+ 7BEC 20 20            jr   nz, .horiz_right
 436+ 7BEE
 437+ 7BEE              .horiz_left:
 438+ 7BEE DD 7E 02         ld   a, (ix+2)                 ; Current X
 439+ 7BF1 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 440+ 7BF3 DD BE 04         cp   (ix+4)                    ; Min Limit
 441+ 7BF6 28 08            jr   z, .h_rev_right
 442+ 7BF8 38 06            jr   c, .h_rev_right
 443+ 7BFA DD 77 02         ld   (ix+2), a
 444+ 7BFD C3 72 7C         jp   .next
 445+ 7C00
 446+ 7C00              .h_rev_right:
 447+ 7C00 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 448+ 7C03 DD 77 02         ld   (ix+2), a
 449+ 7C06 3E 02            ld   a, 2
 450+ 7C08 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 451+ 7C0B C3 72 7C         jp   .next
 452+ 7C0E
 453+ 7C0E              .horiz_right:
 454+ 7C0E DD 7E 02         ld   a, (ix+2)                 ; Current X
 455+ 7C11 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 456+ 7C13 DD BE 05         cp   (ix+5)                    ; Max Limit
 457+ 7C16 28 08            jr   z, .h_rev_left
 458+ 7C18 30 06            jr   nc, .h_rev_left
 459+ 7C1A DD 77 02         ld   (ix+2), a
 460+ 7C1D C3 72 7C         jp   .next
 461+ 7C20
 462+ 7C20              .h_rev_left:
 463+ 7C20 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 464+ 7C23 DD 77 02         ld   (ix+2), a
 465+ 7C26 3E 01            ld   a, 1
 466+ 7C28 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 467+ 7C2B C3 72 7C         jp   .next
 468+ 7C2E
 469+ 7C2E              .vertical:
 470+ 7C2E DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7C31 FE 01            cp   1
 472+ 7C33 20 20            jr   nz, .vert_down
 473+ 7C35
 474+ 7C35              .vert_up:

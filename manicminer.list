2054+ 7E07 CB 3F          srl  a
2054+ 7E09 CB 3F          srl  a   ; A = Col2 (0..31)
2055+ 7E0B 4F               ld   c, a                  ; C = Col2
2056+ 7E0C
2057+ 7E0C                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
2058+ 7E0C 3A 72 EC         ld   a, (PlayerPos)        ; A = PlayerX
2059+ 7E0F CB 3F            srl  a
2059+ 7E11 CB 3F          srl  a
2059+ 7E13 CB 3F          srl  a   ; A = Col1

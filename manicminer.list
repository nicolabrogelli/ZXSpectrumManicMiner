 192+ 7D81              ; -------------------------------------------------------------------
 193+ 7D81              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7D81              ; -------------------------------------------------------------------
 195+ 7D81              Enemy_EraseRoom:
 196+ 7D81              Enemy_DrawRoom:
 197+ 7D81              Enemy_RenderRoom:
 198+ 7D81 E5               push hl
 199+ 7D82 D5               push de
 200+ 7D83 C5               push bc
 201+ 7D84 DD E5            push ix
 202+ 7D86
 203+ 7D86                  ; ---------------------------------------------------------------
 204+ 7D86                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7D86                  ; ---------------------------------------------------------------
 206+ 7D86 DD 21 43 7C      ld   ix, ActiveEnemies
 207+ 7D8A 06 08            ld   b, 8              ; 8 slot
 208+ 7D8C              .erase_loop:
 209+ 7D8C DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7D8F E6 80            and  $80               ; Active?
 211+ 7D91 28 3A            jr   z, .next_erase
 212+ 7D93
 213+ 7D93                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7D93 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7D96 FE FF            cp   $FF
 216+ 7D98 28 33            jr   z, .next_erase
 217+ 7D9A
 218+ 7D9A                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7D9A DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7D9D DD BE 02         cp   (ix+2)            ; Current X
 221+ 7DA0 20 0E            jr   nz, .do_erase_slot
 222+ 7DA2 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7DA5 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7DA8 20 06            jr   nz, .do_erase_slot
 225+ 7DAA
 226+ 7DAA 3A 73 AE         ld   a, (enemy_was_updated)
 227+ 7DAD B7               or   a
 228+ 7DAE 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7DB0
 230+ 7DB0              .do_erase_slot:
 231+ 7DB0 C5               push bc                ; Salva contatore ciclo
 232+ 7DB1
 233+ 7DB1                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7DB1 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7DB4 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7DB7 CD 5D 7D         call CheckEnemyWillyOverlap
 237+ 7DBA
 238+ 7DBA                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7DBA DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7DBD DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7DC0 CD BD 5F         call Gfx_ErasePixelSprite16x16
 242+ 7DC3 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7DC6 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7DC9 CD 73 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7DCC
 246+ 7DCC C1               pop  bc
 247+ 7DCD
 248+ 7DCD              .next_erase:
 249+ 7DCD 11 0B 00         ld   de, 11
 250+ 7DD0 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7DD2 05               dec  b
 252+ 7DD3 20 B7            jr   nz, .erase_loop
 253+ 7DD5
 254+ 7DD5                  ; ---------------------------------------------------------------
 255+ 7DD5                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7DD5                  ; ---------------------------------------------------------------
 257+ 7DD5 DD 21 43 7C      ld   ix, ActiveEnemies
 258+ 7DD9 06 08            ld   b, 8              ; 8 slot
 259+ 7DDB              .draw_loop:
 260+ 7DDB DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7DDE E6 80            and  $80               ; Active?
 262+ 7DE0 28 37            jr   z, .next_draw
 263+ 7DE2
 264+ 7DE2                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7DE2 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7DE5 FE FF            cp   $FF
 267+ 7DE7 28 16            jr   z, .do_draw_slot
 268+ 7DE9
 269+ 7DE9                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7DE9 DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7DEC DD BE 02         cp   (ix+2)            ; Current X
 272+ 7DEF 20 0E            jr   nz, .do_draw_slot
 273+ 7DF1 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7DF4 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7DF7 20 06            jr   nz, .do_draw_slot
 276+ 7DF9
 277+ 7DF9 3A 73 AE         ld   a, (enemy_was_updated)
 278+ 7DFC B7               or   a
 279+ 7DFD 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7DFF
 281+ 7DFF              .do_draw_slot:
 282+ 7DFF C5               push bc                ; Salva contatore ciclo
 283+ 7E00
 284+ 7E00                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7E00 CD 2B 7E         call Enemy_DrawSingleSlot
 286+ 7E03
 287+ 7E03                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 288+ 7E03 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 289+ 7E06 DD 46 03         ld   b, (ix+3)         ; B = Current Y
 290+ 7E09 CD 5D 7D         call CheckEnemyWillyOverlap
 291+ 7E0C
 292+ 7E0C                  ; Salva le coordinate effettivamente disegnate
 293+ 7E0C DD 7E 02         ld   a, (ix+2)
 294+ 7E0F DD 77 08         ld   (ix+8), a         ; Old X = Current X
 295+ 7E12 DD 7E 03         ld   a, (ix+3)
 296+ 7E15 DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 297+ 7E18
 298+ 7E18 C1               pop  bc
 299+ 7E19
 300+ 7E19              .next_draw:
 301+ 7E19 11 0B 00         ld   de, 11
 302+ 7E1C DD 19            add  ix, de            ; Prossimo slot (11 byte)
 303+ 7E1E 05               dec  b
 304+ 7E1F 20 BA            jr   nz, .draw_loop
 305+ 7E21
 306+ 7E21 AF               xor  a
 307+ 7E22 32 73 AE         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 308+ 7E25
 309+ 7E25 DD E1            pop  ix
 310+ 7E27 C1               pop  bc
 311+ 7E28 D1               pop  de
 312+ 7E29 E1               pop  hl
 313+ 7E2A C9               ret

1314+ 7ABD              ; -------------------------------------------------------------------
1315+ 7ABD              ; Legge il tipo di cella dal buffer decompresso in RAM
1316+ 7ABD              ; Input: A = Row (0..15), C = Col (0..31)
1317+ 7ABD              ; Output: A = tipo di cella (0..3)
1318+ 7ABD              ; Preserva tutti gli altri registri.
1319+ 7ABD              ; -------------------------------------------------------------------
1320+ 7ABD              GetCellFromUnpacked:
1321+ 7ABD E5               push hl
1322+ 7ABE D5               push de
1323+ 7ABF
1324+ 7ABF 6F               ld   l, a
1325+ 7AC0 26 00            ld   h, 0
1326+ 7AC2 29               add  hl, hl
1327+ 7AC3 29               add  hl, hl
1328+ 7AC4 29               add  hl, hl
1329+ 7AC5 29               add  hl, hl
1330+ 7AC6 29               add  hl, hl            ; HL = Row * 32
1331+ 7AC7 59               ld   e, c
1332+ 7AC8 16 00            ld   d, 0
1333+ 7ACA 19               add  hl, de            ; HL = Row * 32 + Col
1334+ 7ACB 11 CA EC         ld   de, unpacked_layout
1335+ 7ACE 19               add  hl, de
1336+ 7ACF 7E               ld   a, (hl)           ; A = cell type
1337+ 7AD0
1338+ 7AD0 D1               pop  de
1339+ 7AD1 E1               pop  hl
1340+ 7AD2 C9               ret

2217+ 692D 77               ld   (hl), a
2218+ 692E 23               inc  hl
2219+ 692F
2220+ 692F                  ; Cifra 1 (decine di migliaia)
2221+ 692F DD 7E 02         ld   a, (ix+2)
2222+ 6932 E6 0F            and  $0f
2223+ 6934 C6 30            add  a, '0'
2224+ 6936 77               ld   (hl), a
2225+ 6937 23               inc  hl

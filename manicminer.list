 708  8294              ; CheckAllItemsCollected
 709  8294              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 710  8294              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 711  8294              ; -------------------------------------------------------------------
 712  8294              CheckAllItemsCollected:
 713  8294 3A BC 93         ld   a, (game_objective_completed)
 714  8297 B7               or   a
 715  8298 20 07            jr   nz, .all_collected
 716  829A 3A B1 8D         ld   a, (items_collected)
 717  829D FE 05            cp   TOTAL_ITEMS
 718  829F 38 02            jr   c, .not_all
 719  82A1              .all_collected:
 720  82A1 37               scf
 721  82A2 C9               ret
 722  82A3              .not_all:
 723  82A3 B7               or   a
 724  82A4 C9               ret
 725  82A5

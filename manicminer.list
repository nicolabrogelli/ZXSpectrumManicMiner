 213+ 848D
 214+ 848D                  ; Col = Offset & 31
 215+ 848D 7D               ld   a, l
 216+ 848E E6 1F            and  31
 217+ 8490 4F               ld   c, a                      ; C = Col (0..31)
 218+ 8491
 219+ 8491                  ; Row = Offset / 32
 220+ 8491 CB 3C            srl  h
 220+ 8493 CB 1D          rr l
 221+ 8495 CB 3C            srl  h
 221+ 8497 CB 1D          rr l
 222+ 8499 CB 3C            srl  h
 222+ 849B CB 1D          rr l
 223+ 849D CB 3C            srl  h
 223+ 849F CB 1D          rr l
 224+ 84A1 CB 3C            srl  h
 224+ 84A3 CB 1D          rr l
 225+ 84A5 7D               ld   a, l
 226+ 84A6 47               ld   b, a                      ; B = Row (0..15)
 227+ 84A7
 228+ 84A7                  ; Disegna l'item sullo schermo
 229+ 84A7 DD E5            push ix
 230+ 84A9 E1               pop  hl                        ; HL = puntatore bitmap

  72+ 8422 ~            ; Audio_UpdateMusic
  73+ 8422 ~            ;
  74+ 8422 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8422 ~            ; Viene chiamata a ogni frame.
  76+ 8422 ~            ; -------------------------------------------------------------------
  77+ 8422 ~            Audio_UpdateMusic:
  78+ 8422 ~                push af
  79+ 8422 ~                push bc
  80+ 8422 ~                push de
  81+ 8422 ~                push hl
  82+ 8422 ~
  83+ 8422 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8422 ~                ld   a, (Audio_jump_sound_note)
  85+ 8422 ~                cp   18
  86+ 8422 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8422 ~
  88+ 8422 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8422 ~                ld   a, (Audio_music_frame_counter)
  90+ 8422 ~                dec  a
  91+ 8422 ~                ld   (Audio_music_frame_counter), a
  92+ 8422 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8422 ~
  94+ 8422 ~                ; Altrimenti carica la nota successiva
  95+ 8422 ~                ld   a, (Audio_music_note_idx)
  96+ 8422 ~                inc  a
  97+ 8422 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8422 ~                jr   c, .no_wrap
  99+ 8422 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8422 ~            .no_wrap:
 101+ 8422 ~                ld   (Audio_music_note_idx), a
 102+ 8422 ~
 103+ 8422 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8422 ~                ld   e, a
 105+ 8422 ~                ld   d, 0
 106+ 8422 ~                ld   hl, Audio_MusicSheet
 107+ 8422 ~                add  hl, de
 108+ 8422 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8422 ~
 110+ 8422 ~                ; Leggi durata (secondo byte)
 111+ 8422 ~                inc  hl
 112+ 8422 ~                ld   a, (hl)
 113+ 8422 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8422 ~                jr   nz, .dur_ok
 115+ 8422 ~                ld   a, 1
 116+ 8422 ~            .dur_ok:
 117+ 8422 ~                ld   (Audio_music_frame_counter), a
 118+ 8422 ~
 119+ 8422 ~            .play_current_note:
 120+ 8422 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8422 ~                ld   a, (Audio_music_note_idx)
 122+ 8422 ~                ld   e, a
 123+ 8422 ~                ld   d, 0
 124+ 8422 ~                ld   hl, Audio_MusicSheet
 125+ 8422 ~                add  hl, de
 126+ 8422 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8422 ~                ld   a, (hl)                  ; A = delay
 128+ 8422 ~                or   a
 129+ 8422 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8422 ~
 131+ 8422 ~                ; Suona la nota: 2 cicli
 132+ 8422 ~                ld   d, a                     ; D = delay
 133+ 8422 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8422 ~            .note_loop:
 135+ 8422 ~                ; Speaker ON
 136+ 8422 ~                ld   a, (room_border_color)
 137+ 8422 ~                or   $10
 138+ 8422 ~                out  ($fe), a
 139+ 8422 ~                ld   c, d
 140+ 8422 ~            .d1:
 141+ 8422 ~                push af
 142+ 8422 ~                pop  af
 143+ 8422 ~                dec  c
 144+ 8422 ~                jr   nz, .d1
 145+ 8422 ~
 146+ 8422 ~                ; Speaker OFF
 147+ 8422 ~                ld   a, (room_border_color)
 148+ 8422 ~                and  $ef
 149+ 8422 ~                out  ($fe), a
 150+ 8422 ~                ld   c, d
 151+ 8422 ~            .d2:
 152+ 8422 ~                push af
 153+ 8422 ~                pop  af
 154+ 8422 ~                dec  c
 155+ 8422 ~                jr   nz, .d2
 156+ 8422 ~
 157+ 8422 ~                djnz .note_loop
 158+ 8422 ~
 159+ 8422 ~            .done:
 160+ 8422 ~                pop  hl
 161+ 8422 ~                pop  de
 162+ 8422 ~                pop  bc
 163+ 8422 ~                pop  af
 164+ 8422 ~                ret
 165+ 8422 ~
 166+ 8422 ~            Audio_MusicSheet:
 167+ 8422 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8422 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8422 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8422 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8422 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5

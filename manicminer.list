   8+ 6E84              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6E84              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6E84              ; con i muri.
  11+ 6E84              ;
  12+ 6E84              ; Input:
  13+ 6E84              ;   D = stato dei controlli (bitfield)
  14+ 6E84              ;
  15+ 6E84              ; Strutture utilizzate:
  16+ 6E84              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6E84              ;   player_speed    -> velocità orizzontale
  18+ 6E84              ;   flags           -> flag di stato input
  19+ 6E84              ;
  20+ 6E84              ; Bit controlli:
  21+ 6E84              ;   bit 0 = sinistra
  22+ 6E84              ;   bit 1 = destra
  23+ 6E84              ;
  24+ 6E84              ; Nota:
  25+ 6E84              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6E84              ;   ignorato per tutta la durata del salto.
  27+ 6E84              ;
  28+ 6E84              ; Output:
  29+ 6E84              ;   aggiorna PlayerPos e body_state
  30+ 6E84              ; -------------------------------------------------------------------
  31+ 6E84              MovePlayer:
  32+ 6E84
  33+ 6E84                  ; ---------------------------------------------------------------
  34+ 6E84                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6E84                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6E84                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6E84                  ; ---------------------------------------------------------------
  38+ 6E84 3A FC E1         ld   a, (on_ground)
  39+ 6E87 B7               or   a
  40+ 6E88 20 20            jr   nz, .on_ground_check
  41+ 6E8A
  42+ 6E8A                  ; In aria: resetta lo stato di cattura del nastro
  43+ 6E8A AF               xor  a
  44+ 6E8B 32 18 E5         ld   (conveyor_caught), a
  45+ 6E8E
  46+ 6E8E 3A 01 E2         ld   a, (jump_dir)
  47+ 6E91 B7               or   a
  48+ 6E92 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  49+ 6E93
  50+ 6E93                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  51+ 6E93 DD 21 F5 E1      ld   ix, flags
  52+ 6E97 DD CB 00 86      res  $00, (ix)
  53+ 6E9B
  54+ 6E9B ED 4B ED E1      ld   bc, (PlayerPos)
  55+ 6E9F FE 01            cp   1
  56+ 6EA1 CA 2F 6F         jp   z, movePlayer_left
  57+ 6EA4 FE 02            cp   2
  58+ 6EA6 CA 65 6F         jp   z, movePlayer_right
  59+ 6EA9 C9               ret

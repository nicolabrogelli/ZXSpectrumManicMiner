 383+ 701B 87               add  a, a                      ; *4
 384+ 701C 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 385+ 701D 4F               ld   c, a                      ; C = PlayerX
 386+ 701E 42               ld   b, d                      ; B = PlayerY
 387+ 701F
 388+ 701F                  ; Salva coordinate (C = X, B = Y)

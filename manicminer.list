 102+ A422              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 103+ A422 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 104+ A423 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 105+ A424 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria

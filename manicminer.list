 561+ 8262 3E 01            ld   a, 1
 562+ 8264 32 48 A4         ld   (game_objective_completed), a
 563+ 8267              .no_dec_room:
 564+ 8267
 565+ 8267                  ; Incrementa il conteggio globale degli item raccolti

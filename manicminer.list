 763+ 8776
 764+ 8776 FD 21 54 ED      ld   iy, current_room_items
 765+ 877A
 766+ 877A              .anim_loop:
 767+ 877A FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 877D FE FF            cp   $FF
 769+ 877F 28 35            jr   z, .anim_done
 770+ 8781 B7               or   a
 771+ 8782 28 2B            jr   z, .next_anim_item
 772+ 8784
 773+ 8784                  ; Routine originale $8F63 di Manic Miner:
 774+ 8784                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 8784 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 8786 F6 03            or   $03                       ; Base Ink = 3
 777+ 8788 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 8789 FD 7E 02         ld   a, (iy+2)
 779+ 878C E6 03            and  $03                       ; Isola offset rotazione
 780+ 878E 80               add  a, b                      ; A = Nuovo attributo
 781+ 878F FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 8792 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8793
 784+ 8793                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8793 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 8796 16 00            ld   d, 0
 787+ 8798 26 00            ld   h, 0
 788+ 879A FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 879D 29               add  hl, hl
 790+ 879E 29               add  hl, hl
 791+ 879F 29               add  hl, hl
 792+ 87A0 29               add  hl, hl
 793+ 87A1 29               add  hl, hl                    ; Row * 32
 794+ 87A2 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 87A3
 796+ 87A3                  ; Aggiorna items_grid
 797+ 87A3 E5               push hl
 798+ 87A4 11 24 E8         ld   de, items_grid
 799+ 87A7 19               add  hl, de
 800+ 87A8 70               ld   (hl), b
 801+ 87A9 E1               pop  hl
 802+ 87AA
 803+ 87AA                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 87AA 11 00 58         ld   de, $5800
 805+ 87AD 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 87AE 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 87AF
 808+ 87AF              .next_anim_item:
 809+ 87AF 01 05 00         ld   bc, 5
 810+ 87B2 FD 09            add  iy, bc
 811+ 87B4 18 C4            jr   .anim_loop

 963+ 77D5              ; -------------------------------------------------------------------
 964+ 77D5              CheckWallCell:
 965+ 77D5 E5               push hl
 966+ 77D6 D5               push de
 967+ 77D7 C5               push bc
 968+ 77D8
 969+ 77D8                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77D8 78               ld   a, b
 971+ 77D9 FE 80            cp   128
 972+ 77DB 30 1F            jr   nc, .not_wall
 973+ 77DD

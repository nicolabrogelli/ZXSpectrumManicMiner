 660+ 8295              ; Score_CheckAndUpdateHighScore
 661+ 8295              ; Se player_score > high_score, copia player_score in high_score.
 662+ 8295              ; -------------------------------------------------------------------
 663+ 8295              Score_CheckAndUpdateHighScore:
 664+ 8295                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 8295                  ; Byte 2:
 666+ 8295 3A 16 A4         ld   a, (player_score + 2)
 667+ 8298 47               ld   b, a
 668+ 8299 3A 19 A4         ld   a, (high_score + 2)
 669+ 829C B8               cp   b
 670+ 829D 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 829F 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 82A1
 673+ 82A1                  ; Byte 1:
 674+ 82A1 3A 15 A4         ld   a, (player_score + 1)
 675+ 82A4 47               ld   b, a
 676+ 82A5 3A 18 A4         ld   a, (high_score + 1)
 677+ 82A8 B8               cp   b
 678+ 82A9 38 0C            jr   c, .new_high_score
 679+ 82AB 20 1C            jr   nz, .done_check
 680+ 82AD
 681+ 82AD                  ; Byte 0:
 682+ 82AD 3A 14 A4         ld   a, (player_score + 0)
 683+ 82B0 47               ld   b, a
 684+ 82B1 3A 17 A4         ld   a, (high_score + 0)
 685+ 82B4 B8               cp   b
 686+ 82B5 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 82B7
 688+ 82B7              .new_high_score:
 689+ 82B7 3A 14 A4         ld   a, (player_score + 0)
 690+ 82BA 32 17 A4         ld   (high_score + 0), a
 691+ 82BD 3A 15 A4         ld   a, (player_score + 1)
 692+ 82C0 32 18 A4         ld   (high_score + 1), a
 693+ 82C3 3A 16 A4         ld   a, (player_score + 2)
 694+ 82C6 32 19 A4         ld   (high_score + 2), a
 695+ 82C9
 696+ 82C9              .done_check:
 697+ 82C9 C9               ret

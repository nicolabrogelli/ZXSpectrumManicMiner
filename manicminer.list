 728+ 86A9                  ; Byte 0:
 729+ 86A9 3A 1A E8         ld   a, (player_score + 0)
 730+ 86AC 47               ld   b, a
 731+ 86AD 3A 1D E8         ld   a, (high_score + 0)
 732+ 86B0 B8               cp   b
 733+ 86B1 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

1160+ 78CA 38 17            jr   c, .collision
1161+ 78CC
1162+ 78CC                  ; 2. Punto medio: (X, Y + 7)
1163+ 78CC 78               ld   a, b
1164+ 78CD C6 07            add  a, 7
1165+ 78CF 47               ld   b, a

   8+ 884E              ; Audio_UpdateJumpSound
   9+ 884E              ;
  10+ 884E              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 884E              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 884E              ; -------------------------------------------------------------------
  13+ 884E              Audio_UpdateJumpSound:
  14+ 884E F5               push af
  15+ 884F C5               push bc
  16+ 8850 D5               push de
  17+ 8851 E5               push hl
  18+ 8852
  19+ 8852                  ; Controlla se il suono è attivo (note < 18)
  20+ 8852 3A D6 F0         ld   a, (Audio_jump_sound_note)
  21+ 8855 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8857 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8859
  24+ 8859                  ; Carica la nota corrente da suonare
  25+ 8859 5F               ld   e, a
  26+ 885A 16 00            ld   d, 0
  27+ 885C 21 88 88         ld   hl, Audio_JumpSoundDelays
  28+ 885F 19               add  hl, de
  29+ 8860 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8861 57               ld   d, a                      ; D = delay della nota
  31+ 8862
  32+ 8862                  ; Suona la nota: 15 cicli
  33+ 8862 06 0F            ld   b, 15
  34+ 8864              .note_loop:
  35+ 8864                  ; Speaker ON
  36+ 8864 3A C2 EA         ld   a, (room_border_color)
  37+ 8867 F6 10            or   $10
  38+ 8869 D3 FE            out  ($fe), a
  39+ 886B 4A               ld   c, d
  40+ 886C              .d1:
  41+ 886C 0D               dec  c
  42+ 886D 20 FD            jr   nz, .d1
  43+ 886F
  44+ 886F                  ; Speaker OFF
  45+ 886F 3A C2 EA         ld   a, (room_border_color)
  46+ 8872 E6 EF            and  $ef
  47+ 8874 D3 FE            out  ($fe), a
  48+ 8876 4A               ld   c, d
  49+ 8877              .d2:
  50+ 8877 0D               dec  c
  51+ 8878 20 FD            jr   nz, .d2
  52+ 887A
  53+ 887A 10 E8            djnz .note_loop
  54+ 887C
  55+ 887C                  ; Passa alla nota successiva
  56+ 887C 3A D6 F0         ld   a, (Audio_jump_sound_note)
  57+ 887F 3C               inc  a
  58+ 8880 32 D6 F0         ld   (Audio_jump_sound_note), a
  59+ 8883
  60+ 8883              .done:
  61+ 8883 E1               pop  hl
  62+ 8884 D1               pop  de
  63+ 8885 C1               pop  bc
  64+ 8886 F1               pop  af
  65+ 8887 C9               ret

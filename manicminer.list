  72+ 8330 ~            ; Audio_UpdateMusic
  73+ 8330 ~            ;
  74+ 8330 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8330 ~            ; Viene chiamata a ogni frame.
  76+ 8330 ~            ; -------------------------------------------------------------------
  77+ 8330 ~            Audio_UpdateMusic:
  78+ 8330 ~                push af
  79+ 8330 ~                push bc
  80+ 8330 ~                push de
  81+ 8330 ~                push hl
  82+ 8330 ~
  83+ 8330 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8330 ~                ld   a, (Audio_jump_sound_note)
  85+ 8330 ~                cp   18
  86+ 8330 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8330 ~
  88+ 8330 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8330 ~                ld   a, (Audio_music_frame_counter)
  90+ 8330 ~                dec  a
  91+ 8330 ~                ld   (Audio_music_frame_counter), a
  92+ 8330 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8330 ~
  94+ 8330 ~                ; Altrimenti carica la nota successiva
  95+ 8330 ~                ld   a, (Audio_music_note_idx)
  96+ 8330 ~                inc  a
  97+ 8330 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8330 ~                jr   c, .no_wrap
  99+ 8330 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8330 ~            .no_wrap:
 101+ 8330 ~                ld   (Audio_music_note_idx), a
 102+ 8330 ~
 103+ 8330 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8330 ~                ld   e, a
 105+ 8330 ~                ld   d, 0
 106+ 8330 ~                ld   hl, Audio_MusicSheet
 107+ 8330 ~                add  hl, de
 108+ 8330 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8330 ~
 110+ 8330 ~                ; Leggi durata (secondo byte)
 111+ 8330 ~                inc  hl
 112+ 8330 ~                ld   a, (hl)
 113+ 8330 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8330 ~                jr   nz, .dur_ok
 115+ 8330 ~                ld   a, 1
 116+ 8330 ~            .dur_ok:
 117+ 8330 ~                ld   (Audio_music_frame_counter), a
 118+ 8330 ~
 119+ 8330 ~            .play_current_note:
 120+ 8330 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8330 ~                ld   a, (Audio_music_note_idx)
 122+ 8330 ~                ld   e, a
 123+ 8330 ~                ld   d, 0
 124+ 8330 ~                ld   hl, Audio_MusicSheet
 125+ 8330 ~                add  hl, de
 126+ 8330 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8330 ~                ld   a, (hl)                  ; A = delay
 128+ 8330 ~                or   a
 129+ 8330 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8330 ~
 131+ 8330 ~                ; Suona la nota: 2 cicli
 132+ 8330 ~                ld   d, a                     ; D = delay
 133+ 8330 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8330 ~            .note_loop:
 135+ 8330 ~                ; Speaker ON
 136+ 8330 ~                ld   a, (room_border_color)
 137+ 8330 ~                or   $10
 138+ 8330 ~                out  ($fe), a
 139+ 8330 ~                ld   c, d
 140+ 8330 ~            .d1:
 141+ 8330 ~                push af
 142+ 8330 ~                pop  af
 143+ 8330 ~                dec  c
 144+ 8330 ~                jr   nz, .d1
 145+ 8330 ~
 146+ 8330 ~                ; Speaker OFF
 147+ 8330 ~                ld   a, (room_border_color)
 148+ 8330 ~                and  $ef
 149+ 8330 ~                out  ($fe), a
 150+ 8330 ~                ld   c, d
 151+ 8330 ~            .d2:
 152+ 8330 ~                push af
 153+ 8330 ~                pop  af
 154+ 8330 ~                dec  c
 155+ 8330 ~                jr   nz, .d2
 156+ 8330 ~
 157+ 8330 ~                djnz .note_loop
 158+ 8330 ~
 159+ 8330 ~            .done:
 160+ 8330 ~                pop  hl
 161+ 8330 ~                pop  de
 162+ 8330 ~                pop  bc
 163+ 8330 ~                pop  af
 164+ 8330 ~                ret
 165+ 8330 ~
 166+ 8330 ~            Audio_MusicSheet:
 167+ 8330 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8330 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8330 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8330 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8330 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8330 ~                db 90, 10, 107, 20, 68, 65
 173+ 8330                  ELSE
 174+ 8330              Audio_UpdateMusic:
 175+ 8330 C9               ret

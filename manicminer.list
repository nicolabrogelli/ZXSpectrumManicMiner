 511  85ED 32 3D A2         ld   (willy_safety_timer), a
 512  85F0
 513  85F0                  ; - Ripristina lo stato audio
 514  85F0 3E 12            ld   a, 18
 515  85F2 32 4E A4         ld   (Audio_jump_sound_note), a
 516  85F5 AF               xor  a
 517  85F6 32 4F A4         ld   (Audio_jump_sound_timer), a
 518  85F9                  IF ENABLE_MUSIC != 0
 519  85F9 ~                ld   (Audio_music_note_idx), a
 520  85F9 ~                ld   a, 1
 521  85F9 ~                ld   (Audio_music_frame_counter), a
 522  85F9                  ENDIF
 523  85F9
 524  85F9                  ; - Riposiziona Willy nel punto di default definito nella stanza
 525  85F9 AF               xor  a
 526  85FA 32 B9 A1         ld   (transition_active), a
 527  85FD
 528  85FD                  ; - Cancella lo schermo a nero prima del caricamento

 386  81B2 ED 78            in   a, (c)
 387  81B4 CB 47            bit  0, a
 388  81B6 28 E4            jr   z, .wait_keys_release
 389  81B8
 390  81B8                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER

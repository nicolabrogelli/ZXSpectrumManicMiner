 471+ 84A8 78               ld   a, b                      ; A = WillyY
 472+ 84A9 BA               cp   d                         ; D = ItemBottom
 473+ 84AA 28 04            jr   z, .y_ok
 474+ 84AC 38 02            jr   c, .y_ok
 475+ 84AE 18 13            jr   .no_collision
 476+ 84B0
 477+ 84B0              .y_ok:
 478+ 84B0                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 84B0 BB               cp   e                         ; E = ItemTop
 480+ 84B1 28 0B            jr   z, .collision
 481+ 84B3 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 84B5
 483+ 84B5                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 84B5 C6 0F            add  a, 15
 485+ 84B7 BB               cp   e

   2+ 5DAD              ; settings.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Impostazioni e flag di configurazione a tempo di compilazione per .
   5+ 5DAD              ; Ogni flag può essere abilitato (1) o disabilitato (0).
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DENABLE_MUSIC=0 -DENABLE_ROOM_SKIP_KEYS=0).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Effetti di sottofondo ---
  11+ 5DAD              ; 1 = Effetti abilitati
  12+ 5DAD              ; 0 = Effetti disabilitati
  13+ 5DAD                  IFNDEF ENABLE_EFFECTS
  14+ 5DAD              ENABLE_EFFECTS EQU 0
  15+ 5DAD                  ENDIF
  16+ 5DAD
  17+ 5DAD              ; --- Musica di sottofondo ---
  18+ 5DAD              ; 1 = Musica abilitata
  19+ 5DAD              ; 0 = Musica disabilitata
  20+ 5DAD                  IFNDEF ENABLE_MUSIC
  21+ 5DAD              ENABLE_MUSIC EQU 0
  22+ 5DAD                  ENDIF
  23+ 5DAD
  24+ 5DAD              ; --- Morte per collisione con i guardiani (nemici) ---
  25+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite alla collisione con i guardiani
  26+ 5DAD              ; 0 = Disabilita la morte
  27+ 5DAD                  IFNDEF ENABLE_GUARDIAN_COLLISION_DEATH
  28+ 5DAD              ENABLE_GUARDIAN_COLLISION_DEATH EQU 1
  29+ 5DAD                  ENDIF
  30+ 5DAD
  31+ 5DAD              ; --- Bande colorate di debug per collisione con i guardiani ---
  32+ 5DAD              ; 1 = Abilita le bande colorate (raster bar) sul bordo alla collisione con i guardiani (quando la morte è disabilitata)
  33+ 5DAD              ; 0 = Disabilita le bande colorate di debug per i guardiani
  34+ 5DAD                  IFNDEF ENABLE_GUARDIAN_DEBUG_BARS
  35+ 5DAD              ENABLE_GUARDIAN_DEBUG_BARS EQU 1
  36+ 5DAD                  ENDIF
  37+ 5DAD
  38+ 5DAD              ; --- Morte per collisione con gli elementi Nasty (tiles pericolose) ---
  39+ 5DAD              ; 1 = Abilita la morte e il decremento delle vite al tocco delle Nasty tiles
  40+ 5DAD              ; 0 = Disabilita il controllo di morte sulle Nasty tiles
  41+ 5DAD                  IFNDEF ENABLE_NASTY_COLLISION_DEATH
  42+ 5DAD              ENABLE_NASTY_COLLISION_DEATH EQU 1
  43+ 5DAD                  ENDIF
  44+ 5DAD
  45+ 5DAD              ; --- Animazione delle icone delle vite ---
  46+ 5DAD              ; 1 = Abilita l'animazione camminante per le icone delle vite in basso a schermo
  47+ 5DAD              ; 0 = Icone delle vite statiche
  48+ 5DAD                  IFNDEF ENABLE_ANIMATE_LIVES
  49+ 5DAD              ENABLE_ANIMATE_LIVES EQU 0
  50+ 5DAD                  ENDIF
  51+ 5DAD
  52+ 5DAD              ; --- Tasti di navigazione rapida tra le stanze (Q / A) ---
  53+ 5DAD              ; 1 = Abilita i tasti Q (stanza successiva) e A (stanza precedente) per scorrere tra le stanze
  54+ 5DAD              ; 0 = Disabilita i tasti Q e A
  55+ 5DAD                  IFNDEF ENABLE_ROOM_SKIP_KEYS
  56+ 5DAD              ENABLE_ROOM_SKIP_KEYS EQU 1
  57+ 5DAD                  ENDIF
  58+ 5DAD
  59+ 5DAD              ; --- Bande colorate di debug per Willy su rampa ---
  60+ 5DAD              ; 1 = Abilita le bande colorate (raster bar) sul bordo quando Willy si trova posizionato su una rampa
  61+ 5DAD              ; 0 = Disabilita le bande colorate di debug per le rampe
  62+ 5DAD                  IFNDEF ENABLE_RAMP_DEBUG_BARS
  63+ 5DAD              ENABLE_RAMP_DEBUG_BARS EQU 0
  64+ 5DAD                  ENDIF
  65+ 5DAD
  66+ 5DAD
  67+ 5DAD              ; --- Riavvio del gioco al Game Over quando Willy esaurisce tutte le vite ---
  68+ 5DAD              ; 1 = Abilita la schermata di Game Over e il riavvio completo dal primo livello quando le vite finiscono
  69+ 5DAD              ; 0 = Disabilita il riavvio (Willy respawna normalmente mantenendo 1 vita senza azzerare la partita)
  70+ 5DAD                  IFNDEF ENABLE_GAME_OVER_RESTART
  71+ 5DAD              ENABLE_GAME_OVER_RESTART EQU 1
  72+ 5DAD                  ENDIF
  73+ 5DAD
  74+ 5DAD              ; --- Velocità dell'orologio di gioco (Test rapido) ---
  75+ 5DAD              ; 1 = Modalità Test rapido (1 secondo reale = 1 minuto di gioco, 50 tick IM2 a 50Hz)
  76+ 5DAD              ; 0 = Modalità Normale (40 secondi reali = 1 minuto di gioco, 2000 tick IM2 a 50Hz)
  77+ 5DAD                  IFNDEF ENABLE_FAST_CLOCK_TEST
  78+ 5DAD              ENABLE_FAST_CLOCK_TEST EQU 0
  79+ 5DAD                  ENDIF
  80+ 5DAD
  81+ 5DAD                  IF ENABLE_FAST_CLOCK_TEST != 0
  82+ 5DAD ~            CLOCK_TICKS_PER_MINUTE EQU 50    ; Test rapido: 1 secondo reale = 1 minuto di gioco
  83+ 5DAD                  ELSE
  84+ 5DAD              CLOCK_TICKS_PER_MINUTE EQU 2000  ; Normale: 40 secondi reali = 1 minuto di gioco
  85+ 5DAD                  ENDIF
  86+ 5DAD
  87+ 5DAD              ; --- Sprite Vecchia (Maria) nella Master Bedroom ---
  88+ 5DAD              ; 1 = Mostra lo sprite della Vecchia nella stanza Master Bedroom (comportamento originale)
  89+ 5DAD              ; 0 = Non far comparire lo sprite della Vecchia nella Master Bedroom
  90+ 5DAD              ;    IFNDEF ENABLE_MASTER_BEDROOM_VECCHIA
  91+ 5DAD              ;ENABLE_MASTER_BEDROOM_VECCHIA EQU 1
  92+ 5DAD              ;    ENDIF
  93+ 5DAD
  94+ 5DAD              ; --- Schermata di vittoria al completamento del gioco ---
  95+ 5DAD              ; 1 = Abilita la schermata di vittoria quando Willy raccoglie tutti gli item ed entra nel letto (conveyor) in Master Bedroom
  96+ 5DAD              ; 0 = Disabilita la schermata di vittoria
  97+ 5DAD                  IFNDEF ENABLE_VICTORY_SCREEN
  98+ 5DAD              ENABLE_VICTORY_SCREEN EQU 1
  99+ 5DAD                  ENDIF

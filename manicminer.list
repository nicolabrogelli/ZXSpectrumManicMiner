 513  86E9                  ; - Riposiziona Willy nel punto di default definito nella stanza
 514  86E9 AF               xor  a
 515  86EA 32 90 E2         ld   (transition_active), a
 516  86ED
 517  86ED                  ; - Cancella lo schermo a nero prima del caricamento
 518  86ED AF               xor  a
 519  86EE D3 FE            out  ($fe), a
 520  86F0 CD 99 62         call Gfx_ClearScreenDirect
 521  86F3
 522  86F3                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 523  86F3 C3 91 84         jp   LoadRoomAndRestart
 524  86F6
 525  86F6              ; -------------------------------------------------------------------
 526  86F6              ; TriggerVictory
 527  86F6              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  86F6              ; - Pulisce gli elementi di gioco della stanza.
 529  86F6              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  86F6              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  86F6              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  86F6              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  86F6              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  86F6              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  86F6              ; -------------------------------------------------------------------
 536  86F6              TriggerVictory:
 537  86F6                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  86F6 CD F3 66         call Gfx_DrawVictoryScreen
 539  86F9
 540  86F9                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  86F9              .wait_keys_release:
 542  86F9 76               halt
 543  86FA                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  86FA 01 FE DF         ld   bc, $dffe
 545  86FD ED 78            in   a, (c)
 546  86FF CB 67            bit  4, a
 547  8701 28 F6            jr   z, .wait_keys_release
 548  8703
 549  8703                  ; Controlla tasto N (Porta $7F, bit 3)
 550  8703 01 FE 7F         ld   bc, $7ffe
 551  8706 ED 78            in   a, (c)
 552  8708 CB 5F            bit  3, a
 553  870A 28 ED            jr   z, .wait_keys_release
 554  870C
 555  870C                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  870C 01 FE BF         ld   bc, $bffe
 557  870F ED 78            in   a, (c)
 558  8711 CB 47            bit  0, a
 559  8713 28 E4            jr   z, .wait_keys_release
 560  8715
 561  8715                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  8715 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  8717              .wait_choice_loop:
 564  8717 76               halt
 565  8718
 566  8718                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  8718 0C               inc  c
 568  8719 79               ld   a, c
 569  871A CB 3F            srl  a
 570  871C CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  871E E6 07            and  7
 572  8720 5F               ld   e, a
 573  8721 16 00            ld   d, 0
 574  8723 21 0D 66         ld   hl, victory_color_table
 575  8726 19               add  hl, de
 576  8727 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  8728 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  872B 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  872D              .color_cycle_loop:
 580  872D 77               ld   (hl), a
 581  872E 23               inc  hl
 582  872F 10 FC            djnz .color_cycle_loop
 583  8731
 584  8731                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  8731 01 FE DF         ld   bc, $dffe
 586  8734 ED 78            in   a, (c)
 587  8736 CB 67            bit  4, a
 588  8738 28 2A            jr   z, .play_again_chosen
 589  873A
 590  873A                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  873A 01 FE 7F         ld   bc, $7ffe
 592  873D ED 78            in   a, (c)
 593  873F CB 5F            bit  3, a
 594  8741 28 0B            jr   z, .quit_chosen
 595  8743
 596  8743                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  8743 01 FE BF         ld   bc, $bffe
 598  8746 ED 78            in   a, (c)
 599  8748 CB 47            bit  0, a
 600  874A 28 02            jr   z, .quit_chosen
 601  874C
 602  874C 18 C9            jr   .wait_choice_loop
 603  874E
 604  874E              .quit_chosen:
 605  874E                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  874E              .wait_quit_release:
 607  874E 76               halt
 608  874F 01 FE 7F         ld   bc, $7ffe
 609  8752 ED 78            in   a, (c)
 610  8754 CB 5F            bit  3, a
 611  8756 28 F6            jr   z, .wait_quit_release
 612  8758 01 FE BF         ld   bc, $bffe
 613  875B ED 78            in   a, (c)
 614  875D CB 47            bit  0, a
 615  875F 28 ED            jr   z, .wait_quit_release
 616  8761
 617  8761                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  8761 C3 CA 85         jp   ShowTitleScreen
 619  8764
 620  8764              .play_again_chosen:
 621  8764                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  8764              .wait_play_again_release:
 623  8764 76               halt
 624  8765 01 FE DF         ld   bc, $dffe
 625  8768 ED 78            in   a, (c)
 626  876A CB 67            bit  4, a
 627  876C 28 F6            jr   z, .wait_play_again_release
 628  876E
 629  876E                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  876E CD 6F 88         call ResetFullGameState
 631  8771 C3 91 84         jp   LoadRoomAndRestart
 632  8774
 633  8774              ; -------------------------------------------------------------------
 634  8774              ; CheckPortalTransition
 635  8774              ; Verifica le condizioni per accedere alla stanza successiva:
 636  8774              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  8774              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  8774              ;
 639  8774              ; Output:
 640  8774              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  8774              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  8774              ; -------------------------------------------------------------------
 643  8774              CheckPortalTransition:
 644  8774 C5               push bc
 645  8775 D5               push de
 646  8776 E5               push hl
 647  8777
 648  8777                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  8777 CD 02 88         call CheckAllItemsCollected
 650  877A 30 4D            jr   nc, .no_transition
 651  877C
 652  877C                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  877C                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  877C                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  877C 2A 8A E2         ld   hl, (room_ptr)
 656  877F 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8782 19               add  hl, de
 658  8783 4E               ld   c, (hl)
 659  8784 23               inc  hl
 660  8785 46               ld   b, (hl)                   ; BC = AttrAddr
 661  8786
 662  8786                  ; Offset = BC - 23552
 663  8786 60               ld   h, b
 664  8787 69               ld   l, c
 665  8788 01 00 A4         ld   bc, -23552
 666  878B 09               add  hl, bc
 667  878C
 668  878C                  ; PortalX = (Offset & 31) * 8
 669  878C 7D               ld   a, l
 670  878D E6 1F            and  31
 671  878F 87               add  a, a
 671  8790 87             add a, a
 671  8791 87             add a, a
 672  8792 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8793
 674  8793                  ; PortalY = (Offset / 32) * 8
 675  8793 CB 3C            srl  h
 675  8795 CB 1D          rr l
 676  8797 CB 3C            srl  h
 676  8799 CB 1D          rr l
 677  879B CB 3C            srl  h
 677  879D CB 1D          rr l
 678  879F CB 3C            srl  h
 678  87A1 CB 1D          rr l
 679  87A3 CB 3C            srl  h
 679  87A5 CB 1D          rr l
 680  87A7 7D               ld   a, l
 681  87A8 87               add  a, a
 681  87A9 87             add a, a
 681  87AA 87             add a, a
 682  87AB 57               ld   d, a                      ; D = PortalY (0..120)
 683  87AC
 684  87AC                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  87AC ED 4B 09 DF      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  87B0
 687  87B0                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  87B0 7B               ld   a, e
 689  87B1 91               sub  c
 690  87B2 30 02            jr   nc, .x_diff_pos
 691  87B4 ED 44            neg
 692  87B6              .x_diff_pos:
 693  87B6 FE 0C            cp   12
 694  87B8 30 0F            jr   nc, .no_transition
 695  87BA
 696  87BA                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  87BA 7A               ld   a, d
 698  87BB 90               sub  b
 699  87BC 30 02            jr   nc, .y_diff_pos
 700  87BE ED 44            neg
 701  87C0              .y_diff_pos:
 702  87C0 FE 0E            cp   14
 703  87C2 30 05            jr   nc, .no_transition
 704  87C4
 705  87C4                  ; Transizione al portale attiva!
 706  87C4 E1               pop  hl
 707  87C5 D1               pop  de
 708  87C6 C1               pop  bc
 709  87C7 37               scf
 710  87C8 C9               ret
 711  87C9
 712  87C9              .no_transition:
 713  87C9 E1               pop  hl
 714  87CA D1               pop  de
 715  87CB C1               pop  bc
 716  87CC B7               or   a
 717  87CD C9               ret
 718  87CE
 719  87CE              ; Alias per retrocompatibilità
 720  87CE              CheckVictoryCondition: EQU CheckPortalTransition
 721  87CE
 722  87CE              ; -------------------------------------------------------------------
 723  87CE              ; TriggerPortalTransition
 724  87CE              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  87CE              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  87CE              ; - Avanza all'indice della stanza successiva.
 727  87CE              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  87CE              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  87CE              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  87CE              ; -------------------------------------------------------------------
 731  87CE              TriggerPortalTransition:
 732  87CE                  ; 1. Determina l'ID della stanza corrente
 733  87CE CD 37 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  87D1
 735  87D1                  ; 2. Calcola l'indice della stanza successiva
 736  87D1 3A 2F E2         ld   a, (current_room)
 737  87D4 3C               inc  a
 738  87D5 FE 14            cp   NUM_ROOMS
 739  87D7 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  87D9
 741  87D9                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  87D9 21 0A 73         ld   hl, RoomsListTable
 743  87DC 5F               ld   e, a
 744  87DD 16 00            ld   d, 0
 745  87DF 19               add  hl, de
 746  87E0 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87E1 5E               ld   e, (hl)
 748  87E2 23               inc  hl
 749  87E3 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87E4 ED 53 8A E2      ld   (room_ptr), de
 751  87E8
 752  87E8                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87E8 AF               xor  a
 754  87E9 32 90 E2         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87EC 32 17 DF         ld   (velocity_y), a
 756  87EF 32 20 E5         ld   (game_objective_completed), a
 757  87F2 3E 01            ld   a, 1
 758  87F4 32 18 DF         ld   (on_ground), a
 759  87F7
 760  87F7                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  87F7 3E 07            ld   a, $07
 762  87F9 CD 99 62         call Gfx_ClearScreenDirect
 763  87FC
 764  87FC C3 91 84         jp   LoadRoomAndRestart
 765  87FF
 766  87FF              .all_rooms_completed:
 767  87FF                  ; Tutte le stanze sono state completate con successo!
 768  87FF                  IF ENABLE_VICTORY_SCREEN != 0
 769  87FF C3 F6 86         jp   TriggerVictory
 770  8802                  ELSE
 771  8802 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  8802 ~                ld   de, (RoomsListTable)
 773  8802 ~                ld   (room_ptr), de
 774  8802 ~                xor  a
 775  8802 ~                ld   (transition_active), a
 776  8802 ~                ld   (velocity_y), a
 777  8802 ~                ld   (game_objective_completed), a
 778  8802 ~                ld   a, 1
 779  8802 ~                ld   (on_ground), a
 780  8802 ~                ld   a, $07
 781  8802 ~                call Gfx_ClearScreenDirect
 782  8802 ~                jp   LoadRoomAndRestart
 783  8802                  ENDIF
 784  8802
 785  8802              ; -------------------------------------------------------------------
 786  8802              ; CheckAllItemsCollected
 787  8802              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  8802              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  8802              ; -------------------------------------------------------------------
 790  8802              CheckAllItemsCollected:
 791  8802 3A 20 E5         ld   a, (game_objective_completed)
 792  8805 B7               or   a
 793  8806 20 08            jr   nz, .all_collected
 794  8808 3A 89 E2         ld   a, (num_room_items)
 795  880B B7               or   a
 796  880C 28 02            jr   z, .all_collected
 797  880E B7               or   a
 798  880F C9               ret
 799  8810              .all_collected:
 800  8810 37               scf
 801  8811 C9               ret
 802  8812
 803  8812              ; -------------------------------------------------------------------
 804  8812              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  8812              ; -------------------------------------------------------------------
 806  8812              CheckInMasterBedroom:
 807  8812 37               scf
 808  8813 C9               ret
 809  8814
 810  8814              ; -------------------------------------------------------------------
 811  8814              ; CheckWillyConveyorCollision
 812  8814              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  8814              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  8814              ; -------------------------------------------------------------------
 815  8814              CheckWillyConveyorCollision:
 816  8814 C5               push bc
 817  8815 D5               push de
 818  8816 E5               push hl
 819  8817
 820  8817                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  8817 CD CB 76         call CheckWillyOnConveyor
 822  881A 38 49            jr   c, .collision_detected
 823  881C
 824  881C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  881C 3A 31 E2         ld   a, (conveyor_len)
 826  881F B7               or   a
 827  8820 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  8822
 829  8822                  ; B = WillyY, C = WillyX
 830  8822 ED 4B 09 DF      ld   bc, (PlayerPos)
 831  8826
 832  8826                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  8826 3A 32 E2         ld   a, (conveyor_row)
 834  8829 87               add  a, a                  ; *2
 835  882A 87               add  a, a                  ; *4
 836  882B 87               add  a, a                  ; *8
 837  882C 5F               ld   e, a                  ; E = ConveyorTop
 838  882D C6 07            add  a, 7
 839  882F 57               ld   d, a                  ; D = ConveyorBottom
 840  8830
 841  8830                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  8830 78               ld   a, b                  ; WillyTop
 843  8831 BA               cp   d
 844  8832 28 04            jr   z, .y_overlap
 845  8834 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  8836 18 32            jr   .no_conv_collision
 847  8838
 848  8838              .y_overlap:
 849  8838 C6 0F            add  a, 15                 ; WillyBottom
 850  883A BB               cp   e
 851  883B 28 04            jr   z, .x_check
 852  883D 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  883F 18 29            jr   .no_conv_collision
 854  8841
 855  8841              .x_check:
 856  8841                  ; ConveyorLeft = conveyor_col * 8
 857  8841 3A 33 E2         ld   a, (conveyor_col)
 858  8844 87               add  a, a                  ; *2
 859  8845 87               add  a, a                  ; *4
 860  8846 87               add  a, a                  ; *8
 861  8847 5F               ld   e, a                  ; E = ConveyorLeft
 862  8848
 863  8848                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  8848 21 31 E2         ld   hl, conveyor_len
 865  884B 3A 33 E2         ld   a, (conveyor_col)
 866  884E 86               add  a, (hl)
 867  884F 87               add  a, a                  ; *2
 868  8850 87               add  a, a                  ; *4
 869  8851 87               add  a, a                  ; *8
 870  8852 3D               dec  a                     ; ConveyorRight
 871  8853 57               ld   d, a                  ; D = ConveyorRight
 872  8854
 873  8854                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  8854 79               ld   a, c                  ; WillyLeft
 875  8855 BA               cp   d
 876  8856 28 04            jr   z, .x_overlap
 877  8858 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  885A 18 0E            jr   .no_conv_collision
 879  885C
 880  885C              .x_overlap:
 881  885C C6 0F            add  a, 15                 ; WillyRight
 882  885E BB               cp   e
 883  885F 28 04            jr   z, .collision_detected
 884  8861 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  8863 18 05            jr   .no_conv_collision
 886  8865
 887  8865              .collision_detected:
 888  8865 E1               pop  hl
 889  8866 D1               pop  de
 890  8867 C1               pop  bc
 891  8868 37               scf
 892  8869 C9               ret
 893  886A
 894  886A              .no_conv_collision:
 895  886A E1               pop  hl
 896  886B D1               pop  de
 897  886C C1               pop  bc
 898  886D B7               or   a
 899  886E C9               ret
 900  886F
 901  886F              ; -------------------------------------------------------------------
 902  886F              ; ResetFullGameState
 903  886F              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 904  886F              ; per l'avvio di una nuova partita dopo il Game Over.
 905  886F              ; -------------------------------------------------------------------
 906  886F              ResetFullGameState:
 907  886F                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 908  886F AF               xor  a
 909  8870 D3 FE            out  ($fe), a              ; Bordo a nero
 910  8872 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 911  8875
 912  8875                  ; Ripristina il numero di vite iniziali
 913  8875 3E 07            ld   a, INITIAL_LIVES
 914  8877 32 16 DF         ld   (willy_lives), a
 915  887A
 916  887A                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 917  887A AF               xor  a
 918  887B 32 13 DF         ld   (items_collected), a
 919  887E 32 0F DF         ld   (body_state), a
 920  8881 32 22 DF         ld   (w_warp_state), a
 921  8884 32 25 DF         ld   (w_key_prev), a
 922  8887 32 26 DF         ld   (enter_key_prev), a
 923  888A 32 17 DF         ld   (velocity_y), a
 924  888D 32 19 DF         ld   (jump_pressed), a
 925  8890 32 1B DF         ld   (coyote_timer), a
 926  8893 32 1E DF         ld   (jump_frame), a
 927  8896 32 1D DF         ld   (jump_dir), a
 928  8899 32 90 E2         ld   (transition_active), a
 929  889C 32 15 E3         ld   (willy_safety_timer), a
 930  889F 3E FF            ld   a, $ff
 931  88A1 32 27 DF         ld   (digit_key_prev), a
 932  88A4 3E 01            ld   a, 1
 933  88A6 32 20 DF         ld   (q_prev), a
 934  88A9 32 21 DF         ld   (a_prev), a
 935  88AC 32 18 DF         ld   (on_ground), a
 936  88AF
 937  88AF                  ; Azzeramento punteggio partita corrente (Score = 000000)
 938  88AF                  ; Nota: High score viene mantenuto intatto tra le partite
 939  88AF AF               xor  a
 940  88B0 32 1A E5         ld   (player_score + 0), a
 941  88B3 32 1B E5         ld   (player_score + 1), a
 942  88B6 32 1C E5         ld   (player_score + 2), a
 943  88B9
 944  88B9                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 945  88B9 CD 5E 81         call ResetItemsTable
 946  88BC
 947  88BC                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 948  88BC CD 05 70         call InitRoomEntryPositions
 949  88BF
 950  88BF                  ; Aggiorna la riga di stato con High score e Score azzerato
 951  88BF CD AE 68         call Gfx_UpdateScoreDisplay
 952  88C2
 953  88C2                  ; Ripristina la stanza iniziale (Central Cavern)
 954  88C2 21 C9 88         ld   hl, CentralCavernLayout
 955  88C5 22 8A E2         ld   (room_ptr), hl
 956  88C8
 957  88C8 C9               ret
 958  88C9
 959  88C9
 960  88C9
 961  88C9                  include "resources.asm"

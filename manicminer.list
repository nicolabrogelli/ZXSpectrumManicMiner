 681+ 84AC 47               ld   b, a
 682+ 84AD 3A EF E5         ld   a, (high_score + 1)
 683+ 84B0 B8               cp   b
 684+ 84B1 38 0C            jr   c, .new_high_score
 685+ 84B3 20 1C            jr   nz, .done_check
 686+ 84B5
 687+ 84B5                  ; Byte 0:
 688+ 84B5 3A EB E5         ld   a, (player_score + 0)
 689+ 84B8 47               ld   b, a
 690+ 84B9 3A EE E5         ld   a, (high_score + 0)
 691+ 84BC B8               cp   b
 692+ 84BD 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

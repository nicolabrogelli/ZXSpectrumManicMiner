 403  8642 16 00            ld   d, 0
 404  8644 21 D1 65         ld   hl, game_over_color_table
 405  8647 19               add  hl, de
 406  8648 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  8649 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  864C 06 09            ld   b, 9

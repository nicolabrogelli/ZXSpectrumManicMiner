1875+ 7BAE              ; Phys_UpdateCrumblingFloors
1876+ 7BAE              ; Aggiorna l'animazione di tutti i blocchi sgretolabili attivi.
1877+ 7BAE              ; Quando un blocco completa lo sgretolamento (stadio > 8), viene
1878+ 7BAE              ; definitivamente rimosso dalla fisica (unpacked_layout) e dallo schermo.
1879+ 7BAE              ; -------------------------------------------------------------------
1880+ 7BAE              Phys_UpdateCrumblingFloors:
1881+ 7BAE 3A DD C0         ld   a, (crumbling_active_count)
1882+ 7BB1 B7               or   a
1883+ 7BB2 C8               ret  z                     ; Nessun blocco attivo -> uscita immediata
1884+ 7BB3
1885+ 7BB3                  ; Avanza l'animazione ogni 2 frame (approx 25Hz per 8 stadi = ~0.32s)
1886+ 7BB3 21 DE C0         ld   hl, crumbling_anim_timer
1887+ 7BB6 34               inc  (hl)
1888+ 7BB7 7E               ld   a, (hl)
1889+ 7BB8 E6 01            and  1

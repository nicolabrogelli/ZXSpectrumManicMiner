  92+ F104 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ F105 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ F106 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F107 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F108 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ F109 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over

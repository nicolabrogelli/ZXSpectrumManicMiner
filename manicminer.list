  88+ F104              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  89+ F104 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  90+ F107 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  91+ F10A 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  92+ F10B 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  93+ F10C 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  94+ F10D 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F10E 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F10F 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  97+ F110 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  98+ F111

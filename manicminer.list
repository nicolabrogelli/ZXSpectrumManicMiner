 260  8131 3C               inc  a
 261  8132 E6 07            and  7
 262  8134 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 263  8136              .delay:
 264  8136 0D               dec  c
 265  8137 20 FD            jr   nz, .delay
 266  8139 10 F4            djnz .raster_loop
 267  813B
 268  813B                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 269  813B 3A B9 92         ld   a, (room_border_color)
 270  813E D3 FE            out  ($fe), a
 271  8140 18 05            jr   .no_collision_change
 272  8142
 273  8142              .no_collision:

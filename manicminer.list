 814  82B5 87               add  a, a                  ; *4
 815  82B6 87               add  a, a                  ; *8
 816  82B7 5F               ld   e, a                  ; E = ConveyorLeft
 817  82B8
 818  82B8                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 819  82B8 21 21 91         ld   hl, conveyor_len
 820  82BB 3A 23 91         ld   a, (conveyor_col)
 821  82BE 86               add  a, (hl)
 822  82BF 87               add  a, a                  ; *2
 823  82C0 87               add  a, a                  ; *4
 824  82C1 87               add  a, a                  ; *8
 825  82C2 3D               dec  a                     ; ConveyorRight
 826  82C3 57               ld   d, a                  ; D = ConveyorRight
 827  82C4
 828  82C4                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 829  82C4 79               ld   a, c                  ; WillyLeft
 830  82C5 BA               cp   d
 831  82C6 28 04            jr   z, .x_overlap
 832  82C8 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 833  82CA 18 0E            jr   .no_conv_collision
 834  82CC

 738  8B5C
 739  8B5C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8B5C 3A 71 ED         ld   a, (conveyor_len)
 741  8B5F B7               or   a
 742  8B60 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8B62
 744  8B62                  ; B = WillyY, C = WillyX
 745  8B62 ED 4B 49 EA      ld   bc, (PlayerPos)
 746  8B66
 747  8B66                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8B66 3A 72 ED         ld   a, (conveyor_row)
 749  8B69 87               add  a, a                  ; *2
 750  8B6A 87               add  a, a                  ; *4
 751  8B6B 87               add  a, a                  ; *8
 752  8B6C 5F               ld   e, a                  ; E = ConveyorTop
 753  8B6D C6 07            add  a, 7
 754  8B6F 57               ld   d, a                  ; D = ConveyorBottom
 755  8B70
 756  8B70                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8B70 78               ld   a, b                  ; WillyTop
 758  8B71 BA               cp   d
 759  8B72 28 04            jr   z, .y_overlap
 760  8B74 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8B76 18 32            jr   .no_conv_collision
 762  8B78

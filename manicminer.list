 192+ 8419 D3 FE            out  ($fe), a
 193+ 841B
 194+ 841B 0E 3C            ld   c, 60
 195+ 841D              .d1:
 196+ 841D 0D               dec  c
 197+ 841E 20 FD            jr   nz, .d1
 198+ 8420
 199+ 8420 3A D7 B2         ld   a, (room_border_color)
 200+ 8423 E6 EF            and  $ef              ; speaker OFF
 201+ 8425 D3 FE            out  ($fe), a
 202+ 8427
 203+ 8427 0E 3C            ld   c, 60
 204+ 8429              .d2:
 205+ 8429 0D               dec  c
 206+ 842A 20 FD            jr   nz, .d2
 207+ 842C
 208+ 842C 10 E6            djnz .sound_loop
 209+ 842E
 210+ 842E D1               pop  de
 211+ 842F C1               pop  bc
 212+ 8430 C9               ret

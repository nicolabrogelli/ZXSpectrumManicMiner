 516+ 5FD7 DD 23            inc  ix            ; Avanza di 2 byte nei dati dello sprite
 517+ 5FD9 0D               dec  c
 518+ 5FDA 20 C6            jr   nz, .line_loop
 519+ 5FDC
 520+ 5FDC DD E1            pop  ix
 521+ 5FDE E1               pop  hl
 522+ 5FDF D1               pop  de
 523+ 5FE0 C1               pop  bc
 524+ 5FE1 C9               ret

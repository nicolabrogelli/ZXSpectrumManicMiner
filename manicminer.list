 194+ 88E1 0E 3C            ld   c, 60
 195+ 88E3              .d1:
 196+ 88E3 0D               dec  c
 197+ 88E4 20 FD            jr   nz, .d1
 198+ 88E6
 199+ 88E6 3A FD EA         ld   a, (room_border_color)
 200+ 88E9 E6 EF            and  $ef              ; speaker OFF
 201+ 88EB D3 FE            out  ($fe), a
 202+ 88ED
 203+ 88ED 0E 3C            ld   c, 60
 204+ 88EF              .d2:
 205+ 88EF 0D               dec  c
 206+ 88F0 20 FD            jr   nz, .d2
 207+ 88F2
 208+ 88F2 10 E6            djnz .sound_loop
 209+ 88F4
 210+ 88F4 D1               pop  de
 211+ 88F5 C1               pop  bc
 212+ 88F6 C9               ret

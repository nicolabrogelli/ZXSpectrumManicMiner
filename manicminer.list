 210+ 8511 69               ld   l, c
 211+ 8512 01 00 A4         ld   bc, -23552
 212+ 8515 09               add  hl, bc                    ; HL = AttrOffset
 213+ 8516
 214+ 8516                  ; Col = Offset & 31
 215+ 8516 7D               ld   a, l
 216+ 8517 E6 1F            and  31
 217+ 8519 4F               ld   c, a                      ; C = Col (0..31)
 218+ 851A
 219+ 851A                  ; Row = Offset / 32
 220+ 851A CB 3C            srl  h
 220+ 851C CB 1D          rr l
 221+ 851E CB 3C            srl  h
 221+ 8520 CB 1D          rr l
 222+ 8522 CB 3C            srl  h
 222+ 8524 CB 1D          rr l
 223+ 8526 CB 3C            srl  h
 223+ 8528 CB 1D          rr l
 224+ 852A CB 3C            srl  h
 224+ 852C CB 1D          rr l

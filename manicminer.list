 920  878D              ; ResetFullGameState
 921  878D              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 922  878D              ; per l'avvio di una nuova partita dopo il Game Over.
 923  878D              ; -------------------------------------------------------------------
 924  878D              ResetFullGameState:
 925  878D                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 926  878D AF               xor  a
 927  878E D3 FE            out  ($fe), a              ; Bordo a nero
 928  8790 21 8D 5C         ld   hl, ATTR_P
 929  8793 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 930  8794 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 931  8797 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 932  8799 3E 07            ld   a, $07
 933  879B 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 934  879E
 935  879E                  ; Ripristina il numero di vite iniziali
 936  879E 3E 07            ld   a, INITIAL_LIVES
 937  87A0 32 3F 9E         ld   (willy_lives), a
 938  87A3
 939  87A3                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 940  87A3 AF               xor  a
 941  87A4 32 3C 9E         ld   (items_collected), a
 942  87A7 32 38 9E         ld   (body_state), a
 943  87AA 32 4B 9E         ld   (w_warp_state), a
 944  87AD 32 4E 9E         ld   (w_key_prev), a
 945  87B0 32 4F 9E         ld   (enter_key_prev), a
 946  87B3 32 40 9E         ld   (velocity_y), a
 947  87B6 32 42 9E         ld   (jump_pressed), a
 948  87B9 32 44 9E         ld   (coyote_timer), a
 949  87BC 32 47 9E         ld   (jump_frame), a
 950  87BF 32 46 9E         ld   (jump_dir), a
 951  87C2 32 B9 A1         ld   (transition_active), a
 952  87C5 32 3D A2         ld   (willy_safety_timer), a
 953  87C8 3E FF            ld   a, $ff
 954  87CA 32 50 9E         ld   (digit_key_prev), a
 955  87CD 3E 01            ld   a, 1
 956  87CF 32 49 9E         ld   (q_prev), a
 957  87D2 32 4A 9E         ld   (a_prev), a
 958  87D5 32 41 9E         ld   (on_ground), a

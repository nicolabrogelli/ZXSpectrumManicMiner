1188+ 7881              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1189+ 7881              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1190+ 7881              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1191+ 7881              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1192+ 7881              ; -------------------------------------------------------------------
1193+ 7881              UnpackRoomLayout:
1194+ 7881 E5               push hl
1195+ 7882 D5               push de
1196+ 7883 C5               push bc
1197+ 7884 DD E5            push ix
1198+ 7886
1199+ 7886 DD 2A 82 9D      ld   ix, (room_ptr)
1200+ 788A 11 20 02         ld   de, OFFSET_TILES
1201+ 788D DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1202+ 788F
1203+ 788F 2A 82 9D         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1204+ 7892 11 28 9B         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1205+ 7895 01 00 02         ld   bc, 512               ; 512 celle
1206+ 7898
1207+ 7898              .byte_loop:
1208+ 7898 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1209+ 7899 23               inc  hl
1210+ 789A
1211+ 789A                  ; Confronta con le 8 definizioni di tile:
1212+ 789A DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1213+ 789D 28 23            jr   z, .is_bg
1214+ 789F DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1215+ 78A2 28 29            jr   z, .is_wall
1216+ 78A4 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1217+ 78A7 28 1C            jr   z, .is_floor
1218+ 78A9 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1219+ 78AC 28 1B            jr   z, .is_crumbling
1220+ 78AE DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 78B1 28 1E            jr   z, .is_conveyor
1222+ 78B3 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 78B6 28 1D            jr   z, .is_nasty1
1224+ 78B8 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1225+ 78BB 28 1C            jr   z, .is_nasty2
1226+ 78BD DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1227+ 78C0 28 1B            jr   z, .is_extra
1228+ 78C2
1229+ 78C2              .is_bg:
1230+ 78C2                  ; Default: Tile 0 (Background)
1231+ 78C2 AF               xor  a
1232+ 78C3 18 1A            jr   .store_cell
1233+ 78C5
1234+ 78C5              .is_floor:

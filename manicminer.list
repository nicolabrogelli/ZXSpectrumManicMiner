 843+ 6269              ; Gfx_DrawTitleScreen
 844+ 6269              ; Disegna la schermata iniziale (Title Screen):
 845+ 6269              ; - Bordo nero e pulizia schermo.
 846+ 6269              ; - Titolo "MANIC MINER" e sottotitolo.
 847+ 6269              ; - Separatori grafici.
 848+ 6269              ; - Sprite decorativi (Willy a sinistra, Maria a destra).
 849+ 6269              ; - Obiettivo di gioco.
 850+ 6269              ; - Messaggio "PRESS ENTER TO START".
 851+ 6269              ; - Riepilogo controlli (O, P, Z, ENTER).
 852+ 6269              ; - Copyright.
 853+ 6269              ; (Tutte le righe sono comprese tra 0 e 20 per evitare errori "Out of screen" della ROM)
 854+ 6269              ; -------------------------------------------------------------------
 855+ 6269              Gfx_DrawTitleScreen:
 856+ 6269 F5               push af
 857+ 626A C5               push bc
 858+ 626B D5               push de
 859+ 626C E5               push hl
 860+ 626D DD E5            push ix
 861+ 626F
 862+ 626F                  ; 1. Bordo hardware e schermo a nero
 863+ 626F AF               xor  a
 864+ 6270 D3 FE            out  ($fe), a              ; Bordo a nero
 865+ 6272 21 8D 5C         ld   hl, ATTR_P
 866+ 6275 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 867+ 6276 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
 868+ 6279 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 869+ 627B 3E 07            ld   a, $07
 870+ 627D 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 871+ 6280
 872+ 6280                  ; 2. Stampa riga 1: Titolo principale (Riga 1, Colonna 0)
 873+ 6280 3E 16            ld   a, 22
 874+ 6282 D7               rst  $10
 875+ 6283 3E 01            ld   a, 1
 876+ 6285 D7               rst  $10
 877+ 6286 3E 00            ld   a, 0
 878+ 6288 D7               rst  $10
 879+ 6289 21 41 61         ld   hl, title_banner_1
 880+ 628C 06 20            ld   b, 32
 881+ 628E CD E8 60         call Gfx_PrintString

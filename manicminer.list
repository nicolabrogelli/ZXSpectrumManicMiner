 630+ 87C7              ; -------------------------------------------------------------------
 631+ 87C7              ; Score_Add1Point
 632+ 87C7              ; Aggiunge 1 punto allo Score del giocatore (usato nel countdown dell'aria a fine livello).
 633+ 87C7              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 634+ 87C7              ; -------------------------------------------------------------------
 635+ 87C7              Score_Add1Point:
 636+ 87C7 F5               push af
 637+ 87C8 C5               push bc
 638+ 87C9 D5               push de
 639+ 87CA E5               push hl
 640+ 87CB
 641+ 87CB                  ; Aggiungi 1 punto (byte 0 in BCD rappresenta unità e decine)
 642+ 87CB 3A 17 F1         ld   a, (player_score + 0)
 643+ 87CE C6 01            add  a, $01
 644+ 87D0 27               daa
 645+ 87D1 32 17 F1         ld   (player_score + 0), a
 646+ 87D4
 647+ 87D4                  ; Riporto al byte 1 (centinaia / migliaia)
 648+ 87D4 3A 18 F1         ld   a, (player_score + 1)
 649+ 87D7 CE 00            adc  a, 0
 650+ 87D9 27               daa
 651+ 87DA 32 18 F1         ld   (player_score + 1), a
 652+ 87DD
 653+ 87DD                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 87DD 3A 19 F1         ld   a, (player_score + 2)
 655+ 87E0 CE 00            adc  a, 0
 656+ 87E2 27               daa
 657+ 87E3 32 19 F1         ld   (player_score + 2), a
 658+ 87E6
 659+ 87E6                  ; Controlla se player_score ha superato high_score
 660+ 87E6 CD 12 88         call Score_CheckAndUpdateHighScore
 661+ 87E9
 662+ 87E9                  ; Aggiorna visualizzazione a schermo
 663+ 87E9 CD B8 68         call Gfx_UpdateScoreDisplay
 664+ 87EC
 665+ 87EC E1               pop  hl
 666+ 87ED D1               pop  de
 667+ 87EE C1               pop  bc
 668+ 87EF F1               pop  af
 669+ 87F0 C9               ret
 670+ 87F1
 671+ 87F1              ; -------------------------------------------------------------------
 672+ 87F1              ; Score_AddItemPoints
 673+ 87F1              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 674+ 87F1              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 675+ 87F1              ; -------------------------------------------------------------------
 676+ 87F1              Score_AddItemPoints:
 677+ 87F1 F5               push af
 678+ 87F2 C5               push bc
 679+ 87F3 D5               push de
 680+ 87F4 E5               push hl
 681+ 87F5
 682+ 87F5                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 683+ 87F5 3A 18 F1         ld   a, (player_score + 1)
 684+ 87F8 C6 01            add  a, $01
 685+ 87FA 27               daa
 686+ 87FB 32 18 F1         ld   (player_score + 1), a
 687+ 87FE
 688+ 87FE                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 87FE 3A 19 F1         ld   a, (player_score + 2)
 690+ 8801 CE 00            adc  a, 0
 691+ 8803 27               daa
 692+ 8804 32 19 F1         ld   (player_score + 2), a
 693+ 8807
 694+ 8807                  ; Controlla se player_score ha superato high_score
 695+ 8807 CD 12 88         call Score_CheckAndUpdateHighScore
 696+ 880A
 697+ 880A                  ; Aggiorna visualizzazione a schermo
 698+ 880A CD B8 68         call Gfx_UpdateScoreDisplay
 699+ 880D
 700+ 880D E1               pop  hl
 701+ 880E D1               pop  de
 702+ 880F C1               pop  bc
 703+ 8810 F1               pop  af

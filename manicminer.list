 271+ 6D04              ; LoadPositionPlayeinRoom
 272+ 6D04              ;
 273+ 6D04              ; Inizializza la posizione del player (Willy) quando entra
 274+ 6D04              ; in una nuova stanza.
 275+ 6D04              ;
 276+ 6D04              ; La posizione viene letta direttamente dai dati della stanza
 277+ 6D04              ; (layout/metadata) a partire da room_ptr.
 278+ 6D04              ;
 279+ 6D04              ; Output:
 280+ 6D04              ;   PlayerPos     = posizione iniziale (Y, X)
 281+ 6D04              ;   PlayerPosOld  = copia della posizione iniziale
 282+ 6D04              ;
 283+ 6D04              ; Struttura dati stanza:
 284+ 6D04              ;   OFFSET_POS_WILLY:
 285+ 6D04              ;       +0 = X
 286+ 6D04              ;       +1 = Y
 287+ 6D04              ; -------------------------------------------------------------------
 288+ 6D04              LoadPositionPlayeinRoom:
 289+ 6D04                  ; ---------------------------------------------------------------
 290+ 6D04                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6D04                  ; ---------------------------------------------------------------
 292+ 6D04 2A 14 92         ld   hl, (room_ptr)
 293+ 6D07 11 68 02         ld   de, OFFSET_POS_WILLY
 294+ 6D0A 19               add  hl, de
 295+ 6D0B
 296+ 6D0B                  ; Byte 0: Y * 2
 297+ 6D0B 7E               ld   a, (hl)
 298+ 6D0C CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 299+ 6D0E 57               ld   d, a                      ; D = PlayerY
 300+ 6D0F
 301+ 6D0F                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 302+ 6D0F 23               inc  hl                        ; Byte 1 (Anim frame)
 303+ 6D10 23               inc  hl                        ; Byte 2 (Direction)
 304+ 6D11 7E               ld   a, (hl)
 305+ 6D12 E6 01            and  1
 306+ 6D14 28 04            jr   z, .facing_right
 307+ 6D16 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 308+ 6D18 18 02            jr   .set_dir
 309+ 6D1A              .facing_right:
 310+ 6D1A 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 311+ 6D1C              .set_dir:
 312+ 6D1C 32 9B 8E         ld   (direction), a
 313+ 6D1F
 314+ 6D1F                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 315+ 6D1F 23               inc  hl                        ; Byte 3 (Airborne)
 316+ 6D20 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 317+ 6D21 4E               ld   c, (hl)
 318+ 6D22 23               inc  hl                        ; Byte 5 (AttrAddr High)
 319+ 6D23 7E               ld   a, (hl)
 320+ 6D24
 321+ 6D24                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 322+ 6D24 67               ld   h, a
 323+ 6D25 69               ld   l, c
 324+ 6D26 01 00 A4         ld   bc, -23552
 325+ 6D29 09               add  hl, bc
 326+ 6D2A
 327+ 6D2A 7D               ld   a, l
 328+ 6D2B E6 1F            and  31
 329+ 6D2D 87               add  a, a                      ; *2
 330+ 6D2E 87               add  a, a                      ; *4
 331+ 6D2F 87               add  a, a                      ; *8 -> Pixel X (es. 16)

 386+ 7C87              ; Enemy_Update
 387+ 7C87              ;
 388+ 7C87              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7C87              ; -------------------------------------------------------------------
 390+ 7C87              Enemy_Update:
 391+ 7C87                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7C87 3A 0B 97         ld   a, (enemy_update_rate)
 393+ 7C8A FE 01            cp   1
 394+ 7C8C 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7C8E
 396+ 7C8E 21 0C 97         ld   hl, enemy_update_timer
 397+ 7C91 34               inc  (hl)
 398+ 7C92 7E               ld   a, (hl)
 399+ 7C93 21 0B 97         ld   hl, enemy_update_rate
 400+ 7C96 BE               cp   (hl)
 401+ 7C97 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7C98 AF               xor  a
 403+ 7C99 32 0C 97         ld   (enemy_update_timer), a
 404+ 7C9C
 405+ 7C9C              .do_update:
 406+ 7C9C E5               push hl
 407+ 7C9D D5               push de
 408+ 7C9E C5               push bc
 409+ 7C9F DD E5            push ix
 410+ 7CA1
 411+ 7CA1 3E 01            ld   a, 1
 412+ 7CA3 32 92 97         ld   (enemy_was_updated), a
 413+ 7CA6
 414+ 7CA6 DD 21 57 7A      ld   ix, ActiveEnemies
 415+ 7CAA 06 08            ld   b, 8                      ; 8 slot
 416+ 7CAC              .loop:
 417+ 7CAC DD 7E 00         ld   a, (ix+0)                 ; Flags
 418+ 7CAF E6 80            and  $80                       ; Active?
 419+ 7CB1 CA 50 7D         jp   z, .next
 420+ 7CB4
 421+ 7CB4                  ; 1. Aggiorna Anim State (0..3)
 422+ 7CB4 DD 7E 07         ld   a, (ix+7)
 423+ 7CB7 3C               inc  a
 424+ 7CB8 E6 03            and  3
 425+ 7CBA DD 77 07         ld   (ix+7), a
 426+ 7CBD
 427+ 7CBD                  ; 2. Determina se orizzontale o verticale

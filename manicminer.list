 364+ 86DB              ; RestoreBackgroundCell
 365+ 86DB              ;
 366+ 86DB              ; Ripristina il tile originale presente nella mappa della stanza.
 367+ 86DB              ; Chiamata quando un item viene raccolto.
 368+ 86DB              ;
 369+ 86DB              ; Input:
 370+ 86DB              ;   B = Row (0..15)
 371+ 86DB              ;   C = Col (0..31)
 372+ 86DB              ; -------------------------------------------------------------------
 373+ 86DB              RestoreBackgroundCell:
 374+ 86DB FD E5            push iy
 375+ 86DD C5               push bc
 376+ 86DE D5               push de
 377+ 86DF E5               push hl
 378+ 86E0 DD E5            push ix
 379+ 86E2
 380+ 86E2 C5               push bc
 381+ 86E3 FD E1            pop  iy                        ; IYH = Row, IYL = Col
 382+ 86E5
 383+ 86E5 78               ld   a, b
 384+ 86E6 CD 48 7A         call GetCellFromUnpacked       ; A = tile index (0..7)
 385+ 86E9
 386+ 86E9                  ; IX = room_ptr + OFFSET_TILES + A * 9
 387+ 86E9 6F               ld   l, a
 388+ 86EA 26 00            ld   h, 0
 389+ 86EC 5F               ld   e, a
 390+ 86ED 16 00            ld   d, 0
 391+ 86EF 29               add  hl, hl                    ; *2
 392+ 86F0 29               add  hl, hl                    ; *4
 393+ 86F1 29               add  hl, hl                    ; *8
 394+ 86F2 19               add  hl, de                    ; *9
 395+ 86F3 11 20 02         ld   de, OFFSET_TILES
 396+ 86F6 19               add  hl, de
 397+ 86F7 ED 5B AD EE      ld   de, (room_ptr)
 398+ 86FB 19               add  hl, de
 399+ 86FC E5               push hl
 400+ 86FD DD E1            pop  ix                        ; IX = tile pointer
 401+ 86FF
 402+ 86FF FD E5            push iy
 403+ 8701 C1               pop  bc                        ; B = Row, C = Col
 404+ 8702 CD ED 6A         call Gfx_DrawTile
 405+ 8705
 406+ 8705 DD E1            pop  ix
 407+ 8707 E1               pop  hl
 408+ 8708 D1               pop  de
 409+ 8709 C1               pop  bc
 410+ 870A FD E1            pop  iy
 411+ 870C C9               ret

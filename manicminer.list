  72+ 8344 ~            ; Audio_UpdateMusic
  73+ 8344 ~            ;
  74+ 8344 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8344 ~            ; Viene chiamata a ogni frame.
  76+ 8344 ~            ; -------------------------------------------------------------------
  77+ 8344 ~            Audio_UpdateMusic:
  78+ 8344 ~                push af
  79+ 8344 ~                push bc
  80+ 8344 ~                push de
  81+ 8344 ~                push hl
  82+ 8344 ~
  83+ 8344 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8344 ~                ld   a, (Audio_jump_sound_note)
  85+ 8344 ~                cp   18
  86+ 8344 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8344 ~
  88+ 8344 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8344 ~                ld   a, (Audio_music_frame_counter)
  90+ 8344 ~                dec  a
  91+ 8344 ~                ld   (Audio_music_frame_counter), a
  92+ 8344 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8344 ~
  94+ 8344 ~                ; Altrimenti carica la nota successiva
  95+ 8344 ~                ld   a, (Audio_music_note_idx)
  96+ 8344 ~                inc  a
  97+ 8344 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8344 ~                jr   c, .no_wrap
  99+ 8344 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8344 ~            .no_wrap:
 101+ 8344 ~                ld   (Audio_music_note_idx), a
 102+ 8344 ~
 103+ 8344 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8344 ~                ld   e, a
 105+ 8344 ~                ld   d, 0
 106+ 8344 ~                ld   hl, Audio_MusicSheet
 107+ 8344 ~                add  hl, de
 108+ 8344 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8344 ~
 110+ 8344 ~                ; Leggi durata (secondo byte)
 111+ 8344 ~                inc  hl
 112+ 8344 ~                ld   a, (hl)
 113+ 8344 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8344 ~                jr   nz, .dur_ok
 115+ 8344 ~                ld   a, 1
 116+ 8344 ~            .dur_ok:
 117+ 8344 ~                ld   (Audio_music_frame_counter), a
 118+ 8344 ~
 119+ 8344 ~            .play_current_note:
 120+ 8344 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8344 ~                ld   a, (Audio_music_note_idx)
 122+ 8344 ~                ld   e, a
 123+ 8344 ~                ld   d, 0
 124+ 8344 ~                ld   hl, Audio_MusicSheet
 125+ 8344 ~                add  hl, de
 126+ 8344 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8344 ~                ld   a, (hl)                  ; A = delay
 128+ 8344 ~                or   a
 129+ 8344 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8344 ~
 131+ 8344 ~                ; Suona la nota: 2 cicli
 132+ 8344 ~                ld   d, a                     ; D = delay
 133+ 8344 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8344 ~            .note_loop:
 135+ 8344 ~                ; Speaker ON
 136+ 8344 ~                ld   a, (room_border_color)
 137+ 8344 ~                or   $10
 138+ 8344 ~                out  ($fe), a
 139+ 8344 ~                ld   c, d
 140+ 8344 ~            .d1:
 141+ 8344 ~                push af
 142+ 8344 ~                pop  af
 143+ 8344 ~                dec  c
 144+ 8344 ~                jr   nz, .d1
 145+ 8344 ~
 146+ 8344 ~                ; Speaker OFF
 147+ 8344 ~                ld   a, (room_border_color)
 148+ 8344 ~                and  $ef
 149+ 8344 ~                out  ($fe), a
 150+ 8344 ~                ld   c, d
 151+ 8344 ~            .d2:
 152+ 8344 ~                push af
 153+ 8344 ~                pop  af
 154+ 8344 ~                dec  c
 155+ 8344 ~                jr   nz, .d2
 156+ 8344 ~
 157+ 8344 ~                djnz .note_loop
 158+ 8344 ~
 159+ 8344 ~            .done:
 160+ 8344 ~                pop  hl
 161+ 8344 ~                pop  de
 162+ 8344 ~                pop  bc
 163+ 8344 ~                pop  af
 164+ 8344 ~                ret
 165+ 8344 ~
 166+ 8344 ~            Audio_MusicSheet:
 167+ 8344 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8344 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8344 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 8344 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 8344 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 8344 ~                db 90, 10, 107, 20, 68, 65
 173+ 8344                  ELSE
 174+ 8344              Audio_UpdateMusic:
 175+ 8344 C9               ret
 176+ 8345                  ENDIF

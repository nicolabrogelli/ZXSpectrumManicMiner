 790  8B93 BA               cp   d
 791  8B94 28 04            jr   z, .x_overlap
 792  8B96 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8B98 18 0E            jr   .no_conv_collision
 794  8B9A

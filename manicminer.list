 518+ 7FEA              ; CheckCollision
 519+ 7FEA              ;
 520+ 7FEA              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FEA              ; Output:
 522+ 7FEA              ;   Carry Set = Collisione con guardiano
 523+ 7FEA              ;   Carry Clear = Nessuna collisione
 524+ 7FEA              ; -------------------------------------------------------------------
 525+ 7FEA              CheckCollision:
 526+ 7FEA DD E5            push ix
 527+ 7FEC C5               push bc
 528+ 7FED D5               push de
 529+ 7FEE E5               push hl
 530+ 7FEF
 531+ 7FEF                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FEF 3A 3D A2         ld   a, (willy_safety_timer)
 533+ 7FF2 B7               or   a
 534+ 7FF3 20 3B            jr   nz, .no_collision_found
 535+ 7FF5
 536+ 7FF5 DD 21 E2 7C      ld   ix, ActiveEnemies
 537+ 7FF9 06 08            ld   b, 8                      ; 8 slot
 538+ 7FFB
 539+ 7FFB              .collision_loop:
 540+ 7FFB DD 7E 00         ld   a, (ix+0)
 541+ 7FFE E6 80            and  $80                       ; Active?
 542+ 8000 28 26            jr   z, .next_enemy
 543+ 8002
 544+ 8002 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 8003
 546+ 8003                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 8003 ED 4B 32 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 8007 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 800A
 550+ 800A                  ; Calcola differenza X
 551+ 800A 91               sub  c                         ; A = EnemyX - WillyX
 552+ 800B 30 02            jr   nc, .x_diff_pos
 553+ 800D ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 800F              .x_diff_pos:
 555+ 800F FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 8011 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 8013
 558+ 8013                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 8013 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 8016 90               sub  b                         ; A = EnemyY - WillyY
 561+ 8017 30 02            jr   nc, .y_diff_pos
 562+ 8019 ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 801B              .y_diff_pos:
 564+ 801B FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 801D 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 801F
 567+ 801F                  ; Collisione trovata!
 568+ 801F C1               pop  bc                        ; Ripristina stack
 569+ 8020 E1               pop  hl
 570+ 8021 D1               pop  de
 571+ 8022 C1               pop  bc
 572+ 8023 DD E1            pop  ix
 573+ 8025 37               scf
 574+ 8026 C9               ret
 575+ 8027
 576+ 8027              .no_x_hit:
 577+ 8027 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 8028
 579+ 8028              .next_enemy:
 580+ 8028 11 0B 00         ld   de, 11
 581+ 802B DD 19            add  ix, de
 582+ 802D 05               dec  b
 583+ 802E 20 CB            jr   nz, .collision_loop
 584+ 8030
 585+ 8030              .no_collision_found:
 586+ 8030 E1               pop  hl
 587+ 8031 D1               pop  de
 588+ 8032 C1               pop  bc
 589+ 8033 DD E1            pop  ix
 590+ 8035 B7               or   a
 591+ 8036 C9               ret

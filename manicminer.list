 252+ 7D33              DrawItemGraphic:
 253+ 7D33 C5               push bc
 254+ 7D34 D5               push de
 255+ 7D35 E5               push hl
 256+ 7D36
 257+ 7D36                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 258+ 7D36 78               ld   a, b
 259+ 7D37 E6 18            and  $18
 260+ 7D39 C6 40            add  a, $40
 261+ 7D3B 57               ld   d, a                      ; Byte alto indirizzo video
 262+ 7D3C
 263+ 7D3C 78               ld   a, b

 191+ 86D6 F6 10            or   $10               ; speaker ON
 192+ 86D8 D3 FE            out  ($fe), a
 193+ 86DA
 194+ 86DA 0E 3C            ld   c, 60
 195+ 86DC              .d1:
 196+ 86DC 0D               dec  c
 197+ 86DD 20 FD            jr   nz, .d1
 198+ 86DF
 199+ 86DF 3A 96 E1         ld   a, (room_border_color)
 200+ 86E2 E6 EF            and  $ef              ; speaker OFF
 201+ 86E4 D3 FE            out  ($fe), a
 202+ 86E6
 203+ 86E6 0E 3C            ld   c, 60
 204+ 86E8              .d2:
 205+ 86E8 0D               dec  c
 206+ 86E9 20 FD            jr   nz, .d2
 207+ 86EB
 208+ 86EB 10 E6            djnz .sound_loop
 209+ 86ED
 210+ 86ED D1               pop  de
 211+ 86EE C1               pop  bc
 212+ 86EF C9               ret

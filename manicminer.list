   6+ 701F              ; -------------------------------------------------------------------
   7+ 701F              ; Input_CheckCtrl
   8+ 701F              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 701F              ;
  10+ 701F              ; Output:
  11+ 701F              ;   D = bitmask tasti attivi:
  12+ 701F              ;       bit 0 → sinistra (O)
  13+ 701F              ;       bit 1 → destra   (P)
  14+ 701F              ;       bit 2 → salto    (Z)
  15+ 701F              ;
  16+ 701F              ; Effetti collaterali in RAM:
  17+ 701F              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 701F              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 701F              ;   (jump_prev)     → debounce tasto salto
  20+ 701F              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 701F              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 701F              ; -------------------------------------------------------------------
  23+ 701F
  24+ 701F              Input_CheckCtrl:
  25+ 701F AF               xor  a
  26+ 7020 32 1F 96         ld   (current_input_dir), a
  27+ 7023
  28+ 7023                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 7023                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 7023                  ;
  31+ 7023                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 7023                  ; Se bit 0 = 0, Q è premuto.
  33+ 7023
  34+ 7023 01 FE FB         ld   bc, $fbfe
  35+ 7026 ED 78            in   a, (c)
  36+ 7028 CB 47            bit  0, a
  37+ 702A 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 702C
  39+ 702C                  ; Q è premuto: debounce tramite (q_prev).
  40+ 702C                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 702C 3A 20 96         ld   a, (q_prev)
  42+ 702F B7               or   a
  43+ 7030 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 7032
  45+ 7032                  ; ── Primo frame di pressione di Q ──
  46+ 7032 3E 01            ld   a, 1
  47+ 7034 32 20 96         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 7037
  49+ 7037                  ; NOTA sullo stack:
  50+ 7037                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 7037                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 7037                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 7037                  ; poi JP salta direttamente.
  54+ 7037 E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 7038 C3 EA 70         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 703B
  57+ 703B              .q_not_pressed:
  58+ 703B AF               xor  a
  59+ 703C 32 20 96         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 703F
  61+ 703F              .q_handled:
  62+ 703F
  63+ 703F                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 703F                  ;

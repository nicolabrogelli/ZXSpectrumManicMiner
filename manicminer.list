   2+ 7EFA              ; items.asm
   3+ 7EFA              ;
   4+ 7EFA              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 7EFA              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 7EFA              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 7EFA              ;===========================================================================
   8+ 7EFA
   9+ 7EFA              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 7EFA
  11+ 7EFA              ; -------------------------------------------------------------------
  12+ 7EFA              ; DetermineCurrentRoomID
  13+ 7EFA              ;
  14+ 7EFA              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7EFA              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7EFA              ;
  17+ 7EFA              ; Output:
  18+ 7EFA              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7EFA              ;   (current_room) = A
  20+ 7EFA              ; -------------------------------------------------------------------
  21+ 7EFA              DetermineCurrentRoomID:
  22+ 7EFA E5               push hl
  23+ 7EFB D5               push de
  24+ 7EFC C5               push bc
  25+ 7EFD
  26+ 7EFD 21 09 72         ld   hl, RoomsListTable
  27+ 7F00 ED 5B 57 98      ld   de, (room_ptr)
  28+ 7F04 06 02            ld   b, NUM_ROOMS
  29+ 7F06 0E 00            ld   c, 0
  30+ 7F08
  31+ 7F08              .loop:
  32+ 7F08 7E               ld   a, (hl)
  33+ 7F09 BB               cp   e
  34+ 7F0A 20 06            jr   nz, .no_match
  35+ 7F0C 23               inc  hl
  36+ 7F0D 7E               ld   a, (hl)
  37+ 7F0E BA               cp   d
  38+ 7F0F 28 08            jr   z, .found
  39+ 7F11 2B               dec  hl
  40+ 7F12
  41+ 7F12              .no_match:
  42+ 7F12 23               inc  hl
  43+ 7F13 23               inc  hl
  44+ 7F14 0C               inc  c
  45+ 7F15 10 F1            djnz .loop
  46+ 7F17
  47+ 7F17 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7F19
  49+ 7F19              .found:
  50+ 7F19 79               ld   a, c
  51+ 7F1A 32 FD 97         ld   (current_room), a
  52+ 7F1D
  53+ 7F1D C1               pop  bc
  54+ 7F1E D1               pop  de
  55+ 7F1F E1               pop  hl
  56+ 7F20 C9               ret
  57+ 7F21
  58+ 7F21              ; -------------------------------------------------------------------
  59+ 7F21              ; ResetItemsTable
  60+ 7F21              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7F21              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7F21              ; -------------------------------------------------------------------
  63+ 7F21              ResetItemsTable:
  64+ 7F21 E5               push hl
  65+ 7F22 D5               push de
  66+ 7F23 C5               push bc
  67+ 7F24
  68+ 7F24 21 09 72         ld   hl, RoomsListTable
  69+ 7F27 06 02            ld   b, NUM_ROOMS
  70+ 7F29
  71+ 7F29              .room_loop:
  72+ 7F29 C5               push bc
  73+ 7F2A 5E               ld   e, (hl)
  74+ 7F2B 23               inc  hl
  75+ 7F2C 56               ld   d, (hl)
  76+ 7F2D 23               inc  hl
  77+ 7F2E E5               push hl
  78+ 7F2F
  79+ 7F2F                  ; DE = room_ptr
  80+ 7F2F 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7F32 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7F33
  83+ 7F33              .item_loop:
  84+ 7F33 7E               ld   a, (hl)
  85+ 7F34 FE FF            cp   $FF
  86+ 7F36 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 7F38 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 7F39 23               inc  hl                        ; +2 (Attr Address High)
  89+ 7F3A 23               inc  hl                        ; +3 (Anim mask)
  90+ 7F3B 23               inc  hl                        ; +4 (Collected flag)
  91+ 7F3C 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 7F3E 23               inc  hl                        ; Avanza al prossimo item
  93+ 7F3F 18 F2            jr   .item_loop
  94+ 7F41
  95+ 7F41              .next_room:
  96+ 7F41 E1               pop  hl
  97+ 7F42 C1               pop  bc
  98+ 7F43 10 E4            djnz .room_loop
  99+ 7F45
 100+ 7F45 C1               pop  bc
 101+ 7F46 D1               pop  de
 102+ 7F47 E1               pop  hl
 103+ 7F48 C9               ret

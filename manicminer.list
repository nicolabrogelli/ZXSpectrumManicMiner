 859+ 7744 B7               or   a
 860+ 7745 28 1A            jr   z, .range_left
 861+ 7747              .range_right:
 862+ 7747 3A FE BD         ld   a, (ramp_col)
 863+ 774A 47               ld   b, a              ; B = ramp_col
 864+ 774B 3A FC BD         ld   a, (ramp_len)
 865+ 774E 80               add  a, b              ; A = ramp_col + ramp_len
 866+ 774F 4F               ld   c, a              ; C = limit_right (exclusive)
 867+ 7750
 868+ 7750 7B               ld   a, e              ; A = Col

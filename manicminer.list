 165+ 8346 11 9E DE         ld   de, items_grid + 1
 166+ 8349 36 00            ld   (hl), 0
 167+ 834B 01 FF 01         ld   bc, 511
 168+ 834E ED B0            ldir
 169+ 8350
 170+ 8350                  ; 2. Nessun item attivo inizialmente nella cache

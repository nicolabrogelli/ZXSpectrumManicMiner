 521  85CB ~                ld   (Audio_music_frame_counter), a
 522  85CB                  ENDIF
 523  85CB
 524  85CB                  ; - Riposiziona Willy nel punto di default definito nella stanza
 525  85CB AF               xor  a
 526  85CC 32 8B A1         ld   (transition_active), a
 527  85CF
 528  85CF                  ; - Cancella lo schermo a nero prima del caricamento

1897+ 7BC0 DD 21 DD BE      ld   ix, crumbling_grid
1898+ 7BC4 01 00 02         ld   bc, 512               ; 512 celle
1899+ 7BC7 16 00            ld   d, 0                  ; D = Row (0..15)
1900+ 7BC9 1E 00            ld   e, 0                  ; E = Col (0..31)
1901+ 7BCB
1902+ 7BCB              .loop:
1903+ 7BCB DD 7E 00         ld   a, (ix+0)             ; A = Stage (0..8)
1904+ 7BCE B7               or   a
1905+ 7BCF 28 3F            jr   z, .next
1906+ 7BD1
1907+ 7BD1 3C               inc  a                     ; Avanza di 1 stadio
1908+ 7BD2 DD 77 00         ld   (ix+0), a
1909+ 7BD5
1910+ 7BD5 FE 09            cp   9
1911+ 7BD7 30 0C            jr   nc, .finish_crumble
1912+ 7BD9
1913+ 7BD9                  ; Stadio 1..8: ridisegna la tile nello stadio corrente
1914+ 7BD9 C5               push bc
1915+ 7BDA D5               push de
1916+ 7BDB 42               ld   b, d                  ; B = Row
1917+ 7BDC 4B               ld   c, e                  ; C = Col

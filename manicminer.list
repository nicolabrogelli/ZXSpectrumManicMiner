 632  86D4
 633  86D4              ; -------------------------------------------------------------------
 634  86D4              ; CheckPortalTransition
 635  86D4              ; Verifica le condizioni per accedere alla stanza successiva:
 636  86D4              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  86D4              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  86D4              ;
 639  86D4              ; Output:
 640  86D4              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  86D4              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  86D4              ; -------------------------------------------------------------------
 643  86D4              CheckPortalTransition:
 644  86D4 C5               push bc
 645  86D5 D5               push de
 646  86D6 E5               push hl
 647  86D7
 648  86D7                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  86D7 CD 62 87         call CheckAllItemsCollected
 650  86DA 30 4D            jr   nc, .no_transition
 651  86DC
 652  86DC                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  86DC                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  86DC                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  86DC 2A EA AD         ld   hl, (room_ptr)
 656  86DF 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  86E2 19               add  hl, de
 658  86E3 4E               ld   c, (hl)

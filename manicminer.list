2791+ 6BDA
2792+ 6BDA                  ; Calcola AttrOffset = BC - 23552
2793+ 6BDA 60               ld   h, b
2794+ 6BDB 69               ld   l, c
2795+ 6BDC 01 00 A4         ld   bc, -23552

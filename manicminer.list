 106+ 7DF5              ; Items_DrawRoom
 107+ 7DF5              ;
 108+ 7DF5              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 109+ 7DF5              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 110+ 7DF5              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 111+ 7DF5              ;
 112+ 7DF5              ; Record item nella stanza (5 byte):
 113+ 7DF5              ;   +0 Color / Attributo
 114+ 7DF5              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 115+ 7DF5              ;   +2 Attr Address High
 116+ 7DF5              ;   +3 Anim Mask (96)
 117+ 7DF5              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 118+ 7DF5              ; Fine lista: $FF
 119+ 7DF5              ; -------------------------------------------------------------------
 120+ 7DF5              Items_DrawRoom:
 121+ 7DF5 E5               push hl
 122+ 7DF6 D5               push de
 123+ 7DF7 C5               push bc
 124+ 7DF8 DD E5            push ix
 125+ 7DFA FD E5            push iy
 126+ 7DFC
 127+ 7DFC                  ; 1. Azzera items_grid (512 byte)
 128+ 7DFC 21 71 8D         ld   hl, items_grid
 129+ 7DFF 11 72 8D         ld   de, items_grid + 1
 130+ 7E02 36 00            ld   (hl), 0
 131+ 7E04 01 FF 01         ld   bc, 511
 132+ 7E07 ED B0            ldir
 133+ 7E09
 134+ 7E09                  ; 2. Nessun item attivo inizialmente nella cache
 135+ 7E09 AF               xor  a
 136+ 7E0A 32 F0 92         ld   (num_room_items), a
 137+ 7E0D
 138+ 7E0D FD 21 A0 92      ld   iy, current_room_items
 139+ 7E11
 140+ 7E11                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 141+ 7E11 2A F1 92         ld   hl, (room_ptr)
 142+ 7E14 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 143+ 7E17 19               add  hl, de
 144+ 7E18 E5               push hl
 145+ 7E19 DD E1            pop  ix                        ; IX = bitmap item
 146+ 7E1B
 147+ 7E1B                  ; 4. HL = Inizio lista item nella stanza
 148+ 7E1B 2A F1 92         ld   hl, (room_ptr)
 149+ 7E1E 11 75 02         ld   de, OFFSET_ITEMS
 150+ 7E21 19               add  hl, de
 151+ 7E22
 152+ 7E22              .loop:
 153+ 7E22 7E               ld   a, (hl)                   ; Byte 0: Color
 154+ 7E23 FE FF            cp   $FF
 155+ 7E25 28 65            jr   z, .done                  ; $FF = fine lista item
 156+ 7E27
 157+ 7E27 5F               ld   e, a                      ; E = Color
 158+ 7E28 23               inc  hl
 159+ 7E29 4E               ld   c, (hl)                   ; C = AttrAddr Low
 160+ 7E2A 23               inc  hl
 161+ 7E2B 46               ld   b, (hl)                   ; B = AttrAddr High
 162+ 7E2C 23               inc  hl                        ; Salta Anim Byte
 163+ 7E2D 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 164+ 7E2E
 165+ 7E2E 7E               ld   a, (hl)                   ; A = Collected flag
 166+ 7E2F FE FF            cp   $FF

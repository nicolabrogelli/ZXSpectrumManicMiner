 178+ 83AE              ; -------------------------------------------------------------------
 179+ 83AE              ; Audio_PlayCollectSound
 180+ 83AE              ;
 181+ 83AE              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 83AE              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 83AE              ; -------------------------------------------------------------------
 184+ 83AE              Audio_PlayCollectSound:
 185+ 83AE C5               push bc
 186+ 83AF D5               push de
 187+ 83B0
 188+ 83B0 06 78            ld   b, 120
 189+ 83B2              .sound_loop:
 190+ 83B2 3A 75 AA         ld   a, (room_border_color)
 191+ 83B5 F6 10            or   $10               ; speaker ON
 192+ 83B7 D3 FE            out  ($fe), a
 193+ 83B9
 194+ 83B9 0E 3C            ld   c, 60
 195+ 83BB              .d1:
 196+ 83BB 0D               dec  c
 197+ 83BC 20 FD            jr   nz, .d1
 198+ 83BE
 199+ 83BE 3A 75 AA         ld   a, (room_border_color)
 200+ 83C1 E6 EF            and  $ef              ; speaker OFF
 201+ 83C3 D3 FE            out  ($fe), a
 202+ 83C5
 203+ 83C5 0E 3C            ld   c, 60
 204+ 83C7              .d2:
 205+ 83C7 0D               dec  c
 206+ 83C8 20 FD            jr   nz, .d2
 207+ 83CA
 208+ 83CA 10 E6            djnz .sound_loop
 209+ 83CC
 210+ 83CC D1               pop  de
 211+ 83CD C1               pop  bc
 212+ 83CE C9               ret

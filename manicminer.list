 469+ 7D0C              .vertical:
 470+ 7D0C DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 471+ 7D0F FE 01            cp   1
 472+ 7D11 20 20            jr   nz, .vert_down
 473+ 7D13
 474+ 7D13              .vert_up:

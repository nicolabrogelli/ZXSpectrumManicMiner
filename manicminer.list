 152  8974 ED 43 B8 EA      ld   (PlayerPosOld), bc
 153  8978
 154  8978                  ; 8. Aggiorna le posizioni dei personaggi per il prossimo frame
 155  8978 CD D6 70         call Input_CheckCtrl
 156  897B CD F9 6E         call MovePlayer
 157  897E CD 3B 74         call Phys_ApplyGravity
 158  8981                  IF ENABLE_FALL_DEATH != 0
 159  8981 DA A6 89         jp   c, .willy_dies
 160  8984                  ENDIF
 161  8984 CD DD 80         call Enemy_Update
 162  8987 CD E8 86         call Items_CheckCollision
 163  898A CD FD 87         call Items_Animate
 164  898D CD 25 84         call Kong_CheckSwitches
 165  8990
 166  8990                  ; Controlla passaggio alla stanza successiva tramite Portale (dopo aver raccolto tutti gli item)
 167  8990 CD E8 8A         call CheckPortalTransition
 168  8993 DA 42 8B         jp   c, TriggerPortalTransition
 169  8996
 170  8996                  ; Controlla collisione con Nasties (morte di Willy)
 171  8996                  IF ENABLE_NASTY_COLLISION_DEATH != 0
 172  8996 CD 5F 7C         call Phys_CheckNastyCollision
 173  8999 38 0B            jr   c, .willy_dies
 174  899B                  ENDIF
 175  899B
 176  899B                  ; Controlla collisione con guardiani
 177  899B CD A1 82         call CheckCollision
 178  899E 38 03            jr   c, .guardian_collision_found
 179  89A0
 180  89A0                  ; Nessuna collisione con guardiani. Controlla se Willy è su rampa per debug raster bar
 181  89A0                  IF ENABLE_RAMP_DEBUG_BARS != 0
 182  89A0 ~                ld   a, (willy_on_ramp)
 183  89A0 ~                or   a
 184  89A0 ~                jp   nz, .draw_raster_bars
 185  89A0                  ENDIF
 186  89A0
 187  89A0 C3 15 8A         jp   .no_collision
 188  89A3
 189  89A3              .guardian_collision_found:
 190  89A3                  ; C'è collisione con un guardiano!
 191  89A3                  ; Controlla se la morte per collisione con i guardiani è abilitata
 192  89A3                  IF ENABLE_GUARDIAN_COLLISION_DEATH != 0
 193  89A3 C3 A6 89         jp   .willy_dies
 194  89A6                  ELSE
 195  89A6 ~                    IF ENABLE_GUARDIAN_DEBUG_BARS != 0
 196  89A6 ~                    jp   .draw_raster_bars ; disegna le raster bar per debug se abilitate
 197  89A6 ~                    ELSE
 198  89A6 ~                    jp   .no_collision
 199  89A6 ~                    ENDIF
 200  89A6                  ENDIF
 201  89A6
 202  89A6              .willy_dies:
 203  89A6                  ; 1. Decrementa le vite
 204  89A6 21 C3 EA         ld   hl, willy_lives
 205  89A9 7E               ld   a, (hl)
 206  89AA B7               or   a
 207  89AB 28 05            jr   z, .check_game_over
 208  89AD 35               dec  (hl)
 209  89AE 28 02            jr   z, .check_game_over
 210  89B0 18 03            jr   .normal_respawn
 211  89B2
 212  89B2              .check_game_over:
 213  89B2                  IF ENABLE_GAME_OVER_RESTART != 0
 214  89B2 C3 61 8A         jp   TriggerGameOver
 215  89B5                  ELSE
 216  89B5 ~                ld   a, 1
 217  89B5 ~                ld   (willy_lives), a
 218  89B5 ~                jr   .normal_respawn
 219  89B5                  ENDIF
 220  89B5
 221  89B5              .normal_respawn:
 222  89B5                  ; 1b. Ripristina tutti gli item della stanza corrente (tutti tornano visibili e da raccogliere)
 223  89B5 CD 5B 85         call Items_ResetCurrentRoomItems
 224  89B8
 225  89B8                  ; 2. Cancella lo schermo a nero (imposta bordo e schermo a nero)
 226  89B8 AF               xor  a
 227  89B9 D3 FE            out  ($fe), a              ; Imposta colore bordo hardware a nero
 228  89BB CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce il display RAM e imposta gli attributi a nero
 229  89BE
 230  89BE                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 231  89BE 06 19            ld   b, 25
 232  89C0              .death_pause:
 233  89C0 76               halt
 234  89C1 10 FD            djnz .death_pause
 235  89C3
 236  89C3                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 237  89C3 AF               xor  a
 238  89C4 32 C4 EA         ld   (velocity_y), a
 239  89C7 32 C6 EA         ld   (jump_pressed), a
 240  89CA 32 C8 EA         ld   (coyote_timer), a
 241  89CD 32 CB EA         ld   (jump_frame), a
 242  89D0 32 CA EA         ld   (jump_dir), a
 243  89D3 32 BC EA         ld   (body_state), a
 244  89D6 32 BF EE         ld   (player_old_body), a
 245  89D9 32 BE EE         ld   (player_old_dir), a
 246  89DC 32 C1 EA         ld   (sprite_shift), a
 247  89DF 32 BF EA         ld   (collision_active), a
 248  89E2 32 C3 EE         ld   (willy_needs_redraw), a
 249  89E5 32 CC EA         ld   (current_input_dir), a
 250  89E8 32 E1 ED         ld   (conveyor_caught), a
 251  89EB 32 3D EE         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 252  89EE 3E 01            ld   a, 1
 253  89F0 32 C5 EA         ld   (on_ground), a
 254  89F3
 255  89F3 3E 00            ld   a, RESPAWN_SAFETY_TIME
 256  89F5 32 C2 EE         ld   (willy_safety_timer), a
 257  89F8
 258  89F8                  ; 5. Ricarica la stanza e riposiziona Willy al punto di spawn definito nella stanza
 259  89F8 C3 DE 88         jp   LoadRoomAndRestart
 260  89FB
 261  89FB              .draw_raster_bars:
 262  89FB                  ; Collisione attiva: disegna le raster bar nel bordo
 263  89FB 3A D7 EA         ld   a, (counter)
 264  89FE E6 07            and  7                 ; Colore iniziale basato sul contatore di frame
 265  8A00 06 1E            ld   b, 30             ; Numero di righe della barra raster
 266  8A02              .raster_loop:
 267  8A02 D3 FE            out  ($fe), a
 268  8A04 3C               inc  a
 269  8A05 E6 07            and  7
 270  8A07 0E 96            ld   c, 150            ; Delay per regolare l'altezza delle bande
 271  8A09              .delay:
 272  8A09 0D               dec  c
 273  8A0A 20 FD            jr   nz, .delay
 274  8A0C 10 F4            djnz .raster_loop
 275  8A0E
 276  8A0E                  ; Ripristina il bordo al colore della stanza dopo il disegno delle barre
 277  8A0E 3A C2 EA         ld   a, (room_border_color)
 278  8A11 D3 FE            out  ($fe), a
 279  8A13 18 05            jr   .no_collision_change
 280  8A15
 281  8A15              .no_collision:
 282  8A15                  ; Nessuna collisione: mantieni il bordo al colore della stanza
 283  8A15 3A C2 EA         ld   a, (room_border_color)
 284  8A18 D3 FE            out  ($fe), a
 285  8A1A
 286  8A1A              .no_collision_change:
 287  8A1A C3 41 89         jp   Main_loop
 288  8A1D
 289  8A1D              ; -------------------------------------------------------------------
 290  8A1D              ; ShowTitleScreen
 291  8A1D              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  8A1D              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  8A1D              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  8A1D              ; -------------------------------------------------------------------
 295  8A1D              ShowTitleScreen:
 296  8A1D                  ; 1. Disegna la schermata iniziale
 297  8A1D CD 7A 64         call Gfx_DrawTitleScreen
 298  8A20
 299  8A20                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  8A20              .wait_title_enter_release:
 301  8A20 76               halt
 302  8A21 3E BF            ld   a, $bf
 303  8A23 DB FE            in   a, ($fe)
 304  8A25 1F               rra
 305  8A26 30 F8            jr   nc, .wait_title_enter_release
 306  8A28
 307  8A28                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  8A28 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  8A2A              .title_loop:
 310  8A2A 76               halt
 311  8A2B
 312  8A2B                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  8A2B 0C               inc  c
 314  8A2C 79               ld   a, c
 315  8A2D CB 3F            srl  a
 316  8A2F CB 3F            srl  a
 317  8A31 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  8A33 E6 07            and  7
 319  8A35 5F               ld   e, a
 320  8A36 16 00            ld   d, 0
 321  8A38 21 72 64         ld   hl, title_color_table
 322  8A3B 19               add  hl, de
 323  8A3C 7E               ld   a, (hl)               ; A = nuovo colore
 324  8A3D 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  8A40 06 20            ld   b, 32
 326  8A42              .color_title_loop:
 327  8A42 77               ld   (hl), a
 328  8A43 23               inc  hl
 329  8A44 10 FC            djnz .color_title_loop
 330  8A46
 331  8A46                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  8A46 3E BF            ld   a, $bf
 333  8A48 DB FE            in   a, ($fe)
 334  8A4A 1F               rra
 335  8A4B 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  8A4D
 337  8A4D                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  8A4D              .wait_title_enter_release_after:
 339  8A4D 76               halt
 340  8A4E 3E BF            ld   a, $bf
 341  8A50 DB FE            in   a, ($fe)
 342  8A52 1F               rra
 343  8A53 30 F8            jr   nc, .wait_title_enter_release_after
 344  8A55
 345  8A55                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  8A55 AF               xor  a
 347  8A56 D3 FE            out  ($fe), a              ; Bordo a nero
 348  8A58 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  8A5B
 350  8A5B                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  8A5B CD 1C 8C         call ResetFullGameState
 352  8A5E
 353  8A5E                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  8A5E C3 DE 88         jp   LoadRoomAndRestart
 355  8A61
 356  8A61              ; -------------------------------------------------------------------
 357  8A61              ; TriggerGameOver
 358  8A61              ; Scatena la sequenza originale di Game Over:
 359  8A61              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  8A61              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  8A61              ;   con suono beeper originale e lampeggio dello schermo.
 362  8A61              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  8A61              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  8A61              ; -------------------------------------------------------------------
 365  8A61              TriggerGameOver:
 366  8A61                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  8A61 CD C8 87         call Score_CheckAndUpdateHighScore
 368  8A64
 369  8A64                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  8A64 CD 12 66         call Gfx_DrawGameOverScreen
 371  8A67
 372  8A67                  ; 3. Ritorna al Title Screen originale
 373  8A67 C3 1D 8A         jp   ShowTitleScreen
 374  8A6A
 375  8A6A              ; -------------------------------------------------------------------
 376  8A6A              ; TriggerVictory
 377  8A6A              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  8A6A              ; - Pulisce gli elementi di gioco della stanza.
 379  8A6A              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  8A6A              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  8A6A              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  8A6A              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  8A6A              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  8A6A              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  8A6A              ; -------------------------------------------------------------------
 386  8A6A              TriggerVictory:
 387  8A6A                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  8A6A CD FD 66         call Gfx_DrawVictoryScreen
 389  8A6D
 390  8A6D                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8A6D              .wait_keys_release:
 392  8A6D 76               halt
 393  8A6E                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8A6E 01 FE DF         ld   bc, $dffe
 395  8A71 ED 78            in   a, (c)
 396  8A73 CB 67            bit  4, a
 397  8A75 28 F6            jr   z, .wait_keys_release
 398  8A77
 399  8A77                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8A77 01 FE 7F         ld   bc, $7ffe
 401  8A7A ED 78            in   a, (c)
 402  8A7C CB 5F            bit  3, a
 403  8A7E 28 ED            jr   z, .wait_keys_release
 404  8A80
 405  8A80                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8A80 01 FE BF         ld   bc, $bffe
 407  8A83 ED 78            in   a, (c)
 408  8A85 CB 47            bit  0, a
 409  8A87 28 E4            jr   z, .wait_keys_release
 410  8A89
 411  8A89                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8A89 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8A8B              .wait_choice_loop:
 414  8A8B 76               halt
 415  8A8C
 416  8A8C                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8A8C 0C               inc  c
 418  8A8D 79               ld   a, c
 419  8A8E CB 3F            srl  a
 420  8A90 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8A92 E6 07            and  7
 422  8A94 5F               ld   e, a
 423  8A95 16 00            ld   d, 0
 424  8A97 21 F4 65         ld   hl, victory_color_table
 425  8A9A 19               add  hl, de
 426  8A9B 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8A9C 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8A9F 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8AA1              .color_cycle_loop:
 430  8AA1 77               ld   (hl), a
 431  8AA2 23               inc  hl
 432  8AA3 10 FC            djnz .color_cycle_loop
 433  8AA5
 434  8AA5                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8AA5 01 FE DF         ld   bc, $dffe
 436  8AA8 ED 78            in   a, (c)
 437  8AAA CB 67            bit  4, a
 438  8AAC 28 2A            jr   z, .play_again_chosen
 439  8AAE
 440  8AAE                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8AAE 01 FE 7F         ld   bc, $7ffe
 442  8AB1 ED 78            in   a, (c)
 443  8AB3 CB 5F            bit  3, a
 444  8AB5 28 0B            jr   z, .quit_chosen
 445  8AB7
 446  8AB7                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8AB7 01 FE BF         ld   bc, $bffe
 448  8ABA ED 78            in   a, (c)
 449  8ABC CB 47            bit  0, a
 450  8ABE 28 02            jr   z, .quit_chosen
 451  8AC0
 452  8AC0 18 C9            jr   .wait_choice_loop
 453  8AC2
 454  8AC2              .quit_chosen:
 455  8AC2                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8AC2              .wait_quit_release:
 457  8AC2 76               halt
 458  8AC3 01 FE 7F         ld   bc, $7ffe
 459  8AC6 ED 78            in   a, (c)
 460  8AC8 CB 5F            bit  3, a
 461  8ACA 28 F6            jr   z, .wait_quit_release
 462  8ACC 01 FE BF         ld   bc, $bffe
 463  8ACF ED 78            in   a, (c)
 464  8AD1 CB 47            bit  0, a
 465  8AD3 28 ED            jr   z, .wait_quit_release
 466  8AD5
 467  8AD5                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8AD5 C3 1D 8A         jp   ShowTitleScreen
 469  8AD8
 470  8AD8              .play_again_chosen:
 471  8AD8                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8AD8              .wait_play_again_release:
 473  8AD8 76               halt
 474  8AD9 01 FE DF         ld   bc, $dffe
 475  8ADC ED 78            in   a, (c)
 476  8ADE CB 67            bit  4, a
 477  8AE0 28 F6            jr   z, .wait_play_again_release
 478  8AE2
 479  8AE2                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8AE2 CD 1C 8C         call ResetFullGameState
 481  8AE5 C3 DE 88         jp   LoadRoomAndRestart
 482  8AE8
 483  8AE8              ; -------------------------------------------------------------------
 484  8AE8              ; CheckPortalTransition
 485  8AE8              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8AE8              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8AE8              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8AE8              ;
 489  8AE8              ; Output:
 490  8AE8              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8AE8              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8AE8              ; -------------------------------------------------------------------
 493  8AE8              CheckPortalTransition:
 494  8AE8 C5               push bc
 495  8AE9 D5               push de
 496  8AEA E5               push hl
 497  8AEB
 498  8AEB                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8AEB CD AF 8B         call CheckAllItemsCollected
 500  8AEE 30 4D            jr   nc, .no_transition
 501  8AF0
 502  8AF0                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8AF0                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8AF0                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8AF0 2A 37 EE         ld   hl, (room_ptr)
 506  8AF3 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8AF6 19               add  hl, de
 508  8AF7 4E               ld   c, (hl)
 509  8AF8 23               inc  hl
 510  8AF9 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8AFA
 512  8AFA                  ; Offset = BC - 23552
 513  8AFA 60               ld   h, b
 514  8AFB 69               ld   l, c
 515  8AFC 01 00 A4         ld   bc, -23552
 516  8AFF 09               add  hl, bc
 517  8B00
 518  8B00                  ; PortalX = (Offset & 31) * 8
 519  8B00 7D               ld   a, l
 520  8B01 E6 1F            and  31
 521  8B03 87               add  a, a
 521  8B04 87             add a, a
 521  8B05 87             add a, a
 522  8B06 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8B07
 524  8B07                  ; PortalY = (Offset / 32) * 8
 525  8B07 CB 3C            srl  h
 525  8B09 CB 1D          rr l
 526  8B0B CB 3C            srl  h
 526  8B0D CB 1D          rr l
 527  8B0F CB 3C            srl  h
 527  8B11 CB 1D          rr l
 528  8B13 CB 3C            srl  h
 528  8B15 CB 1D          rr l
 529  8B17 CB 3C            srl  h
 529  8B19 CB 1D          rr l
 530  8B1B 7D               ld   a, l
 531  8B1C 87               add  a, a
 531  8B1D 87             add a, a
 531  8B1E 87             add a, a
 532  8B1F 57               ld   d, a                      ; D = PortalY (0..120)
 533  8B20
 534  8B20                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8B20 ED 4B B6 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8B24
 537  8B24                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8B24 7B               ld   a, e
 539  8B25 91               sub  c
 540  8B26 30 02            jr   nc, .x_diff_pos
 541  8B28 ED 44            neg
 542  8B2A              .x_diff_pos:
 543  8B2A FE 0C            cp   12
 544  8B2C 30 0F            jr   nc, .no_transition
 545  8B2E
 546  8B2E                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8B2E 7A               ld   a, d
 548  8B2F 90               sub  b
 549  8B30 30 02            jr   nc, .y_diff_pos
 550  8B32 ED 44            neg
 551  8B34              .y_diff_pos:
 552  8B34 FE 0E            cp   14
 553  8B36 30 05            jr   nc, .no_transition
 554  8B38
 555  8B38                  ; Transizione al portale attiva!
 556  8B38 E1               pop  hl
 557  8B39 D1               pop  de
 558  8B3A C1               pop  bc
 559  8B3B 37               scf
 560  8B3C C9               ret
 561  8B3D
 562  8B3D              .no_transition:
 563  8B3D E1               pop  hl
 564  8B3E D1               pop  de
 565  8B3F C1               pop  bc
 566  8B40 B7               or   a
 567  8B41 C9               ret
 568  8B42
 569  8B42              ; Alias per retrocompatibilità
 570  8B42              CheckVictoryCondition: EQU CheckPortalTransition
 571  8B42
 572  8B42              ; -------------------------------------------------------------------
 573  8B42              ; TriggerPortalTransition
 574  8B42              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 575  8B42              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 576  8B42              ; - Avanza all'indice della stanza successiva.
 577  8B42              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 578  8B42              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 579  8B42              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 580  8B42              ; -------------------------------------------------------------------
 581  8B42              TriggerPortalTransition:
 582  8B42                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 583  8B42 CD 79 8B         call Air_DepleteCountdown
 584  8B45
 585  8B45                  ; 1. Determina l'ID della stanza corrente
 586  8B45 CD 09 85         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 587  8B48
 588  8B48                  ; 2. Calcola l'indice della stanza successiva
 589  8B48 3A DC ED         ld   a, (current_room)
 590  8B4B 3C               inc  a
 591  8B4C FE 14            cp   NUM_ROOMS
 592  8B4E 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 593  8B50
 594  8B50                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 595  8B50 21 A2 73         ld   hl, RoomsListTable
 596  8B53 5F               ld   e, a
 597  8B54 16 00            ld   d, 0
 598  8B56 19               add  hl, de
 599  8B57 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 600  8B58 5E               ld   e, (hl)
 601  8B59 23               inc  hl
 602  8B5A 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 603  8B5B ED 53 37 EE      ld   (room_ptr), de
 604  8B5F
 605  8B5F                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 606  8B5F AF               xor  a
 607  8B60 32 3D EE         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 608  8B63 32 C4 EA         ld   (velocity_y), a
 609  8B66 32 CF F0         ld   (game_objective_completed), a
 610  8B69 3E 01            ld   a, 1
 611  8B6B 32 C5 EA         ld   (on_ground), a
 612  8B6E
 613  8B6E                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 614  8B6E 3E 07            ld   a, $07
 615  8B70 CD 9D 62         call Gfx_ClearScreenDirect

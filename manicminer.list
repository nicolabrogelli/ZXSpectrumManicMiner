 206+ 7DB9
 207+ 7DB9 23               inc  hl
 208+ 7DBA 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 209+ 7DBB DD 77 05         ld   (ix+5), a                 ; Max Limit Y

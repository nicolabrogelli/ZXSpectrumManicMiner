 649  868F              ; -------------------------------------------------------------------
 650  868F              ; CheckPortalTransition
 651  868F              ; Verifica le condizioni per accedere alla stanza successiva:
 652  868F              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 653  868F              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 654  868F              ;
 655  868F              ; Output:
 656  868F              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 657  868F              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 658  868F              ; -------------------------------------------------------------------
 659  868F              CheckPortalTransition:
 660  868F C5               push bc
 661  8690 D5               push de
 662  8691 E5               push hl
 663  8692
 664  8692                  ; 1. Tutti gli item della stanza sono stati raccolti?
 665  8692 CD 20 87         call CheckAllItemsCollected
 666  8695 30 4D            jr   nc, .no_transition
 667  8697
 668  8697                  ; 2. Willy collide con il portale (16x16 pixel)?
 669  8697                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 670  8697                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 671  8697 2A B3 A1         ld   hl, (room_ptr)
 672  869A 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 673  869D 19               add  hl, de
 674  869E 4E               ld   c, (hl)
 675  869F 23               inc  hl
 676  86A0 46               ld   b, (hl)                   ; BC = AttrAddr
 677  86A1
 678  86A1                  ; Offset = BC - 23552
 679  86A1 60               ld   h, b
 680  86A2 69               ld   l, c
 681  86A3 01 00 A4         ld   bc, -23552
 682  86A6 09               add  hl, bc
 683  86A7
 684  86A7                  ; PortalX = (Offset & 31) * 8
 685  86A7 7D               ld   a, l
 686  86A8 E6 1F            and  31
 687  86AA 87               add  a, a
 687  86AB 87             add a, a
 687  86AC 87             add a, a
 688  86AD 5F               ld   e, a                      ; E = PortalX (0..248)
 689  86AE
 690  86AE                  ; PortalY = (Offset / 32) * 8
 691  86AE CB 3C            srl  h
 691  86B0 CB 1D          rr l
 692  86B2 CB 3C            srl  h
 692  86B4 CB 1D          rr l
 693  86B6 CB 3C            srl  h
 693  86B8 CB 1D          rr l
 694  86BA CB 3C            srl  h
 694  86BC CB 1D          rr l
 695  86BE CB 3C            srl  h
 695  86C0 CB 1D          rr l
 696  86C2 7D               ld   a, l
 697  86C3 87               add  a, a
 697  86C4 87             add a, a
 697  86C5 87             add a, a
 698  86C6 57               ld   d, a                      ; D = PortalY (0..120)
 699  86C7
 700  86C7                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 701  86C7 ED 4B 32 9E      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 702  86CB
 703  86CB                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 704  86CB 7B               ld   a, e
 705  86CC 91               sub  c
 706  86CD 30 02            jr   nc, .x_diff_pos
 707  86CF ED 44            neg
 708  86D1              .x_diff_pos:
 709  86D1 FE 0C            cp   12
 710  86D3 30 0F            jr   nc, .no_transition
 711  86D5
 712  86D5                  ; Controllo verticale: |WillyY - PortalY| < 14
 713  86D5 7A               ld   a, d
 714  86D6 90               sub  b
 715  86D7 30 02            jr   nc, .y_diff_pos
 716  86D9 ED 44            neg
 717  86DB              .y_diff_pos:
 718  86DB FE 0E            cp   14
 719  86DD 30 05            jr   nc, .no_transition
 720  86DF
 721  86DF                  ; Transizione al portale attiva!
 722  86DF E1               pop  hl
 723  86E0 D1               pop  de
 724  86E1 C1               pop  bc
 725  86E2 37               scf
 726  86E3 C9               ret
 727  86E4
 728  86E4              .no_transition:
 729  86E4 E1               pop  hl
 730  86E5 D1               pop  de
 731  86E6 C1               pop  bc
 732  86E7 B7               or   a
 733  86E8 C9               ret
 734  86E9
 735  86E9              ; Alias per retrocompatibilità
 736  86E9              CheckVictoryCondition: EQU CheckPortalTransition
 737  86E9
 738  86E9              ; -------------------------------------------------------------------
 739  86E9              ; TriggerPortalTransition
 740  86E9              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 741  86E9              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 742  86E9              ; - Avanza all'indice della stanza successiva.
 743  86E9              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 744  86E9              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 745  86E9              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 746  86E9              ; -------------------------------------------------------------------
 747  86E9              TriggerPortalTransition:
 748  86E9                  ; 1. Determina l'ID della stanza corrente
 749  86E9 CD 37 80         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 750  86EC
 751  86EC                  ; 2. Calcola l'indice della stanza successiva
 752  86EC 3A 58 A1         ld   a, (current_room)
 753  86EF 3C               inc  a
 754  86F0 FE 04            cp   NUM_ROOMS
 755  86F2 30 29            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 756  86F4
 757  86F4                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 758  86F4 21 7C 73         ld   hl, RoomsListTable
 759  86F7 5F               ld   e, a
 760  86F8 16 00            ld   d, 0
 761  86FA 19               add  hl, de
 762  86FB 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 763  86FC 5E               ld   e, (hl)
 764  86FD 23               inc  hl
 765  86FE 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 766  86FF ED 53 B3 A1      ld   (room_ptr), de
 767  8703
 768  8703                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 769  8703 AF               xor  a
 770  8704 32 B9 A1         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 771  8707 32 40 9E         ld   (velocity_y), a
 772  870A 32 48 A4         ld   (game_objective_completed), a
 773  870D 3E 01            ld   a, 1
 774  870F 32 41 9E         ld   (on_ground), a
 775  8712
 776  8712                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 777  8712 21 8D 5C         ld   hl, ATTR_P
 778  8715 36 07            ld   (hl), $07
 779  8717 CD AF 0D         call CLS
 780  871A
 781  871A C3 8B 83         jp   LoadRoomAndRestart
 782  871D
 783  871D              .all_rooms_completed:
 784  871D                  ; Tutte le stanze sono state completate con successo!
 785  871D                  IF ENABLE_VICTORY_SCREEN != 0
 786  871D C3 11 86         jp   TriggerVictory
 787  8720                  ELSE
 788  8720 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 789  8720 ~                ld   de, (RoomsListTable)
 790  8720 ~                ld   (room_ptr), de
 791  8720 ~                xor  a
 792  8720 ~                ld   (transition_active), a
 793  8720 ~                ld   (velocity_y), a
 794  8720 ~                ld   (game_objective_completed), a
 795  8720 ~                ld   a, 1
 796  8720 ~                ld   (on_ground), a
 797  8720 ~                ld   hl, ATTR_P
 798  8720 ~                ld   (hl), $07
 799  8720 ~                call CLS
 800  8720 ~                jp   LoadRoomAndRestart
 801  8720                  ENDIF
 802  8720
 803  8720              ; -------------------------------------------------------------------
 804  8720              ; CheckAllItemsCollected
 805  8720              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 806  8720              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 807  8720              ; -------------------------------------------------------------------
 808  8720              CheckAllItemsCollected:
 809  8720 3A 48 A4         ld   a, (game_objective_completed)
 810  8723 B7               or   a
 811  8724 20 08            jr   nz, .all_collected
 812  8726 3A B2 A1         ld   a, (num_room_items)
 813  8729 B7               or   a
 814  872A 28 02            jr   z, .all_collected
 815  872C B7               or   a
 816  872D C9               ret
 817  872E              .all_collected:
 818  872E 37               scf
 819  872F C9               ret
 820  8730
 821  8730              ; -------------------------------------------------------------------
 822  8730              ; CheckInMasterBedroom (alias per retrocompatibilità)
 823  8730              ; -------------------------------------------------------------------
 824  8730              CheckInMasterBedroom:
 825  8730 37               scf
 826  8731 C9               ret
 827  8732
 828  8732              ; -------------------------------------------------------------------
 829  8732              ; CheckWillyConveyorCollision
 830  8732              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 831  8732              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 832  8732              ; -------------------------------------------------------------------
 833  8732              CheckWillyConveyorCollision:
 834  8732 C5               push bc
 835  8733 D5               push de
 836  8734 E5               push hl
 837  8735
 838  8735                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 839  8735 CD 50 77         call CheckWillyOnConveyor
 840  8738 38 49            jr   c, .collision_detected
 841  873A
 842  873A                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 843  873A 3A 5A A1         ld   a, (conveyor_len)
 844  873D B7               or   a
 845  873E 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 846  8740
 847  8740                  ; B = WillyY, C = WillyX
 848  8740 ED 4B 32 9E      ld   bc, (PlayerPos)
 849  8744
 850  8744                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 851  8744 3A 5B A1         ld   a, (conveyor_row)
 852  8747 87               add  a, a                  ; *2
 853  8748 87               add  a, a                  ; *4
 854  8749 87               add  a, a                  ; *8
 855  874A 5F               ld   e, a                  ; E = ConveyorTop
 856  874B C6 07            add  a, 7
 857  874D 57               ld   d, a                  ; D = ConveyorBottom
 858  874E
 859  874E                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 860  874E 78               ld   a, b                  ; WillyTop
 861  874F BA               cp   d
 862  8750 28 04            jr   z, .y_overlap
 863  8752 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 864  8754 18 32            jr   .no_conv_collision
 865  8756
 866  8756              .y_overlap:
 867  8756 C6 0F            add  a, 15                 ; WillyBottom
 868  8758 BB               cp   e
 869  8759 28 04            jr   z, .x_check
 870  875B 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 871  875D 18 29            jr   .no_conv_collision
 872  875F
 873  875F              .x_check:
 874  875F                  ; ConveyorLeft = conveyor_col * 8
 875  875F 3A 5C A1         ld   a, (conveyor_col)
 876  8762 87               add  a, a                  ; *2
 877  8763 87               add  a, a                  ; *4
 878  8764 87               add  a, a                  ; *8
 879  8765 5F               ld   e, a                  ; E = ConveyorLeft
 880  8766
 881  8766                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 882  8766 21 5A A1         ld   hl, conveyor_len
 883  8769 3A 5C A1         ld   a, (conveyor_col)
 884  876C 86               add  a, (hl)
 885  876D 87               add  a, a                  ; *2
 886  876E 87               add  a, a                  ; *4
 887  876F 87               add  a, a                  ; *8
 888  8770 3D               dec  a                     ; ConveyorRight
 889  8771 57               ld   d, a                  ; D = ConveyorRight
 890  8772
 891  8772                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 892  8772 79               ld   a, c                  ; WillyLeft
 893  8773 BA               cp   d
 894  8774 28 04            jr   z, .x_overlap
 895  8776 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 896  8778 18 0E            jr   .no_conv_collision
 897  877A
 898  877A              .x_overlap:
 899  877A C6 0F            add  a, 15                 ; WillyRight
 900  877C BB               cp   e
 901  877D 28 04            jr   z, .collision_detected
 902  877F 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 903  8781 18 05            jr   .no_conv_collision
 904  8783
 905  8783              .collision_detected:
 906  8783 E1               pop  hl
 907  8784 D1               pop  de
 908  8785 C1               pop  bc
 909  8786 37               scf
 910  8787 C9               ret
 911  8788
 912  8788              .no_conv_collision:
 913  8788 E1               pop  hl
 914  8789 D1               pop  de
 915  878A C1               pop  bc
 916  878B B7               or   a
 917  878C C9               ret

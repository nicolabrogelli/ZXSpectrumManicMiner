 501  86E9
 502  86E9                  ; - Ripristina lo stato audio
 503  86E9 3E 12            ld   a, 18
 504  86EB 32 2F E5         ld   (Audio_jump_sound_note), a
 505  86EE AF               xor  a
 506  86EF 32 30 E5         ld   (Audio_jump_sound_timer), a
 507  86F2                  IF ENABLE_MUSIC != 0
 508  86F2 ~                ld   (Audio_music_note_idx), a
 509  86F2 ~                ld   a, 1
 510  86F2 ~                ld   (Audio_music_frame_counter), a
 511  86F2                  ENDIF
 512  86F2
 513  86F2                  ; - Riposiziona Willy nel punto di default definito nella stanza
 514  86F2 AF               xor  a
 515  86F3 32 99 E2         ld   (transition_active), a
 516  86F6
 517  86F6                  ; - Cancella lo schermo a nero prima del caricamento
 518  86F6 AF               xor  a
 519  86F7 D3 FE            out  ($fe), a
 520  86F9 CD 99 62         call Gfx_ClearScreenDirect
 521  86FC
 522  86FC                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 523  86FC C3 9A 84         jp   LoadRoomAndRestart
 524  86FF
 525  86FF              ; -------------------------------------------------------------------
 526  86FF              ; TriggerVictory
 527  86FF              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 528  86FF              ; - Pulisce gli elementi di gioco della stanza.
 529  86FF              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 530  86FF              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 531  86FF              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 532  86FF              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 533  86FF              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 534  86FF              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 535  86FF              ; -------------------------------------------------------------------
 536  86FF              TriggerVictory:
 537  86FF                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 538  86FF CD F3 66         call Gfx_DrawVictoryScreen
 539  8702
 540  8702                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 541  8702              .wait_keys_release:
 542  8702 76               halt
 543  8703                  ; Controlla tasto Y (Porta $DF, bit 4)
 544  8703 01 FE DF         ld   bc, $dffe
 545  8706 ED 78            in   a, (c)
 546  8708 CB 67            bit  4, a
 547  870A 28 F6            jr   z, .wait_keys_release
 548  870C
 549  870C                  ; Controlla tasto N (Porta $7F, bit 3)
 550  870C 01 FE 7F         ld   bc, $7ffe
 551  870F ED 78            in   a, (c)
 552  8711 CB 5F            bit  3, a
 553  8713 28 ED            jr   z, .wait_keys_release
 554  8715
 555  8715                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  8715 01 FE BF         ld   bc, $bffe
 557  8718 ED 78            in   a, (c)
 558  871A CB 47            bit  0, a
 559  871C 28 E4            jr   z, .wait_keys_release
 560  871E
 561  871E                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  871E 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  8720              .wait_choice_loop:
 564  8720 76               halt
 565  8721
 566  8721                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 567  8721 0C               inc  c
 568  8722 79               ld   a, c
 569  8723 CB 3F            srl  a
 570  8725 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 571  8727 E6 07            and  7
 572  8729 5F               ld   e, a
 573  872A 16 00            ld   d, 0
 574  872C 21 0D 66         ld   hl, victory_color_table
 575  872F 19               add  hl, de
 576  8730 7E               ld   a, (hl)               ; A = nuovo colore attributo
 577  8731 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 578  8734 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 579  8736              .color_cycle_loop:
 580  8736 77               ld   (hl), a
 581  8737 23               inc  hl
 582  8738 10 FC            djnz .color_cycle_loop
 583  873A
 584  873A                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 585  873A 01 FE DF         ld   bc, $dffe
 586  873D ED 78            in   a, (c)
 587  873F CB 67            bit  4, a
 588  8741 28 2A            jr   z, .play_again_chosen
 589  8743
 590  8743                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 591  8743 01 FE 7F         ld   bc, $7ffe
 592  8746 ED 78            in   a, (c)
 593  8748 CB 5F            bit  3, a
 594  874A 28 0B            jr   z, .quit_chosen
 595  874C
 596  874C                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 597  874C 01 FE BF         ld   bc, $bffe
 598  874F ED 78            in   a, (c)
 599  8751 CB 47            bit  0, a
 600  8753 28 02            jr   z, .quit_chosen
 601  8755
 602  8755 18 C9            jr   .wait_choice_loop
 603  8757
 604  8757              .quit_chosen:
 605  8757                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  8757              .wait_quit_release:
 607  8757 76               halt
 608  8758 01 FE 7F         ld   bc, $7ffe
 609  875B ED 78            in   a, (c)
 610  875D CB 5F            bit  3, a
 611  875F 28 F6            jr   z, .wait_quit_release
 612  8761 01 FE BF         ld   bc, $bffe
 613  8764 ED 78            in   a, (c)
 614  8766 CB 47            bit  0, a
 615  8768 28 ED            jr   z, .wait_quit_release
 616  876A
 617  876A                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 618  876A C3 D3 85         jp   ShowTitleScreen
 619  876D
 620  876D              .play_again_chosen:
 621  876D                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 622  876D              .wait_play_again_release:
 623  876D 76               halt
 624  876E 01 FE DF         ld   bc, $dffe
 625  8771 ED 78            in   a, (c)
 626  8773 CB 67            bit  4, a
 627  8775 28 F6            jr   z, .wait_play_again_release
 628  8777
 629  8777                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 630  8777 CD 78 88         call ResetFullGameState
 631  877A C3 9A 84         jp   LoadRoomAndRestart
 632  877D
 633  877D              ; -------------------------------------------------------------------
 634  877D              ; CheckPortalTransition
 635  877D              ; Verifica le condizioni per accedere alla stanza successiva:
 636  877D              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  877D              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  877D              ;
 639  877D              ; Output:
 640  877D              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  877D              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  877D              ; -------------------------------------------------------------------
 643  877D              CheckPortalTransition:
 644  877D C5               push bc
 645  877E D5               push de
 646  877F E5               push hl
 647  8780
 648  8780                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  8780 CD 0B 88         call CheckAllItemsCollected
 650  8783 30 4D            jr   nc, .no_transition
 651  8785
 652  8785                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  8785                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  8785                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  8785 2A 93 E2         ld   hl, (room_ptr)
 656  8788 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  878B 19               add  hl, de
 658  878C 4E               ld   c, (hl)
 659  878D 23               inc  hl
 660  878E 46               ld   b, (hl)                   ; BC = AttrAddr
 661  878F
 662  878F                  ; Offset = BC - 23552
 663  878F 60               ld   h, b
 664  8790 69               ld   l, c
 665  8791 01 00 A4         ld   bc, -23552
 666  8794 09               add  hl, bc
 667  8795
 668  8795                  ; PortalX = (Offset & 31) * 8
 669  8795 7D               ld   a, l
 670  8796 E6 1F            and  31
 671  8798 87               add  a, a
 671  8799 87             add a, a
 671  879A 87             add a, a
 672  879B 5F               ld   e, a                      ; E = PortalX (0..248)
 673  879C
 674  879C                  ; PortalY = (Offset / 32) * 8
 675  879C CB 3C            srl  h
 675  879E CB 1D          rr l
 676  87A0 CB 3C            srl  h
 676  87A2 CB 1D          rr l
 677  87A4 CB 3C            srl  h
 677  87A6 CB 1D          rr l
 678  87A8 CB 3C            srl  h
 678  87AA CB 1D          rr l
 679  87AC CB 3C            srl  h
 679  87AE CB 1D          rr l
 680  87B0 7D               ld   a, l
 681  87B1 87               add  a, a
 681  87B2 87             add a, a
 681  87B3 87             add a, a
 682  87B4 57               ld   d, a                      ; D = PortalY (0..120)
 683  87B5
 684  87B5                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  87B5 ED 4B 12 DF      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  87B9
 687  87B9                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  87B9 7B               ld   a, e
 689  87BA 91               sub  c
 690  87BB 30 02            jr   nc, .x_diff_pos
 691  87BD ED 44            neg
 692  87BF              .x_diff_pos:
 693  87BF FE 0C            cp   12
 694  87C1 30 0F            jr   nc, .no_transition
 695  87C3
 696  87C3                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  87C3 7A               ld   a, d
 698  87C4 90               sub  b
 699  87C5 30 02            jr   nc, .y_diff_pos
 700  87C7 ED 44            neg
 701  87C9              .y_diff_pos:
 702  87C9 FE 0E            cp   14
 703  87CB 30 05            jr   nc, .no_transition
 704  87CD
 705  87CD                  ; Transizione al portale attiva!
 706  87CD E1               pop  hl
 707  87CE D1               pop  de
 708  87CF C1               pop  bc
 709  87D0 37               scf
 710  87D1 C9               ret
 711  87D2
 712  87D2              .no_transition:
 713  87D2 E1               pop  hl
 714  87D3 D1               pop  de
 715  87D4 C1               pop  bc
 716  87D5 B7               or   a
 717  87D6 C9               ret
 718  87D7
 719  87D7              ; Alias per retrocompatibilità
 720  87D7              CheckVictoryCondition: EQU CheckPortalTransition
 721  87D7
 722  87D7              ; -------------------------------------------------------------------
 723  87D7              ; TriggerPortalTransition
 724  87D7              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 725  87D7              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 726  87D7              ; - Avanza all'indice della stanza successiva.
 727  87D7              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 728  87D7              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 729  87D7              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 730  87D7              ; -------------------------------------------------------------------
 731  87D7              TriggerPortalTransition:
 732  87D7                  ; 1. Determina l'ID della stanza corrente
 733  87D7 CD 40 81         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 734  87DA
 735  87DA                  ; 2. Calcola l'indice della stanza successiva
 736  87DA 3A 38 E2         ld   a, (current_room)
 737  87DD 3C               inc  a
 738  87DE FE 14            cp   NUM_ROOMS
 739  87E0 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 740  87E2
 741  87E2                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 742  87E2 21 0A 73         ld   hl, RoomsListTable
 743  87E5 5F               ld   e, a
 744  87E6 16 00            ld   d, 0
 745  87E8 19               add  hl, de
 746  87E9 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 747  87EA 5E               ld   e, (hl)
 748  87EB 23               inc  hl
 749  87EC 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 750  87ED ED 53 93 E2      ld   (room_ptr), de
 751  87F1
 752  87F1                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 753  87F1 AF               xor  a
 754  87F2 32 99 E2         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 755  87F5 32 20 DF         ld   (velocity_y), a
 756  87F8 32 29 E5         ld   (game_objective_completed), a
 757  87FB 3E 01            ld   a, 1
 758  87FD 32 21 DF         ld   (on_ground), a
 759  8800
 760  8800                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 761  8800 3E 07            ld   a, $07
 762  8802 CD 99 62         call Gfx_ClearScreenDirect
 763  8805
 764  8805 C3 9A 84         jp   LoadRoomAndRestart
 765  8808
 766  8808              .all_rooms_completed:
 767  8808                  ; Tutte le stanze sono state completate con successo!
 768  8808                  IF ENABLE_VICTORY_SCREEN != 0
 769  8808 C3 FF 86         jp   TriggerVictory
 770  880B                  ELSE
 771  880B ~                ; Ricomincia dalla prima stanza (Stanza 00)
 772  880B ~                ld   de, (RoomsListTable)
 773  880B ~                ld   (room_ptr), de
 774  880B ~                xor  a
 775  880B ~                ld   (transition_active), a
 776  880B ~                ld   (velocity_y), a
 777  880B ~                ld   (game_objective_completed), a
 778  880B ~                ld   a, 1
 779  880B ~                ld   (on_ground), a
 780  880B ~                ld   a, $07
 781  880B ~                call Gfx_ClearScreenDirect
 782  880B ~                jp   LoadRoomAndRestart
 783  880B                  ENDIF
 784  880B
 785  880B              ; -------------------------------------------------------------------
 786  880B              ; CheckAllItemsCollected
 787  880B              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  880B              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  880B              ; -------------------------------------------------------------------
 790  880B              CheckAllItemsCollected:
 791  880B 3A 29 E5         ld   a, (game_objective_completed)
 792  880E B7               or   a
 793  880F 20 08            jr   nz, .all_collected
 794  8811 3A 92 E2         ld   a, (num_room_items)
 795  8814 B7               or   a
 796  8815 28 02            jr   z, .all_collected
 797  8817 B7               or   a
 798  8818 C9               ret
 799  8819              .all_collected:
 800  8819 37               scf
 801  881A C9               ret
 802  881B
 803  881B              ; -------------------------------------------------------------------
 804  881B              ; CheckInMasterBedroom (alias per retrocompatibilità)
 805  881B              ; -------------------------------------------------------------------
 806  881B              CheckInMasterBedroom:
 807  881B 37               scf
 808  881C C9               ret
 809  881D
 810  881D              ; -------------------------------------------------------------------
 811  881D              ; CheckWillyConveyorCollision
 812  881D              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 813  881D              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 814  881D              ; -------------------------------------------------------------------
 815  881D              CheckWillyConveyorCollision:
 816  881D C5               push bc
 817  881E D5               push de
 818  881F E5               push hl
 819  8820
 820  8820                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 821  8820 CD CB 76         call CheckWillyOnConveyor
 822  8823 38 49            jr   c, .collision_detected
 823  8825
 824  8825                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 825  8825 3A 3A E2         ld   a, (conveyor_len)
 826  8828 B7               or   a
 827  8829 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  882B
 829  882B                  ; B = WillyY, C = WillyX
 830  882B ED 4B 12 DF      ld   bc, (PlayerPos)
 831  882F
 832  882F                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  882F 3A 3B E2         ld   a, (conveyor_row)
 834  8832 87               add  a, a                  ; *2
 835  8833 87               add  a, a                  ; *4
 836  8834 87               add  a, a                  ; *8
 837  8835 5F               ld   e, a                  ; E = ConveyorTop
 838  8836 C6 07            add  a, 7
 839  8838 57               ld   d, a                  ; D = ConveyorBottom
 840  8839
 841  8839                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  8839 78               ld   a, b                  ; WillyTop
 843  883A BA               cp   d
 844  883B 28 04            jr   z, .y_overlap
 845  883D 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  883F 18 32            jr   .no_conv_collision
 847  8841
 848  8841              .y_overlap:
 849  8841 C6 0F            add  a, 15                 ; WillyBottom
 850  8843 BB               cp   e
 851  8844 28 04            jr   z, .x_check
 852  8846 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 853  8848 18 29            jr   .no_conv_collision
 854  884A
 855  884A              .x_check:
 856  884A                  ; ConveyorLeft = conveyor_col * 8
 857  884A 3A 3C E2         ld   a, (conveyor_col)
 858  884D 87               add  a, a                  ; *2
 859  884E 87               add  a, a                  ; *4
 860  884F 87               add  a, a                  ; *8
 861  8850 5F               ld   e, a                  ; E = ConveyorLeft
 862  8851
 863  8851                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 864  8851 21 3A E2         ld   hl, conveyor_len
 865  8854 3A 3C E2         ld   a, (conveyor_col)
 866  8857 86               add  a, (hl)
 867  8858 87               add  a, a                  ; *2
 868  8859 87               add  a, a                  ; *4
 869  885A 87               add  a, a                  ; *8
 870  885B 3D               dec  a                     ; ConveyorRight
 871  885C 57               ld   d, a                  ; D = ConveyorRight
 872  885D
 873  885D                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 874  885D 79               ld   a, c                  ; WillyLeft
 875  885E BA               cp   d
 876  885F 28 04            jr   z, .x_overlap
 877  8861 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  8863 18 0E            jr   .no_conv_collision
 879  8865
 880  8865              .x_overlap:
 881  8865 C6 0F            add  a, 15                 ; WillyRight
 882  8867 BB               cp   e
 883  8868 28 04            jr   z, .collision_detected
 884  886A 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 885  886C 18 05            jr   .no_conv_collision
 886  886E
 887  886E              .collision_detected:
 888  886E E1               pop  hl
 889  886F D1               pop  de
 890  8870 C1               pop  bc
 891  8871 37               scf
 892  8872 C9               ret
 893  8873
 894  8873              .no_conv_collision:
 895  8873 E1               pop  hl
 896  8874 D1               pop  de
 897  8875 C1               pop  bc
 898  8876 B7               or   a
 899  8877 C9               ret
 900  8878
 901  8878              ; -------------------------------------------------------------------
 902  8878              ; ResetFullGameState
 903  8878              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 904  8878              ; per l'avvio di una nuova partita dopo il Game Over.
 905  8878              ; -------------------------------------------------------------------
 906  8878              ResetFullGameState:
 907  8878                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 908  8878 AF               xor  a
 909  8879 D3 FE            out  ($fe), a              ; Bordo a nero
 910  887B CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 911  887E
 912  887E                  ; Ripristina il numero di vite iniziali
 913  887E 3E 07            ld   a, INITIAL_LIVES
 914  8880 32 1F DF         ld   (willy_lives), a
 915  8883
 916  8883                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 917  8883 AF               xor  a
 918  8884 32 1C DF         ld   (items_collected), a
 919  8887 32 18 DF         ld   (body_state), a
 920  888A 32 2B DF         ld   (w_warp_state), a
 921  888D 32 2E DF         ld   (w_key_prev), a
 922  8890 32 2F DF         ld   (enter_key_prev), a
 923  8893 32 20 DF         ld   (velocity_y), a
 924  8896 32 22 DF         ld   (jump_pressed), a
 925  8899 32 24 DF         ld   (coyote_timer), a
 926  889C 32 27 DF         ld   (jump_frame), a
 927  889F 32 26 DF         ld   (jump_dir), a
 928  88A2 32 99 E2         ld   (transition_active), a
 929  88A5 32 1E E3         ld   (willy_safety_timer), a
 930  88A8 3E FF            ld   a, $ff
 931  88AA 32 30 DF         ld   (digit_key_prev), a
 932  88AD 3E 01            ld   a, 1
 933  88AF 32 29 DF         ld   (q_prev), a
 934  88B2 32 2A DF         ld   (a_prev), a
 935  88B5 32 21 DF         ld   (on_ground), a
 936  88B8
 937  88B8                  ; Azzeramento punteggio partita corrente (Score = 000000)
 938  88B8                  ; Nota: High score viene mantenuto intatto tra le partite
 939  88B8 AF               xor  a
 940  88B9 32 23 E5         ld   (player_score + 0), a
 941  88BC 32 24 E5         ld   (player_score + 1), a
 942  88BF 32 25 E5         ld   (player_score + 2), a
 943  88C2
 944  88C2                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 945  88C2 CD 67 81         call ResetItemsTable
 946  88C5
 947  88C5                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 948  88C5 CD 05 70         call InitRoomEntryPositions
 949  88C8
 950  88C8                  ; Aggiorna la riga di stato con High score e Score azzerato
 951  88C8 CD AE 68         call Gfx_UpdateScoreDisplay

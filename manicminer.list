 279  8014              ; -------------------------------------------------------------------
 280  8014              ; ShowTitleScreen
 281  8014              ; Visualizza la schermata iniziale del gioco (Title Screen).
 282  8014              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 283  8014              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 284  8014              ; -------------------------------------------------------------------
 285  8014              ShowTitleScreen:
 286  8014                  ; 1. Disegna la schermata iniziale
 287  8014 CD 64 62         call Gfx_DrawTitleScreen
 288  8017
 289  8017                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 290  8017              .wait_title_enter_release:
 291  8017 76               halt
 292  8018 3E BF            ld   a, $bf
 293  801A DB FE            in   a, ($fe)
 294  801C 1F               rra
 295  801D 30 F8            jr   nc, .wait_title_enter_release
 296  801F
 297  801F                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 298  801F 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 299  8021              .title_loop:
 300  8021 76               halt
 301  8022
 302  8022                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 303  8022 0C               inc  c
 304  8023 79               ld   a, c
 305  8024 CB 3F            srl  a
 306  8026 CB 3F            srl  a
 307  8028 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 308  802A E6 07            and  7
 309  802C 5F               ld   e, a
 310  802D 16 00            ld   d, 0
 311  802F 21 5C 62         ld   hl, title_color_table
 312  8032 19               add  hl, de
 313  8033 7E               ld   a, (hl)               ; A = nuovo colore
 314  8034 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 315  8037 06 20            ld   b, 32
 316  8039              .color_title_loop:
 317  8039 77               ld   (hl), a
 318  803A 23               inc  hl
 319  803B 10 FC            djnz .color_title_loop
 320  803D
 321  803D                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 322  803D 3E BF            ld   a, $bf
 323  803F DB FE            in   a, ($fe)
 324  8041 1F               rra
 325  8042 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 326  8044
 327  8044                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 328  8044              .wait_title_enter_release_after:
 329  8044 76               halt
 330  8045 3E BF            ld   a, $bf
 331  8047 DB FE            in   a, ($fe)
 332  8049 1F               rra
 333  804A 30 F8            jr   nc, .wait_title_enter_release_after
 334  804C
 335  804C                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 336  804C AF               xor  a
 337  804D D3 FE            out  ($fe), a              ; Bordo a nero
 338  804F 21 8D 5C         ld   hl, ATTR_P
 339  8052 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 340  8053 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 341  8056 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 342  8058 3E 07            ld   a, $07
 343  805A 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 344  805D
 345  805D                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 346  805D CD D2 82         call ResetFullGameState
 347  8060
 348  8060                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 349  8060 C3 F6 7E         jp   LoadRoomAndRestart

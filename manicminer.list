 142+ 8189              ; Items_DrawRoom
 143+ 8189              ;
 144+ 8189              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 8189              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 8189              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 8189              ;
 148+ 8189              ; Record item nella stanza (5 byte):
 149+ 8189              ;   +0 Color / Attributo
 150+ 8189              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 8189              ;   +2 Attr Address High
 152+ 8189              ;   +3 Anim Mask (96)
 153+ 8189              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)

  88+ 7CF8                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7CF8 7D               ld   a, l
  90+ 7CF9 E6 1F            and  31
  91+ 7CFB 87               add  a, a
  91+ 7CFC 87             add a, a
  91+ 7CFD 87             add a, a
  92+ 7CFE DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D01
  94+ 7D01                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D01 CB 3C            srl  h
  95+ 7D03 CB 1D          rr l
  96+ 7D05 CB 3C            srl  h
  96+ 7D07 CB 1D          rr l
  97+ 7D09 CB 3C            srl  h
  97+ 7D0B CB 1D          rr l
  98+ 7D0D CB 3C            srl  h
  98+ 7D0F CB 1D          rr l
  99+ 7D11 CB 3C            srl  h
  99+ 7D13 CB 1D          rr l

1134+ 6445              ; -------------------------------------------------------------------
1135+ 6445              ; Gfx_DrawGameOverScreen
1136+ 6445              ; Esegue la sequenza animata di Game Over:
1137+ 6445              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1138+ 6445              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1139+ 6445              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1140+ 6445              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1141+ 6445              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1142+ 6445              ; -------------------------------------------------------------------
1143+ 6445              Gfx_DrawGameOverScreen:
1144+ 6445 F5               push af
1145+ 6446 C5               push bc
1146+ 6447 D5               push de
1147+ 6448 E5               push hl
1148+ 6449 DD E5            push ix
1149+ 644B
1150+ 644B                  ; 1. Bordo hardware e schermo a nero
1151+ 644B AF               xor  a
1152+ 644C D3 FE            out  ($fe), a              ; Bordo a nero
1153+ 644E 21 8D 5C         ld   hl, ATTR_P
1154+ 6451 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1155+ 6452 CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1156+ 6455 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1157+ 6457 3E 07            ld   a, $07
1158+ 6459 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1159+ 645C
1160+ 645C                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1161+ 645C                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1162+ 645C 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1163+ 645F DD 21 AC 87      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1164+ 6463 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1165+ 6466
1166+ 6466                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1167+ 6466 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1168+ 6469 DD 21 B4 87      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1169+ 646D CD 3F 5E         call Gfx_DrawPixelSprite8x8
1170+ 6470
1171+ 6470                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96
1172+ 6470 01 7C 60         ld   bc, $607c             ; B = Y = 96, C = X = 124
1173+ 6473 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1174+ 6475 CD AF 6A         call Gfx_SetEnemyColorAttributes
1175+ 6478
1176+ 6478                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1177+ 6478 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1178+ 647B DD 21 C7 6B      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1179+ 647F CD 17 5F         call Gfx_DrawPixelSprite16x16
1180+ 6482
1181+ 6482                  ; 3b. Imposta attributi colore per BotteSprite (Rosso Brillante) a X=120, Y=112
1182+ 6482 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1183+ 6485 3E 42            ld   a, RED | $40          ; Rosso Brillante
1184+ 6487 CD AF 6A         call Gfx_SetEnemyColorAttributes
1185+ 648A
1186+ 648A                  ; 4. Stampa il Nome della Stanza a riga 16
1187+ 648A 3E 16            ld   a, 22                 ; Codice di controllo AT (22)
1188+ 648C D7               rst  $10
1189+ 648D 3E 10            ld   a, 16                 ; Riga 16
1190+ 648F D7               rst  $10
1191+ 6490 3E 00            ld   a, 0                  ; Colonna 0

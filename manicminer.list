   8+ 87DF              ; Audio_UpdateJumpSound
   9+ 87DF              ;
  10+ 87DF              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 87DF              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 87DF              ; -------------------------------------------------------------------
  13+ 87DF              Audio_UpdateJumpSound:
  14+ 87DF F5               push af
  15+ 87E0 C5               push bc
  16+ 87E1 D5               push de
  17+ 87E2 E5               push hl
  18+ 87E3
  19+ 87E3                  ; Controlla se il suono è attivo (note < 18)
  20+ 87E3 3A 67 F0         ld   a, (Audio_jump_sound_note)
  21+ 87E6 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 87E8 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 87EA
  24+ 87EA                  ; Carica la nota corrente da suonare
  25+ 87EA 5F               ld   e, a
  26+ 87EB 16 00            ld   d, 0
  27+ 87ED 21 19 88         ld   hl, Audio_JumpSoundDelays
  28+ 87F0 19               add  hl, de
  29+ 87F1 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 87F2 57               ld   d, a                      ; D = delay della nota
  31+ 87F3
  32+ 87F3                  ; Suona la nota: 15 cicli
  33+ 87F3 06 0F            ld   b, 15
  34+ 87F5              .note_loop:
  35+ 87F5                  ; Speaker ON
  36+ 87F5 3A 53 EA         ld   a, (room_border_color)
  37+ 87F8 F6 10            or   $10
  38+ 87FA D3 FE            out  ($fe), a
  39+ 87FC 4A               ld   c, d
  40+ 87FD              .d1:
  41+ 87FD 0D               dec  c
  42+ 87FE 20 FD            jr   nz, .d1
  43+ 8800
  44+ 8800                  ; Speaker OFF
  45+ 8800 3A 53 EA         ld   a, (room_border_color)
  46+ 8803 E6 EF            and  $ef
  47+ 8805 D3 FE            out  ($fe), a
  48+ 8807 4A               ld   c, d
  49+ 8808              .d2:
  50+ 8808 0D               dec  c
  51+ 8809 20 FD            jr   nz, .d2
  52+ 880B
  53+ 880B 10 E8            djnz .note_loop
  54+ 880D
  55+ 880D                  ; Passa alla nota successiva
  56+ 880D 3A 67 F0         ld   a, (Audio_jump_sound_note)
  57+ 8810 3C               inc  a
  58+ 8811 32 67 F0         ld   (Audio_jump_sound_note), a
  59+ 8814
  60+ 8814              .done:
  61+ 8814 E1               pop  hl
  62+ 8815 D1               pop  de
  63+ 8816 C1               pop  bc
  64+ 8817 F1               pop  af
  65+ 8818 C9               ret

 138+ 8085              ; Items_DrawRoom
 139+ 8085              ;
 140+ 8085              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 8085              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 8085              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 8085              ;
 144+ 8085              ; Record item nella stanza (5 byte):
 145+ 8085              ;   +0 Color / Attributo
 146+ 8085              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 8085              ;   +2 Attr Address High
 148+ 8085              ;   +3 Anim Mask (96)
 149+ 8085              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 8085              ; Fine lista: $FF
 151+ 8085              ; -------------------------------------------------------------------
 152+ 8085              Items_DrawRoom:
 153+ 8085 E5               push hl
 154+ 8086 D5               push de
 155+ 8087 C5               push bc
 156+ 8088 DD E5            push ix
 157+ 808A FD E5            push iy
 158+ 808C
 159+ 808C                  ; 1. Azzera items_grid (512 byte)
 160+ 808C 21 00 94         ld   hl, items_grid
 161+ 808F 11 01 94         ld   de, items_grid + 1
 162+ 8092 36 00            ld   (hl), 0
 163+ 8094 01 FF 01         ld   bc, 511
 164+ 8097 ED B0            ldir
 165+ 8099
 166+ 8099                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 8099 AF               xor  a
 168+ 809A 32 7F 99         ld   (num_room_items), a
 169+ 809D
 170+ 809D FD 21 2F 99      ld   iy, current_room_items
 171+ 80A1
 172+ 80A1                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80A1 2A 80 99         ld   hl, (room_ptr)
 174+ 80A4 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80A7 19               add  hl, de
 176+ 80A8 E5               push hl
 177+ 80A9 DD E1            pop  ix                        ; IX = bitmap item
 178+ 80AB
 179+ 80AB                  ; 4. HL = Inizio lista item nella stanza
 180+ 80AB 2A 80 99         ld   hl, (room_ptr)
 181+ 80AE 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80B1 19               add  hl, de
 183+ 80B2
 184+ 80B2              .loop:
 185+ 80B2 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80B3 FE FF            cp   $FF
 187+ 80B5 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80B7
 189+ 80B7 5F               ld   e, a                      ; E = Color
 190+ 80B8 23               inc  hl
 191+ 80B9 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80BA 23               inc  hl
 193+ 80BB 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80BC 23               inc  hl                        ; Salta Anim Byte
 195+ 80BD 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80BE
 197+ 80BE 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80BF FE FF            cp   $FF
 199+ 80C1 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto

 298+ 8128              DrawItemGraphic:
 299+ 8128 C5               push bc
 300+ 8129 D5               push de
 301+ 812A E5               push hl
 302+ 812B
 303+ 812B                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 304+ 812B 78               ld   a, b
 305+ 812C E6 18            and  $18
 306+ 812E C6 40            add  a, $40
 307+ 8130 57               ld   d, a                      ; Byte alto indirizzo video
 308+ 8131
 309+ 8131 78               ld   a, b
 310+ 8132 E6 07            and  7
 311+ 8134 87               add  a, a                      ; *2
 312+ 8135 87               add  a, a                      ; *4
 313+ 8136 87               add  a, a                      ; *8
 314+ 8137 87               add  a, a                      ; *16
 315+ 8138 87               add  a, a                      ; *32
 316+ 8139 81               add  a, c                      ; + Col
 317+ 813A 5F               ld   e, a                      ; Byte basso indirizzo video
 318+ 813B
 319+ 813B C5               push bc
 320+ 813C 06 08            ld   b, 8                      ; 8 scanline
 321+ 813E              .line_loop:
 322+ 813E 7E               ld   a, (hl)

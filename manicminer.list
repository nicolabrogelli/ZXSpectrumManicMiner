 502+ 7D59              ; -------------------------------------------------------------------
 503+ 7D59              ; CheckCollision
 504+ 7D59              ;
 505+ 7D59              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 506+ 7D59              ; Output:
 507+ 7D59              ;   Carry Set = Collisione con guardiano
 508+ 7D59              ;   Carry Clear = Nessuna collisione
 509+ 7D59              ; -------------------------------------------------------------------
 510+ 7D59              CheckCollision:
 511+ 7D59 DD E5            push ix
 512+ 7D5B C5               push bc
 513+ 7D5C D5               push de
 514+ 7D5D E5               push hl
 515+ 7D5E
 516+ 7D5E                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 517+ 7D5E 3A 7B 93         ld   a, (willy_safety_timer)
 518+ 7D61 B7               or   a
 519+ 7D62 20 3B            jr   nz, .no_collision_found
 520+ 7D64
 521+ 7D64 DD 21 66 7A      ld   ix, ActiveEnemies
 522+ 7D68 06 08            ld   b, 8                      ; 8 slot
 523+ 7D6A
 524+ 7D6A              .collision_loop:
 525+ 7D6A DD 7E 00         ld   a, (ix+0)
 526+ 7D6D E6 80            and  $80                       ; Active?
 527+ 7D6F 28 26            jr   z, .next_enemy
 528+ 7D71
 529+ 7D71 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 530+ 7D72
 531+ 7D72                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 532+ 7D72 ED 4B 71 8F      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 533+ 7D76 DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 534+ 7D79
 535+ 7D79                  ; Calcola differenza X
 536+ 7D79 91               sub  c                         ; A = EnemyX - WillyX
 537+ 7D7A 30 02            jr   nc, .x_diff_pos
 538+ 7D7C ED 44            neg                            ; A = |EnemyX - WillyX|
 539+ 7D7E              .x_diff_pos:
 540+ 7D7E FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 541+ 7D80 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 542+ 7D82
 543+ 7D82                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 544+ 7D82 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 545+ 7D85 90               sub  b                         ; A = EnemyY - WillyY
 546+ 7D86 30 02            jr   nc, .y_diff_pos
 547+ 7D88 ED 44            neg                            ; A = |EnemyY - WillyY|
 548+ 7D8A              .y_diff_pos:
 549+ 7D8A FE 0E            cp   14                        ; Sovrapposizione verticale?
 550+ 7D8C 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 551+ 7D8E
 552+ 7D8E                  ; Collisione trovata!
 553+ 7D8E C1               pop  bc                        ; Ripristina stack
 554+ 7D8F E1               pop  hl
 555+ 7D90 D1               pop  de
 556+ 7D91 C1               pop  bc
 557+ 7D92 DD E1            pop  ix
 558+ 7D94 37               scf
 559+ 7D95 C9               ret
 560+ 7D96
 561+ 7D96              .no_x_hit:
 562+ 7D96 C1               pop  bc                        ; Ripristina B (contatore ciclo)
 563+ 7D97
 564+ 7D97              .next_enemy:
 565+ 7D97 11 0B 00         ld   de, 11
 566+ 7D9A DD 19            add  ix, de
 567+ 7D9C 05               dec  b
 568+ 7D9D 20 CB            jr   nz, .collision_loop
 569+ 7D9F
 570+ 7D9F              .no_collision_found:
 571+ 7D9F E1               pop  hl
 572+ 7DA0 D1               pop  de
 573+ 7DA1 C1               pop  bc
 574+ 7DA2 DD E1            pop  ix
 575+ 7DA4 B7               or   a
 576+ 7DA5 C9               ret

  52+ 7D27 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7D2B DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7D2F DD 19            add  ix, de
  55+ 7D31 10 F4            djnz .init_old_pos
  56+ 7D33
  57+ 7D33                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7D33 DD 21 B4 7C      ld   ix, ActiveEnemies
  59+ 7D37 2A 85 A1         ld   hl, (room_ptr)
  60+ 7D3A 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7D3D 19               add  hl, de
  62+ 7D3E
  63+ 7D3E 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7D40              .load_h_loop:
  65+ 7D40 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7D41 FE FF            cp   $FF
  67+ 7D43 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7D45 B7               or   a
  69+ 7D46 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7D48
  71+ 7D48                  ; Slot attivo
  72+ 7D48 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D4C DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7D4F
  75+ 7D4F 23               inc  hl
  76+ 7D50 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7D51 23               inc  hl
  78+ 7D52 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7D53
  80+ 7D53                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7D53 E5               push hl
  82+ 7D54 C5               push bc
  83+ 7D55 67               ld   h, a
  84+ 7D56 69               ld   l, c
  85+ 7D57 01 00 A4         ld   bc, -23552
  86+ 7D5A 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D5B
  88+ 7D5B                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D5B 7D               ld   a, l
  90+ 7D5C E6 1F            and  31
  91+ 7D5E 87               add  a, a
  91+ 7D5F 87             add a, a
  91+ 7D60 87             add a, a
  92+ 7D61 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D64
  94+ 7D64                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D64 CB 3C            srl  h
  95+ 7D66 CB 1D          rr l
  96+ 7D68 CB 3C            srl  h
  96+ 7D6A CB 1D          rr l
  97+ 7D6C CB 3C            srl  h
  97+ 7D6E CB 1D          rr l
  98+ 7D70 CB 3C            srl  h
  98+ 7D72 CB 1D          rr l
  99+ 7D74 CB 3C            srl  h
  99+ 7D76 CB 1D          rr l
 100+ 7D78 7D               ld   a, l
 101+ 7D79 87               add  a, a
 101+ 7D7A 87             add a, a
 101+ 7D7B 87             add a, a
 102+ 7D7C DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D7F C1               pop  bc
 104+ 7D80 E1               pop  hl
 105+ 7D81
 106+ 7D81 23               inc  hl
 107+ 7D82 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D83 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D87
 110+ 7D87 23               inc  hl
 111+ 7D88 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D89 E6 01            and  1
 113+ 7D8B 28 04            jr   z, .h_dir_right
 114+ 7D8D 3E 01            ld   a, 1                      ; 1 = Sinistra

 425+ 82D2 87               add  a, a                      ; *2
 426+ 82D3 87               add  a, a                      ; *4
 427+ 82D4 87               add  a, a                      ; *8
 428+ 82D5 5F               ld   e, a                      ; E = ItemLeft
 429+ 82D6 C6 07            add  a, 7
 430+ 82D8 57               ld   d, a                      ; D = ItemRight
 431+ 82D9
 432+ 82D9 ED 4B 40 AB      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 82DD
 434+ 82DD                  ; WillyLeft <= ItemRight
 435+ 82DD 79               ld   a, c                      ; A = WillyX
 436+ 82DE BA               cp   d                         ; D = ItemRight
 437+ 82DF 28 04            jr   z, .x_ok
 438+ 82E1 38 02            jr   c, .x_ok
 439+ 82E3 18 31            jr   .no_collision
 440+ 82E5
 441+ 82E5              .x_ok:
 442+ 82E5                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 82E5 BB               cp   e                         ; E = ItemLeft
 444+ 82E6 28 0B            jr   z, .y_check
 445+ 82E8 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 82EA
 447+ 82EA                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 82EA C6 0F            add  a, 15
 449+ 82EC BB               cp   e
 450+ 82ED 28 04            jr   z, .y_check
 451+ 82EF 30 02            jr   nc, .y_check
 452+ 82F1 18 23            jr   .no_collision
 453+ 82F3
 454+ 82F3              .y_check:
 455+ 82F3                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 82F3 7C               ld   a, h                      ; H = Item Row
 457+ 82F4 87               add  a, a                      ; *2
 458+ 82F5 87               add  a, a                      ; *4
 459+ 82F6 87               add  a, a                      ; *8
 460+ 82F7 5F               ld   e, a                      ; E = ItemTop
 461+ 82F8 C6 07            add  a, 7

 179+ 7EBD              ; Audio_PlayCollectSound
 180+ 7EBD              ;
 181+ 7EBD              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 7EBD              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 7EBD              ; -------------------------------------------------------------------
 184+ 7EBD              Audio_PlayCollectSound:
 185+ 7EBD C5               push bc
 186+ 7EBE D5               push de
 187+ 7EBF
 188+ 7EBF 06 78            ld   b, 120
 189+ 7EC1              .sound_loop:
 190+ 7EC1 3A 05 8E         ld   a, (room_border_color)
 191+ 7EC4 F6 10            or   $10               ; speaker ON
 192+ 7EC6 D3 FE            out  ($fe), a
 193+ 7EC8
 194+ 7EC8 0E 3C            ld   c, 60
 195+ 7ECA              .d1:
 196+ 7ECA 0D               dec  c
 197+ 7ECB 20 FD            jr   nz, .d1
 198+ 7ECD
 199+ 7ECD 3A 05 8E         ld   a, (room_border_color)
 200+ 7ED0 E6 EF            and  $ef              ; speaker OFF
 201+ 7ED2 D3 FE            out  ($fe), a
 202+ 7ED4
 203+ 7ED4 0E 3C            ld   c, 60
 204+ 7ED6              .d2:
 205+ 7ED6 0D               dec  c
 206+ 7ED7 20 FD            jr   nz, .d2
 207+ 7ED9
 208+ 7ED9 10 E6            djnz .sound_loop
 209+ 7EDB
 210+ 7EDB D1               pop  de
 211+ 7EDC C1               pop  bc
 212+ 7EDD C9               ret

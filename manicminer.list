 330+ 6E69 87               add  a, a                      ; *4
 331+ 6E6A 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6E6B 4F               ld   c, a                      ; C = PlayerX
 333+ 6E6C 42               ld   b, d                      ; B = PlayerY

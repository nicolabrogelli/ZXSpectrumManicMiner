 354  860E              ; -------------------------------------------------------------------
 355  860E              ; TriggerGameOver
 356  860E              ; Scatena la schermata di Game Over per la stanza corrente.
 357  860E              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 358  860E              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 359  860E              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 360  860E              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 361  860E              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 362  860E              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 363  860E              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 364  860E              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 365  860E              ; -------------------------------------------------------------------
 366  860E              TriggerGameOver:
 367  860E                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 368  860E CD 15 66         call Gfx_DrawGameOverScreen
 369  8611
 370  8611                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 371  8611              .wait_keys_release:
 372  8611 76               halt
 373  8612                  ; Controlla tasto Y (Porta $DF, bit 4)
 374  8612 01 FE DF         ld   bc, $dffe
 375  8615 ED 78            in   a, (c)
 376  8617 CB 67            bit  4, a
 377  8619 28 F6            jr   z, .wait_keys_release
 378  861B
 379  861B                  ; Controlla tasto N (Porta $7F, bit 3)
 380  861B 01 FE 7F         ld   bc, $7ffe
 381  861E ED 78            in   a, (c)
 382  8620 CB 5F            bit  3, a
 383  8622 28 ED            jr   z, .wait_keys_release
 384  8624
 385  8624                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  8624 01 FE BF         ld   bc, $bffe
 387  8627 ED 78            in   a, (c)
 388  8629 CB 47            bit  0, a
 389  862B 28 E4            jr   z, .wait_keys_release
 390  862D
 391  862D                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 392  862D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore

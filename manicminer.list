   5+ 6F6E              ; -------------------------------------------------------------------
   6+ 6F6E              ; MovePlayer
   7+ 6F6E              ;
   8+ 6F6E              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6F6E              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6F6E              ; con i muri.
  11+ 6F6E              ;
  12+ 6F6E              ; Input:
  13+ 6F6E              ;   D = stato dei controlli (bitfield)
  14+ 6F6E              ;
  15+ 6F6E              ; Strutture utilizzate:
  16+ 6F6E              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6F6E              ;   player_speed    -> velocità orizzontale
  18+ 6F6E              ;   flags           -> flag di stato input
  19+ 6F6E              ;
  20+ 6F6E              ; Bit controlli:
  21+ 6F6E              ;   bit 0 = sinistra
  22+ 6F6E              ;   bit 1 = destra
  23+ 6F6E              ;
  24+ 6F6E              ; Nota:
  25+ 6F6E              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6F6E              ;   ignorato per tutta la durata del salto.
  27+ 6F6E              ;
  28+ 6F6E              ; Output:
  29+ 6F6E              ;   aggiorna PlayerPos e body_state
  30+ 6F6E              ; -------------------------------------------------------------------
  31+ 6F6E              MovePlayer:
  32+ 6F6E
  33+ 6F6E                  ; ---------------------------------------------------------------
  34+ 6F6E                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6F6E                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6F6E                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6F6E                  ; ---------------------------------------------------------------
  38+ 6F6E 3A B2 EB         ld   a, (on_ground)
  39+ 6F71 B7               or   a
  40+ 6F72 20 20            jr   nz, .on_ground_check
  41+ 6F74
  42+ 6F74                  ; In aria: resetta lo stato di cattura del nastro
  43+ 6F74 AF               xor  a
  44+ 6F75 32 CF EE         ld   (conveyor_caught), a
  45+ 6F78
  46+ 6F78 3A B7 EB         ld   a, (jump_dir)
  47+ 6F7B B7               or   a
  48+ 6F7C C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  49+ 6F7D
  50+ 6F7D                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  51+ 6F7D DD 21 AB EB      ld   ix, flags
  52+ 6F81 DD CB 00 86      res  $00, (ix)
  53+ 6F85
  54+ 6F85 ED 4B A3 EB      ld   bc, (PlayerPos)
  55+ 6F89 FE 01            cp   1
  56+ 6F8B CA 5E 70         jp   z, movePlayer_left
  57+ 6F8E FE 02            cp   2
  58+ 6F90 CA 8D 70         jp   z, movePlayer_right
  59+ 6F93 C9               ret
  60+ 6F94
  61+ 6F94              .on_ground_check:
  62+ 6F94                  ; ---------------------------------------------------------------
  63+ 6F94                  ; Controlla se Willy è sopra un nastro trasportatore (Conveyor)
  64+ 6F94                  ; ---------------------------------------------------------------
  65+ 6F94 CD 0C 79         call CheckWillyOnConveyor
  66+ 6F97 38 20            jr   c, .on_conveyor_ground
  67+ 6F99
  68+ 6F99                  ; ---------------------------------------------------------------
  69+ 6F99                  ; Terreno normale (non su conveyor):
  70+ 6F99                  ; Resetta lo stato di cattura del conveyor
  71+ 6F99                  ; ---------------------------------------------------------------
  72+ 6F99 AF               xor  a
  73+ 6F9A 32 CF EE         ld   (conveyor_caught), a
  74+ 6F9D
  75+ 6F9D DD 21 AB EB      ld   ix, flags
  76+ 6FA1 DD CB 00 46      bit  $00, (ix)
  77+ 6FA5 C8               ret  z
  78+ 6FA6
  79+ 6FA6 DD CB 00 86      res  $00, (ix)
  80+ 6FAA
  81+ 6FAA ED 4B A3 EB      ld   bc, (PlayerPos)
  82+ 6FAE
  83+ 6FAE              .ground_input:
  84+ 6FAE                  ; ---------------------------------------------------------------
  85+ 6FAE                  ; Input: destra?
  86+ 6FAE                  ; ---------------------------------------------------------------
  87+ 6FAE CB 4A            bit  $01, d
  88+ 6FB0 C2 8D 70         jp   nz, movePlayer_right
  89+ 6FB3
  90+ 6FB3                  ; ---------------------------------------------------------------
  91+ 6FB3                  ; Input: sinistra?
  92+ 6FB3                  ; ---------------------------------------------------------------
  93+ 6FB3 CB 42            bit  $00, d
  94+ 6FB5 C8               ret  z
  95+ 6FB6 C3 5E 70         jp   movePlayer_left
  96+ 6FB9
  97+ 6FB9              .on_conveyor_ground:
  98+ 6FB9                  ; ---------------------------------------------------------------
  99+ 6FB9                  ; Willy si trova sul nastro trasportatore:
 100+ 6FB9                  ; - Se Willy monta sul nastro muovendosi nella direzione opposta
 101+ 6FB9                  ;   allo scorrimento, finché tiene premuto il tasto direzionale
 102+ 6FB9                  ;   continua il movimento nella direzione scelta.
 103+ 6FB9                  ; - Non appena il tasto direzionale opposto viene rilasciato,
 104+ 6FB9                  ;   Willy viene catturato dal nastro (conveyor_caught = 1) e trascinato
 105+ 6FB9                  ;   nella direzione del nastro.
 106+ 6FB9                  ; - Se il tasto opposto viene ripremuto mentre Willy è già catturato
 107+ 6FB9                  ;   sul nastro, non ha alcun effetto e Willy continua a essere trascinato.
 108+ 6FB9                  ; ---------------------------------------------------------------
 109+ 6FB9 DD 21 AB EB      ld   ix, flags
 110+ 6FBD DD CB 00 86      res  $00, (ix)
 111+ 6FC1 ED 4B A3 EB      ld   bc, (PlayerPos)
 112+ 6FC5
 113+ 6FC5 3A CB EE         ld   a, (conveyor_dir)
 114+ 6FC8 B7               or   a
 115+ 6FC9 20 31            jr   nz, .conv_is_right
 116+ 6FCB
 117+ 6FCB                  ; ── CONVEYOR VA A SINISTRA (conveyor_dir == 0) ──
 118+ 6FCB                  ; Tasto opposto = DESTRA (bit 1 di D)
 119+ 6FCB CB 4A            bit  $01, d                 ; Premuto DESTRA (opposto)?
 120+ 6FCD 20 0D            jr   nz, .check_oppose_right
 121+ 6FCF
 122+ 6FCF                  ; Non sta premendo Destra: Willy viene catturato dal nastro a Sinistra
 123+ 6FCF 3E 01            ld   a, 1
 124+ 6FD1 32 CF EE         ld   (conveyor_caught), a
 125+ 6FD4
 126+ 6FD4                  ; Muovi a Sinistra (trascinamento del nastro)
 127+ 6FD4 3E 01            ld   a, 1
 128+ 6FD6 32 AA EB         ld   (direction), a
 129+ 6FD9 C3 5E 70         jp   movePlayer_left
 130+ 6FDC
 131+ 6FDC              .check_oppose_right:
 132+ 6FDC                  ; Sta premendo Destra contro il nastro a Sinistra.
 133+ 6FDC                  ; Se sta saltando (bit 2 di D o jump_pressed), permetti sempre il salto a Destra
 134+ 6FDC CB 52            bit  2, d
 135+ 6FDE 20 0C            jr   nz, .do_move_right
 136+ 6FE0 3A B3 EB         ld   a, (jump_pressed)
 137+ 6FE3 B7               or   a
 138+ 6FE4 20 06            jr   nz, .do_move_right
 139+ 6FE6
 140+ 6FE6                  ; Se era già stato catturato (tasto rilasciato prima sul nastro), ignora l'input!
 141+ 6FE6 3A CF EE         ld   a, (conveyor_caught)
 142+ 6FE9 B7               or   a
 143+ 6FEA 20 08            jr   nz, .right_ignored_drag_left
 144+ 6FEC
 145+ 6FEC              .do_move_right:
 146+ 6FEC                  ; Non era ancora catturato o sta saltando: continua a muoversi a Destra!
 147+ 6FEC 3E 02            ld   a, 2
 148+ 6FEE 32 AA EB         ld   (direction), a
 149+ 6FF1 C3 8D 70         jp   movePlayer_right
 150+ 6FF4
 151+ 6FF4              .right_ignored_drag_left:
 152+ 6FF4                  ; Tasto opposto ignorato: continua il trascinamento a Sinistra
 153+ 6FF4 3E 01            ld   a, 1
 154+ 6FF6 32 AA EB         ld   (direction), a
 155+ 6FF9 C3 5E 70         jp   movePlayer_left
 156+ 6FFC
 157+ 6FFC              .conv_is_right:
 158+ 6FFC                  ; ── CONVEYOR VA A DESTRA (conveyor_dir == 1) ──
 159+ 6FFC                  ; Tasto opposto = SINISTRA (bit 0 di D)
 160+ 6FFC CB 42            bit  $00, d                 ; Premuto SINISTRA (opposto)?
 161+ 6FFE 20 0D            jr   nz, .check_oppose_left
 162+ 7000
 163+ 7000                  ; Non sta premendo Sinistra: Willy viene catturato dal nastro a Destra
 164+ 7000 3E 01            ld   a, 1
 165+ 7002 32 CF EE         ld   (conveyor_caught), a
 166+ 7005
 167+ 7005                  ; Muovi a Destra (trascinamento del nastro)
 168+ 7005 3E 02            ld   a, 2
 169+ 7007 32 AA EB         ld   (direction), a
 170+ 700A C3 8D 70         jp   movePlayer_right
 171+ 700D
 172+ 700D              .check_oppose_left:
 173+ 700D                  ; Sta premendo Sinistra contro il nastro a Destra.
 174+ 700D                  ; Se sta saltando (bit 2 di D o jump_pressed), permetti sempre il salto a Sinistra
 175+ 700D CB 52            bit  2, d
 176+ 700F 20 0C            jr   nz, .do_move_left
 177+ 7011 3A B3 EB         ld   a, (jump_pressed)
 178+ 7014 B7               or   a
 179+ 7015 20 06            jr   nz, .do_move_left
 180+ 7017
 181+ 7017                  ; Se era già stato catturato (tasto rilasciato prima sul nastro), ignora l'input!
 182+ 7017 3A CF EE         ld   a, (conveyor_caught)
 183+ 701A B7               or   a
 184+ 701B 20 08            jr   nz, .left_ignored_drag_right
 185+ 701D
 186+ 701D              .do_move_left:
 187+ 701D                  ; Non era ancora catturato o sta saltando: continua a muoversi a Sinistra!
 188+ 701D 3E 01            ld   a, 1
 189+ 701F 32 AA EB         ld   (direction), a
 190+ 7022 C3 5E 70         jp   movePlayer_left
 191+ 7025
 192+ 7025              .left_ignored_drag_right:
 193+ 7025                  ; Tasto opposto ignorato: continua il trascinamento a Destra
 194+ 7025 3E 02            ld   a, 2
 195+ 7027 32 AA EB         ld   (direction), a
 196+ 702A C3 8D 70         jp   movePlayer_right

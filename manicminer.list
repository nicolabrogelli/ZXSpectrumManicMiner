 453+ 7F3E              ; Enemy_DrawSingleSlot
 454+ 7F3E              ;
 455+ 7F3E              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 456+ 7F3E              ; La grafica (8 frame da 32 byte) è letta direttamente da
 457+ 7F3E              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 458+ 7F3E              ; -------------------------------------------------------------------
 459+ 7F3E              Enemy_DrawSingleSlot:
 460+ 7F3E C5               push bc
 461+ 7F3F D5               push de
 462+ 7F40 E5               push hl
 463+ 7F41 DD E5            push ix
 464+ 7F43
 465+ 7F43                  ; 1. Salva subito le coordinate X e Y dal record IX
 466+ 7F43 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 467+ 7F46 DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 468+ 7F49
 469+ 7F49                  ; Controlla se è Kong Beast ($A0)
 470+ 7F49 DD 7E 00         ld   a, (ix+0)
 471+ 7F4C FE A0            cp   $A0
 472+ 7F4E 28 22            jr   z, .kong_frame
 473+ 7F50
 474+ 7F50                  ; Controlla se è guardiano verticale
 475+ 7F50 DD 7E 00         ld   a, (ix+0)
 476+ 7F53 E6 40            and  $40                       ; Vertical?
 477+ 7F55 20 22            jr   nz, .v_frame
 478+ 7F57
 479+ 7F57                  ; Guardiano Orizzontale:
 480+ 7F57 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 481+ 7F5A E6 03            and  3
 482+ 7F5C 5F               ld   e, a                      ; E = Anim subframe
 483+ 7F5D
 484+ 7F5D 3A B4 E5         ld   a, (room_has_v_guardians)
 485+ 7F60 B7               or   a
 486+ 7F61 20 0A            jr   nz, .h_use_second_half    ; Se ci sono guardiani verticali, i guardiani orizzontali usano la SECONDA METÀ (frame 4..7)!
 487+ 7F63
 488+ 7F63 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 489+ 7F66 FE 01            cp   1                         ; Sinistra?
 490+ 7F68 28 03            jr   z, .left_frames
 491+ 7F6A
 492+ 7F6A                  ; Movimento a Destra: Frame 0..3 (prima metà)
 493+ 7F6A 7B               ld   a, e
 494+ 7F6B 18 23            jr   .got_frame_idx
 495+ 7F6D
 496+ 7F6D              .h_use_second_half:
 497+ 7F6D              .left_frames:
 498+ 7F6D                  ; Movimento a Sinistra (o orizzontale in stanze con guardiani verticali): Frame 4..7 (seconda metà)
 499+ 7F6D 3E 04            ld   a, 4
 500+ 7F6F 83               add  a, e
 501+ 7F70 18 1E            jr   .got_frame_idx
 502+ 7F72

1713+ 7B1F CB 3F            srl  a
1714+ 7B21 CB 3F            srl  a                 ; A = c (0..31)
1715+ 7B23 4F               ld   c, a              ; C = c
1716+ 7B24 7B               ld   a, e              ; A = r

 138+ 7D3B              ; Items_DrawRoom
 139+ 7D3B              ;
 140+ 7D3B              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 7D3B              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 7D3B              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 7D3B              ;
 144+ 7D3B              ; Record item nella stanza (5 byte):
 145+ 7D3B              ;   +0 Color / Attributo
 146+ 7D3B              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 7D3B              ;   +2 Attr Address High
 148+ 7D3B              ;   +3 Anim Mask (96)
 149+ 7D3B              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 7D3B              ; Fine lista: $FF
 151+ 7D3B              ; -------------------------------------------------------------------
 152+ 7D3B              Items_DrawRoom:
 153+ 7D3B E5               push hl
 154+ 7D3C D5               push de
 155+ 7D3D C5               push bc
 156+ 7D3E DD E5            push ix
 157+ 7D40 FD E5            push iy
 158+ 7D42
 159+ 7D42                  ; 1. Azzera items_grid (512 byte)
 160+ 7D42 21 AD 90         ld   hl, items_grid
 161+ 7D45 11 AE 90         ld   de, items_grid + 1
 162+ 7D48 36 00            ld   (hl), 0
 163+ 7D4A 01 FF 01         ld   bc, 511
 164+ 7D4D ED B0            ldir
 165+ 7D4F
 166+ 7D4F                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 7D4F AF               xor  a
 168+ 7D50 32 2C 96         ld   (num_room_items), a
 169+ 7D53
 170+ 7D53 FD 21 DC 95      ld   iy, current_room_items
 171+ 7D57
 172+ 7D57                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 7D57 2A 2D 96         ld   hl, (room_ptr)
 174+ 7D5A 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 7D5D 19               add  hl, de
 176+ 7D5E E5               push hl
 177+ 7D5F DD E1            pop  ix                        ; IX = bitmap item
 178+ 7D61
 179+ 7D61                  ; 4. HL = Inizio lista item nella stanza
 180+ 7D61 2A 2D 96         ld   hl, (room_ptr)
 181+ 7D64 11 75 02         ld   de, OFFSET_ITEMS
 182+ 7D67 19               add  hl, de
 183+ 7D68
 184+ 7D68              .loop:
 185+ 7D68 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 7D69 FE FF            cp   $FF
 187+ 7D6B 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 7D6D
 189+ 7D6D 5F               ld   e, a                      ; E = Color
 190+ 7D6E 23               inc  hl
 191+ 7D6F 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 7D70 23               inc  hl
 193+ 7D71 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 7D72 23               inc  hl                        ; Salta Anim Byte

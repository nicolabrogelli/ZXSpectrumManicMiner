 447  8548              .wait_quit_release:
 448  8548 76               halt
 449  8549 01 FE 7F         ld   bc, $7ffe
 450  854C ED 78            in   a, (c)
 451  854E CB 5F            bit  3, a
 452  8550 28 F6            jr   z, .wait_quit_release
 453  8552 01 FE BF         ld   bc, $bffe
 454  8555 ED 78            in   a, (c)
 455  8557 CB 47            bit  0, a
 456  8559 28 ED            jr   z, .wait_quit_release

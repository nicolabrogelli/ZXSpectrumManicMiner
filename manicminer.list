 414+ 86E5              ; CheckWillyItemCollision
 415+ 86E5              ;
 416+ 86E5              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 86E5              ; Input:
 418+ 86E5              ;   A = Item Col (0..31)
 419+ 86E5              ;   H = Item Row (0..15)
 420+ 86E5              ; Output:
 421+ 86E5              ;   Carry Set = Collisione
 422+ 86E5              ;   Carry Clear = Nessuna collisione
 423+ 86E5              ; -------------------------------------------------------------------
 424+ 86E5              CheckWillyItemCollision:
 425+ 86E5 C5               push bc
 426+ 86E6 D5               push de
 427+ 86E7 E5               push hl
 428+ 86E8
 429+ 86E8                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 86E8 6F               ld   l, a
 431+ 86E9 87               add  a, a                      ; *2
 432+ 86EA 87               add  a, a                      ; *4
 433+ 86EB 87               add  a, a                      ; *8
 434+ 86EC 5F               ld   e, a                      ; E = ItemLeft
 435+ 86ED C6 07            add  a, 7
 436+ 86EF 57               ld   d, a                      ; D = ItemRight

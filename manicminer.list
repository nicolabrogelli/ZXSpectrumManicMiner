   9+ 7CD0              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 7CD0
  11+ 7CD0              ; -------------------------------------------------------------------
  12+ 7CD0              ; DetermineCurrentRoomID
  13+ 7CD0              ;
  14+ 7CD0              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7CD0              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7CD0              ;
  17+ 7CD0              ; Output:
  18+ 7CD0              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7CD0              ;   (current_room) = A
  20+ 7CD0              ; -------------------------------------------------------------------
  21+ 7CD0              DetermineCurrentRoomID:
  22+ 7CD0 E5               push hl
  23+ 7CD1 D5               push de
  24+ 7CD2 C5               push bc
  25+ 7CD3
  26+ 7CD3 21 DF 6F         ld   hl, RoomsListTable
  27+ 7CD6 ED 5B 2D 96      ld   de, (room_ptr)
  28+ 7CDA 06 02            ld   b, NUM_ROOMS
  29+ 7CDC 0E 00            ld   c, 0
  30+ 7CDE
  31+ 7CDE              .loop:
  32+ 7CDE 7E               ld   a, (hl)
  33+ 7CDF BB               cp   e
  34+ 7CE0 20 06            jr   nz, .no_match
  35+ 7CE2 23               inc  hl
  36+ 7CE3 7E               ld   a, (hl)
  37+ 7CE4 BA               cp   d
  38+ 7CE5 28 08            jr   z, .found
  39+ 7CE7 2B               dec  hl
  40+ 7CE8
  41+ 7CE8              .no_match:
  42+ 7CE8 23               inc  hl
  43+ 7CE9 23               inc  hl
  44+ 7CEA 0C               inc  c
  45+ 7CEB 10 F1            djnz .loop
  46+ 7CED
  47+ 7CED 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7CEF
  49+ 7CEF              .found:
  50+ 7CEF 79               ld   a, c
  51+ 7CF0 32 D3 95         ld   (current_room), a
  52+ 7CF3
  53+ 7CF3 C1               pop  bc
  54+ 7CF4 D1               pop  de
  55+ 7CF5 E1               pop  hl
  56+ 7CF6 C9               ret

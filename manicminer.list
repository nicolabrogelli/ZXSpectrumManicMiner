 286+ 7DEF              ; -------------------------------------------------------------------
 287+ 7DEF              ; DrawItemGraphic
 288+ 7DEF              ;
 289+ 7DEF              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 290+ 7DEF              ; utilizzando una bitmap di 8 byte e un attributo colore.
 291+ 7DEF              ;
 292+ 7DEF              ; Input:
 293+ 7DEF              ;   B = Riga attributi (0..23)
 294+ 7DEF              ;   C = Colonna attributi (0..31)
 295+ 7DEF              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 296+ 7DEF              ;   E = Attributo colore
 297+ 7DEF              ; -------------------------------------------------------------------
 298+ 7DEF              DrawItemGraphic:
 299+ 7DEF C5               push bc
 300+ 7DF0 D5               push de
 301+ 7DF1 E5               push hl
 302+ 7DF2
 303+ 7DF2                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 304+ 7DF2 78               ld   a, b
 305+ 7DF3 E6 18            and  $18
 306+ 7DF5 C6 40            add  a, $40
 307+ 7DF7 57               ld   d, a                      ; Byte alto indirizzo video
 308+ 7DF8
 309+ 7DF8 78               ld   a, b
 310+ 7DF9 E6 07            and  7
 311+ 7DFB 87               add  a, a                      ; *2
 312+ 7DFC 87               add  a, a                      ; *4
 313+ 7DFD 87               add  a, a                      ; *8
 314+ 7DFE 87               add  a, a                      ; *16
 315+ 7DFF 87               add  a, a                      ; *32
 316+ 7E00 81               add  a, c                      ; + Col
 317+ 7E01 5F               ld   e, a                      ; Byte basso indirizzo video
 318+ 7E02
 319+ 7E02 C5               push bc
 320+ 7E03 06 08            ld   b, 8                      ; 8 scanline
 321+ 7E05              .line_loop:
 322+ 7E05 7E               ld   a, (hl)
 323+ 7E06 12               ld   (de), a
 324+ 7E07 14               inc  d
 325+ 7E08 23               inc  hl
 326+ 7E09 05               dec  b
 327+ 7E0A 20 F9            jr   nz, .line_loop
 328+ 7E0C C1               pop  bc
 329+ 7E0D
 330+ 7E0D                  ; Calcolo indirizzo attributo: $5800 + Row * 32 + Col
 331+ 7E0D 26 00            ld   h, 0
 332+ 7E0F 68               ld   l, b
 333+ 7E10 29               add  hl, hl
 334+ 7E11 29               add  hl, hl
 335+ 7E12 29               add  hl, hl
 336+ 7E13 29               add  hl, hl
 337+ 7E14 29               add  hl, hl                    ; Row * 32
 338+ 7E15 79               ld   a, c
 339+ 7E16 85               add  a, l
 340+ 7E17 6F               ld   l, a
 341+ 7E18 30 01            jr   nc, .no_carry
 342+ 7E1A 24               inc  h
 343+ 7E1B              .no_carry:
 344+ 7E1B 11 00 58         ld   de, $5800
 345+ 7E1E 19               add  hl, de

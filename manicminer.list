1061+ 827B 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
1062+ 827D
1063+ 827D                  ; DeltaX >= 0:
1064+ 827D FE 09            cp   9
1065+ 827F 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
1066+ 8281
1067+ 8281                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte

 716+ 873D B8               cp   b
 717+ 873E 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 8740 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 8742
 720+ 8742                  ; Byte 1:
 721+ 8742 3A 38 F0         ld   a, (player_score + 1)
 722+ 8745 47               ld   b, a
 723+ 8746 3A 3B F0         ld   a, (high_score + 1)
 724+ 8749 B8               cp   b
 725+ 874A 38 0C            jr   c, .new_high_score
 726+ 874C 20 1C            jr   nz, .done_check
 727+ 874E
 728+ 874E                  ; Byte 0:
 729+ 874E 3A 37 F0         ld   a, (player_score + 0)
 730+ 8751 47               ld   b, a
 731+ 8752 3A 3A F0         ld   a, (high_score + 0)
 732+ 8755 B8               cp   b
 733+ 8756 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 8758
 735+ 8758              .new_high_score:

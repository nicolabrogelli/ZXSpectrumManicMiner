 162+ 7B16              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7B16              ; -------------------------------------------------------------------
 164+ 7B16              CheckEnemyWillyOverlap:
 165+ 7B16 3A 9A 92         ld   a, (player_drawn_pos+1)
 166+ 7B19 FE FF            cp   $FF
 167+ 7B1B C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7B1C
 169+ 7B1C                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7B1C 3A 99 92         ld   a, (player_drawn_pos)
 171+ 7B1F E6 F8            and  $F8
 172+ 7B21 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7B22 79               ld   a, c
 174+ 7B23 E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7B25 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7B26 C6 10            add  a, 16
 177+ 7B28 FE 19            cp   25
 178+ 7B2A D0               ret  nc                 ; Fuori portata X
 179+ 7B2B
 180+ 7B2B                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7B2B 3A 9A 92         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7B2E 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7B2F C6 0F            add  a, 15
 184+ 7B31 FE 1F            cp   31
 185+ 7B33 D0               ret  nc                 ; Fuori portata Y

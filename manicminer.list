 316+ 7C4E              ; Enemy_DrawSingleSlot
 317+ 7C4E              ;
 318+ 7C4E              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7C4E              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7C4E              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7C4E              ; -------------------------------------------------------------------
 322+ 7C4E              Enemy_DrawSingleSlot:
 323+ 7C4E C5               push bc
 324+ 7C4F D5               push de
 325+ 7C50 E5               push hl
 326+ 7C51 DD E5            push ix
 327+ 7C53
 328+ 7C53                  ; 1. Determina il frame di animazione (0..7)
 329+ 7C53                  ; Nei dati di Manic Miner:
 330+ 7C53                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7C53                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7C53 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7C56 E6 03            and  3
 334+ 7C58 47               ld   b, a                      ; B = Anim subframe
 335+ 7C59
 336+ 7C59 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7C5C FE 01            cp   1                         ; Sinistra?
 338+ 7C5E 28 03            jr   z, .left_frames
 339+ 7C60
 340+ 7C60                  ; Movimento a Destra: Frame 0..3
 341+ 7C60 78               ld   a, b
 342+ 7C61 18 03            jr   .got_frame_idx
 343+ 7C63
 344+ 7C63              .left_frames:
 345+ 7C63                  ; Movimento a Sinistra: Frame 4..7
 346+ 7C63 3E 04            ld   a, 4
 347+ 7C65 80               add  a, b
 348+ 7C66
 349+ 7C66              .got_frame_idx:
 350+ 7C66                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7C66 6F               ld   l, a
 352+ 7C67 26 00            ld   h, 0
 353+ 7C69 29               add  hl, hl                    ; *2
 354+ 7C6A 29               add  hl, hl                    ; *4
 355+ 7C6B 29               add  hl, hl                    ; *8
 356+ 7C6C 29               add  hl, hl                    ; *16
 357+ 7C6D 29               add  hl, hl                    ; *32
 358+ 7C6E
 359+ 7C6E 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7C71 19               add  hl, de
 361+ 7C72 ED 5B F1 92      ld   de, (room_ptr)
 362+ 7C76 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7C77 E5               push hl
 364+ 7C78 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7C7A
 366+ 7C7A                  ; 2. Coordinate e colore
 367+ 7C7A FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7C7C FD E5            push iy
 369+ 7C7E
 370+ 7C7E FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7C81 FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7C84 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7C87
 374+ 7C87                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7C87 CD 38 5F         call Gfx_DrawPixelSprite16x16
 376+ 7C8A FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7C8D CD 25 6B         call Gfx_SetEnemyColorAttributes

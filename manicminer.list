 142+ 85AE              ; Items_DrawRoom
 143+ 85AE              ;
 144+ 85AE              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 85AE              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 85AE              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 85AE              ;
 148+ 85AE              ; Record item nella stanza (5 byte):
 149+ 85AE              ;   +0 Color / Attributo
 150+ 85AE              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 85AE              ;   +2 Attr Address High
 152+ 85AE              ;   +3 Anim Mask (96)
 153+ 85AE              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 85AE              ; Fine lista: $FF
 155+ 85AE              ; -------------------------------------------------------------------
 156+ 85AE              Items_DrawRoom:
 157+ 85AE E5               push hl
 158+ 85AF D5               push de
 159+ 85B0 C5               push bc

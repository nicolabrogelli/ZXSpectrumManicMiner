  68+ 7D6A B7               or   a
  69+ 7D6B 28 74            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7D6D
  71+ 7D6D                  ; Slot attivo
  72+ 7D6D DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7D71 CB 7F            bit  7, a
  74+ 7D73 28 04            jr   z, .h_speed_normal
  75+ 7D75 DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)

1926+ 7BDD DD 36 00 00      ld   (ix+0), 0             ; Reset in crumbling_grid
1927+ 7BE1
1928+ 7BE1                  ; 1. Rimuovi definitivamente da unpacked_layout (imposta a 0 = Background)
1929+ 7BE1 C5               push bc
1930+ 7BE2 D5               push de
1931+ 7BE3 E5               push hl
1932+ 7BE4 6A               ld   l, d                  ; L = Row
1933+ 7BE5 26 00            ld   h, 0
1934+ 7BE7 29               add  hl, hl
1934+ 7BE8 29             add hl, hl
1934+ 7BE9 29             add hl, hl
1934+ 7BEA 29             add hl, hl
1934+ 7BEB 29             add hl, hl

   6+ 6C7D              ; MovePlayer
   7+ 6C7D              ;
   8+ 6C7D              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6C7D              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6C7D              ; con i muri.
  11+ 6C7D              ;
  12+ 6C7D              ; Input:
  13+ 6C7D              ;   D = stato dei controlli (bitfield)
  14+ 6C7D              ;
  15+ 6C7D              ; Strutture utilizzate:
  16+ 6C7D              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6C7D              ;   player_speed    -> velocità orizzontale
  18+ 6C7D              ;   flags           -> flag di stato input
  19+ 6C7D              ;
  20+ 6C7D              ; Bit controlli:
  21+ 6C7D              ;   bit 0 = sinistra
  22+ 6C7D              ;   bit 1 = destra
  23+ 6C7D              ;
  24+ 6C7D              ; Nota:
  25+ 6C7D              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6C7D              ;   ignorato per tutta la durata del salto.
  27+ 6C7D              ;
  28+ 6C7D              ; Output:
  29+ 6C7D              ;   aggiorna PlayerPos e body_state
  30+ 6C7D              ; -------------------------------------------------------------------
  31+ 6C7D              MovePlayer:
  32+ 6C7D
  33+ 6C7D                  ; ---------------------------------------------------------------
  34+ 6C7D                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6C7D                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6C7D                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6C7D                  ; ---------------------------------------------------------------
  38+ 6C7D 3A 80 8F         ld   a, (on_ground)
  39+ 6C80 B7               or   a
  40+ 6C81 20 1A            jr   nz, .on_ground_check
  41+ 6C83
  42+ 6C83 3A 85 8F         ld   a, (jump_dir)

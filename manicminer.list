 436+ 7EC0              ; -------------------------------------------------------------------
 437+ 7EC0              ; Enemy_Update
 438+ 7EC0              ;
 439+ 7EC0              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 440+ 7EC0              ; -------------------------------------------------------------------
 441+ 7EC0              Enemy_Update:
 442+ 7EC0                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 443+ 7EC0 3A 52 BE         ld   a, (enemy_update_rate)
 444+ 7EC3 FE 01            cp   1
 445+ 7EC5 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 446+ 7EC7
 447+ 7EC7 21 53 BE         ld   hl, enemy_update_timer
 448+ 7ECA 34               inc  (hl)
 449+ 7ECB 7E               ld   a, (hl)
 450+ 7ECC 21 52 BE         ld   hl, enemy_update_rate
 451+ 7ECF BE               cp   (hl)
 452+ 7ED0 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 453+ 7ED1 AF               xor  a
 454+ 7ED2 32 53 BE         ld   (enemy_update_timer), a
 455+ 7ED5
 456+ 7ED5              .do_update:
 457+ 7ED5 E5               push hl
 458+ 7ED6 D5               push de
 459+ 7ED7 C5               push bc
 460+ 7ED8 DD E5            push ix
 461+ 7EDA
 462+ 7EDA 3E 01            ld   a, 1
 463+ 7EDC 32 D9 BE         ld   (enemy_was_updated), a
 464+ 7EDF
 465+ 7EDF DD 21 4B 7C      ld   ix, ActiveEnemies
 466+ 7EE3 06 08            ld   b, 8                      ; 8 slot
 467+ 7EE5              .loop:
 468+ 7EE5 DD 7E 00         ld   a, (ix+0)                 ; Flags
 469+ 7EE8 E6 80            and  $80                       ; Active?
 470+ 7EEA CA 94 7F         jp   z, .next
 471+ 7EED
 472+ 7EED                  ; 1. Determina se orizzontale o verticale
 473+ 7EED DD 7E 00         ld   a, (ix+0)
 474+ 7EF0 E6 40            and  $40                       ; Vertical?
 475+ 7EF2 C2 45 7F         jp   nz, .vertical
 476+ 7EF5
 477+ 7EF5                  ; Aggiorna Anim State per guardiano orizzontale (0..3)
 478+ 7EF5 DD 7E 07         ld   a, (ix+7)
 479+ 7EF8 3C               inc  a
 480+ 7EF9 E6 03            and  3
 481+ 7EFB DD 77 07         ld   (ix+7), a
 482+ 7EFE
 483+ 7EFE              .horizontal:
 484+ 7EFE DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 485+ 7F01 FE 01            cp   1
 486+ 7F03 20 20            jr   nz, .horiz_right
 487+ 7F05
 488+ 7F05              .horiz_left:
 489+ 7F05 DD 7E 02         ld   a, (ix+2)                 ; Current X
 490+ 7F08 D6 02            sub  2                         ; Muovi a sinistra di 2 pixel
 491+ 7F0A DD BE 04         cp   (ix+4)                    ; Min Limit
 492+ 7F0D 28 08            jr   z, .h_rev_right
 493+ 7F0F 38 06            jr   c, .h_rev_right
 494+ 7F11 DD 77 02         ld   (ix+2), a
 495+ 7F14 C3 94 7F         jp   .next
 496+ 7F17
 497+ 7F17              .h_rev_right:
 498+ 7F17 DD 7E 04         ld   a, (ix+4)                 ; Min Limit
 499+ 7F1A DD 77 02         ld   (ix+2), a
 500+ 7F1D 3E 02            ld   a, 2
 501+ 7F1F DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Destra
 502+ 7F22 C3 94 7F         jp   .next
 503+ 7F25
 504+ 7F25              .horiz_right:
 505+ 7F25 DD 7E 02         ld   a, (ix+2)                 ; Current X
 506+ 7F28 C6 02            add  a, 2                      ; Muovi a destra di 2 pixel
 507+ 7F2A DD BE 05         cp   (ix+5)                    ; Max Limit
 508+ 7F2D 28 08            jr   z, .h_rev_left
 509+ 7F2F 30 06            jr   nc, .h_rev_left
 510+ 7F31 DD 77 02         ld   (ix+2), a
 511+ 7F34 C3 94 7F         jp   .next
 512+ 7F37
 513+ 7F37              .h_rev_left:
 514+ 7F37 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 515+ 7F3A DD 77 02         ld   (ix+2), a
 516+ 7F3D 3E 01            ld   a, 1
 517+ 7F3F DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 518+ 7F42 C3 94 7F         jp   .next
 519+ 7F45
 520+ 7F45              .vertical:
 521+ 7F45 DD 7E 07         ld   a, (ix+7)                 ; Step in pixel (1 o 2)
 522+ 7F48 E6 03            and  3
 523+ 7F4A 20 02            jr   nz, .v_step_ok
 524+ 7F4C 3E 01            ld   a, 1
 525+ 7F4E              .v_step_ok:
 526+ 7F4E 4F               ld   c, a                      ; C = Step
 527+ 7F4F
 528+ 7F4F DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 529+ 7F52 FE 01            cp   1
 530+ 7F54 20 1F            jr   nz, .vert_down
 531+ 7F56
 532+ 7F56              .vert_up:
 533+ 7F56 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 534+ 7F59 91               sub  c                         ; Muovi verso l'alto
 535+ 7F5A DD BE 04         cp   (ix+4)                    ; Min Limit Y
 536+ 7F5D 28 08            jr   z, .v_rev_down
 537+ 7F5F 38 06            jr   c, .v_rev_down
 538+ 7F61 DD 77 03         ld   (ix+3), a
 539+ 7F64 C3 94 7F         jp   .next
 540+ 7F67
 541+ 7F67              .v_rev_down:
 542+ 7F67 DD 7E 04         ld   a, (ix+4)                 ; Min Limit Y
 543+ 7F6A DD 77 03         ld   (ix+3), a
 544+ 7F6D 3E 02            ld   a, 2                      ; Cambia direzione a Down
 545+ 7F6F DD 77 06         ld   (ix+6), a
 546+ 7F72 C3 94 7F         jp   .next
 547+ 7F75
 548+ 7F75              .vert_down:
 549+ 7F75 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 550+ 7F78 81               add  a, c                      ; Muovi verso il basso
 551+ 7F79 DD BE 05         cp   (ix+5)                    ; Max Limit Y
 552+ 7F7C 28 08            jr   z, .v_rev_up
 553+ 7F7E 30 06            jr   nc, .v_rev_up
 554+ 7F80 DD 77 03         ld   (ix+3), a
 555+ 7F83 C3 94 7F         jp   .next
 556+ 7F86
 557+ 7F86              .v_rev_up:
 558+ 7F86 DD 7E 05         ld   a, (ix+5)                 ; Max Limit Y
 559+ 7F89 DD 77 03         ld   (ix+3), a
 560+ 7F8C 3E 01            ld   a, 1                      ; Cambia direzione a Up
 561+ 7F8E DD 77 06         ld   (ix+6), a
 562+ 7F91 C3 94 7F         jp   .next
 563+ 7F94
 564+ 7F94              .next:
 565+ 7F94 11 0B 00         ld   de, 11
 566+ 7F97 DD 19            add  ix, de
 567+ 7F99 05               dec  b
 568+ 7F9A C2 E5 7E         jp   nz, .loop
 569+ 7F9D
 570+ 7F9D DD E1            pop  ix
 571+ 7F9F C1               pop  bc
 572+ 7FA0 D1               pop  de
 573+ 7FA1 E1               pop  hl
 574+ 7FA2 C9               ret
 575+ 7FA3
 576+ 7FA3              ; -------------------------------------------------------------------
 577+ 7FA3              ; CheckCollision
 578+ 7FA3              ;
 579+ 7FA3              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 580+ 7FA3              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 581+ 7FA3              ; Output:
 582+ 7FA3              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 583+ 7FA3              ;   Carry Clear = Nessuna collisione
 584+ 7FA3              ; -------------------------------------------------------------------
 585+ 7FA3              CheckCollision:
 586+ 7FA3 DD E5            push ix
 587+ 7FA5 C5               push bc
 588+ 7FA6 D5               push de
 589+ 7FA7 E5               push hl
 590+ 7FA8
 591+ 7FA8                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 592+ 7FA8 3A DA BE         ld   a, (willy_safety_timer)
 593+ 7FAB B7               or   a
 594+ 7FAC C2 F6 80         jp   nz, .no_collision_found
 595+ 7FAF
 596+ 7FAF                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 597+ 7FAF 3A D6 BA         ld   a, (direction)
 598+ 7FB2 FE 01            cp   1                         ; Sinistra?
 599+ 7FB4 20 1A            jr   nz, .willy_right
 600+ 7FB6
 601+ 7FB6                  ; Willy a Sinistra:
 602+ 7FB6 21 AF B4         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 603+ 7FB9 22 F0 C0         ld   (willy_head_ptr), hl
 604+ 7FBC 3A D5 BA         ld   a, (body_state)           ; 0, 1, 2
 605+ 7FBF C6 05            add  a, 5                      ; tile 5, 6, 7
 606+ 7FC1 87               add  a, a
 606+ 7FC2 87             add a, a
 606+ 7FC3 87             add a, a ; * 8
 607+ 7FC4 5F               ld   e, a
 608+ 7FC5 16 00            ld   d, 0
 609+ 7FC7 21 8F B4         ld   hl, Willy
 610+ 7FCA 19               add  hl, de
 611+ 7FCB 22 F2 C0         ld   (willy_body_ptr), hl      ; Corpo sinistro
 612+ 7FCE 18 18            jr   .willy_ptrs_ready
 613+ 7FD0
 614+ 7FD0              .willy_right:
 615+ 7FD0                  ; Willy a Destra:
 616+ 7FD0 21 8F B4         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 617+ 7FD3 22 F0 C0         ld   (willy_head_ptr), hl
 618+ 7FD6 3A D5 BA         ld   a, (body_state)           ; 0, 1, 2
 619+ 7FD9 C6 01            add  a, 1                      ; tile 1, 2, 3
 620+ 7FDB 87               add  a, a
 620+ 7FDC 87             add a, a
 620+ 7FDD 87             add a, a ; * 8
 621+ 7FDE 5F               ld   e, a
 622+ 7FDF 16 00            ld   d, 0
 623+ 7FE1 21 8F B4         ld   hl, Willy
 624+ 7FE4 19               add  hl, de
 625+ 7FE5 22 F2 C0         ld   (willy_body_ptr), hl      ; Corpo destro
 626+ 7FE8
 627+ 7FE8              .willy_ptrs_ready:
 628+ 7FE8 DD 21 4B 7C      ld   ix, ActiveEnemies
 629+ 7FEC 06 08            ld   b, 8                      ; 8 slot
 630+ 7FEE
 631+ 7FEE              .enemy_loop:
 632+ 7FEE DD 7E 00         ld   a, (ix+0)
 633+ 7FF1 E6 80            and  $80                       ; Active?
 634+ 7FF3 CA ED 80         jp   z, .next_enemy
 635+ 7FF6
 636+ 7FF6                  ; ---------------------------------------------------------------
 637+ 7FF6                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 638+ 7FF6                  ; ---------------------------------------------------------------
 639+ 7FF6                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 640+ 7FF6 3A CF BA         ld   a, (PlayerPos)            ; WillyX
 641+ 7FF9 DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 642+ 7FFC FE 10            cp   16
 643+ 7FFE 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 644+ 8000 FE F9            cp   249                       ; 249..255 = -7..-1
 645+ 8002 DA ED 80         jp   c, .next_enemy            ; 16..248 -> fuori range
 646+ 8005              .x_in_range:
 647+ 8005 32 F6 C0         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 648+ 8008
 649+ 8008                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 650+ 8008 3A D0 BA         ld   a, (PlayerPos+1)          ; WillyY
 651+ 800B DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 652+ 800E FE 10            cp   16
 653+ 8010 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 654+ 8012 FE F1            cp   241                       ; 241..255 = -15..-1
 655+ 8014 DA ED 80         jp   c, .next_enemy            ; 16..240 -> fuori range
 656+ 8017              .y_in_range:
 657+ 8017 32 F7 C0         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 658+ 801A
 659+ 801A                  ; ---------------------------------------------------------------
 660+ 801A                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 661+ 801A                  ; ---------------------------------------------------------------
 662+ 801A C5               push bc                        ; Salva contatore nemici (B)
 663+ 801B
 664+ 801B                  ; Controlla se è guardiano verticale
 665+ 801B DD 7E 00         ld   a, (ix+0)
 666+ 801E E6 40            and  $40                       ; Vertical?
 667+ 8020 20 15            jr   nz, .col_guard_vert
 668+ 8022
 669+ 8022 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 670+ 8025 E6 03            and  3
 671+ 8027 4F               ld   c, a
 672+ 8028
 673+ 8028 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 674+ 802B FE 01            cp   1
 675+ 802D 28 03            jr   z, .guard_left_frame
 676+ 802F                  ; Frame Destra: Frame = Subframe (0..3)
 677+ 802F 79               ld   a, c
 678+ 8030 18 0A            jr   .calc_guard_ptr
 679+ 8032              .guard_left_frame:
 680+ 8032                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 681+ 8032 3E 04            ld   a, 4
 682+ 8034 81               add  a, c
 683+ 8035 18 05            jr   .calc_guard_ptr
 684+ 8037
 685+ 8037              .col_guard_vert:
 686+ 8037                  ; Guardiano verticale: usa il frame salvato in (ix+1) (4..7)
 687+ 8037 DD 7E 01         ld   a, (ix+1)
 688+ 803A E6 07            and  7
 689+ 803C
 690+ 803C              .calc_guard_ptr:
 691+ 803C                  ; Offset = Frame * 32
 692+ 803C 6F               ld   l, a
 693+ 803D 26 00            ld   h, 0
 694+ 803F 29               add  hl, hl                    ; *2
 695+ 8040 29               add  hl, hl                    ; *4
 696+ 8041 29               add  hl, hl                    ; *8
 697+ 8042 29               add  hl, hl                    ; *16
 698+ 8043 29               add  hl, hl                    ; *32
 699+ 8044 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 700+ 8047 19               add  hl, de
 701+ 8048 ED 5B 50 BE      ld   de, (room_ptr)
 702+ 804C 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 703+ 804D 22 F4 C0         ld   (guard_sprite_ptr), hl
 704+ 8050
 705+ 8050                  ; ---------------------------------------------------------------
 706+ 8050                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 707+ 8050                  ; ---------------------------------------------------------------
 708+ 8050 3A F7 C0         ld   a, (collision_delta_y)
 709+ 8053 CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 710+ 8055 20 12            jr   nz, .willy_higher
 711+ 8057
 712+ 8057                  ; Willy lower or equal (DeltaY >= 0):
 713+ 8057                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 714+ 8057 32 F8 C0         ld   (row_enemy_cur), a
 715+ 805A AF               xor  a
 716+ 805B 32 F9 C0         ld   (row_willy_cur), a
 717+ 805E 3E 10            ld   a, 16
 718+ 8060 21 F7 C0         ld   hl, collision_delta_y
 719+ 8063 96               sub  (hl)
 720+ 8064 32 FA C0         ld   (overlap_num_lines), a
 721+ 8067 18 12            jr   .check_lines_loop
 722+ 8069
 723+ 8069              .willy_higher:
 724+ 8069                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 725+ 8069 ED 44            neg                            ; A = -DeltaY (1..15)
 726+ 806B 32 F9 C0         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 727+ 806E AF               xor  a
 728+ 806F 32 F8 C0         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 729+ 8072 3E 10            ld   a, 16
 730+ 8074 21 F9 C0         ld   hl, row_willy_cur
 731+ 8077 96               sub  (hl)
 732+ 8078 32 FA C0         ld   (overlap_num_lines), a
 733+ 807B
 734+ 807B              .check_lines_loop:
 735+ 807B                  ; ---------------------------------------------------------------
 736+ 807B                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 737+ 807B                  ; ---------------------------------------------------------------
 738+ 807B 3A FA C0         ld   a, (overlap_num_lines)
 739+ 807E 47               ld   b, a                      ; B = numero di scanlines da controllare
 740+ 807F
 741+ 807F              .scanline_loop:
 742+ 807F C5               push bc                        ; Salva contatore scanlines
 743+ 8080
 744+ 8080                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 745+ 8080 3A F8 C0         ld   a, (row_enemy_cur)
 746+ 8083 87               add  a, a                      ; row * 2
 747+ 8084 5F               ld   e, a
 748+ 8085 16 00            ld   d, 0
 749+ 8087 2A F4 C0         ld   hl, (guard_sprite_ptr)
 750+ 808A 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 751+ 808B 56               ld   d, (hl)                   ; D = Enemy Byte 0
 752+ 808C 23               inc  hl
 753+ 808D 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 754+ 808E
 755+ 808E                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 756+ 808E 3A F6 C0         ld   a, (collision_delta_x)
 757+ 8091 CB 7F            bit  7, a
 758+ 8093 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 759+ 8095
 760+ 8095                  ; DeltaX >= 0:
 761+ 8095 FE 09            cp   9
 762+ 8097 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 763+ 8099
 764+ 8099                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 765+ 8099 B7               or   a
 766+ 809A 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 767+ 809C 4F               ld   c, a                      ; C = DeltaX (1..8)
 768+ 809D              .shift_left_16bit:
 769+ 809D CB 23            sla  e
 770+ 809F CB 12            rl   d
 771+ 80A1 0D               dec  c
 772+ 80A2 20 F9            jr   nz, .shift_left_16bit
 773+ 80A4              .slice_ready_in_d:
 774+ 80A4 7A               ld   a, d                      ; A = fetta guardiano allineata
 775+ 80A5 18 14            jr   .test_willy_line
 776+ 80A7
 777+ 80A7              .shift_dx_gt_8:
 778+ 80A7                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 779+ 80A7 D6 08            sub  8
 780+ 80A9 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 781+ 80AA              .shift_left_e_only:
 782+ 80AA CB 23            sla  e
 783+ 80AC 0D               dec  c
 784+ 80AD 20 FB            jr   nz, .shift_left_e_only
 785+ 80AF 7B               ld   a, e                      ; A = fetta guardiano allineata
 786+ 80B0 18 09            jr   .test_willy_line
 787+ 80B2
 788+ 80B2              .shift_neg_dx:
 789+ 80B2                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 790+ 80B2 ED 44            neg
 791+ 80B4 4F               ld   c, a                      ; C = -DeltaX (1..7)
 792+ 80B5              .shift_right_d_only:
 793+ 80B5 CB 3A            srl  d
 794+ 80B7 0D               dec  c
 795+ 80B8 20 FB            jr   nz, .shift_right_d_only
 796+ 80BA 7A               ld   a, d                      ; A = fetta guardiano allineata
 797+ 80BB
 798+ 80BB              .test_willy_line:
 799+ 80BB                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 800+ 80BB B7               or   a
 801+ 80BC 28 21            jr   z, .next_scanline
 802+ 80BE
 803+ 80BE                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 804+ 80BE 4F               ld   c, a                      ; C = fetta guardiano
 805+ 80BF 3A F9 C0         ld   a, (row_willy_cur)
 806+ 80C2 FE 08            cp   8
 807+ 80C4 38 0D            jr   c, .read_willy_head
 808+ 80C6
 809+ 80C6                  ; Riga corpo (8..15)
 810+ 80C6 D6 08            sub  8
 811+ 80C8 6F               ld   l, a
 812+ 80C9 26 00            ld   h, 0
 813+ 80CB ED 5B F2 C0      ld   de, (willy_body_ptr)
 814+ 80CF 19               add  hl, de
 815+ 80D0 7E               ld   a, (hl)                   ; A = byte corpo Willy
 816+ 80D1 18 09            jr   .do_pixel_and
 817+ 80D3
 818+ 80D3              .read_willy_head:
 819+ 80D3                  ; Riga testa (0..7)
 820+ 80D3 6F               ld   l, a
 821+ 80D4 26 00            ld   h, 0
 822+ 80D6 ED 5B F0 C0      ld   de, (willy_head_ptr)
 823+ 80DA 19               add  hl, de
 824+ 80DB 7E               ld   a, (hl)                   ; A = byte testa Willy
 825+ 80DC
 826+ 80DC              .do_pixel_and:
 827+ 80DC                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 828+ 80DC A1               and  c
 829+ 80DD 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 830+ 80DF
 831+ 80DF              .next_scanline:
 832+ 80DF                  ; Avanza alla prossima riga
 833+ 80DF 21 F8 C0         ld   hl, row_enemy_cur
 834+ 80E2 34               inc  (hl)
 835+ 80E3 21 F9 C0         ld   hl, row_willy_cur
 836+ 80E6 34               inc  (hl)
 837+ 80E7
 838+ 80E7 C1               pop  bc                        ; Ripristina B (contatore scanlines)
 839+ 80E8 05               dec  b
 840+ 80E9 C2 7F 80         jp   nz, .scanline_loop
 841+ 80EC
 842+ 80EC                  ; Nessun pixel sovrapposto per questo guardiano
 843+ 80EC C1               pop  bc                        ; Ripristina B (contatore nemici)
 844+ 80ED
 845+ 80ED              .next_enemy:
 846+ 80ED 11 0B 00         ld   de, 11
 847+ 80F0 DD 19            add  ix, de
 848+ 80F2 05               dec  b
 849+ 80F3 C2 EE 7F         jp   nz, .enemy_loop
 850+ 80F6
 851+ 80F6              .no_collision_found:
 852+ 80F6 E1               pop  hl
 853+ 80F7 D1               pop  de
 854+ 80F8 C1               pop  bc
 855+ 80F9 DD E1            pop  ix
 856+ 80FB B7               or   a                         ; Carry = 0 (Nessuna collisione)
 857+ 80FC C9               ret
 858+ 80FD
 859+ 80FD              .pixel_collision_detected:
 860+ 80FD C1               pop  bc                        ; Pulisci stack scanline
 861+ 80FE C1               pop  bc                        ; Pulisci stack nemici
 862+ 80FF E1               pop  hl

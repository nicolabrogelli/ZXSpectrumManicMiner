 829  8704              ; CheckWillyConveyorCollision
 830  8704              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 831  8704              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 832  8704              ; -------------------------------------------------------------------
 833  8704              CheckWillyConveyorCollision:
 834  8704 C5               push bc
 835  8705 D5               push de
 836  8706 E5               push hl
 837  8707
 838  8707                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 839  8707 CD 22 77         call CheckWillyOnConveyor
 840  870A 38 49            jr   c, .collision_detected
 841  870C
 842  870C                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 843  870C 3A 2C A1         ld   a, (conveyor_len)
 844  870F B7               or   a
 845  8710 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 846  8712
 847  8712                  ; B = WillyY, C = WillyX
 848  8712 ED 4B 04 9E      ld   bc, (PlayerPos)
 849  8716
 850  8716                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 851  8716 3A 2D A1         ld   a, (conveyor_row)
 852  8719 87               add  a, a                  ; *2
 853  871A 87               add  a, a                  ; *4
 854  871B 87               add  a, a                  ; *8
 855  871C 5F               ld   e, a                  ; E = ConveyorTop
 856  871D C6 07            add  a, 7
 857  871F 57               ld   d, a                  ; D = ConveyorBottom
 858  8720
 859  8720                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 860  8720 78               ld   a, b                  ; WillyTop
 861  8721 BA               cp   d
 862  8722 28 04            jr   z, .y_overlap
 863  8724 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 864  8726 18 32            jr   .no_conv_collision
 865  8728
 866  8728              .y_overlap:
 867  8728 C6 0F            add  a, 15                 ; WillyBottom
 868  872A BB               cp   e
 869  872B 28 04            jr   z, .x_check
 870  872D 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 871  872F 18 29            jr   .no_conv_collision
 872  8731
 873  8731              .x_check:
 874  8731                  ; ConveyorLeft = conveyor_col * 8
 875  8731 3A 2E A1         ld   a, (conveyor_col)
 876  8734 87               add  a, a                  ; *2
 877  8735 87               add  a, a                  ; *4
 878  8736 87               add  a, a                  ; *8
 879  8737 5F               ld   e, a                  ; E = ConveyorLeft
 880  8738
 881  8738                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 882  8738 21 2C A1         ld   hl, conveyor_len
 883  873B 3A 2E A1         ld   a, (conveyor_col)
 884  873E 86               add  a, (hl)
 885  873F 87               add  a, a                  ; *2
 886  8740 87               add  a, a                  ; *4
 887  8741 87               add  a, a                  ; *8
 888  8742 3D               dec  a                     ; ConveyorRight
 889  8743 57               ld   d, a                  ; D = ConveyorRight
 890  8744
 891  8744                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 892  8744 79               ld   a, c                  ; WillyLeft
 893  8745 BA               cp   d
 894  8746 28 04            jr   z, .x_overlap
 895  8748 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 896  874A 18 0E            jr   .no_conv_collision
 897  874C
 898  874C              .x_overlap:
 899  874C C6 0F            add  a, 15                 ; WillyRight
 900  874E BB               cp   e
 901  874F 28 04            jr   z, .collision_detected
 902  8751 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 903  8753 18 05            jr   .no_conv_collision

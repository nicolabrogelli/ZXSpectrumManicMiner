   6+ 6C6C              ; MovePlayer
   7+ 6C6C              ;
   8+ 6C6C              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6C6C              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6C6C              ; con i muri.
  11+ 6C6C              ;
  12+ 6C6C              ; Input:
  13+ 6C6C              ;   D = stato dei controlli (bitfield)
  14+ 6C6C              ;
  15+ 6C6C              ; Strutture utilizzate:
  16+ 6C6C              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6C6C              ;   player_speed    -> velocità orizzontale
  18+ 6C6C              ;   flags           -> flag di stato input
  19+ 6C6C              ;
  20+ 6C6C              ; Bit controlli:
  21+ 6C6C              ;   bit 0 = sinistra
  22+ 6C6C              ;   bit 1 = destra
  23+ 6C6C              ;
  24+ 6C6C              ; Nota:
  25+ 6C6C              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6C6C              ;   ignorato per tutta la durata del salto.
  27+ 6C6C              ;
  28+ 6C6C              ; Output:
  29+ 6C6C              ;   aggiorna PlayerPos e body_state
  30+ 6C6C              ; -------------------------------------------------------------------
  31+ 6C6C              MovePlayer:
  32+ 6C6C
  33+ 6C6C                  ; ---------------------------------------------------------------
  34+ 6C6C                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6C6C                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6C6C                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6C6C                  ; ---------------------------------------------------------------
  38+ 6C6C 3A 98 93         ld   a, (on_ground)
  39+ 6C6F B7               or   a
  40+ 6C70 20 1A            jr   nz, .on_ground_check
  41+ 6C72
  42+ 6C72 3A 9D 93         ld   a, (jump_dir)
  43+ 6C75 B7               or   a
  44+ 6C76 C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  45+ 6C77
  46+ 6C77                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  47+ 6C77 DD 21 91 93      ld   ix, flags
  48+ 6C7B DD CB 00 86      res  $00, (ix)
  49+ 6C7F
  50+ 6C7F ED 4B 89 93      ld   bc, (PlayerPos)
  51+ 6C83 FE 01            cp   1
  52+ 6C85 28 1D            jr   z, movePlayer_left
  53+ 6C87 FE 02            cp   2
  54+ 6C89 28 6A            jr   z, movePlayer_right
  55+ 6C8B C9               ret
  56+ 6C8C
  57+ 6C8C              .on_ground_check:
  58+ 6C8C                  ; ---------------------------------------------------------------
  59+ 6C8C                  ; Se siamo a terra, muoviti solo se c'è input (bit 0 di flags impostato)
  60+ 6C8C                  ; ---------------------------------------------------------------

 782+ 890B 47               ld   b, a                      ; B = Nuovo attributo
 783+ 890C
 784+ 890C                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 890C FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)

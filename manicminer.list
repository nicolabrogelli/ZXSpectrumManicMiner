 268+ 7E74
 269+ 7E74                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E74 DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E77 DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E7A 20 0E            jr   nz, .do_draw_slot
 273+ 7E7C DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E7F DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E82 20 06            jr   nz, .do_draw_slot

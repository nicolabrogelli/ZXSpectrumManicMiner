 281  8226              ; -------------------------------------------------------------------
 282  8226              ; ShowTitleScreen
 283  8226              ; Visualizza la schermata iniziale del gioco (Title Screen).
 284  8226              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 285  8226              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 286  8226              ; -------------------------------------------------------------------
 287  8226              ShowTitleScreen:
 288  8226                  ; 1. Disegna la schermata iniziale
 289  8226 CD C1 62         call Gfx_DrawTitleScreen
 290  8229
 291  8229                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 292  8229              .wait_title_enter_release:
 293  8229 76               halt
 294  822A 3E BF            ld   a, $bf
 295  822C DB FE            in   a, ($fe)
 296  822E 1F               rra
 297  822F 30 F8            jr   nc, .wait_title_enter_release
 298  8231
 299  8231                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 300  8231 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 301  8233              .title_loop:
 302  8233 76               halt
 303  8234
 304  8234                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 305  8234 0C               inc  c
 306  8235 79               ld   a, c
 307  8236 CB 3F            srl  a
 308  8238 CB 3F            srl  a
 309  823A CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 310  823C E6 07            and  7
 311  823E 5F               ld   e, a
 312  823F 16 00            ld   d, 0
 313  8241 21 B9 62         ld   hl, title_color_table
 314  8244 19               add  hl, de
 315  8245 7E               ld   a, (hl)               ; A = nuovo colore
 316  8246 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 317  8249 06 20            ld   b, 32
 318  824B              .color_title_loop:
 319  824B 77               ld   (hl), a
 320  824C 23               inc  hl
 321  824D 10 FC            djnz .color_title_loop
 322  824F
 323  824F                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 324  824F 3E BF            ld   a, $bf
 325  8251 DB FE            in   a, ($fe)
 326  8253 1F               rra
 327  8254 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 328  8256
 329  8256                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 330  8256              .wait_title_enter_release_after:
 331  8256 76               halt
 332  8257 3E BF            ld   a, $bf
 333  8259 DB FE            in   a, ($fe)
 334  825B 1F               rra
 335  825C 30 F8            jr   nc, .wait_title_enter_release_after
 336  825E
 337  825E                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 338  825E AF               xor  a
 339  825F D3 FE            out  ($fe), a              ; Bordo a nero
 340  8261 21 8D 5C         ld   hl, ATTR_P
 341  8264 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 342  8265 CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 343  8268 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 344  826A 3E 07            ld   a, $07
 345  826C 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 346  826F
 347  826F                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 348  826F CD E4 84         call ResetFullGameState
 349  8272
 350  8272                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 351  8272 C3 00 81         jp   LoadRoomAndRestart

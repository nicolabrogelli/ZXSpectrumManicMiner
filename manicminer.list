 600+ 6033              ; Disegna il player (testa e corpo se Willy, oppure MaialeSprite se in TheNightmareRoom)
 601+ 6033              ; -------------------------------------------------------------------
 602+ 6033              Gfx_PrintPlayer:
 603+ 6033 DD E5            push ix
 604+ 6035 D5               push de
 605+ 6036 E5               push hl
 606+ 6037 C5               push bc
 607+ 6038
 608+ 6038                  ; --- RENDERING STANDARD WILLY ---
 609+ 6038                  ; 1. Determina sprite per la testa (sinistra o destra)
 610+ 6038 3A 90 93         ld   a, (direction)
 611+ 603B FE 01            cp   1                 ; Sinistra?
 612+ 603D 20 06            jr   nz, .right_head
 613+ 603F
 614+ 603F DD 21 69 8D      ld   ix, Willy + (4 * 8) ; 5° tile (HEAD_GRAPH_LEFT)
 615+ 6043 18 04            jr   .draw_head
 616+ 6045
 617+ 6045              .right_head:
 618+ 6045 DD 21 49 8D      ld   ix, Willy + (0 * 8) ; 1° tile (HEAD_GRAPH_RIGHT)
 619+ 6049
 620+ 6049              .draw_head:
 621+ 6049 ED 4B 89 93      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 622+ 604D CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna testa
 623+ 6050
 624+ 6050                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
 625+ 6050 3A 90 93         ld   a, (direction)
 626+ 6053 FE 01            cp   1                 ; Sinistra?
 627+ 6055 20 13            jr   nz, .right_body
 628+ 6057
 629+ 6057                  ; Corpo a sinistra
 630+ 6057 3A 8F 93         ld   a, (body_state)   ; 0, 1, 2
 631+ 605A C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
 632+ 605C 87               add  a, a              ; *2
 633+ 605D 87               add  a, a              ; *4
 634+ 605E 87               add  a, a              ; *8
 635+ 605F 5F               ld   e, a
 636+ 6060 16 00            ld   d, 0
 637+ 6062 DD 21 49 8D      ld   ix, Willy
 638+ 6066 DD 19            add  ix, de
 639+ 6068 18 11            jr   .draw_body
 640+ 606A
 641+ 606A              .right_body:
 642+ 606A                  ; Corpo a destra
 643+ 606A 3A 8F 93         ld   a, (body_state)   ; 0, 1, 2
 644+ 606D C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 645+ 606F 87               add  a, a              ; *2
 646+ 6070 87               add  a, a              ; *4
 647+ 6071 87               add  a, a              ; *8
 648+ 6072 5F               ld   e, a
 649+ 6073 16 00            ld   d, 0
 650+ 6075 DD 21 49 8D      ld   ix, Willy
 651+ 6079 DD 19            add  ix, de
 652+ 607B
 653+ 607B              .draw_body:
 654+ 607B ED 4B 89 93      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 655+ 607F 78               ld   a, b
 656+ 6080 C6 08            add  a, 8
 657+ 6082 47               ld   b, a              ; B = PlayerY + 8
 658+ 6083 CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna corpo
 659+ 6086
 660+ 6086                  ; 3. Imposta gli attributi colore di Willy (Bianco Brillante)
 661+ 6086 ED 4B 89 93      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY

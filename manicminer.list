  30+ 8984 57               ld   d, a                      ; D = delay della nota
  31+ 8985
  32+ 8985                  ; Suona la nota: 15 cicli
  33+ 8985 06 0F            ld   b, 15
  34+ 8987              .note_loop:
  35+ 8987                  ; Speaker ON
  36+ 8987 3A EB EB         ld   a, (room_border_color)
  37+ 898A F6 10            or   $10

 163+ 84EF                  ; 1. Azzera items_grid (512 byte)
 164+ 84EF 21 24 E8         ld   hl, items_grid
 165+ 84F2 11 25 E8         ld   de, items_grid + 1
 166+ 84F5 36 00            ld   (hl), 0
 167+ 84F7 01 FF 01         ld   bc, 511
 168+ 84FA ED B0            ldir
 169+ 84FC
 170+ 84FC                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 84FC AF               xor  a
 172+ 84FD 32 A4 ED         ld   (num_room_items), a
 173+ 8500
 174+ 8500 FD 21 54 ED      ld   iy, current_room_items
 175+ 8504
 176+ 8504                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 8504 2A A5 ED         ld   hl, (room_ptr)
 178+ 8507 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 850A 19               add  hl, de
 180+ 850B E5               push hl
 181+ 850C DD E1            pop  ix                        ; IX = bitmap item
 182+ 850E
 183+ 850E                  ; 4. HL = Inizio lista item nella stanza
 184+ 850E 2A A5 ED         ld   hl, (room_ptr)
 185+ 8511 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8514 19               add  hl, de
 187+ 8515
 188+ 8515              .loop:
 189+ 8515 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 8516 FE FF            cp   $FF
 191+ 8518 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 851A B7               or   a
 193+ 851B 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 851D
 195+ 851D 5F               ld   e, a                      ; E = Color
 196+ 851E 23               inc  hl
 197+ 851F 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8520 23               inc  hl
 199+ 8521 46               ld   b, (hl)                   ; B = AttrAddr High
 200+ 8522 23               inc  hl                        ; Salta Anim Byte
 201+ 8523 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 202+ 8524
 203+ 8524 7E               ld   a, (hl)                   ; A = Collected flag
 204+ 8525 FE FF            cp   $FF
 205+ 8527 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto

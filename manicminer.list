 671+ 87CF              ; -------------------------------------------------------------------
 672+ 87CF              ; Score_AddItemPoints
 673+ 87CF              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 674+ 87CF              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 675+ 87CF              ; -------------------------------------------------------------------
 676+ 87CF              Score_AddItemPoints:
 677+ 87CF F5               push af
 678+ 87D0 C5               push bc
 679+ 87D1 D5               push de
 680+ 87D2 E5               push hl
 681+ 87D3
 682+ 87D3                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 683+ 87D3 3A F2 F0         ld   a, (player_score + 1)
 684+ 87D6 C6 01            add  a, $01
 685+ 87D8 27               daa
 686+ 87D9 32 F2 F0         ld   (player_score + 1), a
 687+ 87DC
 688+ 87DC                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 87DC 3A F3 F0         ld   a, (player_score + 2)
 690+ 87DF CE 00            adc  a, 0
 691+ 87E1 27               daa
 692+ 87E2 32 F3 F0         ld   (player_score + 2), a
 693+ 87E5
 694+ 87E5                  ; Controlla se player_score ha superato high_score
 695+ 87E5 CD F0 87         call Score_CheckAndUpdateHighScore
 696+ 87E8
 697+ 87E8                  ; Aggiorna visualizzazione a schermo
 698+ 87E8 CD B8 68         call Gfx_UpdateScoreDisplay
 699+ 87EB
 700+ 87EB E1               pop  hl
 701+ 87EC D1               pop  de
 702+ 87ED C1               pop  bc
 703+ 87EE F1               pop  af
 704+ 87EF C9               ret
 705+ 87F0
 706+ 87F0              ; -------------------------------------------------------------------
 707+ 87F0              ; Score_CheckAndUpdateHighScore
 708+ 87F0              ; Se player_score > high_score, copia player_score in high_score.
 709+ 87F0              ; -------------------------------------------------------------------
 710+ 87F0              Score_CheckAndUpdateHighScore:
 711+ 87F0                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 87F0                  ; Byte 2:
 713+ 87F0 3A F3 F0         ld   a, (player_score + 2)
 714+ 87F3 47               ld   b, a
 715+ 87F4 3A F6 F0         ld   a, (high_score + 2)
 716+ 87F7 B8               cp   b
 717+ 87F8 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 87FA 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 87FC
 720+ 87FC                  ; Byte 1:
 721+ 87FC 3A F2 F0         ld   a, (player_score + 1)
 722+ 87FF 47               ld   b, a
 723+ 8800 3A F5 F0         ld   a, (high_score + 1)
 724+ 8803 B8               cp   b
 725+ 8804 38 0C            jr   c, .new_high_score
 726+ 8806 20 1C            jr   nz, .done_check
 727+ 8808
 728+ 8808                  ; Byte 0:
 729+ 8808 3A F1 F0         ld   a, (player_score + 0)
 730+ 880B 47               ld   b, a
 731+ 880C 3A F4 F0         ld   a, (high_score + 0)
 732+ 880F B8               cp   b
 733+ 8810 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 8812
 735+ 8812              .new_high_score:
 736+ 8812 3A F1 F0         ld   a, (player_score + 0)
 737+ 8815 32 F4 F0         ld   (high_score + 0), a
 738+ 8818 3A F2 F0         ld   a, (player_score + 1)
 739+ 881B 32 F5 F0         ld   (high_score + 1), a
 740+ 881E 3A F3 F0         ld   a, (player_score + 2)
 741+ 8821 32 F6 F0         ld   (high_score + 2), a
 742+ 8824
 743+ 8824              .done_check:
 744+ 8824 C9               ret

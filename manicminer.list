 179+ 8328              ; Audio_PlayCollectSound
 180+ 8328              ;
 181+ 8328              ; Genera un breve effetto sonoro (beep) tramite il buzzer
 182+ 8328              ; dello ZX Spectrum utilizzando il port $FE quando viene raccolto un oggetto.
 183+ 8328              ; -------------------------------------------------------------------
 184+ 8328              Audio_PlayCollectSound:
 185+ 8328 C5               push bc
 186+ 8329 D5               push de
 187+ 832A
 188+ 832A 06 78            ld   b, 120
 189+ 832C              .sound_loop:
 190+ 832C 3A 0C 96         ld   a, (room_border_color)
 191+ 832F F6 10            or   $10               ; speaker ON
 192+ 8331 D3 FE            out  ($fe), a
 193+ 8333
 194+ 8333 0E 3C            ld   c, 60
 195+ 8335              .d1:
 196+ 8335 0D               dec  c
 197+ 8336 20 FD            jr   nz, .d1
 198+ 8338
 199+ 8338 3A 0C 96         ld   a, (room_border_color)
 200+ 833B E6 EF            and  $ef              ; speaker OFF
 201+ 833D D3 FE            out  ($fe), a
 202+ 833F
 203+ 833F 0E 3C            ld   c, 60
 204+ 8341              .d2:
 205+ 8341 0D               dec  c
 206+ 8342 20 FD            jr   nz, .d2
 207+ 8344
 208+ 8344 10 E6            djnz .sound_loop
 209+ 8346
 210+ 8346 D1               pop  de
 211+ 8347 C1               pop  bc
 212+ 8348 C9               ret

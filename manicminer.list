   7+ 8882              ; -------------------------------------------------------------------
   8+ 8882              ; Audio_UpdateJumpSound
   9+ 8882              ;
  10+ 8882              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8882              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8882              ; -------------------------------------------------------------------
  13+ 8882              Audio_UpdateJumpSound:
  14+ 8882 F5               push af
  15+ 8883 C5               push bc
  16+ 8884 D5               push de
  17+ 8885 E5               push hl
  18+ 8886
  19+ 8886                  ; Controlla se il suono è attivo (note < 18)
  20+ 8886 3A 0A F1         ld   a, (Audio_jump_sound_note)
  21+ 8889 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 888B 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 888D
  24+ 888D                  ; Carica la nota corrente da suonare
  25+ 888D 5F               ld   e, a
  26+ 888E 16 00            ld   d, 0
  27+ 8890 21 BC 88         ld   hl, Audio_JumpSoundDelays
  28+ 8893 19               add  hl, de
  29+ 8894 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8895 57               ld   d, a                      ; D = delay della nota
  31+ 8896
  32+ 8896                  ; Suona la nota: 15 cicli
  33+ 8896 06 0F            ld   b, 15
  34+ 8898              .note_loop:
  35+ 8898                  ; Speaker ON
  36+ 8898 3A F6 EA         ld   a, (room_border_color)
  37+ 889B F6 10            or   $10
  38+ 889D D3 FE            out  ($fe), a
  39+ 889F 4A               ld   c, d
  40+ 88A0              .d1:
  41+ 88A0 0D               dec  c
  42+ 88A1 20 FD            jr   nz, .d1
  43+ 88A3
  44+ 88A3                  ; Speaker OFF
  45+ 88A3 3A F6 EA         ld   a, (room_border_color)
  46+ 88A6 E6 EF            and  $ef
  47+ 88A8 D3 FE            out  ($fe), a
  48+ 88AA 4A               ld   c, d
  49+ 88AB              .d2:
  50+ 88AB 0D               dec  c
  51+ 88AC 20 FD            jr   nz, .d2
  52+ 88AE
  53+ 88AE 10 E8            djnz .note_loop
  54+ 88B0
  55+ 88B0                  ; Passa alla nota successiva
  56+ 88B0 3A 0A F1         ld   a, (Audio_jump_sound_note)
  57+ 88B3 3C               inc  a
  58+ 88B4 32 0A F1         ld   (Audio_jump_sound_note), a
  59+ 88B7
  60+ 88B7              .done:
  61+ 88B7 E1               pop  hl
  62+ 88B8 D1               pop  de
  63+ 88B9 C1               pop  bc
  64+ 88BA F1               pop  af
  65+ 88BB C9               ret
  66+ 88BC
  67+ 88BC              Audio_JumpSoundDelays:
  68+ 88BC 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 88C0 19 13 0C 06
  68+ 88C4 0C 13 19 20
  68+ 88C8 26 2D 33 3A
  68+ 88CC 40 47
  69+ 88CE
  70+ 88CE                  IF ENABLE_MUSIC != 0
  71+ 88CE ~            ; -------------------------------------------------------------------
  72+ 88CE ~            ; Audio_UpdateMusic
  73+ 88CE ~            ;
  74+ 88CE ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 88CE ~            ; Viene chiamata a ogni frame.
  76+ 88CE ~            ; -------------------------------------------------------------------
  77+ 88CE ~            Audio_UpdateMusic:
  78+ 88CE ~                push af
  79+ 88CE ~                push bc
  80+ 88CE ~                push de
  81+ 88CE ~                push hl
  82+ 88CE ~
  83+ 88CE ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 88CE ~                ld   a, (Audio_jump_sound_note)
  85+ 88CE ~                cp   18
  86+ 88CE ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 88CE ~
  88+ 88CE ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 88CE ~                ld   a, (Audio_music_frame_counter)
  90+ 88CE ~                dec  a
  91+ 88CE ~                ld   (Audio_music_frame_counter), a
  92+ 88CE ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 88CE ~
  94+ 88CE ~                ; Altrimenti carica la nota successiva
  95+ 88CE ~                ld   a, (Audio_music_note_idx)
  96+ 88CE ~                inc  a
  97+ 88CE ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 88CE ~                jr   c, .no_wrap
  99+ 88CE ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 88CE ~            .no_wrap:
 101+ 88CE ~                ld   (Audio_music_note_idx), a
 102+ 88CE ~
 103+ 88CE ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 88CE ~                ld   e, a
 105+ 88CE ~                ld   d, 0
 106+ 88CE ~                ld   hl, Audio_MusicSheet
 107+ 88CE ~                add  hl, de
 108+ 88CE ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 88CE ~
 110+ 88CE ~                ; Leggi durata (secondo byte)
 111+ 88CE ~                inc  hl
 112+ 88CE ~                ld   a, (hl)
 113+ 88CE ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 88CE ~                jr   nz, .dur_ok
 115+ 88CE ~                ld   a, 1
 116+ 88CE ~            .dur_ok:
 117+ 88CE ~                ld   (Audio_music_frame_counter), a
 118+ 88CE ~
 119+ 88CE ~            .play_current_note:
 120+ 88CE ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 88CE ~                ld   a, (Audio_music_note_idx)
 122+ 88CE ~                ld   e, a
 123+ 88CE ~                ld   d, 0
 124+ 88CE ~                ld   hl, Audio_MusicSheet
 125+ 88CE ~                add  hl, de
 126+ 88CE ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 88CE ~                ld   a, (hl)                  ; A = delay
 128+ 88CE ~                or   a
 129+ 88CE ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 88CE ~
 131+ 88CE ~                ; Suona la nota: 2 cicli
 132+ 88CE ~                ld   d, a                     ; D = delay
 133+ 88CE ~                ld   b, 2                     ; 2 cicli per frame
 134+ 88CE ~            .note_loop:
 135+ 88CE ~                ; Speaker ON
 136+ 88CE ~                ld   a, (room_border_color)
 137+ 88CE ~                or   $10
 138+ 88CE ~                out  ($fe), a
 139+ 88CE ~                ld   c, d
 140+ 88CE ~            .d1:
 141+ 88CE ~                push af
 142+ 88CE ~                pop  af
 143+ 88CE ~                dec  c
 144+ 88CE ~                jr   nz, .d1
 145+ 88CE ~
 146+ 88CE ~                ; Speaker OFF
 147+ 88CE ~                ld   a, (room_border_color)
 148+ 88CE ~                and  $ef
 149+ 88CE ~                out  ($fe), a
 150+ 88CE ~                ld   c, d
 151+ 88CE ~            .d2:
 152+ 88CE ~                push af
 153+ 88CE ~                pop  af
 154+ 88CE ~                dec  c
 155+ 88CE ~                jr   nz, .d2
 156+ 88CE ~
 157+ 88CE ~                djnz .note_loop
 158+ 88CE ~
 159+ 88CE ~            .done:
 160+ 88CE ~                pop  hl
 161+ 88CE ~                pop  de
 162+ 88CE ~                pop  bc
 163+ 88CE ~                pop  af
 164+ 88CE ~                ret
 165+ 88CE ~
 166+ 88CE ~            Audio_MusicSheet:
 167+ 88CE ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 88CE ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 88CE ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 88CE ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 88CE ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 88CE ~                db 90, 10, 107, 20, 68, 65
 173+ 88CE                  ELSE
 174+ 88CE              Audio_UpdateMusic:
 175+ 88CE C9               ret
 176+ 88CF                  ENDIF

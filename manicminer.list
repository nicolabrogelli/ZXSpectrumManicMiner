1121+ 784E                  ; Se la cella è sulla rampa, non considerarla un muro!
1122+ 784E 53               ld   d, e              ; D = Row
1123+ 784F 59               ld   e, c              ; E = Col
1124+ 7850 CD BC 77         call IsCellOnRamp
1125+ 7853 38 09            jr   c, .not_wall
1126+ 7855
1127+ 7855 7A               ld   a, d              ; A = Row
1128+ 7856 4B               ld   c, e              ; C = Col

 513+ 7F33              .h_rev_left:
 514+ 7F33 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 515+ 7F36 DD 77 02         ld   (ix+2), a
 516+ 7F39 3E 01            ld   a, 1

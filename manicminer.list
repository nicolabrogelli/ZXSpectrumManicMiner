   8+ 86C6              ; Audio_UpdateJumpSound
   9+ 86C6              ;
  10+ 86C6              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 86C6              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 86C6              ; -------------------------------------------------------------------
  13+ 86C6              Audio_UpdateJumpSound:
  14+ 86C6 F5               push af
  15+ 86C7 C5               push bc
  16+ 86C8 D5               push de
  17+ 86C9 E5               push hl
  18+ 86CA
  19+ 86CA                  ; Controlla se il suono è attivo (note < 18)
  20+ 86CA 3A 26 E8         ld   a, (Audio_jump_sound_note)
  21+ 86CD FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 86CF 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 86D1
  24+ 86D1                  ; Carica la nota corrente da suonare
  25+ 86D1 5F               ld   e, a
  26+ 86D2 16 00            ld   d, 0
  27+ 86D4 21 00 87         ld   hl, Audio_JumpSoundDelays
  28+ 86D7 19               add  hl, de
  29+ 86D8 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 86D9 57               ld   d, a                      ; D = delay della nota
  31+ 86DA
  32+ 86DA                  ; Suona la nota: 15 cicli
  33+ 86DA 06 0F            ld   b, 15
  34+ 86DC              .note_loop:
  35+ 86DC                  ; Speaker ON
  36+ 86DC 3A 13 E2         ld   a, (room_border_color)
  37+ 86DF F6 10            or   $10
  38+ 86E1 D3 FE            out  ($fe), a
  39+ 86E3 4A               ld   c, d
  40+ 86E4              .d1:
  41+ 86E4 0D               dec  c
  42+ 86E5 20 FD            jr   nz, .d1
  43+ 86E7
  44+ 86E7                  ; Speaker OFF
  45+ 86E7 3A 13 E2         ld   a, (room_border_color)
  46+ 86EA E6 EF            and  $ef
  47+ 86EC D3 FE            out  ($fe), a
  48+ 86EE 4A               ld   c, d
  49+ 86EF              .d2:
  50+ 86EF 0D               dec  c
  51+ 86F0 20 FD            jr   nz, .d2
  52+ 86F2
  53+ 86F2 10 E8            djnz .note_loop
  54+ 86F4
  55+ 86F4                  ; Passa alla nota successiva
  56+ 86F4 3A 26 E8         ld   a, (Audio_jump_sound_note)
  57+ 86F7 3C               inc  a
  58+ 86F8 32 26 E8         ld   (Audio_jump_sound_note), a
  59+ 86FB
  60+ 86FB              .done:
  61+ 86FB E1               pop  hl
  62+ 86FC D1               pop  de
  63+ 86FD C1               pop  bc
  64+ 86FE F1               pop  af
  65+ 86FF C9               ret

  29+ 7CB5              ; Enemy_LoadRoom
  30+ 7CB5              ;
  31+ 7CB5              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7CB5              ; Chiamato quando si entra in una stanza.
  33+ 7CB5              ; -------------------------------------------------------------------
  34+ 7CB5              Enemy_LoadRoom:
  35+ 7CB5 E5               push hl
  36+ 7CB6 D5               push de
  37+ 7CB7 C5               push bc
  38+ 7CB8 DD E5            push ix
  39+ 7CBA
  40+ 7CBA                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CBA 21 5D 7C         ld   hl, ActiveEnemies
  42+ 7CBD 11 5E 7C         ld   de, ActiveEnemies + 1
  43+ 7CC0 36 00            ld   (hl), 0
  44+ 7CC2 01 57 00         ld   bc, 87
  45+ 7CC5 ED B0            ldir
  46+ 7CC7
  47+ 7CC7                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CC7 DD 21 5D 7C      ld   ix, ActiveEnemies
  49+ 7CCB 06 08            ld   b, 8
  50+ 7CCD 11 0B 00         ld   de, 11
  51+ 7CD0              .init_old_pos:
  52+ 7CD0 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7CD4 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CD8 DD 19            add  ix, de
  55+ 7CDA 10 F4            djnz .init_old_pos
  56+ 7CDC
  57+ 7CDC                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CDC DD 21 5D 7C      ld   ix, ActiveEnemies
  59+ 7CE0 2A 5B E3         ld   hl, (room_ptr)
  60+ 7CE3 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7CE6 19               add  hl, de
  62+ 7CE7
  63+ 7CE7 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CE9              .load_h_loop:
  65+ 7CE9 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CEA FE FF            cp   $FF
  67+ 7CEC 28 6D            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CEE B7               or   a
  69+ 7CEF 28 6A            jr   z, .done_h_guardians      ; 0 = terminatore
  70+ 7CF1
  71+ 7CF1                  ; Slot attivo
  72+ 7CF1 DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CF5 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  74+ 7CF8
  75+ 7CF8 23               inc  hl
  76+ 7CF9 4E               ld   c, (hl)                   ; C = AttrAddr Low
  77+ 7CFA 23               inc  hl
  78+ 7CFB 7E               ld   a, (hl)                   ; A = AttrAddr High
  79+ 7CFC
  80+ 7CFC                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  81+ 7CFC E5               push hl
  82+ 7CFD C5               push bc
  83+ 7CFE 67               ld   h, a
  84+ 7CFF 69               ld   l, c
  85+ 7D00 01 00 A4         ld   bc, -23552
  86+ 7D03 09               add  hl, bc                    ; HL = AttrOffset
  87+ 7D04
  88+ 7D04                  ; Col = Offset & 31 -> StartX = Col * 8
  89+ 7D04 7D               ld   a, l
  90+ 7D05 E6 1F            and  31
  91+ 7D07 87               add  a, a
  91+ 7D08 87             add a, a
  91+ 7D09 87             add a, a
  92+ 7D0A DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  93+ 7D0D
  94+ 7D0D                  ; Row = Offset / 32 -> StartY = Row * 8
  95+ 7D0D CB 3C            srl  h
  95+ 7D0F CB 1D          rr l
  96+ 7D11 CB 3C            srl  h
  96+ 7D13 CB 1D          rr l
  97+ 7D15 CB 3C            srl  h
  97+ 7D17 CB 1D          rr l
  98+ 7D19 CB 3C            srl  h
  98+ 7D1B CB 1D          rr l
  99+ 7D1D CB 3C            srl  h
  99+ 7D1F CB 1D          rr l
 100+ 7D21 7D               ld   a, l
 101+ 7D22 87               add  a, a
 101+ 7D23 87             add a, a
 101+ 7D24 87             add a, a
 102+ 7D25 DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 103+ 7D28 C1               pop  bc
 104+ 7D29 E1               pop  hl
 105+ 7D2A
 106+ 7D2A 23               inc  hl
 107+ 7D2B 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 108+ 7D2C DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 109+ 7D30
 110+ 7D30 23               inc  hl
 111+ 7D31 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 112+ 7D32 E6 01            and  1
 113+ 7D34 28 04            jr   z, .h_dir_right
 114+ 7D36 3E 01            ld   a, 1                      ; 1 = Sinistra
 115+ 7D38 18 02            jr   .set_h_dir
 116+ 7D3A              .h_dir_right:
 117+ 7D3A 3E 02            ld   a, 2                      ; 2 = Destra
 118+ 7D3C              .set_h_dir:
 119+ 7D3C DD 77 06         ld   (ix+6), a                 ; Direction
 120+ 7D3F
 121+ 7D3F 23               inc  hl
 122+ 7D40 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7D41 E6 1F            and  31
 124+ 7D43 87               add  a, a
 124+ 7D44 87             add a, a
 124+ 7D45 87             add a, a
 125+ 7D46 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7D49
 127+ 7D49 23               inc  hl
 128+ 7D4A 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7D4B E6 1F            and  31
 130+ 7D4D 87               add  a, a
 130+ 7D4E 87             add a, a
 130+ 7D4F 87             add a, a
 131+ 7D50 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7D53
 133+ 7D53 23               inc  hl                        ; Prossimo guardiano
 134+ 7D54 11 0B 00         ld   de, 11
 135+ 7D57 DD 19            add  ix, de
 136+ 7D59 10 8E            djnz .load_h_loop
 137+ 7D5B
 138+ 7D5B              .done_h_guardians:
 139+ 7D5B                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7D5B 2A 5B E3         ld   hl, (room_ptr)
 141+ 7D5E 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7D61 19               add  hl, de
 143+ 7D62
 144+ 7D62 7E               ld   a, (hl)
 145+ 7D63 FE FF            cp   $FF
 146+ 7D65 28 0A            jr   z, .no_v_guardians
 147+ 7D67 B7               or   a
 148+ 7D68 28 07            jr   z, .no_v_guardians
 149+ 7D6A 3E 01            ld   a, 1
 150+ 7D6C 32 E5 E3         ld   (room_has_v_guardians), a
 151+ 7D6F 18 06            jr   .has_v_guardians
 152+ 7D71
 153+ 7D71              .no_v_guardians:
 154+ 7D71 AF               xor  a
 155+ 7D72 32 E5 E3         ld   (room_has_v_guardians), a
 156+ 7D75 18 49            jr   .done_v_guardians
 157+ 7D77
 158+ 7D77              .has_v_guardians:
 159+ 7D77 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 160+ 7D79              .load_v_loop:
 161+ 7D79 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 162+ 7D7A FE FF            cp   $FF
 163+ 7D7C 28 42            jr   z, .done_v_guardians      ; $FF = terminatore
 164+ 7D7E B7               or   a
 165+ 7D7F 28 3F            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 166+ 7D81
 167+ 7D81                  ; Slot attivo per guardiano verticale
 168+ 7D81 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 169+ 7D85 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 170+ 7D88
 171+ 7D88 23               inc  hl
 172+ 7D89 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 173+ 7D8A E6 03            and  3                         ; Frame 0..3 nella prima metà dei dati grafici
 174+ 7D8C DD 77 01         ld   (ix+1), a                 ; Frame index (0..3)
 175+ 7D8F
 176+ 7D8F 23               inc  hl
 177+ 7D90 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 178+ 7D91 DD 77 03         ld   (ix+3), a                 ; Current Y
 179+ 7D94
 180+ 7D94 23               inc  hl
 181+ 7D95 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 182+ 7D96 E6 1F            and  31
 183+ 7D98 87               add  a, a
 183+ 7D99 87             add a, a
 183+ 7D9A 87             add a, a ; * 8 -> X pixel
 184+ 7D9B DD 77 02         ld   (ix+2), a                 ; Current X
 185+ 7D9E
 186+ 7D9E 23               inc  hl
 187+ 7D9F 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 188+ 7DA0 E6 03            and  3
 189+ 7DA2 20 02            jr   nz, .v_step_ok
 190+ 7DA4 3E 01            ld   a, 1
 191+ 7DA6              .v_step_ok:
 192+ 7DA6 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 193+ 7DA9 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 194+ 7DAB DD 77 06         ld   (ix+6), a
 195+ 7DAE
 196+ 7DAE 23               inc  hl
 197+ 7DAF 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 198+ 7DB0 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 199+ 7DB3
 200+ 7DB3 23               inc  hl
 201+ 7DB4 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 202+ 7DB5 DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 203+ 7DB8
 204+ 7DB8 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 205+ 7DB9 11 0B 00         ld   de, 11
 206+ 7DBC DD 19            add  ix, de
 207+ 7DBE 10 B9            djnz .load_v_loop

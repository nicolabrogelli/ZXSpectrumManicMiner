 355+ 7E21              ; RestoreBackgroundCell
 356+ 7E21              ;
 357+ 7E21              ; Ripristina il tile originale presente nella mappa della stanza.
 358+ 7E21              ; Chiamata quando un item viene raccolto.
 359+ 7E21              ;
 360+ 7E21              ; Input:
 361+ 7E21              ;   B = Row (0..15)
 362+ 7E21              ;   C = Col (0..31)
 363+ 7E21              ; -------------------------------------------------------------------
 364+ 7E21              RestoreBackgroundCell:
 365+ 7E21 FD E5            push iy
 366+ 7E23 C5               push bc
 367+ 7E24 D5               push de
 368+ 7E25 E5               push hl
 369+ 7E26 DD E5            push ix
 370+ 7E28
 371+ 7E28 C5               push bc
 372+ 7E29 FD E1            pop  iy                        ; IYH = Row, IYL = Col
 373+ 7E2B
 374+ 7E2B 78               ld   a, b
 375+ 7E2C CD C3 75         call GetCellFromUnpacked       ; A = tile index (0..7)
 376+ 7E2F
 377+ 7E2F                  ; IX = room_ptr + OFFSET_TILES + A * 9
 378+ 7E2F 6F               ld   l, a
 379+ 7E30 26 00            ld   h, 0
 380+ 7E32 5F               ld   e, a
 381+ 7E33 16 00            ld   d, 0
 382+ 7E35 29               add  hl, hl                    ; *2
 383+ 7E36 29               add  hl, hl                    ; *4
 384+ 7E37 29               add  hl, hl                    ; *8
 385+ 7E38 19               add  hl, de                    ; *9
 386+ 7E39 11 20 02         ld   de, OFFSET_TILES
 387+ 7E3C 19               add  hl, de
 388+ 7E3D ED 5B E5 91      ld   de, (room_ptr)
 389+ 7E41 19               add  hl, de
 390+ 7E42 E5               push hl
 391+ 7E43 DD E1            pop  ix                        ; IX = tile pointer
 392+ 7E45
 393+ 7E45 FD E5            push iy
 394+ 7E47 C1               pop  bc                        ; B = Row, C = Col
 395+ 7E48 CD 70 68         call Gfx_DrawTile
 396+ 7E4B
 397+ 7E4B DD E1            pop  ix
 398+ 7E4D E1               pop  hl
 399+ 7E4E D1               pop  de
 400+ 7E4F C1               pop  bc
 401+ 7E50 FD E1            pop  iy
 402+ 7E52 C9               ret

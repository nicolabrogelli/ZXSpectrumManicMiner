 485+ 7C4A DD 77 03         ld   (ix+3), a
 486+ 7C4D 3E 02            ld   a, 2
 487+ 7C4F DD 77 06         ld   (ix+6), a
 488+ 7C52 C3 72 7C         jp   .next
 489+ 7C55
 490+ 7C55              .vert_down:
 491+ 7C55 DD 7E 03         ld   a, (ix+3)                 ; Current Y
 492+ 7C58 C6 02            add  a, 2
 493+ 7C5A DD BE 05         cp   (ix+5)
 494+ 7C5D 28 08            jr   z, .v_rev_up
 495+ 7C5F 30 06            jr   nc, .v_rev_up
 496+ 7C61 DD 77 03         ld   (ix+3), a
 497+ 7C64 C3 72 7C         jp   .next
 498+ 7C67
 499+ 7C67              .v_rev_up:
 500+ 7C67 DD 7E 05         ld   a, (ix+5)

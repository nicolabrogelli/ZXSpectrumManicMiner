 202+ 7DB3              ; -------------------------------------------------------------------
 203+ 7DB3              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 204+ 7DB3              ; -------------------------------------------------------------------
 205+ 7DB3              CheckEnemyWillyOverlap:
 206+ 7DB3 3A F1 E2         ld   a, (player_drawn_pos+1)
 207+ 7DB6 FE FF            cp   $FF
 208+ 7DB8 C8               ret  z                  ; Se Willy non è disegnato, esci
 209+ 7DB9
 210+ 7DB9                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 211+ 7DB9 3A F0 E2         ld   a, (player_drawn_pos)
 212+ 7DBC E6 F8            and  $F8
 213+ 7DBE 5F               ld   e, a               ; E = WillyX & $F8
 214+ 7DBF 79               ld   a, c
 215+ 7DC0 E6 F8            and  $F8                ; A = EnemyX & $F8
 216+ 7DC2 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 217+ 7DC3 C6 10            add  a, 16
 218+ 7DC5 FE 19            cp   25
 219+ 7DC7 D0               ret  nc                 ; Fuori portata X
 220+ 7DC8
 221+ 7DC8                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 222+ 7DC8 3A F1 E2         ld   a, (player_drawn_pos+1) ; A = WillyY
 223+ 7DCB 90               sub  b                  ; A = WillyY - EnemyY
 224+ 7DCC C6 0F            add  a, 15
 225+ 7DCE FE 1F            cp   31
 226+ 7DD0 D0               ret  nc                 ; Fuori portata Y
 227+ 7DD1
 228+ 7DD1                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 229+ 7DD1 3E 01            ld   a, 1
 230+ 7DD3 32 F6 E2         ld   (willy_needs_redraw), a
 231+ 7DD6 C9               ret

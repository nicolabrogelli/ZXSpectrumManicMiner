 414+ 86D6              ; CheckWillyItemCollision
 415+ 86D6              ;
 416+ 86D6              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 86D6              ; Input:
 418+ 86D6              ;   A = Item Col (0..31)
 419+ 86D6              ;   H = Item Row (0..15)
 420+ 86D6              ; Output:
 421+ 86D6              ;   Carry Set = Collisione
 422+ 86D6              ;   Carry Clear = Nessuna collisione
 423+ 86D6              ; -------------------------------------------------------------------
 424+ 86D6              CheckWillyItemCollision:
 425+ 86D6 C5               push bc
 426+ 86D7 D5               push de
 427+ 86D8 E5               push hl
 428+ 86D9
 429+ 86D9                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 86D9 6F               ld   l, a
 431+ 86DA 87               add  a, a                      ; *2
 432+ 86DB 87               add  a, a                      ; *4
 433+ 86DC 87               add  a, a                      ; *8
 434+ 86DD 5F               ld   e, a                      ; E = ItemLeft
 435+ 86DE C6 07            add  a, 7
 436+ 86E0 57               ld   d, a                      ; D = ItemRight
 437+ 86E1
 438+ 86E1 ED 4B F1 EA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 86E5
 440+ 86E5                  ; WillyLeft <= ItemRight
 441+ 86E5 79               ld   a, c                      ; A = WillyX
 442+ 86E6 BA               cp   d                         ; D = ItemRight
 443+ 86E7 28 04            jr   z, .x_ok
 444+ 86E9 38 02            jr   c, .x_ok
 445+ 86EB 18 31            jr   .no_collision
 446+ 86ED
 447+ 86ED              .x_ok:
 448+ 86ED                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 86ED BB               cp   e                         ; E = ItemLeft
 450+ 86EE 28 0B            jr   z, .y_check
 451+ 86F0 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 86F2
 453+ 86F2                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 86F2 C6 07            add  a, 7
 455+ 86F4 BB               cp   e
 456+ 86F5 28 04            jr   z, .y_check
 457+ 86F7 30 02            jr   nc, .y_check
 458+ 86F9 18 23            jr   .no_collision
 459+ 86FB
 460+ 86FB              .y_check:
 461+ 86FB                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 86FB 7C               ld   a, h                      ; H = Item Row
 463+ 86FC 87               add  a, a                      ; *2
 464+ 86FD 87               add  a, a                      ; *4
 465+ 86FE 87               add  a, a                      ; *8
 466+ 86FF 5F               ld   e, a                      ; E = ItemTop
 467+ 8700 C6 07            add  a, 7
 468+ 8702 57               ld   d, a                      ; D = ItemBottom
 469+ 8703
 470+ 8703                  ; WillyTop <= ItemBottom
 471+ 8703 78               ld   a, b                      ; A = WillyY
 472+ 8704 BA               cp   d                         ; D = ItemBottom
 473+ 8705 28 04            jr   z, .y_ok
 474+ 8707 38 02            jr   c, .y_ok
 475+ 8709 18 13            jr   .no_collision
 476+ 870B
 477+ 870B              .y_ok:
 478+ 870B                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 870B BB               cp   e                         ; E = ItemTop
 480+ 870C 28 0B            jr   z, .collision
 481+ 870E 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 8710
 483+ 8710                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 8710 C6 0F            add  a, 15
 485+ 8712 BB               cp   e
 486+ 8713 28 04            jr   z, .collision

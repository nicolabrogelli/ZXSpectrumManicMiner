1219+ 7606 28 1B            jr   z, .is_crumbling
1220+ 7608 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1221+ 760B 28 1E            jr   z, .is_conveyor
1222+ 760D DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1223+ 7610 28 1D            jr   z, .is_nasty1

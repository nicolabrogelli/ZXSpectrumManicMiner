  12+ 8009              ; DetermineCurrentRoomID
  13+ 8009              ;
  14+ 8009              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 8009              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 8009              ;
  17+ 8009              ; Output:
  18+ 8009              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 8009              ;   (current_room) = A

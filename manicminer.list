1239+ 75A2 18 12            jr   .store_cell
1240+ 75A4              .is_wall:
1241+ 75A4 3E 03            ld   a, 3
1242+ 75A6 18 0E            jr   .store_cell
1243+ 75A8              .is_conveyor:
1244+ 75A8 3E 04            ld   a, 4
1245+ 75AA 18 0A            jr   .store_cell
1246+ 75AC              .is_nasty1:
1247+ 75AC 3E 05            ld   a, 5
1248+ 75AE 18 06            jr   .store_cell
1249+ 75B0              .is_nasty2:

1211+ 75E5 DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1212+ 75E8 28 23            jr   z, .is_bg
1213+ 75EA DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1214+ 75ED 28 29            jr   z, .is_wall
1215+ 75EF DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1216+ 75F2 28 1C            jr   z, .is_floor
1217+ 75F4 DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1218+ 75F7 28 1B            jr   z, .is_crumbling
1219+ 75F9 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1220+ 75FC 28 1E            jr   z, .is_conveyor
1221+ 75FE DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1222+ 7601 28 1D            jr   z, .is_nasty1
1223+ 7603 DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1224+ 7606 28 1C            jr   z, .is_nasty2
1225+ 7608 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1226+ 760B 28 1B            jr   z, .is_extra

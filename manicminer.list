   8+ 7E70              ; Audio_UpdateJumpSound
   9+ 7E70              ;
  10+ 7E70              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 7E70              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 7E70              ; -------------------------------------------------------------------
  13+ 7E70              Audio_UpdateJumpSound:
  14+ 7E70 F5               push af
  15+ 7E71 C5               push bc
  16+ 7E72 D5               push de
  17+ 7E73 E5               push hl
  18+ 7E74
  19+ 7E74                  ; Controlla se il suono è attivo (note < 18)
  20+ 7E74 3A 0C 92         ld   a, (Audio_jump_sound_note)
  21+ 7E77 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 7E79 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 7E7B
  24+ 7E7B                  ; Carica la nota corrente da suonare
  25+ 7E7B 5F               ld   e, a
  26+ 7E7C 16 00            ld   d, 0
  27+ 7E7E 21 AA 7E         ld   hl, Audio_JumpSoundDelays
  28+ 7E81 19               add  hl, de
  29+ 7E82 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 7E83 57               ld   d, a                      ; D = delay della nota
  31+ 7E84
  32+ 7E84                  ; Suona la nota: 15 cicli
  33+ 7E84 06 0F            ld   b, 15
  34+ 7E86              .note_loop:
  35+ 7E86                  ; Speaker ON
  36+ 7E86 3A 05 8E         ld   a, (room_border_color)
  37+ 7E89 F6 10            or   $10
  38+ 7E8B D3 FE            out  ($fe), a
  39+ 7E8D 4A               ld   c, d
  40+ 7E8E              .d1:
  41+ 7E8E 0D               dec  c
  42+ 7E8F 20 FD            jr   nz, .d1
  43+ 7E91
  44+ 7E91                  ; Speaker OFF
  45+ 7E91 3A 05 8E         ld   a, (room_border_color)
  46+ 7E94 E6 EF            and  $ef
  47+ 7E96 D3 FE            out  ($fe), a
  48+ 7E98 4A               ld   c, d
  49+ 7E99              .d2:
  50+ 7E99 0D               dec  c
  51+ 7E9A 20 FD            jr   nz, .d2
  52+ 7E9C
  53+ 7E9C 10 E8            djnz .note_loop
  54+ 7E9E
  55+ 7E9E                  ; Passa alla nota successiva
  56+ 7E9E 3A 0C 92         ld   a, (Audio_jump_sound_note)
  57+ 7EA1 3C               inc  a
  58+ 7EA2 32 0C 92         ld   (Audio_jump_sound_note), a
  59+ 7EA5
  60+ 7EA5              .done:
  61+ 7EA5 E1               pop  hl
  62+ 7EA6 D1               pop  de
  63+ 7EA7 C1               pop  bc
  64+ 7EA8 F1               pop  af
  65+ 7EA9 C9               ret
  66+ 7EAA
  67+ 7EAA              Audio_JumpSoundDelays:
  68+ 7EAA 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 7EAE 19 13 0C 06
  68+ 7EB2 0C 13 19 20
  68+ 7EB6 26 2D 33 3A
  68+ 7EBA 40 47
  69+ 7EBC

1897+ 7BD4 DD 21 E3 E5      ld   ix, crumbling_grid
1898+ 7BD8 01 00 02         ld   bc, 512               ; 512 celle
1899+ 7BDB 16 00            ld   d, 0                  ; D = Row (0..15)
1900+ 7BDD 1E 00            ld   e, 0                  ; E = Col (0..31)
1901+ 7BDF
1902+ 7BDF              .loop:
1903+ 7BDF DD 7E 00         ld   a, (ix+0)             ; A = Stage (0..8)
1904+ 7BE2 B7               or   a
1905+ 7BE3 28 3F            jr   z, .next
1906+ 7BE5
1907+ 7BE5 3C               inc  a                     ; Avanza di 1 stadio
1908+ 7BE6 DD 77 00         ld   (ix+0), a
1909+ 7BE9
1910+ 7BE9 FE 09            cp   9
1911+ 7BEB 30 0C            jr   nc, .finish_crumble
1912+ 7BED
1913+ 7BED                  ; Stadio 1..8: ridisegna la tile nello stadio corrente
1914+ 7BED C5               push bc
1915+ 7BEE D5               push de

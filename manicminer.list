 117+ 7D28 19               add  hl, de
 118+ 7D29
 119+ 7D29              .item_loop:
 120+ 7D29 7E               ld   a, (hl)
 121+ 7D2A FE FF            cp   $FF
 122+ 7D2C 28 09            jr   z, .done                  ; $FF = fine lista item della stanza
 123+ 7D2E 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 7D2F 23               inc  hl                        ; +2 (Attr Address High)
 125+ 7D30 23               inc  hl                        ; +3 (Anim mask)
 126+ 7D31 23               inc  hl                        ; +4 (Collected flag)
 127+ 7D32 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 7D34 23               inc  hl                        ; Avanza al prossimo item
 129+ 7D35 18 F2            jr   .item_loop
 130+ 7D37
 131+ 7D37              .done:

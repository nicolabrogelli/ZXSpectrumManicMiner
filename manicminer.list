 478+ 7F3C              ; Enemy_DrawSingleSlot
 479+ 7F3C              ;
 480+ 7F3C              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 481+ 7F3C              ; La grafica (8 frame da 32 byte) è letta direttamente da
 482+ 7F3C              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F3C              ; -------------------------------------------------------------------
 484+ 7F3C              Enemy_DrawSingleSlot:
 485+ 7F3C C5               push bc
 486+ 7F3D D5               push de
 487+ 7F3E E5               push hl
 488+ 7F3F DD E5            push ix
 489+ 7F41
 490+ 7F41                  ; 1. Salva subito le coordinate X e Y dal record IX
 491+ 7F41 DD 4E 02         ld   c, (ix+2)                 ; C = Current X
 492+ 7F44 DD 46 03         ld   b, (ix+3)                 ; B = Current Y
 493+ 7F47
 494+ 7F47                  ; Controlla se è Kong Beast ($A0)
 495+ 7F47 DD 7E 00         ld   a, (ix+0)
 496+ 7F4A FE A0            cp   $A0
 497+ 7F4C 28 22            jr   z, .kong_frame

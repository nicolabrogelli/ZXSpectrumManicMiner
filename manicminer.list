1919+ 7CA9              ; Phys_CheckCrumblingTrigger
1920+ 7CA9              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1921+ 7CA9              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1922+ 7CA9              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1923+ 7CA9              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1924+ 7CA9              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1925+ 7CA9              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1926+ 7CA9              ; -------------------------------------------------------------------
1927+ 7CA9              Phys_CheckCrumblingTrigger:
1928+ 7CA9 C5               push bc
1929+ 7CAA D5               push de
1930+ 7CAB E5               push hl
1931+ 7CAC
1932+ 7CAC ED 4B B6 EA      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1933+ 7CB0
1934+ 7CB0                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1935+ 7CB0 78               ld   a, b
1936+ 7CB1 C6 10            add  a, 16
1937+ 7CB3 FE 80            cp   128
1938+ 7CB5 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1939+ 7CB7
1940+ 7CB7 CB 3F            srl  a
1940+ 7CB9 CB 3F          srl  a
1940+ 7CBB CB 3F          srl  a   ; A = Row (0..15)
1941+ 7CBD 47               ld   b, a                  ; B = Row
1942+ 7CBE
1943+ 7CBE                  ; Piede sinistro: Col1 = PlayerX / 8
1944+ 7CBE 79               ld   a, c
1945+ 7CBF CB 3F            srl  a
1945+ 7CC1 CB 3F          srl  a
1945+ 7CC3 CB 3F          srl  a   ; A = Col1 (0..31)
1946+ 7CC5 4F               ld   c, a                  ; C = Col1
1947+ 7CC6
1948+ 7CC6                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1949+ 7CC6 78               ld   a, b
1950+ 7CC7 CD DB 79         call GetCellFromUnpacked
1951+ 7CCA FE 02            cp   2
1952+ 7CCC 20 03            jr   nz, .check_col2
1953+ 7CCE
1954+ 7CCE                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1955+ 7CCE CD 04 7D         call .advance_crumble_cell
1956+ 7CD1
1957+ 7CD1              .check_col2:
1958+ 7CD1                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1959+ 7CD1 ED 4B B6 EA      ld   bc, (PlayerPos)
1960+ 7CD5 78               ld   a, b
1961+ 7CD6 C6 10            add  a, 16
1962+ 7CD8 CB 3F            srl  a
1962+ 7CDA CB 3F          srl  a
1962+ 7CDC CB 3F          srl  a
1963+ 7CDE 47               ld   b, a                  ; B = Row
1964+ 7CDF
1965+ 7CDF 79               ld   a, c
1966+ 7CE0 C6 07            add  a, 7
1967+ 7CE2 CB 3F            srl  a
1967+ 7CE4 CB 3F          srl  a
1967+ 7CE6 CB 3F          srl  a   ; A = Col2 (0..31)
1968+ 7CE8 4F               ld   c, a                  ; C = Col2
1969+ 7CE9
1970+ 7CE9                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1971+ 7CE9 3A B6 EA         ld   a, (PlayerPos)        ; A = PlayerX
1972+ 7CEC CB 3F            srl  a
1972+ 7CEE CB 3F          srl  a
1972+ 7CF0 CB 3F          srl  a   ; A = Col1
1973+ 7CF2 B9               cp   c
1974+ 7CF3 28 0B            jr   z, .done_trigger
1975+ 7CF5
1976+ 7CF5 78               ld   a, b
1977+ 7CF6 CD DB 79         call GetCellFromUnpacked
1978+ 7CF9 FE 02            cp   2
1979+ 7CFB 20 03            jr   nz, .done_trigger
1980+ 7CFD
1981+ 7CFD                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
1982+ 7CFD CD 04 7D         call .advance_crumble_cell
1983+ 7D00
1984+ 7D00              .done_trigger:
1985+ 7D00 E1               pop  hl
1986+ 7D01 D1               pop  de
1987+ 7D02 C1               pop  bc
1988+ 7D03 C9               ret
1989+ 7D04
1990+ 7D04              .advance_crumble_cell:
1991+ 7D04                  ; Input: B = Row, C = Col
1992+ 7D04 C5               push bc
1993+ 7D05 D5               push de
1994+ 7D06 E5               push hl
1995+ 7D07
1996+ 7D07                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
1997+ 7D07 68               ld   l, b
1998+ 7D08 26 00            ld   h, 0
1999+ 7D0A 29               add  hl, hl
1999+ 7D0B 29             add hl, hl
1999+ 7D0C 29             add hl, hl
1999+ 7D0D 29             add hl, hl
1999+ 7D0E 29             add hl, hl
2000+ 7D0F 59               ld   e, c
2001+ 7D10 16 00            ld   d, 0
2002+ 7D12 19               add  hl, de
2003+ 7D13 11 C7 EE         ld   de, crumbling_grid
2004+ 7D16 19               add  hl, de
2005+ 7D17
2006+ 7D17                  ; 2. Avanza di 1 stadio
2007+ 7D17 7E               ld   a, (hl)               ; A = Stage (0..8)
2008+ 7D18 FE 08            cp   8
2009+ 7D1A 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
2010+ 7D1C
2011+ 7D1C 3C               inc  a                     ; Avanza di 1 scanline (1..8)
2012+ 7D1D 77               ld   (hl), a
2013+ 7D1E 5F               ld   e, a                  ; E = nuovo Stage (1..8)
2014+ 7D1F
2015+ 7D1F                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
2016+ 7D1F E5               push hl
2017+ 7D20 CD 2A 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2018+ 7D23 E1               pop  hl
2019+ 7D24
2020+ 7D24                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2021+ 7D24 7E               ld   a, (hl)
2022+ 7D25 FE 08            cp   8
2023+ 7D27 38 12            jr   c, .done_advance
2024+ 7D29
2025+ 7D29                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2026+ 7D29 68               ld   l, b                  ; L = Row
2027+ 7D2A 26 00            ld   h, 0
2028+ 7D2C 29               add  hl, hl
2028+ 7D2D 29             add hl, hl
2028+ 7D2E 29             add hl, hl
2028+ 7D2F 29             add hl, hl
2028+ 7D30 29             add hl, hl
2029+ 7D31 59               ld   e, c
2030+ 7D32 16 00            ld   d, 0
2031+ 7D34 19               add  hl, de
2032+ 7D35 11 DC EB         ld   de, unpacked_layout
2033+ 7D38 19               add  hl, de
2034+ 7D39 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2035+ 7D3B
2036+ 7D3B              .done_advance:
2037+ 7D3B E1               pop  hl
2038+ 7D3C D1               pop  de
2039+ 7D3D C1               pop  bc
2040+ 7D3E C9               ret

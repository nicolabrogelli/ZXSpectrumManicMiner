 785  87C8              ; -------------------------------------------------------------------
 786  87C8              ; CheckAllItemsCollected
 787  87C8              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 788  87C8              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 789  87C8              ; -------------------------------------------------------------------
 790  87C8              CheckAllItemsCollected:
 791  87C8 3A E5 C0         ld   a, (game_objective_completed)
 792  87CB B7               or   a
 793  87CC 20 08            jr   nz, .all_collected
 794  87CE 3A 4F BE         ld   a, (num_room_items)
 795  87D1 B7               or   a
 796  87D2 28 02            jr   z, .all_collected
 797  87D4 B7               or   a
 798  87D5 C9               ret
 799  87D6              .all_collected:
 800  87D6 37               scf
 801  87D7 C9               ret
 802  87D8

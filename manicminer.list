# file opened: physics_config.asm
   1+ 5DAD              ;===========================================================================
   2+ 5DAD              ; physics_config.asm
   3+ 5DAD              ;
   4+ 5DAD              ; Configurazioni globali per la fisica del salto e del movimento in Manic Miner.
   5+ 5DAD              ; Tutti i parametri di default della fisica possono essere personalizzati qui.
   6+ 5DAD              ; Possono anche essere sovrascritti via riga di comando con sjasmplus
   7+ 5DAD              ; (es. -DDEFAULT_JUMP_STRENGTH=5 -DDEFAULT_GRAVITY_PRESET=1).
   8+ 5DAD              ;===========================================================================
   9+ 5DAD
  10+ 5DAD              ; --- Forza del Salto di Default (Altezza iniziale) ---
  11+ 5DAD              ; Definisce l'impulso verticale iniziale per il salto quando la stanza non specifica un valore personalizzato.
  12+ 5DAD              ; Valori tipici:
  13+ 5DAD              ;   6 = Salto standard (Manic Miner originale)
  14+ 5DAD              ;   5 = Salto medio/corto
  15+ 5DAD              ;   4 = Salto corto
  16+ 5DAD                  IFNDEF DEFAULT_JUMP_STRENGTH
  17+ 5DAD              DEFAULT_JUMP_STRENGTH EQU 6
  18+ 5DAD                  ENDIF
  19+ 5DAD
  20+ 5DAD              ; Alias per compatibilità con il codice esistente
  21+ 5DAD              JUMP_STRENGTH: EQU DEFAULT_JUMP_STRENGTH
  22+ 5DAD
  23+ 5DAD              ; --- Preset Gravità di Default ---
  24+ 5DAD              ; Definisce il comportamento della gravità per le stanze che non hanno un valore personalizzato.
  25+ 5DAD              ; Presets:
  26+ 5DAD              ;   0 = Gravità 0.5 (leggera)
  27+ 5DAD              ;   1 = Gravità 0.75 (standard MM)
  28+ 5DAD              ;   2 = Gravità 1.0 (pesante)
  29+ 5DAD              ;   3 = Gravità 0.25 (molto leggera)
  30+ 5DAD              ;   4 = Gravità 0.0 (nessuna gravità)
  31+ 5DAD                  IFNDEF DEFAULT_GRAVITY_PRESET
  32+ 5DAD              DEFAULT_GRAVITY_PRESET EQU 1
  33+ 5DAD                  ENDIF
  34+ 5DAD
  35+ 5DAD              ; --- Lunghezza / Ampiezza Parabola Salto Orizzontale (Air Speed Preset) ---
  36+ 5DAD              ; Definisce lo spostamento orizzontale in pixel per frame durante il salto direzionale.
  37+ 5DAD              ; Consente di accorciare o allungare la parabola orizzontale mantenendo l'altezza massima invariata.
  38+ 5DAD              ; Presets:
  39+ 5DAD              ;   0 = Parabola stretta       (1.0 px/frame costante  -> gittata ~16 pixel / 2 blocchi, nella stanza usare $FF / 255)
  40+ 5DAD              ;   1 = Parabola corta         (1.5 px/frame alternato -> gittata ~24 pixel / 3 blocchi)
  41+ 5DAD              ;   2 = Parabola media         (2.0 px/frame costante  -> gittata ~32 pixel / 4 blocchi)
  42+ 5DAD              ;   3 = Parabola standard MM   (2.5 px/frame alternato -> gittata ~40 pixel / 5 blocchi)
  43+ 5DAD              ;   4 = Parabola estesa        (3.0 px/frame costante  -> gittata ~48 pixel / 6 blocchi)
  44+ 5DAD              ; Valore di default globale utilizzato se nella stanza corrente il byte
  45+ 5DAD              ; di configurazione (offset 731, OFFSET_AIR_SPEED) è impostato a 0.
  46+ 5DAD                  IFNDEF DEFAULT_AIR_SPEED_PRESET
  47+ 5DAD              DEFAULT_AIR_SPEED_PRESET EQU 3
  48+ 5DAD                  ENDIF
  49+ 5DAD
  50+ 5DAD              JUMP_AIR_SPEED_PRESET: EQU DEFAULT_AIR_SPEED_PRESET
  51+ 5DAD
  52+ 5DAD              ; --- Velocità Massima di Caduta ---
  53+ 5DAD              ; Limite massimo per la velocità di caduta verso il basso (in pixel/frame)
  54+ 5DAD                  IFNDEF MAX_FALL_SPEED
  55+ 5DAD              MAX_FALL_SPEED EQU 12
  56+ 5DAD                  ENDIF
  57+ 5DAD
  58+ 5DAD              ; --- Gravità Base ---
  59+ 5DAD                  IFNDEF GRAVITY
  60+ 5DAD              GRAVITY EQU 1
  61+ 5DAD                  ENDIF
  62+ 5DAD
  63+ 5DAD              ; --- Tolleranza Hitbox Collisioni Guardiani (Inset Margins) ---
  64+ 5DAD              ; Definisce il margine di rientro in pixel per escludere i bordi trasparenti degli sprite.
  65+ 5DAD              ;   0 = Hitbox rigida originale 8x16 vs 16x16
  66+ 5DAD              ;   1 = Tolleranza leggera (1px per lato)
  67+ 5DAD              ;   2 = Tolleranza consigliata (2px per lato, evita morte su bordi vuoti)
  68+ 5DAD                  IFNDEF COLLISION_INSET_X
  69+ 5DAD              COLLISION_INSET_X EQU 2
  70+ 5DAD                  ENDIF
  71+ 5DAD
  72+ 5DAD                  IFNDEF COLLISION_INSET_Y
  73+ 5DAD              COLLISION_INSET_Y EQU 2
  74+ 5DAD                  ENDIF
  75+ 5DAD
  76+ 5DAD              COLLISION_OFFSET_X:    EQU (7 - (2 * COLLISION_INSET_X))
  77+ 5DAD              COLLISION_THRESHOLD_X: EQU (23 - (4 * COLLISION_INSET_X))
  78+ 5DAD
  79+ 5DAD              COLLISION_OFFSET_Y:    EQU (15 - (2 * COLLISION_INSET_Y))
  80+ 5DAD              COLLISION_THRESHOLD_Y: EQU (31 - (4 * COLLISION_INSET_Y))
  81+ 5DAD
  82+ 5DAD              ; --- Tempo di Sicurezza (Invulnerabilità) al Respawn dopo la Morte --
  83+ 5DAD              ; Numero di frame (50Hz) di invulnerabilità ai guardiani dopo il respawn di Willy.
  84+ 5DAD              ;   0  = Disabilitato (nessuna sicurezza)
  85+ 5DAD              ;  50  = 1 secondo di invulnerabilità (default consigliato)
  86+ 5DAD              ;  75  = 1.5 secondi
  87+ 5DAD              ; 100  = 2 secondi
  88+ 5DAD                  IFNDEF RESPAWN_SAFETY_TIME
  89+ 5DAD              RESPAWN_SAFETY_TIME EQU 0
  90+ 5DAD                  ENDIF
  91+ 5DAD
  92+ 5DAD              ; --- Coyote Time (Tempo Coyote per Salto da Bordo) ---
  93+ 5DAD              ; Numero di frame nei quali Willy può ancora saltare dopo essere scivolato oltre il bordo di una piattaforma.
  94+ 5DAD                  IFNDEF COYOTE_TIME_FRAMES
  95+ 5DAD              COYOTE_TIME_FRAMES EQU 4
  96+ 5DAD                  ENDIF
  97+ 5DAD
  98+ 5DAD              ; --- Buffer Pre-Salto (Jump Buffer) ---
  99+ 5DAD              ; Numero di frame nei quali l'input del salto (tasto Z) viene conservato
 100+ 5DAD              ; se premuto poco prima di toccare terra (evita il tasto "sordo").
 101+ 5DAD                  IFNDEF JUMP_BUFFER_FRAMES
 102+ 5DAD              JUMP_BUFFER_FRAMES EQU 5
 103+ 5DAD                  ENDIF
 104+ 5DAD
 105+ 5DAD              ; --- Pausa all'Apice del Salto Verticale (Vertical Jump Apex Pause) ---
 106+ 5DAD              ; Numero di frame (50Hz, 1 frame = 20ms) nei quali Willy rimane sospeso
 107+ 5DAD              ; all'apice del salto verticale prima che inizi la fase di discesa.
 108+ 5DAD              ;   0 = Nessuna pausa (discesa immediata standard)
 109+ 5DAD              ;   2 = Pausa di 2 frame (40 ms)
 110+ 5DAD              ;   3 = Pausa di 3 frame (60 ms - valore frazionario consigliato)
 111+ 5DAD              ;   5 = Pausa di 5 frame (100 ms)
 112+ 5DAD              ; Valore di default globale utilizzato se nella stanza corrente il byte
 113+ 5DAD              ; di configurazione (offset 628, OFFSET_APEX_PAUSE) è impostato a 0.
 114+ 5DAD                  IFNDEF VERTICAL_JUMP_APEX_PAUSE
 115+ 5DAD              VERTICAL_JUMP_APEX_PAUSE EQU 3
 116+ 5DAD                  ENDIF
 117+ 5DAD
 118+ 5DAD
 119+ 5DAD

 928+ 77C0 47               ld   b, a              ; B = offset
 929+ 77C1
 930+ 77C1                  ; SlopeRow = ramp_row - B
 931+ 77C1 3A 40 E5         ld   a, (ramp_row)
 932+ 77C4 90               sub  b
 933+ 77C5 47               ld   b, a              ; B = SlopeRow

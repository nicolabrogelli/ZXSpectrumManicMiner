 822  8700              ; CheckWillyConveyorCollision
 823  8700              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 824  8700              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 825  8700              ; -------------------------------------------------------------------
 826  8700              CheckWillyConveyorCollision:
 827  8700 C5               push bc
 828  8701 D5               push de
 829  8702 E5               push hl
 830  8703
 831  8703                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 832  8703 CD 61 77         call CheckWillyOnConveyor
 833  8706 38 49            jr   c, .collision_detected
 834  8708
 835  8708                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 836  8708 3A 28 99         ld   a, (conveyor_len)
 837  870B B7               or   a
 838  870C 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 839  870E
 840  870E                  ; B = WillyY, C = WillyX
 841  870E ED 4B 00 96      ld   bc, (PlayerPos)
 842  8712
 843  8712                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 844  8712 3A 29 99         ld   a, (conveyor_row)
 845  8715 87               add  a, a                  ; *2
 846  8716 87               add  a, a                  ; *4
 847  8717 87               add  a, a                  ; *8
 848  8718 5F               ld   e, a                  ; E = ConveyorTop
 849  8719 C6 07            add  a, 7
 850  871B 57               ld   d, a                  ; D = ConveyorBottom
 851  871C
 852  871C                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 853  871C 78               ld   a, b                  ; WillyTop
 854  871D BA               cp   d
 855  871E 28 04            jr   z, .y_overlap
 856  8720 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 857  8722 18 32            jr   .no_conv_collision
 858  8724
 859  8724              .y_overlap:
 860  8724 C6 0F            add  a, 15                 ; WillyBottom
 861  8726 BB               cp   e
 862  8727 28 04            jr   z, .x_check
 863  8729 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 864  872B 18 29            jr   .no_conv_collision
 865  872D
 866  872D              .x_check:
 867  872D                  ; ConveyorLeft = conveyor_col * 8
 868  872D 3A 2A 99         ld   a, (conveyor_col)
 869  8730 87               add  a, a                  ; *2
 870  8731 87               add  a, a                  ; *4
 871  8732 87               add  a, a                  ; *8
 872  8733 5F               ld   e, a                  ; E = ConveyorLeft
 873  8734
 874  8734                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 875  8734 21 28 99         ld   hl, conveyor_len
 876  8737 3A 2A 99         ld   a, (conveyor_col)
 877  873A 86               add  a, (hl)
 878  873B 87               add  a, a                  ; *2
 879  873C 87               add  a, a                  ; *4
 880  873D 87               add  a, a                  ; *8
 881  873E 3D               dec  a                     ; ConveyorRight
 882  873F 57               ld   d, a                  ; D = ConveyorRight
 883  8740
 884  8740                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 885  8740 79               ld   a, c                  ; WillyLeft
 886  8741 BA               cp   d
 887  8742 28 04            jr   z, .x_overlap
 888  8744 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 889  8746 18 0E            jr   .no_conv_collision
 890  8748
 891  8748              .x_overlap:
 892  8748 C6 0F            add  a, 15                 ; WillyRight
 893  874A BB               cp   e
 894  874B 28 04            jr   z, .collision_detected
 895  874D 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 896  874F 18 05            jr   .no_conv_collision

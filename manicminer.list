  52+ 7982 DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7986 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 798A DD 19            add  ix, de
  55+ 798C 10 F4            djnz .init_old_pos
  56+ 798E
  57+ 798E                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 798E DD 21 0F 79      ld   ix, ActiveEnemies
  59+ 7992 2A 27 91         ld   hl, (room_ptr)
  60+ 7995 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7998 19               add  hl, de
  62+ 7999
  63+ 7999 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 799B              .load_h_loop:
  65+ 799B 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 799C FE FF            cp   $FF

 303  84D2                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 304  84D2              .wait_title_enter_release:
 305  84D2 76               halt
 306  84D3 3E BF            ld   a, $bf
 307  84D5 DB FE            in   a, ($fe)
 308  84D7 1F               rra
 309  84D8 30 F8            jr   nc, .wait_title_enter_release
 310  84DA
 311  84DA                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 312  84DA 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 313  84DC              .title_loop:
 314  84DC 76               halt
 315  84DD
 316  84DD                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 317  84DD 0C               inc  c
 318  84DE 79               ld   a, c
 319  84DF CB 3F            srl  a
 320  84E1 CB 3F            srl  a
 321  84E3 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 322  84E5 E6 07            and  7
 323  84E7 5F               ld   e, a
 324  84E8 16 00            ld   d, 0
 325  84EA 21 F5 63         ld   hl, title_color_table
 326  84ED 19               add  hl, de
 327  84EE 7E               ld   a, (hl)               ; A = nuovo colore
 328  84EF 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 329  84F2 06 20            ld   b, 32
 330  84F4              .color_title_loop:
 331  84F4 77               ld   (hl), a
 332  84F5 23               inc  hl
 333  84F6 10 FC            djnz .color_title_loop
 334  84F8
 335  84F8                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 336  84F8 3E BF            ld   a, $bf
 337  84FA DB FE            in   a, ($fe)
 338  84FC 1F               rra
 339  84FD 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 340  84FF
 341  84FF                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 342  84FF              .wait_title_enter_release_after:
 343  84FF 76               halt
 344  8500 3E BF            ld   a, $bf
 345  8502 DB FE            in   a, ($fe)
 346  8504 1F               rra
 347  8505 30 F8            jr   nc, .wait_title_enter_release_after
 348  8507
 349  8507                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 350  8507 AF               xor  a
 351  8508 D3 FE            out  ($fe), a              ; Bordo a nero
 352  850A 21 8D 5C         ld   hl, ATTR_P
 353  850D 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 354  850E CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 355  8511 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 356  8513 3E 07            ld   a, $07
 357  8515 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 358  8518
 359  8518                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 360  8518 CD 8D 87         call ResetFullGameState
 361  851B
 362  851B                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 363  851B C3 8B 83         jp   LoadRoomAndRestart
 364  851E
 365  851E              ; -------------------------------------------------------------------
 366  851E              ; TriggerGameOver
 367  851E              ; Scatena la schermata di Game Over per la stanza corrente.
 368  851E              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 369  851E              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 370  851E              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 371  851E              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 372  851E              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 373  851E              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 374  851E              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 375  851E              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 376  851E              ; -------------------------------------------------------------------
 377  851E              TriggerGameOver:
 378  851E                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 379  851E CD DE 65         call Gfx_DrawGameOverScreen
 380  8521
 381  8521                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti

 316+ 7ED0              ; Enemy_DrawSingleSlot
 317+ 7ED0              ;
 318+ 7ED0              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7ED0              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7ED0              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7ED0              ; -------------------------------------------------------------------
 322+ 7ED0              Enemy_DrawSingleSlot:
 323+ 7ED0 C5               push bc
 324+ 7ED1 D5               push de
 325+ 7ED2 E5               push hl
 326+ 7ED3 DD E5            push ix

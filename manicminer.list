 330+ 6FD9 87               add  a, a                      ; *4
 331+ 6FDA 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6FDB 4F               ld   c, a                      ; C = PlayerX
 333+ 6FDC 42               ld   b, d                      ; B = PlayerY
 334+ 6FDD
 335+ 6FDD                  ; Salva coordinate (C = X, B = Y)

 142+ 8443              ; Items_DrawRoom
 143+ 8443              ;
 144+ 8443              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 8443              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 8443              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 8443              ;
 148+ 8443              ; Record item nella stanza (5 byte):
 149+ 8443              ;   +0 Color / Attributo
 150+ 8443              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 8443              ;   +2 Attr Address High
 152+ 8443              ;   +3 Anim Mask (96)
 153+ 8443              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)

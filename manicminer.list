 482+ 7F22              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 483+ 7F22              ; -------------------------------------------------------------------
 484+ 7F22              Enemy_DrawSingleSlot:
 485+ 7F22 C5               push bc
 486+ 7F23 D5               push de
 487+ 7F24 E5               push hl

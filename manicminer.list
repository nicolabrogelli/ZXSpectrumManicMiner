2463+ 6A9F 06 A8            ld   b, 168            ; B = Y pixel (Row 21 / head)
2464+ 6AA1 CD 98 68         call Gfx_ClearPixelSprite8x8
2465+ 6AA4 06 B0            ld   b, 176            ; B = Y pixel (Row 22 / body)
2466+ 6AA6 CD 98 68         call Gfx_ClearPixelSprite8x8
2467+ 6AA9 D1               pop  de

 353  895E              ; TriggerGameOver
 354  895E              ; Scatena la sequenza originale di Game Over:
 355  895E              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 356  895E              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 357  895E              ;   con suono beeper originale e lampeggio dello schermo.
 358  895E              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 359  895E              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 360  895E              ; -------------------------------------------------------------------
 361  895E              TriggerGameOver:
 362  895E                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 363  895E CD 1C 87         call Score_CheckAndUpdateHighScore
 364  8961
 365  8961                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 366  8961 CD 12 66         call Gfx_DrawGameOverScreen
 367  8964
 368  8964                  ; 3. Ritorna al Title Screen originale
 369  8964 C3 1A 89         jp   ShowTitleScreen
 370  8967
 371  8967              ; -------------------------------------------------------------------
 372  8967              ; TriggerVictory
 373  8967              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 374  8967              ; - Pulisce gli elementi di gioco della stanza.
 375  8967              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 376  8967              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 377  8967              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 378  8967              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 379  8967              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 380  8967              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 381  8967              ; -------------------------------------------------------------------
 382  8967              TriggerVictory:
 383  8967                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 384  8967 CD FD 66         call Gfx_DrawVictoryScreen
 385  896A
 386  896A                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 387  896A              .wait_keys_release:
 388  896A 76               halt
 389  896B                  ; Controlla tasto Y (Porta $DF, bit 4)
 390  896B 01 FE DF         ld   bc, $dffe
 391  896E ED 78            in   a, (c)
 392  8970 CB 67            bit  4, a
 393  8972 28 F6            jr   z, .wait_keys_release
 394  8974
 395  8974                  ; Controlla tasto N (Porta $7F, bit 3)
 396  8974 01 FE 7F         ld   bc, $7ffe
 397  8977 ED 78            in   a, (c)
 398  8979 CB 5F            bit  3, a
 399  897B 28 ED            jr   z, .wait_keys_release
 400  897D
 401  897D                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 402  897D 01 FE BF         ld   bc, $bffe
 403  8980 ED 78            in   a, (c)
 404  8982 CB 47            bit  0, a
 405  8984 28 E4            jr   z, .wait_keys_release
 406  8986
 407  8986                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 408  8986 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 409  8988              .wait_choice_loop:
 410  8988 76               halt
 411  8989
 412  8989                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 413  8989 0C               inc  c
 414  898A 79               ld   a, c
 415  898B CB 3F            srl  a
 416  898D CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 417  898F E6 07            and  7
 418  8991 5F               ld   e, a
 419  8992 16 00            ld   d, 0
 420  8994 21 F4 65         ld   hl, victory_color_table
 421  8997 19               add  hl, de
 422  8998 7E               ld   a, (hl)               ; A = nuovo colore attributo
 423  8999 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 424  899C 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 425  899E              .color_cycle_loop:
 426  899E 77               ld   (hl), a
 427  899F 23               inc  hl
 428  89A0 10 FC            djnz .color_cycle_loop
 429  89A2
 430  89A2                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 431  89A2 01 FE DF         ld   bc, $dffe
 432  89A5 ED 78            in   a, (c)
 433  89A7 CB 67            bit  4, a
 434  89A9 28 2A            jr   z, .play_again_chosen
 435  89AB
 436  89AB                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 437  89AB 01 FE 7F         ld   bc, $7ffe
 438  89AE ED 78            in   a, (c)
 439  89B0 CB 5F            bit  3, a
 440  89B2 28 0B            jr   z, .quit_chosen
 441  89B4
 442  89B4                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 443  89B4 01 FE BF         ld   bc, $bffe
 444  89B7 ED 78            in   a, (c)
 445  89B9 CB 47            bit  0, a
 446  89BB 28 02            jr   z, .quit_chosen
 447  89BD
 448  89BD 18 C9            jr   .wait_choice_loop
 449  89BF
 450  89BF              .quit_chosen:
 451  89BF                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 452  89BF              .wait_quit_release:
 453  89BF 76               halt
 454  89C0 01 FE 7F         ld   bc, $7ffe
 455  89C3 ED 78            in   a, (c)
 456  89C5 CB 5F            bit  3, a
 457  89C7 28 F6            jr   z, .wait_quit_release
 458  89C9 01 FE BF         ld   bc, $bffe
 459  89CC ED 78            in   a, (c)
 460  89CE CB 47            bit  0, a
 461  89D0 28 ED            jr   z, .wait_quit_release
 462  89D2
 463  89D2                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 464  89D2 C3 1A 89         jp   ShowTitleScreen
 465  89D5
 466  89D5              .play_again_chosen:
 467  89D5                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 468  89D5              .wait_play_again_release:
 469  89D5 76               halt
 470  89D6 01 FE DF         ld   bc, $dffe
 471  89D9 ED 78            in   a, (c)
 472  89DB CB 67            bit  4, a
 473  89DD 28 F6            jr   z, .wait_play_again_release
 474  89DF
 475  89DF                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 476  89DF CD 19 8B         call ResetFullGameState
 477  89E2 C3 E1 87         jp   LoadRoomAndRestart
 478  89E5
 479  89E5              ; -------------------------------------------------------------------
 480  89E5              ; CheckPortalTransition
 481  89E5              ; Verifica le condizioni per accedere alla stanza successiva:
 482  89E5              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 483  89E5              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 484  89E5              ;
 485  89E5              ; Output:
 486  89E5              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 487  89E5              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 488  89E5              ; -------------------------------------------------------------------
 489  89E5              CheckPortalTransition:
 490  89E5 C5               push bc
 491  89E6 D5               push de
 492  89E7 E5               push hl
 493  89E8
 494  89E8                  ; 1. Tutti gli item della stanza sono stati raccolti?
 495  89E8 CD AC 8A         call CheckAllItemsCollected
 496  89EB 30 4D            jr   nc, .no_transition
 497  89ED
 498  89ED                  ; 2. Willy collide con il portale (16x16 pixel)?
 499  89ED                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 500  89ED                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 501  89ED 2A 34 ED         ld   hl, (room_ptr)
 502  89F0 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 503  89F3 19               add  hl, de
 504  89F4 4E               ld   c, (hl)
 505  89F5 23               inc  hl
 506  89F6 46               ld   b, (hl)                   ; BC = AttrAddr
 507  89F7
 508  89F7                  ; Offset = BC - 23552
 509  89F7 60               ld   h, b
 510  89F8 69               ld   l, c
 511  89F9 01 00 A4         ld   bc, -23552
 512  89FC 09               add  hl, bc
 513  89FD
 514  89FD                  ; PortalX = (Offset & 31) * 8
 515  89FD 7D               ld   a, l
 516  89FE E6 1F            and  31
 517  8A00 87               add  a, a
 517  8A01 87             add a, a
 517  8A02 87             add a, a
 518  8A03 5F               ld   e, a                      ; E = PortalX (0..248)
 519  8A04
 520  8A04                  ; PortalY = (Offset / 32) * 8
 521  8A04 CB 3C            srl  h
 521  8A06 CB 1D          rr l
 522  8A08 CB 3C            srl  h
 522  8A0A CB 1D          rr l
 523  8A0C CB 3C            srl  h
 523  8A0E CB 1D          rr l
 524  8A10 CB 3C            srl  h
 524  8A12 CB 1D          rr l
 525  8A14 CB 3C            srl  h
 525  8A16 CB 1D          rr l
 526  8A18 7D               ld   a, l
 527  8A19 87               add  a, a
 527  8A1A 87             add a, a
 527  8A1B 87             add a, a
 528  8A1C 57               ld   d, a                      ; D = PortalY (0..120)
 529  8A1D
 530  8A1D                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 531  8A1D ED 4B B3 E9      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 532  8A21
 533  8A21                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 534  8A21 7B               ld   a, e
 535  8A22 91               sub  c
 536  8A23 30 02            jr   nc, .x_diff_pos
 537  8A25 ED 44            neg
 538  8A27              .x_diff_pos:
 539  8A27 FE 0C            cp   12
 540  8A29 30 0F            jr   nc, .no_transition
 541  8A2B
 542  8A2B                  ; Controllo verticale: |WillyY - PortalY| < 14
 543  8A2B 7A               ld   a, d
 544  8A2C 90               sub  b
 545  8A2D 30 02            jr   nc, .y_diff_pos
 546  8A2F ED 44            neg
 547  8A31              .y_diff_pos:
 548  8A31 FE 0E            cp   14
 549  8A33 30 05            jr   nc, .no_transition
 550  8A35
 551  8A35                  ; Transizione al portale attiva!
 552  8A35 E1               pop  hl
 553  8A36 D1               pop  de
 554  8A37 C1               pop  bc
 555  8A38 37               scf
 556  8A39 C9               ret
 557  8A3A
 558  8A3A              .no_transition:
 559  8A3A E1               pop  hl
 560  8A3B D1               pop  de
 561  8A3C C1               pop  bc
 562  8A3D B7               or   a
 563  8A3E C9               ret
 564  8A3F
 565  8A3F              ; Alias per retrocompatibilità
 566  8A3F              CheckVictoryCondition: EQU CheckPortalTransition
 567  8A3F
 568  8A3F              ; -------------------------------------------------------------------
 569  8A3F              ; TriggerPortalTransition
 570  8A3F              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 571  8A3F              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 572  8A3F              ; - Avanza all'indice della stanza successiva.
 573  8A3F              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 574  8A3F              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 575  8A3F              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 576  8A3F              ; -------------------------------------------------------------------
 577  8A3F              TriggerPortalTransition:
 578  8A3F                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 579  8A3F CD 76 8A         call Air_DepleteCountdown
 580  8A42
 581  8A42                  ; 1. Determina l'ID della stanza corrente
 582  8A42 CD 5D 84         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 583  8A45
 584  8A45                  ; 2. Calcola l'indice della stanza successiva
 585  8A45 3A D9 EC         ld   a, (current_room)
 586  8A48 3C               inc  a
 587  8A49 FE 14            cp   NUM_ROOMS
 588  8A4B 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 589  8A4D
 590  8A4D                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 591  8A4D 21 8E 73         ld   hl, RoomsListTable
 592  8A50 5F               ld   e, a
 593  8A51 16 00            ld   d, 0
 594  8A53 19               add  hl, de
 595  8A54 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 596  8A55 5E               ld   e, (hl)
 597  8A56 23               inc  hl
 598  8A57 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 599  8A58 ED 53 34 ED      ld   (room_ptr), de
 600  8A5C
 601  8A5C                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 602  8A5C AF               xor  a
 603  8A5D 32 3A ED         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 604  8A60 32 C1 E9         ld   (velocity_y), a
 605  8A63 32 CC EF         ld   (game_objective_completed), a
 606  8A66 3E 01            ld   a, 1
 607  8A68 32 C2 E9         ld   (on_ground), a
 608  8A6B
 609  8A6B                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 610  8A6B 3E 07            ld   a, $07
 611  8A6D CD 9D 62         call Gfx_ClearScreenDirect
 612  8A70
 613  8A70 C3 E1 87         jp   LoadRoomAndRestart
 614  8A73
 615  8A73              .all_rooms_completed:
 616  8A73                  ; Tutte le stanze sono state completate con successo!
 617  8A73                  IF ENABLE_VICTORY_SCREEN != 0
 618  8A73 C3 67 89         jp   TriggerVictory
 619  8A76                  ELSE
 620  8A76 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 621  8A76 ~                ld   de, (RoomsListTable)
 622  8A76 ~                ld   (room_ptr), de
 623  8A76 ~                xor  a
 624  8A76 ~                ld   (transition_active), a
 625  8A76 ~                ld   (velocity_y), a
 626  8A76 ~                ld   (game_objective_completed), a
 627  8A76 ~                ld   a, 1
 628  8A76 ~                ld   (on_ground), a
 629  8A76 ~                ld   a, $07
 630  8A76 ~                call Gfx_ClearScreenDirect
 631  8A76 ~                jp   LoadRoomAndRestart
 632  8A76                  ENDIF
 633  8A76
 634  8A76              ; -------------------------------------------------------------------
 635  8A76              ; Air_DepleteCountdown
 636  8A76              ; Animazione originale di completamento livello (Manic Miner):
 637  8A76              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 638  8A76              ; - Ad ogni pixel decrementato:
 639  8A76              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 640  8A76              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 641  8A76              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 642  8A76              ; -------------------------------------------------------------------
 643  8A76              Air_DepleteCountdown:
 644  8A76 F5               push af
 645  8A77 C5               push bc
 646  8A78 D5               push de
 647  8A79 E5               push hl
 648  8A7A
 649  8A7A              .countdown_loop:
 650  8A7A 3A D5 EF         ld   a, (air_pixels)
 651  8A7D B7               or   a
 652  8A7E 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 653  8A80
 654  8A80 3D               dec  a
 655  8A81 32 D5 EF         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 656  8A84
 657  8A84                  ; Aggiorna la barra grafica dell'aria
 658  8A84 CD 2D 6A         call Gfx_UpdateAirBar
 659  8A87
 660  8A87                  ; Aggiungi 1 punto allo score
 661  8A87 CD D1 86         call Score_Add1Point
 662  8A8A
 663  8A8A                  ; Genera l'effetto sonoro originale di Manic Miner:
 664  8A8A                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 665  8A8A 3A D5 EF         ld   a, (air_pixels)
 666  8A8D 2F               cpl
 667  8A8E E6 3F            and  63
 668  8A90 07               rlca
 669  8A91 3C               inc  a
 670  8A92 57               ld   d, a                      ; D = ritardo semionda audio
 671  8A93
 672  8A93 0E 03            ld   c, 3                      ; Durata impulso
 673  8A95              .audio_loop:
 674  8A95 AF               xor  a
 675  8A96 D3 FE            out  ($fe), a
 676  8A98 42               ld   b, d
 677  8A99 10 FE        .w1: djnz .w1
 678  8A9B
 679  8A9B 3E 18            ld   a, $18
 680  8A9D D3 FE            out  ($fe), a
 681  8A9F 42               ld   b, d
 682  8AA0 10 FE        .w2: djnz .w2
 683  8AA2
 684  8AA2 0D               dec  c
 685  8AA3 20 F0            jr   nz, .audio_loop
 686  8AA5
 687  8AA5 18 D3            jr   .countdown_loop
 688  8AA7
 689  8AA7              .done_countdown:
 690  8AA7 E1               pop  hl
 691  8AA8 D1               pop  de
 692  8AA9 C1               pop  bc
 693  8AAA F1               pop  af
 694  8AAB C9               ret
 695  8AAC
 696  8AAC              ; -------------------------------------------------------------------
 697  8AAC              ; CheckAllItemsCollected
 698  8AAC              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 699  8AAC              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 700  8AAC              ; -------------------------------------------------------------------
 701  8AAC              CheckAllItemsCollected:
 702  8AAC 3A CC EF         ld   a, (game_objective_completed)
 703  8AAF B7               or   a
 704  8AB0 20 08            jr   nz, .all_collected
 705  8AB2 3A 33 ED         ld   a, (num_room_items)
 706  8AB5 B7               or   a
 707  8AB6 28 02            jr   z, .all_collected
 708  8AB8 B7               or   a
 709  8AB9 C9               ret
 710  8ABA              .all_collected:
 711  8ABA 37               scf
 712  8ABB C9               ret
 713  8ABC
 714  8ABC              ; -------------------------------------------------------------------
 715  8ABC              ; CheckInMasterBedroom (alias per retrocompatibilità)
 716  8ABC              ; -------------------------------------------------------------------
 717  8ABC              CheckInMasterBedroom:
 718  8ABC 37               scf
 719  8ABD C9               ret
 720  8ABE
 721  8ABE              ; -------------------------------------------------------------------
 722  8ABE              ; CheckWillyConveyorCollision
 723  8ABE              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 724  8ABE              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 725  8ABE              ; -------------------------------------------------------------------
 726  8ABE              CheckWillyConveyorCollision:
 727  8ABE C5               push bc
 728  8ABF D5               push de
 729  8AC0 E5               push hl
 730  8AC1
 731  8AC1                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 732  8AC1 CD 7F 77         call CheckWillyOnConveyor
 733  8AC4 38 49            jr   c, .collision_detected
 734  8AC6
 735  8AC6                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 736  8AC6 3A DB EC         ld   a, (conveyor_len)
 737  8AC9 B7               or   a
 738  8ACA 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 739  8ACC
 740  8ACC                  ; B = WillyY, C = WillyX
 741  8ACC ED 4B B3 E9      ld   bc, (PlayerPos)
 742  8AD0
 743  8AD0                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 744  8AD0 3A DC EC         ld   a, (conveyor_row)
 745  8AD3 87               add  a, a                  ; *2
 746  8AD4 87               add  a, a                  ; *4
 747  8AD5 87               add  a, a                  ; *8
 748  8AD6 5F               ld   e, a                  ; E = ConveyorTop
 749  8AD7 C6 07            add  a, 7
 750  8AD9 57               ld   d, a                  ; D = ConveyorBottom
 751  8ADA
 752  8ADA                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 753  8ADA 78               ld   a, b                  ; WillyTop
 754  8ADB BA               cp   d
 755  8ADC 28 04            jr   z, .y_overlap
 756  8ADE 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 757  8AE0 18 32            jr   .no_conv_collision
 758  8AE2
 759  8AE2              .y_overlap:
 760  8AE2 C6 0F            add  a, 15                 ; WillyBottom
 761  8AE4 BB               cp   e
 762  8AE5 28 04            jr   z, .x_check
 763  8AE7 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 764  8AE9 18 29            jr   .no_conv_collision
 765  8AEB
 766  8AEB              .x_check:
 767  8AEB                  ; ConveyorLeft = conveyor_col * 8
 768  8AEB 3A DD EC         ld   a, (conveyor_col)
 769  8AEE 87               add  a, a                  ; *2
 770  8AEF 87               add  a, a                  ; *4
 771  8AF0 87               add  a, a                  ; *8
 772  8AF1 5F               ld   e, a                  ; E = ConveyorLeft
 773  8AF2
 774  8AF2                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 775  8AF2 21 DB EC         ld   hl, conveyor_len
 776  8AF5 3A DD EC         ld   a, (conveyor_col)
 777  8AF8 86               add  a, (hl)
 778  8AF9 87               add  a, a                  ; *2
 779  8AFA 87               add  a, a                  ; *4
 780  8AFB 87               add  a, a                  ; *8
 781  8AFC 3D               dec  a                     ; ConveyorRight
 782  8AFD 57               ld   d, a                  ; D = ConveyorRight
 783  8AFE
 784  8AFE                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 785  8AFE 79               ld   a, c                  ; WillyLeft
 786  8AFF BA               cp   d
 787  8B00 28 04            jr   z, .x_overlap
 788  8B02 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 789  8B04 18 0E            jr   .no_conv_collision
 790  8B06
 791  8B06              .x_overlap:
 792  8B06 C6 0F            add  a, 15                 ; WillyRight
 793  8B08 BB               cp   e
 794  8B09 28 04            jr   z, .collision_detected
 795  8B0B 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 796  8B0D 18 05            jr   .no_conv_collision
 797  8B0F
 798  8B0F              .collision_detected:
 799  8B0F E1               pop  hl
 800  8B10 D1               pop  de
 801  8B11 C1               pop  bc
 802  8B12 37               scf
 803  8B13 C9               ret
 804  8B14
 805  8B14              .no_conv_collision:
 806  8B14 E1               pop  hl
 807  8B15 D1               pop  de
 808  8B16 C1               pop  bc
 809  8B17 B7               or   a
 810  8B18 C9               ret
 811  8B19
 812  8B19              ; -------------------------------------------------------------------
 813  8B19              ; ResetFullGameState
 814  8B19              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 815  8B19              ; per l'avvio di una nuova partita dopo il Game Over.
 816  8B19              ; -------------------------------------------------------------------
 817  8B19              ResetFullGameState:
 818  8B19                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 819  8B19 AF               xor  a
 820  8B1A D3 FE            out  ($fe), a              ; Bordo a nero
 821  8B1C CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 822  8B1F
 823  8B1F                  ; Ripristina il numero di vite iniziali
 824  8B1F 3E 07            ld   a, INITIAL_LIVES
 825  8B21 32 C0 E9         ld   (willy_lives), a
 826  8B24
 827  8B24                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 828  8B24 AF               xor  a
 829  8B25 32 BD E9         ld   (items_collected), a
 830  8B28 32 B9 E9         ld   (body_state), a
 831  8B2B 32 CC E9         ld   (w_warp_state), a

 138+ 7DC5              .done_h_guardians:
 139+ 7DC5                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DC5 2A 82 9D         ld   hl, (room_ptr)
 141+ 7DC8 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DCB 19               add  hl, de
 143+ 7DCC 7E               ld   a, (hl)
 144+ 7DCD FE FF            cp   $FF
 145+ 7DCF 28 0A            jr   z, .done_v_guardians
 146+ 7DD1 B7               or   a
 147+ 7DD2 28 07            jr   z, .done_v_guardians
 148+ 7DD4
 149+ 7DD4                  ; Slot attivo per guardiano verticale
 150+ 7DD4 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DD8 DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DDB                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DDB
 154+ 7DDB              .done_v_guardians:
 155+ 7DDB DD E1            pop  ix
 156+ 7DDD C1               pop  bc
 157+ 7DDE D1               pop  de
 158+ 7DDF E1               pop  hl
 159+ 7DE0 C9               ret
 160+ 7DE1
 161+ 7DE1              ; -------------------------------------------------------------------
 162+ 7DE1              ; Controlla se la posizione (C = X, B = Y) del nemico si sovrappone a Willy
 163+ 7DE1              ; -------------------------------------------------------------------
 164+ 7DE1              CheckEnemyWillyOverlap:
 165+ 7DE1 3A 08 9E         ld   a, (player_drawn_pos+1)
 166+ 7DE4 FE FF            cp   $FF
 167+ 7DE6 C8               ret  z                  ; Se Willy non è disegnato, esci
 168+ 7DE7
 169+ 7DE7                  ; 1. Controllo X: (EnemyX & $F8) - (WillyX & $F8) + 16 <= 24
 170+ 7DE7 3A 07 9E         ld   a, (player_drawn_pos)
 171+ 7DEA E6 F8            and  $F8
 172+ 7DEC 5F               ld   e, a               ; E = WillyX & $F8
 173+ 7DED 79               ld   a, c
 174+ 7DEE E6 F8            and  $F8                ; A = EnemyX & $F8
 175+ 7DF0 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 176+ 7DF1 C6 10            add  a, 16
 177+ 7DF3 FE 19            cp   25
 178+ 7DF5 D0               ret  nc                 ; Fuori portata X
 179+ 7DF6
 180+ 7DF6                  ; 2. Controllo Y: WillyY - EnemyY + 15 <= 30
 181+ 7DF6 3A 08 9E         ld   a, (player_drawn_pos+1) ; A = WillyY
 182+ 7DF9 90               sub  b                  ; A = WillyY - EnemyY
 183+ 7DFA C6 0F            add  a, 15
 184+ 7DFC FE 1F            cp   31
 185+ 7DFE D0               ret  nc                 ; Fuori portata Y
 186+ 7DFF
 187+ 7DFF                  ; Sovrapposizione confermata! Segnala che Willy deve essere ridisegnato
 188+ 7DFF 3E 01            ld   a, 1
 189+ 7E01 32 0D 9E         ld   (willy_needs_redraw), a
 190+ 7E04 C9               ret
 191+ 7E05
 192+ 7E05              ; -------------------------------------------------------------------
 193+ 7E05              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 194+ 7E05              ; -------------------------------------------------------------------
 195+ 7E05              Enemy_EraseRoom:
 196+ 7E05              Enemy_DrawRoom:
 197+ 7E05              Enemy_RenderRoom:
 198+ 7E05 E5               push hl
 199+ 7E06 D5               push de
 200+ 7E07 C5               push bc
 201+ 7E08 DD E5            push ix
 202+ 7E0A
 203+ 7E0A                  ; ---------------------------------------------------------------
 204+ 7E0A                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 205+ 7E0A                  ; ---------------------------------------------------------------
 206+ 7E0A DD 21 C7 7C      ld   ix, ActiveEnemies
 207+ 7E0E 06 08            ld   b, 8              ; 8 slot
 208+ 7E10              .erase_loop:
 209+ 7E10 DD 7E 00         ld   a, (ix+0)         ; Flags
 210+ 7E13 E6 80            and  $80               ; Active?
 211+ 7E15 28 3A            jr   z, .next_erase
 212+ 7E17
 213+ 7E17                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 214+ 7E17 DD 7E 08         ld   a, (ix+8)         ; Old X
 215+ 7E1A FE FF            cp   $FF
 216+ 7E1C 28 33            jr   z, .next_erase
 217+ 7E1E
 218+ 7E1E                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 219+ 7E1E DD 7E 08         ld   a, (ix+8)         ; Old X
 220+ 7E21 DD BE 02         cp   (ix+2)            ; Current X
 221+ 7E24 20 0E            jr   nz, .do_erase_slot
 222+ 7E26 DD 7E 09         ld   a, (ix+9)         ; Old Y
 223+ 7E29 DD BE 03         cp   (ix+3)            ; Current Y
 224+ 7E2C 20 06            jr   nz, .do_erase_slot
 225+ 7E2E
 226+ 7E2E 3A 0B 9E         ld   a, (enemy_was_updated)
 227+ 7E31 B7               or   a
 228+ 7E32 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 229+ 7E34
 230+ 7E34              .do_erase_slot:
 231+ 7E34 C5               push bc                ; Salva contatore ciclo
 232+ 7E35
 233+ 7E35                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 234+ 7E35 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 235+ 7E38 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 236+ 7E3B CD E1 7D         call CheckEnemyWillyOverlap
 237+ 7E3E
 238+ 7E3E                  ; Cancella il nemico nella VECCHIA posizione
 239+ 7E3E DD 4E 08         ld   c, (ix+8)         ; C = Old X
 240+ 7E41 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 241+ 7E44 CD E2 5F         call Gfx_ErasePixelSprite16x16
 242+ 7E47 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 243+ 7E4A DD 46 09         ld   b, (ix+9)         ; B = Old Y
 244+ 7E4D CD BE 6D         call Gfx_RestoreEnemyColorAttributes
 245+ 7E50
 246+ 7E50 C1               pop  bc
 247+ 7E51
 248+ 7E51              .next_erase:
 249+ 7E51 11 0B 00         ld   de, 11
 250+ 7E54 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 251+ 7E56 05               dec  b
 252+ 7E57 20 B7            jr   nz, .erase_loop
 253+ 7E59
 254+ 7E59                  ; ---------------------------------------------------------------
 255+ 7E59                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 256+ 7E59                  ; ---------------------------------------------------------------
 257+ 7E59 DD 21 C7 7C      ld   ix, ActiveEnemies
 258+ 7E5D 06 08            ld   b, 8              ; 8 slot
 259+ 7E5F              .draw_loop:
 260+ 7E5F DD 7E 00         ld   a, (ix+0)         ; Flags
 261+ 7E62 E6 80            and  $80               ; Active?
 262+ 7E64 28 37            jr   z, .next_draw
 263+ 7E66
 264+ 7E66                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E66 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E69 FE FF            cp   $FF
 267+ 7E6B 28 16            jr   z, .do_draw_slot
 268+ 7E6D
 269+ 7E6D                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E6D DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E70 DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E73 20 0E            jr   nz, .do_draw_slot
 273+ 7E75 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E78 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E7B 20 06            jr   nz, .do_draw_slot
 276+ 7E7D
 277+ 7E7D 3A 0B 9E         ld   a, (enemy_was_updated)
 278+ 7E80 B7               or   a
 279+ 7E81 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 280+ 7E83
 281+ 7E83              .do_draw_slot:
 282+ 7E83 C5               push bc                ; Salva contatore ciclo
 283+ 7E84
 284+ 7E84                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 285+ 7E84 CD AF 7E         call Enemy_DrawSingleSlot
 286+ 7E87
 287+ 7E87                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy

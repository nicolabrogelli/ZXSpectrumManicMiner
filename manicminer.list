 175+ 7D8E FE FF            cp   $FF
 176+ 7D90 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 177+ 7D92 B7               or   a
 178+ 7D93 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 179+ 7D95
 180+ 7D95                  ; Slot attivo per guardiano verticale

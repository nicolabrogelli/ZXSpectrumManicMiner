 717+ 8763 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 8765 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 8767
 720+ 8767                  ; Byte 1:
 721+ 8767 3A 5D F0         ld   a, (player_score + 1)
 722+ 876A 47               ld   b, a
 723+ 876B 3A 60 F0         ld   a, (high_score + 1)
 724+ 876E B8               cp   b
 725+ 876F 38 0C            jr   c, .new_high_score
 726+ 8771 20 1C            jr   nz, .done_check
 727+ 8773
 728+ 8773                  ; Byte 0:
 729+ 8773 3A 5C F0         ld   a, (player_score + 0)
 730+ 8776 47               ld   b, a
 731+ 8777 3A 5F F0         ld   a, (high_score + 0)
 732+ 877A B8               cp   b
 733+ 877B 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

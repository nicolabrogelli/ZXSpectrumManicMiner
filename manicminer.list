 517+ 7EAD              ; -------------------------------------------------------------------
 518+ 7EAD              ; CheckCollision
 519+ 7EAD              ;
 520+ 7EAD              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7EAD              ; Output:
 522+ 7EAD              ;   Carry Set = Collisione con guardiano
 523+ 7EAD              ;   Carry Clear = Nessuna collisione
 524+ 7EAD              ; -------------------------------------------------------------------
 525+ 7EAD              CheckCollision:
 526+ 7EAD DD E5            push ix
 527+ 7EAF C5               push bc
 528+ 7EB0 D5               push de
 529+ 7EB1 E5               push hl
 530+ 7EB2
 531+ 7EB2                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7EB2 3A E1 98         ld   a, (willy_safety_timer)
 533+ 7EB5 B7               or   a
 534+ 7EB6 20 3B            jr   nz, .no_collision_found
 535+ 7EB8
 536+ 7EB8 DD 21 A5 7B      ld   ix, ActiveEnemies
 537+ 7EBC 06 08            ld   b, 8                      ; 8 slot
 538+ 7EBE
 539+ 7EBE              .collision_loop:
 540+ 7EBE DD 7E 00         ld   a, (ix+0)
 541+ 7EC1 E6 80            and  $80                       ; Active?
 542+ 7EC3 28 26            jr   z, .next_enemy
 543+ 7EC5
 544+ 7EC5 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7EC6
 546+ 7EC6                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7EC6 ED 4B D7 94      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7ECA DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7ECD
 550+ 7ECD                  ; Calcola differenza X
 551+ 7ECD 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7ECE 30 02            jr   nc, .x_diff_pos
 553+ 7ED0 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7ED2              .x_diff_pos:
 555+ 7ED2 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7ED4 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7ED6
 558+ 7ED6                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7ED6 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7ED9 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7EDA 30 02            jr   nc, .y_diff_pos
 562+ 7EDC ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7EDE              .y_diff_pos:
 564+ 7EDE FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 7EE0 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 7EE2
 567+ 7EE2                  ; Collisione trovata!
 568+ 7EE2 C1               pop  bc                        ; Ripristina stack
 569+ 7EE3 E1               pop  hl
 570+ 7EE4 D1               pop  de
 571+ 7EE5 C1               pop  bc
 572+ 7EE6 DD E1            pop  ix
 573+ 7EE8 37               scf
 574+ 7EE9 C9               ret
 575+ 7EEA
 576+ 7EEA              .no_x_hit:
 577+ 7EEA C1               pop  bc                        ; Ripristina B (contatore ciclo)
 578+ 7EEB
 579+ 7EEB              .next_enemy:
 580+ 7EEB 11 0B 00         ld   de, 11
 581+ 7EEE DD 19            add  ix, de
 582+ 7EF0 05               dec  b
 583+ 7EF1 20 CB            jr   nz, .collision_loop
 584+ 7EF3
 585+ 7EF3              .no_collision_found:
 586+ 7EF3 E1               pop  hl
 587+ 7EF4 D1               pop  de
 588+ 7EF5 C1               pop  bc
 589+ 7EF6 DD E1            pop  ix
 590+ 7EF8 B7               or   a
 591+ 7EF9 C9               ret

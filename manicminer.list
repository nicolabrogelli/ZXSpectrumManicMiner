1943+ 7CD1              ; Phys_CheckCrumblingTrigger
1944+ 7CD1              ; Controlla se Willy è sopra una tile Crumbling Floor (Tile 2) e fa avanzare
1945+ 7CD1              ; lo sgretolamento di 1 pixel (traslazione verso il basso) per ciascuna cella calpestata.
1946+ 7CD1              ; Nel gioco originale Manic Miner (routine 35515 e 35770):
1947+ 7CD1              ; - Lo sgretolamento avanza di 1 scanline per ogni frame in cui Willy tocca il blocco.
1948+ 7CD1              ; - Se Willy si allontana, il blocco si ferma allo stadio raggiunto.
1949+ 7CD1              ; - Quando raggiunge 8 scanline sgretolate, il blocco scompare (Background) e Willy precipita.
1950+ 7CD1              ; -------------------------------------------------------------------
1951+ 7CD1              Phys_CheckCrumblingTrigger:
1952+ 7CD1 C5               push bc
1953+ 7CD2 D5               push de
1954+ 7CD3 E5               push hl
1955+ 7CD4
1956+ 7CD4 ED 4B DE EA      ld   bc, (PlayerPos)       ; C = PlayerX, B = PlayerY
1957+ 7CD8
1958+ 7CD8                  ; I piedi di Willy toccano la superficie della cella sottostante (Y + 16)
1959+ 7CD8 78               ld   a, b
1960+ 7CD9 C6 10            add  a, 16
1961+ 7CDB FE 80            cp   128
1962+ 7CDD 30 49            jr   nc, .done_trigger     ; Fuori dallo schermo
1963+ 7CDF
1964+ 7CDF CB 3F            srl  a
1964+ 7CE1 CB 3F          srl  a
1964+ 7CE3 CB 3F          srl  a   ; A = Row (0..15)
1965+ 7CE5 47               ld   b, a                  ; B = Row
1966+ 7CE6
1967+ 7CE6                  ; Piede sinistro: Col1 = PlayerX / 8
1968+ 7CE6 79               ld   a, c
1969+ 7CE7 CB 3F            srl  a
1969+ 7CE9 CB 3F          srl  a
1969+ 7CEB CB 3F          srl  a   ; A = Col1 (0..31)
1970+ 7CED 4F               ld   c, a                  ; C = Col1
1971+ 7CEE
1972+ 7CEE                  ; Controlla se (Row B, Col1 C) è Crumbling Floor (Tile 2)
1973+ 7CEE 78               ld   a, b
1974+ 7CEF CD 03 7A         call GetCellFromUnpacked
1975+ 7CF2 FE 02            cp   2
1976+ 7CF4 20 03            jr   nz, .check_col2
1977+ 7CF6
1978+ 7CF6                  ; Fa avanzare lo sgretolamento di 1 scanline per Col1
1979+ 7CF6 CD 2C 7D         call .advance_crumble_cell
1980+ 7CF9
1981+ 7CF9              .check_col2:
1982+ 7CF9                  ; Piede destro: Col2 = (PlayerX + 7) / 8
1983+ 7CF9 ED 4B DE EA      ld   bc, (PlayerPos)
1984+ 7CFD 78               ld   a, b
1985+ 7CFE C6 10            add  a, 16
1986+ 7D00 CB 3F            srl  a
1986+ 7D02 CB 3F          srl  a
1986+ 7D04 CB 3F          srl  a
1987+ 7D06 47               ld   b, a                  ; B = Row
1988+ 7D07
1989+ 7D07 79               ld   a, c
1990+ 7D08 C6 07            add  a, 7
1991+ 7D0A CB 3F            srl  a
1991+ 7D0C CB 3F          srl  a
1991+ 7D0E CB 3F          srl  a   ; A = Col2 (0..31)
1992+ 7D10 4F               ld   c, a                  ; C = Col2
1993+ 7D11
1994+ 7D11                  ; Se Col2 == Col1, la cella è la stessa ed è già stata avanzata in questo frame
1995+ 7D11 3A DE EA         ld   a, (PlayerPos)        ; A = PlayerX
1996+ 7D14 CB 3F            srl  a
1996+ 7D16 CB 3F          srl  a
1996+ 7D18 CB 3F          srl  a   ; A = Col1
1997+ 7D1A B9               cp   c
1998+ 7D1B 28 0B            jr   z, .done_trigger
1999+ 7D1D
2000+ 7D1D 78               ld   a, b
2001+ 7D1E CD 03 7A         call GetCellFromUnpacked
2002+ 7D21 FE 02            cp   2
2003+ 7D23 20 03            jr   nz, .done_trigger
2004+ 7D25
2005+ 7D25                  ; Fa avanzare lo sgretolamento di 1 scanline per Col2
2006+ 7D25 CD 2C 7D         call .advance_crumble_cell
2007+ 7D28
2008+ 7D28              .done_trigger:
2009+ 7D28 E1               pop  hl
2010+ 7D29 D1               pop  de
2011+ 7D2A C1               pop  bc
2012+ 7D2B C9               ret
2013+ 7D2C
2014+ 7D2C              .advance_crumble_cell:
2015+ 7D2C                  ; Input: B = Row, C = Col
2016+ 7D2C C5               push bc
2017+ 7D2D D5               push de
2018+ 7D2E E5               push hl
2019+ 7D2F
2020+ 7D2F                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2021+ 7D2F 68               ld   l, b
2022+ 7D30 26 00            ld   h, 0
2023+ 7D32 29               add  hl, hl
2023+ 7D33 29             add hl, hl
2023+ 7D34 29             add hl, hl
2023+ 7D35 29             add hl, hl
2023+ 7D36 29             add hl, hl
2024+ 7D37 59               ld   e, c
2025+ 7D38 16 00            ld   d, 0
2026+ 7D3A 19               add  hl, de
2027+ 7D3B 11 EF EE         ld   de, crumbling_grid
2028+ 7D3E 19               add  hl, de
2029+ 7D3F
2030+ 7D3F                  ; 2. Avanza di 1 stadio
2031+ 7D3F 7E               ld   a, (hl)               ; A = Stage (0..8)
2032+ 7D40 FE 08            cp   8
2033+ 7D42 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
2034+ 7D44
2035+ 7D44 3C               inc  a                     ; Avanza di 1 scanline (1..8)
2036+ 7D45 77               ld   (hl), a
2037+ 7D46 5F               ld   e, a                  ; E = nuovo Stage (1..8)
2038+ 7D47
2039+ 7D47                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
2040+ 7D47 E5               push hl
2041+ 7D48 CD 2A 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2042+ 7D4B E1               pop  hl
2043+ 7D4C
2044+ 7D4C                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2045+ 7D4C 7E               ld   a, (hl)
2046+ 7D4D FE 08            cp   8
2047+ 7D4F 38 12            jr   c, .done_advance
2048+ 7D51
2049+ 7D51                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2050+ 7D51 68               ld   l, b                  ; L = Row
2051+ 7D52 26 00            ld   h, 0
2052+ 7D54 29               add  hl, hl
2052+ 7D55 29             add hl, hl
2052+ 7D56 29             add hl, hl
2052+ 7D57 29             add hl, hl
2052+ 7D58 29             add hl, hl
2053+ 7D59 59               ld   e, c
2054+ 7D5A 16 00            ld   d, 0
2055+ 7D5C 19               add  hl, de
2056+ 7D5D 11 04 EC         ld   de, unpacked_layout
2057+ 7D60 19               add  hl, de
2058+ 7D61 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2059+ 7D63
2060+ 7D63              .done_advance:
2061+ 7D63 E1               pop  hl
2062+ 7D64 D1               pop  de
2063+ 7D65 C1               pop  bc
2064+ 7D66 C9               ret

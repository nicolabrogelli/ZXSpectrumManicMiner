 185+ 7D97 DD 77 03         ld   (ix+3), a                 ; Current Y
 186+ 7D9A
 187+ 7D9A 23               inc  hl
 188+ 7D9B 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 189+ 7D9C E6 1F            and  31
 190+ 7D9E 87               add  a, a

 707+ 871C              ; Score_CheckAndUpdateHighScore
 708+ 871C              ; Se player_score > high_score, copia player_score in high_score.
 709+ 871C              ; -------------------------------------------------------------------
 710+ 871C              Score_CheckAndUpdateHighScore:
 711+ 871C                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 871C                  ; Byte 2:
 713+ 871C 3A C8 EF         ld   a, (player_score + 2)
 714+ 871F 47               ld   b, a
 715+ 8720 3A CB EF         ld   a, (high_score + 2)

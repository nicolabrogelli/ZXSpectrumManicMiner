 409+ 7DC0 87               add  a, a                      ; *2
 410+ 7DC1 87               add  a, a                      ; *4
 411+ 7DC2 87               add  a, a                      ; *8
 412+ 7DC3 5F               ld   e, a                      ; ItemTop
 413+ 7DC4 C6 07            add  a, 7
 414+ 7DC6 57               ld   d, a                      ; ItemBottom
 415+ 7DC7
 416+ 7DC7                  ; WillyTop <= ItemBottom

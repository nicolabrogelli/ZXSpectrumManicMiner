 122+ 80AC 28 09            jr   z, .done                  ; $FF = fine lista item della stanza
 123+ 80AE 23               inc  hl                        ; +1 (Attr Address Low)
 124+ 80AF 23               inc  hl                        ; +2 (Attr Address High)
 125+ 80B0 23               inc  hl                        ; +3 (Anim mask)
 126+ 80B1 23               inc  hl                        ; +4 (Collected flag)
 127+ 80B2 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
 128+ 80B4 23               inc  hl                        ; Avanza al prossimo item
 129+ 80B5 18 F2            jr   .item_loop

 799+ 80D6 18 14            jr   .test_willy_line
 800+ 80D8
 801+ 80D8              .shift_dx_gt_8:
 802+ 80D8                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 803+ 80D8 D6 08            sub  8
 804+ 80DA 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 805+ 80DB              .shift_left_e_only:
 806+ 80DB CB 23            sla  e
 807+ 80DD 0D               dec  c
 808+ 80DE 20 FB            jr   nz, .shift_left_e_only
 809+ 80E0 7B               ld   a, e                      ; A = fetta guardiano allineata
 810+ 80E1 18 09            jr   .test_willy_line
 811+ 80E3
 812+ 80E3              .shift_neg_dx:
 813+ 80E3                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 814+ 80E3 ED 44            neg
 815+ 80E5 4F               ld   c, a                      ; C = -DeltaX (1..7)
 816+ 80E6              .shift_right_d_only:
 817+ 80E6 CB 3A            srl  d
 818+ 80E8 0D               dec  c
 819+ 80E9 20 FB            jr   nz, .shift_right_d_only
 820+ 80EB 7A               ld   a, d                      ; A = fetta guardiano allineata
 821+ 80EC
 822+ 80EC              .test_willy_line:
 823+ 80EC                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 824+ 80EC B7               or   a
 825+ 80ED 28 21            jr   z, .next_scanline
 826+ 80EF
 827+ 80EF                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 828+ 80EF 4F               ld   c, a                      ; C = fetta guardiano
 829+ 80F0 3A 34 E5         ld   a, (row_willy_cur)
 830+ 80F3 FE 08            cp   8
 831+ 80F5 38 0D            jr   c, .read_willy_head
 832+ 80F7

   6+ 7016              ; -------------------------------------------------------------------
   7+ 7016              ; Input_CheckCtrl
   8+ 7016              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 7016              ;
  10+ 7016              ; Output:
  11+ 7016              ;   D = bitmask tasti attivi:
  12+ 7016              ;       bit 0 → sinistra (O)
  13+ 7016              ;       bit 1 → destra   (P)
  14+ 7016              ;       bit 2 → salto    (Z)
  15+ 7016              ;
  16+ 7016              ; Effetti collaterali in RAM:
  17+ 7016              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 7016              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 7016              ;   (jump_prev)     → debounce tasto salto
  20+ 7016              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)
  21+ 7016              ;   (flags)         → bit 0 impostato se movimento rilevato
  22+ 7016              ; -------------------------------------------------------------------
  23+ 7016
  24+ 7016              Input_CheckCtrl:
  25+ 7016 AF               xor  a
  26+ 7017 32 18 9A         ld   (current_input_dir), a
  27+ 701A
  28+ 701A                  IF ENABLE_ROOM_SKIP_KEYS != 0
  29+ 701A                  ; ── Sezione 1a: tasto Q (cambio stanza AVANTI) ─────────────────────
  30+ 701A                  ;
  31+ 701A                  ; Porta $FB → riga Q, W, E, R, T. Bit 0 = Q.
  32+ 701A                  ; Se bit 0 = 0, Q è premuto.
  33+ 701A
  34+ 701A 01 FE FB         ld   bc, $fbfe
  35+ 701D ED 78            in   a, (c)
  36+ 701F CB 47            bit  0, a
  37+ 7021 20 0F            jr   nz, .q_not_pressed     ; bit 0 = 1 → Q non premuto, salta
  38+ 7023
  39+ 7023                  ; Q è premuto: debounce tramite (q_prev).
  40+ 7023                  ; Se (q_prev) ≠ 0 il tasto era già giù nel frame precedente → ignora.
  41+ 7023 3A 19 9A         ld   a, (q_prev)
  42+ 7026 B7               or   a
  43+ 7027 20 0D            jr   nz, .q_handled         ; era già premuto, niente da fare
  44+ 7029
  45+ 7029                  ; ── Primo frame di pressione di Q ──
  46+ 7029 3E 01            ld   a, 1
  47+ 702B 32 19 9A         ld   (q_prev), a            ; marca "Q era premuto"
  48+ 702E
  49+ 702E                  ; NOTA sullo stack:
  50+ 702E                  ; Input_CheckCtrl è stata invocata con CALL, quindi l'indirizzo di ritorno
  51+ 702E                  ; è in cima allo stack. Vogliamo saltare a PerformRoomChangeNext senza
  52+ 702E                  ; tornare al chiamante, quindi POP HL scarta quell'indirizzo,
  53+ 702E                  ; poi JP salta direttamente.
  54+ 702E E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  55+ 702F C3 E1 70         jp   PerformRoomChangeNext  ; salta al cambio stanza avanti (non torna qui)
  56+ 7032
  57+ 7032              .q_not_pressed:
  58+ 7032 AF               xor  a
  59+ 7033 32 19 9A         ld   (q_prev), a            ; Q rilasciato → azzera debounce
  60+ 7036
  61+ 7036              .q_handled:
  62+ 7036
  63+ 7036                  ; ── Sezione 1b: tasto A (cambio stanza INDIETRO) ────────────────────
  64+ 7036                  ;
  65+ 7036                  ; Porta $FD → riga A, S, D, F, G. Bit 0 = A.
  66+ 7036                  ; Se bit 0 = 0, A è premuto.
  67+ 7036
  68+ 7036 01 FE FD         ld   bc, $fdfe
  69+ 7039 ED 78            in   a, (c)
  70+ 703B CB 47            bit  0, a
  71+ 703D 20 0F            jr   nz, .a_not_pressed     ; bit 0 = 1 → A non premuto, salta
  72+ 703F
  73+ 703F                  ; A è premuto: debounce tramite (a_prev).
  74+ 703F 3A 1A 9A         ld   a, (a_prev)
  75+ 7042 B7               or   a
  76+ 7043 20 0D            jr   nz, .a_handled         ; era già premuto, niente da fare
  77+ 7045
  78+ 7045                  ; ── Primo frame di pressione di A ──
  79+ 7045 3E 01            ld   a, 1
  80+ 7047 32 1A 9A         ld   (a_prev), a            ; marca "A era premuto"
  81+ 704A
  82+ 704A E1               pop  hl                     ; rimuove indirizzo di ritorno di Input_CheckCtrl
  83+ 704B C3 E5 70         jp   PerformRoomChangePrev  ; salta al cambio stanza indietro (non torna qui)
  84+ 704E
  85+ 704E              .a_not_pressed:
  86+ 704E AF               xor  a
  87+ 704F 32 1A 9A         ld   (a_prev), a            ; A rilasciato → azzera debounce
  88+ 7052
  89+ 7052              .a_handled:
  90+ 7052 CD 46 71         call Input_CheckWarpKeys
  91+ 7055                  ENDIF
  92+ 7055
  93+ 7055                  ; ── Sezione 2: movimento (sinistra / destra) ────────────────────
  94+ 7055                  ;
  95+ 7055                  ; Porta $DF → riga P, O, I, U, Y.
  96+ 7055                  ; Bit 0 = P (destra), Bit 1 = O (sinistra).
  97+ 7055
  98+ 7055 16 00            ld  d, $00                  ; azzera output
  99+ 7057 01 FE DF         ld  bc, $dffe
 100+ 705A ED 78            in  a, (c)                  ; legge riga $FE
 101+ 705C
 102+ 705C                  ; Se Willy è su un conveyor in qualsiasi stanza,

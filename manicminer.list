1237+ 78CB              .is_crumbling:
1238+ 78CB 3E 02            ld   a, 2
1239+ 78CD 18 12            jr   .store_cell
1240+ 78CF              .is_wall:
1241+ 78CF 3E 03            ld   a, 3
1242+ 78D1 18 0E            jr   .store_cell
1243+ 78D3              .is_conveyor:
1244+ 78D3 3E 04            ld   a, 4
1245+ 78D5 18 0A            jr   .store_cell
1246+ 78D7              .is_nasty1:
1247+ 78D7 3E 05            ld   a, 5
1248+ 78D9 18 06            jr   .store_cell
1249+ 78DB              .is_nasty2:
1250+ 78DB 3E 06            ld   a, 6
1251+ 78DD 18 02            jr   .store_cell
1252+ 78DF              .is_extra:
1253+ 78DF 3E 07            ld   a, 7

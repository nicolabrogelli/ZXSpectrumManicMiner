   8+ 8401              ; Audio_UpdateJumpSound
   9+ 8401              ;
  10+ 8401              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8401              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8401              ; -------------------------------------------------------------------
  13+ 8401              Audio_UpdateJumpSound:
  14+ 8401 F5               push af
  15+ 8402 C5               push bc
  16+ 8403 D5               push de
  17+ 8404 E5               push hl
  18+ 8405
  19+ 8405                  ; Controlla se il suono è attivo (note < 18)
  20+ 8405 3A 26 E5         ld   a, (Audio_jump_sound_note)
  21+ 8408 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 840A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 840C
  24+ 840C                  ; Carica la nota corrente da suonare
  25+ 840C 5F               ld   e, a
  26+ 840D 16 00            ld   d, 0
  27+ 840F 21 3B 84         ld   hl, Audio_JumpSoundDelays
  28+ 8412 19               add  hl, de
  29+ 8413 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8414 57               ld   d, a                      ; D = delay della nota
  31+ 8415
  32+ 8415                  ; Suona la nota: 15 cicli
  33+ 8415 06 0F            ld   b, 15
  34+ 8417              .note_loop:
  35+ 8417                  ; Speaker ON
  36+ 8417 3A 15 DF         ld   a, (room_border_color)
  37+ 841A F6 10            or   $10
  38+ 841C D3 FE            out  ($fe), a
  39+ 841E 4A               ld   c, d
  40+ 841F              .d1:
  41+ 841F 0D               dec  c
  42+ 8420 20 FD            jr   nz, .d1
  43+ 8422
  44+ 8422                  ; Speaker OFF
  45+ 8422 3A 15 DF         ld   a, (room_border_color)
  46+ 8425 E6 EF            and  $ef
  47+ 8427 D3 FE            out  ($fe), a
  48+ 8429 4A               ld   c, d
  49+ 842A              .d2:
  50+ 842A 0D               dec  c
  51+ 842B 20 FD            jr   nz, .d2
  52+ 842D
  53+ 842D 10 E8            djnz .note_loop
  54+ 842F
  55+ 842F                  ; Passa alla nota successiva
  56+ 842F 3A 26 E5         ld   a, (Audio_jump_sound_note)
  57+ 8432 3C               inc  a
  58+ 8433 32 26 E5         ld   (Audio_jump_sound_note), a

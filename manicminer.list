  84+ A442
  85+ A442              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ A442 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ A445 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ A448 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ A449 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ A44A 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ A44B 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ A44C 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ A44D 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ A44E
  95+ A44E 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ A44F 00           Audio_jump_sound_timer:   db 0
  97+ A450                  IF ENABLE_MUSIC != 0
  98+ A450 ~            Audio_music_note_idx:      db 0
  99+ A450 ~            Audio_music_frame_counter: db 1
 100+ A450                  ENDIF
 101+ A450
 102+ A450              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 103+ A450 E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 104+ A451 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 105+ A452 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria

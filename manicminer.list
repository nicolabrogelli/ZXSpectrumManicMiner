 999+ 781D              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1000+ 781D              ; Input: C = X, B = Y
1001+ 781D              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1002+ 781D              ; -------------------------------------------------------------------
1003+ 781D              CheckWallCell:
1004+ 781D E5               push hl
1005+ 781E D5               push de
1006+ 781F C5               push bc
1007+ 7820
1008+ 7820                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1009+ 7820 78               ld   a, b
1010+ 7821 FE 80            cp   128
1011+ 7823 30 1F            jr   nc, .not_wall
1012+ 7825
1013+ 7825                  ; 2. Calcola riga di layout: r = Y / 8
1014+ 7825 CB 3F            srl  a
1015+ 7827 CB 3F            srl  a
1016+ 7829 CB 3F            srl  a                 ; A = r (0..15)
1017+ 782B
1018+ 782B                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1019+ 782B 5F               ld   e, a              ; E = r (Row)
1020+ 782C 79               ld   a, c
1021+ 782D CB 3F            srl  a
1022+ 782F CB 3F            srl  a
1023+ 7831 CB 3F            srl  a                 ; A = c (0..31)
1024+ 7833 4F               ld   c, a              ; C = c (Col)
1025+ 7834
1026+ 7834                  ; Se la cella è sulla rampa, non considerarla un muro!
1027+ 7834 53               ld   d, e              ; D = Row
1028+ 7835 59               ld   e, c              ; E = Col
1029+ 7836 CD A2 77         call IsCellOnRamp
1030+ 7839 38 09            jr   c, .not_wall
1031+ 783B
1032+ 783B 7A               ld   a, d              ; A = Row
1033+ 783C 4B               ld   c, e              ; C = Col
1034+ 783D CD D9 78         call GetCellFromUnpacked ; A = cell type
1035+ 7840
1036+ 7840                  ; Controlla se è Wall (3)

 262+ 7E51 28 37            jr   z, .next_draw
 263+ 7E53
 264+ 7E53                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 265+ 7E53 DD 7E 08         ld   a, (ix+8)         ; Old X
 266+ 7E56 FE FF            cp   $FF
 267+ 7E58 28 16            jr   z, .do_draw_slot
 268+ 7E5A
 269+ 7E5A                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 270+ 7E5A DD 7E 08         ld   a, (ix+8)         ; Old X
 271+ 7E5D DD BE 02         cp   (ix+2)            ; Current X
 272+ 7E60 20 0E            jr   nz, .do_draw_slot
 273+ 7E62 DD 7E 09         ld   a, (ix+9)         ; Old Y
 274+ 7E65 DD BE 03         cp   (ix+3)            ; Current Y
 275+ 7E68 20 06            jr   nz, .do_draw_slot
 276+ 7E6A
 277+ 7E6A 3A 0E A2         ld   a, (enemy_was_updated)
 278+ 7E6D B7               or   a
 279+ 7E6E 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!

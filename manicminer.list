  29+ 7CA2              ; Enemy_LoadRoom
  30+ 7CA2              ;
  31+ 7CA2              ; Carica i guardiani della stanza corrente in ActiveEnemies.
  32+ 7CA2              ; Chiamato quando si entra in una stanza.
  33+ 7CA2              ; -------------------------------------------------------------------
  34+ 7CA2              Enemy_LoadRoom:
  35+ 7CA2 E5               push hl
  36+ 7CA3 D5               push de
  37+ 7CA4 C5               push bc
  38+ 7CA5 DD E5            push ix
  39+ 7CA7
  40+ 7CA7                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7CA7 21 4A 7C         ld   hl, ActiveEnemies
  42+ 7CAA 11 4B 7C         ld   de, ActiveEnemies + 1
  43+ 7CAD 36 00            ld   (hl), 0
  44+ 7CAF 01 57 00         ld   bc, 87
  45+ 7CB2 ED B0            ldir
  46+ 7CB4
  47+ 7CB4                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7CB4 DD 21 4A 7C      ld   ix, ActiveEnemies
  49+ 7CB8 06 08            ld   b, 8
  50+ 7CBA 11 0B 00         ld   de, 11
  51+ 7CBD              .init_old_pos:
  52+ 7CBD DD 36 08 FF      ld   (ix+8), $FF               ; Old X
  53+ 7CC1 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y
  54+ 7CC5 DD 19            add  ix, de
  55+ 7CC7 10 F4            djnz .init_old_pos
  56+ 7CC9
  57+ 7CC9                  ; 2. Carica i guardiani orizzontali da room_ptr + OFFSET_H_GUARDIANS
  58+ 7CC9 DD 21 4A 7C      ld   ix, ActiveEnemies
  59+ 7CCD 2A 9E E5         ld   hl, (room_ptr)
  60+ 7CD0 11 BE 02         ld   de, OFFSET_H_GUARDIANS
  61+ 7CD3 19               add  hl, de
  62+ 7CD4
  63+ 7CD4 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CD6              .load_h_loop:
  65+ 7CD6 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CD7 FE FF            cp   $FF
  67+ 7CD9 28 7F            jr   z, .done_h_guardians      ; $FF = terminatore
  68+ 7CDB B7               or   a
  69+ 7CDC 28 74            jr   z, .skip_h_guardian       ; 0 = slot inutilizzato -> salta al prossimo slot!
  70+ 7CDE
  71+ 7CDE                  ; Slot attivo
  72+ 7CDE DD 36 00 80      ld   (ix+0), $80               ; Active = 1, Horizontal (Bit 6 = 0)
  73+ 7CE2 CB 7F            bit  7, a
  74+ 7CE4 28 04            jr   z, .h_speed_normal
  75+ 7CE6 DD CB 00 E6      set  4, (ix+0)                 ; Bit 4 = Slow speed (indicato dal bit 7 di Byte 0)
  76+ 7CEA              .h_speed_normal:
  77+ 7CEA E6 7F            and  $7F                       ; Rimuove bit 7 (velocità) per isolare l'attributo colore ed evitare il FLASH hardware
  78+ 7CEC DD 77 0A         ld   (ix+10), a                ; Color / Attributo
  79+ 7CEF
  80+ 7CEF 23               inc  hl
  81+ 7CF0 4E               ld   c, (hl)                   ; C = AttrAddr Low
  82+ 7CF1 23               inc  hl
  83+ 7CF2 7E               ld   a, (hl)                   ; A = AttrAddr High
  84+ 7CF3
  85+ 7CF3                  ; Calcola StartX e StartY da AttrAddr: Offset = AttrAddr - 23552
  86+ 7CF3 E5               push hl
  87+ 7CF4 C5               push bc
  88+ 7CF5 67               ld   h, a
  89+ 7CF6 69               ld   l, c
  90+ 7CF7 01 00 A4         ld   bc, -23552
  91+ 7CFA 09               add  hl, bc                    ; HL = AttrOffset
  92+ 7CFB
  93+ 7CFB                  ; Col = Offset & 31 -> StartX = Col * 8
  94+ 7CFB 7D               ld   a, l
  95+ 7CFC E6 1F            and  31
  96+ 7CFE 87               add  a, a
  96+ 7CFF 87             add a, a
  96+ 7D00 87             add a, a
  97+ 7D01 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7D04
  99+ 7D04                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7D04 CB 3C            srl  h
 100+ 7D06 CB 1D          rr l
 101+ 7D08 CB 3C            srl  h
 101+ 7D0A CB 1D          rr l
 102+ 7D0C CB 3C            srl  h
 102+ 7D0E CB 1D          rr l
 103+ 7D10 CB 3C            srl  h
 103+ 7D12 CB 1D          rr l
 104+ 7D14 CB 3C            srl  h
 104+ 7D16 CB 1D          rr l
 105+ 7D18 7D               ld   a, l
 106+ 7D19 87               add  a, a
 106+ 7D1A 87             add a, a
 106+ 7D1B 87             add a, a
 107+ 7D1C DD 77 03         ld   (ix+3), a                 ; Current Y = StartY
 108+ 7D1F C1               pop  bc
 109+ 7D20 E1               pop  hl
 110+ 7D21
 111+ 7D21 23               inc  hl
 112+ 7D22 7E               ld   a, (hl)                   ; Byte 3: Anim mask / frame
 113+ 7D23 DD 36 07 00      ld   (ix+7), 0                 ; Anim subframe iniziale = 0
 114+ 7D27
 115+ 7D27 23               inc  hl
 116+ 7D28 7E               ld   a, (hl)                   ; Byte 4: Direction (0 = Destra, 1 = Sinistra)
 117+ 7D29 E6 01            and  1
 118+ 7D2B 28 04            jr   z, .h_dir_right
 119+ 7D2D 3E 01            ld   a, 1                      ; 1 = Sinistra
 120+ 7D2F 18 02            jr   .set_h_dir
 121+ 7D31              .h_dir_right:
 122+ 7D31 3E 02            ld   a, 2                      ; 2 = Destra
 123+ 7D33              .set_h_dir:
 124+ 7D33 DD 77 06         ld   (ix+6), a                 ; Direction
 125+ 7D36
 126+ 7D36 23               inc  hl
 127+ 7D37 7E               ld   a, (hl)                   ; Byte 5: Min limit
 128+ 7D38 E6 1F            and  31
 129+ 7D3A 87               add  a, a
 129+ 7D3B 87             add a, a
 129+ 7D3C 87             add a, a
 130+ 7D3D DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 131+ 7D40
 132+ 7D40 23               inc  hl
 133+ 7D41 7E               ld   a, (hl)                   ; Byte 6: Max limit
 134+ 7D42 E6 1F            and  31
 135+ 7D44 87               add  a, a
 135+ 7D45 87             add a, a
 135+ 7D46 87             add a, a
 136+ 7D47 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 137+ 7D4A
 138+ 7D4A 23               inc  hl                        ; Prossimo guardiano
 139+ 7D4B 11 0B 00         ld   de, 11
 140+ 7D4E DD 19            add  ix, de
 141+ 7D50 18 04            jr   .next_h_loop
 142+ 7D52
 143+ 7D52              .skip_h_guardian:
 144+ 7D52 11 07 00         ld   de, 7
 145+ 7D55 19               add  hl, de                    ; Salta 7 byte dei dati stanza
 146+ 7D56
 147+ 7D56              .next_h_loop:
 148+ 7D56 05               dec  b
 149+ 7D57 C2 D6 7C         jp   nz, .load_h_loop
 150+ 7D5A
 151+ 7D5A              .done_h_guardians:
 152+ 7D5A                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 153+ 7D5A 2A 9E E5         ld   hl, (room_ptr)
 154+ 7D5D 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 155+ 7D60 19               add  hl, de
 156+ 7D61
 157+ 7D61 7E               ld   a, (hl)
 158+ 7D62 FE FF            cp   $FF
 159+ 7D64 28 0A            jr   z, .no_v_guardians
 160+ 7D66 B7               or   a
 161+ 7D67 28 07            jr   z, .no_v_guardians
 162+ 7D69 3E 01            ld   a, 1
 163+ 7D6B 32 28 E6         ld   (room_has_v_guardians), a
 164+ 7D6E 18 06            jr   .has_v_guardians
 165+ 7D70
 166+ 7D70              .no_v_guardians:
 167+ 7D70 AF               xor  a
 168+ 7D71 32 28 E6         ld   (room_has_v_guardians), a
 169+ 7D74 18 4B            jr   .done_v_guardians
 170+ 7D76
 171+ 7D76              .has_v_guardians:
 172+ 7D76 06 04            ld   b, 4                      ; Fino a 4 guardiani verticali
 173+ 7D78              .load_v_loop:
 174+ 7D78 7E               ld   a, (hl)                   ; Byte 0: Attributo / Colore
 175+ 7D79 FE FF            cp   $FF
 176+ 7D7B 28 44            jr   z, .done_v_guardians      ; $FF = terminatore
 177+ 7D7D B7               or   a
 178+ 7D7E 28 41            jr   z, .done_v_guardians      ; 0 = nessun guardiano
 179+ 7D80
 180+ 7D80                  ; Slot attivo per guardiano verticale
 181+ 7D80 DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 182+ 7D84 E6 7F            and  $7F                       ; Rimuove bit 7
 183+ 7D86 DD 77 0A         ld   (ix+10), a                ; Color / Attributo
 184+ 7D89
 185+ 7D89 23               inc  hl
 186+ 7D8A 7E               ld   a, (hl)                   ; Byte 1: Graphic index (0..3)
 187+ 7D8B E6 03            and  3                         ; Frame 0..3 nella prima metà dei dati grafici
 188+ 7D8D DD 77 01         ld   (ix+1), a                 ; Frame index (0..3)
 189+ 7D90
 190+ 7D90 23               inc  hl
 191+ 7D91 7E               ld   a, (hl)                   ; Byte 2: Initial Y (pixel)
 192+ 7D92 DD 77 03         ld   (ix+3), a                 ; Current Y
 193+ 7D95
 194+ 7D95 23               inc  hl
 195+ 7D96 7E               ld   a, (hl)                   ; Byte 3: X colonna (0..31)
 196+ 7D97 E6 1F            and  31
 197+ 7D99 87               add  a, a
 197+ 7D9A 87             add a, a
 197+ 7D9B 87             add a, a ; * 8 -> X pixel
 198+ 7D9C DD 77 02         ld   (ix+2), a                 ; Current X
 199+ 7D9F
 200+ 7D9F 23               inc  hl
 201+ 7DA0 7E               ld   a, (hl)                   ; Byte 4: Direction / Speed
 202+ 7DA1 E6 03            and  3
 203+ 7DA3 20 02            jr   nz, .v_step_ok
 204+ 7DA5 3E 01            ld   a, 1
 205+ 7DA7              .v_step_ok:
 206+ 7DA7 DD 77 07         ld   (ix+7), a                 ; Speed step (1 o 2 pixel per frame)
 207+ 7DAA 3E 02            ld   a, 2                      ; Direction iniziale = 2 (Down)
 208+ 7DAC DD 77 06         ld   (ix+6), a
 209+ 7DAF
 210+ 7DAF 23               inc  hl
 211+ 7DB0 7E               ld   a, (hl)                   ; Byte 5: Min Limit Y (pixel)
 212+ 7DB1 DD 77 04         ld   (ix+4), a                 ; Min Limit Y
 213+ 7DB4
 214+ 7DB4 23               inc  hl
 215+ 7DB5 7E               ld   a, (hl)                   ; Byte 6: Max Limit Y (pixel)
 216+ 7DB6 DD 77 05         ld   (ix+5), a                 ; Max Limit Y
 217+ 7DB9
 218+ 7DB9 23               inc  hl                        ; Prossimo guardiano verticale (7 byte per record)
 219+ 7DBA 11 0B 00         ld   de, 11
 220+ 7DBD DD 19            add  ix, de
 221+ 7DBF 10 B7            djnz .load_v_loop
 222+ 7DC1
 223+ 7DC1              .done_v_guardians:
 224+ 7DC1                  ; 4. Controlla se la stanza corrente è Eugene's Lair (Caverna 04)
 225+ 7DC1 2A 9E E5         ld   hl, (room_ptr)
 226+ 7DC4 11 DD 9B         ld   de, EugeneLairLayout
 227+ 7DC7 B7               or   a
 228+ 7DC8 ED 52            sbc  hl, de
 229+ 7DCA 20 30            jr   nz, .not_eugene
 230+ 7DCC
 231+ 7DCC                  ; Inizializza Eugene nello Slot 4 (offset 44) di ActiveEnemies
 232+ 7DCC DD 21 76 7C      ld   ix, ActiveEnemies + 44
 233+ 7DD0 DD 36 00 E0      ld   (ix+0), $E0               ; Active = 1, Vertical = 1, Eugene = 1
 234+ 7DD4 DD 36 01 00      ld   (ix+1), 0                 ; Frame = 0
 235+ 7DD8 DD 36 02 78      ld   (ix+2), 120               ; X = 120 (Colonna 15)
 236+ 7DDC DD 36 03 58      ld   (ix+3), 88                ; Initial Y = 88
 237+ 7DE0 DD 36 04 00      ld   (ix+4), 0                 ; Min Limit Y = 0
 238+ 7DE4 DD 36 05 58      ld   (ix+5), 88                ; Max Limit Y = 88
 239+ 7DE8 DD 36 06 01      ld   (ix+6), 1                 ; Direction = 1 (Up)
 240+ 7DEC DD 36 07 01      ld   (ix+7), 1                 ; Speed = 1
 241+ 7DF0 DD 36 08 FF      ld   (ix+8), $FF               ; Old X = $FF
 242+ 7DF4 DD 36 09 FF      ld   (ix+9), $FF               ; Old Y = $FF
 243+ 7DF8 DD 36 0A 17      ld   (ix+10), 23               ; Paper 2 (Red), Ink 7 (White) -> 23
 244+ 7DFC
 245+ 7DFC              .not_eugene:
 246+ 7DFC                  ; 5. Controlla se la stanza corrente ha il boss Kong Beast (Caverna 07 o Caverna 11)
 247+ 7DFC 2A 9E E5         ld   hl, (room_ptr)
 248+ 7DFF 11 DD A7         ld   de, MinerWillymeetstheKongBeastLayout
 249+ 7E02 B7               or   a
 250+ 7E03 ED 52            sbc  hl, de
 251+ 7E05 28 0F            jr   z, .is_kong_room1

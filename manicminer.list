 963+ 77B4              ; -------------------------------------------------------------------
 964+ 77B4              CheckWallCell:
 965+ 77B4 E5               push hl
 966+ 77B5 D5               push de
 967+ 77B6 C5               push bc
 968+ 77B7
 969+ 77B7                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77B7 78               ld   a, b
 971+ 77B8 FE 80            cp   128
 972+ 77BA 30 1F            jr   nc, .not_wall
 973+ 77BC
 974+ 77BC                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77BC CB 3F            srl  a
 976+ 77BE CB 3F            srl  a
 977+ 77C0 CB 3F            srl  a                 ; A = r (0..15)
 978+ 77C2
 979+ 77C2                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77C2 5F               ld   e, a              ; E = r (Row)
 981+ 77C3 79               ld   a, c
 982+ 77C4 CB 3F            srl  a
 983+ 77C6 CB 3F            srl  a
 984+ 77C8 CB 3F            srl  a                 ; A = c (0..31)

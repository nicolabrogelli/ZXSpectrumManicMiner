 829  8C5F 32 FE EA         ld   (willy_lives), a
 830  8C62
 831  8C62                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 832  8C62 AF               xor  a
 833  8C63 32 FB EA         ld   (items_collected), a
 834  8C66 32 F7 EA         ld   (body_state), a
 835  8C69 32 0A EB         ld   (w_warp_state), a

1929+ 7C1A              ; -------------------------------------------------------------------
1930+ 7C1A              ; Phys_UpdateAir
1931+ 7C1A              ; Aggiorna il consumo di aria durante ogni frame di gioco.
1932+ 7C1A              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
1933+ 7C1A              ; Output:
1934+ 7C1A              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
1935+ 7C1A              ;   Carry Clear = Aria ancora disponibile
1936+ 7C1A              ; -------------------------------------------------------------------
1937+ 7C1A              Phys_UpdateAir:
1938+ 7C1A                  ; Incrementa il timer dei frame
1939+ 7C1A 3A 34 E8         ld   a, (air_timer)
1940+ 7C1D 3C               inc  a
1941+ 7C1E 32 34 E8         ld   (air_timer), a
1942+ 7C21 21 35 E8         ld   hl, air_deplete_rate
1943+ 7C24 BE               cp   (hl)
1944+ 7C25 38 14            jr   c, .no_deplete
1945+ 7C27
1946+ 7C27                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
1947+ 7C27 AF               xor  a
1948+ 7C28 32 34 E8         ld   (air_timer), a
1949+ 7C2B
1950+ 7C2B 3A 33 E8         ld   a, (air_pixels)
1951+ 7C2E B7               or   a
1952+ 7C2F 28 0C            jr   z, .air_finished
1953+ 7C31
1954+ 7C31 3D               dec  a
1955+ 7C32 32 33 E8         ld   (air_pixels), a
1956+ 7C35 CD 27 6A         call Gfx_UpdateAirBar
1957+ 7C38
1958+ 7C38 B7               or   a
1959+ 7C39 28 02            jr   z, .air_finished
1960+ 7C3B
1961+ 7C3B              .no_deplete:
1962+ 7C3B B7               or   a                     ; Carry Clear = Ok
1963+ 7C3C C9               ret
1964+ 7C3D
1965+ 7C3D              .air_finished:
1966+ 7C3D 37               scf                        ; Carry Set = Morte per esaurimento aria
1967+ 7C3E C9               ret

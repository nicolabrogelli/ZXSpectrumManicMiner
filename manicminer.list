 138+ 7EF9              ; Items_DrawRoom
 139+ 7EF9              ;
 140+ 7EF9              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 7EF9              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 7EF9              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 7EF9              ;
 144+ 7EF9              ; Record item nella stanza (5 byte):
 145+ 7EF9              ;   +0 Color / Attributo
 146+ 7EF9              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 7EF9              ;   +2 Attr Address High
 148+ 7EF9              ;   +3 Anim Mask (96)
 149+ 7EF9              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 7EF9              ; Fine lista: $FF
 151+ 7EF9              ; -------------------------------------------------------------------
 152+ 7EF9              Items_DrawRoom:
 153+ 7EF9 E5               push hl
 154+ 7EFA D5               push de
 155+ 7EFB C5               push bc
 156+ 7EFC DD E5            push ix
 157+ 7EFE FD E5            push iy
 158+ 7F00
 159+ 7F00                  ; 1. Azzera items_grid (512 byte)
 160+ 7F00 21 6B 92         ld   hl, items_grid
 161+ 7F03 11 6C 92         ld   de, items_grid + 1
 162+ 7F06 36 00            ld   (hl), 0
 163+ 7F08 01 FF 01         ld   bc, 511
 164+ 7F0B ED B0            ldir
 165+ 7F0D
 166+ 7F0D                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 7F0D AF               xor  a
 168+ 7F0E 32 EA 97         ld   (num_room_items), a
 169+ 7F11
 170+ 7F11 FD 21 9A 97      ld   iy, current_room_items
 171+ 7F15
 172+ 7F15                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 7F15 2A EB 97         ld   hl, (room_ptr)
 174+ 7F18 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 7F1B 19               add  hl, de
 176+ 7F1C E5               push hl
 177+ 7F1D DD E1            pop  ix                        ; IX = bitmap item
 178+ 7F1F
 179+ 7F1F                  ; 4. HL = Inizio lista item nella stanza
 180+ 7F1F 2A EB 97         ld   hl, (room_ptr)
 181+ 7F22 11 75 02         ld   de, OFFSET_ITEMS
 182+ 7F25 19               add  hl, de
 183+ 7F26
 184+ 7F26              .loop:
 185+ 7F26 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 7F27 FE FF            cp   $FF
 187+ 7F29 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 7F2B
 189+ 7F2B 5F               ld   e, a                      ; E = Color
 190+ 7F2C 23               inc  hl
 191+ 7F2D 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 7F2E 23               inc  hl
 193+ 7F2F 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 7F30 23               inc  hl                        ; Salta Anim Byte
 195+ 7F31 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 7F32
 197+ 7F32 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 7F33 FE FF            cp   $FF
 199+ 7F35 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 7F37
 201+ 7F37                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 7F37 E5               push hl
 203+ 7F38 60               ld   h, b
 204+ 7F39 69               ld   l, c
 205+ 7F3A 01 00 A4         ld   bc, -23552
 206+ 7F3D 09               add  hl, bc                    ; HL = AttrOffset
 207+ 7F3E
 208+ 7F3E                  ; Col = Offset & 31
 209+ 7F3E 7D               ld   a, l
 210+ 7F3F E6 1F            and  31
 211+ 7F41 4F               ld   c, a                      ; C = Col (0..31)
 212+ 7F42
 213+ 7F42                  ; Row = Offset / 32
 214+ 7F42 CB 3C            srl  h
 214+ 7F44 CB 1D          rr l
 215+ 7F46 CB 3C            srl  h
 215+ 7F48 CB 1D          rr l
 216+ 7F4A CB 3C            srl  h
 216+ 7F4C CB 1D          rr l
 217+ 7F4E CB 3C            srl  h
 217+ 7F50 CB 1D          rr l
 218+ 7F52 CB 3C            srl  h
 218+ 7F54 CB 1D          rr l
 219+ 7F56 7D               ld   a, l
 220+ 7F57 47               ld   b, a                      ; B = Row (0..15)

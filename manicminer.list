 453  895B ED 78            in   a, (c)
 454  895D CB 67            bit  4, a
 455  895F 28 F6            jr   z, .wait_continue_release
 456  8961
 457  8961                  ; 5b. Ripristina lo stato per continuare la partita:
 458  8961                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 459  8961 CD 3A 84         call Items_ResetCurrentRoomItems
 460  8964
 461  8964                  ; - Ripristina le vite di Willy al valore iniziale
 462  8964 3E 07            ld   a, INITIAL_LIVES
 463  8966 32 2A E2         ld   (willy_lives), a
 464  8969
 465  8969                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 466  8969 2A 3E E2         ld   hl, (counter)
 467  896C 22 41 E2         ld   (last_frame_counter), hl
 468  896F
 469  896F                  ; - Reimposta la fisica e le variabili di stato di Willy
 470  896F AF               xor  a
 471  8970 32 2B E2         ld   (velocity_y), a
 472  8973 32 2D E2         ld   (jump_pressed), a
 473  8976 32 2F E2         ld   (coyote_timer), a
 474  8979 32 32 E2         ld   (jump_frame), a
 475  897C 32 31 E2         ld   (jump_dir), a
 476  897F 32 23 E2         ld   (body_state), a
 477  8982 32 36 E2         ld   (w_warp_state), a
 478  8985 32 39 E2         ld   (w_key_prev), a
 479  8988 32 3A E2         ld   (enter_key_prev), a
 480  898B 32 26 E2         ld   (collision_active), a
 481  898E 32 25 E2         ld   (flags), a
 482  8991 32 1F E6         ld   (ramp_entry_guard), a
 483  8994 32 2B E6         ld   (willy_on_ramp), a
 484  8997 32 2A E6         ld   (willy_needs_redraw), a
 485  899A 3E FF            ld   a, $ff
 486  899C 32 3B E2         ld   (digit_key_prev), a
 487  899F 32 24 E6         ld   (player_drawn_pos+1), a
 488  89A2 32 25 E6         ld   (player_old_dir), a
 489  89A5 32 26 E6         ld   (player_old_body), a
 490  89A8 3E 01            ld   a, 1
 491  89AA 32 34 E2         ld   (q_prev), a
 492  89AD 32 35 E2         ld   (a_prev), a
 493  89B0 32 2C E2         ld   (on_ground), a
 494  89B3 32 27 E6         ld   (enemy_was_updated), a
 495  89B6
 496  89B6                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 497  89B6 3E 00            ld   a, RESPAWN_SAFETY_TIME
 498  89B8 32 29 E6         ld   (willy_safety_timer), a
 499  89BB
 500  89BB                  ; - Ripristina lo stato audio
 501  89BB 3E 12            ld   a, 18
 502  89BD 32 3C E8         ld   (Audio_jump_sound_note), a
 503  89C0 AF               xor  a
 504  89C1 32 3D E8         ld   (Audio_jump_sound_timer), a
 505  89C4                  IF ENABLE_MUSIC != 0
 506  89C4 ~                ld   (Audio_music_note_idx), a
 507  89C4 ~                ld   a, 1
 508  89C4 ~                ld   (Audio_music_frame_counter), a
 509  89C4                  ENDIF
 510  89C4
 511  89C4                  ; - Riposiziona Willy nel punto di default definito nella stanza
 512  89C4 AF               xor  a
 513  89C5 32 A4 E5         ld   (transition_active), a
 514  89C8
 515  89C8                  ; - Cancella lo schermo a nero prima del caricamento
 516  89C8 AF               xor  a
 517  89C9 D3 FE            out  ($fe), a
 518  89CB CD 9D 62         call Gfx_ClearScreenDirect
 519  89CE
 520  89CE                  ; - Ricarica e riavvia la stanza corrente mantenendo tutti gli items raccolti
 521  89CE C3 6C 87         jp   LoadRoomAndRestart
 522  89D1
 523  89D1              ; -------------------------------------------------------------------
 524  89D1              ; TriggerVictory
 525  89D1              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 526  89D1              ; - Pulisce gli elementi di gioco della stanza.
 527  89D1              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 528  89D1              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 529  89D1              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 530  89D1              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 531  89D1              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 532  89D1              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 533  89D1              ; -------------------------------------------------------------------
 534  89D1              TriggerVictory:
 535  89D1                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 536  89D1 CD F7 66         call Gfx_DrawVictoryScreen
 537  89D4
 538  89D4                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 539  89D4              .wait_keys_release:
 540  89D4 76               halt
 541  89D5                  ; Controlla tasto Y (Porta $DF, bit 4)
 542  89D5 01 FE DF         ld   bc, $dffe
 543  89D8 ED 78            in   a, (c)
 544  89DA CB 67            bit  4, a
 545  89DC 28 F6            jr   z, .wait_keys_release
 546  89DE
 547  89DE                  ; Controlla tasto N (Porta $7F, bit 3)
 548  89DE 01 FE 7F         ld   bc, $7ffe
 549  89E1 ED 78            in   a, (c)
 550  89E3 CB 5F            bit  3, a
 551  89E5 28 ED            jr   z, .wait_keys_release
 552  89E7
 553  89E7                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 554  89E7 01 FE BF         ld   bc, $bffe
 555  89EA ED 78            in   a, (c)
 556  89EC CB 47            bit  0, a
 557  89EE 28 E4            jr   z, .wait_keys_release
 558  89F0
 559  89F0                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 560  89F0 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 561  89F2              .wait_choice_loop:
 562  89F2 76               halt
 563  89F3
 564  89F3                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 565  89F3 0C               inc  c
 566  89F4 79               ld   a, c
 567  89F5 CB 3F            srl  a
 568  89F7 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 569  89F9 E6 07            and  7
 570  89FB 5F               ld   e, a
 571  89FC 16 00            ld   d, 0
 572  89FE 21 11 66         ld   hl, victory_color_table
 573  8A01 19               add  hl, de
 574  8A02 7E               ld   a, (hl)               ; A = nuovo colore attributo
 575  8A03 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 576  8A06 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 577  8A08              .color_cycle_loop:
 578  8A08 77               ld   (hl), a
 579  8A09 23               inc  hl
 580  8A0A 10 FC            djnz .color_cycle_loop
 581  8A0C
 582  8A0C                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 583  8A0C 01 FE DF         ld   bc, $dffe
 584  8A0F ED 78            in   a, (c)
 585  8A11 CB 67            bit  4, a
 586  8A13 28 2A            jr   z, .play_again_chosen
 587  8A15
 588  8A15                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 589  8A15 01 FE 7F         ld   bc, $7ffe
 590  8A18 ED 78            in   a, (c)
 591  8A1A CB 5F            bit  3, a
 592  8A1C 28 0B            jr   z, .quit_chosen
 593  8A1E
 594  8A1E                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 595  8A1E 01 FE BF         ld   bc, $bffe
 596  8A21 ED 78            in   a, (c)
 597  8A23 CB 47            bit  0, a
 598  8A25 28 02            jr   z, .quit_chosen
 599  8A27
 600  8A27 18 C9            jr   .wait_choice_loop
 601  8A29
 602  8A29              .quit_chosen:
 603  8A29                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 604  8A29              .wait_quit_release:
 605  8A29 76               halt
 606  8A2A 01 FE 7F         ld   bc, $7ffe
 607  8A2D ED 78            in   a, (c)
 608  8A2F CB 5F            bit  3, a
 609  8A31 28 F6            jr   z, .wait_quit_release
 610  8A33 01 FE BF         ld   bc, $bffe
 611  8A36 ED 78            in   a, (c)
 612  8A38 CB 47            bit  0, a
 613  8A3A 28 ED            jr   z, .wait_quit_release
 614  8A3C
 615  8A3C                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 616  8A3C C3 A5 88         jp   ShowTitleScreen
 617  8A3F
 618  8A3F              .play_again_chosen:
 619  8A3F                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 620  8A3F              .wait_play_again_release:
 621  8A3F 76               halt
 622  8A40 01 FE DF         ld   bc, $dffe
 623  8A43 ED 78            in   a, (c)
 624  8A45 CB 67            bit  4, a
 625  8A47 28 F6            jr   z, .wait_play_again_release
 626  8A49
 627  8A49                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 628  8A49 CD 83 8B         call ResetFullGameState
 629  8A4C C3 6C 87         jp   LoadRoomAndRestart
 630  8A4F
 631  8A4F              ; -------------------------------------------------------------------
 632  8A4F              ; CheckPortalTransition
 633  8A4F              ; Verifica le condizioni per accedere alla stanza successiva:
 634  8A4F              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 635  8A4F              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 636  8A4F              ;
 637  8A4F              ; Output:
 638  8A4F              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 639  8A4F              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 640  8A4F              ; -------------------------------------------------------------------
 641  8A4F              CheckPortalTransition:
 642  8A4F C5               push bc
 643  8A50 D5               push de
 644  8A51 E5               push hl
 645  8A52
 646  8A52                  ; 1. Tutti gli item della stanza sono stati raccolti?
 647  8A52 CD 16 8B         call CheckAllItemsCollected
 648  8A55 30 4D            jr   nc, .no_transition
 649  8A57
 650  8A57                  ; 2. Willy collide con il portale (16x16 pixel)?
 651  8A57                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 652  8A57                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 653  8A57 2A 9E E5         ld   hl, (room_ptr)
 654  8A5A 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 655  8A5D 19               add  hl, de
 656  8A5E 4E               ld   c, (hl)
 657  8A5F 23               inc  hl
 658  8A60 46               ld   b, (hl)                   ; BC = AttrAddr
 659  8A61
 660  8A61                  ; Offset = BC - 23552
 661  8A61 60               ld   h, b
 662  8A62 69               ld   l, c
 663  8A63 01 00 A4         ld   bc, -23552
 664  8A66 09               add  hl, bc
 665  8A67
 666  8A67                  ; PortalX = (Offset & 31) * 8
 667  8A67 7D               ld   a, l
 668  8A68 E6 1F            and  31
 669  8A6A 87               add  a, a
 669  8A6B 87             add a, a
 669  8A6C 87             add a, a
 670  8A6D 5F               ld   e, a                      ; E = PortalX (0..248)
 671  8A6E
 672  8A6E                  ; PortalY = (Offset / 32) * 8
 673  8A6E CB 3C            srl  h
 673  8A70 CB 1D          rr l
 674  8A72 CB 3C            srl  h
 674  8A74 CB 1D          rr l
 675  8A76 CB 3C            srl  h
 675  8A78 CB 1D          rr l
 676  8A7A CB 3C            srl  h
 676  8A7C CB 1D          rr l
 677  8A7E CB 3C            srl  h
 677  8A80 CB 1D          rr l
 678  8A82 7D               ld   a, l
 679  8A83 87               add  a, a
 679  8A84 87             add a, a
 679  8A85 87             add a, a
 680  8A86 57               ld   d, a                      ; D = PortalY (0..120)
 681  8A87
 682  8A87                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 683  8A87 ED 4B 1D E2      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 684  8A8B
 685  8A8B                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 686  8A8B 7B               ld   a, e
 687  8A8C 91               sub  c
 688  8A8D 30 02            jr   nc, .x_diff_pos
 689  8A8F ED 44            neg
 690  8A91              .x_diff_pos:
 691  8A91 FE 0C            cp   12
 692  8A93 30 0F            jr   nc, .no_transition
 693  8A95
 694  8A95                  ; Controllo verticale: |WillyY - PortalY| < 14
 695  8A95 7A               ld   a, d
 696  8A96 90               sub  b
 697  8A97 30 02            jr   nc, .y_diff_pos
 698  8A99 ED 44            neg
 699  8A9B              .y_diff_pos:
 700  8A9B FE 0E            cp   14
 701  8A9D 30 05            jr   nc, .no_transition
 702  8A9F
 703  8A9F                  ; Transizione al portale attiva!
 704  8A9F E1               pop  hl
 705  8AA0 D1               pop  de
 706  8AA1 C1               pop  bc
 707  8AA2 37               scf
 708  8AA3 C9               ret
 709  8AA4
 710  8AA4              .no_transition:
 711  8AA4 E1               pop  hl
 712  8AA5 D1               pop  de
 713  8AA6 C1               pop  bc
 714  8AA7 B7               or   a
 715  8AA8 C9               ret
 716  8AA9
 717  8AA9              ; Alias per retrocompatibilità
 718  8AA9              CheckVictoryCondition: EQU CheckPortalTransition
 719  8AA9
 720  8AA9              ; -------------------------------------------------------------------
 721  8AA9              ; TriggerPortalTransition
 722  8AA9              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 723  8AA9              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 724  8AA9              ; - Avanza all'indice della stanza successiva.
 725  8AA9              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 726  8AA9              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 727  8AA9              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 728  8AA9              ; -------------------------------------------------------------------
 729  8AA9              TriggerPortalTransition:
 730  8AA9                  ; 0. Animazione di fine livello: svuota l'aria residua convertendola in punteggio (+1 per pixel)
 731  8AA9 CD E0 8A         call Air_DepleteCountdown
 732  8AAC
 733  8AAC                  ; 1. Determina l'ID della stanza corrente
 734  8AAC CD E8 83         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 735  8AAF
 736  8AAF                  ; 2. Calcola l'indice della stanza successiva
 737  8AAF 3A 43 E5         ld   a, (current_room)
 738  8AB2 3C               inc  a
 739  8AB3 FE 14            cp   NUM_ROOMS
 740  8AB5 30 26            jr   nc, .all_rooms_completed  ; Se >= NUM_ROOMS, tutte le stanze completate!
 741  8AB7
 742  8AB7                  ; 3. Carica il puntatore alla stanza successiva da RoomsListTable[A]
 743  8AB7 21 19 73         ld   hl, RoomsListTable
 744  8ABA 5F               ld   e, a
 745  8ABB 16 00            ld   d, 0
 746  8ABD 19               add  hl, de
 747  8ABE 19               add  hl, de                    ; HL = RoomsListTable + A * 2
 748  8ABF 5E               ld   e, (hl)
 749  8AC0 23               inc  hl
 750  8AC1 56               ld   d, (hl)                   ; DE = puntatore layout nuova stanza
 751  8AC2 ED 53 9E E5      ld   (room_ptr), de
 752  8AC6
 753  8AC6                  ; 4. Prepara lo stato per l'ingresso nella nuova stanza
 754  8AC6 AF               xor  a
 755  8AC7 32 A4 E5         ld   (transition_active), a    ; 0 = carica coordinate da OFFSET_POS_WILLY
 756  8ACA 32 2B E2         ld   (velocity_y), a
 757  8ACD 32 36 E8         ld   (game_objective_completed), a
 758  8AD0 3E 01            ld   a, 1
 759  8AD2 32 2C E2         ld   (on_ground), a
 760  8AD5
 761  8AD5                  ; 5. Pulisci lo schermo e avvia la nuova stanza
 762  8AD5 3E 07            ld   a, $07
 763  8AD7 CD 9D 62         call Gfx_ClearScreenDirect
 764  8ADA
 765  8ADA C3 6C 87         jp   LoadRoomAndRestart
 766  8ADD
 767  8ADD              .all_rooms_completed:
 768  8ADD                  ; Tutte le stanze sono state completate con successo!
 769  8ADD                  IF ENABLE_VICTORY_SCREEN != 0
 770  8ADD C3 D1 89         jp   TriggerVictory
 771  8AE0                  ELSE
 772  8AE0 ~                ; Ricomincia dalla prima stanza (Stanza 00)
 773  8AE0 ~                ld   de, (RoomsListTable)
 774  8AE0 ~                ld   (room_ptr), de
 775  8AE0 ~                xor  a
 776  8AE0 ~                ld   (transition_active), a
 777  8AE0 ~                ld   (velocity_y), a
 778  8AE0 ~                ld   (game_objective_completed), a
 779  8AE0 ~                ld   a, 1
 780  8AE0 ~                ld   (on_ground), a
 781  8AE0 ~                ld   a, $07
 782  8AE0 ~                call Gfx_ClearScreenDirect
 783  8AE0 ~                jp   LoadRoomAndRestart
 784  8AE0                  ENDIF
 785  8AE0
 786  8AE0              ; -------------------------------------------------------------------
 787  8AE0              ; Air_DepleteCountdown
 788  8AE0              ; Animazione originale di completamento livello (Manic Miner):
 789  8AE0              ; - Esegue il conto alla rovescia di tutti i pixel di aria rimanenti (air_pixels).
 790  8AE0              ; - Ad ogni pixel decrementato:
 791  8AE0              ;   * Aggiorna la barra dell'aria a schermo (Gfx_UpdateAirBar).
 792  8AE0              ;   * Aggiunge 1 punto allo score del giocatore (Score_Add1Point).
 793  8AE0              ;   * Produce un impulso sonoro sul buzzer dello speaker (porta $FE) con frequenza proporzionale all'aria.
 794  8AE0              ; -------------------------------------------------------------------
 795  8AE0              Air_DepleteCountdown:
 796  8AE0 F5               push af
 797  8AE1 C5               push bc
 798  8AE2 D5               push de
 799  8AE3 E5               push hl
 800  8AE4
 801  8AE4              .countdown_loop:
 802  8AE4 3A 3E E8         ld   a, (air_pixels)
 803  8AE7 B7               or   a
 804  8AE8 28 27            jr   z, .done_countdown        ; Barra dell'aria azzerata -> fine animazione
 805  8AEA
 806  8AEA 3D               dec  a
 807  8AEB 32 3E E8         ld   (air_pixels), a           ; Decrementa 1 pixel di aria
 808  8AEE
 809  8AEE                  ; Aggiorna la barra grafica dell'aria
 810  8AEE CD 27 6A         call Gfx_UpdateAirBar
 811  8AF1
 812  8AF1                  ; Aggiungi 1 punto allo score
 813  8AF1 CD 5C 86         call Score_Add1Point
 814  8AF4
 815  8AF4                  ; Genera l'effetto sonoro originale di Manic Miner:
 816  8AF4                  ; Pitch dipendente dai pixel di aria rimanenti (frequenza crescente man mano che si svuota)
 817  8AF4 3A 3E E8         ld   a, (air_pixels)
 818  8AF7 2F               cpl
 819  8AF8 E6 3F            and  63
 820  8AFA 07               rlca
 821  8AFB 3C               inc  a
 822  8AFC 57               ld   d, a                      ; D = ritardo semionda audio
 823  8AFD
 824  8AFD 0E 03            ld   c, 3                      ; Durata impulso
 825  8AFF              .audio_loop:
 826  8AFF AF               xor  a
 827  8B00 D3 FE            out  ($fe), a
 828  8B02 42               ld   b, d
 829  8B03 10 FE        .w1: djnz .w1
 830  8B05
 831  8B05 3E 18            ld   a, $18
 832  8B07 D3 FE            out  ($fe), a
 833  8B09 42               ld   b, d
 834  8B0A 10 FE        .w2: djnz .w2
 835  8B0C
 836  8B0C 0D               dec  c
 837  8B0D 20 F0            jr   nz, .audio_loop
 838  8B0F
 839  8B0F 18 D3            jr   .countdown_loop
 840  8B11
 841  8B11              .done_countdown:
 842  8B11 E1               pop  hl
 843  8B12 D1               pop  de
 844  8B13 C1               pop  bc
 845  8B14 F1               pop  af
 846  8B15 C9               ret
 847  8B16
 848  8B16              ; -------------------------------------------------------------------
 849  8B16              ; CheckAllItemsCollected
 850  8B16              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 851  8B16              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 852  8B16              ; -------------------------------------------------------------------
 853  8B16              CheckAllItemsCollected:
 854  8B16 3A 36 E8         ld   a, (game_objective_completed)
 855  8B19 B7               or   a
 856  8B1A 20 08            jr   nz, .all_collected
 857  8B1C 3A 9D E5         ld   a, (num_room_items)
 858  8B1F B7               or   a
 859  8B20 28 02            jr   z, .all_collected
 860  8B22 B7               or   a
 861  8B23 C9               ret
 862  8B24              .all_collected:
 863  8B24 37               scf
 864  8B25 C9               ret
 865  8B26
 866  8B26              ; -------------------------------------------------------------------
 867  8B26              ; CheckInMasterBedroom (alias per retrocompatibilità)
 868  8B26              ; -------------------------------------------------------------------
 869  8B26              CheckInMasterBedroom:
 870  8B26 37               scf
 871  8B27 C9               ret
 872  8B28
 873  8B28              ; -------------------------------------------------------------------
 874  8B28              ; CheckWillyConveyorCollision
 875  8B28              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 876  8B28              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 877  8B28              ; -------------------------------------------------------------------
 878  8B28              CheckWillyConveyorCollision:
 879  8B28 C5               push bc
 880  8B29 D5               push de
 881  8B2A E5               push hl
 882  8B2B
 883  8B2B                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 884  8B2B CD 0A 77         call CheckWillyOnConveyor

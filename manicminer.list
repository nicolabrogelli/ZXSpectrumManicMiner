2491+ 6AC0                  ; Determina il frame del corpo per le icone delle vite
2492+ 6AC0                  IF ENABLE_ANIMATE_LIVES != 0
2493+ 6AC0 ~                ; Calcola il frame animato dal contatore
2494+ 6AC0 ~                ld   a, (counter)

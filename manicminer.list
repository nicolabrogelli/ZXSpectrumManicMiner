  11+ 7E87              ; Struttura dati per i nemici attivi della stanza corrente (RAM)
  12+ 7E87              ; 8 slot, 11 byte ciascuno:
  13+ 7E87              ; Offset 0: Flags (Bit 7: Active, Bit 6: Vertical)
  14+ 7E87              ; Offset 1: Sprite Frame Offset / Tipo
  15+ 7E87              ; Offset 2: Current X
  16+ 7E87              ; Offset 3: Current Y
  17+ 7E87              ; Offset 4: Min Limit
  18+ 7E87              ; Offset 5: Max Limit
  19+ 7E87              ; Offset 6: Direction (1 = Left/Up, 2 = Right/Down)
  20+ 7E87              ; Offset 7: Anim State (0..3)
  21+ 7E87              ; Offset 8: Old X
  22+ 7E87              ; Offset 9: Old Y
  23+ 7E87              ; Offset 10: Color (Attributo Spectrum)
  24+ 7E87              ; -------------------------------------------------------------------
  25+ 7E87              ActiveEnemies:
  26+ 7E87 00          > db 0
  26+ 7E88 00          > db 0
  26+ 7E89 00          > db 0

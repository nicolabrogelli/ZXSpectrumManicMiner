 874  8A06 79               ld   a, c                  ; WillyLeft
 875  8A07 BA               cp   d
 876  8A08 28 04            jr   z, .x_overlap
 877  8A0A 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 878  8A0C 18 0E            jr   .no_conv_collision
 879  8A0E

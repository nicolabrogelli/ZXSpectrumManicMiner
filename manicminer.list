   6+ 82CA
   7+ 82CA              ; -------------------------------------------------------------------
   8+ 82CA              ; Audio_UpdateJumpSound
   9+ 82CA              ;
  10+ 82CA              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 82CA              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 82CA              ; -------------------------------------------------------------------
  13+ 82CA              Audio_UpdateJumpSound:
  14+ 82CA F5               push af
  15+ 82CB C5               push bc
  16+ 82CC D5               push de
  17+ 82CD E5               push hl
  18+ 82CE
  19+ 82CE                  ; Controlla se il suono è attivo (note < 18)
  20+ 82CE 3A 20 A4         ld   a, (Audio_jump_sound_note)
  21+ 82D1 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 82D3 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 82D5
  24+ 82D5                  ; Carica la nota corrente da suonare
  25+ 82D5 5F               ld   e, a
  26+ 82D6 16 00            ld   d, 0
  27+ 82D8 21 04 83         ld   hl, Audio_JumpSoundDelays
  28+ 82DB 19               add  hl, de
  29+ 82DC 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 82DD 57               ld   d, a                      ; D = delay della nota
  31+ 82DE
  32+ 82DE                  ; Suona la nota: 15 cicli
  33+ 82DE 06 0F            ld   b, 15
  34+ 82E0              .note_loop:
  35+ 82E0                  ; Speaker ON
  36+ 82E0 3A 10 9E         ld   a, (room_border_color)
  37+ 82E3 F6 10            or   $10
  38+ 82E5 D3 FE            out  ($fe), a
  39+ 82E7 4A               ld   c, d
  40+ 82E8              .d1:
  41+ 82E8 0D               dec  c
  42+ 82E9 20 FD            jr   nz, .d1
  43+ 82EB
  44+ 82EB                  ; Speaker OFF
  45+ 82EB 3A 10 9E         ld   a, (room_border_color)
  46+ 82EE E6 EF            and  $ef
  47+ 82F0 D3 FE            out  ($fe), a
  48+ 82F2 4A               ld   c, d
  49+ 82F3              .d2:
  50+ 82F3 0D               dec  c
  51+ 82F4 20 FD            jr   nz, .d2
  52+ 82F6
  53+ 82F6 10 E8            djnz .note_loop
  54+ 82F8
  55+ 82F8                  ; Passa alla nota successiva
  56+ 82F8 3A 20 A4         ld   a, (Audio_jump_sound_note)
  57+ 82FB 3C               inc  a
  58+ 82FC 32 20 A4         ld   (Audio_jump_sound_note), a

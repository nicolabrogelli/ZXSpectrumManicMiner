1575+ 6615              ; -------------------------------------------------------------------
1576+ 6615              ; Gfx_DrawGameOverScreen
1577+ 6615              ; Esegue la sequenza animata di Game Over:
1578+ 6615              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1579+ 6615              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1580+ 6615              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1581+ 6615              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1582+ 6615              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1583+ 6615              ; -------------------------------------------------------------------
1584+ 6615              Gfx_DrawGameOverScreen:
1585+ 6615 F5               push af
1586+ 6616 C5               push bc
1587+ 6617 D5               push de
1588+ 6618 E5               push hl
1589+ 6619 DD E5            push ix
1590+ 661B
1591+ 661B                  ; 1. Bordo hardware e schermo a nero
1592+ 661B AF               xor  a
1593+ 661C D3 FE            out  ($fe), a              ; Bordo a nero
1594+ 661E CD 99 62         call Gfx_ClearScreenDirect ; Pulisce tutti i pixel e gli attributi a nero
1595+ 6621
1596+ 6621                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1597+ 6621                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1598+ 6621 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1599+ 6624 DD 21 5D DA      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1600+ 6628 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1601+ 662B
1602+ 662B                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1603+ 662B 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1604+ 662E DD 21 65 DA      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1605+ 6632 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1606+ 6635
1607+ 6635                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96
1608+ 6635 01 7C 60         ld   bc, $607c             ; B = Y = 96, C = X = 124
1609+ 6638 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1610+ 663A CD 12 6D         call Gfx_SetEnemyColorAttributes
1611+ 663D
1612+ 663D                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1613+ 663D 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1614+ 6640 DD 21 35 6E      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1615+ 6644 CD 6B 5F         call Gfx_DrawPixelSprite16x16
1616+ 6647
1617+ 6647                  ; 3b. Imposta attributi colore per BotteSprite (Rosso Brillante) a X=120, Y=112
1618+ 6647 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1619+ 664A 3E 42            ld   a, RED | $40          ; Rosso Brillante
1620+ 664C CD 12 6D         call Gfx_SetEnemyColorAttributes
1621+ 664F
1622+ 664F                  ; 4. Stampa il Nome della Stanza a riga 16
1623+ 664F CD BC 62         call Gfx_PrintRoomName
1624+ 6652
1625+ 6652                  ; 5. Stampa la riga di stato a riga 18
1626+ 6652 21 5B 69         ld   hl, status_line       ; HL = indirizzo stringa di stato
1627+ 6655 06 20            ld   b, 32                 ; B = 32 caratteri
1628+ 6657 16 12            ld   d, 18
1629+ 6659 1E 00            ld   e, 0
1630+ 665B CD 3D 62         call Gfx_PrintDirectText
1631+ 665E
1632+ 665E                  ; 6. Applica i colori agli attributi di riga 18 ($5A40)
1633+ 665E 21 7B 69         ld   hl, status_line_attrs
1634+ 6661 11 40 5A         ld   de, $5a40             ; Indirizzo attributi riga 18
1635+ 6664 01 20 00         ld   bc, 32
1636+ 6667 ED B0            ldir
1637+ 6669
1638+ 6669                  ; 7. Animazione: Discesa fluida di PiedeSprite dall'alto (Y=0) fino a Y=96 (alla parte alta della Botte)
1639+ 6669 06 00            ld   b, 0                  ; B = Y iniziale (0)
1640+ 666B              .foot_descent_loop:
1641+ 666B C5               push bc                    ; Salva B = Y corrente
1642+ 666C
1643+ 666C                  ; 7a. Cancella l'intero blocco 16x16 della posizione precedente (Y - 2) se Y > 0
1644+ 666C 78               ld   a, b
1645+ 666D B7               or   a
1646+ 666E 28 1F            jr   z, .skip_clear_prev
1647+ 6670 D6 02            sub  2                     ; Y precedente (passo 2 pixel)
1648+ 6672 47               ld   b, a
1649+ 6673 0E 78            ld   c, 120                ; X = 120
1650+ 6675 CD 1C 63         call Gfx_Clear16x16_Black
1651+ 6678
1652+ 6678                  ; Pulisce l'attributo della riga lasciata indietro (Row = (Y - 2) / 8)
1653+ 6678 78               ld   a, b
1654+ 6679 CB 3F            srl  a
1655+ 667B CB 3F            srl  a
1656+ 667D CB 3F            srl  a                     ; A = Row da azzerare
1657+ 667F 6F               ld   l, a
1658+ 6680 26 00            ld   h, 0
1659+ 6682 29               add  hl, hl                ; * 2
1660+ 6683 29               add  hl, hl                ; * 4
1661+ 6684 29               add  hl, hl                ; * 8
1662+ 6685 29               add  hl, hl                ; * 16
1663+ 6686 29               add  hl, hl                ; * 32
1664+ 6687 11 0F 58         ld   de, $580f             ; $5800 + 15
1665+ 668A 19               add  hl, de
1666+ 668B AF               xor  a
1667+ 668C 77               ld   (hl), a               ; Col 15 = 0
1668+ 668D 23               inc  hl
1669+ 668E 77               ld   (hl), a               ; Col 16 = 0
1670+ 668F
1671+ 668F              .skip_clear_prev:
1672+ 668F C1               pop  bc                    ; Ripristina B = Y corrente
1673+ 6690 C5               push bc
1674+ 6691
1675+ 6691                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1676+ 6691 78               ld   a, b
1677+ 6692 FE 60            cp   96
1678+ 6694 20 09            jr   nz, .draw_foot
1679+ 6696 C5               push bc
1680+ 6697 0E 78            ld   c, 120
1681+ 6699 06 60            ld   b, 96
1682+ 669B CD 1C 63         call Gfx_Clear16x16_Black
1683+ 669E C1               pop  bc
1684+ 669F
1685+ 669F              .draw_foot:
1686+ 669F                  ; 7b. Disegna PiedeSprite alla coordinata corrente (X=120, Y)
1687+ 669F 0E 78            ld   c, 120
1688+ 66A1 DD 21 15 6E      ld   ix, PiedeSprite
1689+ 66A5 CD 6B 5F         call Gfx_DrawPixelSprite16x16
1690+ 66A8
1691+ 66A8                  ; 7c. Imposta colore Giallo Brillante per PiedeSprite
1692+ 66A8 0E 78            ld   c, 120
1693+ 66AA 3E 46            ld   a, YELLOW | $40
1694+ 66AC CD 12 6D         call Gfx_SetEnemyColorAttributes
1695+ 66AF
1696+ 66AF                  ; 7d. Pausa per movimento fluido a 50Hz
1697+ 66AF 76               halt
1698+ 66B0
1699+ 66B0 C1               pop  bc                    ; B = Y corrente
1700+ 66B1 78               ld   a, b
1701+ 66B2 C6 02            add  a, 2                  ; Avanza di 2 pixel
1702+ 66B4 47               ld   b, a
1703+ 66B5 FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1704+ 66B7 38 B2            jr   c, .foot_descent_loop
1705+ 66B9
1706+ 66B9                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1707+ 66B9 06 23            ld   b, 35
1708+ 66BB              .pause_after_foot:
1709+ 66BB 76               halt
1710+ 66BC 10 FD            djnz .pause_after_foot
1711+ 66BE
1712+ 66BE                  ; 9. Solo DOPO la pausa, fa comparire GAME OVER al centro dello schermo a riga 5, colonna 11
1713+ 66BE 21 B4 65         ld   hl, game_over_str
1714+ 66C1 06 09            ld   b, 9
1715+ 66C3 16 05            ld   d, 5
1716+ 66C5 1E 0B            ld   e, 11
1717+ 66C7 CD 3D 62         call Gfx_PrintDirectText
1718+ 66CA
1719+ 66CA                  ; Imposta attributo iniziale per GAME OVER (Rosso Brillante)
1720+ 66CA 21 AB 58         ld   hl, $58ab             ; Riga 5, Colonna 11 ($5800 + 5*32 + 11 = $58AB)
1721+ 66CD 06 09            ld   b, 9
1722+ 66CF 3E 42            ld   a, RED | $40
1723+ 66D1              .init_go_attr:

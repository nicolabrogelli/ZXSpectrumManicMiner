 298+ 81BF              DrawItemGraphic:
 299+ 81BF C5               push bc
 300+ 81C0 D5               push de
 301+ 81C1 E5               push hl
 302+ 81C2
 303+ 81C2                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 304+ 81C2 78               ld   a, b
 305+ 81C3 E6 18            and  $18
 306+ 81C5 C6 40            add  a, $40
 307+ 81C7 57               ld   d, a                      ; Byte alto indirizzo video
 308+ 81C8
 309+ 81C8 78               ld   a, b
 310+ 81C9 E6 07            and  7
 311+ 81CB 87               add  a, a                      ; *2
 312+ 81CC 87               add  a, a                      ; *4
 313+ 81CD 87               add  a, a                      ; *8
 314+ 81CE 87               add  a, a                      ; *16
 315+ 81CF 87               add  a, a                      ; *32
 316+ 81D0 81               add  a, c                      ; + Col
 317+ 81D1 5F               ld   e, a                      ; Byte basso indirizzo video
 318+ 81D2
 319+ 81D2 C5               push bc
 320+ 81D3 06 08            ld   b, 8                      ; 8 scanline
 321+ 81D5              .line_loop:
 322+ 81D5 7E               ld   a, (hl)
 323+ 81D6 12               ld   (de), a
 324+ 81D7 14               inc  d
 325+ 81D8 23               inc  hl
 326+ 81D9 05               dec  b
 327+ 81DA 20 F9            jr   nz, .line_loop
 328+ 81DC C1               pop  bc

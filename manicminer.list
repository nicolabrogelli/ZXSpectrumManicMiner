 319+ 7E88 90               sub  b                  ; A = WillyY - EnemyY
 320+ 7E89 C6 0F            add  a, 15
 321+ 7E8B FE 1F            cp   31
 322+ 7E8D D0               ret  nc                 ; Fuori portata Y

  12+ 801A              ; DetermineCurrentRoomID
  13+ 801A              ;
  14+ 801A              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 801A              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 801A              ;
  17+ 801A              ; Output:
  18+ 801A              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 801A              ;   (current_room) = A
  20+ 801A              ; -------------------------------------------------------------------
  21+ 801A              DetermineCurrentRoomID:
  22+ 801A E5               push hl
  23+ 801B D5               push de
  24+ 801C C5               push bc
  25+ 801D
  26+ 801D 21 04 73         ld   hl, RoomsListTable
  27+ 8020 ED 5B 80 99      ld   de, (room_ptr)

 241+ 7D33              ; DrawItemGraphic
 242+ 7D33              ;
 243+ 7D33              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 244+ 7D33              ; utilizzando una bitmap di 8 byte e un attributo colore.
 245+ 7D33              ;
 246+ 7D33              ; Input:
 247+ 7D33              ;   B = Riga attributi (0..23)
 248+ 7D33              ;   C = Colonna attributi (0..31)
 249+ 7D33              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)
 250+ 7D33              ;   E = Attributo colore

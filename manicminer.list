2177+ 695E D5               push de
2178+ 695F E5               push hl
2179+ 6960
2180+ 6960                  ; 1. Calcola indirizzo dello schermo (bitmap) per Row B, Col C, scanline 0
2181+ 6960                  ; HighByte = $40 + (B & $18)
2182+ 6960 78               ld   a, b

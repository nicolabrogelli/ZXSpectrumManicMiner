  12+ 7CCE              ; DetermineCurrentRoomID
  13+ 7CCE              ;
  14+ 7CCE              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7CCE              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7CCE              ;
  17+ 7CCE              ; Output:
  18+ 7CCE              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7CCE              ;   (current_room) = A
  20+ 7CCE              ; -------------------------------------------------------------------
  21+ 7CCE              DetermineCurrentRoomID:
  22+ 7CCE E5               push hl
  23+ 7CCF D5               push de
  24+ 7CD0 C5               push bc
  25+ 7CD1
  26+ 7CD1 21 DF 6F         ld   hl, RoomsListTable
  27+ 7CD4 ED 5B E5 91      ld   de, (room_ptr)
  28+ 7CD8 06 01            ld   b, NUM_ROOMS
  29+ 7CDA 0E 00            ld   c, 0
  30+ 7CDC
  31+ 7CDC              .loop:
  32+ 7CDC 7E               ld   a, (hl)
  33+ 7CDD BB               cp   e
  34+ 7CDE 20 06            jr   nz, .no_match
  35+ 7CE0 23               inc  hl
  36+ 7CE1 7E               ld   a, (hl)
  37+ 7CE2 BA               cp   d
  38+ 7CE3 28 08            jr   z, .found
  39+ 7CE5 2B               dec  hl
  40+ 7CE6
  41+ 7CE6              .no_match:
  42+ 7CE6 23               inc  hl
  43+ 7CE7 23               inc  hl
  44+ 7CE8 0C               inc  c
  45+ 7CE9 10 F1            djnz .loop
  46+ 7CEB
  47+ 7CEB 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7CED
  49+ 7CED              .found:
  50+ 7CED 79               ld   a, c
  51+ 7CEE 32 8B 91         ld   (current_room), a
  52+ 7CF1
  53+ 7CF1 C1               pop  bc
  54+ 7CF2 D1               pop  de
  55+ 7CF3 E1               pop  hl
  56+ 7CF4 C9               ret

 353+ 7EA9 E6 80            and  $80               ; Active?
 354+ 7EAB 28 35            jr   z, .do_erase_inactive_slot
 355+ 7EAD
 356+ 7EAD                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 357+ 7EAD DD 7E 08         ld   a, (ix+8)         ; Old X
 358+ 7EB0 DD BE 02         cp   (ix+2)            ; Current X
 359+ 7EB3 20 0E            jr   nz, .do_erase_slot
 360+ 7EB5 DD 7E 09         ld   a, (ix+9)         ; Old Y
 361+ 7EB8 DD BE 03         cp   (ix+3)            ; Current Y
 362+ 7EBB 20 06            jr   nz, .do_erase_slot

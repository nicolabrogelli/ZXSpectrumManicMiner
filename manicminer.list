 404+ 7E53              ; -------------------------------------------------------------------
 405+ 7E53              ; CheckWillyItemCollision
 406+ 7E53              ;
 407+ 7E53              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 408+ 7E53              ; Input:
 409+ 7E53              ;   A = Item Col (0..31)
 410+ 7E53              ;   H = Item Row (0..15)
 411+ 7E53              ; Output:
 412+ 7E53              ;   Carry Set = Collisione
 413+ 7E53              ;   Carry Clear = Nessuna collisione
 414+ 7E53              ; -------------------------------------------------------------------
 415+ 7E53              CheckWillyItemCollision:
 416+ 7E53 C5               push bc
 417+ 7E54 D5               push de
 418+ 7E55 E5               push hl
 419+ 7E56
 420+ 7E56                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 421+ 7E56 6F               ld   l, a
 422+ 7E57 87               add  a, a                      ; *2
 423+ 7E58 87               add  a, a                      ; *4
 424+ 7E59 87               add  a, a                      ; *8
 425+ 7E5A 5F               ld   e, a                      ; E = ItemLeft
 426+ 7E5B C6 07            add  a, 7
 427+ 7E5D 57               ld   d, a                      ; D = ItemRight
 428+ 7E5E
 429+ 7E5E ED 4B 65 8E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 430+ 7E62
 431+ 7E62                  ; WillyLeft <= ItemRight
 432+ 7E62 79               ld   a, c
 433+ 7E63 BA               cp   d
 434+ 7E64 28 04            jr   z, .x_ok
 435+ 7E66 38 02            jr   c, .x_ok
 436+ 7E68 18 29            jr   .no_collision
 437+ 7E6A
 438+ 7E6A              .x_ok:
 439+ 7E6A                  ; WillyRight >= ItemLeft (WillyRight = WillyX + 7 o 15)
 440+ 7E6A C6 07            add  a, 7
 441+ 7E6C BB               cp   e
 442+ 7E6D 28 04            jr   z, .y_check
 443+ 7E6F 30 02            jr   nc, .y_check
 444+ 7E71 18 20            jr   .no_collision
 445+ 7E73
 446+ 7E73              .y_check:
 447+ 7E73 E1               pop  hl
 448+ 7E74 E5               push hl
 449+ 7E75
 450+ 7E75                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 451+ 7E75 7C               ld   a, h
 452+ 7E76 87               add  a, a                      ; *2
 453+ 7E77 87               add  a, a                      ; *4
 454+ 7E78 87               add  a, a                      ; *8
 455+ 7E79 5F               ld   e, a                      ; ItemTop
 456+ 7E7A C6 07            add  a, 7
 457+ 7E7C 57               ld   d, a                      ; ItemBottom
 458+ 7E7D
 459+ 7E7D                  ; WillyTop <= ItemBottom
 460+ 7E7D 78               ld   a, b
 461+ 7E7E BA               cp   d
 462+ 7E7F 28 04            jr   z, .y_ok
 463+ 7E81 38 02            jr   c, .y_ok
 464+ 7E83 18 0E            jr   .no_collision
 465+ 7E85
 466+ 7E85              .y_ok:
 467+ 7E85                  ; WillyBottom >= ItemTop (WillyBottom = WillyY + 15)
 468+ 7E85 C6 0F            add  a, 15
 469+ 7E87 BB               cp   e
 470+ 7E88 28 04            jr   z, .collision
 471+ 7E8A 30 02            jr   nc, .collision
 472+ 7E8C 18 05            jr   .no_collision
 473+ 7E8E
 474+ 7E8E              .collision:
 475+ 7E8E E1               pop  hl
 476+ 7E8F D1               pop  de
 477+ 7E90 C1               pop  bc
 478+ 7E91 37               scf
 479+ 7E92 C9               ret
 480+ 7E93
 481+ 7E93              .no_collision:
 482+ 7E93 E1               pop  hl
 483+ 7E94 D1               pop  de
 484+ 7E95 C1               pop  bc
 485+ 7E96 B7               or   a
 486+ 7E97 C9               ret
 487+ 7E98
 488+ 7E98              ; -------------------------------------------------------------------
 489+ 7E98              ; Items_CheckCollision
 490+ 7E98              ;
 491+ 7E98              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 492+ 7E98              ; -------------------------------------------------------------------
 493+ 7E98              Items_CheckCollision:
 494+ 7E98 E5               push hl
 495+ 7E99 D5               push de
 496+ 7E9A C5               push bc
 497+ 7E9B FD E5            push iy
 498+ 7E9D
 499+ 7E9D 3A E4 91         ld   a, (num_room_items)
 500+ 7EA0 B7               or   a
 501+ 7EA1 28 63            jr   z, .done
 502+ 7EA3
 503+ 7EA3 47               ld   b, a                      ; B = numero item attivi
 504+ 7EA4 FD 21 94 91      ld   iy, current_room_items
 505+ 7EA8
 506+ 7EA8              .loop:
 507+ 7EA8 FD 7E 02         ld   a, (iy+2)                 ; Color / Active
 508+ 7EAB B7               or   a
 509+ 7EAC 28 51            jr   z, .next_item
 510+ 7EAE
 511+ 7EAE FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 512+ 7EB1 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 513+ 7EB4
 514+ 7EB4 79               ld   a, c
 515+ 7EB5 CD 53 7E         call CheckWillyItemCollision
 516+ 7EB8 30 45            jr   nc, .next_item
 517+ 7EBA
 518+ 7EBA                  ; --- ITEM RACCOLTO ---
 519+ 7EBA                  ; 1. Imposta il flag collected nei dati stanza
 520+ 7EBA FD 6E 03         ld   l, (iy+3)
 521+ 7EBD FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 522+ 7EC0 36 00            ld   (hl), 0                   ; 0 = raccolto
 523+ 7EC2
 524+ 7EC2                  ; 2. Rimuovi dalla griglia items_grid
 525+ 7EC2 FD 4E 00         ld   c, (iy+0)
 526+ 7EC5 FD 46 01         ld   b, (iy+1)
 527+ 7EC8 C5               push bc
 528+ 7EC9 26 00            ld   h, 0
 529+ 7ECB 68               ld   l, b
 530+ 7ECC 29               add  hl, hl
 530+ 7ECD 29             add hl, hl
 530+ 7ECE 29             add hl, hl
 530+ 7ECF 29             add hl, hl
 530+ 7ED0 29             add hl, hl
 531+ 7ED1 59               ld   e, c
 532+ 7ED2 16 00            ld   d, 0
 533+ 7ED4 19               add  hl, de
 534+ 7ED5 11 65 8C         ld   de, items_grid
 535+ 7ED8 19               add  hl, de
 536+ 7ED9 36 00            ld   (hl), 0
 537+ 7EDB C1               pop  bc
 538+ 7EDC
 539+ 7EDC                  ; 3. Disattiva lo slot nella cache
 540+ 7EDC FD 36 02 00      ld   (iy+2), 0
 541+ 7EE0
 542+ 7EE0                  ; 4. Decrementa il numero di item rimanenti nella stanza corrente
 543+ 7EE0 21 E4 91         ld   hl, num_room_items
 544+ 7EE3 7E               ld   a, (hl)
 545+ 7EE4 B7               or   a
 546+ 7EE5 28 08            jr   z, .no_dec_room
 547+ 7EE7 35               dec  (hl)
 548+ 7EE8 20 05            jr   nz, .no_dec_room
 549+ 7EEA                  ; Ultimo item della stanza raccolto -> Attiva il portale!
 550+ 7EEA 3E 01            ld   a, 1
 551+ 7EEC 32 7A 94         ld   (game_objective_completed), a
 552+ 7EEF              .no_dec_room:
 553+ 7EEF
 554+ 7EEF                  ; Incrementa il conteggio globale degli item raccolti
 555+ 7EEF 3A 6F 8E         ld   a, (items_collected)
 556+ 7EF2 3C               inc  a
 557+ 7EF3 32 6F 8E         ld   (items_collected), a
 558+ 7EF6
 559+ 7EF6                  ; 5. Aggiungi 100 punti allo Score, aggiorna High Score e aggiorna la visualizzazione HUD
 560+ 7EF6 CD 2A 7F         call Score_AddItemPoints
 561+ 7EF9
 562+ 7EF9                  ; 6. Ripristina il tile di sfondo
 563+ 7EF9 CD 21 7E         call RestoreBackgroundCell
 564+ 7EFC
 565+ 7EFC                  ; 7. Suono di raccolta
 566+ 7EFC CD CD 7F         call Audio_PlayCollectSound
 567+ 7EFF
 568+ 7EFF              .next_item:
 569+ 7EFF 11 05 00         ld   de, 5
 570+ 7F02 FD 19            add  iy, de
 571+ 7F04 10 A2            djnz .loop
 572+ 7F06
 573+ 7F06              .done:
 574+ 7F06 FD E1            pop  iy
 575+ 7F08 C1               pop  bc
 576+ 7F09 D1               pop  de
 577+ 7F0A E1               pop  hl
 578+ 7F0B C9               ret
 579+ 7F0C
 580+ 7F0C              ; -------------------------------------------------------------------
 581+ 7F0C              ; CheckActiveItemAtCell
 582+ 7F0C              ;
 583+ 7F0C              ; Verifica rapida su griglia se c'è un item attivo alla cella (B=Col, C=Row)
 584+ 7F0C              ; Output: Carry Set = Item presente, Carry Clear = Nessun item
 585+ 7F0C              ; -------------------------------------------------------------------
 586+ 7F0C              CheckActiveItemAtCell:
 587+ 7F0C D5               push de
 588+ 7F0D E5               push hl
 589+ 7F0E
 590+ 7F0E 26 00            ld   h, 0
 591+ 7F10 69               ld   l, c                      ; HL = Row
 592+ 7F11 29               add  hl, hl
 592+ 7F12 29             add hl, hl
 592+ 7F13 29             add hl, hl
 592+ 7F14 29             add hl, hl
 592+ 7F15 29             add hl, hl
 593+ 7F16 58               ld   e, b
 594+ 7F17 16 00            ld   d, 0
 595+ 7F19 19               add  hl, de
 596+ 7F1A 11 65 8C         ld   de, items_grid
 597+ 7F1D 19               add  hl, de
 598+ 7F1E 7E               ld   a, (hl)
 599+ 7F1F B7               or   a
 600+ 7F20 28 04            jr   z, .not_active
 601+ 7F22
 602+ 7F22 E1               pop  hl
 603+ 7F23 D1               pop  de
 604+ 7F24 37               scf
 605+ 7F25 C9               ret
 606+ 7F26
 607+ 7F26              .not_active:
 608+ 7F26 E1               pop  hl
 609+ 7F27 D1               pop  de
 610+ 7F28 B7               or   a
 611+ 7F29 C9               ret
 612+ 7F2A
 613+ 7F2A              ; -------------------------------------------------------------------
 614+ 7F2A              ; Score_AddItemPoints
 615+ 7F2A              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 616+ 7F2A              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 617+ 7F2A              ; -------------------------------------------------------------------
 618+ 7F2A              Score_AddItemPoints:
 619+ 7F2A F5               push af
 620+ 7F2B C5               push bc
 621+ 7F2C D5               push de
 622+ 7F2D E5               push hl
 623+ 7F2E
 624+ 7F2E                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 625+ 7F2E 3A 75 94         ld   a, (player_score + 1)
 626+ 7F31 C6 01            add  a, $01
 627+ 7F33 27               daa
 628+ 7F34 32 75 94         ld   (player_score + 1), a
 629+ 7F37
 630+ 7F37                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 631+ 7F37 3A 76 94         ld   a, (player_score + 2)
 632+ 7F3A CE 00            adc  a, 0
 633+ 7F3C 27               daa
 634+ 7F3D 32 76 94         ld   (player_score + 2), a
 635+ 7F40
 636+ 7F40                  ; Controlla se player_score ha superato high_score
 637+ 7F40 CD 4B 7F         call Score_CheckAndUpdateHighScore
 638+ 7F43
 639+ 7F43                  ; Aggiorna visualizzazione a schermo
 640+ 7F43 CD 63 67         call Gfx_UpdateScoreDisplay
 641+ 7F46
 642+ 7F46 E1               pop  hl
 643+ 7F47 D1               pop  de
 644+ 7F48 C1               pop  bc
 645+ 7F49 F1               pop  af
 646+ 7F4A C9               ret
 647+ 7F4B
 648+ 7F4B              ; -------------------------------------------------------------------
 649+ 7F4B              ; Score_CheckAndUpdateHighScore
 650+ 7F4B              ; Se player_score > high_score, copia player_score in high_score.
 651+ 7F4B              ; -------------------------------------------------------------------
 652+ 7F4B              Score_CheckAndUpdateHighScore:
 653+ 7F4B                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 654+ 7F4B                  ; Byte 2:
 655+ 7F4B 3A 76 94         ld   a, (player_score + 2)
 656+ 7F4E 47               ld   b, a
 657+ 7F4F 3A 79 94         ld   a, (high_score + 2)
 658+ 7F52 B8               cp   b
 659+ 7F53 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 660+ 7F55 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 661+ 7F57
 662+ 7F57                  ; Byte 1:
 663+ 7F57 3A 75 94         ld   a, (player_score + 1)
 664+ 7F5A 47               ld   b, a
 665+ 7F5B 3A 78 94         ld   a, (high_score + 1)
 666+ 7F5E B8               cp   b
 667+ 7F5F 38 0C            jr   c, .new_high_score
 668+ 7F61 20 1C            jr   nz, .done_check
 669+ 7F63
 670+ 7F63                  ; Byte 0:
 671+ 7F63 3A 74 94         ld   a, (player_score + 0)
 672+ 7F66 47               ld   b, a
 673+ 7F67 3A 77 94         ld   a, (high_score + 0)
 674+ 7F6A B8               cp   b
 675+ 7F6B 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 676+ 7F6D
 677+ 7F6D              .new_high_score:
 678+ 7F6D 3A 74 94         ld   a, (player_score + 0)
 679+ 7F70 32 77 94         ld   (high_score + 0), a
 680+ 7F73 3A 75 94         ld   a, (player_score + 1)
 681+ 7F76 32 78 94         ld   (high_score + 1), a
 682+ 7F79 3A 76 94         ld   a, (player_score + 2)
 683+ 7F7C 32 79 94         ld   (high_score + 2), a
 684+ 7F7F

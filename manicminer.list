  96+ 7E1A 87             add a, a
  96+ 7E1B 87             add a, a
  97+ 7E1C DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7E1F
  99+ 7E1F                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7E1F CB 3C            srl  h

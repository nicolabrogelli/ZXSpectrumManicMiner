 102+ 6CCD                  ; Se Willy è su un conveyor in qualsiasi stanza,
 103+ 6CCD                  ; impedisci lo spostamento nella direzione opposta a quella del conveyor.
 104+ 6CCD F5               push af
 105+ 6CCE CD D0 73         call CheckWillyOnConveyor
 106+ 6CD1 30 12            jr   nc, .no_block_conveyor
 107+ 6CD3 F1               pop  af
 108+ 6CD4 47               ld   b, a                   ; Salva stato dei tasti in B
 109+ 6CD5 3A CE 90         ld   a, (conveyor_dir)
 110+ 6CD8 B7               or   a                      ; 0 = conveyor va a sinistra, non-0 = va a destra
 111+ 6CD9 20 06            jr   nz, .conveyor_block_left
 112+ 6CDB                  ; Conveyor va a sinistra: disabilita tasto destra (P / bit 0)
 113+ 6CDB 78               ld   a, b
 114+ 6CDC F6 01            or   $01                    ; Forza bit 0 (destra) a 1 (non premuto)
 115+ 6CDE F5               push af
 116+ 6CDF 18 04            jr   .no_block_conveyor
 117+ 6CE1              .conveyor_block_left:
 118+ 6CE1                  ; Conveyor va a destra: disabilita tasto sinistra (O / bit 1)
 119+ 6CE1 78               ld   a, b
 120+ 6CE2 F6 02            or   $02                    ; Forza bit 1 (sinistra) a 1 (non premuto)
 121+ 6CE4 F5               push af
 122+ 6CE5              .no_block_conveyor:
 123+ 6CE5 F1               pop  af

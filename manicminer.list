  84+ C0DF
  85+ C0DF              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ C0DF 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ C0E2 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ C0E5 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ C0E6 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ C0E7 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ C0E8 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ C0E9 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ C0EA 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ C0EB
  95+ C0EB 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ C0EC 00           Audio_jump_sound_timer:   db 0

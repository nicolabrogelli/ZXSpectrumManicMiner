 673+ 82B4                  ; Byte 1:
 674+ 82B4 3A 12 A0         ld   a, (player_score + 1)
 675+ 82B7 47               ld   b, a
 676+ 82B8 3A 15 A0         ld   a, (high_score + 1)
 677+ 82BB B8               cp   b
 678+ 82BC 38 0C            jr   c, .new_high_score
 679+ 82BE 20 1C            jr   nz, .done_check
 680+ 82C0
 681+ 82C0                  ; Byte 0:
 682+ 82C0 3A 11 A0         ld   a, (player_score + 0)
 683+ 82C3 47               ld   b, a
 684+ 82C4 3A 14 A0         ld   a, (high_score + 0)
 685+ 82C7 B8               cp   b
 686+ 82C8 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

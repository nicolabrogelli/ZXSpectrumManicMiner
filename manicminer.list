   8+ 840A              ; Audio_UpdateJumpSound
   9+ 840A              ;
  10+ 840A              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 840A              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 840A              ; -------------------------------------------------------------------
  13+ 840A              Audio_UpdateJumpSound:
  14+ 840A F5               push af
  15+ 840B C5               push bc
  16+ 840C D5               push de
  17+ 840D E5               push hl
  18+ 840E
  19+ 840E                  ; Controlla se il suono è attivo (note < 18)
  20+ 840E 3A 2F E5         ld   a, (Audio_jump_sound_note)
  21+ 8411 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8413 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8415
  24+ 8415                  ; Carica la nota corrente da suonare
  25+ 8415 5F               ld   e, a
  26+ 8416 16 00            ld   d, 0
  27+ 8418 21 44 84         ld   hl, Audio_JumpSoundDelays
  28+ 841B 19               add  hl, de
  29+ 841C 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 841D 57               ld   d, a                      ; D = delay della nota
  31+ 841E
  32+ 841E                  ; Suona la nota: 15 cicli
  33+ 841E 06 0F            ld   b, 15
  34+ 8420              .note_loop:
  35+ 8420                  ; Speaker ON
  36+ 8420 3A 1E DF         ld   a, (room_border_color)
  37+ 8423 F6 10            or   $10
  38+ 8425 D3 FE            out  ($fe), a
  39+ 8427 4A               ld   c, d
  40+ 8428              .d1:
  41+ 8428 0D               dec  c
  42+ 8429 20 FD            jr   nz, .d1
  43+ 842B
  44+ 842B                  ; Speaker OFF
  45+ 842B 3A 1E DF         ld   a, (room_border_color)
  46+ 842E E6 EF            and  $ef
  47+ 8430 D3 FE            out  ($fe), a
  48+ 8432 4A               ld   c, d
  49+ 8433              .d2:
  50+ 8433 0D               dec  c
  51+ 8434 20 FD            jr   nz, .d2
  52+ 8436
  53+ 8436 10 E8            djnz .note_loop
  54+ 8438
  55+ 8438                  ; Passa alla nota successiva
  56+ 8438 3A 2F E5         ld   a, (Audio_jump_sound_note)
  57+ 843B 3C               inc  a
  58+ 843C 32 2F E5         ld   (Audio_jump_sound_note), a

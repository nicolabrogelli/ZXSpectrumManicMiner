  72+ 871D ~            ; Audio_UpdateMusic
  73+ 871D ~            ;
  74+ 871D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 871D ~            ; Viene chiamata a ogni frame.
  76+ 871D ~            ; -------------------------------------------------------------------
  77+ 871D ~            Audio_UpdateMusic:
  78+ 871D ~                push af
  79+ 871D ~                push bc
  80+ 871D ~                push de
  81+ 871D ~                push hl
  82+ 871D ~
  83+ 871D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 871D ~                ld   a, (Audio_jump_sound_note)
  85+ 871D ~                cp   18
  86+ 871D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 871D ~
  88+ 871D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 871D ~                ld   a, (Audio_music_frame_counter)
  90+ 871D ~                dec  a
  91+ 871D ~                ld   (Audio_music_frame_counter), a
  92+ 871D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 871D ~
  94+ 871D ~                ; Altrimenti carica la nota successiva
  95+ 871D ~                ld   a, (Audio_music_note_idx)
  96+ 871D ~                inc  a
  97+ 871D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 871D ~                jr   c, .no_wrap
  99+ 871D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 871D ~            .no_wrap:
 101+ 871D ~                ld   (Audio_music_note_idx), a
 102+ 871D ~
 103+ 871D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 871D ~                ld   e, a
 105+ 871D ~                ld   d, 0
 106+ 871D ~                ld   hl, Audio_MusicSheet
 107+ 871D ~                add  hl, de
 108+ 871D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 871D ~
 110+ 871D ~                ; Leggi durata (secondo byte)
 111+ 871D ~                inc  hl
 112+ 871D ~                ld   a, (hl)
 113+ 871D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 871D ~                jr   nz, .dur_ok
 115+ 871D ~                ld   a, 1
 116+ 871D ~            .dur_ok:
 117+ 871D ~                ld   (Audio_music_frame_counter), a
 118+ 871D ~
 119+ 871D ~            .play_current_note:
 120+ 871D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 871D ~                ld   a, (Audio_music_note_idx)
 122+ 871D ~                ld   e, a
 123+ 871D ~                ld   d, 0
 124+ 871D ~                ld   hl, Audio_MusicSheet
 125+ 871D ~                add  hl, de
 126+ 871D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 871D ~                ld   a, (hl)                  ; A = delay
 128+ 871D ~                or   a
 129+ 871D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 871D ~
 131+ 871D ~                ; Suona la nota: 2 cicli
 132+ 871D ~                ld   d, a                     ; D = delay
 133+ 871D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 871D ~            .note_loop:
 135+ 871D ~                ; Speaker ON
 136+ 871D ~                ld   a, (room_border_color)
 137+ 871D ~                or   $10
 138+ 871D ~                out  ($fe), a
 139+ 871D ~                ld   c, d
 140+ 871D ~            .d1:
 141+ 871D ~                push af
 142+ 871D ~                pop  af
 143+ 871D ~                dec  c
 144+ 871D ~                jr   nz, .d1
 145+ 871D ~
 146+ 871D ~                ; Speaker OFF
 147+ 871D ~                ld   a, (room_border_color)
 148+ 871D ~                and  $ef
 149+ 871D ~                out  ($fe), a
 150+ 871D ~                ld   c, d
 151+ 871D ~            .d2:
 152+ 871D ~                push af
 153+ 871D ~                pop  af
 154+ 871D ~                dec  c
 155+ 871D ~                jr   nz, .d2
 156+ 871D ~
 157+ 871D ~                djnz .note_loop
 158+ 871D ~
 159+ 871D ~            .done:
 160+ 871D ~                pop  hl
 161+ 871D ~                pop  de
 162+ 871D ~                pop  bc
 163+ 871D ~                pop  af
 164+ 871D ~                ret
 165+ 871D ~
 166+ 871D ~            Audio_MusicSheet:
 167+ 871D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 871D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 871D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10

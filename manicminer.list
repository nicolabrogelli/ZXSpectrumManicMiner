 625+ 82A2              ; Score_AddItemPoints
 626+ 82A2              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 82A2              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 82A2              ; -------------------------------------------------------------------
 629+ 82A2              Score_AddItemPoints:
 630+ 82A2 F5               push af
 631+ 82A3 C5               push bc
 632+ 82A4 D5               push de
 633+ 82A5 E5               push hl
 634+ 82A6
 635+ 82A6                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 82A6 3A 43 A4         ld   a, (player_score + 1)
 637+ 82A9 C6 01            add  a, $01
 638+ 82AB 27               daa
 639+ 82AC 32 43 A4         ld   (player_score + 1), a
 640+ 82AF
 641+ 82AF                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 82AF 3A 44 A4         ld   a, (player_score + 2)
 643+ 82B2 CE 00            adc  a, 0
 644+ 82B4 27               daa
 645+ 82B5 32 44 A4         ld   (player_score + 2), a
 646+ 82B8
 647+ 82B8                  ; Controlla se player_score ha superato high_score
 648+ 82B8 CD C3 82         call Score_CheckAndUpdateHighScore
 649+ 82BB
 650+ 82BB                  ; Aggiorna visualizzazione a schermo
 651+ 82BB CD F7 68         call Gfx_UpdateScoreDisplay
 652+ 82BE
 653+ 82BE E1               pop  hl
 654+ 82BF D1               pop  de
 655+ 82C0 C1               pop  bc
 656+ 82C1 F1               pop  af
 657+ 82C2 C9               ret

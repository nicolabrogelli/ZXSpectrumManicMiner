 892+ 779C 3A 4A E5         ld   a, (ramp_len)
 893+ 779F 80               add  a, b              ; A = ramp_col + ramp_len
 894+ 77A0 4F               ld   c, a              ; C = limit_right (exclusive)
 895+ 77A1
 896+ 77A1 7B               ld   a, e              ; A = Col
 897+ 77A2 B8               cp   b
 898+ 77A3 38 34            jr   c, .check_platform_case ; Col < ramp_col
 899+ 77A5 B9               cp   c
 900+ 77A6 30 31            jr   nc, .check_platform_case ; Col >= limit_right
 901+ 77A8
 902+ 77A8                  ; Calcola B = Col - ramp_col
 903+ 77A8 7B               ld   a, e
 904+ 77A9 90               sub  b
 905+ 77AA 47               ld   b, a              ; B = offset (0..ramp_len-1)
 906+ 77AB
 907+ 77AB                  ; SlopeRow = ramp_row - B
 908+ 77AB 3A 4B E5         ld   a, (ramp_row)
 909+ 77AE 90               sub  b
 910+ 77AF 47               ld   b, a              ; B = SlopeRow
 911+ 77B0 18 1F            jr   .check_row_match
 912+ 77B2
 913+ 77B2              .range_left:
 914+ 77B2                  ; Per rampa a sinistra, range è [ramp_col - ramp_len + 1, ramp_col]
 915+ 77B2 21 4A E5         ld   hl, ramp_len
 916+ 77B5 3A 4C E5         ld   a, (ramp_col)
 917+ 77B8 96               sub  (hl)
 918+ 77B9 3C               inc  a                 ; A = ramp_col - ramp_len + 1
 919+ 77BA 47               ld   b, a              ; B = limit_left
 920+ 77BB
 921+ 77BB 3A 4C E5         ld   a, (ramp_col)
 922+ 77BE 3C               inc  a
 923+ 77BF 4F               ld   c, a              ; C = limit_right (exclusive)
 924+ 77C0
 925+ 77C0 7B               ld   a, e              ; A = Col
 926+ 77C1 B8               cp   b
 927+ 77C2 38 15            jr   c, .check_platform_case
 928+ 77C4 B9               cp   c
 929+ 77C5 30 12            jr   nc, .check_platform_case
 930+ 77C7
 931+ 77C7                  ; Calcola B = ramp_col - Col
 932+ 77C7 3A 4C E5         ld   a, (ramp_col)

 534  85E3              ; -------------------------------------------------------------------
 535  85E3              ; TriggerVictory
 536  85E3              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 537  85E3              ; - Pulisce gli elementi di gioco della stanza.
 538  85E3              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 539  85E3              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 540  85E3              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 541  85E3              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 542  85E3              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 543  85E3              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 544  85E3              ; -------------------------------------------------------------------
 545  85E3              TriggerVictory:
 546  85E3                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 547  85E3 CD DC 66         call Gfx_DrawVictoryScreen
 548  85E6
 549  85E6                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 550  85E6              .wait_keys_release:
 551  85E6 76               halt
 552  85E7                  ; Controlla tasto Y (Porta $DF, bit 4)
 553  85E7 01 FE DF         ld   bc, $dffe
 554  85EA ED 78            in   a, (c)
 555  85EC CB 67            bit  4, a
 556  85EE 28 F6            jr   z, .wait_keys_release
 557  85F0
 558  85F0                  ; Controlla tasto N (Porta $7F, bit 3)
 559  85F0 01 FE 7F         ld   bc, $7ffe
 560  85F3 ED 78            in   a, (c)
 561  85F5 CB 5F            bit  3, a
 562  85F7 28 ED            jr   z, .wait_keys_release
 563  85F9
 564  85F9                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 565  85F9 01 FE BF         ld   bc, $bffe
 566  85FC ED 78            in   a, (c)
 567  85FE CB 47            bit  0, a
 568  8600 28 E4            jr   z, .wait_keys_release
 569  8602
 570  8602                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 571  8602 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 572  8604              .wait_choice_loop:
 573  8604 76               halt
 574  8605
 575  8605                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 576  8605 0C               inc  c
 577  8606 79               ld   a, c
 578  8607 CB 3F            srl  a
 579  8609 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 580  860B E6 07            and  7
 581  860D 5F               ld   e, a
 582  860E 16 00            ld   d, 0
 583  8610 21 BB 65         ld   hl, victory_color_table
 584  8613 19               add  hl, de
 585  8614 7E               ld   a, (hl)               ; A = nuovo colore attributo
 586  8615 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 587  8618 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 588  861A              .color_cycle_loop:
 589  861A 77               ld   (hl), a
 590  861B 23               inc  hl
 591  861C 10 FC            djnz .color_cycle_loop
 592  861E
 593  861E                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)

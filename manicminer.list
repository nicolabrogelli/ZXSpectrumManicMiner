 163+ 8512                  ; 1. Azzera items_grid (512 byte)
 164+ 8512 21 47 E8         ld   hl, items_grid
 165+ 8515 11 48 E8         ld   de, items_grid + 1
 166+ 8518 36 00            ld   (hl), 0
 167+ 851A 01 FF 01         ld   bc, 511
 168+ 851D ED B0            ldir
 169+ 851F
 170+ 851F                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 851F AF               xor  a
 172+ 8520 32 C7 ED         ld   (num_room_items), a
 173+ 8523
 174+ 8523 FD 21 77 ED      ld   iy, current_room_items
 175+ 8527
 176+ 8527                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 8527 2A C8 ED         ld   hl, (room_ptr)
 178+ 852A 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 852D 19               add  hl, de
 180+ 852E E5               push hl
 181+ 852F DD E1            pop  ix                        ; IX = bitmap item
 182+ 8531
 183+ 8531                  ; 4. HL = Inizio lista item nella stanza
 184+ 8531 2A C8 ED         ld   hl, (room_ptr)
 185+ 8534 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8537 19               add  hl, de
 187+ 8538
 188+ 8538              .loop:
 189+ 8538 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 8539 FE FF            cp   $FF
 191+ 853B 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 853D B7               or   a
 193+ 853E 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 8540
 195+ 8540 5F               ld   e, a                      ; E = Color
 196+ 8541 23               inc  hl
 197+ 8542 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8543 23               inc  hl

 354  85D4              ; -------------------------------------------------------------------
 355  85D4              ; TriggerGameOver
 356  85D4              ; Scatena la schermata di Game Over per la stanza corrente.
 357  85D4              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 358  85D4              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 359  85D4              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 360  85D4              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 361  85D4              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 362  85D4              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 363  85D4              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 364  85D4              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 365  85D4              ; -------------------------------------------------------------------
 366  85D4              TriggerGameOver:
 367  85D4                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 368  85D4 CD 15 66         call Gfx_DrawGameOverScreen
 369  85D7
 370  85D7                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 371  85D7              .wait_keys_release:
 372  85D7 76               halt
 373  85D8                  ; Controlla tasto Y (Porta $DF, bit 4)
 374  85D8 01 FE DF         ld   bc, $dffe
 375  85DB ED 78            in   a, (c)
 376  85DD CB 67            bit  4, a
 377  85DF 28 F6            jr   z, .wait_keys_release
 378  85E1
 379  85E1                  ; Controlla tasto N (Porta $7F, bit 3)
 380  85E1 01 FE 7F         ld   bc, $7ffe
 381  85E4 ED 78            in   a, (c)
 382  85E6 CB 5F            bit  3, a
 383  85E8 28 ED            jr   z, .wait_keys_release
 384  85EA
 385  85EA                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  85EA 01 FE BF         ld   bc, $bffe
 387  85ED ED 78            in   a, (c)
 388  85EF CB 47            bit  0, a
 389  85F1 28 E4            jr   z, .wait_keys_release
 390  85F3
 391  85F3                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 392  85F3 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 393  85F5              .wait_choice_loop:
 394  85F5 76               halt
 395  85F6
 396  85F6                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 397  85F6 0C               inc  c
 398  85F7 79               ld   a, c
 399  85F8 CB 3F            srl  a
 400  85FA CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 401  85FC E6 07            and  7
 402  85FE 5F               ld   e, a
 403  85FF 16 00            ld   d, 0
 404  8601 21 D1 65         ld   hl, game_over_color_table
 405  8604 19               add  hl, de
 406  8605 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  8606 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  8609 06 09            ld   b, 9

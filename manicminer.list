  86+ F13D 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  87+ F13E 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  88+ F13F
  89+ F13F              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  90+ F13F 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  91+ F142 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  92+ F145 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  93+ F146 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  94+ F147 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  95+ F148 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  96+ F149 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  97+ F14A 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  98+ F14B 00           game_over_distance:         db 0       ; Distanza/offset discesa Piede durante Game Over
  99+ F14C
 100+ F14C 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
 101+ F14D 00           Audio_jump_sound_timer:   db 0
 102+ F14E                  IF ENABLE_MUSIC != 0
 103+ F14E ~            Audio_music_note_idx:      db 0
 104+ F14E ~            Audio_music_frame_counter: db 1
 105+ F14E                  ENDIF
 106+ F14E
 107+ F14E              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 108+ F14E E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 109+ F14F 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 110+ F150 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 111+ F151
 112+ F151              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 113+ F151 00 00        willy_head_ptr:         dw 0
 114+ F153 00 00        willy_body_ptr:         dw 0
 115+ F155 00 00        guard_sprite_ptr:       dw 0
 116+ F157 00           collision_delta_x:      db 0
 117+ F158 00           collision_delta_y:      db 0
 118+ F159 00           row_enemy_cur:          db 0
 119+ F15A 00           row_willy_cur:          db 0
 120+ F15B 00           overlap_num_lines:      db 0
 121+ F15C
 122+ F15C              ; Interrupt
 123+ F15C              IM2_TABLE   = $FE00
 124+ F15C              IM2_VECTOR  = $FDFD
 125+ F15C              SCREEN_LINE = $4860
 126+ F15C              SCREEN_MEMORY = $4000
 127+ F15C              COLOR_DATA = $5800
 128+ F15C              STACK_POINTER = $fdf0

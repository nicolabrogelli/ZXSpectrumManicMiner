 106+ 80D0              ; Items_ResetCurrentRoomItems
 107+ 80D0              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
 108+ 80D0              ; per tutti gli item della stanza corrente puntata da (room_ptr).
 109+ 80D0              ; -------------------------------------------------------------------
 110+ 80D0              Items_ResetCurrentRoomItems:
 111+ 80D0 E5               push hl
 112+ 80D1 D5               push de
 113+ 80D2 F5               push af
 114+ 80D3
 115+ 80D3 2A E7 99         ld   hl, (room_ptr)

   8+ 8971              ; Audio_UpdateJumpSound
   9+ 8971              ;
  10+ 8971              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 8971              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 8971              ; -------------------------------------------------------------------
  13+ 8971              Audio_UpdateJumpSound:
  14+ 8971 F5               push af
  15+ 8972 C5               push bc
  16+ 8973 D5               push de
  17+ 8974 E5               push hl
  18+ 8975
  19+ 8975                  ; Controlla se il suono è attivo (note < 18)
  20+ 8975 3A 94 F2         ld   a, (Audio_jump_sound_note)
  21+ 8978 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 897A 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 897C
  24+ 897C                  ; Carica la nota corrente da suonare
  25+ 897C 5F               ld   e, a
  26+ 897D 16 00            ld   d, 0
  27+ 897F 21 AB 89         ld   hl, Audio_JumpSoundDelays
  28+ 8982 19               add  hl, de
  29+ 8983 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8984 57               ld   d, a                      ; D = delay della nota
  31+ 8985
  32+ 8985                  ; Suona la nota: 15 cicli
  33+ 8985 06 0F            ld   b, 15
  34+ 8987              .note_loop:
  35+ 8987                  ; Speaker ON (attiva bit 3 MIC e bit 4 EAR per volume ottimale)
  36+ 8987 3A 7E EC         ld   a, (room_border_color)
  37+ 898A F6 18            or   $18
  38+ 898C D3 FE            out  ($fe), a
  39+ 898E 4A               ld   c, d
  40+ 898F              .d1:
  41+ 898F 0D               dec  c
  42+ 8990 20 FD            jr   nz, .d1
  43+ 8992
  44+ 8992                  ; Speaker OFF
  45+ 8992 3A 7E EC         ld   a, (room_border_color)
  46+ 8995 E6 E7            and  $e7
  47+ 8997 D3 FE            out  ($fe), a
  48+ 8999 4A               ld   c, d
  49+ 899A              .d2:
  50+ 899A 0D               dec  c
  51+ 899B 20 FD            jr   nz, .d2
  52+ 899D
  53+ 899D 10 E8            djnz .note_loop
  54+ 899F
  55+ 899F                  ; Passa alla nota successiva
  56+ 899F 3A 94 F2         ld   a, (Audio_jump_sound_note)
  57+ 89A2 3C               inc  a
  58+ 89A3 32 94 F2         ld   (Audio_jump_sound_note), a

 764  8B78 C6 0F            add  a, 15                 ; WillyBottom
 765  8B7A BB               cp   e
 766  8B7B 28 04            jr   z, .x_check
 767  8B7D 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8B7F 18 29            jr   .no_conv_collision

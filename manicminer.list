  83+ E6CA 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  84+ E6CB 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  85+ E6CC
  86+ E6CC              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  87+ E6CC 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  88+ E6CF 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  89+ E6D2 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  90+ E6D3 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  91+ E6D4 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  92+ E6D5 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  93+ E6D6 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  94+ E6D7 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  95+ E6D8
  96+ E6D8 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  97+ E6D9 00           Audio_jump_sound_timer:   db 0
  98+ E6DA                  IF ENABLE_MUSIC != 0
  99+ E6DA ~            Audio_music_note_idx:      db 0
 100+ E6DA ~            Audio_music_frame_counter: db 1
 101+ E6DA                  ENDIF
 102+ E6DA
 103+ E6DA              ; Gestione Barra dell'Aria (AIR bar - Riga 17)
 104+ E6DA E0           air_pixels:             db 224     ; Quantità aria rimanente in pixel (28 colonne * 8 = 224 pixel)
 105+ E6DB 00           air_timer:              db 0       ; Timer frame per il consumo progressivo dell'aria
 106+ E6DC 08           air_deplete_rate:       db 8       ; Frame per decremento di 1 pixel di aria
 107+ E6DD
 108+ E6DD              ; Variabili temporanee per collisione pixel-perfect Willy-Guardiani
 109+ E6DD 00 00        willy_head_ptr:         dw 0
 110+ E6DF 00 00        willy_body_ptr:         dw 0
 111+ E6E1 00 00        guard_sprite_ptr:       dw 0
 112+ E6E3 00           collision_delta_x:      db 0
 113+ E6E4 00           collision_delta_y:      db 0
 114+ E6E5 00           row_enemy_cur:          db 0
 115+ E6E6 00           row_willy_cur:          db 0
 116+ E6E7 00           overlap_num_lines:      db 0
 117+ E6E8

 407+ 7E59              ; -------------------------------------------------------------------
 408+ 7E59              ; CheckWillyItemCollision
 409+ 7E59              ;
 410+ 7E59              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 7E59              ; Input:
 412+ 7E59              ;   A = Item Col (0..31)
 413+ 7E59              ;   H = Item Row (0..15)
 414+ 7E59              ; Output:
 415+ 7E59              ;   Carry Set = Collisione
 416+ 7E59              ;   Carry Clear = Nessuna collisione
 417+ 7E59              ; -------------------------------------------------------------------
 418+ 7E59              CheckWillyItemCollision:
 419+ 7E59 C5               push bc
 420+ 7E5A D5               push de
 421+ 7E5B E5               push hl
 422+ 7E5C
 423+ 7E5C                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 7E5C 6F               ld   l, a
 425+ 7E5D 87               add  a, a                      ; *2
 426+ 7E5E 87               add  a, a                      ; *4
 427+ 7E5F 87               add  a, a                      ; *8
 428+ 7E60 5F               ld   e, a                      ; E = ItemLeft
 429+ 7E61 C6 07            add  a, 7
 430+ 7E63 57               ld   d, a                      ; D = ItemRight
 431+ 7E64
 432+ 7E64 ED 4B AD 92      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 7E68
 434+ 7E68                  ; WillyLeft <= ItemRight
 435+ 7E68 79               ld   a, c                      ; A = WillyX
 436+ 7E69 BA               cp   d                         ; D = ItemRight
 437+ 7E6A 28 04            jr   z, .x_ok
 438+ 7E6C 38 02            jr   c, .x_ok
 439+ 7E6E 18 31            jr   .no_collision
 440+ 7E70
 441+ 7E70              .x_ok:
 442+ 7E70                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 7E70 BB               cp   e                         ; E = ItemLeft
 444+ 7E71 28 0B            jr   z, .y_check
 445+ 7E73 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 7E75
 447+ 7E75                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 7E75 C6 0F            add  a, 15
 449+ 7E77 BB               cp   e
 450+ 7E78 28 04            jr   z, .y_check
 451+ 7E7A 30 02            jr   nc, .y_check
 452+ 7E7C 18 23            jr   .no_collision
 453+ 7E7E
 454+ 7E7E              .y_check:
 455+ 7E7E                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 7E7E 7C               ld   a, h                      ; H = Item Row
 457+ 7E7F 87               add  a, a                      ; *2
 458+ 7E80 87               add  a, a                      ; *4
 459+ 7E81 87               add  a, a                      ; *8
 460+ 7E82 5F               ld   e, a                      ; E = ItemTop
 461+ 7E83 C6 07            add  a, 7
 462+ 7E85 57               ld   d, a                      ; D = ItemBottom
 463+ 7E86
 464+ 7E86                  ; WillyTop <= ItemBottom
 465+ 7E86 78               ld   a, b                      ; A = WillyY
 466+ 7E87 BA               cp   d                         ; D = ItemBottom
 467+ 7E88 28 04            jr   z, .y_ok
 468+ 7E8A 38 02            jr   c, .y_ok
 469+ 7E8C 18 13            jr   .no_collision
 470+ 7E8E
 471+ 7E8E              .y_ok:
 472+ 7E8E                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 7E8E BB               cp   e                         ; E = ItemTop
 474+ 7E8F 28 0B            jr   z, .collision
 475+ 7E91 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 7E93
 477+ 7E93                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 7E93 C6 0F            add  a, 15
 479+ 7E95 BB               cp   e
 480+ 7E96 28 04            jr   z, .collision
 481+ 7E98 30 02            jr   nc, .collision
 482+ 7E9A 18 05            jr   .no_collision
 483+ 7E9C
 484+ 7E9C              .collision:
 485+ 7E9C E1               pop  hl
 486+ 7E9D D1               pop  de
 487+ 7E9E C1               pop  bc
 488+ 7E9F 37               scf
 489+ 7EA0 C9               ret
 490+ 7EA1
 491+ 7EA1              .no_collision:
 492+ 7EA1 E1               pop  hl
 493+ 7EA2 D1               pop  de
 494+ 7EA3 C1               pop  bc
 495+ 7EA4 B7               or   a
 496+ 7EA5 C9               ret

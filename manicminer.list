 920+ 826C
 921+ 826C                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 922+ 826C 3A 25 EA         ld   a, (PlayerPos+1)          ; WillyY
 923+ 826F DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 924+ 8272 FE 10            cp   16
 925+ 8274 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 926+ 8276 FE F1            cp   241                       ; 241..255 = -15..-1
 927+ 8278 DA 7A 83         jp   c, .next_enemy            ; 16..240 -> fuori range
 928+ 827B              .y_in_range:

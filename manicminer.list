   8+ 881D              ; Audio_UpdateJumpSound
   9+ 881D              ;
  10+ 881D              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 881D              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 881D              ; -------------------------------------------------------------------
  13+ 881D              Audio_UpdateJumpSound:
  14+ 881D F5               push af
  15+ 881E C5               push bc
  16+ 881F D5               push de
  17+ 8820 E5               push hl
  18+ 8821
  19+ 8821                  ; Controlla se il suono è attivo (note < 18)
  20+ 8821 3A A5 F0         ld   a, (Audio_jump_sound_note)
  21+ 8824 FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 8826 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 8828
  24+ 8828                  ; Carica la nota corrente da suonare
  25+ 8828 5F               ld   e, a
  26+ 8829 16 00            ld   d, 0
  27+ 882B 21 57 88         ld   hl, Audio_JumpSoundDelays
  28+ 882E 19               add  hl, de
  29+ 882F 7E               ld   a, (hl)                   ; A = delay della nota corrente
  30+ 8830 57               ld   d, a                      ; D = delay della nota
  31+ 8831
  32+ 8831                  ; Suona la nota: 15 cicli
  33+ 8831 06 0F            ld   b, 15
  34+ 8833              .note_loop:
  35+ 8833                  ; Speaker ON
  36+ 8833 3A 91 EA         ld   a, (room_border_color)
  37+ 8836 F6 10            or   $10
  38+ 8838 D3 FE            out  ($fe), a
  39+ 883A 4A               ld   c, d
  40+ 883B              .d1:
  41+ 883B 0D               dec  c
  42+ 883C 20 FD            jr   nz, .d1
  43+ 883E
  44+ 883E                  ; Speaker OFF
  45+ 883E 3A 91 EA         ld   a, (room_border_color)
  46+ 8841 E6 EF            and  $ef
  47+ 8843 D3 FE            out  ($fe), a
  48+ 8845 4A               ld   c, d
  49+ 8846              .d2:
  50+ 8846 0D               dec  c
  51+ 8847 20 FD            jr   nz, .d2
  52+ 8849
  53+ 8849 10 E8            djnz .note_loop
  54+ 884B
  55+ 884B                  ; Passa alla nota successiva
  56+ 884B 3A A5 F0         ld   a, (Audio_jump_sound_note)
  57+ 884E 3C               inc  a
  58+ 884F 32 A5 F0         ld   (Audio_jump_sound_note), a
  59+ 8852
  60+ 8852              .done:
  61+ 8852 E1               pop  hl
  62+ 8853 D1               pop  de
  63+ 8854 C1               pop  bc
  64+ 8855 F1               pop  af
  65+ 8856 C9               ret
  66+ 8857
  67+ 8857              Audio_JumpSoundDelays:
  68+ 8857 33 2D 26 20      db 51, 45, 38, 32, 25, 19, 12, 6, 12, 19, 25, 32, 38, 45, 51, 58, 64, 71
  68+ 885B 19 13 0C 06
  68+ 885F 0C 13 19 20
  68+ 8863 26 2D 33 3A
  68+ 8867 40 47

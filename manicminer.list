   6+ 6EBE              ; MovePlayer
   7+ 6EBE              ;
   8+ 6EBE              ; Gestisce il movimento orizzontale del player (Willy),
   9+ 6EBE              ; applicando input da controlli, limiti di schermo e collisioni
  10+ 6EBE              ; con i muri.
  11+ 6EBE              ;
  12+ 6EBE              ; Input:
  13+ 6EBE              ;   D = stato dei controlli (bitfield)
  14+ 6EBE              ;
  15+ 6EBE              ; Strutture utilizzate:
  16+ 6EBE              ;   PlayerPos       -> posizione (B = Y, C = X in pixel)
  17+ 6EBE              ;   player_speed    -> velocità orizzontale
  18+ 6EBE              ;   flags           -> flag di stato input
  19+ 6EBE              ;
  20+ 6EBE              ; Bit controlli:
  21+ 6EBE              ;   bit 0 = sinistra
  22+ 6EBE              ;   bit 1 = destra
  23+ 6EBE              ;
  24+ 6EBE              ; Nota:
  25+ 6EBE              ;   Se Willy è in aria (on_ground = 0) il movimento orizzontale viene
  26+ 6EBE              ;   ignorato per tutta la durata del salto.
  27+ 6EBE              ;
  28+ 6EBE              ; Output:
  29+ 6EBE              ;   aggiorna PlayerPos e body_state
  30+ 6EBE              ; -------------------------------------------------------------------
  31+ 6EBE              MovePlayer:
  32+ 6EBE
  33+ 6EBE                  ; ---------------------------------------------------------------
  34+ 6EBE                  ; Se siamo in aria, usa la direzione bloccata al momento del salto.
  35+ 6EBE                  ; Il movimento orizzontale in aria continua anche se non ci sono
  36+ 6EBE                  ; tasti di direzione premuti (jump_dir decide).
  37+ 6EBE                  ; ---------------------------------------------------------------
  38+ 6EBE 3A 41 9E         ld   a, (on_ground)
  39+ 6EC1 B7               or   a
  40+ 6EC2 20 20            jr   nz, .on_ground_check
  41+ 6EC4
  42+ 6EC4                  ; In aria: resetta lo stato di cattura del nastro
  43+ 6EC4 AF               xor  a
  44+ 6EC5 32 5D A1         ld   (conveyor_caught), a
  45+ 6EC8
  46+ 6EC8 3A 46 9E         ld   a, (jump_dir)
  47+ 6ECB B7               or   a
  48+ 6ECC C8               ret  z                  ; Se jump_dir è 0, salto verticale -> nessun movimento orizzontale
  49+ 6ECD
  50+ 6ECD                  ; In volo: resetta comunque il flag di aggiornamento movimento se era impostato
  51+ 6ECD DD 21 3A 9E      ld   ix, flags
  52+ 6ED1 DD CB 00 86      res  $00, (ix)
  53+ 6ED5
  54+ 6ED5 ED 4B 32 9E      ld   bc, (PlayerPos)
  55+ 6ED9 FE 01            cp   1
  56+ 6EDB CA 69 6F         jp   z, movePlayer_left
  57+ 6EDE FE 02            cp   2
  58+ 6EE0 CA B0 6F         jp   z, movePlayer_right
  59+ 6EE3 C9               ret

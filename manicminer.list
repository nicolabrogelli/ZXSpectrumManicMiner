 233+ 7DD7              ; -------------------------------------------------------------------
 234+ 7DD7              ; Aggiorna e disegna i nemici in due passate (prima cancella tutti i vecchi, poi disegna tutti i nuovi)
 235+ 7DD7              ; -------------------------------------------------------------------
 236+ 7DD7              Enemy_EraseRoom:
 237+ 7DD7              Enemy_DrawRoom:
 238+ 7DD7              Enemy_RenderRoom:
 239+ 7DD7 E5               push hl
 240+ 7DD8 D5               push de
 241+ 7DD9 C5               push bc
 242+ 7DDA DD E5            push ix
 243+ 7DDC
 244+ 7DDC                  ; ---------------------------------------------------------------
 245+ 7DDC                  ; PASSATA 1: Cancella la vecchia posizione di tutti i nemici che si sono mossi o aggiornati
 246+ 7DDC                  ; ---------------------------------------------------------------
 247+ 7DDC DD 21 5D 7C      ld   ix, ActiveEnemies
 248+ 7DE0 06 08            ld   b, 8              ; 8 slot
 249+ 7DE2              .erase_loop:
 250+ 7DE2 DD 7E 00         ld   a, (ix+0)         ; Flags
 251+ 7DE5 E6 80            and  $80               ; Active?
 252+ 7DE7 28 3A            jr   z, .next_erase
 253+ 7DE9
 254+ 7DE9                  ; Se Old X == $FF (nuova stanza o non ancora disegnato), non c'è nulla da cancellare
 255+ 7DE9 DD 7E 08         ld   a, (ix+8)         ; Old X
 256+ 7DEC FE FF            cp   $FF
 257+ 7DEE 28 33            jr   z, .next_erase
 258+ 7DF0
 259+ 7DF0                  ; Controlla se la posizione è cambiata o se l'animazione/stato si è aggiornato
 260+ 7DF0 DD 7E 08         ld   a, (ix+8)         ; Old X
 261+ 7DF3 DD BE 02         cp   (ix+2)            ; Current X
 262+ 7DF6 20 0E            jr   nz, .do_erase_slot
 263+ 7DF8 DD 7E 09         ld   a, (ix+9)         ; Old Y
 264+ 7DFB DD BE 03         cp   (ix+3)            ; Current Y
 265+ 7DFE 20 06            jr   nz, .do_erase_slot
 266+ 7E00
 267+ 7E00 3A F4 E2         ld   a, (enemy_was_updated)
 268+ 7E03 B7               or   a
 269+ 7E04 28 1D            jr   z, .next_erase    ; Nessuna modifica in questo frame, non cancellare!
 270+ 7E06
 271+ 7E06              .do_erase_slot:
 272+ 7E06 C5               push bc                ; Salva contatore ciclo
 273+ 7E07
 274+ 7E07                  ; Controlla se la VECCHIA posizione del guardiano sovrascrive Willy
 275+ 7E07 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 276+ 7E0A DD 46 09         ld   b, (ix+9)         ; B = Old Y
 277+ 7E0D CD B3 7D         call CheckEnemyWillyOverlap
 278+ 7E10
 279+ 7E10                  ; Cancella il nemico nella VECCHIA posizione
 280+ 7E10 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 281+ 7E13 DD 46 09         ld   b, (ix+9)         ; B = Old Y
 282+ 7E16 CD BD 5F         call Gfx_ErasePixelSprite16x16
 283+ 7E19 DD 4E 08         ld   c, (ix+8)         ; C = Old X
 284+ 7E1C DD 46 09         ld   b, (ix+9)         ; B = Old Y
 285+ 7E1F CD 73 6D         call Gfx_RestoreEnemyColorAttributes
 286+ 7E22
 287+ 7E22 C1               pop  bc
 288+ 7E23
 289+ 7E23              .next_erase:
 290+ 7E23 11 0B 00         ld   de, 11
 291+ 7E26 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 292+ 7E28 05               dec  b
 293+ 7E29 20 B7            jr   nz, .erase_loop
 294+ 7E2B
 295+ 7E2B                  ; ---------------------------------------------------------------
 296+ 7E2B                  ; PASSATA 2: Disegna la nuova posizione di tutti i nemici
 297+ 7E2B                  ; ---------------------------------------------------------------
 298+ 7E2B DD 21 5D 7C      ld   ix, ActiveEnemies
 299+ 7E2F 06 08            ld   b, 8              ; 8 slot
 300+ 7E31              .draw_loop:
 301+ 7E31 DD 7E 00         ld   a, (ix+0)         ; Flags
 302+ 7E34 E6 80            and  $80               ; Active?
 303+ 7E36 28 37            jr   z, .next_draw
 304+ 7E38
 305+ 7E38                  ; Se Old X == $FF, deve essere disegnato (prima volta)
 306+ 7E38 DD 7E 08         ld   a, (ix+8)         ; Old X
 307+ 7E3B FE FF            cp   $FF
 308+ 7E3D 28 16            jr   z, .do_draw_slot
 309+ 7E3F
 310+ 7E3F                  ; Controlla se si è mosso o se l'animazione/stato si è aggiornato
 311+ 7E3F DD 7E 08         ld   a, (ix+8)         ; Old X
 312+ 7E42 DD BE 02         cp   (ix+2)            ; Current X
 313+ 7E45 20 0E            jr   nz, .do_draw_slot
 314+ 7E47 DD 7E 09         ld   a, (ix+9)         ; Old Y
 315+ 7E4A DD BE 03         cp   (ix+3)            ; Current Y
 316+ 7E4D 20 06            jr   nz, .do_draw_slot
 317+ 7E4F
 318+ 7E4F 3A F4 E2         ld   a, (enemy_was_updated)
 319+ 7E52 B7               or   a
 320+ 7E53 28 1A            jr   z, .next_draw     ; Nessuna modifica in questo frame, non ridisegnare!
 321+ 7E55
 322+ 7E55              .do_draw_slot:
 323+ 7E55 C5               push bc                ; Salva contatore ciclo
 324+ 7E56
 325+ 7E56                  ; Disegna il nemico nella NUOVA posizione (applica anche gli attributi colore)
 326+ 7E56 CD 81 7E         call Enemy_DrawSingleSlot
 327+ 7E59
 328+ 7E59                  ; Controlla se la NUOVA posizione del guardiano si sovrappone a Willy
 329+ 7E59 DD 4E 02         ld   c, (ix+2)         ; C = Current X
 330+ 7E5C DD 46 03         ld   b, (ix+3)         ; B = Current Y
 331+ 7E5F CD B3 7D         call CheckEnemyWillyOverlap
 332+ 7E62
 333+ 7E62                  ; Salva le coordinate effettivamente disegnate
 334+ 7E62 DD 7E 02         ld   a, (ix+2)
 335+ 7E65 DD 77 08         ld   (ix+8), a         ; Old X = Current X
 336+ 7E68 DD 7E 03         ld   a, (ix+3)
 337+ 7E6B DD 77 09         ld   (ix+9), a         ; Old Y = Current Y
 338+ 7E6E
 339+ 7E6E C1               pop  bc
 340+ 7E6F
 341+ 7E6F              .next_draw:
 342+ 7E6F 11 0B 00         ld   de, 11
 343+ 7E72 DD 19            add  ix, de            ; Prossimo slot (11 byte)
 344+ 7E74 05               dec  b
 345+ 7E75 20 BA            jr   nz, .draw_loop
 346+ 7E77
 347+ 7E77 AF               xor  a
 348+ 7E78 32 F4 E2         ld   (enemy_was_updated), a ; Resetta flag aggiornamento nemici
 349+ 7E7B
 350+ 7E7B DD E1            pop  ix
 351+ 7E7D C1               pop  bc
 352+ 7E7E D1               pop  de
 353+ 7E7F E1               pop  hl
 354+ 7E80 C9               ret

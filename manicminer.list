1632+ 6659 06 20            ld   b, 32                 ; B = 32 caratteri
1633+ 665B 16 12            ld   d, 18
1634+ 665D 1E 00            ld   e, 0
1635+ 665F CD 41 62         call Gfx_PrintDirectText

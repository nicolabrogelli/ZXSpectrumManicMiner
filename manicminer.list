 287  8590              ; -------------------------------------------------------------------
 288  8590              ; ShowTitleScreen
 289  8590              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  8590              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  8590              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  8590              ; -------------------------------------------------------------------
 293  8590              ShowTitleScreen:
 294  8590                  ; 1. Disegna la schermata iniziale
 295  8590 CD 76 64         call Gfx_DrawTitleScreen
 296  8593
 297  8593                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  8593              .wait_title_enter_release:
 299  8593 76               halt
 300  8594 3E BF            ld   a, $bf
 301  8596 DB FE            in   a, ($fe)
 302  8598 1F               rra
 303  8599 30 F8            jr   nc, .wait_title_enter_release
 304  859B
 305  859B                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  859B 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  859D              .title_loop:
 308  859D 76               halt
 309  859E
 310  859E                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  859E 0C               inc  c
 312  859F 79               ld   a, c
 313  85A0 CB 3F            srl  a
 314  85A2 CB 3F            srl  a
 315  85A4 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  85A6 E6 07            and  7
 317  85A8 5F               ld   e, a
 318  85A9 16 00            ld   d, 0
 319  85AB 21 6E 64         ld   hl, title_color_table
 320  85AE 19               add  hl, de
 321  85AF 7E               ld   a, (hl)               ; A = nuovo colore
 322  85B0 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  85B3 06 20            ld   b, 32
 324  85B5              .color_title_loop:
 325  85B5 77               ld   (hl), a
 326  85B6 23               inc  hl
 327  85B7 10 FC            djnz .color_title_loop
 328  85B9
 329  85B9                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  85B9 3E BF            ld   a, $bf
 331  85BB DB FE            in   a, ($fe)
 332  85BD 1F               rra
 333  85BE 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  85C0
 335  85C0                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  85C0              .wait_title_enter_release_after:
 337  85C0 76               halt
 338  85C1 3E BF            ld   a, $bf
 339  85C3 DB FE            in   a, ($fe)
 340  85C5 1F               rra
 341  85C6 30 F8            jr   nc, .wait_title_enter_release_after
 342  85C8
 343  85C8                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  85C8 AF               xor  a
 345  85C9 D3 FE            out  ($fe), a              ; Bordo a nero
 346  85CB CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  85CE

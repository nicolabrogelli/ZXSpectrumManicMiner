 940  84D2              ; -------------------------------------------------------------------
 941  84D2              ; Time_UpdateClock
 942  84D2              ; Gestisce lo scorrimento del tempo durante il gioco.
 943  84D2              ; 1 minuto di gioco corrisponde a 40.0 secondi reali esatti.
 944  84D2              ; Utilizza il contatore hardware di interrupt a 50Hz (counter) per
 945  84D2              ; garantire l'esattezza del tempo indipendentemente dalla velocità del loop.
 946  84D2              ; (50 tick/sec * 40 sec = 2000 tick hardware a 50Hz).
 947  84D2              ; Se l'orologio raggiunge le 12:00 AM (mezzanotte) senza che l'obiettivo
 948  84D2              ; sia completato, scatena immediatamente il Game Over.
 949  84D2              ; -------------------------------------------------------------------
 950  84D2              Time_UpdateClock:
 951  84D2                  ; Calcola la differenza tra il contatore IM2 a 50Hz ed il contatore dell'ultimo scatto
 952  84D2 2A 92 8F         ld   hl, (counter)
 953  84D5 ED 5B 83 95      ld   de, (time_last_counter)
 954  84D9 B7               or   a
 955  84DA ED 52            sbc  hl, de                 ; HL = tick hardware a 50Hz trascorsi
 956  84DC
 957  84DC                  ; Controlla se sono trascorsi i tick necessari per 1 minuto di gioco (CLOCK_TICKS_PER_MINUTE)
 958  84DC 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 959  84DF B7               or   a
 960  84E0 ED 52            sbc  hl, de
 961  84E2 D8               ret  c                      ; Se non sono trascorsi abbastanza tick, ritorna
 962  84E3
 963  84E3                  ; Tick trascorsi: aggiorna time_last_counter aggiungendo CLOCK_TICKS_PER_MINUTE
 964  84E3 2A 83 95         ld   hl, (time_last_counter)
 965  84E6 11 D0 07         ld   de, CLOCK_TICKS_PER_MINUTE
 966  84E9 19               add  hl, de
 967  84EA 22 83 95         ld   (time_last_counter), hl
 968  84ED
 969  84ED                  ; Incrementa di 1 minuto il tempo di gioco
 970  84ED 3A 81 95         ld   a, (time_minutes)
 971  84F0 3C               inc  a
 972  84F1 FE 3C            cp   60
 973  84F3 38 21            jr   c, .minutes_ok
 974  84F5
 975  84F5                  ; 60 minuti trascorsi: azzera i minuti ed incrementa l'ora
 976  84F5 AF               xor  a
 977  84F6 32 81 95         ld   (time_minutes), a
 978  84F9 3A 80 95         ld   a, (time_hours)
 979  84FC 3C               inc  a
 980  84FD FE 0C            cp   12
 981  84FF 28 08            jr   z, .toggle_period      ; 11 -> 12: l'ora passa a 12 e il periodo (AM/PM) commuta
 982  8501 FE 0D            cp   13
 983  8503 38 0E            jr   c, .hours_ok
 984  8505 3E 01            ld   a, 1                   ; 12 -> 13: l'ora passa a 1 (es. 12:59 PM -> 01:00 PM)
 985  8507 18 0A            jr   .hours_ok
 986  8509
 987  8509              .toggle_period:
 988  8509 F5               push af                     ; Salva A (valore 12)
 989  850A 3A 82 95         ld   a, (time_period)
 990  850D EE 01            xor  1                       ; Commuta 0 (AM) <-> 1 (PM)
 991  850F 32 82 95         ld   (time_period), a
 992  8512 F1               pop  af                     ; Ripristina A = 12
 993  8513
 994  8513              .hours_ok:
 995  8513 32 80 95         ld   (time_hours), a
 996  8516
 997  8516              .minutes_ok:
 998  8516 32 81 95         ld   (time_minutes), a
 999  8519
1000  8519                  ; Aggiorna l'orologio sul display dell'HUD (riga 18)
1001  8519 CD D5 67         call Gfx_UpdateTimeDisplay
1002  851C
1003  851C                  ; Controlla se l'obiettivo di gioco è stato completato (priorità assoluta)
1004  851C 3A 85 95         ld   a, (game_objective_completed)
1005  851F B7               or   a
1006  8520 C0               ret  nz                     ; Obiettivo completato -> nessun Game Over temporale!
1007  8521
1008  8521                  ; Controlla se l'orologio ha raggiunto le 12:00 AM (mezzanotte)
1009  8521 3A 82 95         ld   a, (time_period)
1010  8524 B7               or   a
1011  8525 C0               ret  nz                     ; Se è PM (1), la partita continua sempre! (es. 12:00 PM è mezzogiorno)
1012  8526
1013  8526 3A 80 95         ld   a, (time_hours)
1014  8529 FE 0C            cp   12
1015  852B 28 01            jr   z, .time_limit_reached ; 12:00 AM (mezzanotte) -> Game Over!
1016  852D C9               ret
1017  852E
1018  852E              .time_limit_reached:
1019  852E                  ; Limite di tempo raggiunto senza aver completato l'obiettivo!
1020  852E                  ; Scatena immediatamente il Game Over temporale!
1021  852E C3 E8 81         jp   TriggerGameOver

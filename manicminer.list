 198+ 839F
 199+ 839F 3A 73 96         ld   a, (room_border_color)
 200+ 83A2 E6 EF            and  $ef              ; speaker OFF
 201+ 83A4 D3 FE            out  ($fe), a
 202+ 83A6
 203+ 83A6 0E 3C            ld   c, 60

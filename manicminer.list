 289  8A58              ; -------------------------------------------------------------------
 290  8A58              ; ShowTitleScreen
 291  8A58              ; Visualizza la schermata iniziale del gioco (Title Screen).
 292  8A58              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 293  8A58              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 294  8A58              ; -------------------------------------------------------------------
 295  8A58              ShowTitleScreen:
 296  8A58                  ; 1. Disegna la schermata iniziale
 297  8A58 CD 7A 64         call Gfx_DrawTitleScreen
 298  8A5B
 299  8A5B                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 300  8A5B              .wait_title_enter_release:
 301  8A5B 76               halt
 302  8A5C 3E BF            ld   a, $bf
 303  8A5E DB FE            in   a, ($fe)
 304  8A60 1F               rra
 305  8A61 30 F8            jr   nc, .wait_title_enter_release
 306  8A63
 307  8A63                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 308  8A63 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 309  8A65              .title_loop:
 310  8A65 76               halt
 311  8A66
 312  8A66                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 313  8A66 0C               inc  c
 314  8A67 79               ld   a, c
 315  8A68 CB 3F            srl  a
 316  8A6A CB 3F            srl  a
 317  8A6C CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 318  8A6E E6 07            and  7
 319  8A70 5F               ld   e, a
 320  8A71 16 00            ld   d, 0
 321  8A73 21 72 64         ld   hl, title_color_table
 322  8A76 19               add  hl, de
 323  8A77 7E               ld   a, (hl)               ; A = nuovo colore
 324  8A78 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 325  8A7B 06 20            ld   b, 32
 326  8A7D              .color_title_loop:
 327  8A7D 77               ld   (hl), a
 328  8A7E 23               inc  hl
 329  8A7F 10 FC            djnz .color_title_loop
 330  8A81
 331  8A81                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 332  8A81 3E BF            ld   a, $bf
 333  8A83 DB FE            in   a, ($fe)
 334  8A85 1F               rra
 335  8A86 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 336  8A88
 337  8A88                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 338  8A88              .wait_title_enter_release_after:
 339  8A88 76               halt
 340  8A89 3E BF            ld   a, $bf
 341  8A8B DB FE            in   a, ($fe)
 342  8A8D 1F               rra
 343  8A8E 30 F8            jr   nc, .wait_title_enter_release_after
 344  8A90
 345  8A90                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 346  8A90 AF               xor  a
 347  8A91 D3 FE            out  ($fe), a              ; Bordo a nero
 348  8A93 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 349  8A96
 350  8A96                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 351  8A96 CD 57 8C         call ResetFullGameState
 352  8A99
 353  8A99                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 354  8A99 C3 19 89         jp   LoadRoomAndRestart

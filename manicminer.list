1015+ 8307                  ; Willy lower or equal (DeltaY >= 0):
1016+ 8307                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
1017+ 8307 32 74 F0         ld   (row_enemy_cur), a
1018+ 830A AF               xor  a

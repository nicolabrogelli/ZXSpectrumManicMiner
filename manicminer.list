 375+ 7E83 E6 40            and  $40                       ; Vertical?
 376+ 7E85 20 15            jr   nz, .v_frame
 377+ 7E87
 378+ 7E87                  ; Guardiano Orizzontale:
 379+ 7E87 DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 380+ 7E8A E6 03            and  3
 381+ 7E8C 5F               ld   e, a                      ; E = Anim subframe
 382+ 7E8D
 383+ 7E8D DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 384+ 7E90 FE 01            cp   1                         ; Sinistra?
 385+ 7E92 28 03            jr   z, .left_frames
 386+ 7E94
 387+ 7E94                  ; Movimento a Destra: Frame 0..3
 388+ 7E94 7B               ld   a, e
 389+ 7E95 18 0A            jr   .got_frame_idx
 390+ 7E97
 391+ 7E97              .left_frames:
 392+ 7E97                  ; Movimento a Sinistra: Frame 4..7

 342  84D7                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 343  84D7 AF               xor  a
 344  84D8 D3 FE            out  ($fe), a              ; Bordo a nero
 345  84DA 21 8D 5C         ld   hl, ATTR_P
 346  84DD 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 347  84DE CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 348  84E1 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 349  84E3 3E 07            ld   a, $07
 350  84E5 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 351  84E8
 352  84E8                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 353  84E8 CD 5D 87         call ResetFullGameState
 354  84EB
 355  84EB                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 356  84EB C3 70 83         jp   LoadRoomAndRestart
 357  84EE
 358  84EE              ; -------------------------------------------------------------------
 359  84EE              ; TriggerGameOver
 360  84EE              ; Scatena la schermata di Game Over per la stanza corrente.
 361  84EE              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 362  84EE              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 363  84EE              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 364  84EE              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 365  84EE              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 366  84EE              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 367  84EE              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 368  84EE              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 369  84EE              ; -------------------------------------------------------------------
 370  84EE              TriggerGameOver:
 371  84EE                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 372  84EE CD C3 65         call Gfx_DrawGameOverScreen
 373  84F1
 374  84F1                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 375  84F1              .wait_keys_release:
 376  84F1 76               halt
 377  84F2                  ; Controlla tasto Y (Porta $DF, bit 4)
 378  84F2 01 FE DF         ld   bc, $dffe
 379  84F5 ED 78            in   a, (c)
 380  84F7 CB 67            bit  4, a
 381  84F9 28 F6            jr   z, .wait_keys_release
 382  84FB
 383  84FB                  ; Controlla tasto N (Porta $7F, bit 3)
 384  84FB 01 FE 7F         ld   bc, $7ffe
 385  84FE ED 78            in   a, (c)
 386  8500 CB 5F            bit  3, a
 387  8502 28 ED            jr   z, .wait_keys_release
 388  8504
 389  8504                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 390  8504 01 FE BF         ld   bc, $bffe
 391  8507 ED 78            in   a, (c)
 392  8509 CB 47            bit  0, a
 393  850B 28 E4            jr   z, .wait_keys_release
 394  850D
 395  850D                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 396  850D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 397  850F              .wait_choice_loop:
 398  850F 76               halt
 399  8510
 400  8510                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 401  8510 0C               inc  c
 402  8511 79               ld   a, c
 403  8512 CB 3F            srl  a
 404  8514 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 405  8516 E6 07            and  7
 406  8518 5F               ld   e, a
 407  8519 16 00            ld   d, 0
 408  851B 21 7F 65         ld   hl, game_over_color_table
 409  851E 19               add  hl, de
 410  851F 7E               ld   a, (hl)               ; A = nuovo colore attributo
 411  8520 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 412  8523 06 09            ld   b, 9
 413  8525              .color_cycle_loop:
 414  8525 77               ld   (hl), a
 415  8526 23               inc  hl
 416  8527 10 FC            djnz .color_cycle_loop
 417  8529
 418  8529                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 419  8529 01 FE DF         ld   bc, $dffe
 420  852C ED 78            in   a, (c)
 421  852E CB 67            bit  4, a
 422  8530 28 2A            jr   z, .continue_chosen
 423  8532
 424  8532                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 425  8532 01 FE 7F         ld   bc, $7ffe
 426  8535 ED 78            in   a, (c)
 427  8537 CB 5F            bit  3, a
 428  8539 28 0B            jr   z, .quit_chosen
 429  853B
 430  853B                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 431  853B 01 FE BF         ld   bc, $bffe
 432  853E ED 78            in   a, (c)
 433  8540 CB 47            bit  0, a
 434  8542 28 02            jr   z, .quit_chosen
 435  8544
 436  8544 18 C9            jr   .wait_choice_loop
 437  8546
 438  8546              .quit_chosen:
 439  8546                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 440  8546              .wait_quit_release:
 441  8546 76               halt
 442  8547 01 FE 7F         ld   bc, $7ffe
 443  854A ED 78            in   a, (c)
 444  854C CB 5F            bit  3, a
 445  854E 28 F6            jr   z, .wait_quit_release
 446  8550 01 FE BF         ld   bc, $bffe
 447  8553 ED 78            in   a, (c)
 448  8555 CB 47            bit  0, a
 449  8557 28 ED            jr   z, .wait_quit_release

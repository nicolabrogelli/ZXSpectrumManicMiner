 720+ 8846                  ; Byte 1:
 721+ 8846 3A 40 F1         ld   a, (player_score + 1)
 722+ 8849 47               ld   b, a
 723+ 884A 3A 43 F1         ld   a, (high_score + 1)
 724+ 884D B8               cp   b
 725+ 884E 38 0C            jr   c, .new_high_score
 726+ 8850 20 1C            jr   nz, .done_check
 727+ 8852
 728+ 8852                  ; Byte 0:
 729+ 8852 3A 3F F1         ld   a, (player_score + 0)
 730+ 8855 47               ld   b, a
 731+ 8856 3A 42 F1         ld   a, (high_score + 0)
 732+ 8859 B8               cp   b
 733+ 885A 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

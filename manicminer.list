 408+ 8229              ; CheckWillyItemCollision
 409+ 8229              ;
 410+ 8229              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 8229              ; Input:
 412+ 8229              ;   A = Item Col (0..31)
 413+ 8229              ;   H = Item Row (0..15)
 414+ 8229              ; Output:
 415+ 8229              ;   Carry Set = Collisione
 416+ 8229              ;   Carry Clear = Nessuna collisione
 417+ 8229              ; -------------------------------------------------------------------
 418+ 8229              CheckWillyItemCollision:
 419+ 8229 C5               push bc
 420+ 822A D5               push de
 421+ 822B E5               push hl
 422+ 822C
 423+ 822C                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 822C 6F               ld   l, a
 425+ 822D 87               add  a, a                      ; *2
 426+ 822E 87               add  a, a                      ; *4
 427+ 822F 87               add  a, a                      ; *8
 428+ 8230 5F               ld   e, a                      ; E = ItemLeft
 429+ 8231 C6 07            add  a, 7
 430+ 8233 57               ld   d, a                      ; D = ItemRight
 431+ 8234
 432+ 8234 ED 4B 69 AA      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 8238
 434+ 8238                  ; WillyLeft <= ItemRight
 435+ 8238 79               ld   a, c                      ; A = WillyX
 436+ 8239 BA               cp   d                         ; D = ItemRight
 437+ 823A 28 04            jr   z, .x_ok
 438+ 823C 38 02            jr   c, .x_ok
 439+ 823E 18 31            jr   .no_collision
 440+ 8240
 441+ 8240              .x_ok:
 442+ 8240                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 8240 BB               cp   e                         ; E = ItemLeft
 444+ 8241 28 0B            jr   z, .y_check
 445+ 8243 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 8245
 447+ 8245                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 8245 C6 0F            add  a, 15
 449+ 8247 BB               cp   e
 450+ 8248 28 04            jr   z, .y_check
 451+ 824A 30 02            jr   nc, .y_check
 452+ 824C 18 23            jr   .no_collision
 453+ 824E
 454+ 824E              .y_check:
 455+ 824E                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 824E 7C               ld   a, h                      ; H = Item Row
 457+ 824F 87               add  a, a                      ; *2
 458+ 8250 87               add  a, a                      ; *4
 459+ 8251 87               add  a, a                      ; *8
 460+ 8252 5F               ld   e, a                      ; E = ItemTop
 461+ 8253 C6 07            add  a, 7
 462+ 8255 57               ld   d, a                      ; D = ItemBottom
 463+ 8256
 464+ 8256                  ; WillyTop <= ItemBottom
 465+ 8256 78               ld   a, b                      ; A = WillyY
 466+ 8257 BA               cp   d                         ; D = ItemBottom
 467+ 8258 28 04            jr   z, .y_ok
 468+ 825A 38 02            jr   c, .y_ok
 469+ 825C 18 13            jr   .no_collision
 470+ 825E
 471+ 825E              .y_ok:
 472+ 825E                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 825E BB               cp   e                         ; E = ItemTop
 474+ 825F 28 0B            jr   z, .collision
 475+ 8261 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 8263
 477+ 8263                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 8263 C6 0F            add  a, 15
 479+ 8265 BB               cp   e
 480+ 8266 28 04            jr   z, .collision
 481+ 8268 30 02            jr   nc, .collision
 482+ 826A 18 05            jr   .no_collision

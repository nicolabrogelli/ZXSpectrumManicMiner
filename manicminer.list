 551  86CC ED 78            in   a, (c)
 552  86CE CB 5F            bit  3, a
 553  86D0 28 ED            jr   z, .wait_keys_release
 554  86D2
 555  86D2                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  86D2 01 FE BF         ld   bc, $bffe
 557  86D5 ED 78            in   a, (c)
 558  86D7 CB 47            bit  0, a
 559  86D9 28 E4            jr   z, .wait_keys_release

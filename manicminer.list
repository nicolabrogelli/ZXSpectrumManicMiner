1763+ 7B29 47               ld   b, a
1764+ 7B2A CD C7 7A         call CheckNastyCell
1765+ 7B2D 38 0C            jr   c, .collision
1766+ 7B2F
1767+ 7B2F                  ; Punto 6: Bottom-Right (X + 7, Y + 15)
1768+ 7B2F 79               ld   a, c
1769+ 7B30 C6 07            add  a, 7
1770+ 7B32 4F               ld   c, a
1771+ 7B33 CD C7 7A         call CheckNastyCell
1772+ 7B36 38 03            jr   c, .collision
1773+ 7B38
1774+ 7B38 C1               pop  bc
1775+ 7B39 B7               or   a                 ; Clear carry
1776+ 7B3A C9               ret
1777+ 7B3B
1778+ 7B3B              .collision:

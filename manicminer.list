 287+ 8128              ; DrawItemGraphic
 288+ 8128              ;
 289+ 8128              ; Disegna un oggetto 8x8 pixel sullo schermo dello ZX Spectrum
 290+ 8128              ; utilizzando una bitmap di 8 byte e un attributo colore.
 291+ 8128              ;
 292+ 8128              ; Input:
 293+ 8128              ;   B = Riga attributi (0..23)
 294+ 8128              ;   C = Colonna attributi (0..31)
 295+ 8128              ;   HL = Puntatore alla bitmap dell'oggetto (8 byte)

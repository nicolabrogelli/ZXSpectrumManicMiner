 546+ 80A7 19               add  hl, de
 547+ 80A8 36 00            ld   (hl), 0
 548+ 80AA C1               pop  bc
 549+ 80AB
 550+ 80AB                  ; 3. Disattiva lo slot nella cache
 551+ 80AB FD 36 02 00      ld   (iy+2), 0
 552+ 80AF
 553+ 80AF                  ; 4. Decrementa il numero di item rimanenti nella stanza corrente

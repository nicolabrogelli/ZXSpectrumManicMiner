 441+ 7F27              ; Enemy_DrawSingleSlot
 442+ 7F27              ;
 443+ 7F27              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 444+ 7F27              ; La grafica (8 frame da 32 byte) è letta direttamente da
 445+ 7F27              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 446+ 7F27              ; -------------------------------------------------------------------
 447+ 7F27              Enemy_DrawSingleSlot:
 448+ 7F27 C5               push bc
 449+ 7F28 D5               push de
 450+ 7F29 E5               push hl
 451+ 7F2A DD E5            push ix
 452+ 7F2C
 453+ 7F2C                  ; 1. Salva subito le coordinate X e Y dal record IX

1270+ 64F6 0E 78            ld   c, 120
1271+ 64F8 DD 21 A7 6B      ld   ix, PiedeSprite
1272+ 64FC CD 17 5F         call Gfx_DrawPixelSprite16x16
1273+ 64FF
1274+ 64FF                  ; 7c. Imposta colore Giallo Brillante per PiedeSprite
1275+ 64FF 0E 78            ld   c, 120
1276+ 6501 3E 46            ld   a, YELLOW | $40
1277+ 6503 CD AF 6A         call Gfx_SetEnemyColorAttributes
1278+ 6506
1279+ 6506                  ; 7d. Pausa per movimento fluido a 50Hz
1280+ 6506 76               halt
1281+ 6507
1282+ 6507 C1               pop  bc                    ; B = Y corrente
1283+ 6508 78               ld   a, b
1284+ 6509 C6 02            add  a, 2                  ; Avanza di 2 pixel
1285+ 650B 47               ld   b, a
1286+ 650C FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1287+ 650E 38 B2            jr   c, .foot_descent_loop
1288+ 6510
1289+ 6510                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1290+ 6510 06 23            ld   b, 35

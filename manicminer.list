  72+ 86CE ~            ; Audio_UpdateMusic
  73+ 86CE ~            ;
  74+ 86CE ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 86CE ~            ; Viene chiamata a ogni frame.
  76+ 86CE ~            ; -------------------------------------------------------------------
  77+ 86CE ~            Audio_UpdateMusic:
  78+ 86CE ~                push af
  79+ 86CE ~                push bc
  80+ 86CE ~                push de
  81+ 86CE ~                push hl
  82+ 86CE ~
  83+ 86CE ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 86CE ~                ld   a, (Audio_jump_sound_note)
  85+ 86CE ~                cp   18
  86+ 86CE ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 86CE ~
  88+ 86CE ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 86CE ~                ld   a, (Audio_music_frame_counter)
  90+ 86CE ~                dec  a
  91+ 86CE ~                ld   (Audio_music_frame_counter), a
  92+ 86CE ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 86CE ~
  94+ 86CE ~                ; Altrimenti carica la nota successiva
  95+ 86CE ~                ld   a, (Audio_music_note_idx)
  96+ 86CE ~                inc  a
  97+ 86CE ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 86CE ~                jr   c, .no_wrap
  99+ 86CE ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 86CE ~            .no_wrap:
 101+ 86CE ~                ld   (Audio_music_note_idx), a
 102+ 86CE ~
 103+ 86CE ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 86CE ~                ld   e, a
 105+ 86CE ~                ld   d, 0
 106+ 86CE ~                ld   hl, Audio_MusicSheet
 107+ 86CE ~                add  hl, de
 108+ 86CE ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 86CE ~
 110+ 86CE ~                ; Leggi durata (secondo byte)
 111+ 86CE ~                inc  hl
 112+ 86CE ~                ld   a, (hl)
 113+ 86CE ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 86CE ~                jr   nz, .dur_ok
 115+ 86CE ~                ld   a, 1
 116+ 86CE ~            .dur_ok:
 117+ 86CE ~                ld   (Audio_music_frame_counter), a
 118+ 86CE ~
 119+ 86CE ~            .play_current_note:
 120+ 86CE ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 86CE ~                ld   a, (Audio_music_note_idx)
 122+ 86CE ~                ld   e, a
 123+ 86CE ~                ld   d, 0
 124+ 86CE ~                ld   hl, Audio_MusicSheet
 125+ 86CE ~                add  hl, de
 126+ 86CE ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 86CE ~                ld   a, (hl)                  ; A = delay
 128+ 86CE ~                or   a
 129+ 86CE ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 86CE ~
 131+ 86CE ~                ; Suona la nota: 2 cicli
 132+ 86CE ~                ld   d, a                     ; D = delay
 133+ 86CE ~                ld   b, 2                     ; 2 cicli per frame
 134+ 86CE ~            .note_loop:
 135+ 86CE ~                ; Speaker ON
 136+ 86CE ~                ld   a, (room_border_color)
 137+ 86CE ~                or   $10
 138+ 86CE ~                out  ($fe), a
 139+ 86CE ~                ld   c, d
 140+ 86CE ~            .d1:
 141+ 86CE ~                push af
 142+ 86CE ~                pop  af
 143+ 86CE ~                dec  c
 144+ 86CE ~                jr   nz, .d1
 145+ 86CE ~
 146+ 86CE ~                ; Speaker OFF
 147+ 86CE ~                ld   a, (room_border_color)
 148+ 86CE ~                and  $ef
 149+ 86CE ~                out  ($fe), a
 150+ 86CE ~                ld   c, d
 151+ 86CE ~            .d2:
 152+ 86CE ~                push af
 153+ 86CE ~                pop  af
 154+ 86CE ~                dec  c
 155+ 86CE ~                jr   nz, .d2
 156+ 86CE ~
 157+ 86CE ~                djnz .note_loop
 158+ 86CE ~
 159+ 86CE ~            .done:
 160+ 86CE ~                pop  hl
 161+ 86CE ~                pop  de
 162+ 86CE ~                pop  bc
 163+ 86CE ~                pop  af
 164+ 86CE ~                ret
 165+ 86CE ~
 166+ 86CE ~            Audio_MusicSheet:
 167+ 86CE ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 86CE ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 86CE ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 86CE ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 86CE ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 86CE ~                db 90, 10, 107, 20, 68, 65

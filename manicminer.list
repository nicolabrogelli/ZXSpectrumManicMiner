 423  8529 10 FC            djnz .color_cycle_loop
 424  852B
 425  852B                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 426  852B 01 FE DF         ld   bc, $dffe
 427  852E ED 78            in   a, (c)
 428  8530 CB 67            bit  4, a
 429  8532 28 2A            jr   z, .continue_chosen
 430  8534
 431  8534                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)

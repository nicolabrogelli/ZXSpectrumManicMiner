1924+ 7C0F              ; Phys_UpdateAir
1925+ 7C0F              ; Aggiorna il consumo di aria durante ogni frame di gioco.
1926+ 7C0F              ; Decrementa progressivamente i pixel di aria e aggiorna la barra a schermo.
1927+ 7C0F              ; Output:
1928+ 7C0F              ;   Carry Set   = Aria esaurita (Willy muore per asfissia)
1929+ 7C0F              ;   Carry Clear = Aria ancora disponibile
1930+ 7C0F              ; -------------------------------------------------------------------
1931+ 7C0F              Phys_UpdateAir:
1932+ 7C0F                  ; Incrementa il timer dei frame
1933+ 7C0F 3A 29 E8         ld   a, (air_timer)
1934+ 7C12 3C               inc  a
1935+ 7C13 32 29 E8         ld   (air_timer), a
1936+ 7C16 21 2A E8         ld   hl, air_deplete_rate
1937+ 7C19 BE               cp   (hl)
1938+ 7C1A 38 14            jr   c, .no_deplete
1939+ 7C1C
1940+ 7C1C                  ; Intervallo raggiunto: azzera timer e consuma 1 pixel di aria
1941+ 7C1C AF               xor  a
1942+ 7C1D 32 29 E8         ld   (air_timer), a
1943+ 7C20
1944+ 7C20 3A 28 E8         ld   a, (air_pixels)
1945+ 7C23 B7               or   a
1946+ 7C24 28 0C            jr   z, .air_finished
1947+ 7C26
1948+ 7C26 3D               dec  a
1949+ 7C27 32 28 E8         ld   (air_pixels), a
1950+ 7C2A CD 27 6A         call Gfx_UpdateAirBar
1951+ 7C2D
1952+ 7C2D B7               or   a
1953+ 7C2E 28 02            jr   z, .air_finished
1954+ 7C30
1955+ 7C30              .no_deplete:
1956+ 7C30 B7               or   a                     ; Carry Clear = Ok
1957+ 7C31 C9               ret
1958+ 7C32
1959+ 7C32              .air_finished:
1960+ 7C32 37               scf                        ; Carry Set = Morte per esaurimento aria
1961+ 7C33 C9               ret

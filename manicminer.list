 546+ 82B9 19               add  hl, de
 547+ 82BA 36 00            ld   (hl), 0
 548+ 82BC C1               pop  bc
 549+ 82BD
 550+ 82BD                  ; 3. Disattiva lo slot nella cache
 551+ 82BD FD 36 02 00      ld   (iy+2), 0
 552+ 82C1

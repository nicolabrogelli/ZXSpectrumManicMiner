1135+ 7870              ; -------------------------------------------------------------------
1136+ 7870              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7870              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7870              ; Output: A = tipo di cella (0..3)
1139+ 7870              ; Preserva tutti gli altri registri.
1140+ 7870              ; -------------------------------------------------------------------
1141+ 7870              GetCellFromUnpacked:
1142+ 7870 E5               push hl
1143+ 7871 D5               push de
1144+ 7872
1145+ 7872 6F               ld   l, a
1146+ 7873 26 00            ld   h, 0
1147+ 7875 29               add  hl, hl
1148+ 7876 29               add  hl, hl
1149+ 7877 29               add  hl, hl
1150+ 7878 29               add  hl, hl
1151+ 7879 29               add  hl, hl            ; HL = Row * 32
1152+ 787A 59               ld   e, c
1153+ 787B 16 00            ld   d, 0
1154+ 787D 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 787E 11 F5 BB         ld   de, unpacked_layout
1156+ 7881 19               add  hl, de
1157+ 7882 7E               ld   a, (hl)           ; A = cell type
1158+ 7883
1159+ 7883 D1               pop  de
1160+ 7884 E1               pop  hl
1161+ 7885 C9               ret

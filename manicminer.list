  71+ 879D ~            ; -------------------------------------------------------------------
  72+ 879D ~            ; Audio_UpdateMusic
  73+ 879D ~            ;
  74+ 879D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 879D ~            ; Viene chiamata a ogni frame.
  76+ 879D ~            ; -------------------------------------------------------------------
  77+ 879D ~            Audio_UpdateMusic:
  78+ 879D ~                push af
  79+ 879D ~                push bc
  80+ 879D ~                push de
  81+ 879D ~                push hl
  82+ 879D ~
  83+ 879D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 879D ~                ld   a, (Audio_jump_sound_note)
  85+ 879D ~                cp   18
  86+ 879D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 879D ~
  88+ 879D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 879D ~                ld   a, (Audio_music_frame_counter)
  90+ 879D ~                dec  a
  91+ 879D ~                ld   (Audio_music_frame_counter), a
  92+ 879D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 879D ~
  94+ 879D ~                ; Altrimenti carica la nota successiva
  95+ 879D ~                ld   a, (Audio_music_note_idx)
  96+ 879D ~                inc  a
  97+ 879D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 879D ~                jr   c, .no_wrap
  99+ 879D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 879D ~            .no_wrap:
 101+ 879D ~                ld   (Audio_music_note_idx), a
 102+ 879D ~
 103+ 879D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 879D ~                ld   e, a
 105+ 879D ~                ld   d, 0
 106+ 879D ~                ld   hl, Audio_MusicSheet
 107+ 879D ~                add  hl, de
 108+ 879D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 879D ~
 110+ 879D ~                ; Leggi durata (secondo byte)
 111+ 879D ~                inc  hl
 112+ 879D ~                ld   a, (hl)
 113+ 879D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 879D ~                jr   nz, .dur_ok
 115+ 879D ~                ld   a, 1
 116+ 879D ~            .dur_ok:
 117+ 879D ~                ld   (Audio_music_frame_counter), a
 118+ 879D ~
 119+ 879D ~            .play_current_note:
 120+ 879D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 879D ~                ld   a, (Audio_music_note_idx)
 122+ 879D ~                ld   e, a
 123+ 879D ~                ld   d, 0
 124+ 879D ~                ld   hl, Audio_MusicSheet
 125+ 879D ~                add  hl, de
 126+ 879D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 879D ~                ld   a, (hl)                  ; A = delay
 128+ 879D ~                or   a
 129+ 879D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 879D ~
 131+ 879D ~                ; Suona la nota: 2 cicli
 132+ 879D ~                ld   d, a                     ; D = delay
 133+ 879D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 879D ~            .note_loop:
 135+ 879D ~                ; Speaker ON
 136+ 879D ~                ld   a, (room_border_color)
 137+ 879D ~                or   $10
 138+ 879D ~                out  ($fe), a
 139+ 879D ~                ld   c, d
 140+ 879D ~            .d1:
 141+ 879D ~                push af
 142+ 879D ~                pop  af
 143+ 879D ~                dec  c
 144+ 879D ~                jr   nz, .d1
 145+ 879D ~
 146+ 879D ~                ; Speaker OFF
 147+ 879D ~                ld   a, (room_border_color)
 148+ 879D ~                and  $ef
 149+ 879D ~                out  ($fe), a
 150+ 879D ~                ld   c, d
 151+ 879D ~            .d2:
 152+ 879D ~                push af
 153+ 879D ~                pop  af
 154+ 879D ~                dec  c
 155+ 879D ~                jr   nz, .d2
 156+ 879D ~
 157+ 879D ~                djnz .note_loop
 158+ 879D ~
 159+ 879D ~            .done:
 160+ 879D ~                pop  hl
 161+ 879D ~                pop  de
 162+ 879D ~                pop  bc
 163+ 879D ~                pop  af
 164+ 879D ~                ret
 165+ 879D ~
 166+ 879D ~            Audio_MusicSheet:
 167+ 879D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 879D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 879D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 879D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 879D ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 879D ~                db 90, 10, 107, 20, 68, 65

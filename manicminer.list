 551  889A ED 78            in   a, (c)
 552  889C CB 5F            bit  3, a
 553  889E 28 ED            jr   z, .wait_keys_release
 554  88A0
 555  88A0                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 556  88A0 01 FE BF         ld   bc, $bffe
 557  88A3 ED 78            in   a, (c)
 558  88A5 CB 47            bit  0, a
 559  88A7 28 E4            jr   z, .wait_keys_release
 560  88A9
 561  88A9                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 562  88A9 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 563  88AB              .wait_choice_loop:

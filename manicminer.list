 283+ 6D6E              ; Struttura dati stanza:
 284+ 6D6E              ;   OFFSET_POS_WILLY:
 285+ 6D6E              ;       +0 = X
 286+ 6D6E              ;       +1 = Y
 287+ 6D6E              ; -------------------------------------------------------------------

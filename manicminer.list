2036+ 7D76              .advance_crumble_cell:
2037+ 7D76                  ; Input: B = Row, C = Col
2038+ 7D76 C5               push bc
2039+ 7D77 D5               push de
2040+ 7D78 E5               push hl
2041+ 7D79
2042+ 7D79                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2043+ 7D79 68               ld   l, b
2044+ 7D7A 26 00            ld   h, 0
2045+ 7D7C 29               add  hl, hl
2045+ 7D7D 29             add hl, hl
2045+ 7D7E 29             add hl, hl
2045+ 7D7F 29             add hl, hl
2045+ 7D80 29             add hl, hl
2046+ 7D81 59               ld   e, c
2047+ 7D82 16 00            ld   d, 0
2048+ 7D84 19               add  hl, de
2049+ 7D85 11 3D EF         ld   de, crumbling_grid
2050+ 7D88 19               add  hl, de
2051+ 7D89
2052+ 7D89                  ; 2. Avanza di 1 stadio
2053+ 7D89 7E               ld   a, (hl)               ; A = Stage (0..8)
2054+ 7D8A FE 08            cp   8
2055+ 7D8C 30 1F            jr   nc, .done_advance     ; Già completamente sgretolato
2056+ 7D8E
2057+ 7D8E 3C               inc  a                     ; Avanza di 1 scanline (1..8)
2058+ 7D8F 77               ld   (hl), a
2059+ 7D90 5F               ld   e, a                  ; E = nuovo Stage (1..8)
2060+ 7D91
2061+ 7D91                  ; 3. Ridisegna la tile nello stadio corrente (trasla il bitmap verso il basso di 1 pixel)
2062+ 7D91 E5               push hl
2063+ 7D92 CD 2A 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2064+ 7D95 E1               pop  hl
2065+ 7D96
2066+ 7D96                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2067+ 7D96 7E               ld   a, (hl)
2068+ 7D97 FE 08            cp   8
2069+ 7D99 38 12            jr   c, .done_advance
2070+ 7D9B
2071+ 7D9B                  ; Rimuovi da unpacked_layout (imposta a 0 = Background)
2072+ 7D9B 68               ld   l, b                  ; L = Row
2073+ 7D9C 26 00            ld   h, 0
2074+ 7D9E 29               add  hl, hl
2074+ 7D9F 29             add hl, hl
2074+ 7DA0 29             add hl, hl
2074+ 7DA1 29             add hl, hl
2074+ 7DA2 29             add hl, hl
2075+ 7DA3 59               ld   e, c
2076+ 7DA4 16 00            ld   d, 0
2077+ 7DA6 19               add  hl, de
2078+ 7DA7 11 52 EC         ld   de, unpacked_layout
2079+ 7DAA 19               add  hl, de
2080+ 7DAB 36 00            ld   (hl), 0               ; 0 = Background (non più solido!)
2081+ 7DAD
2082+ 7DAD              .done_advance:
2083+ 7DAD E1               pop  hl
2084+ 7DAE D1               pop  de
2085+ 7DAF C1               pop  bc
2086+ 7DB0 C9               ret

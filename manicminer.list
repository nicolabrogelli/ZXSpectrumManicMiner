 408+ 8192              ; CheckWillyItemCollision
 409+ 8192              ;
 410+ 8192              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 8192              ; Input:
 412+ 8192              ;   A = Item Col (0..31)
 413+ 8192              ;   H = Item Row (0..15)
 414+ 8192              ; Output:
 415+ 8192              ;   Carry Set = Collisione
 416+ 8192              ;   Carry Clear = Nessuna collisione
 417+ 8192              ; -------------------------------------------------------------------
 418+ 8192              CheckWillyItemCollision:
 419+ 8192 C5               push bc
 420+ 8193 D5               push de
 421+ 8194 E5               push hl
 422+ 8195
 423+ 8195                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 8195 6F               ld   l, a
 425+ 8196 87               add  a, a                      ; *2
 426+ 8197 87               add  a, a                      ; *4
 427+ 8198 87               add  a, a                      ; *8
 428+ 8199 5F               ld   e, a                      ; E = ItemLeft
 429+ 819A C6 07            add  a, 7
 430+ 819C 57               ld   d, a                      ; D = ItemRight
 431+ 819D
 432+ 819D ED 4B 04 9E      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81A1
 434+ 81A1                  ; WillyLeft <= ItemRight
 435+ 81A1 79               ld   a, c                      ; A = WillyX
 436+ 81A2 BA               cp   d                         ; D = ItemRight
 437+ 81A3 28 04            jr   z, .x_ok
 438+ 81A5 38 02            jr   c, .x_ok
 439+ 81A7 18 31            jr   .no_collision
 440+ 81A9
 441+ 81A9              .x_ok:
 442+ 81A9                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81A9 BB               cp   e                         ; E = ItemLeft
 444+ 81AA 28 0B            jr   z, .y_check
 445+ 81AC 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81AE
 447+ 81AE                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81AE C6 0F            add  a, 15
 449+ 81B0 BB               cp   e
 450+ 81B1 28 04            jr   z, .y_check
 451+ 81B3 30 02            jr   nc, .y_check
 452+ 81B5 18 23            jr   .no_collision
 453+ 81B7
 454+ 81B7              .y_check:
 455+ 81B7                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81B7 7C               ld   a, h                      ; H = Item Row
 457+ 81B8 87               add  a, a                      ; *2
 458+ 81B9 87               add  a, a                      ; *4
 459+ 81BA 87               add  a, a                      ; *8
 460+ 81BB 5F               ld   e, a                      ; E = ItemTop
 461+ 81BC C6 07            add  a, 7
 462+ 81BE 57               ld   d, a                      ; D = ItemBottom
 463+ 81BF
 464+ 81BF                  ; WillyTop <= ItemBottom
 465+ 81BF 78               ld   a, b                      ; A = WillyY
 466+ 81C0 BA               cp   d                         ; D = ItemBottom
 467+ 81C1 28 04            jr   z, .y_ok
 468+ 81C3 38 02            jr   c, .y_ok
 469+ 81C5 18 13            jr   .no_collision
 470+ 81C7
 471+ 81C7              .y_ok:
 472+ 81C7                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81C7 BB               cp   e                         ; E = ItemTop
 474+ 81C8 28 0B            jr   z, .collision
 475+ 81CA 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81CC
 477+ 81CC                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81CC C6 0F            add  a, 15
 479+ 81CE BB               cp   e
 480+ 81CF 28 04            jr   z, .collision
 481+ 81D1 30 02            jr   nc, .collision
 482+ 81D3 18 05            jr   .no_collision
 483+ 81D5
 484+ 81D5              .collision:
 485+ 81D5 E1               pop  hl
 486+ 81D6 D1               pop  de
 487+ 81D7 C1               pop  bc
 488+ 81D8 37               scf
 489+ 81D9 C9               ret
 490+ 81DA
 491+ 81DA              .no_collision:
 492+ 81DA E1               pop  hl
 493+ 81DB D1               pop  de
 494+ 81DC C1               pop  bc
 495+ 81DD B7               or   a
 496+ 81DE C9               ret

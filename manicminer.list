2103+ 7E42 E5               push hl
2104+ 7E43 CD 3F 6B         call Gfx_DrawCrumblingTile ; Input: B = Row, C = Col, E = Stage (1..8)
2105+ 7E46 E1               pop  hl
2106+ 7E47
2107+ 7E47                  ; 4. Se lo stadio ha raggiunto 8, rimuovi definitivamente da unpacked_layout
2108+ 7E47 7E               ld   a, (hl)

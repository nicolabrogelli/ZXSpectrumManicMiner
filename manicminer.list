 287  877C              ; -------------------------------------------------------------------
 288  877C              ; ShowTitleScreen
 289  877C              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  877C              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  877C              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  877C              ; -------------------------------------------------------------------
 293  877C              ShowTitleScreen:
 294  877C                  ; 1. Disegna la schermata iniziale
 295  877C CD 76 64         call Gfx_DrawTitleScreen
 296  877F
 297  877F                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  877F              .wait_title_enter_release:
 299  877F 76               halt
 300  8780 3E BF            ld   a, $bf
 301  8782 DB FE            in   a, ($fe)
 302  8784 1F               rra
 303  8785 30 F8            jr   nc, .wait_title_enter_release
 304  8787
 305  8787                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  8787 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  8789              .title_loop:
 308  8789 76               halt
 309  878A
 310  878A                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  878A 0C               inc  c
 312  878B 79               ld   a, c
 313  878C CB 3F            srl  a
 314  878E CB 3F            srl  a
 315  8790 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  8792 E6 07            and  7
 317  8794 5F               ld   e, a
 318  8795 16 00            ld   d, 0
 319  8797 21 6E 64         ld   hl, title_color_table
 320  879A 19               add  hl, de
 321  879B 7E               ld   a, (hl)               ; A = nuovo colore
 322  879C 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  879F 06 20            ld   b, 32
 324  87A1              .color_title_loop:
 325  87A1 77               ld   (hl), a
 326  87A2 23               inc  hl
 327  87A3 10 FC            djnz .color_title_loop
 328  87A5
 329  87A5                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  87A5 3E BF            ld   a, $bf
 331  87A7 DB FE            in   a, ($fe)
 332  87A9 1F               rra
 333  87AA 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  87AC
 335  87AC                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  87AC              .wait_title_enter_release_after:
 337  87AC 76               halt
 338  87AD 3E BF            ld   a, $bf
 339  87AF DB FE            in   a, ($fe)
 340  87B1 1F               rra
 341  87B2 30 F8            jr   nc, .wait_title_enter_release_after
 342  87B4
 343  87B4                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  87B4 AF               xor  a
 345  87B5 D3 FE            out  ($fe), a              ; Bordo a nero
 346  87B7 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  87BA
 348  87BA                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 349  87BA CD 21 8A         call ResetFullGameState
 350  87BD
 351  87BD                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 352  87BD C3 43 86         jp   LoadRoomAndRestart

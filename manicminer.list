 386+ 7F12              ; Enemy_Update
 387+ 7F12              ;
 388+ 7F12              ; Aggiorna le posizioni e le animazioni dei guardiani attivi.
 389+ 7F12              ; -------------------------------------------------------------------
 390+ 7F12              Enemy_Update:
 391+ 7F12                  ; 0. Controllo della frequenza di aggiornamento guardiani (enemy_update_rate)
 392+ 7F12 3A B5 A1         ld   a, (enemy_update_rate)
 393+ 7F15 FE 01            cp   1
 394+ 7F17 28 0E            jr   z, .do_update             ; Se rate == 1 (standard), aggiorna sempre
 395+ 7F19
 396+ 7F19 21 B6 A1         ld   hl, enemy_update_timer
 397+ 7F1C 34               inc  (hl)
 398+ 7F1D 7E               ld   a, (hl)
 399+ 7F1E 21 B5 A1         ld   hl, enemy_update_rate
 400+ 7F21 BE               cp   (hl)
 401+ 7F22 D8               ret  c                         ; Se il timer non ha ancora raggiunto la soglia, ritorna subito
 402+ 7F23 AF               xor  a
 403+ 7F24 32 B6 A1         ld   (enemy_update_timer), a
 404+ 7F27
 405+ 7F27              .do_update:
 406+ 7F27 E5               push hl
 407+ 7F28 D5               push de
 408+ 7F29 C5               push bc
 409+ 7F2A DD E5            push ix
 410+ 7F2C
 411+ 7F2C 3E 01            ld   a, 1
 412+ 7F2E 32 3C A2         ld   (enemy_was_updated), a

2034+ 7D4E              .advance_crumble_cell:
2035+ 7D4E                  ; Input: B = Row, C = Col
2036+ 7D4E C5               push bc
2037+ 7D4F D5               push de
2038+ 7D50 E5               push hl
2039+ 7D51
2040+ 7D51                  ; 1. Calcola offset in crumbling_grid: HL = Row * 32 + Col
2041+ 7D51 68               ld   l, b
2042+ 7D52 26 00            ld   h, 0
2043+ 7D54 29               add  hl, hl
2043+ 7D55 29             add hl, hl
2043+ 7D56 29             add hl, hl
2043+ 7D57 29             add hl, hl
2043+ 7D58 29             add hl, hl

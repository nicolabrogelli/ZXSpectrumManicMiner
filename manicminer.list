  72+ 86F8 ~            ; Audio_UpdateMusic
  73+ 86F8 ~            ;
  74+ 86F8 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 86F8 ~            ; Viene chiamata a ogni frame.
  76+ 86F8 ~            ; -------------------------------------------------------------------
  77+ 86F8 ~            Audio_UpdateMusic:
  78+ 86F8 ~                push af
  79+ 86F8 ~                push bc
  80+ 86F8 ~                push de
  81+ 86F8 ~                push hl
  82+ 86F8 ~
  83+ 86F8 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 86F8 ~                ld   a, (Audio_jump_sound_note)
  85+ 86F8 ~                cp   18
  86+ 86F8 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 86F8 ~
  88+ 86F8 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 86F8 ~                ld   a, (Audio_music_frame_counter)
  90+ 86F8 ~                dec  a
  91+ 86F8 ~                ld   (Audio_music_frame_counter), a
  92+ 86F8 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 86F8 ~
  94+ 86F8 ~                ; Altrimenti carica la nota successiva
  95+ 86F8 ~                ld   a, (Audio_music_note_idx)
  96+ 86F8 ~                inc  a
  97+ 86F8 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 86F8 ~                jr   c, .no_wrap
  99+ 86F8 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 86F8 ~            .no_wrap:
 101+ 86F8 ~                ld   (Audio_music_note_idx), a
 102+ 86F8 ~
 103+ 86F8 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 86F8 ~                ld   e, a
 105+ 86F8 ~                ld   d, 0
 106+ 86F8 ~                ld   hl, Audio_MusicSheet
 107+ 86F8 ~                add  hl, de
 108+ 86F8 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 86F8 ~
 110+ 86F8 ~                ; Leggi durata (secondo byte)
 111+ 86F8 ~                inc  hl
 112+ 86F8 ~                ld   a, (hl)
 113+ 86F8 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 86F8 ~                jr   nz, .dur_ok
 115+ 86F8 ~                ld   a, 1
 116+ 86F8 ~            .dur_ok:
 117+ 86F8 ~                ld   (Audio_music_frame_counter), a
 118+ 86F8 ~
 119+ 86F8 ~            .play_current_note:
 120+ 86F8 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 86F8 ~                ld   a, (Audio_music_note_idx)
 122+ 86F8 ~                ld   e, a
 123+ 86F8 ~                ld   d, 0
 124+ 86F8 ~                ld   hl, Audio_MusicSheet
 125+ 86F8 ~                add  hl, de
 126+ 86F8 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 86F8 ~                ld   a, (hl)                  ; A = delay
 128+ 86F8 ~                or   a
 129+ 86F8 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 86F8 ~
 131+ 86F8 ~                ; Suona la nota: 2 cicli
 132+ 86F8 ~                ld   d, a                     ; D = delay
 133+ 86F8 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 86F8 ~            .note_loop:
 135+ 86F8 ~                ; Speaker ON
 136+ 86F8 ~                ld   a, (room_border_color)
 137+ 86F8 ~                or   $10
 138+ 86F8 ~                out  ($fe), a
 139+ 86F8 ~                ld   c, d
 140+ 86F8 ~            .d1:
 141+ 86F8 ~                push af
 142+ 86F8 ~                pop  af
 143+ 86F8 ~                dec  c
 144+ 86F8 ~                jr   nz, .d1
 145+ 86F8 ~
 146+ 86F8 ~                ; Speaker OFF
 147+ 86F8 ~                ld   a, (room_border_color)
 148+ 86F8 ~                and  $ef
 149+ 86F8 ~                out  ($fe), a
 150+ 86F8 ~                ld   c, d
 151+ 86F8 ~            .d2:
 152+ 86F8 ~                push af
 153+ 86F8 ~                pop  af
 154+ 86F8 ~                dec  c
 155+ 86F8 ~                jr   nz, .d2
 156+ 86F8 ~
 157+ 86F8 ~                djnz .note_loop
 158+ 86F8 ~
 159+ 86F8 ~            .done:
 160+ 86F8 ~                pop  hl
 161+ 86F8 ~                pop  de
 162+ 86F8 ~                pop  bc
 163+ 86F8 ~                pop  af
 164+ 86F8 ~                ret
 165+ 86F8 ~
 166+ 86F8 ~            Audio_MusicSheet:
 167+ 86F8 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 86F8 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 86F8 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 86F8 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 86F8 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 86F8 ~                db 90, 10, 107, 20, 68, 65

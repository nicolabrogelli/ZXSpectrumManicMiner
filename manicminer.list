   6+ 7040              ; -------------------------------------------------------------------
   7+ 7040              ; Input_CheckCtrl
   8+ 7040              ; Legge la tastiera e popola il registro D con i flag di input.
   9+ 7040              ;
  10+ 7040              ; Output:
  11+ 7040              ;   D = bitmask tasti attivi:
  12+ 7040              ;       bit 0 → sinistra (O)
  13+ 7040              ;       bit 1 → destra   (P)
  14+ 7040              ;       bit 2 → salto    (Z)
  15+ 7040              ;
  16+ 7040              ; Effetti collaterali in RAM:
  17+ 7040              ;   (q_prev)        → debounce tasto Q (cambio stanza)
  18+ 7040              ;   (direction)     → 1=sinistra, 2=destra (ultimo movimento)
  19+ 7040              ;   (jump_prev)     → debounce tasto salto
  20+ 7040              ;   (jump_pressed)  → flag "salto appena premuto" (edge detection)

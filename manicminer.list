 817  83AD              ; CheckWillyConveyorCollision
 818  83AD              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 819  83AD              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 820  83AD              ; -------------------------------------------------------------------
 821  83AD              CheckWillyConveyorCollision:
 822  83AD C5               push bc
 823  83AE D5               push de
 824  83AF E5               push hl
 825  83B0
 826  83B0                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 827  83B0 CD 3C 74         call CheckWillyOnConveyor
 828  83B3 38 49            jr   c, .collision_detected
 829  83B5
 830  83B5                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 831  83B5 3A D5 95         ld   a, (conveyor_len)
 832  83B8 B7               or   a
 833  83B9 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 834  83BB
 835  83BB                  ; B = WillyY, C = WillyX
 836  83BB ED 4B AD 92      ld   bc, (PlayerPos)
 837  83BF
 838  83BF                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 839  83BF 3A D6 95         ld   a, (conveyor_row)
 840  83C2 87               add  a, a                  ; *2
 841  83C3 87               add  a, a                  ; *4
 842  83C4 87               add  a, a                  ; *8
 843  83C5 5F               ld   e, a                  ; E = ConveyorTop
 844  83C6 C6 07            add  a, 7
 845  83C8 57               ld   d, a                  ; D = ConveyorBottom
 846  83C9
 847  83C9                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 848  83C9 78               ld   a, b                  ; WillyTop
 849  83CA BA               cp   d
 850  83CB 28 04            jr   z, .y_overlap
 851  83CD 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 852  83CF 18 32            jr   .no_conv_collision
 853  83D1
 854  83D1              .y_overlap:
 855  83D1 C6 0F            add  a, 15                 ; WillyBottom
 856  83D3 BB               cp   e
 857  83D4 28 04            jr   z, .x_check
 858  83D6 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 859  83D8 18 29            jr   .no_conv_collision
 860  83DA
 861  83DA              .x_check:
 862  83DA                  ; ConveyorLeft = conveyor_col * 8
 863  83DA 3A D7 95         ld   a, (conveyor_col)
 864  83DD 87               add  a, a                  ; *2
 865  83DE 87               add  a, a                  ; *4
 866  83DF 87               add  a, a                  ; *8
 867  83E0 5F               ld   e, a                  ; E = ConveyorLeft
 868  83E1
 869  83E1                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 870  83E1 21 D5 95         ld   hl, conveyor_len
 871  83E4 3A D7 95         ld   a, (conveyor_col)
 872  83E7 86               add  a, (hl)
 873  83E8 87               add  a, a                  ; *2
 874  83E9 87               add  a, a                  ; *4
 875  83EA 87               add  a, a                  ; *8
 876  83EB 3D               dec  a                     ; ConveyorRight
 877  83EC 57               ld   d, a                  ; D = ConveyorRight
 878  83ED
 879  83ED                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 880  83ED 79               ld   a, c                  ; WillyLeft
 881  83EE BA               cp   d
 882  83EF 28 04            jr   z, .x_overlap
 883  83F1 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 884  83F3 18 0E            jr   .no_conv_collision
 885  83F5
 886  83F5              .x_overlap:
 887  83F5 C6 0F            add  a, 15                 ; WillyRight
 888  83F7 BB               cp   e
 889  83F8 28 04            jr   z, .collision_detected
 890  83FA 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 891  83FC 18 05            jr   .no_conv_collision

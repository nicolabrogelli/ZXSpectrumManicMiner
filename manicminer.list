 999+ 784B              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
1000+ 784B              ; Input: C = X, B = Y
1001+ 784B              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
1002+ 784B              ; -------------------------------------------------------------------
1003+ 784B              CheckWallCell:
1004+ 784B E5               push hl
1005+ 784C D5               push de
1006+ 784D C5               push bc
1007+ 784E
1008+ 784E                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
1009+ 784E 78               ld   a, b
1010+ 784F FE 80            cp   128
1011+ 7851 30 1F            jr   nc, .not_wall
1012+ 7853
1013+ 7853                  ; 2. Calcola riga di layout: r = Y / 8
1014+ 7853 CB 3F            srl  a
1015+ 7855 CB 3F            srl  a
1016+ 7857 CB 3F            srl  a                 ; A = r (0..15)
1017+ 7859
1018+ 7859                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1019+ 7859 5F               ld   e, a              ; E = r (Row)
1020+ 785A 79               ld   a, c
1021+ 785B CB 3F            srl  a
1022+ 785D CB 3F            srl  a
1023+ 785F CB 3F            srl  a                 ; A = c (0..31)
1024+ 7861 4F               ld   c, a              ; C = c (Col)
1025+ 7862
1026+ 7862                  ; Se la cella è sulla rampa, non considerarla un muro!
1027+ 7862 53               ld   d, e              ; D = Row
1028+ 7863 59               ld   e, c              ; E = Col
1029+ 7864 CD D0 77         call IsCellOnRamp
1030+ 7867 38 09            jr   c, .not_wall
1031+ 7869
1032+ 7869 7A               ld   a, d              ; A = Row
1033+ 786A 4B               ld   c, e              ; C = Col
1034+ 786B CD 07 79         call GetCellFromUnpacked ; A = cell type
1035+ 786E
1036+ 786E                  ; Controlla se è Wall (3)
1037+ 786E FE 03            cp   3
1038+ 7870 28 05            jr   z, .is_wall
1039+ 7872
1040+ 7872              .not_wall:
1041+ 7872 C1               pop  bc
1042+ 7873 D1               pop  de
1043+ 7874 E1               pop  hl

1164+ 787E              ; Phys_CheckRampOnRoomChange
1165+ 787E              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 787E              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 787E              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 787E              ; -------------------------------------------------------------------
1169+ 787E              Phys_CheckRampOnRoomChange:
1170+ 787E E5               push hl
1171+ 787F D5               push de
1172+ 7880 C5               push bc
1173+ 7881
1174+ 7881                  ; Offsets per RampData: DE + 218
1175+ 7881 21 DA 00         ld   hl, 218
1176+ 7884 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 7885
1178+ 7885 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 7886 32 95 AD         ld   (ramp_dir), a
1180+ 7889 23               inc  hl
1181+ 788A 5E               ld   e, (hl)
1182+ 788B 23               inc  hl
1183+ 788C 56               ld   d, (hl)           ; DE = Location
1184+ 788D 23               inc  hl
1185+ 788E 7E               ld   a, (hl)           ; A = Length
1186+ 788F 32 96 AD         ld   (ramp_len), a
1187+ 7892
1188+ 7892                  ; Controlla se DE (Location) è 0 o Length è 0
1189+ 7892 7A               ld   a, d
1190+ 7893 B3               or   e
1191+ 7894 CA 9B 79         jp   z, .no_ramp_change
1192+ 7897 3A 96 AD         ld   a, (ramp_len)
1193+ 789A B7               or   a
1194+ 789B CA 9B 79         jp   z, .no_ramp_change
1195+ 789E
1196+ 789E                  ; Calcola Row e Col: Offset = DE - 24064
1197+ 789E 21 00 A2         ld   hl, -24064
1198+ 78A1 19               add  hl, de            ; HL = Offset
1199+ 78A2 54               ld   d, h
1200+ 78A3 5D               ld   e, l
1201+ 78A4
1202+ 78A4 7B               ld   a, e
1203+ 78A5 E6 1F            and  31
1204+ 78A7 32 98 AD         ld   (ramp_col), a     ; Col Start
1205+ 78AA
1206+ 78AA CB 3C            srl  h
1206+ 78AC CB 1D          rr l
1207+ 78AE CB 3C            srl  h
1207+ 78B0 CB 1D          rr l
1208+ 78B2 CB 3C            srl  h
1208+ 78B4 CB 1D          rr l
1209+ 78B6 CB 3C            srl  h
1209+ 78B8 CB 1D          rr l
1210+ 78BA CB 3C            srl  h
1210+ 78BC CB 1D          rr l
1211+ 78BE 7D               ld   a, l
1212+ 78BF 32 97 AD         ld   (ramp_row), a     ; Row Start
1213+ 78C2
1214+ 78C2 C1               pop  bc                ; BC ha C = PlayerX, B = PlayerY
1215+ 78C3 C5               push bc
1216+ 78C4
1217+ 78C4                  ; Calcola ramp_Y per PlayerX (in C) nella nuova stanza
1218+ 78C4 CD 9F 79         call GetRampY          ; Output: Carry SET se X è nel range rampa, A = ramp_Y
1219+ 78C7 38 6C            jr   c, .on_ramp_x_ok
1220+ 78C9
1221+ 78C9                  ; PlayerX (in C) è fuori dal range orizzontale della rampa.
1222+ 78C9                  ; Verifichiamo se C è vicino all'estremità della rampa (tolleranza 16 pixel).
1223+ 78C9 3A 95 AD         ld   a, (ramp_dir)
1224+ 78CC B7               or   a
1225+ 78CD 28 2C            jr   z, .prox_dir_left

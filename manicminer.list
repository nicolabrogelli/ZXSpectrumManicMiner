 138+ 7DCC              .done_h_guardians:
 139+ 7DCC                  ; 3. Carica guardiani verticali (se presenti a OFFSET_V_GUARDIANS)
 140+ 7DCC 2A 89 99         ld   hl, (room_ptr)
 141+ 7DCF 11 DD 02         ld   de, OFFSET_V_GUARDIANS
 142+ 7DD2 19               add  hl, de
 143+ 7DD3 7E               ld   a, (hl)
 144+ 7DD4 FE FF            cp   $FF
 145+ 7DD6 28 0A            jr   z, .done_v_guardians
 146+ 7DD8 B7               or   a
 147+ 7DD9 28 07            jr   z, .done_v_guardians
 148+ 7DDB
 149+ 7DDB                  ; Slot attivo per guardiano verticale
 150+ 7DDB DD 36 00 C0      ld   (ix+0), $C0               ; Active = 1, Vertical = 1
 151+ 7DDF DD 77 0A         ld   (ix+10), a                ; Color
 152+ 7DE2                  ; (Imposta coordinate verticali se presenti in livelli futuri)
 153+ 7DE2
 154+ 7DE2              .done_v_guardians:
 155+ 7DE2 DD E1            pop  ix
 156+ 7DE4 C1               pop  bc
 157+ 7DE5 D1               pop  de
 158+ 7DE6 E1               pop  hl
 159+ 7DE7 C9               ret

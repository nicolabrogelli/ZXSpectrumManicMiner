 597  86A3 01 FE BF         ld   bc, $bffe
 598  86A6 ED 78            in   a, (c)
 599  86A8 CB 47            bit  0, a
 600  86AA 28 02            jr   z, .quit_chosen
 601  86AC
 602  86AC 18 C9            jr   .wait_choice_loop
 603  86AE
 604  86AE              .quit_chosen:
 605  86AE                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 606  86AE              .wait_quit_release:
 607  86AE 76               halt
 608  86AF 01 FE 7F         ld   bc, $7ffe
 609  86B2 ED 78            in   a, (c)
 610  86B4 CB 5F            bit  3, a
 611  86B6 28 F6            jr   z, .wait_quit_release
 612  86B8 01 FE BF         ld   bc, $bffe
 613  86BB ED 78            in   a, (c)
 614  86BD CB 47            bit  0, a

 356  8A9C              ; -------------------------------------------------------------------
 357  8A9C              ; TriggerGameOver
 358  8A9C              ; Scatena la sequenza originale di Game Over:
 359  8A9C              ; - Verifica e aggiorna l'High Score se il punteggio corrente e superiore.
 360  8A9C              ; - Esegue l'animazione originale del Piede che schiaccia Willy sul Piedistallo
 361  8A9C              ;   con suono beeper originale e lampeggio dello schermo.
 362  8A9C              ; - Mostra "Game" e "Over" con effetto arcobaleno (glistening).
 363  8A9C              ; - Ritorna alla schermata iniziale del titolo (Title Screen).
 364  8A9C              ; -------------------------------------------------------------------
 365  8A9C              TriggerGameOver:
 366  8A9C                  ; 1. Verifica ed aggiorna eventuale nuovo High Score
 367  8A9C CD 03 88         call Score_CheckAndUpdateHighScore
 368  8A9F
 369  8A9F                  ; 2. Esegue la sequenza grafica e sonora originale di Game Over
 370  8A9F CD 12 66         call Gfx_DrawGameOverScreen
 371  8AA2
 372  8AA2                  ; 3. Ritorna al Title Screen originale
 373  8AA2 C3 58 8A         jp   ShowTitleScreen
 374  8AA5
 375  8AA5              ; -------------------------------------------------------------------
 376  8AA5              ; TriggerVictory
 377  8AA5              ; Scatena la schermata di vittoria (Victory Screen) per la partita completata.
 378  8AA5              ; - Pulisce gli elementi di gioco della stanza.
 379  8AA5              ; - Esegue l'animazione di Maria (VecchiaSprite) che cammina verso Willy.
 380  8AA5              ; - Fa comparire le scritte "YOU HAVE WON!" e "CONGRATULATIONS!" ed anima i colori.
 381  8AA5              ; - Fa comparire la domanda "PLAY AGAIN? Y/N" a riga 8.
 382  8AA5              ; - Mantiene visibile il Nome della Stanza (Master Bedroom) e la Riga di Stato.
 383  8AA5              ; - Se il giocatore preme 'Y': resetta completamente la partita e avvia una nuova partita.
 384  8AA5              ; - Se il giocatore preme 'N' (o ENTER): ritorna alla schermata iniziale (Title Screen).
 385  8AA5              ; -------------------------------------------------------------------
 386  8AA5              TriggerVictory:
 387  8AA5                  ; 1. Disegna la schermata di vittoria ed esegue l'animazione di Maria, CONGRATULATIONS e prompt
 388  8AA5 CD FD 66         call Gfx_DrawVictoryScreen
 389  8AA8
 390  8AA8                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 391  8AA8              .wait_keys_release:
 392  8AA8 76               halt
 393  8AA9                  ; Controlla tasto Y (Porta $DF, bit 4)
 394  8AA9 01 FE DF         ld   bc, $dffe
 395  8AAC ED 78            in   a, (c)
 396  8AAE CB 67            bit  4, a
 397  8AB0 28 F6            jr   z, .wait_keys_release
 398  8AB2
 399  8AB2                  ; Controlla tasto N (Porta $7F, bit 3)
 400  8AB2 01 FE 7F         ld   bc, $7ffe
 401  8AB5 ED 78            in   a, (c)
 402  8AB7 CB 5F            bit  3, a
 403  8AB9 28 ED            jr   z, .wait_keys_release
 404  8ABB
 405  8ABB                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 406  8ABB 01 FE BF         ld   bc, $bffe
 407  8ABE ED 78            in   a, (c)
 408  8AC0 CB 47            bit  0, a
 409  8AC2 28 E4            jr   z, .wait_keys_release
 410  8AC4
 411  8AC4                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su CONGRATULATIONS!
 412  8AC4 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 413  8AC6              .wait_choice_loop:
 414  8AC6 76               halt
 415  8AC7
 416  8AC7                  ; Animazione ciclo colore per CONGRATULATIONS! (Riga 5, Colonna 8..23, $58A8)
 417  8AC7 0C               inc  c
 418  8AC8 79               ld   a, c
 419  8AC9 CB 3F            srl  a
 420  8ACB CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 421  8ACD E6 07            and  7
 422  8ACF 5F               ld   e, a
 423  8AD0 16 00            ld   d, 0
 424  8AD2 21 F4 65         ld   hl, victory_color_table
 425  8AD5 19               add  hl, de
 426  8AD6 7E               ld   a, (hl)               ; A = nuovo colore attributo
 427  8AD7 21 A8 58         ld   hl, $58a8             ; Indirizzo attributi riga 5, col 8 ($5800 + 5*32 + 8 = $58A8)
 428  8ADA 06 10            ld   b, 16                 ; 16 caratteri "CONGRATULATIONS!"
 429  8ADC              .color_cycle_loop:
 430  8ADC 77               ld   (hl), a
 431  8ADD 23               inc  hl
 432  8ADE 10 FC            djnz .color_cycle_loop
 433  8AE0
 434  8AE0                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 435  8AE0 01 FE DF         ld   bc, $dffe
 436  8AE3 ED 78            in   a, (c)
 437  8AE5 CB 67            bit  4, a
 438  8AE7 28 2A            jr   z, .play_again_chosen
 439  8AE9
 440  8AE9                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 441  8AE9 01 FE 7F         ld   bc, $7ffe
 442  8AEC ED 78            in   a, (c)
 443  8AEE CB 5F            bit  3, a
 444  8AF0 28 0B            jr   z, .quit_chosen
 445  8AF2
 446  8AF2                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 447  8AF2 01 FE BF         ld   bc, $bffe
 448  8AF5 ED 78            in   a, (c)
 449  8AF7 CB 47            bit  0, a
 450  8AF9 28 02            jr   z, .quit_chosen
 451  8AFB
 452  8AFB 18 C9            jr   .wait_choice_loop
 453  8AFD
 454  8AFD              .quit_chosen:
 455  8AFD                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 456  8AFD              .wait_quit_release:
 457  8AFD 76               halt
 458  8AFE 01 FE 7F         ld   bc, $7ffe
 459  8B01 ED 78            in   a, (c)
 460  8B03 CB 5F            bit  3, a
 461  8B05 28 F6            jr   z, .wait_quit_release
 462  8B07 01 FE BF         ld   bc, $bffe
 463  8B0A ED 78            in   a, (c)
 464  8B0C CB 47            bit  0, a
 465  8B0E 28 ED            jr   z, .wait_quit_release
 466  8B10
 467  8B10                  ; 5a. Esegue il normale flusso di uscita (ritorno a Title Screen)
 468  8B10 C3 58 8A         jp   ShowTitleScreen
 469  8B13
 470  8B13              .play_again_chosen:
 471  8B13                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 472  8B13              .wait_play_again_release:
 473  8B13 76               halt
 474  8B14 01 FE DF         ld   bc, $dffe
 475  8B17 ED 78            in   a, (c)
 476  8B19 CB 67            bit  4, a
 477  8B1B 28 F6            jr   z, .wait_play_again_release
 478  8B1D
 479  8B1D                  ; 5b. Reset completo dello stato di gioco e avvio di una nuova partita
 480  8B1D CD 57 8C         call ResetFullGameState
 481  8B20 C3 19 89         jp   LoadRoomAndRestart
 482  8B23
 483  8B23              ; -------------------------------------------------------------------
 484  8B23              ; CheckPortalTransition
 485  8B23              ; Verifica le condizioni per accedere alla stanza successiva:
 486  8B23              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 487  8B23              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 488  8B23              ;
 489  8B23              ; Output:
 490  8B23              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 491  8B23              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 492  8B23              ; -------------------------------------------------------------------
 493  8B23              CheckPortalTransition:
 494  8B23 C5               push bc
 495  8B24 D5               push de
 496  8B25 E5               push hl
 497  8B26
 498  8B26                  ; 1. Tutti gli item della stanza sono stati raccolti?
 499  8B26 CD EA 8B         call CheckAllItemsCollected
 500  8B29 30 4D            jr   nc, .no_transition
 501  8B2B
 502  8B2B                  ; 2. Willy collide con il portale (16x16 pixel)?
 503  8B2B                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 504  8B2B                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 505  8B2B 2A 72 EE         ld   hl, (room_ptr)
 506  8B2E 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 507  8B31 19               add  hl, de
 508  8B32 4E               ld   c, (hl)
 509  8B33 23               inc  hl
 510  8B34 46               ld   b, (hl)                   ; BC = AttrAddr
 511  8B35
 512  8B35                  ; Offset = BC - 23552
 513  8B35 60               ld   h, b
 514  8B36 69               ld   l, c
 515  8B37 01 00 A4         ld   bc, -23552
 516  8B3A 09               add  hl, bc
 517  8B3B
 518  8B3B                  ; PortalX = (Offset & 31) * 8
 519  8B3B 7D               ld   a, l
 520  8B3C E6 1F            and  31
 521  8B3E 87               add  a, a
 521  8B3F 87             add a, a
 521  8B40 87             add a, a
 522  8B41 5F               ld   e, a                      ; E = PortalX (0..248)
 523  8B42
 524  8B42                  ; PortalY = (Offset / 32) * 8
 525  8B42 CB 3C            srl  h
 525  8B44 CB 1D          rr l
 526  8B46 CB 3C            srl  h
 526  8B48 CB 1D          rr l
 527  8B4A CB 3C            srl  h
 527  8B4C CB 1D          rr l
 528  8B4E CB 3C            srl  h
 528  8B50 CB 1D          rr l
 529  8B52 CB 3C            srl  h
 529  8B54 CB 1D          rr l
 530  8B56 7D               ld   a, l
 531  8B57 87               add  a, a
 531  8B58 87             add a, a
 531  8B59 87             add a, a
 532  8B5A 57               ld   d, a                      ; D = PortalY (0..120)
 533  8B5B
 534  8B5B                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 535  8B5B ED 4B F1 EA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 536  8B5F
 537  8B5F                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 538  8B5F 7B               ld   a, e
 539  8B60 91               sub  c
 540  8B61 30 02            jr   nc, .x_diff_pos
 541  8B63 ED 44            neg
 542  8B65              .x_diff_pos:
 543  8B65 FE 0C            cp   12
 544  8B67 30 0F            jr   nc, .no_transition
 545  8B69
 546  8B69                  ; Controllo verticale: |WillyY - PortalY| < 14
 547  8B69 7A               ld   a, d
 548  8B6A 90               sub  b
 549  8B6B 30 02            jr   nc, .y_diff_pos
 550  8B6D ED 44            neg
 551  8B6F              .y_diff_pos:
 552  8B6F FE 0E            cp   14

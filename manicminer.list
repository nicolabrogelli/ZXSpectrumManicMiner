2468+ 6AA3 06 A8            ld   b, 168            ; B = Y pixel (Row 21 / head)
2469+ 6AA5 CD 9C 68         call Gfx_ClearPixelSprite8x8
2470+ 6AA8 06 B0            ld   b, 176            ; B = Y pixel (Row 22 / body)
2471+ 6AAA CD 9C 68         call Gfx_ClearPixelSprite8x8
2472+ 6AAD D1               pop  de

 479  86AC 2A 61 AB         ld   hl, (counter)
 480  86AF 22 64 AB         ld   (last_frame_counter), hl
 481  86B2
 482  86B2                  ; - Reimposta la fisica e le variabili di stato di Willy
 483  86B2 AF               xor  a

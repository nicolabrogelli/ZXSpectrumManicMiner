 414+ 82C9              ; CheckWillyItemCollision
 415+ 82C9              ;
 416+ 82C9              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 82C9              ; Input:
 418+ 82C9              ;   A = Item Col (0..31)
 419+ 82C9              ;   H = Item Row (0..15)
 420+ 82C9              ; Output:
 421+ 82C9              ;   Carry Set = Collisione
 422+ 82C9              ;   Carry Clear = Nessuna collisione
 423+ 82C9              ; -------------------------------------------------------------------
 424+ 82C9              CheckWillyItemCollision:
 425+ 82C9 C5               push bc
 426+ 82CA D5               push de
 427+ 82CB E5               push hl
 428+ 82CC
 429+ 82CC                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7

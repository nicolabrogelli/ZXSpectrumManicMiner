 414+ 8782              ; CheckWillyItemCollision
 415+ 8782              ;
 416+ 8782              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 8782              ; Input:
 418+ 8782              ;   A = Item Col (0..31)
 419+ 8782              ;   H = Item Row (0..15)
 420+ 8782              ; Output:
 421+ 8782              ;   Carry Set = Collisione
 422+ 8782              ;   Carry Clear = Nessuna collisione
 423+ 8782              ; -------------------------------------------------------------------
 424+ 8782              CheckWillyItemCollision:
 425+ 8782 C5               push bc
 426+ 8783 D5               push de
 427+ 8784 E5               push hl
 428+ 8785
 429+ 8785                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8785 6F               ld   l, a
 431+ 8786 87               add  a, a                      ; *2
 432+ 8787 87               add  a, a                      ; *4
 433+ 8788 87               add  a, a                      ; *8
 434+ 8789 5F               ld   e, a                      ; E = ItemLeft
 435+ 878A C6 07            add  a, 7
 436+ 878C 57               ld   d, a                      ; D = ItemRight
 437+ 878D
 438+ 878D ED 4B A3 EB      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 8791
 440+ 8791                  ; WillyLeft <= ItemRight
 441+ 8791 79               ld   a, c                      ; A = WillyX
 442+ 8792 BA               cp   d                         ; D = ItemRight
 443+ 8793 28 04            jr   z, .x_ok
 444+ 8795 38 02            jr   c, .x_ok
 445+ 8797 18 31            jr   .no_collision
 446+ 8799
 447+ 8799              .x_ok:
 448+ 8799                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 8799 BB               cp   e                         ; E = ItemLeft
 450+ 879A 28 0B            jr   z, .y_check
 451+ 879C 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 879E
 453+ 879E                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 879E C6 07            add  a, 7
 455+ 87A0 BB               cp   e
 456+ 87A1 28 04            jr   z, .y_check
 457+ 87A3 30 02            jr   nc, .y_check
 458+ 87A5 18 23            jr   .no_collision

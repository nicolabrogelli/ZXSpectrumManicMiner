 631+ 870E              ; Score_Add1Point
 632+ 870E              ; Aggiunge 1 punto allo Score del giocatore (usato nel countdown dell'aria a fine livello).
 633+ 870E              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 634+ 870E              ; -------------------------------------------------------------------
 635+ 870E              Score_Add1Point:
 636+ 870E F5               push af
 637+ 870F C5               push bc
 638+ 8710 D5               push de
 639+ 8711 E5               push hl
 640+ 8712
 641+ 8712                  ; Aggiungi 1 punto (byte 0 in BCD rappresenta unità e decine)
 642+ 8712 3A 5A F0         ld   a, (player_score + 0)
 643+ 8715 C6 01            add  a, $01
 644+ 8717 27               daa
 645+ 8718 32 5A F0         ld   (player_score + 0), a
 646+ 871B
 647+ 871B                  ; Riporto al byte 1 (centinaia / migliaia)
 648+ 871B 3A 5B F0         ld   a, (player_score + 1)
 649+ 871E CE 00            adc  a, 0
 650+ 8720 27               daa
 651+ 8721 32 5B F0         ld   (player_score + 1), a
 652+ 8724
 653+ 8724                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 8724 3A 5C F0         ld   a, (player_score + 2)
 655+ 8727 CE 00            adc  a, 0
 656+ 8729 27               daa
 657+ 872A 32 5C F0         ld   (player_score + 2), a
 658+ 872D
 659+ 872D                  ; Controlla se player_score ha superato high_score
 660+ 872D CD 59 87         call Score_CheckAndUpdateHighScore

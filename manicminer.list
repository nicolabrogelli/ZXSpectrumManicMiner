 362+ 7EFE              ; CheckWillyItemCollision
 363+ 7EFE              ;
 364+ 7EFE              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 365+ 7EFE              ; Input:
 366+ 7EFE              ;   A = Item Col (0..31)
 367+ 7EFE              ;   H = Item Row (0..15)
 368+ 7EFE              ; Output:
 369+ 7EFE              ;   Carry Set = Collisione
 370+ 7EFE              ;   Carry Clear = Nessuna collisione
 371+ 7EFE              ; -------------------------------------------------------------------
 372+ 7EFE              CheckWillyItemCollision:
 373+ 7EFE C5               push bc
 374+ 7EFF D5               push de
 375+ 7F00 E5               push hl
 376+ 7F01
 377+ 7F01                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 378+ 7F01 6F               ld   l, a
 379+ 7F02 87               add  a, a                      ; *2
 380+ 7F03 87               add  a, a                      ; *4
 381+ 7F04 87               add  a, a                      ; *8
 382+ 7F05 5F               ld   e, a                      ; E = ItemLeft
 383+ 7F06 C6 07            add  a, 7
 384+ 7F08 57               ld   d, a                      ; D = ItemRight
 385+ 7F09
 386+ 7F09 ED 4B 71 8F      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 387+ 7F0D
 388+ 7F0D                  ; WillyLeft <= ItemRight
 389+ 7F0D 79               ld   a, c
 390+ 7F0E BA               cp   d
 391+ 7F0F 28 04            jr   z, .x_ok
 392+ 7F11 38 02            jr   c, .x_ok
 393+ 7F13 18 29            jr   .no_collision
 394+ 7F15
 395+ 7F15              .x_ok:
 396+ 7F15                  ; WillyRight >= ItemLeft (WillyRight = WillyX + 7 o 15)
 397+ 7F15 C6 07            add  a, 7
 398+ 7F17 BB               cp   e
 399+ 7F18 28 04            jr   z, .y_check
 400+ 7F1A 30 02            jr   nc, .y_check
 401+ 7F1C 18 20            jr   .no_collision
 402+ 7F1E
 403+ 7F1E              .y_check:
 404+ 7F1E E1               pop  hl
 405+ 7F1F E5               push hl
 406+ 7F20
 407+ 7F20                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 408+ 7F20 7C               ld   a, h
 409+ 7F21 87               add  a, a                      ; *2
 410+ 7F22 87               add  a, a                      ; *4
 411+ 7F23 87               add  a, a                      ; *8
 412+ 7F24 5F               ld   e, a                      ; ItemTop
 413+ 7F25 C6 07            add  a, 7
 414+ 7F27 57               ld   d, a                      ; ItemBottom
 415+ 7F28
 416+ 7F28                  ; WillyTop <= ItemBottom
 417+ 7F28 78               ld   a, b
 418+ 7F29 BA               cp   d
 419+ 7F2A 28 04            jr   z, .y_ok
 420+ 7F2C 38 02            jr   c, .y_ok
 421+ 7F2E 18 0E            jr   .no_collision
 422+ 7F30
 423+ 7F30              .y_ok:
 424+ 7F30                  ; WillyBottom >= ItemTop (WillyBottom = WillyY + 15)
 425+ 7F30 C6 0F            add  a, 15
 426+ 7F32 BB               cp   e
 427+ 7F33 28 04            jr   z, .collision
 428+ 7F35 30 02            jr   nc, .collision
 429+ 7F37 18 05            jr   .no_collision

 988+ 7805              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 989+ 7805              ; Input: C = X, B = Y
 990+ 7805              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 991+ 7805              ; -------------------------------------------------------------------
 992+ 7805              CheckWallCell:
 993+ 7805 E5               push hl
 994+ 7806 D5               push de
 995+ 7807 C5               push bc
 996+ 7808
 997+ 7808                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 998+ 7808 78               ld   a, b
 999+ 7809 FE 80            cp   128
1000+ 780B 30 1F            jr   nc, .not_wall
1001+ 780D
1002+ 780D                  ; 2. Calcola riga di layout: r = Y / 8
1003+ 780D CB 3F            srl  a
1004+ 780F CB 3F            srl  a
1005+ 7811 CB 3F            srl  a                 ; A = r (0..15)
1006+ 7813
1007+ 7813                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1008+ 7813 5F               ld   e, a              ; E = r (Row)
1009+ 7814 79               ld   a, c
1010+ 7815 CB 3F            srl  a
1011+ 7817 CB 3F            srl  a
1012+ 7819 CB 3F            srl  a                 ; A = c (0..31)
1013+ 781B 4F               ld   c, a              ; C = c (Col)
1014+ 781C
1015+ 781C                  ; Se la cella è sulla rampa, non considerarla un muro!
1016+ 781C 53               ld   d, e              ; D = Row
1017+ 781D 59               ld   e, c              ; E = Col
1018+ 781E CD 8A 77         call IsCellOnRamp
1019+ 7821 38 09            jr   c, .not_wall
1020+ 7823
1021+ 7823 7A               ld   a, d              ; A = Row
1022+ 7824 4B               ld   c, e              ; C = Col
1023+ 7825 CD C1 78         call GetCellFromUnpacked ; A = cell type
1024+ 7828
1025+ 7828                  ; Controlla se è Wall (3)
1026+ 7828 FE 03            cp   3
1027+ 782A 28 05            jr   z, .is_wall
1028+ 782C

 106+ 7C9E              ; Items_DrawRoom
 107+ 7C9E              ;
 108+ 7C9E              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 109+ 7C9E              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 110+ 7C9E              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 111+ 7C9E              ;
 112+ 7C9E              ; Record item nella stanza (5 byte):
 113+ 7C9E              ;   +0 Color / Attributo
 114+ 7C9E              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 115+ 7C9E              ;   +2 Attr Address High
 116+ 7C9E              ;   +3 Anim Mask (96)
 117+ 7C9E              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 118+ 7C9E              ; Fine lista: $FF
 119+ 7C9E              ; -------------------------------------------------------------------
 120+ 7C9E              Items_DrawRoom:
 121+ 7C9E E5               push hl
 122+ 7C9F D5               push de
 123+ 7CA0 C5               push bc
 124+ 7CA1 DD E5            push ix
 125+ 7CA3 FD E5            push iy
 126+ 7CA5
 127+ 7CA5                  ; 1. Azzera items_grid (512 byte)
 128+ 7CA5 21 A7 8B         ld   hl, items_grid
 129+ 7CA8 11 A8 8B         ld   de, items_grid + 1
 130+ 7CAB 36 00            ld   (hl), 0
 131+ 7CAD 01 FF 01         ld   bc, 511
 132+ 7CB0 ED B0            ldir
 133+ 7CB2
 134+ 7CB2                  ; 2. Nessun item attivo inizialmente nella cache
 135+ 7CB2 AF               xor  a
 136+ 7CB3 32 26 91         ld   (num_room_items), a
 137+ 7CB6
 138+ 7CB6 FD 21 D6 90      ld   iy, current_room_items
 139+ 7CBA
 140+ 7CBA                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 141+ 7CBA 2A 27 91         ld   hl, (room_ptr)
 142+ 7CBD 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 143+ 7CC0 19               add  hl, de
 144+ 7CC1 E5               push hl
 145+ 7CC2 DD E1            pop  ix                        ; IX = bitmap item
 146+ 7CC4
 147+ 7CC4                  ; 4. HL = Inizio lista item nella stanza
 148+ 7CC4 2A 27 91         ld   hl, (room_ptr)
 149+ 7CC7 11 75 02         ld   de, OFFSET_ITEMS
 150+ 7CCA 19               add  hl, de
 151+ 7CCB
 152+ 7CCB              .loop:
 153+ 7CCB 7E               ld   a, (hl)                   ; Byte 0: Color
 154+ 7CCC FE FF            cp   $FF
 155+ 7CCE 28 65            jr   z, .done                  ; $FF = fine lista item
 156+ 7CD0
 157+ 7CD0 5F               ld   e, a                      ; E = Color
 158+ 7CD1 23               inc  hl
 159+ 7CD2 4E               ld   c, (hl)                   ; C = AttrAddr Low
 160+ 7CD3 23               inc  hl
 161+ 7CD4 46               ld   b, (hl)                   ; B = AttrAddr High
 162+ 7CD5 23               inc  hl                        ; Salta Anim Byte
 163+ 7CD6 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 164+ 7CD7
 165+ 7CD7 7E               ld   a, (hl)                   ; A = Collected flag
 166+ 7CD8 FE FF            cp   $FF
 167+ 7CDA 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 168+ 7CDC
 169+ 7CDC                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 170+ 7CDC E5               push hl
 171+ 7CDD 60               ld   h, b
 172+ 7CDE 69               ld   l, c
 173+ 7CDF 01 00 A4         ld   bc, -23552
 174+ 7CE2 09               add  hl, bc                    ; HL = AttrOffset
 175+ 7CE3
 176+ 7CE3                  ; Col = Offset & 31
 177+ 7CE3 7D               ld   a, l
 178+ 7CE4 E6 1F            and  31
 179+ 7CE6 4F               ld   c, a                      ; C = Col (0..31)
 180+ 7CE7
 181+ 7CE7                  ; Row = Offset / 32
 182+ 7CE7 CB 3C            srl  h
 182+ 7CE9 CB 1D          rr l
 183+ 7CEB CB 3C            srl  h
 183+ 7CED CB 1D          rr l
 184+ 7CEF CB 3C            srl  h
 184+ 7CF1 CB 1D          rr l
 185+ 7CF3 CB 3C            srl  h
 185+ 7CF5 CB 1D          rr l
 186+ 7CF7 CB 3C            srl  h
 186+ 7CF9 CB 1D          rr l
 187+ 7CFB 7D               ld   a, l
 188+ 7CFC 47               ld   b, a                      ; B = Row (0..15)
 189+ 7CFD
 190+ 7CFD                  ; Disegna l'item sullo schermo
 191+ 7CFD DD E5            push ix
 192+ 7CFF E1               pop  hl                        ; HL = puntatore bitmap
 193+ 7D00 CD 3D 7D         call DrawItemGraphic
 194+ 7D03
 195+ 7D03                  ; Aggiorna items_grid: offset = Row * 32 + Col
 196+ 7D03 D5               push de
 197+ 7D04 26 00            ld   h, 0
 198+ 7D06 68               ld   l, b                      ; HL = Row
 199+ 7D07 29               add  hl, hl
 200+ 7D08 29               add  hl, hl
 201+ 7D09 29               add  hl, hl
 202+ 7D0A 29               add  hl, hl
 203+ 7D0B 29               add  hl, hl                    ; Row * 32
 204+ 7D0C 59               ld   e, c
 205+ 7D0D 16 00            ld   d, 0
 206+ 7D0F 19               add  hl, de                    ; Row * 32 + Col
 207+ 7D10 11 A7 8B         ld   de, items_grid
 208+ 7D13 19               add  hl, de
 209+ 7D14 D1               pop  de                        ; E = Color
 210+ 7D15 73               ld   (hl), e                   ; Salva colore nella griglia
 211+ 7D16
 212+ 7D16 E1               pop  hl                        ; HL = puntatore al flag Collected nei dati stanza
 213+ 7D17
 214+ 7D17                  ; Salva l'item nella cache current_room_items (5 byte: Col, Row, Color, FlagPtrLow, FlagPtrHigh)
 215+ 7D17 FD 71 00         ld   (iy+0), c                 ; Colonna
 216+ 7D1A FD 70 01         ld   (iy+1), b                 ; Riga
 217+ 7D1D FD 73 02         ld   (iy+2), e                 ; Colore
 218+ 7D20 FD 75 03         ld   (iy+3), l                 ; Flag Ptr Low
 219+ 7D23 FD 74 04         ld   (iy+4), h                 ; Flag Ptr High
 220+ 7D26
 221+ 7D26 01 05 00         ld   bc, 5
 222+ 7D29 FD 09            add  iy, bc
 223+ 7D2B
 224+ 7D2B 3A 26 91         ld   a, (num_room_items)
 225+ 7D2E 3C               inc  a
 226+ 7D2F 32 26 91         ld   (num_room_items), a

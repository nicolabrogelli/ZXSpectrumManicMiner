 123+ 6F5A 3E 01            ld   a, 1
 124+ 6F5C 32 1C EE         ld   (conveyor_caught), a
 125+ 6F5F
 126+ 6F5F                  ; Muovi a Sinistra (trascinamento del nastro)
 127+ 6F5F 3E 01            ld   a, 1
 128+ 6F61 32 F8 EA         ld   (direction), a
 129+ 6F64 C3 B8 6F         jp   movePlayer_left

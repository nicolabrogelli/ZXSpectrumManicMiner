 637  84C8              ; -------------------------------------------------------------------
 638  84C8              ; CheckPortalTransition
 639  84C8              ; Verifica le condizioni per accedere alla stanza successiva:
 640  84C8              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 641  84C8              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 642  84C8              ;
 643  84C8              ; Output:
 644  84C8              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 645  84C8              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 646  84C8              ; -------------------------------------------------------------------
 647  84C8              CheckPortalTransition:
 648  84C8 C5               push bc
 649  84C9 D5               push de
 650  84CA E5               push hl
 651  84CB
 652  84CB                  ; 1. Tutti gli item della stanza sono stati raccolti?
 653  84CB CD 59 85         call CheckAllItemsCollected
 654  84CE 30 4D            jr   nc, .no_transition
 655  84D0
 656  84D0                  ; 2. Willy collide con il portale (16x16 pixel)?
 657  84D0                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 658  84D0                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 659  84D0 2A EB 97         ld   hl, (room_ptr)
 660  84D3 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 661  84D6 19               add  hl, de
 662  84D7 4E               ld   c, (hl)
 663  84D8 23               inc  hl
 664  84D9 46               ld   b, (hl)                   ; BC = AttrAddr
 665  84DA
 666  84DA                  ; Offset = BC - 23552
 667  84DA 60               ld   h, b
 668  84DB 69               ld   l, c
 669  84DC 01 00 A4         ld   bc, -23552
 670  84DF 09               add  hl, bc
 671  84E0
 672  84E0                  ; PortalX = (Offset & 31) * 8
 673  84E0 7D               ld   a, l
 674  84E1 E6 1F            and  31
 675  84E3 87               add  a, a
 675  84E4 87             add a, a
 675  84E5 87             add a, a
 676  84E6 5F               ld   e, a                      ; E = PortalX (0..248)
 677  84E7
 678  84E7                  ; PortalY = (Offset / 32) * 8
 679  84E7 CB 3C            srl  h
 679  84E9 CB 1D          rr l
 680  84EB CB 3C            srl  h
 680  84ED CB 1D          rr l
 681  84EF CB 3C            srl  h
 681  84F1 CB 1D          rr l
 682  84F3 CB 3C            srl  h
 682  84F5 CB 1D          rr l
 683  84F7 CB 3C            srl  h
 683  84F9 CB 1D          rr l
 684  84FB 7D               ld   a, l
 685  84FC 87               add  a, a
 685  84FD 87             add a, a
 685  84FE 87             add a, a
 686  84FF 57               ld   d, a                      ; D = PortalY (0..120)
 687  8500
 688  8500                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 689  8500 ED 4B 6B 94      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 690  8504
 691  8504                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 692  8504 7B               ld   a, e
 693  8505 91               sub  c
 694  8506 30 02            jr   nc, .x_diff_pos
 695  8508 ED 44            neg
 696  850A              .x_diff_pos:
 697  850A FE 0C            cp   12
 698  850C 30 0F            jr   nc, .no_transition
 699  850E
 700  850E                  ; Controllo verticale: |WillyY - PortalY| < 14
 701  850E 7A               ld   a, d
 702  850F 90               sub  b
 703  8510 30 02            jr   nc, .y_diff_pos
 704  8512 ED 44            neg
 705  8514              .y_diff_pos:
 706  8514 FE 0E            cp   14
 707  8516 30 05            jr   nc, .no_transition
 708  8518
 709  8518                  ; Transizione al portale attiva!
 710  8518 E1               pop  hl
 711  8519 D1               pop  de
 712  851A C1               pop  bc
 713  851B 37               scf
 714  851C C9               ret
 715  851D
 716  851D              .no_transition:
 717  851D E1               pop  hl
 718  851E D1               pop  de
 719  851F C1               pop  bc
 720  8520 B7               or   a
 721  8521 C9               ret
 722  8522
 723  8522              ; Alias per retrocompatibilità
 724  8522              CheckVictoryCondition: EQU CheckPortalTransition
 725  8522
 726  8522              ; -------------------------------------------------------------------
 727  8522              ; TriggerPortalTransition
 728  8522              ; Esegue il passaggio alla stanza successiva quando Willy entra nel portale:
 729  8522              ; - Identifica l'ID della stanza corrente in RoomsListTable.
 730  8522              ; - Avanza all'indice della stanza successiva.
 731  8522              ; - Se ci sono altre stanze: carica la nuova stanza leggendo le coordinate
 732  8522              ;   iniziali di Willy da OFFSET_POS_WILLY (byte 616) e avvia la stanza.
 733  8522              ; - Se era l'ultima stanza disponibile: scatena la vittoria (Victory Screen).
 734  8522              ; -------------------------------------------------------------------
 735  8522              TriggerPortalTransition:
 736  8522                  ; 1. Determina l'ID della stanza corrente
 737  8522 CD 8E 7E         call DetermineCurrentRoomID    ; (current_room) = ID stanza (0..NUM_ROOMS-1)
 738  8525
 739  8525                  ; 2. Calcola l'indice della stanza successiva
 740  8525 3A 91 97         ld   a, (current_room)
 741  8528 3C               inc  a
 742  8529 FE 02            cp   NUM_ROOMS

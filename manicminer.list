 298+ 8139              DrawItemGraphic:
 299+ 8139 C5               push bc
 300+ 813A D5               push de
 301+ 813B E5               push hl
 302+ 813C
 303+ 813C                  ; Calcolo indirizzo bitmap: High = $40 + (Row & $18), Low = ((Row & 7) * 32) + Col
 304+ 813C 78               ld   a, b
 305+ 813D E6 18            and  $18
 306+ 813F C6 40            add  a, $40
 307+ 8141 57               ld   d, a                      ; Byte alto indirizzo video
 308+ 8142
 309+ 8142 78               ld   a, b
 310+ 8143 E6 07            and  7
 311+ 8145 87               add  a, a                      ; *2
 312+ 8146 87               add  a, a                      ; *4
 313+ 8147 87               add  a, a                      ; *8
 314+ 8148 87               add  a, a                      ; *16
 315+ 8149 87               add  a, a                      ; *32
 316+ 814A 81               add  a, c                      ; + Col
 317+ 814B 5F               ld   e, a                      ; Byte basso indirizzo video
 318+ 814C
 319+ 814C C5               push bc
 320+ 814D 06 08            ld   b, 8                      ; 8 scanline
 321+ 814F              .line_loop:
 322+ 814F 7E               ld   a, (hl)
 323+ 8150 12               ld   (de), a

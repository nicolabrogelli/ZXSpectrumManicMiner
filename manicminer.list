 753+ 60F0 73               ld   (hl), e               ; Applica l'attributo del tile alla cella
 754+ 60F1 E1               pop  hl
 755+ 60F2 18 1A            jr   .next_col
 756+ 60F4
 757+ 60F4              .cell_is_empty:

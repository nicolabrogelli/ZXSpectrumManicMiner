 228  89E3 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce il display RAM e imposta gli attributi a nero
 229  89E6
 230  89E6                  ; 3. Pausa a schermo nero (~0.5 secondi per respawn normale)
 231  89E6 06 19            ld   b, 25
 232  89E8              .death_pause:
 233  89E8 76               halt
 234  89E9 10 FD            djnz .death_pause
 235  89EB
 236  89EB                  ; 4. Reimposta la fisica di Willy e imposta il timer di sicurezza al respawn
 237  89EB AF               xor  a
 238  89EC 32 EC EA         ld   (velocity_y), a
 239  89EF 32 EE EA         ld   (jump_pressed), a
 240  89F2 32 F0 EA         ld   (coyote_timer), a
 241  89F5 32 F3 EA         ld   (jump_frame), a
 242  89F8 32 F2 EA         ld   (jump_dir), a
 243  89FB 32 E4 EA         ld   (body_state), a
 244  89FE 32 E7 EE         ld   (player_old_body), a
 245  8A01 32 E6 EE         ld   (player_old_dir), a
 246  8A04 32 E9 EA         ld   (sprite_shift), a
 247  8A07 32 E7 EA         ld   (collision_active), a
 248  8A0A 32 EB EE         ld   (willy_needs_redraw), a
 249  8A0D 32 F4 EA         ld   (current_input_dir), a
 250  8A10 32 09 EE         ld   (conveyor_caught), a
 251  8A13 32 65 EE         ld   (transition_active), a    ; 0 = Posiziona Willy nel punto definito nella stanza (OFFSET_POS_WILLY)
 252  8A16 3E 01            ld   a, 1
 253  8A18 32 ED EA         ld   (on_ground), a
 254  8A1B
 255  8A1B 3E 00            ld   a, RESPAWN_SAFETY_TIME
 256  8A1D 32 EA EE         ld   (willy_safety_timer), a

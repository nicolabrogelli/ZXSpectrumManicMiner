 827  842C 87               add  a, a                  ; *2
 828  842D 87               add  a, a                  ; *4
 829  842E 87               add  a, a                  ; *8
 830  842F 5F               ld   e, a                  ; E = ConveyorLeft
 831  8430
 832  8430                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 833  8430 21 99 92         ld   hl, conveyor_len
 834  8433 3A 9B 92         ld   a, (conveyor_col)
 835  8436 86               add  a, (hl)
 836  8437 87               add  a, a                  ; *2
 837  8438 87               add  a, a                  ; *4
 838  8439 87               add  a, a                  ; *8
 839  843A 3D               dec  a                     ; ConveyorRight
 840  843B 57               ld   d, a                  ; D = ConveyorRight
 841  843C
 842  843C                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 843  843C 79               ld   a, c                  ; WillyLeft
 844  843D BA               cp   d
 845  843E 28 04            jr   z, .x_overlap
 846  8440 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 847  8442 18 0E            jr   .no_conv_collision
 848  8444
 849  8444              .x_overlap:

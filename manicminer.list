 207+ 8486                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 208+ 8486 E5               push hl
 209+ 8487 60               ld   h, b
 210+ 8488 69               ld   l, c
 211+ 8489 01 00 A4         ld   bc, -23552

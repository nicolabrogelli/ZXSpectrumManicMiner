 315  88A7 5F               ld   e, a
 316  88A8 16 00            ld   d, 0
 317  88AA 21 72 64         ld   hl, title_color_table
 318  88AD 19               add  hl, de
 319  88AE 7E               ld   a, (hl)               ; A = nuovo colore
 320  88AF 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 321  88B2 06 20            ld   b, 32

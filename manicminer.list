 634+ 8292
 635+ 8292                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8292 3A 19 9C         ld   a, (player_score + 1)
 637+ 8295 C6 01            add  a, $01
 638+ 8297 27               daa
 639+ 8298 32 19 9C         ld   (player_score + 1), a
 640+ 829B

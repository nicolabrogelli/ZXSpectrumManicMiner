 627+ 605F 3A 77 8F         ld   a, (body_state)
 628+ 6062 21 79 93         ld   hl, player_old_body
 629+ 6065 BE               cp   (hl)
 630+ 6066 20 08            jr   nz, .player_moved
 631+ 6068
 632+ 6068                  ; Willy non si è mosso. Ma se un nemico lo ha sovrascritto, ridisegnalo senza prima cancellarlo!
 633+ 6068 3A 7C 93         ld   a, (willy_needs_redraw)
 634+ 606B B7               or   a
 635+ 606C 20 22            jr   nz, .redraw_overlay_only
 636+ 606E 18 48            jr   .player_no_change

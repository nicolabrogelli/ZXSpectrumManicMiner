 310+ 7E51 79               ld   a, c
 311+ 7E52 E6 F8            and  $F8                ; A = EnemyX & $F8
 312+ 7E54 93               sub  e                  ; A = (EnemyX & $F8) - (WillyX & $F8)
 313+ 7E55 C6 10            add  a, 16
 314+ 7E57 FE 19            cp   25

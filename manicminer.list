 427  81E9 ED 78            in   a, (c)
 428  81EB CB 47            bit  0, a
 429  81ED 28 02            jr   z, .quit_chosen
 430  81EF
 431  81EF 18 C9            jr   .wait_choice_loop
 432  81F1
 433  81F1              .quit_chosen:
 434  81F1                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 435  81F1              .wait_quit_release:
 436  81F1 76               halt
 437  81F2 01 FE 7F         ld   bc, $7ffe
 438  81F5 ED 78            in   a, (c)
 439  81F7 CB 5F            bit  3, a
 440  81F9 28 F6            jr   z, .wait_quit_release
 441  81FB 01 FE BF         ld   bc, $bffe
 442  81FE ED 78            in   a, (c)
 443  8200 CB 47            bit  0, a
 444  8202 28 ED            jr   z, .wait_quit_release

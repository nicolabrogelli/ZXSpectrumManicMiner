 287  852A              ; -------------------------------------------------------------------
 288  852A              ; ShowTitleScreen
 289  852A              ; Visualizza la schermata iniziale del gioco (Title Screen).
 290  852A              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 291  852A              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 292  852A              ; -------------------------------------------------------------------
 293  852A              ShowTitleScreen:
 294  852A                  ; 1. Disegna la schermata iniziale
 295  852A CD 76 64         call Gfx_DrawTitleScreen
 296  852D
 297  852D                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 298  852D              .wait_title_enter_release:
 299  852D 76               halt
 300  852E 3E BF            ld   a, $bf
 301  8530 DB FE            in   a, ($fe)
 302  8532 1F               rra
 303  8533 30 F8            jr   nc, .wait_title_enter_release
 304  8535
 305  8535                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 306  8535 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 307  8537              .title_loop:
 308  8537 76               halt
 309  8538
 310  8538                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 311  8538 0C               inc  c
 312  8539 79               ld   a, c
 313  853A CB 3F            srl  a
 314  853C CB 3F            srl  a
 315  853E CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 316  8540 E6 07            and  7
 317  8542 5F               ld   e, a
 318  8543 16 00            ld   d, 0
 319  8545 21 6E 64         ld   hl, title_color_table
 320  8548 19               add  hl, de
 321  8549 7E               ld   a, (hl)               ; A = nuovo colore
 322  854A 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 323  854D 06 20            ld   b, 32
 324  854F              .color_title_loop:
 325  854F 77               ld   (hl), a
 326  8550 23               inc  hl
 327  8551 10 FC            djnz .color_title_loop
 328  8553
 329  8553                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 330  8553 3E BF            ld   a, $bf
 331  8555 DB FE            in   a, ($fe)
 332  8557 1F               rra
 333  8558 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 334  855A
 335  855A                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 336  855A              .wait_title_enter_release_after:
 337  855A 76               halt
 338  855B 3E BF            ld   a, $bf
 339  855D DB FE            in   a, ($fe)
 340  855F 1F               rra
 341  8560 30 F8            jr   nc, .wait_title_enter_release_after
 342  8562
 343  8562                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 344  8562 AF               xor  a
 345  8563 D3 FE            out  ($fe), a              ; Bordo a nero
 346  8565 CD 99 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 347  8568
 348  8568                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 349  8568 CD CF 87         call ResetFullGameState
 350  856B
 351  856B                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 352  856B C3 F1 83         jp   LoadRoomAndRestart
 353  856E
 354  856E              ; -------------------------------------------------------------------
 355  856E              ; TriggerGameOver
 356  856E              ; Scatena la schermata di Game Over per la stanza corrente.
 357  856E              ; - Pulisce gli elementi di gioco della stanza (piattaforme, nemici, Willy, item).
 358  856E              ; - Esegue l'animazione del Piede (discesa fluida ed atterraggio sotto BotteSprite).
 359  856E              ; - Fa comparire la scritta GAME OVER al centro dello schermo dopo la pausa ed anima i suoi colori.
 360  856E              ; - Fa comparire la domanda "VUOI CONTINUARE? Y/N" a riga 8.
 361  856E              ; - Mantiene visibile il Nome della Stanza corrente e la Riga di Stato (Item ed Orario).
 362  856E              ; - Se il giocatore preme 'Y': riprende la partita dal punto esatto in cui era arrivato,
 363  856E              ;   mantenendo lo stato della stanza e tutti gli oggetti (items) raccolti.
 364  856E              ; - Se il giocatore preme 'N' (o ENTER): esegue il normale flusso del Game Over (Title Screen).
 365  856E              ; -------------------------------------------------------------------
 366  856E              TriggerGameOver:
 367  856E                  ; 1. Disegna la schermata di Game Over ed esegue l'animazione del Piede, GAME OVER e prompt continua
 368  856E CD 15 66         call Gfx_DrawGameOverScreen
 369  8571
 370  8571                  ; 2. Attende il rilascio dei tasti Y, N ed ENTER se erano già premuti
 371  8571              .wait_keys_release:
 372  8571 76               halt
 373  8572                  ; Controlla tasto Y (Porta $DF, bit 4)
 374  8572 01 FE DF         ld   bc, $dffe
 375  8575 ED 78            in   a, (c)
 376  8577 CB 67            bit  4, a
 377  8579 28 F6            jr   z, .wait_keys_release
 378  857B
 379  857B                  ; Controlla tasto N (Porta $7F, bit 3)
 380  857B 01 FE 7F         ld   bc, $7ffe
 381  857E ED 78            in   a, (c)
 382  8580 CB 5F            bit  3, a
 383  8582 28 ED            jr   z, .wait_keys_release
 384  8584
 385  8584                  ; Controlla tasto ENTER (Porta $BF, bit 0)
 386  8584 01 FE BF         ld   bc, $bffe
 387  8587 ED 78            in   a, (c)
 388  8589 CB 47            bit  0, a
 389  858B 28 E4            jr   z, .wait_keys_release
 390  858D
 391  858D                  ; 3. Attesa della scelta del giocatore con animazione ciclo colore su GAME OVER
 392  858D 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 393  858F              .wait_choice_loop:
 394  858F 76               halt
 395  8590
 396  8590                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 397  8590 0C               inc  c
 398  8591 79               ld   a, c
 399  8592 CB 3F            srl  a
 400  8594 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 401  8596 E6 07            and  7
 402  8598 5F               ld   e, a
 403  8599 16 00            ld   d, 0
 404  859B 21 D1 65         ld   hl, game_over_color_table
 405  859E 19               add  hl, de
 406  859F 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  85A0 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  85A3 06 09            ld   b, 9
 409  85A5              .color_cycle_loop:
 410  85A5 77               ld   (hl), a
 411  85A6 23               inc  hl
 412  85A7 10 FC            djnz .color_cycle_loop
 413  85A9
 414  85A9                  ; Controlla se il tasto Y è premuto (Porta $DF, bit 4 = 0)
 415  85A9 01 FE DF         ld   bc, $dffe
 416  85AC ED 78            in   a, (c)
 417  85AE CB 67            bit  4, a
 418  85B0 28 2A            jr   z, .continue_chosen
 419  85B2
 420  85B2                  ; Controlla se il tasto N è premuto (Porta $7F, bit 3 = 0)
 421  85B2 01 FE 7F         ld   bc, $7ffe
 422  85B5 ED 78            in   a, (c)
 423  85B7 CB 5F            bit  3, a
 424  85B9 28 0B            jr   z, .quit_chosen
 425  85BB
 426  85BB                  ; Controlla se il tasto ENTER è premuto (Porta $BF, bit 0 = 0)
 427  85BB 01 FE BF         ld   bc, $bffe
 428  85BE ED 78            in   a, (c)
 429  85C0 CB 47            bit  0, a
 430  85C2 28 02            jr   z, .quit_chosen
 431  85C4
 432  85C4 18 C9            jr   .wait_choice_loop
 433  85C6
 434  85C6              .quit_chosen:
 435  85C6                  ; 4a. Attende il rilascio di N ed ENTER per evitare doppi scatti
 436  85C6              .wait_quit_release:
 437  85C6 76               halt
 438  85C7 01 FE 7F         ld   bc, $7ffe
 439  85CA ED 78            in   a, (c)
 440  85CC CB 5F            bit  3, a
 441  85CE 28 F6            jr   z, .wait_quit_release
 442  85D0 01 FE BF         ld   bc, $bffe
 443  85D3 ED 78            in   a, (c)
 444  85D5 CB 47            bit  0, a
 445  85D7 28 ED            jr   z, .wait_quit_release
 446  85D9
 447  85D9                  ; 5a. Esegue il normale flusso del Game Over (ritorno a Title Screen)
 448  85D9 C3 2A 85         jp   ShowTitleScreen
 449  85DC
 450  85DC              .continue_chosen:
 451  85DC                  ; 4b. Attende il rilascio del tasto Y per evitare doppi scatti
 452  85DC              .wait_continue_release:
 453  85DC 76               halt
 454  85DD 01 FE DF         ld   bc, $dffe
 455  85E0 ED 78            in   a, (c)
 456  85E2 CB 67            bit  4, a
 457  85E4 28 F6            jr   z, .wait_continue_release
 458  85E6
 459  85E6                  ; 5b. Ripristina lo stato per continuare la partita:
 460  85E6                  ; - Ripristina tutti gli item della stanza corrente al valore $FF (tutti da raccogliere)
 461  85E6 CD EF 80         call Items_ResetCurrentRoomItems
 462  85E9
 463  85E9                  ; - Ripristina le vite di Willy al valore iniziale
 464  85E9 3E 07            ld   a, INITIAL_LIVES
 465  85EB 32 76 AA         ld   (willy_lives), a
 466  85EE
 467  85EE                  ; - Sincronizza i contatori temporali con counter hardware per evitare salti dopo la pausa a schermo
 468  85EE 2A 8A AA         ld   hl, (counter)
 469  85F1 22 8D AA         ld   (last_frame_counter), hl
 470  85F4
 471  85F4                  ; - Reimposta la fisica e le variabili di stato di Willy
 472  85F4 AF               xor  a
 473  85F5 32 77 AA         ld   (velocity_y), a
 474  85F8 32 79 AA         ld   (jump_pressed), a
 475  85FB 32 7B AA         ld   (coyote_timer), a
 476  85FE 32 7E AA         ld   (jump_frame), a
 477  8601 32 7D AA         ld   (jump_dir), a
 478  8604 32 6F AA         ld   (body_state), a
 479  8607 32 82 AA         ld   (w_warp_state), a
 480  860A 32 85 AA         ld   (w_key_prev), a
 481  860D 32 86 AA         ld   (enter_key_prev), a
 482  8610 32 72 AA         ld   (collision_active), a
 483  8613 32 71 AA         ld   (flags), a
 484  8616 32 6B AE         ld   (ramp_entry_guard), a
 485  8619 32 76 AE         ld   (willy_on_ramp), a
 486  861C 32 75 AE         ld   (willy_needs_redraw), a
 487  861F 3E FF            ld   a, $ff
 488  8621 32 87 AA         ld   (digit_key_prev), a
 489  8624 32 70 AE         ld   (player_drawn_pos+1), a
 490  8627 32 71 AE         ld   (player_old_dir), a
 491  862A 32 72 AE         ld   (player_old_body), a
 492  862D 3E 01            ld   a, 1
 493  862F 32 80 AA         ld   (q_prev), a
 494  8632 32 81 AA         ld   (a_prev), a
 495  8635 32 78 AA         ld   (on_ground), a
 496  8638 32 73 AE         ld   (enemy_was_updated), a
 497  863B
 498  863B                  ; - Timer di sicurezza post-respawn (invulnerabilità)
 499  863B 3E 00            ld   a, RESPAWN_SAFETY_TIME
 500  863D 32 74 AE         ld   (willy_safety_timer), a
 501  8640
 502  8640                  ; - Ripristina lo stato audio
 503  8640 3E 12            ld   a, 18
 504  8642 32 85 B0         ld   (Audio_jump_sound_note), a
 505  8645 AF               xor  a
 506  8646 32 86 B0         ld   (Audio_jump_sound_timer), a
 507  8649                  IF ENABLE_MUSIC != 0
 508  8649 ~                ld   (Audio_music_note_idx), a

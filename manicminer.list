   8+ 82E4              ; Audio_UpdateJumpSound
   9+ 82E4              ;
  10+ 82E4              ; Gestisce la riproduzione dell'effetto sonoro del salto frame-by-frame.
  11+ 82E4              ; Viene chiamata una volta per frame nel ciclo principale.
  12+ 82E4              ; -------------------------------------------------------------------
  13+ 82E4              Audio_UpdateJumpSound:
  14+ 82E4 F5               push af
  15+ 82E5 C5               push bc
  16+ 82E6 D5               push de
  17+ 82E7 E5               push hl
  18+ 82E8
  19+ 82E8                  ; Controlla se il suono è attivo (note < 18)
  20+ 82E8 3A 24 9C         ld   a, (Audio_jump_sound_note)
  21+ 82EB FE 12            cp   18                        ; Ci sono 18 note (0..17)
  22+ 82ED 30 2A            jr   nc, .done                 ; Se >= 18, non stiamo riproducendo
  23+ 82EF

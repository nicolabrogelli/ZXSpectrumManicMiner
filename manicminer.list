  86+ 8045 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 8047 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 8048 23               inc  hl                        ; +2 (Attr Address High)
  89+ 8049 23               inc  hl                        ; +3 (Anim mask)
  90+ 804A 23               inc  hl                        ; +4 (Collected flag)
  91+ 804B 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 804D 23               inc  hl                        ; Avanza al prossimo item
  93+ 804E 18 F2            jr   .item_loop
  94+ 8050
  95+ 8050              .next_room:

  72+ 8808 ~            ; Audio_UpdateMusic
  73+ 8808 ~            ;
  74+ 8808 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8808 ~            ; Viene chiamata a ogni frame.
  76+ 8808 ~            ; -------------------------------------------------------------------
  77+ 8808 ~            Audio_UpdateMusic:
  78+ 8808 ~                push af
  79+ 8808 ~                push bc
  80+ 8808 ~                push de
  81+ 8808 ~                push hl
  82+ 8808 ~
  83+ 8808 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8808 ~                ld   a, (Audio_jump_sound_note)
  85+ 8808 ~                cp   18
  86+ 8808 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8808 ~
  88+ 8808 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8808 ~                ld   a, (Audio_music_frame_counter)
  90+ 8808 ~                dec  a
  91+ 8808 ~                ld   (Audio_music_frame_counter), a
  92+ 8808 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8808 ~
  94+ 8808 ~                ; Altrimenti carica la nota successiva
  95+ 8808 ~                ld   a, (Audio_music_note_idx)
  96+ 8808 ~                inc  a
  97+ 8808 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8808 ~                jr   c, .no_wrap
  99+ 8808 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8808 ~            .no_wrap:
 101+ 8808 ~                ld   (Audio_music_note_idx), a
 102+ 8808 ~
 103+ 8808 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8808 ~                ld   e, a
 105+ 8808 ~                ld   d, 0
 106+ 8808 ~                ld   hl, Audio_MusicSheet
 107+ 8808 ~                add  hl, de
 108+ 8808 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8808 ~
 110+ 8808 ~                ; Leggi durata (secondo byte)
 111+ 8808 ~                inc  hl
 112+ 8808 ~                ld   a, (hl)
 113+ 8808 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8808 ~                jr   nz, .dur_ok
 115+ 8808 ~                ld   a, 1
 116+ 8808 ~            .dur_ok:
 117+ 8808 ~                ld   (Audio_music_frame_counter), a
 118+ 8808 ~
 119+ 8808 ~            .play_current_note:
 120+ 8808 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 8808 ~                ld   a, (Audio_music_note_idx)
 122+ 8808 ~                ld   e, a
 123+ 8808 ~                ld   d, 0
 124+ 8808 ~                ld   hl, Audio_MusicSheet
 125+ 8808 ~                add  hl, de
 126+ 8808 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 8808 ~                ld   a, (hl)                  ; A = delay
 128+ 8808 ~                or   a
 129+ 8808 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 8808 ~
 131+ 8808 ~                ; Suona la nota: 2 cicli
 132+ 8808 ~                ld   d, a                     ; D = delay
 133+ 8808 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 8808 ~            .note_loop:
 135+ 8808 ~                ; Speaker ON
 136+ 8808 ~                ld   a, (room_border_color)
 137+ 8808 ~                or   $10
 138+ 8808 ~                out  ($fe), a
 139+ 8808 ~                ld   c, d
 140+ 8808 ~            .d1:
 141+ 8808 ~                push af
 142+ 8808 ~                pop  af
 143+ 8808 ~                dec  c
 144+ 8808 ~                jr   nz, .d1
 145+ 8808 ~
 146+ 8808 ~                ; Speaker OFF
 147+ 8808 ~                ld   a, (room_border_color)
 148+ 8808 ~                and  $ef
 149+ 8808 ~                out  ($fe), a
 150+ 8808 ~                ld   c, d
 151+ 8808 ~            .d2:
 152+ 8808 ~                push af
 153+ 8808 ~                pop  af
 154+ 8808 ~                dec  c
 155+ 8808 ~                jr   nz, .d2
 156+ 8808 ~
 157+ 8808 ~                djnz .note_loop
 158+ 8808 ~
 159+ 8808 ~            .done:
 160+ 8808 ~                pop  hl
 161+ 8808 ~                pop  de
 162+ 8808 ~                pop  bc
 163+ 8808 ~                pop  af
 164+ 8808 ~                ret
 165+ 8808 ~
 166+ 8808 ~            Audio_MusicSheet:
 167+ 8808 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 8808 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 8808 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10

 660+ 82C3              ; Score_CheckAndUpdateHighScore
 661+ 82C3              ; Se player_score > high_score, copia player_score in high_score.
 662+ 82C3              ; -------------------------------------------------------------------
 663+ 82C3              Score_CheckAndUpdateHighScore:
 664+ 82C3                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 665+ 82C3                  ; Byte 2:
 666+ 82C3 3A 44 A4         ld   a, (player_score + 2)
 667+ 82C6 47               ld   b, a
 668+ 82C7 3A 47 A4         ld   a, (high_score + 2)
 669+ 82CA B8               cp   b
 670+ 82CB 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 671+ 82CD 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 672+ 82CF
 673+ 82CF                  ; Byte 1:
 674+ 82CF 3A 43 A4         ld   a, (player_score + 1)
 675+ 82D2 47               ld   b, a
 676+ 82D3 3A 46 A4         ld   a, (high_score + 1)
 677+ 82D6 B8               cp   b
 678+ 82D7 38 0C            jr   c, .new_high_score
 679+ 82D9 20 1C            jr   nz, .done_check
 680+ 82DB
 681+ 82DB                  ; Byte 0:
 682+ 82DB 3A 42 A4         ld   a, (player_score + 0)
 683+ 82DE 47               ld   b, a
 684+ 82DF 3A 45 A4         ld   a, (high_score + 0)
 685+ 82E2 B8               cp   b
 686+ 82E3 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 687+ 82E5
 688+ 82E5              .new_high_score:
 689+ 82E5 3A 42 A4         ld   a, (player_score + 0)
 690+ 82E8 32 45 A4         ld   (high_score + 0), a
 691+ 82EB 3A 43 A4         ld   a, (player_score + 1)
 692+ 82EE 32 46 A4         ld   (high_score + 1), a
 693+ 82F1 3A 44 A4         ld   a, (player_score + 2)
 694+ 82F4 32 47 A4         ld   (high_score + 2), a
 695+ 82F7
 696+ 82F7              .done_check:
 697+ 82F7 C9               ret

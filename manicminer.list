  61+ 7CDA 19               add  hl, de
  62+ 7CDB
  63+ 7CDB 06 04            ld   b, 4                      ; Fino a 4 guardiani orizzontali
  64+ 7CDD              .load_h_loop:
  65+ 7CDD 7E               ld   a, (hl)                   ; Byte 0: Attributo / Flags
  66+ 7CDE FE FF            cp   $FF

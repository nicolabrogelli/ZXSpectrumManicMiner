 142+ 85EC              ; Items_DrawRoom
 143+ 85EC              ;
 144+ 85EC              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 145+ 85EC              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 146+ 85EC              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 147+ 85EC              ;
 148+ 85EC              ; Record item nella stanza (5 byte):
 149+ 85EC              ;   +0 Color / Attributo
 150+ 85EC              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 151+ 85EC              ;   +2 Attr Address High
 152+ 85EC              ;   +3 Anim Mask (96)
 153+ 85EC              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 154+ 85EC              ; Fine lista: $FF
 155+ 85EC              ; -------------------------------------------------------------------
 156+ 85EC              Items_DrawRoom:
 157+ 85EC E5               push hl
 158+ 85ED D5               push de
 159+ 85EE C5               push bc
 160+ 85EF DD E5            push ix
 161+ 85F1 FD E5            push iy
 162+ 85F3
 163+ 85F3                  ; 1. Azzera items_grid (512 byte)
 164+ 85F3 21 2B E9         ld   hl, items_grid
 165+ 85F6 11 2C E9         ld   de, items_grid + 1
 166+ 85F9 36 00            ld   (hl), 0
 167+ 85FB 01 FF 01         ld   bc, 511
 168+ 85FE ED B0            ldir
 169+ 8600
 170+ 8600                  ; 2. Nessun item attivo inizialmente nella cache
 171+ 8600 AF               xor  a
 172+ 8601 32 AC EE         ld   (num_room_items), a
 173+ 8604
 174+ 8604 FD 21 5C EE      ld   iy, current_room_items
 175+ 8608
 176+ 8608                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 177+ 8608 2A AD EE         ld   hl, (room_ptr)
 178+ 860B 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 179+ 860E 19               add  hl, de
 180+ 860F E5               push hl
 181+ 8610 DD E1            pop  ix                        ; IX = bitmap item
 182+ 8612
 183+ 8612                  ; 4. HL = Inizio lista item nella stanza
 184+ 8612 2A AD EE         ld   hl, (room_ptr)
 185+ 8615 11 75 02         ld   de, OFFSET_ITEMS
 186+ 8618 19               add  hl, de
 187+ 8619
 188+ 8619              .loop:
 189+ 8619 7E               ld   a, (hl)                   ; Byte 0: Color
 190+ 861A FE FF            cp   $FF
 191+ 861C 28 68            jr   z, .done                  ; $FF = fine lista item
 192+ 861E B7               or   a
 193+ 861F 28 65            jr   z, .done                  ; 0 = fine lista item (nessun colore / slot vuoto)
 194+ 8621
 195+ 8621 5F               ld   e, a                      ; E = Color
 196+ 8622 23               inc  hl
 197+ 8623 4E               ld   c, (hl)                   ; C = AttrAddr Low
 198+ 8624 23               inc  hl
 199+ 8625 46               ld   b, (hl)                   ; B = AttrAddr High
 200+ 8626 23               inc  hl                        ; Salta Anim Byte
 201+ 8627 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 202+ 8628
 203+ 8628 7E               ld   a, (hl)                   ; A = Collected flag
 204+ 8629 FE FF            cp   $FF
 205+ 862B 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 206+ 862D
 207+ 862D                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 208+ 862D E5               push hl
 209+ 862E 60               ld   h, b
 210+ 862F 69               ld   l, c
 211+ 8630 01 00 A4         ld   bc, -23552
 212+ 8633 09               add  hl, bc                    ; HL = AttrOffset
 213+ 8634
 214+ 8634                  ; Col = Offset & 31
 215+ 8634 7D               ld   a, l
 216+ 8635 E6 1F            and  31
 217+ 8637 4F               ld   c, a                      ; C = Col (0..31)
 218+ 8638
 219+ 8638                  ; Row = Offset / 32
 220+ 8638 CB 3C            srl  h
 220+ 863A CB 1D          rr l
 221+ 863C CB 3C            srl  h
 221+ 863E CB 1D          rr l
 222+ 8640 CB 3C            srl  h
 222+ 8642 CB 1D          rr l
 223+ 8644 CB 3C            srl  h
 223+ 8646 CB 1D          rr l
 224+ 8648 CB 3C            srl  h
 224+ 864A CB 1D          rr l
 225+ 864C 7D               ld   a, l
 226+ 864D 47               ld   b, a                      ; B = Row (0..15)
 227+ 864E
 228+ 864E                  ; Disegna l'item sullo schermo
 229+ 864E DD E5            push ix
 230+ 8650 E1               pop  hl                        ; HL = puntatore bitmap
 231+ 8651 CD A3 86         call DrawItemGraphic
 232+ 8654
 233+ 8654                  ; Aggiorna items_grid: offset = Row * 32 + Col
 234+ 8654 D5               push de
 235+ 8655 26 00            ld   h, 0
 236+ 8657 68               ld   l, b                      ; HL = Row
 237+ 8658 29               add  hl, hl
 238+ 8659 29               add  hl, hl
 239+ 865A 29               add  hl, hl
 240+ 865B 29               add  hl, hl
 241+ 865C 29               add  hl, hl                    ; Row * 32
 242+ 865D 59               ld   e, c
 243+ 865E 16 00            ld   d, 0

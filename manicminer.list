 825  8302              ; ResetFullGameState
 826  8302              ; Ripristina tutti i dati ed i parametri allo stato iniziale
 827  8302              ; per l'avvio di una nuova partita dopo il Game Over.
 828  8302              ; -------------------------------------------------------------------
 829  8302              ResetFullGameState:
 830  8302                  ; Pulisce completamente lo schermo e ripristina gli attributi di default
 831  8302 AF               xor  a
 832  8303 D3 FE            out  ($fe), a              ; Bordo a nero
 833  8305 21 8D 5C         ld   hl, ATTR_P
 834  8308 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 835  8309 CD AF 0D         call CLS                   ; Pulisce tutta la memoria pixel (6144B) e attributi (768B)
 836  830C 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
 837  830E 3E 07            ld   a, $07
 838  8310 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 839  8313
 840  8313                  ; Ripristina il numero di vite iniziali
 841  8313 3E 07            ld   a, INITIAL_LIVES
 842  8315 32 B4 8D         ld   (willy_lives), a
 843  8318
 844  8318                  ; Azzeramento conteggio item raccolti e dello stato fisica/input
 845  8318 AF               xor  a
 846  8319 32 B1 8D         ld   (items_collected), a
 847  831C 32 AD 8D         ld   (body_state), a
 848  831F 32 C0 8D         ld   (w_warp_state), a
 849  8322 32 C3 8D         ld   (w_key_prev), a
 850  8325 32 C4 8D         ld   (enter_key_prev), a
 851  8328 32 B5 8D         ld   (velocity_y), a
 852  832B 32 B7 8D         ld   (jump_pressed), a
 853  832E 32 B9 8D         ld   (coyote_timer), a
 854  8331 32 BC 8D         ld   (jump_frame), a
 855  8334 32 BB 8D         ld   (jump_dir), a
 856  8337 32 2D 91         ld   (transition_active), a
 857  833A 32 B1 91         ld   (willy_safety_timer), a
 858  833D 3E FF            ld   a, $ff
 859  833F 32 C5 8D         ld   (digit_key_prev), a
 860  8342 3E 01            ld   a, 1
 861  8344 32 BE 8D         ld   (q_prev), a
 862  8347 32 BF 8D         ld   (a_prev), a
 863  834A 32 B6 8D         ld   (on_ground), a
 864  834D
 865  834D                  ; Azzeramento punteggio partita corrente (Score = 000000)
 866  834D                  ; Nota: High score viene mantenuto intatto tra le partite
 867  834D AF               xor  a
 868  834E 32 B6 93         ld   (player_score + 0), a
 869  8351 32 B7 93         ld   (player_score + 1), a
 870  8354 32 B8 93         ld   (player_score + 2), a
 871  8357
 872  8357                  ; Ripristina tutti gli item in ItemsTable al valore 0 (non raccolti)
 873  8357 CD 76 7C         call ResetItemsTable
 874  835A
 875  835A                  ; Inizializza la tabella dei punti di ingresso per tutte le stanze (0..60)
 876  835A CD 4E 6C         call InitRoomEntryPositions
 877  835D
 878  835D                  ; Aggiorna la riga di stato con High score e Score azzerato
 879  835D CD 63 67         call Gfx_UpdateScoreDisplay
 880  8360
 881  8360                  ; Ripristina la stanza iniziale (Central Cavern)
 882  8360 21 67 83         ld   hl, CentralCavernLayout
 883  8363 22 27 91         ld   (room_ptr), hl
 884  8366
 885  8366 C9               ret

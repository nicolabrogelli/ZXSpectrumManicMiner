 747+ 8790              ; Items_Animate
 748+ 8790              ;
 749+ 8790              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 8790              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 8790              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 8790              ; originale $8F63.
 753+ 8790              ; -------------------------------------------------------------------
 754+ 8790              Items_Animate:
 755+ 8790 E5               push hl
 756+ 8791 D5               push de
 757+ 8792 C5               push bc
 758+ 8793 FD E5            push iy
 759+ 8795
 760+ 8795 3A C9 ED         ld   a, (num_room_items)
 761+ 8798 B7               or   a
 762+ 8799 28 40            jr   z, .anim_done
 763+ 879B
 764+ 879B FD 21 79 ED      ld   iy, current_room_items
 765+ 879F
 766+ 879F              .anim_loop:
 767+ 879F FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 87A2 FE FF            cp   $FF
 769+ 87A4 28 35            jr   z, .anim_done
 770+ 87A6 B7               or   a
 771+ 87A7 28 2B            jr   z, .next_anim_item
 772+ 87A9
 773+ 87A9                  ; Routine originale $8F63 di Manic Miner:
 774+ 87A9                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 87A9 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 87AB F6 03            or   $03                       ; Base Ink = 3
 777+ 87AD 47               ld   b, a                      ; B = (Paper & $F8) | 3

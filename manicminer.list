 523+ 868B FE FF            cp   $FF
 524+ 868D 28 5B            jr   z, .done                  ; Fine lista item della stanza
 525+ 868F B7               or   a
 526+ 8690 28 51            jr   z, .next_item             ; Item già raccolto -> controlla il successivo
 527+ 8692
 528+ 8692 FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 529+ 8695 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)

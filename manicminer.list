  96+ 7D8E 87             add a, a
  96+ 7D8F 87             add a, a
  97+ 7D90 DD 77 02         ld   (ix+2), a                 ; Current X = StartX
  98+ 7D93
  99+ 7D93                  ; Row = Offset / 32 -> StartY = Row * 8
 100+ 7D93 CB 3C            srl  h
 100+ 7D95 CB 1D          rr l
 101+ 7D97 CB 3C            srl  h

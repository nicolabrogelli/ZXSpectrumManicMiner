 959+ 77C8              ; -------------------------------------------------------------------
 960+ 77C8              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 961+ 77C8              ; Input: C = X, B = Y
 962+ 77C8              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 963+ 77C8              ; -------------------------------------------------------------------
 964+ 77C8              CheckWallCell:
 965+ 77C8 E5               push hl
 966+ 77C9 D5               push de
 967+ 77CA C5               push bc
 968+ 77CB
 969+ 77CB                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77CB 78               ld   a, b
 971+ 77CC FE 80            cp   128
 972+ 77CE 30 1F            jr   nc, .not_wall
 973+ 77D0
 974+ 77D0                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77D0 CB 3F            srl  a
 976+ 77D2 CB 3F            srl  a
 977+ 77D4 CB 3F            srl  a                 ; A = r (0..15)
 978+ 77D6
 979+ 77D6                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77D6 5F               ld   e, a              ; E = r (Row)
 981+ 77D7 79               ld   a, c
 982+ 77D8 CB 3F            srl  a
 983+ 77DA CB 3F            srl  a
 984+ 77DC CB 3F            srl  a                 ; A = c (0..31)
 985+ 77DE 4F               ld   c, a              ; C = c (Col)
 986+ 77DF
 987+ 77DF                  ; Se la cella è sulla rampa, non considerarla un muro!
 988+ 77DF 53               ld   d, e              ; D = Row
 989+ 77E0 59               ld   e, c              ; E = Col
 990+ 77E1 CD 4D 77         call IsCellOnRamp
 991+ 77E4 38 09            jr   c, .not_wall
 992+ 77E6
 993+ 77E6 7A               ld   a, d              ; A = Row
 994+ 77E7 4B               ld   c, e              ; C = Col
 995+ 77E8 CD 84 78         call GetCellFromUnpacked ; A = cell type
 996+ 77EB
 997+ 77EB                  ; Controlla se è Wall (3)
 998+ 77EB FE 03            cp   3

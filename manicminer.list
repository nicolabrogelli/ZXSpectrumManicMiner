  82+ CCEC 00           crumbling_active_count: db 0      ; Numero di blocchi attualmente in fase di sgretolamento
  83+ CCED 00           crumbling_anim_timer:   db 0      ; Timer per scandire la velocità di animazione dello sgretolamento
  84+ CCEE
  85+ CCEE              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  86+ CCEE 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  87+ CCF1 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  88+ CCF4 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  89+ CCF5 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  90+ CCF6 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  91+ CCF7 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  92+ CCF8 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  93+ CCF9 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)
  94+ CCFA
  95+ CCFA 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  96+ CCFB 00           Audio_jump_sound_timer:   db 0

 438+ 86F0 ED 4B 03 EB      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 86F4
 440+ 86F4                  ; WillyLeft <= ItemRight
 441+ 86F4 79               ld   a, c                      ; A = WillyX
 442+ 86F5 BA               cp   d                         ; D = ItemRight
 443+ 86F6 28 04            jr   z, .x_ok
 444+ 86F8 38 02            jr   c, .x_ok
 445+ 86FA 18 31            jr   .no_collision
 446+ 86FC
 447+ 86FC              .x_ok:
 448+ 86FC                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 86FC BB               cp   e                         ; E = ItemLeft
 450+ 86FD 28 0B            jr   z, .y_check
 451+ 86FF 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 8701
 453+ 8701                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 7) >= ItemLeft
 454+ 8701 C6 07            add  a, 7
 455+ 8703 BB               cp   e
 456+ 8704 28 04            jr   z, .y_check
 457+ 8706 30 02            jr   nc, .y_check
 458+ 8708 18 23            jr   .no_collision
 459+ 870A
 460+ 870A              .y_check:
 461+ 870A                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 870A 7C               ld   a, h                      ; H = Item Row
 463+ 870B 87               add  a, a                      ; *2
 464+ 870C 87               add  a, a                      ; *4
 465+ 870D 87               add  a, a                      ; *8
 466+ 870E 5F               ld   e, a                      ; E = ItemTop
 467+ 870F C6 07            add  a, 7
 468+ 8711 57               ld   d, a                      ; D = ItemBottom
 469+ 8712
 470+ 8712                  ; WillyTop <= ItemBottom
 471+ 8712 78               ld   a, b                      ; A = WillyY
 472+ 8713 BA               cp   d                         ; D = ItemBottom
 473+ 8714 28 04            jr   z, .y_ok
 474+ 8716 38 02            jr   c, .y_ok
 475+ 8718 18 13            jr   .no_collision
 476+ 871A
 477+ 871A              .y_ok:
 478+ 871A                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 871A BB               cp   e                         ; E = ItemTop
 480+ 871B 28 0B            jr   z, .collision
 481+ 871D 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 871F
 483+ 871F                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 871F C6 0F            add  a, 15
 485+ 8721 BB               cp   e
 486+ 8722 28 04            jr   z, .collision
 487+ 8724 30 02            jr   nc, .collision
 488+ 8726 18 05            jr   .no_collision

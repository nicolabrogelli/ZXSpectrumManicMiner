 701  8B7E              ; CheckAllItemsCollected
 702  8B7E              ; Verifica che tutti gli item della stanza/gioco siano stati raccolti.
 703  8B7E              ; Output: Carry = 1 se tutti raccolti, Carry = 0 altrimenti
 704  8B7E              ; -------------------------------------------------------------------
 705  8B7E              CheckAllItemsCollected:
 706  8B7E 3A 9E F0         ld   a, (game_objective_completed)
 707  8B81 B7               or   a
 708  8B82 20 08            jr   nz, .all_collected
 709  8B84 3A 05 EE         ld   a, (num_room_items)
 710  8B87 B7               or   a
 711  8B88 28 02            jr   z, .all_collected
 712  8B8A B7               or   a
 713  8B8B C9               ret
 714  8B8C              .all_collected:
 715  8B8C 37               scf
 716  8B8D C9               ret

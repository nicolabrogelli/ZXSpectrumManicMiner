 394  862F 76               halt
 395  8630
 396  8630                  ; Animazione ciclo colore per GAME OVER (Riga 5, Colonna 11..19, $58AB)
 397  8630 0C               inc  c
 398  8631 79               ld   a, c
 399  8632 CB 3F            srl  a
 400  8634 CB 3F            srl  a                     ; Cambia colore ogni 4 frame (~80ms)
 401  8636 E6 07            and  7
 402  8638 5F               ld   e, a
 403  8639 16 00            ld   d, 0
 404  863B 21 D1 65         ld   hl, game_over_color_table
 405  863E 19               add  hl, de
 406  863F 7E               ld   a, (hl)               ; A = nuovo colore attributo
 407  8640 21 AB 58         ld   hl, $58ab             ; Indirizzo attributi riga 5, col 11 ($5800 + 5*32 + 11 = $58AB)
 408  8643 06 09            ld   b, 9

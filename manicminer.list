  42+ 8990 20 FD            jr   nz, .d1
  43+ 8992
  44+ 8992                  ; Speaker OFF
  45+ 8992 3A EB EB         ld   a, (room_border_color)
  46+ 8995 E6 EF            and  $ef
  47+ 8997 D3 FE            out  ($fe), a
  48+ 8999 4A               ld   c, d
  49+ 899A              .d2:
  50+ 899A 0D               dec  c
  51+ 899B 20 FD            jr   nz, .d2
  52+ 899D
  53+ 899D 10 E8            djnz .note_loop
  54+ 899F
  55+ 899F                  ; Passa alla nota successiva
  56+ 899F 3A 01 F2         ld   a, (Audio_jump_sound_note)
  57+ 89A2 3C               inc  a
  58+ 89A3 32 01 F2         ld   (Audio_jump_sound_note), a

1284+ 64FE 0E 78            ld   c, 120
1285+ 6500 DD 21 B3 6B      ld   ix, PiedeSprite
1286+ 6504 CD 38 5F         call Gfx_DrawPixelSprite16x16
1287+ 6507
1288+ 6507                  ; 7c. Imposta colore Giallo Brillante per PiedeSprite
1289+ 6507 0E 78            ld   c, 120
1290+ 6509 3E 46            ld   a, YELLOW | $40
1291+ 650B CD BB 6A         call Gfx_SetEnemyColorAttributes
1292+ 650E
1293+ 650E                  ; 7d. Pausa per movimento fluido a 50Hz
1294+ 650E 76               halt
1295+ 650F
1296+ 650F C1               pop  bc                    ; B = Y corrente
1297+ 6510 78               ld   a, b
1298+ 6511 C6 02            add  a, 2                  ; Avanza di 2 pixel
1299+ 6513 47               ld   b, a
1300+ 6514 FE 62            cp   98                    ; Si ferma a Y = 96 (incluso, il ciclo termina quando B=98)
1301+ 6516 38 B2            jr   c, .foot_descent_loop
1302+ 6518
1303+ 6518                  ; 8. Breve pausa con PiedeSprite fermato sulla parte alta della Botte (~0.7s)
1304+ 6518 06 23            ld   b, 35

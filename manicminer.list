 121+ 7DB0 23               inc  hl
 122+ 7DB1 7E               ld   a, (hl)                   ; Byte 5: Min limit
 123+ 7DB2 E6 1F            and  31
 124+ 7DB4 87               add  a, a
 124+ 7DB5 87             add a, a
 124+ 7DB6 87             add a, a
 125+ 7DB7 DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 126+ 7DBA
 127+ 7DBA 23               inc  hl
 128+ 7DBB 7E               ld   a, (hl)                   ; Byte 6: Max limit
 129+ 7DBC E6 1F            and  31
 130+ 7DBE 87               add  a, a
 130+ 7DBF 87             add a, a
 130+ 7DC0 87             add a, a
 131+ 7DC1 DD 77 05         ld   (ix+5), a                 ; Max Limit X (pixel)
 132+ 7DC4
 133+ 7DC4 23               inc  hl                        ; Prossimo guardiano
 134+ 7DC5 11 0B 00         ld   de, 11
 135+ 7DC8 DD 19            add  ix, de
 136+ 7DCA 10 8E            djnz .load_h_loop

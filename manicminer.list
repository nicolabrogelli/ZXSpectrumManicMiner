 447+ 7CF8              .h_rev_left:
 448+ 7CF8 DD 7E 05         ld   a, (ix+5)                 ; Max Limit
 449+ 7CFB DD 77 02         ld   (ix+2), a
 450+ 7CFE 3E 01            ld   a, 1
 451+ 7D00 DD 77 06         ld   (ix+6), a                 ; Cambia direzione a Sinistra
 452+ 7D03 C3 4A 7D         jp   .next
 453+ 7D06
 454+ 7D06              .vertical:
 455+ 7D06 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Up, 2 = Down)
 456+ 7D09 FE 01            cp   1

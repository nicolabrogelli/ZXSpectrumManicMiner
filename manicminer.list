  86+ 8058 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 805A 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 805B 23               inc  hl                        ; +2 (Attr Address High)
  89+ 805C 23               inc  hl                        ; +3 (Anim mask)
  90+ 805D 23               inc  hl                        ; +4 (Collected flag)
  91+ 805E 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 8060 23               inc  hl                        ; Avanza al prossimo item
  93+ 8061 18 F2            jr   .item_loop
  94+ 8063
  95+ 8063              .next_room:

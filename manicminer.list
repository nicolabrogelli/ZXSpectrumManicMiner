1053+ 7826              ; -------------------------------------------------------------------
1054+ 7826              ; Decodifica il layout della stanza (512 byte) in un buffer di 512 byte in RAM.
1055+ 7826              ; Mappa gli attributi grafici delle celle nei tipi standardizzati (0..7):
1056+ 7826              ;   0 = Background, 1 = Floor, 2 = Crumbling, 3 = Wall,
1057+ 7826              ;   4 = Conveyor,   5 = Nasty1, 6 = Nasty2,     7 = Extra
1058+ 7826              ; -------------------------------------------------------------------
1059+ 7826              UnpackRoomLayout:
1060+ 7826 E5               push hl
1061+ 7827 D5               push de
1062+ 7828 C5               push bc
1063+ 7829 DD E5            push ix
1064+ 782B
1065+ 782B DD 2A 0B E5      ld   ix, (room_ptr)
1066+ 782F 11 20 02         ld   de, OFFSET_TILES
1067+ 7832 DD 19            add  ix, de                ; IX = room_ptr + OFFSET_TILES (544)
1068+ 7834
1069+ 7834 2A 0B E5         ld   hl, (room_ptr)        ; HL = inizio layout (512 byte)
1070+ 7837 11 B0 E2         ld   de, unpacked_layout   ; DE = buffer RAM (512 byte)
1071+ 783A 01 00 02         ld   bc, 512               ; 512 celle
1072+ 783D
1073+ 783D              .byte_loop:
1074+ 783D 7E               ld   a, (hl)               ; Leggi byte attributo dal layout
1075+ 783E 23               inc  hl
1076+ 783F
1077+ 783F                  ; Confronta con le 8 definizioni di tile:
1078+ 783F DD BE 00         cp   (ix + 0*9)            ; Background (Tile 0)?
1079+ 7842 28 23            jr   z, .is_bg
1080+ 7844 DD BE 1B         cp   (ix + 3*9)            ; Wall (Tile 3)?
1081+ 7847 28 29            jr   z, .is_wall
1082+ 7849 DD BE 09         cp   (ix + 1*9)            ; Floor (Tile 1)?
1083+ 784C 28 1C            jr   z, .is_floor
1084+ 784E DD BE 12         cp   (ix + 2*9)            ; Crumbling Floor (Tile 2)?
1085+ 7851 28 1B            jr   z, .is_crumbling
1086+ 7853 DD BE 24         cp   (ix + 4*9)            ; Conveyor (Tile 4)?
1087+ 7856 28 1E            jr   z, .is_conveyor
1088+ 7858 DD BE 2D         cp   (ix + 5*9)            ; Nasty 1 (Tile 5)?
1089+ 785B 28 1D            jr   z, .is_nasty1
1090+ 785D DD BE 36         cp   (ix + 6*9)            ; Nasty 2 (Tile 6)?
1091+ 7860 28 1C            jr   z, .is_nasty2
1092+ 7862 DD BE 3F         cp   (ix + 7*9)            ; Extra (Tile 7)?
1093+ 7865 28 1B            jr   z, .is_extra
1094+ 7867
1095+ 7867              .is_bg:
1096+ 7867                  ; Default: Tile 0 (Background)
1097+ 7867 AF               xor  a
1098+ 7868 18 1A            jr   .store_cell
1099+ 786A
1100+ 786A              .is_floor:
1101+ 786A 3E 01            ld   a, 1
1102+ 786C 18 16            jr   .store_cell
1103+ 786E              .is_crumbling:
1104+ 786E 3E 02            ld   a, 2
1105+ 7870 18 12            jr   .store_cell
1106+ 7872              .is_wall:
1107+ 7872 3E 03            ld   a, 3
1108+ 7874 18 0E            jr   .store_cell
1109+ 7876              .is_conveyor:
1110+ 7876 3E 04            ld   a, 4
1111+ 7878 18 0A            jr   .store_cell
1112+ 787A              .is_nasty1:
1113+ 787A 3E 05            ld   a, 5
1114+ 787C 18 06            jr   .store_cell
1115+ 787E              .is_nasty2:
1116+ 787E 3E 06            ld   a, 6
1117+ 7880 18 02            jr   .store_cell
1118+ 7882              .is_extra:
1119+ 7882 3E 07            ld   a, 7
1120+ 7884
1121+ 7884              .store_cell:
1122+ 7884 12               ld   (de), a
1123+ 7885 13               inc  de
1124+ 7886 0B               dec  bc
1125+ 7887 78               ld   a, b
1126+ 7888 B1               or   c
1127+ 7889 20 B2            jr   nz, .byte_loop
1128+ 788B
1129+ 788B DD E1            pop  ix
1130+ 788D C1               pop  bc
1131+ 788E D1               pop  de
1132+ 788F E1               pop  hl
1133+ 7890 C9               ret
1134+ 7891
1135+ 7891              ; -------------------------------------------------------------------
1136+ 7891              ; Legge il tipo di cella dal buffer decompresso in RAM
1137+ 7891              ; Input: A = Row (0..15), C = Col (0..31)
1138+ 7891              ; Output: A = tipo di cella (0..3)
1139+ 7891              ; Preserva tutti gli altri registri.
1140+ 7891              ; -------------------------------------------------------------------
1141+ 7891              GetCellFromUnpacked:
1142+ 7891 E5               push hl
1143+ 7892 D5               push de
1144+ 7893
1145+ 7893 6F               ld   l, a
1146+ 7894 26 00            ld   h, 0
1147+ 7896 29               add  hl, hl
1148+ 7897 29               add  hl, hl
1149+ 7898 29               add  hl, hl
1150+ 7899 29               add  hl, hl
1151+ 789A 29               add  hl, hl            ; HL = Row * 32
1152+ 789B 59               ld   e, c
1153+ 789C 16 00            ld   d, 0
1154+ 789E 19               add  hl, de            ; HL = Row * 32 + Col
1155+ 789F 11 B0 E2         ld   de, unpacked_layout
1156+ 78A2 19               add  hl, de
1157+ 78A3 7E               ld   a, (hl)           ; A = cell type
1158+ 78A4
1159+ 78A4 D1               pop  de
1160+ 78A5 E1               pop  hl
1161+ 78A6 C9               ret

1164+ 7886              ; Phys_CheckRampOnRoomChange
1165+ 7886              ; Controlla se nella nuova stanza (DE = room layout ptr) c'è una rampa
1166+ 7886              ; allineata con la posizione d'ingresso di Willy (C = PlayerX, B = PlayerY).
1167+ 7886              ; Output: Se allineato, modifica B = ramp_Y e C = PlayerX e imposta on_ground = 1.
1168+ 7886              ; -------------------------------------------------------------------
1169+ 7886              Phys_CheckRampOnRoomChange:
1170+ 7886 E5               push hl
1171+ 7887 D5               push de
1172+ 7888 C5               push bc
1173+ 7889
1174+ 7889                  ; Offsets per RampData: DE + 218
1175+ 7889 21 DA 00         ld   hl, 218
1176+ 788C 19               add  hl, de            ; HL = RampData pointer (nella nuova stanza)
1177+ 788D
1178+ 788D 7E               ld   a, (hl)           ; A = Direction (0 = up-left, 1 = up-right)
1179+ 788E 32 FB BD         ld   (ramp_dir), a
1180+ 7891 23               inc  hl
1181+ 7892 5E               ld   e, (hl)
1182+ 7893 23               inc  hl
1183+ 7894 56               ld   d, (hl)           ; DE = Location
1184+ 7895 23               inc  hl
1185+ 7896 7E               ld   a, (hl)           ; A = Length
1186+ 7897 32 FC BD         ld   (ramp_len), a
1187+ 789A
1188+ 789A                  ; Controlla se DE (Location) è 0 o Length è 0
1189+ 789A 7A               ld   a, d
1190+ 789B B3               or   e
1191+ 789C CA A3 79         jp   z, .no_ramp_change
1192+ 789F 3A FC BD         ld   a, (ramp_len)
1193+ 78A2 B7               or   a
1194+ 78A3 CA A3 79         jp   z, .no_ramp_change
1195+ 78A6
1196+ 78A6                  ; Calcola Row e Col: Offset = DE - 24064
1197+ 78A6 21 00 A2         ld   hl, -24064
1198+ 78A9 19               add  hl, de            ; HL = Offset
1199+ 78AA 54               ld   d, h
1200+ 78AB 5D               ld   e, l
1201+ 78AC
1202+ 78AC 7B               ld   a, e
1203+ 78AD E6 1F            and  31
1204+ 78AF 32 FE BD         ld   (ramp_col), a     ; Col Start
1205+ 78B2
1206+ 78B2 CB 3C            srl  h
1206+ 78B4 CB 1D          rr l
1207+ 78B6 CB 3C            srl  h
1207+ 78B8 CB 1D          rr l
1208+ 78BA CB 3C            srl  h
1208+ 78BC CB 1D          rr l
1209+ 78BE CB 3C            srl  h
1209+ 78C0 CB 1D          rr l
1210+ 78C2 CB 3C            srl  h
1210+ 78C4 CB 1D          rr l
1211+ 78C6 7D               ld   a, l
1212+ 78C7 32 FD BD         ld   (ramp_row), a     ; Row Start

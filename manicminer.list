 705+ 8812
 706+ 8812              ; -------------------------------------------------------------------
 707+ 8812              ; Score_CheckAndUpdateHighScore
 708+ 8812              ; Se player_score > high_score, copia player_score in high_score.
 709+ 8812              ; -------------------------------------------------------------------
 710+ 8812              Score_CheckAndUpdateHighScore:
 711+ 8812                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 8812                  ; Byte 2:
 713+ 8812 3A 19 F1         ld   a, (player_score + 2)
 714+ 8815 47               ld   b, a
 715+ 8816 3A 1C F1         ld   a, (high_score + 2)
 716+ 8819 B8               cp   b
 717+ 881A 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 881C 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 881E
 720+ 881E                  ; Byte 1:
 721+ 881E 3A 18 F1         ld   a, (player_score + 1)
 722+ 8821 47               ld   b, a
 723+ 8822 3A 1B F1         ld   a, (high_score + 1)
 724+ 8825 B8               cp   b
 725+ 8826 38 0C            jr   c, .new_high_score
 726+ 8828 20 1C            jr   nz, .done_check
 727+ 882A
 728+ 882A                  ; Byte 0:
 729+ 882A 3A 17 F1         ld   a, (player_score + 0)
 730+ 882D 47               ld   b, a
 731+ 882E 3A 1A F1         ld   a, (high_score + 0)
 732+ 8831 B8               cp   b
 733+ 8832 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento
 734+ 8834
 735+ 8834              .new_high_score:
 736+ 8834 3A 17 F1         ld   a, (player_score + 0)
 737+ 8837 32 1A F1         ld   (high_score + 0), a
 738+ 883A 3A 18 F1         ld   a, (player_score + 1)
 739+ 883D 32 1B F1         ld   (high_score + 1), a
 740+ 8840 3A 19 F1         ld   a, (player_score + 2)
 741+ 8843 32 1C F1         ld   (high_score + 2), a
 742+ 8846
 743+ 8846              .done_check:
 744+ 8846 C9               ret

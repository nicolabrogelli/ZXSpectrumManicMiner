 487+ 5FBB 7A               ld   a, d
 488+ 5FBC B6               or   (hl)
 489+ 5FBD 77               ld   (hl), a
 490+ 5FBE 23               inc  hl
 491+ 5FBF 7B               ld   a, e
 492+ 5FC0 B6               or   (hl)
 493+ 5FC1 77               ld   (hl), a
 494+ 5FC2 23               inc  hl
 495+ 5FC3 78               ld   a, b          ; Recupera il 3° byte dello sprite
 496+ 5FC4 B6               or   (hl)
 497+ 5FC5 77               ld   (hl), a

 493  8592 32 0D 9E         ld   (collision_active), a
 494  8595 32 0C 9E         ld   (flags), a
 495  8598 32 06 A2         ld   (ramp_entry_guard), a
 496  859B 32 11 A2         ld   (willy_on_ramp), a
 497  859E 32 10 A2         ld   (willy_needs_redraw), a
 498  85A1 3E FF            ld   a, $ff
 499  85A3 32 22 9E         ld   (digit_key_prev), a
 500  85A6 32 0B A2         ld   (player_drawn_pos+1), a
 501  85A9 32 0C A2         ld   (player_old_dir), a
 502  85AC 32 0D A2         ld   (player_old_body), a
 503  85AF 3E 01            ld   a, 1
 504  85B1 32 1B 9E         ld   (q_prev), a
 505  85B4 32 1C 9E         ld   (a_prev), a
 506  85B7 32 13 9E         ld   (on_ground), a
 507  85BA 32 0E A2         ld   (enemy_was_updated), a
 508  85BD
 509  85BD                  ; - Timer di sicurezza post-respawn (invulnerabilità)

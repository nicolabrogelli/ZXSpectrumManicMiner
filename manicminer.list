2187+ 6923 77               ld   (hl), a
2188+ 6924 23               inc  hl
2189+ 6925
2190+ 6925                  ; Cifra 1 (decine di migliaia)
2191+ 6925 DD 7E 02         ld   a, (ix+2)
2192+ 6928 E6 0F            and  $0f
2193+ 692A C6 30            add  a, '0'
2194+ 692C 77               ld   (hl), a
2195+ 692D 23               inc  hl
2196+ 692E
2197+ 692E                  ; Cifra 2 (migliaia)
2198+ 692E DD 7E 01         ld   a, (ix+1)
2199+ 6931 0F               rrca
2200+ 6932 0F               rrca
2201+ 6933 0F               rrca
2202+ 6934 0F               rrca
2203+ 6935 E6 0F            and  $0f
2204+ 6937 C6 30            add  a, '0'
2205+ 6939 77               ld   (hl), a
2206+ 693A 23               inc  hl
2207+ 693B
2208+ 693B                  ; Cifra 3 (centinaia)
2209+ 693B DD 7E 01         ld   a, (ix+1)
2210+ 693E E6 0F            and  $0f
2211+ 6940 C6 30            add  a, '0'
2212+ 6942 77               ld   (hl), a
2213+ 6943 23               inc  hl
2214+ 6944
2215+ 6944                  ; Cifra 4 (decine)
2216+ 6944 DD 7E 00         ld   a, (ix+0)
2217+ 6947 0F               rrca
2218+ 6948 0F               rrca
2219+ 6949 0F               rrca
2220+ 694A 0F               rrca
2221+ 694B E6 0F            and  $0f
2222+ 694D C6 30            add  a, '0'
2223+ 694F 77               ld   (hl), a

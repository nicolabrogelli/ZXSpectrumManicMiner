1218+ 64A2              ; Gfx_DrawGameOverScreen
1219+ 64A2              ; Esegue la sequenza animata di Game Over:
1220+ 64A2              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1221+ 64A2              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1222+ 64A2              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1223+ 64A2              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1224+ 64A2              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1225+ 64A2              ; -------------------------------------------------------------------
1226+ 64A2              Gfx_DrawGameOverScreen:
1227+ 64A2 F5               push af
1228+ 64A3 C5               push bc
1229+ 64A4 D5               push de
1230+ 64A5 E5               push hl
1231+ 64A6 DD E5            push ix
1232+ 64A8
1233+ 64A8                  ; 1. Bordo hardware e schermo a nero
1234+ 64A8 AF               xor  a
1235+ 64A9 D3 FE            out  ($fe), a              ; Bordo a nero
1236+ 64AB 21 8D 5C         ld   hl, ATTR_P
1237+ 64AE 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
1238+ 64AF CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1239+ 64B2 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1240+ 64B4 3E 07            ld   a, $07
1241+ 64B6 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1242+ 64B9
1243+ 64B9                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1244+ 64B9                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1245+ 64B9 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1246+ 64BC DD 21 49 8D      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1247+ 64C0 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1248+ 64C3
1249+ 64C3                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1250+ 64C3 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1251+ 64C6 DD 21 51 8D      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1252+ 64CA CD 3F 5E         call Gfx_DrawPixelSprite8x8
1253+ 64CD
1254+ 64CD                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96
1255+ 64CD 01 7C 60         ld   bc, $607c             ; B = Y = 96, C = X = 124
1256+ 64D0 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1257+ 64D2 CD 14 6B         call Gfx_SetEnemyColorAttributes
1258+ 64D5
1259+ 64D5                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1260+ 64D5 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1261+ 64D8 DD 21 2C 6C      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1262+ 64DC CD 90 5F         call Gfx_DrawPixelSprite16x16
1263+ 64DF
1264+ 64DF                  ; 3b. Imposta attributi colore per BotteSprite (Rosso Brillante) a X=120, Y=112
1265+ 64DF 01 78 70         ld   bc, $7078             ; B = Y = 112, C = X = 120
1266+ 64E2 3E 42            ld   a, RED | $40          ; Rosso Brillante
1267+ 64E4 CD 14 6B         call Gfx_SetEnemyColorAttributes
1268+ 64E7

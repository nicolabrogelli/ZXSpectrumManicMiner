 322+ 5F09                  ; La linea richiesta corrisponde alla linea originale traslata (ScanlineOffset - stage)
 323+ 5F09 90               sub  b                     ; A = stage - B
 324+ 5F0A ED 44            neg                        ; A = B - stage
 325+ 5F0C 47               ld   b, a                  ; B = offset scanline originale nel tile (1..8)
 326+ 5F0D
 327+ 5F0D              .crumble_intact:
 328+ 5F0D 3E 02            ld   a, 2                  ; Tile 2
 329+ 5F0F
 330+ 5F0F              .not_crumbling_bg:
 331+ 5F0F                  ; 7. Calcola puntatore alla scanline del tile:
 332+ 5F0F                  ; HL = (room_ptr + OFFSET_TILES) + (A * 9) + ScanlineOffset (in B)
 333+ 5F0F 6F               ld   l, a
 334+ 5F10 26 00            ld   h, 0
 335+ 5F12 5F               ld   e, a
 336+ 5F13 16 00            ld   d, 0
 337+ 5F15 29               add  hl, hl                ; *2
 338+ 5F16 29               add  hl, hl                ; *4
 339+ 5F17 29               add  hl, hl                ; *8
 340+ 5F18 19               add  hl, de                ; *9 (HL = A * 9)
 341+ 5F19
 342+ 5F19 11 20 02         ld   de, OFFSET_TILES      ; 544
 343+ 5F1C 19               add  hl, de
 344+ 5F1D ED 5B 62 EF      ld   de, (room_ptr)
 345+ 5F21 19               add  hl, de                ; HL = room_ptr + OFFSET_TILES + A * 9 (byte 0 = attributo)
 346+ 5F22
 347+ 5F22 58               ld   e, b                  ; E = Scanline offset (1..8)
 348+ 5F23 16 00            ld   d, 0
 349+ 5F25 19               add  hl, de                ; HL = puntatore alla scanline bitmap richiesta
 350+ 5F26 7E               ld   a, (hl)               ; A = byte bitmap originale del tile
 351+ 5F27
 352+ 5F27 C1               pop  bc
 353+ 5F28 D1               pop  de
 354+ 5F29 E1               pop  hl
 355+ 5F2A C9               ret

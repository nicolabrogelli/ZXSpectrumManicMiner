 959+ 77BA              ; -------------------------------------------------------------------
 960+ 77BA              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 961+ 77BA              ; Input: C = X, B = Y
 962+ 77BA              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 963+ 77BA              ; -------------------------------------------------------------------
 964+ 77BA              CheckWallCell:
 965+ 77BA E5               push hl
 966+ 77BB D5               push de
 967+ 77BC C5               push bc
 968+ 77BD
 969+ 77BD                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 970+ 77BD 78               ld   a, b
 971+ 77BE FE 80            cp   128
 972+ 77C0 30 1F            jr   nc, .not_wall
 973+ 77C2
 974+ 77C2                  ; 2. Calcola riga di layout: r = Y / 8
 975+ 77C2 CB 3F            srl  a
 976+ 77C4 CB 3F            srl  a
 977+ 77C6 CB 3F            srl  a                 ; A = r (0..15)
 978+ 77C8
 979+ 77C8                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
 980+ 77C8 5F               ld   e, a              ; E = r (Row)
 981+ 77C9 79               ld   a, c
 982+ 77CA CB 3F            srl  a
 983+ 77CC CB 3F            srl  a
 984+ 77CE CB 3F            srl  a                 ; A = c (0..31)
 985+ 77D0 4F               ld   c, a              ; C = c (Col)
 986+ 77D1
 987+ 77D1                  ; Se la cella è sulla rampa, non considerarla un muro!
 988+ 77D1 53               ld   d, e              ; D = Row
 989+ 77D2 59               ld   e, c              ; E = Col
 990+ 77D3 CD 3F 77         call IsCellOnRamp
 991+ 77D6 38 09            jr   c, .not_wall
 992+ 77D8
 993+ 77D8 7A               ld   a, d              ; A = Row
 994+ 77D9 4B               ld   c, e              ; C = Col
 995+ 77DA CD 76 78         call GetCellFromUnpacked ; A = cell type
 996+ 77DD
 997+ 77DD                  ; Controlla se è Wall (3)
 998+ 77DD FE 03            cp   3

 576+ 7F9F              ; -------------------------------------------------------------------
 577+ 7F9F              ; CheckCollision
 578+ 7F9F              ;
 579+ 7F9F              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 580+ 7F9F              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 581+ 7F9F              ; Output:
 582+ 7F9F              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 583+ 7F9F              ;   Carry Clear = Nessuna collisione
 584+ 7F9F              ; -------------------------------------------------------------------
 585+ 7F9F              CheckCollision:
 586+ 7F9F DD E5            push ix
 587+ 7FA1 C5               push bc
 588+ 7FA2 D5               push de
 589+ 7FA3 E5               push hl
 590+ 7FA4
 591+ 7FA4                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 592+ 7FA4 3A D6 B6         ld   a, (willy_safety_timer)
 593+ 7FA7 B7               or   a
 594+ 7FA8 C2 F2 80         jp   nz, .no_collision_found
 595+ 7FAB
 596+ 7FAB                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 597+ 7FAB 3A D2 B2         ld   a, (direction)
 598+ 7FAE FE 01            cp   1                         ; Sinistra?
 599+ 7FB0 20 1A            jr   nz, .willy_right
 600+ 7FB2
 601+ 7FB2                  ; Willy a Sinistra:
 602+ 7FB2 21 AB AC         ld   hl, Willy + (4 * 8)       ; Testa sinistra (tile 4, offset 32)
 603+ 7FB5 22 EC B8         ld   (willy_head_ptr), hl
 604+ 7FB8 3A D1 B2         ld   a, (body_state)           ; 0, 1, 2
 605+ 7FBB C6 05            add  a, 5                      ; tile 5, 6, 7
 606+ 7FBD 87               add  a, a
 606+ 7FBE 87             add a, a
 606+ 7FBF 87             add a, a ; * 8
 607+ 7FC0 5F               ld   e, a
 608+ 7FC1 16 00            ld   d, 0
 609+ 7FC3 21 8B AC         ld   hl, Willy
 610+ 7FC6 19               add  hl, de
 611+ 7FC7 22 EE B8         ld   (willy_body_ptr), hl      ; Corpo sinistro
 612+ 7FCA 18 18            jr   .willy_ptrs_ready
 613+ 7FCC
 614+ 7FCC              .willy_right:
 615+ 7FCC                  ; Willy a Destra:
 616+ 7FCC 21 8B AC         ld   hl, Willy + (0 * 8)       ; Testa destra (tile 0, offset 0)
 617+ 7FCF 22 EC B8         ld   (willy_head_ptr), hl
 618+ 7FD2 3A D1 B2         ld   a, (body_state)           ; 0, 1, 2
 619+ 7FD5 C6 01            add  a, 1                      ; tile 1, 2, 3
 620+ 7FD7 87               add  a, a
 620+ 7FD8 87             add a, a
 620+ 7FD9 87             add a, a ; * 8
 621+ 7FDA 5F               ld   e, a
 622+ 7FDB 16 00            ld   d, 0
 623+ 7FDD 21 8B AC         ld   hl, Willy
 624+ 7FE0 19               add  hl, de
 625+ 7FE1 22 EE B8         ld   (willy_body_ptr), hl      ; Corpo destro
 626+ 7FE4
 627+ 7FE4              .willy_ptrs_ready:
 628+ 7FE4 DD 21 47 7C      ld   ix, ActiveEnemies
 629+ 7FE8 06 08            ld   b, 8                      ; 8 slot
 630+ 7FEA
 631+ 7FEA              .enemy_loop:
 632+ 7FEA DD 7E 00         ld   a, (ix+0)
 633+ 7FED E6 80            and  $80                       ; Active?
 634+ 7FEF CA E9 80         jp   z, .next_enemy
 635+ 7FF2
 636+ 7FF2                  ; ---------------------------------------------------------------
 637+ 7FF2                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 638+ 7FF2                  ; ---------------------------------------------------------------
 639+ 7FF2                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 640+ 7FF2 3A CB B2         ld   a, (PlayerPos)            ; WillyX
 641+ 7FF5 DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 642+ 7FF8 FE 10            cp   16
 643+ 7FFA 38 05            jr   c, .x_in_range             ; 0..15 -> in range
 644+ 7FFC FE F9            cp   249                       ; 249..255 = -7..-1
 645+ 7FFE DA E9 80         jp   c, .next_enemy            ; 16..248 -> fuori range
 646+ 8001              .x_in_range:
 647+ 8001 32 F2 B8         ld   (collision_delta_x), a    ; Salva DeltaX (-7..15)
 648+ 8004
 649+ 8004                  ; Calcola DeltaY = WillyY - EnemyY (range valido [-15 .. 15])
 650+ 8004 3A CC B2         ld   a, (PlayerPos+1)          ; WillyY
 651+ 8007 DD 96 03         sub  (ix+3)                    ; A = WillyY - EnemyY
 652+ 800A FE 10            cp   16
 653+ 800C 38 05            jr   c, .y_in_range             ; 0..15 -> in range
 654+ 800E FE F1            cp   241                       ; 241..255 = -15..-1
 655+ 8010 DA E9 80         jp   c, .next_enemy            ; 16..240 -> fuori range
 656+ 8013              .y_in_range:
 657+ 8013 32 F3 B8         ld   (collision_delta_y), a    ; Salva DeltaY (-15..15)
 658+ 8016
 659+ 8016                  ; ---------------------------------------------------------------
 660+ 8016                  ; DETERMINA FRAME GRAFICO DEL GUARDIANO (32 byte)
 661+ 8016                  ; ---------------------------------------------------------------
 662+ 8016 C5               push bc                        ; Salva contatore nemici (B)
 663+ 8017
 664+ 8017                  ; Controlla se è guardiano verticale
 665+ 8017 DD 7E 00         ld   a, (ix+0)
 666+ 801A E6 40            and  $40                       ; Vertical?
 667+ 801C 20 15            jr   nz, .col_guard_vert
 668+ 801E
 669+ 801E DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 670+ 8021 E6 03            and  3
 671+ 8023 4F               ld   c, a
 672+ 8024
 673+ 8024 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 674+ 8027 FE 01            cp   1
 675+ 8029 28 03            jr   z, .guard_left_frame
 676+ 802B                  ; Frame Destra: Frame = Subframe (0..3)
 677+ 802B 79               ld   a, c
 678+ 802C 18 0A            jr   .calc_guard_ptr
 679+ 802E              .guard_left_frame:
 680+ 802E                  ; Frame Sinistra: Frame = 4 + Subframe (4..7)
 681+ 802E 3E 04            ld   a, 4
 682+ 8030 81               add  a, c
 683+ 8031 18 05            jr   .calc_guard_ptr
 684+ 8033
 685+ 8033              .col_guard_vert:
 686+ 8033                  ; Guardiano verticale: usa il frame salvato in (ix+1) (4..7)
 687+ 8033 DD 7E 01         ld   a, (ix+1)
 688+ 8036 E6 07            and  7
 689+ 8038
 690+ 8038              .calc_guard_ptr:
 691+ 8038                  ; Offset = Frame * 32
 692+ 8038 6F               ld   l, a
 693+ 8039 26 00            ld   h, 0
 694+ 803B 29               add  hl, hl                    ; *2
 695+ 803C 29               add  hl, hl                    ; *4
 696+ 803D 29               add  hl, hl                    ; *8
 697+ 803E 29               add  hl, hl                    ; *16
 698+ 803F 29               add  hl, hl                    ; *32
 699+ 8040 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 700+ 8043 19               add  hl, de
 701+ 8044 ED 5B 4C B6      ld   de, (room_ptr)
 702+ 8048 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame guardiano
 703+ 8049 22 F0 B8         ld   (guard_sprite_ptr), hl
 704+ 804C
 705+ 804C                  ; ---------------------------------------------------------------
 706+ 804C                  ; DETERMINA IL RANGE DELLE RIGHE SOVRAPPOSTE
 707+ 804C                  ; ---------------------------------------------------------------
 708+ 804C 3A F3 B8         ld   a, (collision_delta_y)
 709+ 804F CB 7F            bit  7, a                      ; DeltaY negativo? (Willy più in alto del nemico)
 710+ 8051 20 12            jr   nz, .willy_higher
 711+ 8053
 712+ 8053                  ; Willy lower or equal (DeltaY >= 0):
 713+ 8053                  ; row_enemy_cur = DeltaY, row_willy_cur = 0, num_lines = 16 - DeltaY
 714+ 8053 32 F4 B8         ld   (row_enemy_cur), a
 715+ 8056 AF               xor  a
 716+ 8057 32 F5 B8         ld   (row_willy_cur), a
 717+ 805A 3E 10            ld   a, 16
 718+ 805C 21 F3 B8         ld   hl, collision_delta_y
 719+ 805F 96               sub  (hl)
 720+ 8060 32 F6 B8         ld   (overlap_num_lines), a
 721+ 8063 18 12            jr   .check_lines_loop
 722+ 8065
 723+ 8065              .willy_higher:
 724+ 8065                  ; Willy higher (DeltaY < 0, cioè WillyY < EnemyY):
 725+ 8065 ED 44            neg                            ; A = -DeltaY (1..15)
 726+ 8067 32 F5 B8         ld   (row_willy_cur), a        ; row_willy_cur = -DeltaY
 727+ 806A AF               xor  a
 728+ 806B 32 F4 B8         ld   (row_enemy_cur), a        ; row_enemy_cur = 0
 729+ 806E 3E 10            ld   a, 16
 730+ 8070 21 F5 B8         ld   hl, row_willy_cur
 731+ 8073 96               sub  (hl)
 732+ 8074 32 F6 B8         ld   (overlap_num_lines), a
 733+ 8077
 734+ 8077              .check_lines_loop:
 735+ 8077                  ; ---------------------------------------------------------------
 736+ 8077                  ; CONFRONTO PIXEL-PERFECT RIGA PER RIGA
 737+ 8077                  ; ---------------------------------------------------------------
 738+ 8077 3A F6 B8         ld   a, (overlap_num_lines)
 739+ 807A 47               ld   b, a                      ; B = numero di scanlines da controllare
 740+ 807B
 741+ 807B              .scanline_loop:
 742+ 807B C5               push bc                        ; Salva contatore scanlines
 743+ 807C
 744+ 807C                  ; 1. Leggi i 2 byte della scanline corrente del guardiano
 745+ 807C 3A F4 B8         ld   a, (row_enemy_cur)
 746+ 807F 87               add  a, a                      ; row * 2
 747+ 8080 5F               ld   e, a
 748+ 8081 16 00            ld   d, 0
 749+ 8083 2A F0 B8         ld   hl, (guard_sprite_ptr)
 750+ 8086 19               add  hl, de                    ; HL = guard_sprite_ptr + row * 2
 751+ 8087 56               ld   d, (hl)                   ; D = Enemy Byte 0
 752+ 8088 23               inc  hl
 753+ 8089 5E               ld   e, (hl)                   ; E = Enemy Byte 1
 754+ 808A
 755+ 808A                  ; 2. Estrai la fetta di 8 pixel del guardiano allineata a DeltaX
 756+ 808A 3A F2 B8         ld   a, (collision_delta_x)
 757+ 808D CB 7F            bit  7, a
 758+ 808F 20 1D            jr   nz, .shift_neg_dx         ; DeltaX in [-7..-1]
 759+ 8091
 760+ 8091                  ; DeltaX >= 0:
 761+ 8091 FE 09            cp   9
 762+ 8093 30 0E            jr   nc, .shift_dx_gt_8        ; DeltaX in [9..15]
 763+ 8095
 764+ 8095                  ; DeltaX in [0..8]: shift a sinistra a 16 bit (D, E) per DeltaX volte
 765+ 8095 B7               or   a
 766+ 8096 28 08            jr   z, .slice_ready_in_d      ; DeltaX == 0 -> fetta già allineata in D
 767+ 8098 4F               ld   c, a                      ; C = DeltaX (1..8)
 768+ 8099              .shift_left_16bit:
 769+ 8099 CB 23            sla  e
 770+ 809B CB 12            rl   d
 771+ 809D 0D               dec  c
 772+ 809E 20 F9            jr   nz, .shift_left_16bit
 773+ 80A0              .slice_ready_in_d:
 774+ 80A0 7A               ld   a, d                      ; A = fetta guardiano allineata
 775+ 80A1 18 14            jr   .test_willy_line
 776+ 80A3
 777+ 80A3              .shift_dx_gt_8:
 778+ 80A3                  ; DeltaX in [9..15]: shift a sinistra del solo byte E per (DeltaX - 8) volte
 779+ 80A3 D6 08            sub  8
 780+ 80A5 4F               ld   c, a                      ; C = DeltaX - 8 (1..7)
 781+ 80A6              .shift_left_e_only:
 782+ 80A6 CB 23            sla  e
 783+ 80A8 0D               dec  c
 784+ 80A9 20 FB            jr   nz, .shift_left_e_only
 785+ 80AB 7B               ld   a, e                      ; A = fetta guardiano allineata
 786+ 80AC 18 09            jr   .test_willy_line
 787+ 80AE
 788+ 80AE              .shift_neg_dx:
 789+ 80AE                  ; DeltaX in [-7..-1]: shift a destra del solo byte D per (-DeltaX) volte
 790+ 80AE ED 44            neg
 791+ 80B0 4F               ld   c, a                      ; C = -DeltaX (1..7)
 792+ 80B1              .shift_right_d_only:
 793+ 80B1 CB 3A            srl  d
 794+ 80B3 0D               dec  c
 795+ 80B4 20 FB            jr   nz, .shift_right_d_only
 796+ 80B6 7A               ld   a, d                      ; A = fetta guardiano allineata
 797+ 80B7
 798+ 80B7              .test_willy_line:
 799+ 80B7                  ; Se la fetta del guardiano non ha pixel attivi su questa scanline, passa alla prossima
 800+ 80B7 B7               or   a
 801+ 80B8 28 21            jr   z, .next_scanline
 802+ 80BA
 803+ 80BA                  ; 3. Leggi il byte corrispondente dello sprite di Willy
 804+ 80BA 4F               ld   c, a                      ; C = fetta guardiano
 805+ 80BB 3A F5 B8         ld   a, (row_willy_cur)
 806+ 80BE FE 08            cp   8
 807+ 80C0 38 0D            jr   c, .read_willy_head
 808+ 80C2
 809+ 80C2                  ; Riga corpo (8..15)
 810+ 80C2 D6 08            sub  8
 811+ 80C4 6F               ld   l, a
 812+ 80C5 26 00            ld   h, 0
 813+ 80C7 ED 5B EE B8      ld   de, (willy_body_ptr)
 814+ 80CB 19               add  hl, de
 815+ 80CC 7E               ld   a, (hl)                   ; A = byte corpo Willy
 816+ 80CD 18 09            jr   .do_pixel_and
 817+ 80CF
 818+ 80CF              .read_willy_head:
 819+ 80CF                  ; Riga testa (0..7)
 820+ 80CF 6F               ld   l, a
 821+ 80D0 26 00            ld   h, 0
 822+ 80D2 ED 5B EC B8      ld   de, (willy_head_ptr)
 823+ 80D6 19               add  hl, de
 824+ 80D7 7E               ld   a, (hl)                   ; A = byte testa Willy
 825+ 80D8
 826+ 80D8              .do_pixel_and:
 827+ 80D8                  ; 4. TEST BIT A BIT: (Pixel_Willy AND Pixel_Guardiano)
 828+ 80D8 A1               and  c
 829+ 80D9 20 1E            jr   nz, .pixel_collision_detected ; Se != 0, COLLISIONE PIXEL-PERFECT!
 830+ 80DB
 831+ 80DB              .next_scanline:
 832+ 80DB                  ; Avanza alla prossima riga
 833+ 80DB 21 F4 B8         ld   hl, row_enemy_cur
 834+ 80DE 34               inc  (hl)
 835+ 80DF 21 F5 B8         ld   hl, row_willy_cur

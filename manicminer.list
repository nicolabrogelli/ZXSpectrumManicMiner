 649+ 87C8 CE 00            adc  a, 0
 650+ 87CA 27               daa
 651+ 87CB 32 05 F1         ld   (player_score + 1), a
 652+ 87CE
 653+ 87CE                  ; Riporto al byte 2 (decine / centinaia di migliaia)
 654+ 87CE 3A 06 F1         ld   a, (player_score + 2)
 655+ 87D1 CE 00            adc  a, 0

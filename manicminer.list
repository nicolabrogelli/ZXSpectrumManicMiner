 710+ 87C8              Score_CheckAndUpdateHighScore:
 711+ 87C8                  ; Confronto BCD a 3 byte (big-endian: byte 2 -> byte 1 -> byte 0)
 712+ 87C8                  ; Byte 2:
 713+ 87C8 3A CB F0         ld   a, (player_score + 2)
 714+ 87CB 47               ld   b, a
 715+ 87CC 3A CE F0         ld   a, (high_score + 2)
 716+ 87CF B8               cp   b
 717+ 87D0 38 18            jr   c, .new_high_score    ; se high_score+2 < player_score+2 -> nuovo high score
 718+ 87D2 20 28            jr   nz, .done_check       ; se high_score+2 > player_score+2 -> nessun aggiornamento
 719+ 87D4
 720+ 87D4                  ; Byte 1:
 721+ 87D4 3A CA F0         ld   a, (player_score + 1)
 722+ 87D7 47               ld   b, a
 723+ 87D8 3A CD F0         ld   a, (high_score + 1)
 724+ 87DB B8               cp   b
 725+ 87DC 38 0C            jr   c, .new_high_score
 726+ 87DE 20 1C            jr   nz, .done_check
 727+ 87E0
 728+ 87E0                  ; Byte 0:
 729+ 87E0 3A C9 F0         ld   a, (player_score + 0)
 730+ 87E3 47               ld   b, a
 731+ 87E4 3A CC F0         ld   a, (high_score + 0)
 732+ 87E7 B8               cp   b
 733+ 87E8 30 12            jr   nc, .done_check       ; se high_score+0 >= player_score+0 -> nessun aggiornamento

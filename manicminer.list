1367+ 7A72                  ; Controlla se DE (Location) è 0 o Length è 0
1368+ 7A72 7A               ld   a, d
1369+ 7A73 B3               or   e
1370+ 7A74 CA 7B 7B         jp   z, .no_ramp_change
1371+ 7A77 3A 59 EE         ld   a, (ramp_len)
1372+ 7A7A B7               or   a
1373+ 7A7B CA 7B 7B         jp   z, .no_ramp_change
1374+ 7A7E
1375+ 7A7E                  ; Calcola Row e Col: Offset = DE - 24064
1376+ 7A7E 21 00 A2         ld   hl, -24064
1377+ 7A81 19               add  hl, de            ; HL = Offset
1378+ 7A82 54               ld   d, h
1379+ 7A83 5D               ld   e, l
1380+ 7A84
1381+ 7A84 7B               ld   a, e
1382+ 7A85 E6 1F            and  31
1383+ 7A87 32 5B EE         ld   (ramp_col), a     ; Col Start
1384+ 7A8A
1385+ 7A8A CB 3C            srl  h
1385+ 7A8C CB 1D          rr l
1386+ 7A8E CB 3C            srl  h
1386+ 7A90 CB 1D          rr l
1387+ 7A92 CB 3C            srl  h
1387+ 7A94 CB 1D          rr l
1388+ 7A96 CB 3C            srl  h
1388+ 7A98 CB 1D          rr l
1389+ 7A9A CB 3C            srl  h
1389+ 7A9C CB 1D          rr l
1390+ 7A9E 7D               ld   a, l
1391+ 7A9F 32 5A EE         ld   (ramp_row), a     ; Row Start
1392+ 7AA2
1393+ 7AA2 C1               pop  bc                ; BC ha C = PlayerX, B = PlayerY
1394+ 7AA3 C5               push bc
1395+ 7AA4
1396+ 7AA4                  ; Calcola ramp_Y per PlayerX (in C) nella nuova stanza
1397+ 7AA4 CD 7F 7B         call GetRampY          ; Output: Carry SET se X è nel range rampa, A = ramp_Y
1398+ 7AA7 38 6C            jr   c, .on_ramp_x_ok
1399+ 7AA9
1400+ 7AA9                  ; PlayerX (in C) è fuori dal range orizzontale della rampa.
1401+ 7AA9                  ; Verifichiamo se C è vicino all'estremità della rampa (tolleranza 16 pixel).
1402+ 7AA9 3A 58 EE         ld   a, (ramp_dir)
1403+ 7AAC B7               or   a
1404+ 7AAD 28 2C            jr   z, .prox_dir_left
1405+ 7AAF
1406+ 7AAF              .prox_dir_right:

 565+ 86CC 20 05            jr   nz, .no_dec_room
 566+ 86CE                  ; Ultimo item della stanza raccolto -> Attiva il portale!
 567+ 86CE 3E 01            ld   a, 1
 568+ 86D0 32 60 F0         ld   (game_objective_completed), a
 569+ 86D3              .no_dec_room:

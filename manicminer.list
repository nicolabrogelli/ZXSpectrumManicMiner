 652+ 608D CD 86 6B         call Gfx_RestoreEnemyColorAttributes ; Ripristina sfondo
 653+ 6090
 654+ 6090              .redraw_overlay_only:
 655+ 6090                  ; Durante il timer di sicurezza, fa lampeggiare lo sprite
 656+ 6090 3A 7B 93         ld   a, (willy_safety_timer)
 657+ 6093 B7               or   a
 658+ 6094 28 07            jr   z, .do_print

 641  86C4
 642  86C4              ; -------------------------------------------------------------------
 643  86C4              ; CheckPortalTransition
 644  86C4              ; Verifica le condizioni per accedere alla stanza successiva:
 645  86C4              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 646  86C4              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 647  86C4              ;
 648  86C4              ; Output:
 649  86C4              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 650  86C4              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 651  86C4              ; -------------------------------------------------------------------
 652  86C4              CheckPortalTransition:
 653  86C4 C5               push bc
 654  86C5 D5               push de
 655  86C6 E5               push hl
 656  86C7
 657  86C7                  ; 1. Tutti gli item della stanza sono stati raccolti?
 658  86C7 CD 55 87         call CheckAllItemsCollected
 659  86CA 30 4D            jr   nc, .no_transition
 660  86CC
 661  86CC                  ; 2. Willy collide con il portale (16x16 pixel)?
 662  86CC                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 663  86CC                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 664  86CC 2A E7 99         ld   hl, (room_ptr)
 665  86CF 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 666  86D2 19               add  hl, de
 667  86D3 4E               ld   c, (hl)
 668  86D4 23               inc  hl
 669  86D5 46               ld   b, (hl)                   ; BC = AttrAddr
 670  86D6
 671  86D6                  ; Offset = BC - 23552
 672  86D6 60               ld   h, b
 673  86D7 69               ld   l, c
 674  86D8 01 00 A4         ld   bc, -23552
 675  86DB 09               add  hl, bc
 676  86DC
 677  86DC                  ; PortalX = (Offset & 31) * 8
 678  86DC 7D               ld   a, l
 679  86DD E6 1F            and  31
 680  86DF 87               add  a, a
 680  86E0 87             add a, a
 680  86E1 87             add a, a
 681  86E2 5F               ld   e, a                      ; E = PortalX (0..248)
 682  86E3
 683  86E3                  ; PortalY = (Offset / 32) * 8
 684  86E3 CB 3C            srl  h
 684  86E5 CB 1D          rr l
 685  86E7 CB 3C            srl  h
 685  86E9 CB 1D          rr l
 686  86EB CB 3C            srl  h
 686  86ED CB 1D          rr l
 687  86EF CB 3C            srl  h
 687  86F1 CB 1D          rr l
 688  86F3 CB 3C            srl  h
 688  86F5 CB 1D          rr l

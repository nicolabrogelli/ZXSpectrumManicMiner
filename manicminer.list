 372+ 6FFA 7E               ld   a, (hl)
 373+ 6FFB
 374+ 6FFB 67               ld   h, a
 375+ 6FFC 69               ld   l, c
 376+ 6FFD 01 00 A4         ld   bc, -23552
 377+ 7000 09               add  hl, bc
 378+ 7001 7D               ld   a, l

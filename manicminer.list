 728  82A5              ; -------------------------------------------------------------------
 729  82A5              CheckInMasterBedroom:
 730  82A5 37               scf
 731  82A6 C9               ret
 732  82A7
 733  82A7              ; -------------------------------------------------------------------
 734  82A7              ; CheckWillyConveyorCollision
 735  82A7              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 736  82A7              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 737  82A7              ; -------------------------------------------------------------------
 738  82A7              CheckWillyConveyorCollision:
 739  82A7 C5               push bc
 740  82A8 D5               push de
 741  82A9 E5               push hl
 742  82AA
 743  82AA                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 744  82AA CD D0 73         call CheckWillyOnConveyor
 745  82AD 38 49            jr   c, .collision_detected
 746  82AF
 747  82AF                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 748  82AF 3A CF 90         ld   a, (conveyor_len)
 749  82B2 B7               or   a
 750  82B3 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 751  82B5
 752  82B5                  ; B = WillyY, C = WillyX
 753  82B5 ED 4B A7 8D      ld   bc, (PlayerPos)
 754  82B9
 755  82B9                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 756  82B9 3A D0 90         ld   a, (conveyor_row)
 757  82BC 87               add  a, a                  ; *2
 758  82BD 87               add  a, a                  ; *4
 759  82BE 87               add  a, a                  ; *8
 760  82BF 5F               ld   e, a                  ; E = ConveyorTop
 761  82C0 C6 07            add  a, 7
 762  82C2 57               ld   d, a                  ; D = ConveyorBottom
 763  82C3
 764  82C3                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 765  82C3 78               ld   a, b                  ; WillyTop
 766  82C4 BA               cp   d
 767  82C5 28 04            jr   z, .y_overlap
 768  82C7 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 769  82C9 18 32            jr   .no_conv_collision
 770  82CB
 771  82CB              .y_overlap:
 772  82CB C6 0F            add  a, 15                 ; WillyBottom
 773  82CD BB               cp   e
 774  82CE 28 04            jr   z, .x_check
 775  82D0 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 776  82D2 18 29            jr   .no_conv_collision
 777  82D4
 778  82D4              .x_check:
 779  82D4                  ; ConveyorLeft = conveyor_col * 8
 780  82D4 3A D1 90         ld   a, (conveyor_col)
 781  82D7 87               add  a, a                  ; *2
 782  82D8 87               add  a, a                  ; *4
 783  82D9 87               add  a, a                  ; *8
 784  82DA 5F               ld   e, a                  ; E = ConveyorLeft
 785  82DB
 786  82DB                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 787  82DB 21 CF 90         ld   hl, conveyor_len
 788  82DE 3A D1 90         ld   a, (conveyor_col)
 789  82E1 86               add  a, (hl)
 790  82E2 87               add  a, a                  ; *2
 791  82E3 87               add  a, a                  ; *4
 792  82E4 87               add  a, a                  ; *8
 793  82E5 3D               dec  a                     ; ConveyorRight
 794  82E6 57               ld   d, a                  ; D = ConveyorRight
 795  82E7
 796  82E7                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 797  82E7 79               ld   a, c                  ; WillyLeft
 798  82E8 BA               cp   d
 799  82E9 28 04            jr   z, .x_overlap
 800  82EB 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 801  82ED 18 0E            jr   .no_conv_collision
 802  82EF
 803  82EF              .x_overlap:
 804  82EF C6 0F            add  a, 15                 ; WillyRight
 805  82F1 BB               cp   e
 806  82F2 28 04            jr   z, .collision_detected
 807  82F4 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 808  82F6 18 05            jr   .no_conv_collision
 809  82F8
 810  82F8              .collision_detected:
 811  82F8 E1               pop  hl
 812  82F9 D1               pop  de
 813  82FA C1               pop  bc
 814  82FB 37               scf
 815  82FC C9               ret
 816  82FD
 817  82FD              .no_conv_collision:
 818  82FD E1               pop  hl
 819  82FE D1               pop  de
 820  82FF C1               pop  bc
 821  8300 B7               or   a
 822  8301 C9               ret
 823  8302

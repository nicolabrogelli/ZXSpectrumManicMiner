1187+ 647D 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)
1188+ 6480 DD 21 50 6B      ld   ix, BotteSprite       ; Frame 1 di BotteSprite
1189+ 6484 CD 38 5F         call Gfx_DrawPixelSprite16x16
1190+ 6487

 313+ 6FE0              ; LoadPositionPlayeinRoom
 314+ 6FE0              ;
 315+ 6FE0              ; Inizializza la posizione del player (Willy) quando entra
 316+ 6FE0              ; in una nuova stanza.
 317+ 6FE0              ;
 318+ 6FE0              ; La posizione viene letta direttamente dai dati della stanza
 319+ 6FE0              ; (layout/metadata) a partire da room_ptr.
 320+ 6FE0              ;
 321+ 6FE0              ; Output:
 322+ 6FE0              ;   PlayerPos     = posizione iniziale (Y, X)
 323+ 6FE0              ;   PlayerPosOld  = copia della posizione iniziale
 324+ 6FE0              ;
 325+ 6FE0              ; Struttura dati stanza:
 326+ 6FE0              ;   OFFSET_POS_WILLY:
 327+ 6FE0              ;       +0 = X
 328+ 6FE0              ;       +1 = Y
 329+ 6FE0              ; -------------------------------------------------------------------
 330+ 6FE0              LoadPositionPlayeinRoom:
 331+ 6FE0                  ; ---------------------------------------------------------------
 332+ 6FE0                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 333+ 6FE0                  ; ---------------------------------------------------------------
 334+ 6FE0 2A 85 A1         ld   hl, (room_ptr)
 335+ 6FE3 11 68 02         ld   de, OFFSET_POS_WILLY
 336+ 6FE6 19               add  hl, de
 337+ 6FE7
 338+ 6FE7                  ; Byte 0: Y * 2
 339+ 6FE7 7E               ld   a, (hl)
 340+ 6FE8 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 341+ 6FEA 57               ld   d, a                      ; D = PlayerY
 342+ 6FEB
 343+ 6FEB                  ; Byte 1: Anim frame
 344+ 6FEB 23               inc  hl
 345+ 6FEC 7E               ld   a, (hl)
 346+ 6FED E6 03            and  3                         ; Garanzia valore valido (0..3)
 347+ 6FEF FE 03            cp   3
 348+ 6FF1 38 01            jr   c, .valid_anim
 349+ 6FF3 AF               xor  a
 350+ 6FF4              .valid_anim:
 351+ 6FF4 32 0A 9E         ld   (body_state), a
 352+ 6FF7 32 0D A2         ld   (player_old_body), a
 353+ 6FFA
 354+ 6FFA                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 355+ 6FFA 23               inc  hl                        ; Byte 2 (Direction)
 356+ 6FFB 7E               ld   a, (hl)
 357+ 6FFC E6 01            and  1
 358+ 6FFE 28 04            jr   z, .facing_right
 359+ 7000 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 360+ 7002 18 02            jr   .set_dir

   3+ 8050              ;
   4+ 8050              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 8050              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 8050              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 8050              ;===========================================================================
   8+ 8050
   9+ 8050              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 8050
  11+ 8050              ; -------------------------------------------------------------------
  12+ 8050              ; DetermineCurrentRoomID
  13+ 8050              ;
  14+ 8050              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 8050              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 8050              ;
  17+ 8050              ; Output:
  18+ 8050              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 8050              ;   (current_room) = A
  20+ 8050              ; -------------------------------------------------------------------
  21+ 8050              DetermineCurrentRoomID:
  22+ 8050 E5               push hl
  23+ 8051 D5               push de
  24+ 8052 C5               push bc
  25+ 8053
  26+ 8053 21 36 73         ld   hl, RoomsListTable
  27+ 8056 ED 5B CF A1      ld   de, (room_ptr)
  28+ 805A 06 04            ld   b, NUM_ROOMS
  29+ 805C 0E 00            ld   c, 0
  30+ 805E
  31+ 805E              .loop:
  32+ 805E 7E               ld   a, (hl)
  33+ 805F BB               cp   e
  34+ 8060 20 06            jr   nz, .no_match
  35+ 8062 23               inc  hl
  36+ 8063 7E               ld   a, (hl)
  37+ 8064 BA               cp   d
  38+ 8065 28 08            jr   z, .found
  39+ 8067 2B               dec  hl
  40+ 8068
  41+ 8068              .no_match:
  42+ 8068 23               inc  hl
  43+ 8069 23               inc  hl
  44+ 806A 0C               inc  c
  45+ 806B 10 F1            djnz .loop
  46+ 806D
  47+ 806D 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 806F
  49+ 806F              .found:
  50+ 806F 79               ld   a, c
  51+ 8070 32 74 A1         ld   (current_room), a
  52+ 8073
  53+ 8073 C1               pop  bc
  54+ 8074 D1               pop  de
  55+ 8075 E1               pop  hl
  56+ 8076 C9               ret

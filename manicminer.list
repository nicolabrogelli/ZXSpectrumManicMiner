 906+ 8257 CA 7A 83         jp   z, .next_enemy
 907+ 825A
 908+ 825A                  ; ---------------------------------------------------------------
 909+ 825A                  ; PRE-FILTRO BOUNDING BOX RAPIDO:
 910+ 825A                  ; ---------------------------------------------------------------
 911+ 825A                  ; Calcola DeltaX = WillyX - EnemyX (range valido [-7 .. 15])
 912+ 825A 3A 24 EA         ld   a, (PlayerPos)            ; WillyX
 913+ 825D DD 96 02         sub  (ix+2)                    ; A = WillyX - EnemyX
 914+ 8260 FE 10            cp   16

 315+ 7AF7              ; -------------------------------------------------------------------
 316+ 7AF7              ; Enemy_DrawSingleSlot
 317+ 7AF7              ;
 318+ 7AF7              ; Disegna un singolo guardiano 16x16 pixel specificato da IX.
 319+ 7AF7              ; La grafica (8 frame da 32 byte) è letta direttamente da
 320+ 7AF7              ; room_ptr + OFFSET_GUARDIAN_GRAPHICS.
 321+ 7AF7              ; -------------------------------------------------------------------
 322+ 7AF7              Enemy_DrawSingleSlot:
 323+ 7AF7 C5               push bc
 324+ 7AF8 D5               push de
 325+ 7AF9 E5               push hl
 326+ 7AFA DD E5            push ix
 327+ 7AFC
 328+ 7AFC                  ; 1. Determina il frame di animazione (0..7)
 329+ 7AFC                  ; Nei dati di Manic Miner:
 330+ 7AFC                  ;   Frame 0..3 = Movimento verso DESTRA
 331+ 7AFC                  ;   Frame 4..7 = Movimento verso SINISTRA
 332+ 7AFC DD 7E 07         ld   a, (ix+7)                 ; Anim subframe (0..3)
 333+ 7AFF E6 03            and  3
 334+ 7B01 47               ld   b, a                      ; B = Anim subframe
 335+ 7B02
 336+ 7B02 DD 7E 06         ld   a, (ix+6)                 ; Direction (1 = Left, 2 = Right)
 337+ 7B05 FE 01            cp   1                         ; Sinistra?
 338+ 7B07 28 03            jr   z, .left_frames
 339+ 7B09
 340+ 7B09                  ; Movimento a Destra: Frame 0..3
 341+ 7B09 78               ld   a, b
 342+ 7B0A 18 03            jr   .got_frame_idx
 343+ 7B0C
 344+ 7B0C              .left_frames:
 345+ 7B0C                  ; Movimento a Sinistra: Frame 4..7
 346+ 7B0C 3E 04            ld   a, 4
 347+ 7B0E 80               add  a, b
 348+ 7B0F
 349+ 7B0F              .got_frame_idx:
 350+ 7B0F                  ; Frame index in A (0..7). Calcola Offset = Frame * 32
 351+ 7B0F 6F               ld   l, a
 352+ 7B10 26 00            ld   h, 0
 353+ 7B12 29               add  hl, hl                    ; *2
 354+ 7B13 29               add  hl, hl                    ; *4
 355+ 7B14 29               add  hl, hl                    ; *8
 356+ 7B15 29               add  hl, hl                    ; *16
 357+ 7B16 29               add  hl, hl                    ; *32
 358+ 7B17
 359+ 7B17 11 00 03         ld   de, OFFSET_GUARDIAN_GRAPHICS
 360+ 7B1A 19               add  hl, de
 361+ 7B1B ED 5B 27 91      ld   de, (room_ptr)
 362+ 7B1F 19               add  hl, de                    ; HL = puntatore ai 32 byte del frame bitmap
 363+ 7B20 E5               push hl
 364+ 7B21 DD E1            pop  ix                        ; IX = frame bitmap pointer
 365+ 7B23
 366+ 7B23                  ; 2. Coordinate e colore
 367+ 7B23 FD E1            pop  iy                        ; IY = ActiveEnemies slot
 368+ 7B25 FD E5            push iy
 369+ 7B27
 370+ 7B27 FD 4E 02         ld   c, (iy+2)                 ; C = Current X
 371+ 7B2A FD 46 03         ld   b, (iy+3)                 ; B = Current Y
 372+ 7B2D FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 373+ 7B30
 374+ 7B30                  ; 3. Disegna sprite 16x16 e imposta attributi colore
 375+ 7B30 CD 38 5F         call Gfx_DrawPixelSprite16x16
 376+ 7B33 FD 7E 0A         ld   a, (iy+10)                ; A = Color Attributo
 377+ 7B36 CD CE 69         call Gfx_SetEnemyColorAttributes

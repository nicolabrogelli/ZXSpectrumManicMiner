 497+ 5FBA              ; -------------------------------------------------------------------
 498+ 5FBA              ; Disegna il player (testa e corpo se Willy, oppure MaialeSprite se in TheNightmareRoom)
 499+ 5FBA              ; -------------------------------------------------------------------
 500+ 5FBA              Gfx_PrintPlayer:
 501+ 5FBA DD E5            push ix
 502+ 5FBC D5               push de
 503+ 5FBD E5               push hl
 504+ 5FBE C5               push bc
 505+ 5FBF
 506+ 5FBF                  ; --- RENDERING STANDARD WILLY ---
 507+ 5FBF                  ; 1. Determina sprite per la testa (sinistra o destra)
 508+ 5FBF 3A F3 8D         ld   a, (direction)
 509+ 5FC2 FE 01            cp   1                 ; Sinistra?
 510+ 5FC4 20 06            jr   nz, .right_head
 511+ 5FC6
 512+ 5FC6 DD 21 CC 87      ld   ix, Willy + (4 * 8) ; 5° tile (HEAD_GRAPH_LEFT)
 513+ 5FCA 18 04            jr   .draw_head
 514+ 5FCC
 515+ 5FCC              .right_head:
 516+ 5FCC DD 21 AC 87      ld   ix, Willy + (0 * 8) ; 1° tile (HEAD_GRAPH_RIGHT)
 517+ 5FD0
 518+ 5FD0              .draw_head:
 519+ 5FD0 ED 4B EC 8D      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 520+ 5FD4 CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna testa
 521+ 5FD7
 522+ 5FD7                  ; 2. Determina sprite per il corpo (sinistra o destra con frame animazione)
 523+ 5FD7 3A F3 8D         ld   a, (direction)
 524+ 5FDA FE 01            cp   1                 ; Sinistra?
 525+ 5FDC 20 13            jr   nz, .right_body
 526+ 5FDE
 527+ 5FDE                  ; Corpo a sinistra
 528+ 5FDE 3A F2 8D         ld   a, (body_state)   ; 0, 1, 2
 529+ 5FE1 C6 05            add  a, 5              ; offset del tile per il corpo sinistro (5, 6, 7)
 530+ 5FE3 87               add  a, a              ; *2
 531+ 5FE4 87               add  a, a              ; *4
 532+ 5FE5 87               add  a, a              ; *8
 533+ 5FE6 5F               ld   e, a
 534+ 5FE7 16 00            ld   d, 0
 535+ 5FE9 DD 21 AC 87      ld   ix, Willy
 536+ 5FED DD 19            add  ix, de
 537+ 5FEF 18 11            jr   .draw_body
 538+ 5FF1
 539+ 5FF1              .right_body:
 540+ 5FF1                  ; Corpo a destra
 541+ 5FF1 3A F2 8D         ld   a, (body_state)   ; 0, 1, 2
 542+ 5FF4 C6 01            add  a, 1              ; offset del tile per il corpo destro (1, 2, 3)
 543+ 5FF6 87               add  a, a              ; *2
 544+ 5FF7 87               add  a, a              ; *4
 545+ 5FF8 87               add  a, a              ; *8
 546+ 5FF9 5F               ld   e, a
 547+ 5FFA 16 00            ld   d, 0
 548+ 5FFC DD 21 AC 87      ld   ix, Willy
 549+ 6000 DD 19            add  ix, de
 550+ 6002
 551+ 6002              .draw_body:
 552+ 6002 ED 4B EC 8D      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 553+ 6006 78               ld   a, b
 554+ 6007 C6 08            add  a, 8
 555+ 6009 47               ld   b, a              ; B = PlayerY + 8
 556+ 600A CD 3F 5E         call Gfx_DrawPixelSprite8x8 ; Disegna corpo
 557+ 600D
 558+ 600D                  ; 3. Imposta gli attributi colore di Willy (Bianco Brillante)
 559+ 600D ED 4B EC 8D      ld   bc, (PlayerPos)   ; C = PlayerX, B = PlayerY
 560+ 6011 3E 47            ld   a, WHITE | $40    ; Bianco Brillante
 561+ 6013 CD AF 6A         call Gfx_SetEnemyColorAttributes

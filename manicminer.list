 412+ 6FF0 32 D4 B2         ld   (collision_active), a
 413+ 6FF3 32 D7 B6         ld   (willy_needs_redraw), a
 414+ 6FF6 32 E1 B2         ld   (current_input_dir), a
 415+ 6FF9 32 F6 B5         ld   (conveyor_caught), a
 416+ 6FFC 3E FF            ld   a, $FF

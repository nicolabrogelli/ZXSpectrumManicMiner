 624+ 7FEA C6 05            add  a, 5                      ; tile 5, 6, 7
 625+ 7FEC 87               add  a, a
 625+ 7FED 87             add a, a
 625+ 7FEE 87             add a, a ; * 8
 626+ 7FEF 5F               ld   e, a
 627+ 7FF0 16 00            ld   d, 0
 628+ 7FF2 21 C9 D8         ld   hl, Willy
 629+ 7FF5 19               add  hl, de

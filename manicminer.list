  83+ A40F
  84+ A40F              ; Gestione Punteggio (Score & High score - 3 byte BCD ciascuno: 6 cifre decimali)
  85+ A40F 00 00 00     player_score:               db 0, 0, 0 ; Punteggio partita corrente (inizia a 000000)
  86+ A412 00 00 00     high_score:                 db 0, 0, 0 ; Punteggio record (mantenuto tra le partite)
  87+ A415 00           game_objective_completed:   db 0       ; 1 = Obiettivo completato (portale attivo), 0 = Non completato
  88+ A416 00           portal_anim_timer:          db 0       ; Timer velocità lampeggio portale attivo
  89+ A417 00           portal_anim_frame:          db 0       ; Frame ciclo colori portale attivo (0..7)
  90+ A418 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  91+ A419
  92+ A419 12           Audio_jump_sound_note:    db 18   ; 18 = inactive (0..17 are active notes)
  93+ A41A 00           Audio_jump_sound_timer:   db 0

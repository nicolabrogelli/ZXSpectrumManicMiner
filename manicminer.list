  72+ 88E4 ~            ; Audio_UpdateMusic
  73+ 88E4 ~            ;
  74+ 88E4 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 88E4 ~            ; Viene chiamata a ogni frame.
  76+ 88E4 ~            ; -------------------------------------------------------------------
  77+ 88E4 ~            Audio_UpdateMusic:
  78+ 88E4 ~                push af
  79+ 88E4 ~                push bc
  80+ 88E4 ~                push de
  81+ 88E4 ~                push hl
  82+ 88E4 ~
  83+ 88E4 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 88E4 ~                ld   a, (Audio_jump_sound_note)
  85+ 88E4 ~                cp   18
  86+ 88E4 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 88E4 ~
  88+ 88E4 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 88E4 ~                ld   a, (Audio_music_frame_counter)
  90+ 88E4 ~                dec  a
  91+ 88E4 ~                ld   (Audio_music_frame_counter), a
  92+ 88E4 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 88E4 ~
  94+ 88E4 ~                ; Altrimenti carica la nota successiva
  95+ 88E4 ~                ld   a, (Audio_music_note_idx)
  96+ 88E4 ~                inc  a
  97+ 88E4 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 88E4 ~                jr   c, .no_wrap
  99+ 88E4 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 88E4 ~            .no_wrap:
 101+ 88E4 ~                ld   (Audio_music_note_idx), a
 102+ 88E4 ~
 103+ 88E4 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 88E4 ~                ld   e, a
 105+ 88E4 ~                ld   d, 0
 106+ 88E4 ~                ld   hl, Audio_MusicSheet
 107+ 88E4 ~                add  hl, de
 108+ 88E4 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 88E4 ~
 110+ 88E4 ~                ; Leggi durata (secondo byte)
 111+ 88E4 ~                inc  hl
 112+ 88E4 ~                ld   a, (hl)
 113+ 88E4 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 88E4 ~                jr   nz, .dur_ok
 115+ 88E4 ~                ld   a, 1
 116+ 88E4 ~            .dur_ok:
 117+ 88E4 ~                ld   (Audio_music_frame_counter), a
 118+ 88E4 ~
 119+ 88E4 ~            .play_current_note:
 120+ 88E4 ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 88E4 ~                ld   a, (Audio_music_note_idx)
 122+ 88E4 ~                ld   e, a
 123+ 88E4 ~                ld   d, 0
 124+ 88E4 ~                ld   hl, Audio_MusicSheet
 125+ 88E4 ~                add  hl, de
 126+ 88E4 ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 88E4 ~                ld   a, (hl)                  ; A = delay
 128+ 88E4 ~                or   a
 129+ 88E4 ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 88E4 ~
 131+ 88E4 ~                ; Suona la nota: 2 cicli
 132+ 88E4 ~                ld   d, a                     ; D = delay
 133+ 88E4 ~                ld   b, 2                     ; 2 cicli per frame
 134+ 88E4 ~            .note_loop:
 135+ 88E4 ~                ; Speaker ON
 136+ 88E4 ~                ld   a, (room_border_color)
 137+ 88E4 ~                or   $10
 138+ 88E4 ~                out  ($fe), a
 139+ 88E4 ~                ld   c, d
 140+ 88E4 ~            .d1:
 141+ 88E4 ~                push af
 142+ 88E4 ~                pop  af
 143+ 88E4 ~                dec  c
 144+ 88E4 ~                jr   nz, .d1
 145+ 88E4 ~
 146+ 88E4 ~                ; Speaker OFF
 147+ 88E4 ~                ld   a, (room_border_color)
 148+ 88E4 ~                and  $ef
 149+ 88E4 ~                out  ($fe), a
 150+ 88E4 ~                ld   c, d
 151+ 88E4 ~            .d2:
 152+ 88E4 ~                push af
 153+ 88E4 ~                pop  af
 154+ 88E4 ~                dec  c
 155+ 88E4 ~                jr   nz, .d2
 156+ 88E4 ~
 157+ 88E4 ~                djnz .note_loop
 158+ 88E4 ~
 159+ 88E4 ~            .done:
 160+ 88E4 ~                pop  hl
 161+ 88E4 ~                pop  de
 162+ 88E4 ~                pop  bc
 163+ 88E4 ~                pop  af
 164+ 88E4 ~                ret
 165+ 88E4 ~
 166+ 88E4 ~            Audio_MusicSheet:
 167+ 88E4 ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 88E4 ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 88E4 ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 88E4 ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 88E4 ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 88E4 ~                db 90, 10, 107, 20, 68, 65
 173+ 88E4                  ELSE
 174+ 88E4              Audio_UpdateMusic:
 175+ 88E4 C9               ret
 176+ 88E5                  ENDIF

 362+ 7D9D              ; CheckWillyItemCollision
 363+ 7D9D              ;
 364+ 7D9D              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 365+ 7D9D              ; Input:
 366+ 7D9D              ;   A = Item Col (0..31)
 367+ 7D9D              ;   H = Item Row (0..15)
 368+ 7D9D              ; Output:
 369+ 7D9D              ;   Carry Set = Collisione
 370+ 7D9D              ;   Carry Clear = Nessuna collisione
 371+ 7D9D              ; -------------------------------------------------------------------
 372+ 7D9D              CheckWillyItemCollision:
 373+ 7D9D C5               push bc
 374+ 7D9E D5               push de
 375+ 7D9F E5               push hl
 376+ 7DA0
 377+ 7DA0                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 378+ 7DA0 6F               ld   l, a
 379+ 7DA1 87               add  a, a                      ; *2
 380+ 7DA2 87               add  a, a                      ; *4
 381+ 7DA3 87               add  a, a                      ; *8
 382+ 7DA4 5F               ld   e, a                      ; E = ItemLeft
 383+ 7DA5 C6 07            add  a, 7
 384+ 7DA7 57               ld   d, a                      ; D = ItemRight
 385+ 7DA8
 386+ 7DA8 ED 4B F9 8D      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 387+ 7DAC
 388+ 7DAC                  ; WillyLeft <= ItemRight
 389+ 7DAC 79               ld   a, c
 390+ 7DAD BA               cp   d
 391+ 7DAE 28 04            jr   z, .x_ok
 392+ 7DB0 38 02            jr   c, .x_ok
 393+ 7DB2 18 29            jr   .no_collision
 394+ 7DB4
 395+ 7DB4              .x_ok:
 396+ 7DB4                  ; WillyRight >= ItemLeft (WillyRight = WillyX + 7 o 15)
 397+ 7DB4 C6 07            add  a, 7
 398+ 7DB6 BB               cp   e
 399+ 7DB7 28 04            jr   z, .y_check
 400+ 7DB9 30 02            jr   nc, .y_check
 401+ 7DBB 18 20            jr   .no_collision
 402+ 7DBD
 403+ 7DBD              .y_check:
 404+ 7DBD E1               pop  hl
 405+ 7DBE E5               push hl

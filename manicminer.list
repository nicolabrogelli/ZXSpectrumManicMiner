 293  85DD              ; -------------------------------------------------------------------
 294  85DD              ; ShowTitleScreen
 295  85DD              ; Visualizza la schermata iniziale del gioco (Title Screen).
 296  85DD              ; Rimane visibile con animazione ciclica finché il giocatore non preme ENTER.
 297  85DD              ; Alla pressione di ENTER, inizializza la partita e avvia il primo livello.
 298  85DD              ; -------------------------------------------------------------------
 299  85DD              ShowTitleScreen:
 300  85DD                  ; 1. Disegna la schermata iniziale
 301  85DD CD FD 63         call Gfx_DrawTitleScreen
 302  85E0
 303  85E0                  ; 2. Attende il rilascio del tasto ENTER (se era già premuto)
 304  85E0              .wait_title_enter_release:
 305  85E0 76               halt
 306  85E1 3E BF            ld   a, $bf
 307  85E3 DB FE            in   a, ($fe)
 308  85E5 1F               rra
 309  85E6 30 F8            jr   nc, .wait_title_enter_release
 310  85E8
 311  85E8                  ; 3. Ciclo di attesa pressione ENTER con animazione colore
 312  85E8 0E 00            ld   c, 0                  ; C = contatore frame per animazione colore
 313  85EA              .title_loop:
 314  85EA 76               halt
 315  85EB
 316  85EB                  ; Animazione ciclo colore su "PRESS ENTER TO START" (Riga 12, Col 0..31, $5980)
 317  85EB 0C               inc  c
 318  85EC 79               ld   a, c
 319  85ED CB 3F            srl  a
 320  85EF CB 3F            srl  a
 321  85F1 CB 3F            srl  a                     ; Cambia colore ogni 8 frame (~160ms)
 322  85F3 E6 07            and  7
 323  85F5 5F               ld   e, a
 324  85F6 16 00            ld   d, 0
 325  85F8 21 F5 63         ld   hl, title_color_table
 326  85FB 19               add  hl, de
 327  85FC 7E               ld   a, (hl)               ; A = nuovo colore
 328  85FD 21 80 59         ld   hl, $5980             ; Riga 12 ($5800 + 12*32 = $5980)
 329  8600 06 20            ld   b, 32
 330  8602              .color_title_loop:
 331  8602 77               ld   (hl), a
 332  8603 23               inc  hl
 333  8604 10 FC            djnz .color_title_loop
 334  8606
 335  8606                  ; Controlla se il tasto ENTER è premuto (Porta $BFFE, Bit 0)
 336  8606 3E BF            ld   a, $bf
 337  8608 DB FE            in   a, ($fe)
 338  860A 1F               rra
 339  860B 38 DD            jr   c, .title_loop        ; Carry = 1 (non premuto) -> continua loop
 340  860D
 341  860D                  ; 4. Attende il rilascio del tasto ENTER per evitare doppi scatti
 342  860D              .wait_title_enter_release_after:
 343  860D 76               halt
 344  860E 3E BF            ld   a, $bf
 345  8610 DB FE            in   a, ($fe)
 346  8612 1F               rra
 347  8613 30 F8            jr   nc, .wait_title_enter_release_after
 348  8615
 349  8615                  ; 5. Pulisce completamente l'intero schermo e gli attributi (cancella totalmente il Title Screen)
 350  8615 AF               xor  a
 351  8616 D3 FE            out  ($fe), a              ; Bordo a nero
 352  8618 21 8D 5C         ld   hl, ATTR_P
 353  861B 77               ld   (hl), a               ; Paper/Ink = 0 (Nero)
 354  861C CD AF 0D         call CLS                   ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 355  861F 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07
 356  8621 3E 07            ld   a, $07
 357  8623 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
 358  8626
 359  8626                  ; 6. Ripristina integralmente lo stato iniziale della partita (vite, item, stanze, tempo)
 360  8626 CD 9B 88         call ResetFullGameState
 361  8629
 362  8629                  ; 7. Avvia il gioco dal primo livello (Stanza 0: The Off Licence)
 363  8629 C3 99 84         jp   LoadRoomAndRestart

 736+ 86BE 3A 25 E8         ld   a, (player_score + 0)
 737+ 86C1 32 28 E8         ld   (high_score + 0), a
 738+ 86C4 3A 26 E8         ld   a, (player_score + 1)
 739+ 86C7 32 29 E8         ld   (high_score + 1), a
 740+ 86CA 3A 27 E8         ld   a, (player_score + 2)
 741+ 86CD 32 2A E8         ld   (high_score + 2), a
 742+ 86D0
 743+ 86D0              .done_check:
 744+ 86D0 C9               ret

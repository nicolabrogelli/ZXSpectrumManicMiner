1580+ 6619              ; -------------------------------------------------------------------
1581+ 6619              ; Gfx_DrawGameOverScreen
1582+ 6619              ; Esegue la sequenza animata di Game Over:
1583+ 6619              ; 1. Pulisce lo schermo a nero, mostra Willy (Y=96), BotteSprite (Y=112, Rosso), Nome Stanza (riga 16) e Status Line (riga 18).
1584+ 6619              ; 2. Animazione di discesa fluida di PiedeSprite dall'alto (Y=0) fino a fermarsi sopra Willy (Y=80), prima del bordo alto della Botte.
1585+ 6619              ; 3. Breve pausa con PiedeSprite fermo sopra Willy.
1586+ 6619              ; 4. Stampa la scritta GAME OVER al centro dello schermo (riga 5) solo dopo la pausa.
1587+ 6619              ; 5. Stampa la richiesta "VUOI CONTINUARE? Y/N" a riga 8.
1588+ 6619              ; -------------------------------------------------------------------
1589+ 6619              Gfx_DrawGameOverScreen:
1590+ 6619 F5               push af
1591+ 661A C5               push bc
1592+ 661B D5               push de
1593+ 661C E5               push hl
1594+ 661D DD E5            push ix
1595+ 661F
1596+ 661F                  ; 1. Bordo hardware e schermo a nero
1597+ 661F AF               xor  a
1598+ 6620 D3 FE            out  ($fe), a              ; Bordo a nero
1599+ 6622 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce tutti i pixel e gli attributi a nero
1600+ 6625
1601+ 6625                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1602+ 6625                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1603+ 6625 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1604+ 6628 DD 21 C7 DB      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1605+ 662C CD 3F 5E         call Gfx_DrawPixelSprite8x8
1606+ 662F
1607+ 662F                  ; 2b. Corpo di Willy (8x8) a X=124, Y=104
1608+ 662F 01 7C 68         ld   bc, $687c             ; B = Y = 104 ($68), C = X = 124 ($7C)
1609+ 6632 DD 21 CF DB      ld   ix, Willy + (1 * 8)   ; Body right frame 0
1610+ 6636 CD 3F 5E         call Gfx_DrawPixelSprite8x8
1611+ 6639
1612+ 6639                  ; 2c. Imposta attributi colore di Willy (Bianco Brillante) a X=124, Y=96
1613+ 6639 01 7C 60         ld   bc, $607c             ; B = Y = 96, C = X = 124
1614+ 663C 3E 47            ld   a, WHITE | $40        ; Bianco Brillante
1615+ 663E CD 1F 6D         call Gfx_SetEnemyColorAttributes
1616+ 6641
1617+ 6641                  ; 3. Disegna BotteSprite (immobile, colore Rosso) a X=120, Y=112
1618+ 6641 01 78 70         ld   bc, $7078             ; B = Y = 112 ($70), C = X = 120 ($78)

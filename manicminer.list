 128+ 7DC7 E6 1F            and  31
 129+ 7DC9 87               add  a, a
 129+ 7DCA 87             add a, a
 129+ 7DCB 87             add a, a
 130+ 7DCC DD 77 04         ld   (ix+4), a                 ; Min Limit X (pixel)
 131+ 7DCF

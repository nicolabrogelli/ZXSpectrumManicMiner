1543+ 65EB CD AF 0D         call CLS                   ; Pulisce tutti i pixel e gli attributi a nero
1544+ 65EE 36 07            ld   (hl), $07             ; Ripristina ATTR_P a $07 (Inchiostro Bianco, Sfondo Nero)
1545+ 65F0 3E 07            ld   a, $07
1546+ 65F2 32 8F 5C         ld   (ATTR_T), a           ; Ripristina ATTR_T a $07
1547+ 65F5
1548+ 65F5                  ; 2. Disegna Willy (immobile, rivolto a destra) a X=124, Y=96
1549+ 65F5                  ; 2a. Testa di Willy (8x8) a X=124, Y=96
1550+ 65F5 01 7C 60         ld   bc, $607c             ; B = Y = 96 ($60), C = X = 124 ($7C)
1551+ 65F8 DD 21 F2 97      ld   ix, Willy + (0 * 8)   ; HEAD_GRAPH_RIGHT
1552+ 65FC CD 3F 5E         call Gfx_DrawPixelSprite8x8

  94+ F0A1 00           portal_static_color:        db 0       ; Attributo colore originale del portale statico
  95+ F0A2 00           portal_row:                 db 0       ; Riga del portale nella stanza corrente (0..15)
  96+ F0A3 00           portal_col:                 db 0       ; Colonna del portale nella stanza corrente (0..31)

 672+ 87E2              ; Score_AddItemPoints
 673+ 87E2              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 674+ 87E2              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 675+ 87E2              ; -------------------------------------------------------------------
 676+ 87E2              Score_AddItemPoints:
 677+ 87E2 F5               push af
 678+ 87E3 C5               push bc
 679+ 87E4 D5               push de
 680+ 87E5 E5               push hl
 681+ 87E6
 682+ 87E6                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 683+ 87E6 3A 05 F1         ld   a, (player_score + 1)
 684+ 87E9 C6 01            add  a, $01
 685+ 87EB 27               daa
 686+ 87EC 32 05 F1         ld   (player_score + 1), a
 687+ 87EF
 688+ 87EF                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 689+ 87EF 3A 06 F1         ld   a, (player_score + 2)
 690+ 87F2 CE 00            adc  a, 0
 691+ 87F4 27               daa
 692+ 87F5 32 06 F1         ld   (player_score + 2), a
 693+ 87F8
 694+ 87F8                  ; Controlla se player_score ha superato high_score
 695+ 87F8 CD 03 88         call Score_CheckAndUpdateHighScore

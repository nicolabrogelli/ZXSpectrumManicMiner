 561+ 82CB 3E 01            ld   a, 1
 562+ 82CD 32 7F B0         ld   (game_objective_completed), a
 563+ 82D0              .no_dec_room:
 564+ 82D0
 565+ 82D0                  ; Incrementa il conteggio globale degli item raccolti
 566+ 82D0 3A 73 AA         ld   a, (items_collected)

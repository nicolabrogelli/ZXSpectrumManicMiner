 746+ 878E              ; -------------------------------------------------------------------
 747+ 878E              ; Items_Animate
 748+ 878E              ;
 749+ 878E              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 878E              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 878E              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 878E              ; originale $8F63.
 753+ 878E              ; -------------------------------------------------------------------
 754+ 878E              Items_Animate:
 755+ 878E E5               push hl
 756+ 878F D5               push de
 757+ 8790 C5               push bc
 758+ 8791 FD E5            push iy
 759+ 8793
 760+ 8793 3A C7 ED         ld   a, (num_room_items)
 761+ 8796 B7               or   a
 762+ 8797 28 40            jr   z, .anim_done
 763+ 8799
 764+ 8799 FD 21 77 ED      ld   iy, current_room_items
 765+ 879D
 766+ 879D              .anim_loop:
 767+ 879D FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 87A0 FE FF            cp   $FF
 769+ 87A2 28 35            jr   z, .anim_done
 770+ 87A4 B7               or   a
 771+ 87A5 28 2B            jr   z, .next_anim_item
 772+ 87A7
 773+ 87A7                  ; Routine originale $8F63 di Manic Miner:
 774+ 87A7                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 87A7 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 87A9 F6 03            or   $03                       ; Base Ink = 3
 777+ 87AB 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 87AC FD 7E 02         ld   a, (iy+2)
 779+ 87AF E6 03            and  $03                       ; Isola offset rotazione
 780+ 87B1 80               add  a, b                      ; A = Nuovo attributo
 781+ 87B2 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 87B5 47               ld   b, a                      ; B = Nuovo attributo
 783+ 87B6
 784+ 87B6                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col

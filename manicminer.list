 330+ 6FA7              ; LoadPositionPlayeinRoom
 331+ 6FA7              ;
 332+ 6FA7              ; Inizializza la posizione del player (Willy) quando entra
 333+ 6FA7              ; in una nuova stanza.
 334+ 6FA7              ;
 335+ 6FA7              ; La posizione viene letta direttamente dai dati della stanza
 336+ 6FA7              ; (layout/metadata) a partire da room_ptr.
 337+ 6FA7              ;
 338+ 6FA7              ; Output:
 339+ 6FA7              ;   PlayerPos     = posizione iniziale (Y, X)
 340+ 6FA7              ;   PlayerPosOld  = copia della posizione iniziale
 341+ 6FA7              ;
 342+ 6FA7              ; Struttura dati stanza:
 343+ 6FA7              ;   OFFSET_POS_WILLY:
 344+ 6FA7              ;       +0 = X
 345+ 6FA7              ;       +1 = Y
 346+ 6FA7              ; -------------------------------------------------------------------
 347+ 6FA7              LoadPositionPlayeinRoom:
 348+ 6FA7                  ; ---------------------------------------------------------------
 349+ 6FA7                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 350+ 6FA7                  ; ---------------------------------------------------------------
 351+ 6FA7 2A 53 E5         ld   hl, (room_ptr)
 352+ 6FAA 11 68 02         ld   de, OFFSET_POS_WILLY
 353+ 6FAD 19               add  hl, de
 354+ 6FAE
 355+ 6FAE                  ; Byte 0: Y * 2
 356+ 6FAE 7E               ld   a, (hl)
 357+ 6FAF CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 358+ 6FB1 57               ld   d, a                      ; D = PlayerY
 359+ 6FB2
 360+ 6FB2                  ; Byte 1: Anim frame
 361+ 6FB2 23               inc  hl
 362+ 6FB3 7E               ld   a, (hl)
 363+ 6FB4 E6 03            and  3                         ; Garanzia valore valido (0..3)
 364+ 6FB6 FE 03            cp   3
 365+ 6FB8 38 01            jr   c, .valid_anim
 366+ 6FBA AF               xor  a
 367+ 6FBB              .valid_anim:
 368+ 6FBB 32 D8 E1         ld   (body_state), a
 369+ 6FBE 32 DB E5         ld   (player_old_body), a
 370+ 6FC1
 371+ 6FC1                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 372+ 6FC1 23               inc  hl                        ; Byte 2 (Direction)
 373+ 6FC2 7E               ld   a, (hl)
 374+ 6FC3 E6 01            and  1
 375+ 6FC5 28 04            jr   z, .facing_right
 376+ 6FC7 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 377+ 6FC9 18 02            jr   .set_dir
 378+ 6FCB              .facing_right:
 379+ 6FCB 3E 02            ld   a, 2                      ; 2 = Destra nel motore
 380+ 6FCD              .set_dir:
 381+ 6FCD 32 D9 E1         ld   (direction), a
 382+ 6FD0 32 DA E5         ld   (player_old_dir), a
 383+ 6FD3
 384+ 6FD3                  ; Byte 4-5: Location in attribute buffer (DEFW) -> AttrAddr (es. 23970)
 385+ 6FD3 23               inc  hl                        ; Byte 3 (Airborne)
 386+ 6FD4 23               inc  hl                        ; Byte 4 (AttrAddr Low)
 387+ 6FD5 4E               ld   c, (hl)
 388+ 6FD6 23               inc  hl                        ; Byte 5 (AttrAddr High)
 389+ 6FD7 7E               ld   a, (hl)
 390+ 6FD8
 391+ 6FD8                  ; Col = (AttrAddr - 23552) & 31 -> Pixel X = Col * 8
 392+ 6FD8 67               ld   h, a
 393+ 6FD9 69               ld   l, c
 394+ 6FDA 01 00 A4         ld   bc, -23552
 395+ 6FDD 09               add  hl, bc
 396+ 6FDE
 397+ 6FDE 7D               ld   a, l
 398+ 6FDF E6 1F            and  31
 399+ 6FE1 87               add  a, a                      ; *2
 400+ 6FE2 87               add  a, a                      ; *4
 401+ 6FE3 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 402+ 6FE4 4F               ld   c, a                      ; C = PlayerX
 403+ 6FE5 42               ld   b, d                      ; B = PlayerY

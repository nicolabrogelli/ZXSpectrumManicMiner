 144+ 8712 ~                jr   nz, .d1
 145+ 8712 ~
 146+ 8712 ~                ; Speaker OFF
 147+ 8712 ~                ld   a, (room_border_color)
 148+ 8712 ~                and  $ef
 149+ 8712 ~                out  ($fe), a
 150+ 8712 ~                ld   c, d
 151+ 8712 ~            .d2:
 152+ 8712 ~                push af
 153+ 8712 ~                pop  af
 154+ 8712 ~                dec  c
 155+ 8712 ~                jr   nz, .d2
 156+ 8712 ~
 157+ 8712 ~                djnz .note_loop
 158+ 8712 ~
 159+ 8712 ~            .done:
 160+ 8712 ~                pop  hl
 161+ 8712 ~                pop  de
 162+ 8712 ~                pop  bc
 163+ 8712 ~                pop  af
 164+ 8712 ~                ret

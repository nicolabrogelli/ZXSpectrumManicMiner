1676+ 6693              .skip_clear_prev:
1677+ 6693 C1               pop  bc                    ; Ripristina B = Y corrente
1678+ 6694 C5               push bc
1679+ 6695
1680+ 6695                  ; Quando il Piede raggiunge Y = 96, cancella lo sprite di Willy a (124, 96) prima di disegnare il Piede
1681+ 6695 78               ld   a, b
1682+ 6696 FE 60            cp   96
1683+ 6698 20 09            jr   nz, .draw_foot
1684+ 669A C5               push bc
1685+ 669B 0E 78            ld   c, 120
1686+ 669D 06 60            ld   b, 96
1687+ 669F CD 20 63         call Gfx_Clear16x16_Black
1688+ 66A2 C1               pop  bc

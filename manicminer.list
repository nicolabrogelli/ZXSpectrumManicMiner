 469+ 7F43 E6 03            and  3
 470+ 7F45 5F               ld   e, a                      ; E = Anim subframe
 471+ 7F46
 472+ 7F46 3A A8 E4         ld   a, (room_has_v_guardians)
 473+ 7F49 B7               or   a

 550+ 7F74 81               add  a, c                      ; Muovi verso il basso
 551+ 7F75 DD BE 05         cp   (ix+5)                    ; Max Limit Y
 552+ 7F78 28 08            jr   z, .v_rev_up
 553+ 7F7A 30 06            jr   nc, .v_rev_up
 554+ 7F7C DD 77 03         ld   (ix+3), a
 555+ 7F7F C3 90 7F         jp   .next

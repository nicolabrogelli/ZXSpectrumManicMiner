  59+ 7CF7              ; ResetItemsTable
  60+ 7CF7              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 7CF7              ; per tutte le stanze registrate in RoomsListTable.
  62+ 7CF7              ; -------------------------------------------------------------------
  63+ 7CF7              ResetItemsTable:
  64+ 7CF7 E5               push hl
  65+ 7CF8 D5               push de
  66+ 7CF9 C5               push bc
  67+ 7CFA
  68+ 7CFA 21 DF 6F         ld   hl, RoomsListTable
  69+ 7CFD 06 02            ld   b, NUM_ROOMS
  70+ 7CFF
  71+ 7CFF              .room_loop:
  72+ 7CFF C5               push bc
  73+ 7D00 5E               ld   e, (hl)
  74+ 7D01 23               inc  hl
  75+ 7D02 56               ld   d, (hl)
  76+ 7D03 23               inc  hl
  77+ 7D04 E5               push hl
  78+ 7D05
  79+ 7D05                  ; DE = room_ptr
  80+ 7D05 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 7D08 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 7D09
  83+ 7D09              .item_loop:

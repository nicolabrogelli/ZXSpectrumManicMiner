 342  88DD AF               xor  a
 343  88DE D3 FE            out  ($fe), a              ; Bordo a nero
 344  88E0 CD 9D 62         call Gfx_ClearScreenDirect ; Pulisce integralmente tutta la memoria pixel (6144B) e attributi (768B)
 345  88E3

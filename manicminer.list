 747+ 886F              ; Items_Animate
 748+ 886F              ;
 749+ 886F              ; Esegue l'animazione originale degli Item di Manic Miner:
 750+ 886F              ; cicla il colore INK attraverso Magenta (3), Verde (4), Ciano (5), Giallo (6)
 751+ 886F              ; mantenendo inalterati i bit di PAPER e BRIGHT, esattamente come nella routine
 752+ 886F              ; originale $8F63.
 753+ 886F              ; -------------------------------------------------------------------
 754+ 886F              Items_Animate:
 755+ 886F E5               push hl
 756+ 8870 D5               push de
 757+ 8871 C5               push bc
 758+ 8872 FD E5            push iy
 759+ 8874
 760+ 8874 3A AC EE         ld   a, (num_room_items)
 761+ 8877 B7               or   a
 762+ 8878 28 40            jr   z, .anim_done
 763+ 887A
 764+ 887A FD 21 5C EE      ld   iy, current_room_items
 765+ 887E
 766+ 887E              .anim_loop:
 767+ 887E FD 7E 02         ld   a, (iy+2)                 ; A = colore corrente (0 = raccolto, $FF = fine)
 768+ 8881 FE FF            cp   $FF
 769+ 8883 28 35            jr   z, .anim_done
 770+ 8885 B7               or   a
 771+ 8886 28 2B            jr   z, .next_anim_item
 772+ 8888
 773+ 8888                  ; Routine originale $8F63 di Manic Miner:
 774+ 8888                  ; Cicla l'Ink attraverso Magenta (3) -> Giallo (6) -> Ciano (5) -> Verde (4) -> Magenta (3)
 775+ 8888 E6 F8            and  $F8                       ; Preserva Paper e Bright
 776+ 888A F6 03            or   $03                       ; Base Ink = 3
 777+ 888C 47               ld   b, a                      ; B = (Paper & $F8) | 3
 778+ 888D FD 7E 02         ld   a, (iy+2)
 779+ 8890 E6 03            and  $03                       ; Isola offset rotazione
 780+ 8892 80               add  a, b                      ; A = Nuovo attributo
 781+ 8893 FD 77 02         ld   (iy+2), a                 ; Salva nella cache
 782+ 8896 47               ld   b, a                      ; B = Nuovo attributo
 783+ 8897
 784+ 8897                  ; Calcola indirizzo attributi: $5800 + Row * 32 + Col
 785+ 8897 FD 5E 00         ld   e, (iy+0)                 ; E = Col (0..31)
 786+ 889A 16 00            ld   d, 0
 787+ 889C 26 00            ld   h, 0
 788+ 889E FD 6E 01         ld   l, (iy+1)                 ; HL = Row (0..15)
 789+ 88A1 29               add  hl, hl
 790+ 88A2 29               add  hl, hl
 791+ 88A3 29               add  hl, hl
 792+ 88A4 29               add  hl, hl
 793+ 88A5 29               add  hl, hl                    ; Row * 32
 794+ 88A6 19               add  hl, de                    ; Row * 32 + Col (Offset 0..511)
 795+ 88A7
 796+ 88A7                  ; Aggiorna items_grid
 797+ 88A7 E5               push hl
 798+ 88A8 11 2B E9         ld   de, items_grid
 799+ 88AB 19               add  hl, de
 800+ 88AC 70               ld   (hl), b
 801+ 88AD E1               pop  hl
 802+ 88AE
 803+ 88AE                  ; Aggiorna memoria attributi VRAM ($5800)
 804+ 88AE 11 00 58         ld   de, COLOR_DATA
 805+ 88B1 19               add  hl, de                    ; HL = Indirizzo attributi a schermo
 806+ 88B2 70               ld   (hl), b                   ; Scrive l'attributo aggiornato a schermo
 807+ 88B3
 808+ 88B3              .next_anim_item:
 809+ 88B3 01 05 00         ld   bc, 5
 810+ 88B6 FD 09            add  iy, bc
 811+ 88B8 18 C4            jr   .anim_loop

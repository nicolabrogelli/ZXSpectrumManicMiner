  72+ 835D ~            ; Audio_UpdateMusic
  73+ 835D ~            ;
  74+ 835D ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 835D ~            ; Viene chiamata a ogni frame.
  76+ 835D ~            ; -------------------------------------------------------------------
  77+ 835D ~            Audio_UpdateMusic:
  78+ 835D ~                push af
  79+ 835D ~                push bc
  80+ 835D ~                push de
  81+ 835D ~                push hl
  82+ 835D ~
  83+ 835D ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 835D ~                ld   a, (Audio_jump_sound_note)
  85+ 835D ~                cp   18
  86+ 835D ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 835D ~
  88+ 835D ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 835D ~                ld   a, (Audio_music_frame_counter)
  90+ 835D ~                dec  a
  91+ 835D ~                ld   (Audio_music_frame_counter), a
  92+ 835D ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 835D ~
  94+ 835D ~                ; Altrimenti carica la nota successiva
  95+ 835D ~                ld   a, (Audio_music_note_idx)
  96+ 835D ~                inc  a
  97+ 835D ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 835D ~                jr   c, .no_wrap
  99+ 835D ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 835D ~            .no_wrap:
 101+ 835D ~                ld   (Audio_music_note_idx), a
 102+ 835D ~
 103+ 835D ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 835D ~                ld   e, a
 105+ 835D ~                ld   d, 0
 106+ 835D ~                ld   hl, Audio_MusicSheet
 107+ 835D ~                add  hl, de
 108+ 835D ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 835D ~
 110+ 835D ~                ; Leggi durata (secondo byte)
 111+ 835D ~                inc  hl
 112+ 835D ~                ld   a, (hl)
 113+ 835D ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 835D ~                jr   nz, .dur_ok
 115+ 835D ~                ld   a, 1
 116+ 835D ~            .dur_ok:
 117+ 835D ~                ld   (Audio_music_frame_counter), a
 118+ 835D ~
 119+ 835D ~            .play_current_note:
 120+ 835D ~                ; Ottieni il delay della nota corrente (primo byte)
 121+ 835D ~                ld   a, (Audio_music_note_idx)
 122+ 835D ~                ld   e, a
 123+ 835D ~                ld   d, 0
 124+ 835D ~                ld   hl, Audio_MusicSheet
 125+ 835D ~                add  hl, de
 126+ 835D ~                add  hl, de                   ; hl punta al primo byte della nota
 127+ 835D ~                ld   a, (hl)                  ; A = delay
 128+ 835D ~                or   a
 129+ 835D ~                jr   z, .done                 ; Se delay è 0, è una pausa (Rest)
 130+ 835D ~
 131+ 835D ~                ; Suona la nota: 2 cicli
 132+ 835D ~                ld   d, a                     ; D = delay
 133+ 835D ~                ld   b, 2                     ; 2 cicli per frame
 134+ 835D ~            .note_loop:
 135+ 835D ~                ; Speaker ON
 136+ 835D ~                ld   a, (room_border_color)
 137+ 835D ~                or   $10
 138+ 835D ~                out  ($fe), a
 139+ 835D ~                ld   c, d
 140+ 835D ~            .d1:
 141+ 835D ~                push af
 142+ 835D ~                pop  af
 143+ 835D ~                dec  c
 144+ 835D ~                jr   nz, .d1
 145+ 835D ~
 146+ 835D ~                ; Speaker OFF
 147+ 835D ~                ld   a, (room_border_color)
 148+ 835D ~                and  $ef
 149+ 835D ~                out  ($fe), a
 150+ 835D ~                ld   c, d
 151+ 835D ~            .d2:
 152+ 835D ~                push af
 153+ 835D ~                pop  af
 154+ 835D ~                dec  c
 155+ 835D ~                jr   nz, .d2
 156+ 835D ~
 157+ 835D ~                djnz .note_loop
 158+ 835D ~
 159+ 835D ~            .done:
 160+ 835D ~                pop  hl
 161+ 835D ~                pop  de
 162+ 835D ~                pop  bc
 163+ 835D ~                pop  af
 164+ 835D ~                ret
 165+ 835D ~
 166+ 835D ~            Audio_MusicSheet:
 167+ 835D ~                ; Formato: db delay, durata (in frame a 50Hz)
 168+ 835D ~                db 96, 5, 101, 15, 96, 5, 107, 25, 152, 5, 143, 35, 107, 15, 96, 10
 169+ 835D ~                db 107, 10, 96, 10, 107, 25, 96, 10, 85, 10, 81, 10, 85, 5, 81, 10
 170+ 835D ~                db 85, 10, 96, 70, 72, 40, 81, 10, 76, 5, 85, 20, 96, 10, 107, 25
 171+ 835D ~                db 90, 20, 114, 5, 107, 10, 90, 10, 96, 10, 107, 10, 96, 10, 85, 5
 172+ 835D ~                db 90, 10, 107, 20, 68, 65

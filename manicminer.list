 518+ 7FCD              ; CheckCollision
 519+ 7FCD              ;
 520+ 7FCD              ; Controlla se Willy collide con un guardiano attivo (bounding box 16x16).
 521+ 7FCD              ; Output:
 522+ 7FCD              ;   Carry Set = Collisione con guardiano
 523+ 7FCD              ;   Carry Clear = Nessuna collisione
 524+ 7FCD              ; -------------------------------------------------------------------
 525+ 7FCD              CheckCollision:
 526+ 7FCD DD E5            push ix
 527+ 7FCF C5               push bc
 528+ 7FD0 D5               push de
 529+ 7FD1 E5               push hl
 530+ 7FD2
 531+ 7FD2                  ; Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 532+ 7FD2 3A 0A 9A         ld   a, (willy_safety_timer)
 533+ 7FD5 B7               or   a
 534+ 7FD6 20 3B            jr   nz, .no_collision_found
 535+ 7FD8
 536+ 7FD8 DD 21 C5 7C      ld   ix, ActiveEnemies
 537+ 7FDC 06 08            ld   b, 8                      ; 8 slot
 538+ 7FDE
 539+ 7FDE              .collision_loop:
 540+ 7FDE DD 7E 00         ld   a, (ix+0)
 541+ 7FE1 E6 80            and  $80                       ; Active?
 542+ 7FE3 28 26            jr   z, .next_enemy
 543+ 7FE5
 544+ 7FE5 C5               push bc                        ; Salva B (contatore ciclo 8 slot)
 545+ 7FE6
 546+ 7FE6                  ; 1. Controllo Bounding Box X: |WillyX - EnemyX| < 12 (tolleranza collisione)
 547+ 7FE6 ED 4B 00 96      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 548+ 7FEA DD 7E 02         ld   a, (ix+2)                 ; A = EnemyX
 549+ 7FED
 550+ 7FED                  ; Calcola differenza X
 551+ 7FED 91               sub  c                         ; A = EnemyX - WillyX
 552+ 7FEE 30 02            jr   nc, .x_diff_pos
 553+ 7FF0 ED 44            neg                            ; A = |EnemyX - WillyX|
 554+ 7FF2              .x_diff_pos:
 555+ 7FF2 FE 0C            cp   12                        ; Sovrapposizione orizzontale?
 556+ 7FF4 30 14            jr   nc, .no_x_hit             ; Se distanza >= 12 px, nessun contatto
 557+ 7FF6
 558+ 7FF6                  ; 2. Controllo Bounding Box Y: |WillyY - EnemyY| < 14
 559+ 7FF6 DD 7E 03         ld   a, (ix+3)                 ; A = EnemyY
 560+ 7FF9 90               sub  b                         ; A = EnemyY - WillyY
 561+ 7FFA 30 02            jr   nc, .y_diff_pos
 562+ 7FFC ED 44            neg                            ; A = |EnemyY - WillyY|
 563+ 7FFE              .y_diff_pos:
 564+ 7FFE FE 0E            cp   14                        ; Sovrapposizione verticale?
 565+ 8000 30 08            jr   nc, .no_x_hit             ; Se distanza >= 14 px, nessun contatto
 566+ 8002
 567+ 8002                  ; Collisione trovata!
 568+ 8002 C1               pop  bc                        ; Ripristina stack
 569+ 8003 E1               pop  hl
 570+ 8004 D1               pop  de
 571+ 8005 C1               pop  bc
 572+ 8006 DD E1            pop  ix
 573+ 8008 37               scf
 574+ 8009 C9               ret
 575+ 800A
 576+ 800A              .no_x_hit:
 577+ 800A C1               pop  bc                        ; Ripristina B (contatore ciclo)

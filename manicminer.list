 625+ 8274              ; Score_AddItemPoints
 626+ 8274              ; Aggiunge 100 punti allo Score del giocatore quando raccoglie un item.
 627+ 8274              ; Aggiorna automaticamente l'High Score se Score > HighScore.
 628+ 8274              ; -------------------------------------------------------------------
 629+ 8274              Score_AddItemPoints:
 630+ 8274 F5               push af
 631+ 8275 C5               push bc
 632+ 8276 D5               push de
 633+ 8277 E5               push hl
 634+ 8278
 635+ 8278                  ; Aggiungi 100 punti (byte 1 in BCD rappresenta centinaia/migliaia)
 636+ 8278 3A 15 A4         ld   a, (player_score + 1)
 637+ 827B C6 01            add  a, $01
 638+ 827D 27               daa
 639+ 827E 32 15 A4         ld   (player_score + 1), a
 640+ 8281
 641+ 8281                  ; Riporto al byte 2 (decine di migliaia / centinaia di migliaia)
 642+ 8281 3A 16 A4         ld   a, (player_score + 2)
 643+ 8284 CE 00            adc  a, 0
 644+ 8286 27               daa
 645+ 8287 32 16 A4         ld   (player_score + 2), a
 646+ 828A
 647+ 828A                  ; Controlla se player_score ha superato high_score
 648+ 828A CD 95 82         call Score_CheckAndUpdateHighScore
 649+ 828D
 650+ 828D                  ; Aggiorna visualizzazione a schermo

 191+ 88CA F6 10            or   $10               ; speaker ON
 192+ 88CC D3 FE            out  ($fe), a
 193+ 88CE
 194+ 88CE 0E 3C            ld   c, 60
 195+ 88D0              .d1:
 196+ 88D0 0D               dec  c
 197+ 88D1 20 FD            jr   nz, .d1
 198+ 88D3
 199+ 88D3 3A EA EA         ld   a, (room_border_color)
 200+ 88D6 E6 EF            and  $ef              ; speaker OFF
 201+ 88D8 D3 FE            out  ($fe), a
 202+ 88DA
 203+ 88DA 0E 3C            ld   c, 60
 204+ 88DC              .d2:
 205+ 88DC 0D               dec  c
 206+ 88DD 20 FD            jr   nz, .d2
 207+ 88DF
 208+ 88DF 10 E6            djnz .sound_loop
 209+ 88E1
 210+ 88E1 D1               pop  de
 211+ 88E2 C1               pop  bc
 212+ 88E3 C9               ret

  72+ 8712 ~            ; Audio_UpdateMusic
  73+ 8712 ~            ;
  74+ 8712 ~            ; Gestisce la riproduzione della musica di sottofondo frame-by-frame.
  75+ 8712 ~            ; Viene chiamata a ogni frame.
  76+ 8712 ~            ; -------------------------------------------------------------------
  77+ 8712 ~            Audio_UpdateMusic:
  78+ 8712 ~                push af
  79+ 8712 ~                push bc
  80+ 8712 ~                push de
  81+ 8712 ~                push hl
  82+ 8712 ~
  83+ 8712 ~                ; Se il salto sta riproducendo un effetto sonoro, non suonare la musica
  84+ 8712 ~                ld   a, (Audio_jump_sound_note)
  85+ 8712 ~                cp   18
  86+ 8712 ~                jr   c, .done                 ; Salto attivo -> niente musica
  87+ 8712 ~
  88+ 8712 ~                ; Decrementa il contatore dei frame della nota corrente
  89+ 8712 ~                ld   a, (Audio_music_frame_counter)
  90+ 8712 ~                dec  a
  91+ 8712 ~                ld   (Audio_music_frame_counter), a
  92+ 8712 ~                jr   nz, .play_current_note   ; Se non è zero, continua a suonare
  93+ 8712 ~
  94+ 8712 ~                ; Altrimenti carica la nota successiva
  95+ 8712 ~                ld   a, (Audio_music_note_idx)
  96+ 8712 ~                inc  a
  97+ 8712 ~                cp   35                       ; Abbiamo 35 note in totale
  98+ 8712 ~                jr   c, .no_wrap
  99+ 8712 ~                xor  a                        ; Torna a 0 se raggiunge la fine (loop)
 100+ 8712 ~            .no_wrap:
 101+ 8712 ~                ld   (Audio_music_note_idx), a
 102+ 8712 ~
 103+ 8712 ~                ; Carica la durata e impostala come nuovo contatore di frame
 104+ 8712 ~                ld   e, a
 105+ 8712 ~                ld   d, 0
 106+ 8712 ~                ld   hl, Audio_MusicSheet
 107+ 8712 ~                add  hl, de
 108+ 8712 ~                add  hl, de                   ; Ogni nota prende 2 byte (delay, duration)
 109+ 8712 ~
 110+ 8712 ~                ; Leggi durata (secondo byte)
 111+ 8712 ~                inc  hl
 112+ 8712 ~                ld   a, (hl)
 113+ 8712 ~                srl  a                        ; Divide per 2 (velocizza 2x, quattro volte più lento rispetto all'inizio)
 114+ 8712 ~                jr   nz, .dur_ok
 115+ 8712 ~                ld   a, 1
 116+ 8712 ~            .dur_ok:
 117+ 8712 ~                ld   (Audio_music_frame_counter), a

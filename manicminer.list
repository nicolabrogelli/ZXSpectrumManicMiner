 142+ 7CA6 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 143+ 7CA9 19               add  hl, de
 144+ 7CAA E5               push hl
 145+ 7CAB DD E1            pop  ix                        ; IX = bitmap item
 146+ 7CAD
 147+ 7CAD                  ; 4. HL = Inizio lista item nella stanza
 148+ 7CAD 2A 6C 91         ld   hl, (room_ptr)
 149+ 7CB0 11 75 02         ld   de, OFFSET_ITEMS
 150+ 7CB3 19               add  hl, de
 151+ 7CB4
 152+ 7CB4              .loop:
 153+ 7CB4 7E               ld   a, (hl)                   ; Byte 0: Color
 154+ 7CB5 FE FF            cp   $FF
 155+ 7CB7 28 65            jr   z, .done                  ; $FF = fine lista item
 156+ 7CB9
 157+ 7CB9 5F               ld   e, a                      ; E = Color
 158+ 7CBA 23               inc  hl
 159+ 7CBB 4E               ld   c, (hl)                   ; C = AttrAddr Low
 160+ 7CBC 23               inc  hl
 161+ 7CBD 46               ld   b, (hl)                   ; B = AttrAddr High

 725  8B90              ; -------------------------------------------------------------------
 726  8B90              ; CheckWillyConveyorCollision
 727  8B90              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 728  8B90              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 729  8B90              ; -------------------------------------------------------------------
 730  8B90              CheckWillyConveyorCollision:
 731  8B90 C5               push bc
 732  8B91 D5               push de
 733  8B92 E5               push hl
 734  8B93
 735  8B93                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 736  8B93 CD FA 77         call CheckWillyOnConveyor
 737  8B96 38 49            jr   c, .collision_detected
 738  8B98
 739  8B98                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 740  8B98 3A AD ED         ld   a, (conveyor_len)
 741  8B9B B7               or   a
 742  8B9C 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 743  8B9E
 744  8B9E                  ; B = WillyY, C = WillyX
 745  8B9E ED 4B 85 EA      ld   bc, (PlayerPos)
 746  8BA2
 747  8BA2                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 748  8BA2 3A AE ED         ld   a, (conveyor_row)
 749  8BA5 87               add  a, a                  ; *2
 750  8BA6 87               add  a, a                  ; *4
 751  8BA7 87               add  a, a                  ; *8
 752  8BA8 5F               ld   e, a                  ; E = ConveyorTop
 753  8BA9 C6 07            add  a, 7
 754  8BAB 57               ld   d, a                  ; D = ConveyorBottom
 755  8BAC
 756  8BAC                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 757  8BAC 78               ld   a, b                  ; WillyTop
 758  8BAD BA               cp   d
 759  8BAE 28 04            jr   z, .y_overlap
 760  8BB0 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 761  8BB2 18 32            jr   .no_conv_collision
 762  8BB4
 763  8BB4              .y_overlap:
 764  8BB4 C6 0F            add  a, 15                 ; WillyBottom
 765  8BB6 BB               cp   e
 766  8BB7 28 04            jr   z, .x_check
 767  8BB9 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 768  8BBB 18 29            jr   .no_conv_collision
 769  8BBD
 770  8BBD              .x_check:
 771  8BBD                  ; ConveyorLeft = conveyor_col * 8
 772  8BBD 3A AF ED         ld   a, (conveyor_col)
 773  8BC0 87               add  a, a                  ; *2
 774  8BC1 87               add  a, a                  ; *4
 775  8BC2 87               add  a, a                  ; *8
 776  8BC3 5F               ld   e, a                  ; E = ConveyorLeft
 777  8BC4
 778  8BC4                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 779  8BC4 21 AD ED         ld   hl, conveyor_len
 780  8BC7 3A AF ED         ld   a, (conveyor_col)
 781  8BCA 86               add  a, (hl)
 782  8BCB 87               add  a, a                  ; *2
 783  8BCC 87               add  a, a                  ; *4
 784  8BCD 87               add  a, a                  ; *8
 785  8BCE 3D               dec  a                     ; ConveyorRight
 786  8BCF 57               ld   d, a                  ; D = ConveyorRight
 787  8BD0
 788  8BD0                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 789  8BD0 79               ld   a, c                  ; WillyLeft
 790  8BD1 BA               cp   d
 791  8BD2 28 04            jr   z, .x_overlap
 792  8BD4 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 793  8BD6 18 0E            jr   .no_conv_collision
 794  8BD8
 795  8BD8              .x_overlap:
 796  8BD8 C6 0F            add  a, 15                 ; WillyRight
 797  8BDA BB               cp   e
 798  8BDB 28 04            jr   z, .collision_detected
 799  8BDD 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 800  8BDF 18 05            jr   .no_conv_collision
 801  8BE1
 802  8BE1              .collision_detected:
 803  8BE1 E1               pop  hl
 804  8BE2 D1               pop  de

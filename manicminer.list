 283+ 6C17              ; Struttura dati stanza:
 284+ 6C17              ;   OFFSET_POS_WILLY:
 285+ 6C17              ;       +0 = X
 286+ 6C17              ;       +1 = Y
 287+ 6C17              ; -------------------------------------------------------------------
 288+ 6C17              LoadPositionPlayeinRoom:
 289+ 6C17                  ; ---------------------------------------------------------------
 290+ 6C17                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 291+ 6C17                  ; ---------------------------------------------------------------

 849+ 8207              ; CheckCollision
 850+ 8207              ;
 851+ 8207              ; Controlla se Willy collide con un guardiano attivo con rilevamento
 852+ 8207              ; PIXEL-PERFECT (bit a bit), identico all'originale per ZX Spectrum.
 853+ 8207              ; Output:
 854+ 8207              ;   Carry Set = Collisione reale (pixel Willy sovrapposto a pixel guardiano)
 855+ 8207              ;   Carry Clear = Nessuna collisione
 856+ 8207              ; -------------------------------------------------------------------
 857+ 8207              CheckCollision:
 858+ 8207 DD E5            push ix
 859+ 8209 C5               push bc
 860+ 820A D5               push de
 861+ 820B E5               push hl
 862+ 820C
 863+ 820C                  ; 1. Se il timer di sicurezza (post-respawn) è attivo, Willy è invulnerabile
 864+ 820C 3A 30 EE         ld   a, (willy_safety_timer)
 865+ 820F B7               or   a
 866+ 8210 C2 83 83         jp   nz, .no_collision_found
 867+ 8213
 868+ 8213                  ; 2. Prepara i puntatori agli sprite di Willy (Testa e Corpo)
 869+ 8213 3A 2B EA         ld   a, (direction)

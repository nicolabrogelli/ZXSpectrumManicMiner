 413+ 858F              ; -------------------------------------------------------------------
 414+ 858F              ; CheckWillyItemCollision
 415+ 858F              ;
 416+ 858F              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 417+ 858F              ; Input:
 418+ 858F              ;   A = Item Col (0..31)
 419+ 858F              ;   H = Item Row (0..15)
 420+ 858F              ; Output:
 421+ 858F              ;   Carry Set = Collisione
 422+ 858F              ;   Carry Clear = Nessuna collisione
 423+ 858F              ; -------------------------------------------------------------------
 424+ 858F              CheckWillyItemCollision:
 425+ 858F C5               push bc
 426+ 8590 D5               push de
 427+ 8591 E5               push hl
 428+ 8592
 429+ 8592                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 430+ 8592 6F               ld   l, a
 431+ 8593 87               add  a, a                      ; *2
 432+ 8594 87               add  a, a                      ; *4
 433+ 8595 87               add  a, a                      ; *8
 434+ 8596 5F               ld   e, a                      ; E = ItemLeft
 435+ 8597 C6 07            add  a, 7
 436+ 8599 57               ld   d, a                      ; D = ItemRight
 437+ 859A
 438+ 859A ED 4B D2 E1      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 859E
 440+ 859E                  ; WillyLeft <= ItemRight
 441+ 859E 79               ld   a, c                      ; A = WillyX
 442+ 859F BA               cp   d                         ; D = ItemRight
 443+ 85A0 28 04            jr   z, .x_ok
 444+ 85A2 38 02            jr   c, .x_ok
 445+ 85A4 18 31            jr   .no_collision
 446+ 85A6
 447+ 85A6              .x_ok:
 448+ 85A6                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 85A6 BB               cp   e                         ; E = ItemLeft
 450+ 85A7 28 0B            jr   z, .y_check
 451+ 85A9 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 452+ 85AB
 453+ 85AB                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 454+ 85AB C6 0F            add  a, 15
 455+ 85AD BB               cp   e
 456+ 85AE 28 04            jr   z, .y_check
 457+ 85B0 30 02            jr   nc, .y_check
 458+ 85B2 18 23            jr   .no_collision
 459+ 85B4
 460+ 85B4              .y_check:
 461+ 85B4                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 462+ 85B4 7C               ld   a, h                      ; H = Item Row
 463+ 85B5 87               add  a, a                      ; *2
 464+ 85B6 87               add  a, a                      ; *4
 465+ 85B7 87               add  a, a                      ; *8
 466+ 85B8 5F               ld   e, a                      ; E = ItemTop
 467+ 85B9 C6 07            add  a, 7
 468+ 85BB 57               ld   d, a                      ; D = ItemBottom
 469+ 85BC
 470+ 85BC                  ; WillyTop <= ItemBottom
 471+ 85BC 78               ld   a, b                      ; A = WillyY
 472+ 85BD BA               cp   d                         ; D = ItemBottom
 473+ 85BE 28 04            jr   z, .y_ok
 474+ 85C0 38 02            jr   c, .y_ok
 475+ 85C2 18 13            jr   .no_collision
 476+ 85C4
 477+ 85C4              .y_ok:
 478+ 85C4                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 479+ 85C4 BB               cp   e                         ; E = ItemTop
 480+ 85C5 28 0B            jr   z, .collision
 481+ 85C7 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 482+ 85C9
 483+ 85C9                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 484+ 85C9 C6 0F            add  a, 15
 485+ 85CB BB               cp   e
 486+ 85CC 28 04            jr   z, .collision
 487+ 85CE 30 02            jr   nc, .collision
 488+ 85D0 18 05            jr   .no_collision
 489+ 85D2
 490+ 85D2              .collision:
 491+ 85D2 E1               pop  hl
 492+ 85D3 D1               pop  de
 493+ 85D4 C1               pop  bc
 494+ 85D5 37               scf
 495+ 85D6 C9               ret
 496+ 85D7
 497+ 85D7              .no_collision:
 498+ 85D7 E1               pop  hl
 499+ 85D8 D1               pop  de
 500+ 85D9 C1               pop  bc
 501+ 85DA B7               or   a
 502+ 85DB C9               ret
 503+ 85DC
 504+ 85DC              ; -------------------------------------------------------------------
 505+ 85DC              ; Items_CheckCollision
 506+ 85DC              ;
 507+ 85DC              ; Controlla se Willy collide con uno degli item attivi nella stanza.
 508+ 85DC              ; -------------------------------------------------------------------
 509+ 85DC              Items_CheckCollision:
 510+ 85DC E5               push hl
 511+ 85DD D5               push de
 512+ 85DE C5               push bc
 513+ 85DF FD E5            push iy
 514+ 85E1
 515+ 85E1 3A 52 E5         ld   a, (num_room_items)
 516+ 85E4 B7               or   a
 517+ 85E5 28 66            jr   z, .done
 518+ 85E7
 519+ 85E7 FD 21 02 E5      ld   iy, current_room_items
 520+ 85EB
 521+ 85EB              .loop:
 522+ 85EB FD 7E 02         ld   a, (iy+2)                 ; Color / Active / Terminator ($FF)
 523+ 85EE FE FF            cp   $FF
 524+ 85F0 28 5B            jr   z, .done                  ; Fine lista item della stanza
 525+ 85F2 B7               or   a
 526+ 85F3 28 51            jr   z, .next_item             ; Item già raccolto -> controlla il successivo
 527+ 85F5
 528+ 85F5 FD 4E 00         ld   c, (iy+0)                 ; C = Item Col (0..31)
 529+ 85F8 FD 66 01         ld   h, (iy+1)                 ; H = Item Row (0..15)
 530+ 85FB
 531+ 85FB 79               ld   a, c
 532+ 85FC CD 8F 85         call CheckWillyItemCollision
 533+ 85FF 30 45            jr   nc, .next_item
 534+ 8601
 535+ 8601                  ; --- ITEM RACCOLTO ---
 536+ 8601                  ; 1. Imposta il flag collected nei dati stanza
 537+ 8601 FD 6E 03         ld   l, (iy+3)
 538+ 8604 FD 66 04         ld   h, (iy+4)                 ; HL = puntatore al flag nei dati stanza
 539+ 8607 36 00            ld   (hl), 0                   ; 0 = raccolto
 540+ 8609
 541+ 8609                  ; 2. Rimuovi dalla griglia items_grid
 542+ 8609 FD 4E 00         ld   c, (iy+0)
 543+ 860C FD 46 01         ld   b, (iy+1)
 544+ 860F C5               push bc
 545+ 8610 26 00            ld   h, 0
 546+ 8612 68               ld   l, b
 547+ 8613 29               add  hl, hl
 547+ 8614 29             add hl, hl
 547+ 8615 29             add hl, hl
 547+ 8616 29             add hl, hl
 547+ 8617 29             add hl, hl
 548+ 8618 59               ld   e, c
 549+ 8619 16 00            ld   d, 0
 550+ 861B 19               add  hl, de
 551+ 861C 11 D2 DF         ld   de, items_grid
 552+ 861F 19               add  hl, de
 553+ 8620 36 00            ld   (hl), 0
 554+ 8622 C1               pop  bc
 555+ 8623
 556+ 8623                  ; 3. Disattiva lo slot nella cache
 557+ 8623 FD 36 02 00      ld   (iy+2), 0
 558+ 8627
 559+ 8627                  ; 4. Decrementa il numero di item rimanenti nella stanza corrente
 560+ 8627 21 52 E5         ld   hl, num_room_items
 561+ 862A 7E               ld   a, (hl)
 562+ 862B B7               or   a
 563+ 862C 28 08            jr   z, .no_dec_room
 564+ 862E 35               dec  (hl)
 565+ 862F 20 05            jr   nz, .no_dec_room
 566+ 8631                  ; Ultimo item della stanza raccolto -> Attiva il portale!
 567+ 8631 3E 01            ld   a, 1
 568+ 8633 32 EB E7         ld   (game_objective_completed), a
 569+ 8636              .no_dec_room:
 570+ 8636
 571+ 8636                  ; Incrementa il conteggio globale degli item raccolti
 572+ 8636 3A DC E1         ld   a, (items_collected)
 573+ 8639 3C               inc  a
 574+ 863A 32 DC E1         ld   (items_collected), a
 575+ 863D
 576+ 863D                  ; 5. Aggiungi 100 punti allo Score, aggiorna High Score e aggiorna la visualizzazione HUD
 577+ 863D CD 71 86         call Score_AddItemPoints
 578+ 8640
 579+ 8640                  ; 6. Ripristina il tile di sfondo
 580+ 8640 CD 5D 85         call RestoreBackgroundCell
 581+ 8643
 582+ 8643                  ; 7. Suono di raccolta
 583+ 8643 CD 14 87         call Audio_PlayCollectSound
 584+ 8646
 585+ 8646              .next_item:
 586+ 8646 11 05 00         ld   de, 5
 587+ 8649 FD 19            add  iy, de
 588+ 864B 18 9E            jr   .loop
 589+ 864D
 590+ 864D              .done:
 591+ 864D FD E1            pop  iy
 592+ 864F C1               pop  bc
 593+ 8650 D1               pop  de
 594+ 8651 E1               pop  hl
 595+ 8652 C9               ret

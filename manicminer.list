 982+ 77FA              ; Verifica se c'è un blocco Wall (tipo 2) alle coordinate pixel (X, Y)
 983+ 77FA              ; Input: C = X, B = Y
 984+ 77FA              ; Output: Carry flag impostato se è un Wall, altrimenti resettato
 985+ 77FA              ; -------------------------------------------------------------------
 986+ 77FA              CheckWallCell:
 987+ 77FA E5               push hl
 988+ 77FB D5               push de
 989+ 77FC C5               push bc
 990+ 77FD
 991+ 77FD                  ; 1. Controlla se Y (in B) è fuori dalla griglia di layout
 992+ 77FD 78               ld   a, b
 993+ 77FE FE 80            cp   128
 994+ 7800 30 1F            jr   nc, .not_wall
 995+ 7802
 996+ 7802                  ; 2. Calcola riga di layout: r = Y / 8
 997+ 7802 CB 3F            srl  a
 998+ 7804 CB 3F            srl  a
 999+ 7806 CB 3F            srl  a                 ; A = r (0..15)
1000+ 7808
1001+ 7808                  ; 3. Calcola colonna di layout: c = X / 8 (in C)
1002+ 7808 5F               ld   e, a              ; E = r (Row)
1003+ 7809 79               ld   a, c
1004+ 780A CB 3F            srl  a
1005+ 780C CB 3F            srl  a
1006+ 780E CB 3F            srl  a                 ; A = c (0..31)
1007+ 7810 4F               ld   c, a              ; C = c (Col)
1008+ 7811
1009+ 7811                  ; Se la cella è sulla rampa, non considerarla un muro!
1010+ 7811 53               ld   d, e              ; D = Row
1011+ 7812 59               ld   e, c              ; E = Col
1012+ 7813 CD 7F 77         call IsCellOnRamp
1013+ 7816 38 09            jr   c, .not_wall
1014+ 7818
1015+ 7818 7A               ld   a, d              ; A = Row
1016+ 7819 4B               ld   c, e              ; C = Col
1017+ 781A CD B6 78         call GetCellFromUnpacked ; A = cell type
1018+ 781D
1019+ 781D                  ; Controlla se è Wall (3)
1020+ 781D FE 03            cp   3
1021+ 781F 28 05            jr   z, .is_wall
1022+ 7821
1023+ 7821              .not_wall:
1024+ 7821 C1               pop  bc
1025+ 7822 D1               pop  de
1026+ 7823 E1               pop  hl

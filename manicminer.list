 830  874E              ; CheckWillyConveyorCollision
 831  874E              ; Verifica se Willy collide o si trova sul blocco Conveyor attivo nella stanza.
 832  874E              ; Output: Carry = 1 se collide con conveyor, Carry = 0 altrimenti
 833  874E              ; -------------------------------------------------------------------
 834  874E              CheckWillyConveyorCollision:
 835  874E C5               push bc
 836  874F D5               push de
 837  8750 E5               push hl
 838  8751
 839  8751                  ; 1. Se Willy è in piedi / cammina sul conveyor (check solido da fisica)
 840  8751 CD 97 77         call CheckWillyOnConveyor
 841  8754 38 49            jr   c, .collision_detected
 842  8756
 843  8756                  ; 2. Controlla anche intersezione tra Bounding Box di Willy (16x16) e blocco Conveyor
 844  8756 3A 76 A1         ld   a, (conveyor_len)
 845  8759 B7               or   a
 846  875A 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 847  875C
 848  875C                  ; B = WillyY, C = WillyX
 849  875C ED 4B 4E 9E      ld   bc, (PlayerPos)
 850  8760
 851  8760                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 852  8760 3A 77 A1         ld   a, (conveyor_row)
 853  8763 87               add  a, a                  ; *2
 854  8764 87               add  a, a                  ; *4
 855  8765 87               add  a, a                  ; *8
 856  8766 5F               ld   e, a                  ; E = ConveyorTop
 857  8767 C6 07            add  a, 7
 858  8769 57               ld   d, a                  ; D = ConveyorBottom
 859  876A
 860  876A                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 861  876A 78               ld   a, b                  ; WillyTop
 862  876B BA               cp   d
 863  876C 28 04            jr   z, .y_overlap
 864  876E 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 865  8770 18 32            jr   .no_conv_collision
 866  8772
 867  8772              .y_overlap:
 868  8772 C6 0F            add  a, 15                 ; WillyBottom
 869  8774 BB               cp   e
 870  8775 28 04            jr   z, .x_check
 871  8777 30 02            jr   nc, .x_check          ; WillyBottom >= ConveyorTop
 872  8779 18 29            jr   .no_conv_collision
 873  877B
 874  877B              .x_check:
 875  877B                  ; ConveyorLeft = conveyor_col * 8
 876  877B 3A 78 A1         ld   a, (conveyor_col)
 877  877E 87               add  a, a                  ; *2
 878  877F 87               add  a, a                  ; *4
 879  8780 87               add  a, a                  ; *8
 880  8781 5F               ld   e, a                  ; E = ConveyorLeft
 881  8782
 882  8782                  ; ConveyorRight = (conveyor_col + conveyor_len) * 8 - 1
 883  8782 21 76 A1         ld   hl, conveyor_len
 884  8785 3A 78 A1         ld   a, (conveyor_col)
 885  8788 86               add  a, (hl)
 886  8789 87               add  a, a                  ; *2
 887  878A 87               add  a, a                  ; *4
 888  878B 87               add  a, a                  ; *8
 889  878C 3D               dec  a                     ; ConveyorRight
 890  878D 57               ld   d, a                  ; D = ConveyorRight
 891  878E
 892  878E                  ; WillyLeft = WillyX (C), WillyRight = WillyX + 15
 893  878E 79               ld   a, c                  ; WillyLeft
 894  878F BA               cp   d
 895  8790 28 04            jr   z, .x_overlap
 896  8792 38 02            jr   c, .x_overlap         ; WillyLeft <= ConveyorRight
 897  8794 18 0E            jr   .no_conv_collision
 898  8796
 899  8796              .x_overlap:
 900  8796 C6 0F            add  a, 15                 ; WillyRight
 901  8798 BB               cp   e
 902  8799 28 04            jr   z, .collision_detected
 903  879B 30 02            jr   nc, .collision_detected ; WillyRight >= ConveyorLeft
 904  879D 18 05            jr   .no_conv_collision
 905  879F

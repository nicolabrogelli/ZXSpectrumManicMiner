 633  873A              ; -------------------------------------------------------------------
 634  873A              ; CheckPortalTransition
 635  873A              ; Verifica le condizioni per accedere alla stanza successiva:
 636  873A              ; 1. Tutti gli oggetti della caverna corrente devono essere raccolti (game_objective_completed != 0);
 637  873A              ; 2. Willy collide con il portale attivo definito a partire dal byte 655 (OFFSET_PORTAL).
 638  873A              ;
 639  873A              ; Output:
 640  873A              ;   Carry Set   = Tutti gli item raccolti e Willy sul portale -> Transizione attiva
 641  873A              ;   Carry Clear = Condizioni non soddisfatte -> Nessuna transizione
 642  873A              ; -------------------------------------------------------------------
 643  873A              CheckPortalTransition:
 644  873A C5               push bc
 645  873B D5               push de
 646  873C E5               push hl
 647  873D
 648  873D                  ; 1. Tutti gli item della stanza sono stati raccolti?
 649  873D CD C8 87         call CheckAllItemsCollected
 650  8740 30 4D            jr   nc, .no_transition
 651  8742
 652  8742                  ; 2. Willy collide con il portale (16x16 pixel)?
 653  8742                  ; Dai dati della stanza (OFFSET_PORTAL = 655):
 654  8742                  ; Offset 655 + 33 (688) contiene AttrAddr (DEFW: 23552 + Row * 32 + Col)
 655  8742 2A 50 BE         ld   hl, (room_ptr)
 656  8745 11 B0 02         ld   de, OFFSET_PORTAL + 33    ; Offset AttrAddr del portale
 657  8748 19               add  hl, de
 658  8749 4E               ld   c, (hl)
 659  874A 23               inc  hl
 660  874B 46               ld   b, (hl)                   ; BC = AttrAddr
 661  874C
 662  874C                  ; Offset = BC - 23552
 663  874C 60               ld   h, b
 664  874D 69               ld   l, c
 665  874E 01 00 A4         ld   bc, -23552
 666  8751 09               add  hl, bc
 667  8752
 668  8752                  ; PortalX = (Offset & 31) * 8
 669  8752 7D               ld   a, l
 670  8753 E6 1F            and  31
 671  8755 87               add  a, a
 671  8756 87             add a, a
 671  8757 87             add a, a
 672  8758 5F               ld   e, a                      ; E = PortalX (0..248)
 673  8759
 674  8759                  ; PortalY = (Offset / 32) * 8
 675  8759 CB 3C            srl  h
 675  875B CB 1D          rr l
 676  875D CB 3C            srl  h
 676  875F CB 1D          rr l
 677  8761 CB 3C            srl  h
 677  8763 CB 1D          rr l
 678  8765 CB 3C            srl  h
 678  8767 CB 1D          rr l
 679  8769 CB 3C            srl  h
 679  876B CB 1D          rr l
 680  876D 7D               ld   a, l
 681  876E 87               add  a, a
 681  876F 87             add a, a
 681  8770 87             add a, a
 682  8771 57               ld   d, a                      ; D = PortalY (0..120)
 683  8772
 684  8772                  ; Collisione Bounding Box 16x16 tra Willy (PlayerPos) e Portale (E, D)
 685  8772 ED 4B CF BA      ld   bc, (PlayerPos)           ; C = WillyX, B = WillyY
 686  8776
 687  8776                  ; Controllo orizzontale: |WillyX - PortalX| < 12
 688  8776 7B               ld   a, e
 689  8777 91               sub  c
 690  8778 30 02            jr   nc, .x_diff_pos
 691  877A ED 44            neg
 692  877C              .x_diff_pos:
 693  877C FE 0C            cp   12
 694  877E 30 0F            jr   nc, .no_transition
 695  8780
 696  8780                  ; Controllo verticale: |WillyY - PortalY| < 14
 697  8780 7A               ld   a, d
 698  8781 90               sub  b
 699  8782 30 02            jr   nc, .y_diff_pos
 700  8784 ED 44            neg
 701  8786              .y_diff_pos:
 702  8786 FE 0E            cp   14
 703  8788 30 05            jr   nc, .no_transition
 704  878A
 705  878A                  ; Transizione al portale attiva!
 706  878A E1               pop  hl
 707  878B D1               pop  de
 708  878C C1               pop  bc
 709  878D 37               scf
 710  878E C9               ret
 711  878F
 712  878F              .no_transition:
 713  878F E1               pop  hl
 714  8790 D1               pop  de
 715  8791 C1               pop  bc
 716  8792 B7               or   a
 717  8793 C9               ret

 328+ 6C3E E6 1F            and  31
 329+ 6C40 87               add  a, a                      ; *2
 330+ 6C41 87               add  a, a                      ; *4
 331+ 6C42 87               add  a, a                      ; *8 -> Pixel X (es. 16)
 332+ 6C43 4F               ld   c, a                      ; C = PlayerX
 333+ 6C44 42               ld   b, d                      ; B = PlayerY
 334+ 6C45
 335+ 6C45                  ; Salva coordinate (C = X, B = Y)
 336+ 6C45 ED 43 A7 8D      ld   (PlayerPos), bc
 337+ 6C49 ED 43 A9 8D      ld   (PlayerPosOld), bc

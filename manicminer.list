  40+ 7D2B                  ; 1. Azzera la tabella ActiveEnemies (8 slot x 11 byte = 88 byte)
  41+ 7D2B 21 CE 7C         ld   hl, ActiveEnemies
  42+ 7D2E 11 CF 7C         ld   de, ActiveEnemies + 1
  43+ 7D31 36 00            ld   (hl), 0
  44+ 7D33 01 57 00         ld   bc, 87
  45+ 7D36 ED B0            ldir
  46+ 7D38
  47+ 7D38                  ; Inizializza Old X e Old Y a $FF per tutti gli 8 slot
  48+ 7D38 DD 21 CE 7C      ld   ix, ActiveEnemies
  49+ 7D3C 06 08            ld   b, 8
  50+ 7D3E 11 0B 00         ld   de, 11

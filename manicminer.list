  12+ 7C4F              ; DetermineCurrentRoomID
  13+ 7C4F              ;
  14+ 7C4F              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 7C4F              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 7C4F              ;
  17+ 7C4F              ; Output:
  18+ 7C4F              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 7C4F              ;   (current_room) = A
  20+ 7C4F              ; -------------------------------------------------------------------
  21+ 7C4F              DetermineCurrentRoomID:
  22+ 7C4F E5               push hl
  23+ 7C50 D5               push de
  24+ 7C51 C5               push bc
  25+ 7C52
  26+ 7C52 21 75 6F         ld   hl, RoomsListTable
  27+ 7C55 ED 5B 27 91      ld   de, (room_ptr)
  28+ 7C59 06 01            ld   b, NUM_ROOMS
  29+ 7C5B 0E 00            ld   c, 0
  30+ 7C5D
  31+ 7C5D              .loop:
  32+ 7C5D 7E               ld   a, (hl)
  33+ 7C5E BB               cp   e
  34+ 7C5F 20 06            jr   nz, .no_match
  35+ 7C61 23               inc  hl
  36+ 7C62 7E               ld   a, (hl)
  37+ 7C63 BA               cp   d
  38+ 7C64 28 08            jr   z, .found
  39+ 7C66 2B               dec  hl
  40+ 7C67
  41+ 7C67              .no_match:
  42+ 7C67 23               inc  hl
  43+ 7C68 23               inc  hl
  44+ 7C69 0C               inc  c
  45+ 7C6A 10 F1            djnz .loop
  46+ 7C6C
  47+ 7C6C 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 7C6E
  49+ 7C6E              .found:
  50+ 7C6E 79               ld   a, c
  51+ 7C6F 32 CD 90         ld   (current_room), a
  52+ 7C72
  53+ 7C72 C1               pop  bc
  54+ 7C73 D1               pop  de
  55+ 7C74 E1               pop  hl
  56+ 7C75 C9               ret

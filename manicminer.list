 195+ 7CF9                  ; Aggiorna items_grid: offset = Row * 32 + Col
 196+ 7CF9 D5               push de
 197+ 7CFA 26 00            ld   h, 0
 198+ 7CFC 68               ld   l, b                      ; HL = Row
 199+ 7CFD 29               add  hl, hl
 200+ 7CFE 29               add  hl, hl
 201+ 7CFF 29               add  hl, hl

 435+ 82D1 C6 07            add  a, 7
 436+ 82D3 57               ld   d, a                      ; D = ItemRight
 437+ 82D4
 438+ 82D4 ED 4B 09 DF      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 439+ 82D8
 440+ 82D8                  ; WillyLeft <= ItemRight
 441+ 82D8 79               ld   a, c                      ; A = WillyX
 442+ 82D9 BA               cp   d                         ; D = ItemRight
 443+ 82DA 28 04            jr   z, .x_ok
 444+ 82DC 38 02            jr   c, .x_ok
 445+ 82DE 18 31            jr   .no_collision
 446+ 82E0
 447+ 82E0              .x_ok:
 448+ 82E0                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 449+ 82E0 BB               cp   e                         ; E = ItemLeft
 450+ 82E1 28 0B            jr   z, .y_check
 451+ 82E3 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft

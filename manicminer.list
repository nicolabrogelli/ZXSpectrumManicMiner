 138+ 8089              ; Items_DrawRoom
 139+ 8089              ;
 140+ 8089              ; Disegna tutti gli oggetti attivi appartenenti alla stanza corrente.
 141+ 8089              ; Legge i dati direttamente da room_ptr + OFFSET_ITEMS e la bitmap da
 142+ 8089              ; room_ptr + OFFSET_ITEM_GRAPHIC.
 143+ 8089              ;
 144+ 8089              ; Record item nella stanza (5 byte):
 145+ 8089              ;   +0 Color / Attributo
 146+ 8089              ;   +1 Attr Address Low (23552 + Row * 32 + Col)
 147+ 8089              ;   +2 Attr Address High
 148+ 8089              ;   +3 Anim Mask (96)
 149+ 8089              ;   +4 Collected Flag ($FF = attivo/non raccolto, 0 = raccolto)
 150+ 8089              ; Fine lista: $FF
 151+ 8089              ; -------------------------------------------------------------------
 152+ 8089              Items_DrawRoom:
 153+ 8089 E5               push hl
 154+ 808A D5               push de
 155+ 808B C5               push bc
 156+ 808C DD E5            push ix
 157+ 808E FD E5            push iy
 158+ 8090
 159+ 8090                  ; 1. Azzera items_grid (512 byte)
 160+ 8090 21 00 9C         ld   hl, items_grid
 161+ 8093 11 01 9C         ld   de, items_grid + 1
 162+ 8096 36 00            ld   (hl), 0
 163+ 8098 01 FF 01         ld   bc, 511
 164+ 809B ED B0            ldir
 165+ 809D
 166+ 809D                  ; 2. Nessun item attivo inizialmente nella cache
 167+ 809D AF               xor  a
 168+ 809E 32 7F A1         ld   (num_room_items), a
 169+ 80A1
 170+ 80A1 FD 21 2F A1      ld   iy, current_room_items
 171+ 80A5
 172+ 80A5                  ; 3. IX = Puntatore alla bitmap grafica dell'item (8 byte)
 173+ 80A5 2A 80 A1         ld   hl, (room_ptr)
 174+ 80A8 11 B4 02         ld   de, OFFSET_ITEM_GRAPHIC
 175+ 80AB 19               add  hl, de
 176+ 80AC E5               push hl
 177+ 80AD DD E1            pop  ix                        ; IX = bitmap item
 178+ 80AF
 179+ 80AF                  ; 4. HL = Inizio lista item nella stanza
 180+ 80AF 2A 80 A1         ld   hl, (room_ptr)
 181+ 80B2 11 75 02         ld   de, OFFSET_ITEMS
 182+ 80B5 19               add  hl, de
 183+ 80B6
 184+ 80B6              .loop:
 185+ 80B6 7E               ld   a, (hl)                   ; Byte 0: Color
 186+ 80B7 FE FF            cp   $FF
 187+ 80B9 28 65            jr   z, .done                  ; $FF = fine lista item
 188+ 80BB
 189+ 80BB 5F               ld   e, a                      ; E = Color
 190+ 80BC 23               inc  hl
 191+ 80BD 4E               ld   c, (hl)                   ; C = AttrAddr Low
 192+ 80BE 23               inc  hl
 193+ 80BF 46               ld   b, (hl)                   ; B = AttrAddr High
 194+ 80C0 23               inc  hl                        ; Salta Anim Byte
 195+ 80C1 23               inc  hl                        ; HL punta a Byte 4: Collected flag
 196+ 80C2
 197+ 80C2 7E               ld   a, (hl)                   ; A = Collected flag
 198+ 80C3 FE FF            cp   $FF
 199+ 80C5 20 56            jr   nz, .next_item            ; Se != $FF, l'item è già stato raccolto
 200+ 80C7
 201+ 80C7                  ; Calcola Row e Col da BC (AttrAddr): Offset = BC - 23552
 202+ 80C7 E5               push hl
 203+ 80C8 60               ld   h, b
 204+ 80C9 69               ld   l, c
 205+ 80CA 01 00 A4         ld   bc, -23552
 206+ 80CD 09               add  hl, bc                    ; HL = AttrOffset
 207+ 80CE
 208+ 80CE                  ; Col = Offset & 31
 209+ 80CE 7D               ld   a, l
 210+ 80CF E6 1F            and  31
 211+ 80D1 4F               ld   c, a                      ; C = Col (0..31)
 212+ 80D2
 213+ 80D2                  ; Row = Offset / 32
 214+ 80D2 CB 3C            srl  h
 214+ 80D4 CB 1D          rr l
 215+ 80D6 CB 3C            srl  h
 215+ 80D8 CB 1D          rr l
 216+ 80DA CB 3C            srl  h
 216+ 80DC CB 1D          rr l
 217+ 80DE CB 3C            srl  h
 217+ 80E0 CB 1D          rr l
 218+ 80E2 CB 3C            srl  h
 218+ 80E4 CB 1D          rr l
 219+ 80E6 7D               ld   a, l
 220+ 80E7 47               ld   b, a                      ; B = Row (0..15)
 221+ 80E8
 222+ 80E8                  ; Disegna l'item sullo schermo
 223+ 80E8 DD E5            push ix
 224+ 80EA E1               pop  hl                        ; HL = puntatore bitmap
 225+ 80EB CD 3D 81         call DrawItemGraphic
 226+ 80EE
 227+ 80EE                  ; Aggiorna items_grid: offset = Row * 32 + Col
 228+ 80EE D5               push de
 229+ 80EF 26 00            ld   h, 0
 230+ 80F1 68               ld   l, b                      ; HL = Row
 231+ 80F2 29               add  hl, hl
 232+ 80F3 29               add  hl, hl
 233+ 80F4 29               add  hl, hl
 234+ 80F5 29               add  hl, hl
 235+ 80F6 29               add  hl, hl                    ; Row * 32
 236+ 80F7 59               ld   e, c

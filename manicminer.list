1269+ 78EA              ; -------------------------------------------------------------------
1270+ 78EA              ; Legge il tipo di cella dal buffer decompresso in RAM
1271+ 78EA              ; Input: A = Row (0..15), C = Col (0..31)
1272+ 78EA              ; Output: A = tipo di cella (0..3)
1273+ 78EA              ; Preserva tutti gli altri registri.
1274+ 78EA              ; -------------------------------------------------------------------
1275+ 78EA              GetCellFromUnpacked:
1276+ 78EA E5               push hl
1277+ 78EB D5               push de
1278+ 78EC
1279+ 78EC 6F               ld   l, a
1280+ 78ED 26 00            ld   h, 0
1281+ 78EF 29               add  hl, hl
1282+ 78F0 29               add  hl, hl
1283+ 78F1 29               add  hl, hl
1284+ 78F2 29               add  hl, hl
1285+ 78F3 29               add  hl, hl            ; HL = Row * 32
1286+ 78F4 59               ld   e, c
1287+ 78F5 16 00            ld   d, 0

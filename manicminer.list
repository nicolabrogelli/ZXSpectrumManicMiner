 346+ 703D              ; LoadPositionPlayeinRoom
 347+ 703D              ;
 348+ 703D              ; Inizializza la posizione del player (Willy) quando entra
 349+ 703D              ; in una nuova stanza.
 350+ 703D              ;
 351+ 703D              ; La posizione viene letta direttamente dai dati della stanza
 352+ 703D              ; (layout/metadata) a partire da room_ptr.
 353+ 703D              ;
 354+ 703D              ; Output:
 355+ 703D              ;   PlayerPos     = posizione iniziale (Y, X)
 356+ 703D              ;   PlayerPosOld  = copia della posizione iniziale
 357+ 703D              ;
 358+ 703D              ; Struttura dati stanza:
 359+ 703D              ;   OFFSET_POS_WILLY:
 360+ 703D              ;       +0 = X
 361+ 703D              ;       +1 = Y
 362+ 703D              ; -------------------------------------------------------------------
 363+ 703D              LoadPositionPlayeinRoom:
 364+ 703D                  ; ---------------------------------------------------------------
 365+ 703D                  ; Accede alla struttura dati della stanza corrente (OFFSET_POS_WILLY = 616)
 366+ 703D                  ; ---------------------------------------------------------------
 367+ 703D 2A 37 EE         ld   hl, (room_ptr)
 368+ 7040 11 68 02         ld   de, OFFSET_POS_WILLY
 369+ 7043 19               add  hl, de
 370+ 7044
 371+ 7044                  ; Byte 0: Y * 2
 372+ 7044 7E               ld   a, (hl)
 373+ 7045 CB 3F            srl  a                         ; A = Pixel Y (es. 208 -> 104)
 374+ 7047 57               ld   d, a                      ; D = PlayerY
 375+ 7048
 376+ 7048                  ; Byte 1: Anim frame
 377+ 7048 23               inc  hl
 378+ 7049 7E               ld   a, (hl)
 379+ 704A E6 03            and  3                         ; Garanzia valore valido (0..3)
 380+ 704C FE 03            cp   3
 381+ 704E 38 01            jr   c, .valid_anim
 382+ 7050 AF               xor  a
 383+ 7051              .valid_anim:
 384+ 7051 32 BC EA         ld   (body_state), a
 385+ 7054 32 BF EE         ld   (player_old_body), a
 386+ 7057
 387+ 7057                  ; Byte 2: Direction (0 = right, 1 = left in formato MM)
 388+ 7057 23               inc  hl                        ; Byte 2 (Direction)
 389+ 7058 7E               ld   a, (hl)
 390+ 7059 E6 01            and  1
 391+ 705B 28 04            jr   z, .facing_right
 392+ 705D 3E 01            ld   a, 1                      ; 1 = Sinistra nel motore
 393+ 705F 18 02            jr   .set_dir
 394+ 7061              .facing_right:
 395+ 7061 3E 02            ld   a, 2                      ; 2 = Destra nel motore

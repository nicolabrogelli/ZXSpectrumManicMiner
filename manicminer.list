  85+ 7D0A FE FF            cp   $FF
  86+ 7D0C 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 7D0E 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 7D0F 23               inc  hl                        ; +2 (Attr Address High)
  89+ 7D10 23               inc  hl                        ; +3 (Anim mask)
  90+ 7D11 23               inc  hl                        ; +4 (Collected flag)
  91+ 7D12 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 7D14 23               inc  hl                        ; Avanza al prossimo item
  93+ 7D15 18 F2            jr   .item_loop
  94+ 7D17
  95+ 7D17              .next_room:

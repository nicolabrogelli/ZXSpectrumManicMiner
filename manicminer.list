 408+ 81A3              ; CheckWillyItemCollision
 409+ 81A3              ;
 410+ 81A3              ; Verifica collisione bounding box (16x16 vs 8x8) tra Willy e un item.
 411+ 81A3              ; Input:
 412+ 81A3              ;   A = Item Col (0..31)
 413+ 81A3              ;   H = Item Row (0..15)
 414+ 81A3              ; Output:
 415+ 81A3              ;   Carry Set = Collisione
 416+ 81A3              ;   Carry Clear = Nessuna collisione
 417+ 81A3              ; -------------------------------------------------------------------
 418+ 81A3              CheckWillyItemCollision:
 419+ 81A3 C5               push bc
 420+ 81A4 D5               push de
 421+ 81A5 E5               push hl
 422+ 81A6
 423+ 81A6                  ; ItemLeft = Col * 8, ItemRight = ItemLeft + 7
 424+ 81A6 6F               ld   l, a
 425+ 81A7 87               add  a, a                      ; *2
 426+ 81A8 87               add  a, a                      ; *4
 427+ 81A9 87               add  a, a                      ; *8
 428+ 81AA 5F               ld   e, a                      ; E = ItemLeft
 429+ 81AB C6 07            add  a, 7
 430+ 81AD 57               ld   d, a                      ; D = ItemRight
 431+ 81AE
 432+ 81AE ED 4B 00 96      ld   bc, (PlayerPos)           ; B = WillyY, C = WillyX
 433+ 81B2
 434+ 81B2                  ; WillyLeft <= ItemRight
 435+ 81B2 79               ld   a, c                      ; A = WillyX
 436+ 81B3 BA               cp   d                         ; D = ItemRight
 437+ 81B4 28 04            jr   z, .x_ok
 438+ 81B6 38 02            jr   c, .x_ok
 439+ 81B8 18 31            jr   .no_collision
 440+ 81BA
 441+ 81BA              .x_ok:
 442+ 81BA                  ; Se WillyX >= ItemLeft, allora WillyX è compreso tra ItemLeft e ItemRight (overlap X garantito)
 443+ 81BA BB               cp   e                         ; E = ItemLeft
 444+ 81BB 28 0B            jr   z, .y_check
 445+ 81BD 30 09            jr   nc, .y_check              ; WillyX >= ItemLeft
 446+ 81BF
 447+ 81BF                  ; Se WillyX < ItemLeft, verifichiamo che WillyRight (WillyX + 15) >= ItemLeft
 448+ 81BF C6 0F            add  a, 15
 449+ 81C1 BB               cp   e
 450+ 81C2 28 04            jr   z, .y_check
 451+ 81C4 30 02            jr   nc, .y_check
 452+ 81C6 18 23            jr   .no_collision
 453+ 81C8
 454+ 81C8              .y_check:
 455+ 81C8                  ; ItemTop = Row * 8, ItemBottom = ItemTop + 7
 456+ 81C8 7C               ld   a, h                      ; H = Item Row
 457+ 81C9 87               add  a, a                      ; *2
 458+ 81CA 87               add  a, a                      ; *4
 459+ 81CB 87               add  a, a                      ; *8
 460+ 81CC 5F               ld   e, a                      ; E = ItemTop
 461+ 81CD C6 07            add  a, 7
 462+ 81CF 57               ld   d, a                      ; D = ItemBottom
 463+ 81D0
 464+ 81D0                  ; WillyTop <= ItemBottom
 465+ 81D0 78               ld   a, b                      ; A = WillyY
 466+ 81D1 BA               cp   d                         ; D = ItemBottom
 467+ 81D2 28 04            jr   z, .y_ok
 468+ 81D4 38 02            jr   c, .y_ok
 469+ 81D6 18 13            jr   .no_collision
 470+ 81D8
 471+ 81D8              .y_ok:
 472+ 81D8                  ; Se WillyY >= ItemTop, allora WillyY è compreso tra ItemTop e ItemBottom (overlap Y garantito)
 473+ 81D8 BB               cp   e                         ; E = ItemTop
 474+ 81D9 28 0B            jr   z, .collision
 475+ 81DB 30 09            jr   nc, .collision            ; WillyY >= ItemTop
 476+ 81DD
 477+ 81DD                  ; Se WillyY < ItemTop, verifichiamo che WillyBottom (WillyY + 15) >= ItemTop
 478+ 81DD C6 0F            add  a, 15
 479+ 81DF BB               cp   e
 480+ 81E0 28 04            jr   z, .collision
 481+ 81E2 30 02            jr   nc, .collision
 482+ 81E4 18 05            jr   .no_collision

 827  89D2 28 48            jr   z, .no_conv_collision ; Nessun conveyor presente
 828  89D4
 829  89D4                  ; B = WillyY, C = WillyX
 830  89D4 ED 4B BB E0      ld   bc, (PlayerPos)
 831  89D8
 832  89D8                  ; ConveyorTop = conveyor_row * 8, ConveyorBottom = ConveyorTop + 7
 833  89D8 3A E4 E3         ld   a, (conveyor_row)
 834  89DB 87               add  a, a                  ; *2
 835  89DC 87               add  a, a                  ; *4
 836  89DD 87               add  a, a                  ; *8
 837  89DE 5F               ld   e, a                  ; E = ConveyorTop
 838  89DF C6 07            add  a, 7
 839  89E1 57               ld   d, a                  ; D = ConveyorBottom
 840  89E2
 841  89E2                  ; WillyTop = WillyY (B), WillyBottom = WillyY + 15
 842  89E2 78               ld   a, b                  ; WillyTop
 843  89E3 BA               cp   d
 844  89E4 28 04            jr   z, .y_overlap
 845  89E6 38 02            jr   c, .y_overlap         ; WillyTop <= ConveyorBottom
 846  89E8 18 32            jr   .no_conv_collision
 847  89EA

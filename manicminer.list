   4+ 80A0              ; Gestione degli Oggetti (Items) per Manic Miner.
   5+ 80A0              ; Gli item e la relativa grafica sono definiti direttamente all'interno
   6+ 80A0              ; dei dati della stanza (offset OFFSET_ITEMS e OFFSET_ITEM_GRAPHIC).
   7+ 80A0              ;===========================================================================
   8+ 80A0
   9+ 80A0              TOTAL_ITEMS: EQU 5 ; Numero totale di item in Central Cavern (aggiornato per le caverne attive)
  10+ 80A0
  11+ 80A0              ; -------------------------------------------------------------------
  12+ 80A0              ; DetermineCurrentRoomID
  13+ 80A0              ;
  14+ 80A0              ; Determina l'ID numerico della stanza corrente confrontando
  15+ 80A0              ; il puntatore room_ptr con gli indirizzi presenti in RoomsListTable.
  16+ 80A0              ;
  17+ 80A0              ; Output:
  18+ 80A0              ;   A = ID della stanza (0..NUM_ROOMS-1)
  19+ 80A0              ;   (current_room) = A
  20+ 80A0              ; -------------------------------------------------------------------
  21+ 80A0              DetermineCurrentRoomID:
  22+ 80A0 E5               push hl
  23+ 80A1 D5               push de
  24+ 80A2 C5               push bc
  25+ 80A3
  26+ 80A3 21 0A 73         ld   hl, RoomsListTable
  27+ 80A6 ED 5B EA AD      ld   de, (room_ptr)
  28+ 80AA 06 07            ld   b, NUM_ROOMS
  29+ 80AC 0E 00            ld   c, 0
  30+ 80AE
  31+ 80AE              .loop:
  32+ 80AE 7E               ld   a, (hl)
  33+ 80AF BB               cp   e
  34+ 80B0 20 06            jr   nz, .no_match
  35+ 80B2 23               inc  hl
  36+ 80B3 7E               ld   a, (hl)
  37+ 80B4 BA               cp   d
  38+ 80B5 28 08            jr   z, .found
  39+ 80B7 2B               dec  hl
  40+ 80B8
  41+ 80B8              .no_match:
  42+ 80B8 23               inc  hl
  43+ 80B9 23               inc  hl
  44+ 80BA 0C               inc  c
  45+ 80BB 10 F1            djnz .loop
  46+ 80BD
  47+ 80BD 0E 00            ld   c, 0                      ; Default stanza 0 se non trovata
  48+ 80BF
  49+ 80BF              .found:
  50+ 80BF 79               ld   a, c
  51+ 80C0 32 8F AD         ld   (current_room), a
  52+ 80C3
  53+ 80C3 C1               pop  bc
  54+ 80C4 D1               pop  de
  55+ 80C5 E1               pop  hl
  56+ 80C6 C9               ret
  57+ 80C7
  58+ 80C7              ; -------------------------------------------------------------------
  59+ 80C7              ; ResetItemsTable
  60+ 80C7              ; Ripristina il flag di raccolta (byte 4 di ciascun item) a $FF (non raccolto)
  61+ 80C7              ; per tutte le stanze registrate in RoomsListTable.
  62+ 80C7              ; -------------------------------------------------------------------
  63+ 80C7              ResetItemsTable:
  64+ 80C7 E5               push hl
  65+ 80C8 D5               push de
  66+ 80C9 C5               push bc
  67+ 80CA
  68+ 80CA 21 0A 73         ld   hl, RoomsListTable
  69+ 80CD 06 07            ld   b, NUM_ROOMS
  70+ 80CF
  71+ 80CF              .room_loop:
  72+ 80CF C5               push bc
  73+ 80D0 5E               ld   e, (hl)
  74+ 80D1 23               inc  hl
  75+ 80D2 56               ld   d, (hl)
  76+ 80D3 23               inc  hl
  77+ 80D4 E5               push hl
  78+ 80D5
  79+ 80D5                  ; DE = room_ptr
  80+ 80D5 21 75 02         ld   hl, OFFSET_ITEMS
  81+ 80D8 19               add  hl, de                    ; HL = offset oggetti nella stanza
  82+ 80D9
  83+ 80D9              .item_loop:
  84+ 80D9 7E               ld   a, (hl)
  85+ 80DA FE FF            cp   $FF
  86+ 80DC 28 09            jr   z, .next_room             ; $FF = fine lista item della stanza
  87+ 80DE 23               inc  hl                        ; +1 (Attr Address Low)
  88+ 80DF 23               inc  hl                        ; +2 (Attr Address High)
  89+ 80E0 23               inc  hl                        ; +3 (Anim mask)
  90+ 80E1 23               inc  hl                        ; +4 (Collected flag)
  91+ 80E2 36 FF            ld   (hl), $FF                 ; $FF = non raccolto
  92+ 80E4 23               inc  hl                        ; Avanza al prossimo item
  93+ 80E5 18 F2            jr   .item_loop
  94+ 80E7
  95+ 80E7              .next_room:
  96+ 80E7 E1               pop  hl
  97+ 80E8 C1               pop  bc
  98+ 80E9 10 E4            djnz .room_loop
  99+ 80EB
 100+ 80EB C1               pop  bc
 101+ 80EC D1               pop  de
 102+ 80ED E1               pop  hl
 103+ 80EE C9               ret

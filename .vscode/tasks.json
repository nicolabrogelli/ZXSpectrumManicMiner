{
    "version": "2.0.0",
    "tasks": [
      {
        "label": "buildZXSpectrum",
        "type": "shell",
        "command": "\"C:\\Users\\nicol\\Documents\\Progetti\\asm\\sjasmplus\\sjasmplus.exe\"",
        "args": [
          "-Wno-sna48",
          "--sld=${workspaceFolder}/manicminer.sld",
          "--fullpath",
          "--lst=${workspaceFolder}/manicminer.list",
          "manicminer.asm"
        ],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "buildZXSpectrum (No Music)",
        "type": "shell",
        "command": "\"C:\\Users\\nicol\\Documents\\Progetti\\asm\\sjasmplus\\sjasmplus.exe\"",
        "args": [
          "-Wno-sna48",
          "-DENABLE_MUSIC=0",
          "--sld=${workspaceFolder}/manicminer.sld",
          "--fullpath",
          "--lst=${workspaceFolder}/manicminer.list",
          "manicminer.asm"
        ],
        "group": "build",
        "problemMatcher": []
      },
      {
        "label": "start zesarux",
        "type": "shell",
        "command": "${config:zesarux_dir}\\zesarux.exe",
        "args": [
            "--noconfigfile",           // Do not load configuration file
            "--machine", "tbblue",      // Emulate ZX Next
            "--tbblue-fast-boot-mode",  // Boots tbblue directly to a 48 rom but with all the Next features enabled
            "--snap-no-change-machine", // Do not change machine when loading sna or z80 snapshots. Just load it on memory
            "--enable-esxdos-handler",  // Enable ESXDOS traps handler
            "--enable-remoteprotocol",  // Enable ZRCP remote protocol
            "--disable-autoframeskip",  // Dissable auto skip
            "--esxdos-root-dir", ".",    // Set ESXDOS root directory
            "--ignoremouseclickopenmenu" // Prevent left-click from pausing/opening the menu
        ],
        "options": {
           "cwd": "${config:zesarux_dir}"
        },
        "detail": "zesarux --noconfigfile --machine tbblue --tbblue-fast-boot-mode --snap-no-change-machine --enable-esxdos-handler --enable-remoteprotocol --disable-autoframeskip --esxdos-root-dir .",
        "problemMatcher": []
    },
    {
      "label": "start cspect",
      "type": "shell",
      "command": "${config:cspect_dir}\\CSpect.exe",
      "args": [
          "-w4", // Window size
          "-zxnext", // Use zxnext HW registers
          "-mmc=./", // Enable RST 8, emulate SW card at director ./  (the trailing slash is important)
          "-tv", // Disable TV shader
          "-r", // Remember window settings
          "-debug" // Start up in (CSpect) debugger
      ],
      "options": {
          "cwd": "${config:cspect_dir}"
      },
      "problemMatcher": []
    },
    {
      "label": "start fuse",
      "type": "shell",
      "command": "C:\\Users\\nicol\\Documents\\BACKUP\\DOC - RETROCOMPUTER\\COMPUTER\\SINCLAIR\\EMULATORI\\ZX SPECTRUM\\fuse-1.6.0-win32\\fuse.exe",
      "args": [
        "${workspaceFolder}/manicminer.sna"
      ],
      "dependsOn": "buildZXSpectrum",
      "problemMatcher": []
    }
  ]
}
  
{
    "rootFolder": "${workspaceFolder}",
      "version": "0.2.0",
      "configurations": [
        {
          "type": "dezog",
          "rootFolder": "${workspaceFolder}",
          "request": "launch",
          "name": "Internal Emulator",
          "remoteType": "zsim",
          "zsim": {
                "preset": "spectrum",
                "memoryModel": "ZX48K",
          },
          "startAutomatically": true,
          "preLaunchTask": "buildZXSpectrum",
          "load":"${workspaceFolder}/maincminer.sna",
          "sjasmplus": [
          {
            "path": "${workspaceFolder}/maincminer.sld"
          }],
        },
        {
          "type": "dezog",
          "request": "launch",
          "name": "ZEsarUX",
          "remoteType": "zrcp",
          "sjasmplus": [
              {
                  "path": "${workspaceFolder}/maincminer.sld"
              }
          ],
          "history": {
              "reverseDebugInstructionCount": 1000000,
              "spotCount": 10,
          },
          "startAutomatically": true,
          "commandsAfterLaunch": [
          ],
          "rootFolder": "${workspaceFolder}",
          "load": "${workspaceFolder}/maincminer.sna",
          "smallValuesMaximum": 513,
          "tmpDir": ".tmp"
      },        
      {
        "type": "dezog",
        "request": "launch",
        "name": "CSpect",
        "remoteType": "cspect",
        "sjasmplus": [
            {
                "path": "${workspaceFolder}/maincminer.sld"
            }
        ],
        "history": {
            "reverseDebugInstructionCount": 1000000,
            "spotCount": 10
        },
        "startAutomatically": false,
        "commandsAfterLaunch": [
        ],
        "rootFolder": "${workspaceFolder}",
        "load": "${workspaceFolder}/maincminer.sna",
        "smallValuesMaximum": 513,
        "tmpDir": ".tmp"
    }     
      ]
    }